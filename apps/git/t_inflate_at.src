// `zlib.decompress_at`/`zlib.inflate_at` against `oracle_inflate_at.py`'s
// two concatenated-stream fixtures -- isolated from `pack.src`'s own framing,
// exactly as that oracle's own header explains.
//
//   python3 apps/git/oracle_inflate_at.py DIR > want
//   ./build.sh apps/git/t_inflate_at.src -o t_inflate_at
//   ./t_inflate_at DIR > got
//   diff got want
//
// One line per stream, in the order it starts at in its buffer:
//
//   <kind> <index> <start> ok <used> <sha1-of-the-payload>
//   <kind> <index> <start> err

import zlib;
import sha1;
import io;
import os;
import fs;

List<str> argv = os.args();
if (argv.size() < 2) {
    io.eprint("usage: t_inflate_at <fixture-dir>");
    os.exit(2);
}
str dir = argv[1];
bytes zbuf = [];
match (io.read_bytes(fs.join(dir, "streams.zlib"))) {
    case Ok(bytes b): {
        zbuf = b;
    }
    case Err(io.Error e): {
        io.eprint("cannot read streams.zlib: " + e.to_str());
        os.exit(2);
    }
}
bytes rbuf = [];
match (io.read_bytes(fs.join(dir, "streams.raw"))) {
    case Ok(bytes b): {
        rbuf = b;
    }
    case Err(io.Error e): {
        io.eprint("cannot read streams.raw: " + e.to_str());
        os.exit(2);
    }
}
int zi = 0;
int zoff = 0;
while (zoff < zbuf.size()) {
    match (zlib.decompress_at(zbuf, zoff)) {
        case Ok(zlib.Decoded d): {
            print("zlib " + zi.to_str() + " " + zoff.to_str() + " ok " + d.used.to_str() + " " + sha1.hex(d.data));
            if (d.used <= 0) {
                // Refuse to spin forever on a bug that reports no progress.
                io.eprint("zlib stream " + zi.to_str() + " reported used <= 0");
                os.exit(2);
            }
            zoff = zoff + d.used;
        }
        case Err(zlib.Error e): {
            print("zlib " + zi.to_str() + " " + zoff.to_str() + " err");
            io.eprint("  zlib " + zi.to_str() + ": " + e.to_str());
            zoff = zbuf.size();
        }
    }
    zi = zi + 1;
}
int ri = 0;
int roff = 0;
while (roff < rbuf.size()) {
    match (zlib.inflate_at(rbuf, roff)) {
        case Ok(zlib.Decoded d): {
            print("raw " + ri.to_str() + " " + roff.to_str() + " ok " + d.used.to_str() + " " + sha1.hex(d.data));
            if (d.used <= 0) {
                io.eprint("raw stream " + ri.to_str() + " reported used <= 0");
                os.exit(2);
            }
            roff = roff + d.used;
        }
        case Err(zlib.Error e): {
            print("raw " + ri.to_str() + " " + roff.to_str() + " err");
            io.eprint("  raw " + ri.to_str() + ": " + e.to_str());
            roff = rbuf.size();
        }
    }
    ri = ri + 1;
}
