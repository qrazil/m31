// `zlib.decompress` against Python's `zlib`, over the fixtures
// `oracle_inflate.py` writes.
//
//   python3 apps/git/oracle_inflate.py DIR > want
//   ./build.sh apps/git/t_inflate.src -o t_inflate && ./t_inflate DIR > got
//   diff got want
//
// One line per `.z` file in DIR, sorted by name:
//
//   <name> ok <octets> <sha1-of-the-output>
//   <name> err
//
// The digest rather than the octets, because the fixtures include a two-
// megabyte case and a diff of two megabytes of binary is not a diagnostic.
// `t_object.src` compares real objects octet for octet.

import zlib;
import sha1;
import io;
import os;
import fs;
import text;
import date;

List<str> argv = os.args();
if (argv.size() < 2) {
    io.eprint("usage: t_inflate <fixture-dir>");
    os.exit(2);
}
str dir = argv[1];
List<str> names = [];
match (fs.listdir(dir)) {
    case Ok(List<str> found): {
        for (str f in found) {
            // The name WITHOUT the extension, because that is what is
            // printed and the order has to be the order of the printed
            // lines: `fixed-match.z` sorts before `fixed.z` (`-` is below
            // `.`) while `fixed` sorts before `fixed-match`.
            str name = text.strip_suffix(f, ".z");
            if (name != f) {
                names.push(name);
            }
        }
    }
    case Err(io.Error e): {
        io.eprint("cannot list " + dir + ": " + e.to_str());
        os.exit(2);
    }
}
names.sort();
int slowest = 0;
int slowest_bytes = 0;
str slowest_name = "";
for (str name in names) {
    match (io.read_bytes(fs.join(dir, name + ".z"))) {
        case Ok(bytes stream): {
            int t0 = date.now_ns();
            match (zlib.decompress(stream)) {
                case Ok(bytes out): {
                    int ns = date.now_ns() - t0;
                    print(name + " ok " + out.size().to_str() + " " + sha1.hex(out));
                    if (out.size() > slowest_bytes) {
                        slowest_bytes = out.size();
                        slowest = ns;
                        slowest_name = name;
                    }
                }
                case Err(zlib.Error e): {
                    print(name + " err");
                    // The message is not compared -- no oracle has an opinion
                    // about it -- but a refusal nobody can read is not much of
                    // a refusal, so every one of them is shown on stderr.
                    io.eprint("  " + name + ": " + e.to_str());
                }
            }
        }
        case Err(io.Error e): {
            io.eprint("cannot read " + name + ": " + e.to_str());
            os.exit(2);
        }
    }
}
if (slowest > 0) {
    io.eprint("inflate: " + slowest_name + ", " + slowest_bytes.to_str() + " octets out in " + (slowest / 1_000_000).to_str() + " ms = " + (slowest_bytes * 1_000 / slowest).to_str() + " MB/s");
}
