// Packfiles: the `.idx`/`.pack` pair under `.git/objects/pack/` that a real
// `git clone` writes instead of loose objects, and that `git gc`/`git repack`
// collapse a repository's loose objects into later. `apps/git/README.md`'s
// "What a real repository needs that this cannot do" names this as the whole
// remaining gap, and `apps/git/object.m31` wires this module in underneath
// `object.read` so that everything above it -- `log`, `cat-file`, `ls-tree`,
// `rev-parse`'s short names, the interactive client -- reads a packed
// repository exactly as it reads a loose one, with no call site changed.
//
// API
// ---
//   pack.read(gitdir, id)   -> Result<Found, Error>    kind + content, or NotFound
//   pack.ids(gitdir)        -> Result<List<str>, Error> every packed object's id
//   f.kind, f.content                                  what `Found` carries
//
// --- the `.idx`, format v2 only ----------------------------------------------
//
// v2 is the modern, universal format -- every `git` since 1.6 (2008) writes
// it, and reading v1 (no magic, 24-byte entries, no per-object CRC) means
// guessing at a format nothing still produces. So a `.idx` without the v2
// magic (`\xff\x74\x4f\x63`, i.e. `\377tOc`) or whose version word is not 2 is
// `Error.UnsupportedIdx` -- refused, not misread.
//
// v2's layout, in order: a 256-entry fanout table (4-byte big-endian
// cumulative counts -- `fanout[b]` is how many of the pack's objects have a
// first id-byte of `b` or less, so `fanout[255]` is the object count and
// `fanout[first-1] .. fanout[first]` is the slice to binary-search for any id
// starting with byte `first`); the sorted table of 20-byte object ids itself;
// a CRC32 per object (unused here -- nothing above this module asks for it,
// and the final SHA-1 check in `object.parse` is the stronger guarantee
// anyway); a 4-byte offset per object, whose top bit, when set, is not part of
// the offset but a flag: the low 31 bits are an INDEX into a trailing table of
// 8-byte big-endian offsets, for any object living past 2 GB into the pack;
// and finally the pack's own SHA-1 and the idx file's own, neither checked
// here for the same reason the CRC32 is not.
//
// --- the packfile itself ------------------------------------------------------
//
// `PACK`, a 4-byte version, a 4-byte object count, then that many entries
// back to back: a variable-length type+size header (3 type bits and 4 size
// bits in the first octet, each further octet's top bit a continuation flag
// and its low 7 bits the next size bits, least-significant group first), then
// one zlib stream (RFC 1950 -- the exact format `zlib.m31` already reads for a
// loose object, which is why `zlib.decompress_at` exists: this is that
// decoder, started at an offset instead of at the front of its own buffer).
//
// For an ordinary object (commit/tree/blob/tag) that stream is the content,
// with the header's size field its length. For `OBJ_OFS_DELTA` or
// `OBJ_REF_DELTA` it is instead a delta: copy/insert instructions against a
// base object, which may itself be a delta. `OBJ_OFS_DELTA` names its base by
// a backward BYTE OFFSET from the START OF ITS OWN TYPE+SIZE HEADER, encoded
// in the same "groups of 7 bits, continuation in the top bit" shape but with
// a `+1` folded into every continuation (RFC-less and easy to get off by one
// -- `resolve_offset` below has the arithmetic, and `apps/git/test.sh`'s
// packed fixture is what proves it against real objects). `OBJ_REF_DELTA`
// names its base by the base's own 20-byte id instead of an offset, which is
// how a THIN pack (one built assuming the receiver already has the base) can
// delta against an object that is not in the pack at all -- see
// `resolve_id`'s loose/other-pack fallback below.
//
// --- resolving a delta chain --------------------------------------------------
//
// A chain is walked DOWN iteratively, not recursively: from the requested
// offset, each `OBJ_OFS_DELTA` link decompresses its own delta stream once and
// moves `cur` to its base's offset in the SAME loop, so a chain fifty deep
// costs fifty decompressions and one call frame, not fifty. Recursion (via
// `resolve_id`) is used only where the chain can actually leave this walk --
// an `OBJ_REF_DELTA` whose base is not in this pack's own `.idx`, which
// `apps/git/README.md`'s packed repositories never produce (a full repack's
// bases are always in the one pack it writes) but a thin pack could. Each
// base is therefore decompressed exactly once for one lookup, in the order
// the chain is walked, with no cache needed to avoid a second decompression of
// the same base: the walk never revisits one. `MAX_DELTA_DEPTH` bounds both
// forms of recursion together (the iterative steps and the `resolve_id` call
// depth share one counter), which is what keeps a corrupt or cyclic chain
// from recursing or looping forever rather than reporting `ChainTooDeep`.
//
// --- what is NOT here ---------------------------------------------------------
//
// Writing a packfile -- `apps/git/README.md` and `apps/git/design.md`
// ("Going remote") both name this as later, separate work, once `push` needs
// it. Reading a pack's own trailing checksums (the CRC32 per object, the pack
// and idx SHA-1s) is skipped for the reason the header above gives: the
// content this module hands back is checked against the id it was asked for
// by `object.parse`'s own SHA-1, which is the stronger and already-existing
// guarantee, and re-deriving a second one here would only be insurance on
// insurance.

import io;
import fs;
import repo;
import zlib;

/// Why an object could not be read out of a `.idx`/`.pack` pair. Payload-free
/// (docs/errors-decision.md §4): the id, the path, and the offset a caller
/// was trying are context it already has when it reports.
pub enum Error {
    /// Not named by any `.idx` under `objects/pack/`, nor loose. Genuinely
    /// missing, not merely unread.
    NotFound;
    /// A `.idx` or `.pack` file exists and could not be read.
    Io;
    /// A `.idx` file that claims the v2 magic but is truncated or otherwise
    /// inconsistent with its own fanout table.
    BadIdx;
    /// A `.idx` file with no v2 magic (so, format v1) or a version word other
    /// than 2. Refused rather than guessed at -- see the module header.
    UnsupportedIdx;
    /// A `.pack` file's header, an object's type+size encoding, or an
    /// `OBJ_OFS_DELTA` offset is truncated or does not make sense (an offset
    /// reaching before the start of the pack or past its own object, an
    /// unknown type code).
    BadPack;
    /// A packed object's zlib stream is not intact.
    Zlib;
    /// A delta instruction stream is truncated, has an opcode of zero (which
    /// the format reserves and no writer emits), or a copy instruction
    /// reaching past the end of its base.
    BadDelta;
    /// A delta chain longer than `MAX_DELTA_DEPTH`, which is far deeper than
    /// any real repository's -- so this is a cycle or a corrupt pack, not a
    /// slow answer waiting to happen.
    ChainTooDeep;
}

pub str Error.to_str() {
    match (this) {
        case NotFound: {
            return "not found in any .idx/.pack under objects/pack/, nor loose";
        }
        case Io: {
            return "the pack or its index could not be read";
        }
        case BadIdx: {
            return "the .idx file is truncated or inconsistent with its own fanout table";
        }
        case UnsupportedIdx: {
            return "the .idx file is not format v2 (v1 is refused, not guessed at)";
        }
        case BadPack: {
            return "the .pack file's header or an object's encoding does not make sense";
        }
        case Zlib: {
            return "a packed object's zlib stream is not intact";
        }
        case BadDelta: {
            return "a delta instruction stream is malformed";
        }
        case ChainTooDeep: {
            return "a delta chain is implausibly deep, or cycles back on itself";
        }
    }
}

/// A packed object, resolved all the way down to its plain content: the same
/// two things `object.m31`'s loose reading already has by the time it calls
/// `object.parse` -- `object.read` reassembles `<kind> <size>\0<content>` from
/// this and hands it to `parse` exactly as it would for a loose object, so the
/// SHA-1 check, the tree/commit/tag parsing and everything above it are
/// shared, unchanged, between the two sources.
pub type Found {
    pub str kind;
    pub bytes content;
}

/// How far down a delta chain this will follow before calling it a cycle
/// or a corrupt pack rather than a slow lookup. Git's own `repack` defaults
/// to a delta depth of 50; this is generous past any real chain on purpose.
const int MAX_DELTA_DEPTH = 1000;

/// The packed object named `id`, or `Error.NotFound` if no `.idx` under
/// `objects/pack/` names it (and it is not loose either -- see the fallback
/// in `resolve_id`, needed for an `OBJ_REF_DELTA` base a thin pack leaves
/// outside the pack).
pub Result<Found, Error> read(str gitdir, str id) {
    List<PackFile> packs = discover(gitdir);
    return resolve_id(gitdir, packs, id, MAX_DELTA_DEPTH);
}

/// Every object named by a `.idx` under `objects/pack/`, sorted and
/// deduplicated (an id could in principle be named by more than one pack, if
/// the repository has not been fully repacked). A `.idx` that cannot be read
/// or does not parse is skipped rather than failing the whole call -- one bad
/// pack should not hide every object in the others -- so an `Err` here means
/// the pack directory itself could not be listed, not that some object is
/// unreadable.
pub Result<List<str>, Error> ids(str gitdir) {
    List<PackFile> packs = discover(gitdir);
    List<str> out = [];
    for (PackFile pf in packs) {
        match (io.read_bytes(pf.idx_path)) {
            case Ok(bytes data): {
                match (parse_idx(data)) {
                    case Ok(Idx ix): {
                        for (str id in ix.all_ids()) {
                            out.push(id);
                        }
                    }
                    case Err(Error e): {
                    }
                }
            }
            case Err(io.Error e): {
            }
        }
    }
    out.sort();
    List<str> dedup = [];
    str prev = "";
    for (str id in out) {
        if (dedup.size() == 0 || id != prev) {
            dedup.push(id);
        }
        prev = id;
    }
    return Result<List<str>, Error>.Ok(dedup);
}

// --- finding the `.idx`/`.pack` pairs -----------------------------------------

// One pack: its index and the packfile it indexes, both real files.
type PackFile {
    str idx_path;
    str pack_path;
}

// Every `<name>.idx` under `objects/pack/` that has a matching `<name>.pack`
// beside it, sorted by name (so a lookup is at least deterministic about
// which pack answers first if more than one names the same id). No packs
// directory at all is not an error -- most of this program's own fixtures
// have none -- it is simply zero packs.
List<PackFile> discover(str gitdir) {
    List<PackFile> out = [];
    str dir = fs.join(fs.join(repo.common(gitdir), "objects"), "pack");
    if (!fs.is_dir(dir)) {
        return out;
    }
    match (fs.listdir(dir)) {
        case Ok(List<str> names): {
            List<str> sorted = names;
            sorted.sort();
            for (str f in sorted) {
                if (f.ends_with(".idx")) {
                    str base = f.substr(0, f.size() - 4);
                    str packf = base + ".pack";
                    if (fs.is_file(fs.join(dir, packf))) {
                        out.push(PackFile(fs.join(dir, f), fs.join(dir, packf)));
                    }
                }
            }
        }
        case Err(io.Error e): {
        }
    }
    return out;
}

// --- the loose fallback, for a delta base a thin pack leaves outside it ------

// `id`'s loose object, read down to its kind and content only -- not through
// `object.parse`, which this module does not depend on (object.m31 depends on
// this one; the other way would be a cycle). No SHA-1 check and no structural
// validation: a delta base found this way is about to be fed straight into
// `apply_delta`, and the RESULT still goes through `object.parse` exactly as
// every other object does, which is where the one check that matters happens.
Option<Found> loose_raw(str gitdir, str id) {
    str root = fs.join(repo.common(gitdir), "objects");
    str path = fs.join(fs.join(root, id.substr(0, 2)), id.substr(2, 40));
    if (!fs.exists(path)) {
        return Option<Found>.None;
    }
    match (io.read_bytes(path)) {
        case Ok(bytes raw): {
            match (zlib.decompress(raw)) {
                case Ok(bytes plain): {
                    int nul = find(plain, 0, 0);
                    int sp = find(plain, 32, 0);
                    if (nul < 0 || sp < 0 || sp > nul) {
                        return Option<Found>.None;
                    }
                    str kind = plain.substr(0, sp).utf8().or("");
                    bytes content = plain.substr(nul + 1, plain.size());
                    return Option<Found>.Some(Found(kind, content));
                }
                case Err(zlib.Error e): {
                    return Option<Found>.None;
                }
            }
        }
        case Err(io.Error e): {
            return Option<Found>.None;
        }
    }
}

// The index of octet `b` at or after `from`, or -1 -- `object.m31`'s own
// private helper, duplicated rather than imported (that module imports this
// one, not the other way around; see the header on why, and `object.m31`'s
// own copy of this same helper for the established house pattern of not
// sharing a four-line scan across modules).
int find(bytes hay, int b, int from) {
    int i = from;
    int n = hay.size();
    while (i < n) {
        if (hay[i] == b) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// --- resolving one id, loose or packed, with the delta-base fallback --------

// `id` (loose, or named by one of `packs`' `.idx` files), depth-bounded so an
// `OBJ_REF_DELTA` chain that keeps leaving the pack it started in -- or, on a
// corrupt/cyclic input, never terminates -- is `ChainTooDeep` instead of a
// stack that grows forever. Loose is checked first at every depth, not only
// at the top: a delta base can be loose two or three hops down a chain just
// as easily as at the top of one.
Result<Found, Error> resolve_id(str gitdir, List<PackFile> packs, str id, int depth) {
    if (depth <= 0) {
        return Result<Found, Error>.Err(Error.ChainTooDeep);
    }
    match (loose_raw(gitdir, id)) {
        case Some(Found f): {
            return Result<Found, Error>.Ok(f);
        }
        case None: {
        }
    }
    bytes id20 = hex_decode(id);
    for (PackFile pf in packs) {
        match (io.read_bytes(pf.idx_path)) {
            case Ok(bytes idata): {
                match (parse_idx(idata)) {
                    case Ok(Idx ix): {
                        match (ix.offset_of(id20)) {
                            case Some(int off): {
                                match (io.read_bytes(pf.pack_path)) {
                                    case Ok(bytes packbytes): {
                                        return resolve_offset(gitdir, packs, ix, packbytes, off, depth);
                                    }
                                    case Err(io.Error e): {
                                        return Result<Found, Error>.Err(Error.Io);
                                    }
                                }
                            }
                            case None: {
                            }
                        }
                    }
                    case Err(Error e): {
                    }
                }
            }
            case Err(io.Error e): {
            }
        }
    }
    return Result<Found, Error>.Err(Error.NotFound);
}

// The object at `start_offset` in `pack` (indexed by `ix`), walking down an
// `OBJ_OFS_DELTA`/`OBJ_REF_DELTA` chain iteratively and applying it back up
// once the chain bottoms out at a real commit/tree/blob/tag. See the module
// header, "resolving a delta chain", for why this is a loop and not a
// recursive call for the common case.
Result<Found, Error> resolve_offset(str gitdir, List<PackFile> packs, Idx ix, bytes pack, int start_offset, int depth) {
    List<bytes> chain = [];
    int cur = start_offset;
    int steps = 0;
    str base_kind = "";
    bytes base_content = [];
    while (true) {
        steps = steps + 1;
        if (steps > depth) {
            return Result<Found, Error>.Err(Error.ChainTooDeep);
        }
        ObjHeader hdr = read_obj_header(pack, cur)?;
        if (hdr.kind == 1 || hdr.kind == 2 || hdr.kind == 3 || hdr.kind == 4) {
            zlib.Decoded d = inflate_pack_zlib(pack, cur + hdr.header_len)?;
            base_kind = kind_name(hdr.kind);
            base_content = d.data;
            break;
        } else if (hdr.kind == 6) {
            // OBJ_OFS_DELTA: a backward byte offset from `cur`, the start of
            // THIS object's own type+size header -- not from the end of the
            // header, not from the start of the pack. Encoded as successive
            // 7-bit groups, continuation in the top bit, but with a `+1`
            // folded into every continuation past the first (the encoding's
            // own trick for not wasting a representable value on 0, which a
            // plain base-128 varint would); see the header note on why this
            // is the easiest arithmetic here to get subtly wrong.
            int p = cur + hdr.header_len;
            if (p >= pack.size()) {
                return Result<Found, Error>.Err(Error.BadPack);
            }
            int c = pack[p];
            p = p + 1;
            int value = c & 0x7F;
            int guard = 0;
            while ((c & 0x80) != 0) {
                guard = guard + 1;
                if (guard > 8) {
                    return Result<Found, Error>.Err(Error.BadPack);
                }
                if (p >= pack.size()) {
                    return Result<Found, Error>.Err(Error.BadPack);
                }
                c = pack[p];
                p = p + 1;
                value = (value + 1) << 7 | (c & 0x7F);
            }
            int base_off = cur - value;
            if (base_off < 0 || base_off >= cur) {
                return Result<Found, Error>.Err(Error.BadPack);
            }
            zlib.Decoded d = inflate_pack_zlib(pack, p)?;
            chain.push(d.data);
            cur = base_off;
        } else if (hdr.kind == 7) {
            // OBJ_REF_DELTA: the base named by its own 20-byte id, which may
            // or may not be in THIS pack (a thin pack leaves it out on
            // purpose) -- checked against `ix` first, since that is the
            // common case and stays inside this iterative loop; only a miss
            // falls back to `resolve_id`'s general search.
            int p = cur + hdr.header_len;
            if (p + 20 > pack.size()) {
                return Result<Found, Error>.Err(Error.BadPack);
            }
            bytes base_sha = pack.substr(p, p + 20);
            zlib.Decoded d = inflate_pack_zlib(pack, p + 20)?;
            chain.push(d.data);
            bool base_done = false;
            match (ix.offset_of(base_sha)) {
                case Some(int base_off): {
                    cur = base_off;
                }
                case None: {
                    Found f = resolve_id(gitdir, packs, base_sha.hex(), depth - steps)?;
                    base_kind = f.kind;
                    base_content = f.content;
                    base_done = true;
                }
            }
            if (base_done) {
                break;
            }
        } else {
            return Result<Found, Error>.Err(Error.BadPack);
        }
    }
    bytes content = base_content;
    int i = chain.size() - 1;
    while (i >= 0) {
        content = apply_delta(content, chain[i])?;
        i = i - 1;
    }
    return Result<Found, Error>.Ok(Found(base_kind, content));
}

// `blob`, `tree`, `commit` or `tag` for a packfile's 1..4 type code -- `""`
// for anything else, which `resolve_offset` never asks for (5, 6 and 7 are
// handled separately, and no other code exists).
str kind_name(int k) {
    if (k == 1) {
        return "commit";
    }
    if (k == 2) {
        return "tree";
    }
    if (k == 3) {
        return "blob";
    }
    if (k == 4) {
        return "tag";
    }
    return "";
}

// --- a delta stream: copy from the base, or insert a literal -----------------

// `base_size`, `result_size` (each a plain 7-bit-group varint, least
// significant group first, unlike the packed object header's, which starts
// with a special 4-bit group -- the two encodings are easy to conflate and
// are not the same), then instructions to the end: a high bit set is a COPY
// (the low 7 bits of the opcode say which of up to 4 offset octets and 3 size
// octets follow, least significant octet first; a size of 0 means the one
// value the 3 octets cannot spell, 0x10000); a high bit clear and a nonzero
// opcode is an INSERT of that many literal octets, taken from the delta
// stream itself; zero is reserved and no writer emits it.
Result<bytes, Error> apply_delta(bytes base, bytes delta) {
    int n = delta.size();
    int pos = 0;
    int shift = 0;
    int base_size = 0;
    int c = 0;
    while (true) {
        if (pos >= n) {
            return Result<bytes, Error>.Err(Error.BadDelta);
        }
        c = delta[pos];
        pos = pos + 1;
        if (shift > 63) {
            return Result<bytes, Error>.Err(Error.BadDelta);
        }
        base_size = base_size | (c & 0x7F) << shift;
        shift = shift + 7;
        if ((c & 0x80) == 0) {
            break;
        }
    }
    shift = 0;
    int result_size = 0;
    while (true) {
        if (pos >= n) {
            return Result<bytes, Error>.Err(Error.BadDelta);
        }
        c = delta[pos];
        pos = pos + 1;
        if (shift > 63) {
            return Result<bytes, Error>.Err(Error.BadDelta);
        }
        result_size = result_size | (c & 0x7F) << shift;
        shift = shift + 7;
        if ((c & 0x80) == 0) {
            break;
        }
    }
    if (base_size != base.size()) {
        return Result<bytes, Error>.Err(Error.BadDelta);
    }
    bytes out = [];
    while (pos < n) {
        c = delta[pos];
        pos = pos + 1;
        if ((c & 0x80) != 0) {
            int offset = 0;
            int size = 0;
            if ((c & 0x01) != 0) {
                if (pos >= n) {
                    return Result<bytes, Error>.Err(Error.BadDelta);
                }
                offset = offset | delta[pos];
                pos = pos + 1;
            }
            if ((c & 0x02) != 0) {
                if (pos >= n) {
                    return Result<bytes, Error>.Err(Error.BadDelta);
                }
                offset = offset | delta[pos] << 8;
                pos = pos + 1;
            }
            if ((c & 0x04) != 0) {
                if (pos >= n) {
                    return Result<bytes, Error>.Err(Error.BadDelta);
                }
                offset = offset | delta[pos] << 16;
                pos = pos + 1;
            }
            if ((c & 0x08) != 0) {
                if (pos >= n) {
                    return Result<bytes, Error>.Err(Error.BadDelta);
                }
                offset = offset | delta[pos] << 24;
                pos = pos + 1;
            }
            if ((c & 0x10) != 0) {
                if (pos >= n) {
                    return Result<bytes, Error>.Err(Error.BadDelta);
                }
                size = size | delta[pos];
                pos = pos + 1;
            }
            if ((c & 0x20) != 0) {
                if (pos >= n) {
                    return Result<bytes, Error>.Err(Error.BadDelta);
                }
                size = size | delta[pos] << 8;
                pos = pos + 1;
            }
            if ((c & 0x40) != 0) {
                if (pos >= n) {
                    return Result<bytes, Error>.Err(Error.BadDelta);
                }
                size = size | delta[pos] << 16;
                pos = pos + 1;
            }
            if (size == 0) {
                size = 0x10000;
            }
            if (offset < 0 || size < 0 || offset + size > base.size()) {
                return Result<bytes, Error>.Err(Error.BadDelta);
            }
            out.extend(base.substr(offset, offset + size));
        } else if (c != 0) {
            if (pos + c > n) {
                return Result<bytes, Error>.Err(Error.BadDelta);
            }
            out.extend(delta.substr(pos, pos + c));
            pos = pos + c;
        } else {
            return Result<bytes, Error>.Err(Error.BadDelta);
        }
    }
    if (out.size() != result_size) {
        return Result<bytes, Error>.Err(Error.BadDelta);
    }
    return Result<bytes, Error>.Ok(out);
}

// --- one packed object's own header, and the zlib stream after it -----------

// The type code (1 commit, 2 tree, 3 blob, 4 tag, 6 `OBJ_OFS_DELTA`, 7
// `OBJ_REF_DELTA` -- 5 is reserved), the declared inflated size (the object's
// own content length for a real object, or the delta stream's length for a
// delta -- neither is checked against what actually comes out, for the reason
// the module header gives), and how many octets the encoding itself took, so
// the caller knows where whatever follows (an `OBJ_OFS_DELTA` offset, an
// `OBJ_REF_DELTA` id, or straight into the zlib stream) begins.
type ObjHeader {
    int kind;
    int size;
    int header_len;
}

Result<ObjHeader, Error> read_obj_header(bytes pack, int offset) {
    int n = pack.size();
    if (offset < 0 || offset >= n) {
        return Result<ObjHeader, Error>.Err(Error.BadPack);
    }
    int c = pack[offset];
    int kind = c >> 4 & 0x7;
    int size = c & 0xF;
    int shift = 4;
    int i = offset + 1;
    while ((c & 0x80) != 0) {
        if (i >= n) {
            return Result<ObjHeader, Error>.Err(Error.BadPack);
        }
        c = pack[i];
        i = i + 1;
        if (shift > 63) {
            return Result<ObjHeader, Error>.Err(Error.BadPack);
        }
        size = size | (c & 0x7F) << shift;
        shift = shift + 7;
    }
    return Result<ObjHeader, Error>.Ok(ObjHeader(kind, size, i - offset));
}

// `zlib.decompress_at`, with its `Error` folded into this module's own --
// every packed object's stream is a full RFC 1950 stream, exactly like a
// loose object's (the module header says why `decompress_at` and not
// `inflate_at` is what belongs here).
Result<zlib.Decoded, Error> inflate_pack_zlib(bytes pack, int start) {
    match (zlib.decompress_at(pack, start)) {
        case Ok(zlib.Decoded d): {
            return Result<zlib.Decoded, Error>.Ok(d);
        }
        case Err(zlib.Error e): {
            return Result<zlib.Decoded, Error>.Err(Error.Zlib);
        }
    }
}

// --- the `.idx`, format v2 ----------------------------------------------------

// A parsed `.idx`: `data` held onto (no copy -- `bytes` is a reference type),
// and the three offsets into it that `offset_of`/`all_ids` need. The fanout
// table itself is always at `8 .. 8 + 1024`, so it needs no field of its own.
type Idx {
    bytes data;
    int n;
    int names_off;
    int off_off;
    int large_off;
}

/// The pack offset of `id20` (20 raw octets), by binary search within the
/// fanout slice its first octet selects, or `None` if this `.idx` does not
/// name it.
Option<int> Idx.offset_of(bytes id20) {
    if (id20.size() != 20) {
        return Option<int>.None;
    }
    int first = id20[0];
    int lo = 0;
    if (first > 0) {
        lo = u32be(data, 8 + (first - 1) * 4);
    }
    int hi = u32be(data, 8 + first * 4);
    while (lo < hi) {
        int mid = lo + (hi - lo) / 2;
        int c = cmp20(data, names_off + mid * 20, id20);
        if (c == 0) {
            return Option<int>.Some(offset_at(mid));
        } else if (c < 0) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return Option<int>.None;
}

// The `i`th object's pack offset. The top bit of the 4-byte small offset is
// not part of the offset -- it flags that the low 31 bits are an INDEX into
// the 8-byte large-offset table instead, for a pack whose object lives past
// 2 GB in. An index landing outside that table (which this format cannot
// produce, only a corrupt file can) answers -1, which `resolve_offset`'s own
// bounds check on a negative offset turns into `Error.BadPack` rather than an
// out-of-range read.
int Idx.offset_at(int i) {
    int v = u32be(data, off_off + i * 4);
    if ((v & 0x80000000) != 0) {
        int li = v & 0x7FFFFFFF;
        int at = large_off + li * 8;
        if (at + 8 > data.size()) {
            return -1;
        }
        return u64be(data, at);
    }
    return v;
}

/// Every id this `.idx` names, in its own sorted order.
List<str> Idx.all_ids() {
    List<str> out = [];
    int i = 0;
    while (i < n) {
        out.push(data.substr(names_off + i * 20, names_off + i * 20 + 20).hex());
        i = i + 1;
    }
    return out;
}

Result<Idx, Error> parse_idx(bytes data) {
    if (data.size() < 8) {
        return Result<Idx, Error>.Err(Error.BadIdx);
    }
    bool magic = data[0] == 0xFF && data[1] == 0x74 && data[2] == 0x4F && data[3] == 0x63;
    if (!magic) {
        return Result<Idx, Error>.Err(Error.UnsupportedIdx);
    }
    int version = u32be(data, 4);
    if (version != 2) {
        return Result<Idx, Error>.Err(Error.UnsupportedIdx);
    }
    if (data.size() < 8 + 1024) {
        return Result<Idx, Error>.Err(Error.BadIdx);
    }
    int n = u32be(data, 8 + 255 * 4);
    if (n < 0) {
        return Result<Idx, Error>.Err(Error.BadIdx);
    }
    int names_off = 8 + 1024;
    int crc_off = names_off + 20 * n;
    int off_off = crc_off + 4 * n;
    int large_off = off_off + 4 * n;
    // At least the trailing pack and idx checksums (20 octets each) must
    // follow the small-offset table, whether or not any entry needs the
    // large-offset table between them.
    if (large_off + 40 > data.size()) {
        return Result<Idx, Error>.Err(Error.BadIdx);
    }
    return Result<Idx, Error>.Ok(Idx(data, n, names_off, off_off, large_off));
}

// --- small things the standard library does not have -------------------------

// A big-endian 32-bit field as a non-negative `int` -- the top 32 bits are
// always zero, since `int` is 64 bits and this only ever ORs in the low 32.
int u32be(bytes b, int at) {
    return b[at] << 24 | b[at + 1] << 16 | b[at + 2] << 8 | b[at + 3];
}

// A big-endian 64-bit field. Git's own offsets never reach the top bit (a
// pack cannot be `2^63` octets), so this never needs to be read as signed.
int u64be(bytes b, int at) {
    int v = 0;
    int i = 0;
    while (i < 8) {
        v = v << 8 | b[at + i];
        i = i + 1;
    }
    return v;
}

// Lexicographic comparison of the 20 octets at `data[off .. off+20]` against
// `id20`, negative/zero/positive -- `object.m31`'s `cmp_bytes` over a fixed
// width and without the `bytes.substr` copy a general comparison would need,
// since this runs once per binary-search step.
int cmp20(bytes data, int off, bytes id20) {
    int i = 0;
    while (i < 20) {
        int d = data[off + i] - id20[i];
        if (d != 0) {
            return d;
        }
        i = i + 1;
    }
    return 0;
}

// 40 lowercase hex digits to the 20 octets they spell -- `object.m31`'s and
// `index.m31`'s own private helper, duplicated for the same reason `find`
// above is: this module does not import either.
bytes hex_decode(str s) {
    bytes out = [];
    int i = 0;
    while (i + 1 < s.size()) {
        out.push(hex_val(s.byte_at(i)) << 4 | hex_val(s.byte_at(i + 1)));
        i = i + 2;
    }
    return out;
}

int hex_val(int c) {
    if (c >= '0' && c <= '9') {
        return c - '0';
    }
    if (c >= 'a' && c <= 'f') {
        return c - 'a' + 10;
    }
    if (c >= 'A' && c <= 'F') {
        return c - 'A' + 10;
    }
    return 0;
}
