// `.git/index`: what is staged, and what git believes about it without
// re-reading the working tree.
//
// The index is a flat, sorted array of entries -- one per staged path, not a
// tree -- each holding a blob's SHA-1 and a `stat(2)` snapshot from when it
// was staged. That snapshot is the whole reason the file exists: comparing a
// working-tree file's size and mtime against it is far cheaper than reading
// and hashing the file, and is safe precisely because a change to either
// number is what the file system promises on a write (`status.m31` is the
// caller that leans on this).
//
// Layout (`Documentation/gitformat-index.txt`, version 2, the common case):
//
//     "DIRC"  version:u32  count:u32          -- 12-byte header
//     entry * count                            -- sorted by path, then stage
//     extension *                              -- signature:4  size:u32  data
//     sha1(everything above)                    -- 20-byte trailer
//
// Each entry is ctime, mtime (seconds and nanoseconds, four fields), dev,
// ino, mode, uid, gid, file size (nine 32-bit fields), the blob's 20-octet
// SHA-1, a 16-bit flags word (assume-valid, extended, a 2-bit merge stage,
// a 12-bit name length), the path, and NUL padding out to a multiple of 8
// octets counted from the start of the entry -- see `read_entry` for the
// exact arithmetic, which is git's own and not a round number.
//
// API
// ---
//   index.read(gitdir)         -> Result<Index, Error>
//   index.parse(data)          -> Result<Index, Error>   (no I/O)
//   index.write(gitdir, ix)    -> Result<bool, Error>
//   index.encode(ix)           -> bytes                  (no I/O)
//
// --- what this does not have to get right ------------------------------------
//
// `dev`, `ino`, `uid` and `gid` are always written as 0: `fs.stat` (this
// standard library's only window on a file) does not report them at all
// (`runtime/sys.h`'s `SysStat` has exactly `size`, `mode`, `mtime_ns`), and
// there is no primitive here to ask for the rest. `ctime` is written equal to
// `mtime`, for the same reason -- there is no separate ctime to read. This is
// a real gap against a byte-for-byte index real git would have written, and a
// deliberate one: every one of those fields is an optimisation git itself
// falls back from safely. A `dev`/`ino` mismatch, or a zeroed one, only ever
// costs a re-hash it would otherwise have skipped (`read-cache.c`'s own
// `ce_match_stat`); it is never trusted on its own to mean "unchanged" the way
// `mtime` and `size` together are (`status.m31` implements exactly that
// shortcut, and only that one). So an index this module writes is safe for
// real git to read -- slower on its next `status`, in exchange for every
// entry it has to re-hash once, never wrong.
//
// Versions 3 and 4 are not implemented. A version-3 entry differs from
// version 2 only by an extra 16-bit "extended flags" word when the entry's
// own extended bit is set, which costs nothing extra to read, so it is
// handled here regardless of the file's declared version. Version 4's
// whole-file prefix-compressed pathnames are a different entry encoding
// altogether and are refused (`Error.BadVersion`) rather than misread --
// silently decoding a v4 index as if it were v2 would produce entries with
// wrong, truncated paths, which is worse than refusing to open it. Every
// extension block (`TREE`, `REUC`, `UNTR`, `link`, and any this has never
// heard of) is skipped by its own declared size rather than by name, and
// none is written back: a round trip through this module keeps the entries
// and drops every extension, cache-tree included, which only ever costs real
// git a cache it can rebuild.

import io;
import fs;
import repo;
import sha1;
import random;

/// Why an index could not be read or believed. Payload-free
/// (docs/errors-decision.md §4): the offset or the extension's signature is
/// context the caller already has, from the same read that produced this.
pub enum Error {
    /// There is no index file yet -- an empty repository, or one nothing has
    /// ever been staged in.
    NotFound;
    /// The file is there and could not be read, or could not be written.
    Io;
    /// The first four octets are not `DIRC`.
    BadSignature;
    /// A version this does not read: anything but 2 or 3.
    BadVersion;
    /// The file ends in the middle of an entry, an extension header, or the
    /// trailing checksum.
    Truncated;
    /// An extension's declared size runs past the end of the file.
    BadExtension;
    /// The trailing SHA-1 does not match the bytes before it: the index is
    /// corrupt.
    Checksum;
}

pub str Error.to_str() {
    match (this) {
        case NotFound: {
            return "no index file";
        }
        case Io: {
            return "the index file could not be read or written";
        }
        case BadSignature: {
            return "not an index file: missing the 'DIRC' signature";
        }
        case BadVersion: {
            return "index format version is not 2 or 3 (version 4's compressed names are not read here)";
        }
        case Truncated: {
            return "the index ends in the middle of an entry or an extension";
        }
        case BadExtension: {
            return "an extension's declared size runs past the end of the file";
        }
        case Checksum: {
            return "the index's trailing SHA-1 does not match its contents: the index is corrupt";
        }
    }
}

/// One staged path: a blob, the `stat(2)` snapshot from when it was staged,
/// and the merge machinery's own two bits. `path` is `bytes`, not `str`, for
/// `object.m31`'s reason (its own module header): a path is whatever octets
/// the filesystem gave git, and no caller of this one is required to prove
/// they are UTF-8 before staging them.
pub type Entry {
    pub int ctime_s;
    pub int ctime_ns;
    pub int mtime_s;
    pub int mtime_ns;
    pub int dev;
    pub int ino;
    /// The full mode, exactly as `object.Entry.mode` is: 0o100644, 0o100755,
    /// 0o120000 or 0o160000 (a submodule's gitlink), never a tree.
    pub int mode;
    pub int uid;
    pub int gid;
    pub int size;
    /// The blob's 40-digit name.
    pub str id;
    /// 0 for an ordinary entry; 1, 2 or 3 name the three sides of a conflict
    /// git has not asked to resolve yet ("ours", "theirs", the merge base).
    /// `write` never produces anything but 0.
    pub int stage;
    pub bool assume_valid;
    pub bytes path;
}

/// Is the staged mode a symlink?
pub bool Entry.is_link() {
    return mode >> 12 == 0o12;
}

/// Is it a submodule -- a commit staged inside a tree?
pub bool Entry.is_gitlink() {
    return mode >> 12 == 0o16;
}

/// Entries sort by path first and by stage second, which is the index
/// format's own order (`read_entry` relies on nothing about the order it is
/// handed; `write` imposes this with `sort()` before encoding).
pub int Entry.cmp(Entry other) {
    int c = cmp_bytes(path, other.path);
    if (c != 0) {
        return c;
    }
    return stage - other.stage;
}

/// The whole index: every staged entry, in the file's own order.
pub type Index {
    pub List<Entry> entries;
}

/// The index of the repository whose git directory is `gitdir`. `NotFound`
/// for a repository with nothing staged yet -- not an error a caller should
/// print, just "there is no index", which `status.m31` treats as an empty
/// one.
pub Result<Index, Error> read(str gitdir) {
    str path = fs.join(repo.common(gitdir), "index");
    bytes data = [];
    match (io.read_bytes(path)) {
        case Ok(bytes b): {
            data = b;
        }
        case Err(io.Error e): {
            if (!fs.exists(path)) {
                return Result<Index, Error>.Err(Error.NotFound);
            }
            return Result<Index, Error>.Err(Error.Io);
        }
    }
    return parse(data);
}

/// An index from its raw bytes -- no I/O, so a fixture or a test can hand
/// this whatever it likes.
pub Result<Index, Error> parse(bytes data) {
    if (data.size() < 32) {
        return Result<Index, Error>.Err(Error.Truncated);
    }
    if (!(data[0] == 'D' && data[1] == 'I' && data[2] == 'R' && data[3] == 'C')) {
        return Result<Index, Error>.Err(Error.BadSignature);
    }
    int version = be32(data, 4);
    if (version != 2 && version != 3) {
        return Result<Index, Error>.Err(Error.BadVersion);
    }
    int count = be32(data, 8);
    int end = data.size() - 20;
    if (end < 12) {
        return Result<Index, Error>.Err(Error.Truncated);
    }
    bytes body = data.substr(0, end);
    bytes want = data.substr(end, data.size());
    if (sha1.sum(body).hex() != want.hex()) {
        return Result<Index, Error>.Err(Error.Checksum);
    }
    List<Entry> entries = [];
    int at = 12;
    for (int i in 0 .. count) {
        Parsed p = read_entry(data, at, end)?;
        entries.push(p.entry);
        at = p.next;
    }
    while (end - at >= 8) {
        int size = be32(data, at + 4);
        int next = at + 8 + size;
        if (size < 0 || next > end) {
            return Result<Index, Error>.Err(Error.BadExtension);
        }
        at = next;
    }
    if (at != end) {
        return Result<Index, Error>.Err(Error.Truncated);
    }
    return Result<Index, Error>.Ok(Index(entries));
}

// One entry, and the offset just past it (already padded).
type Parsed {
    Entry entry;
    int next;
}

Result<Parsed, Error> read_entry(bytes data, int at, int end) {
    if (at + 62 > end) {
        return Result<Parsed, Error>.Err(Error.Truncated);
    }
    int ctime_s = be32(data, at);
    int ctime_ns = be32(data, at + 4);
    int mtime_s = be32(data, at + 8);
    int mtime_ns = be32(data, at + 12);
    int dev = be32(data, at + 16);
    int ino = be32(data, at + 20);
    int mode = be32(data, at + 24);
    int uid = be32(data, at + 28);
    int gid = be32(data, at + 32);
    int size = be32(data, at + 36);
    bytes id = data.substr(at + 40, at + 60);
    int flags = be16(data, at + 60);
    int stage = flags >> 12 & 0x3;
    bool assume_valid = flags & 0x8000 != 0;
    bool extended = flags & 0x4000 != 0;
    int path_start = at + 62;
    if (extended) {
        path_start = path_start + 2;
    }
    if (path_start > end) {
        return Result<Parsed, Error>.Err(Error.Truncated);
    }
    int nul = find(data, 0, path_start, end);
    if (nul < 0) {
        return Result<Parsed, Error>.Err(Error.Truncated);
    }
    bytes path = data.substr(path_start, nul);
    // The record from `at` through the terminating NUL, inclusive, rounded up
    // to the next multiple of 8 -- git's own padding rule (`read-cache.c`'s
    // `ondisk_size`), which always leaves at least the one NUL already
    // counted and never fewer.
    int through_nul = nul + 1 - at;
    int padded = through_nul;
    if (padded % 8 != 0) {
        padded = padded + (8 - padded % 8);
    }
    int next = at + padded;
    if (next > end) {
        return Result<Parsed, Error>.Err(Error.Truncated);
    }
    Entry e = Entry(ctime_s, ctime_ns, mtime_s, mtime_ns, dev, ino, mode, uid, gid, size, id.hex(), stage, assume_valid, path);
    return Result<Parsed, Error>.Ok(Parsed(e, next));
}

/// A fresh, stage-0 entry for a regular file or a symlink: `fs.stat`'s
/// numbers, `is_link` (which the caller must supply -- `fs.stat` itself
/// follows a symlink, so its `mode` is the *target's* type, not the entry
/// being staged's), and the blob's name already computed and written
/// elsewhere (`object.write_blob`). `dev`, `ino`, `uid` and `gid` are 0 and
/// `ctime` is set equal to `mtime`; see the module header for why that is
/// safe.
pub Entry from_stat(bytes path, fs.Stat st, bool is_link, str blob_id) {
    int mode = 0o100644;
    if (is_link) {
        mode = 0o120000;
    } else if (st.perm() & 0o111 != 0) {
        mode = 0o100755;
    }
    int s = st.mtime_ns / 1_000_000_000;
    int ns = st.mtime_ns % 1_000_000_000;
    return Entry(s, ns, s, ns, 0, 0, mode, 0, 0, st.size, blob_id, 0, false, path);
}

/// The index of the repository whose git directory is `gitdir`, written
/// atomically: a temporary file beside `.git/index`, written whole, then
/// renamed over it, so a reader never opens a half-written index and a crash
/// mid-write leaves the old one intact -- the same discipline `refs.m31` uses
/// for a ref.
pub Result<bool, Error> write(str gitdir, Index ix) {
    bytes out = encode(ix);
    str path = fs.join(repo.common(gitdir), "index");
    random.System rnd = random.system();
    str tmp = path + ".tmp" + rnd.hex(12);
    match (io.write_bytes(tmp, out)) {
        case Ok: {
        }
        case Err(io.Error e): {
            return Result<bool, Error>.Err(Error.Io);
        }
    }
    match (fs.rename(tmp, path)) {
        case Ok: {
            return Result<bool, Error>.Ok(true);
        }
        case Err(io.Error e): {
            return Result<bool, Error>.Err(Error.Io);
        }
    }
}

/// `ix`, as the bytes of a version-2 index file, checksum included -- no I/O,
/// so a test can check this against a fixture byte for byte without touching
/// a filesystem. Entries are sorted into the format's own order first
/// (`Entry.cmp`); a caller need not have sorted them.
pub bytes encode(Index ix) {
    List<Entry> sorted = clone(ix.entries);
    sorted.sort();
    bytes out = [];
    out.extend("DIRC".to_bytes());
    push_be32(out, 2);
    push_be32(out, sorted.size());
    for (Entry e in sorted) {
        encode_entry(out, e);
    }
    bytes sum = sha1.sum(out);
    out.extend(sum);
    return out;
}

// One entry, version-2 shape: no extended-flags word, `stage` folded into the
// flags, and NUL padding to the next multiple of 8 counted from the start of
// the entry -- the exact inverse of `read_entry`'s arithmetic.
void encode_entry(bytes out, Entry e) {
    int start = out.size();
    push_be32(out, e.ctime_s);
    push_be32(out, e.ctime_ns);
    push_be32(out, e.mtime_s);
    push_be32(out, e.mtime_ns);
    push_be32(out, e.dev);
    push_be32(out, e.ino);
    push_be32(out, e.mode);
    push_be32(out, e.uid);
    push_be32(out, e.gid);
    push_be32(out, e.size);
    out.extend(hex_decode(e.id));
    int namelen = e.path.size();
    int lenfield = namelen;
    if (lenfield > 0x0FFF) {
        lenfield = 0x0FFF;
    }
    int flags = (e.stage & 0x3) << 12 | lenfield;
    if (e.assume_valid) {
        flags = flags | 0x8000;
    }
    push_be16(out, flags);
    out.extend(e.path);
    int through_nul = out.size() - start + 1;
    int padded = through_nul;
    if (padded % 8 != 0) {
        padded = padded + (8 - padded % 8);
    }
    int nuls = padded - (out.size() - start);
    for (int i in 0 .. nuls) {
        out.push(0);
    }
}

// --- small helpers, the way object.m31 and refs.m31 each write their own ----

int be32(bytes b, int at) {
    return b[at] << 24 | b[at + 1] << 16 | b[at + 2] << 8 | b[at + 3];
}

int be16(bytes b, int at) {
    return b[at] << 8 | b[at + 1];
}

void push_be32(bytes out, int v) {
    out.push(v >> 24 & 0xFF);
    out.push(v >> 16 & 0xFF);
    out.push(v >> 8 & 0xFF);
    out.push(v & 0xFF);
}

void push_be16(bytes out, int v) {
    out.push(v >> 8 & 0xFF);
    out.push(v & 0xFF);
}

// The first octet `b` at or after `from` and before `upto`, or -1.
int find(bytes hay, int b, int from, int upto) {
    int i = from;
    while (i < upto) {
        if (hay[i] == b) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// 40 lowercase hex digits to the 20 octets they spell -- `object.m31`'s own
// helper, needed here too and not shared, the way `find`/`ascii`/`decimal`
// are each written out per module rather than pulled into a shared utility.
bytes hex_decode(str s) {
    bytes out = [];
    int i = 0;
    while (i + 1 < s.size()) {
        out.push(hex_val(s.byte_at(i)) << 4 | hex_val(s.byte_at(i + 1)));
        i = i + 2;
    }
    return out;
}

int hex_val(int c) {
    if (c >= '0' && c <= '9') {
        return c - '0';
    }
    if (c >= 'a' && c <= 'f') {
        return c - 'a' + 10;
    }
    if (c >= 'A' && c <= 'F') {
        return c - 'A' + 10;
    }
    return 0;
}

// Byte comparison of two runs, negative/zero/positive.
int cmp_bytes(bytes a, bytes b) {
    int n = a.size();
    if (b.size() < n) {
        n = b.size();
    }
    for (int i in 0 .. n) {
        if (a[i] != b[i]) {
            return a[i] - b[i];
        }
    }
    return a.size() - b.size();
}
