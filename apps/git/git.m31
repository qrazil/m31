// A read-only git plumbing client: `cat-file`, `ls-tree`, `log`, `rev-parse`
// and `refs`, over loose objects only.
//
//   ./build.sh apps/git/git.m31 -o ourgit
//
//   ourgit -cat-file --type <object>
//   ourgit -cat-file --size <object>
//   ourgit -cat-file <object>              # --pretty is the default
//   ourgit -ls-tree <tree>
//   ourgit -log [--max N] [<rev>]
//   ourgit -rev-parse <rev>
//   ourgit -refs
//   ourgit [--git-dir DIR] ...             # default: `.git` here or above
//
// --- why the command is `-cat-file` and not `cat-file` ------------------------
//
// `lib/args` has one grammar and it is not git's: a command is `-word`, an
// option is `--word`, and anything else is data (its module header argues for
// this at length). So `git cat-file -t X` is spelled `ourgit -cat-file --type
// X` here. Writing git's own spelling would have meant not using `lib/args`,
// which was the point of the exercise; what it costs is that no muscle memory
// transfers. See FRICTION.md.
//
// --- the output is git's, octet for octet -------------------------------------
//
// `apps/git/compare.sh` runs each of these beside the real `git` on a real
// repository and diffs the bytes. Where this program prints something git
// does not, or spells a date differently, that script fails. Two deliberate
// pins, both because the alternative is a moving target rather than a format:
//
//   - abbreviated object names in a `Merge:` line are seven digits, where git
//     derives a length from how many objects the repository has. The
//     comparison runs git with `-c core.abbrev=7`.
//   - there is no `.mailmap`, no `log.decorate`, no colour and no pager,
//     because there is no configuration at all.

import args;
import io;
import os;
import fs;
import date;
import text;
import object;
import refs;
import repo;
import gitlog;

args.Parser p = args.Parser("ourgit", summary: "read-only git plumbing over loose objects");
p.value("git-dir", help: "the repository's git directory", placeholder: "DIR");
args.Parser cat = p.command("cat-file", "print an object's type, size or contents");
cat.flag("type", help: "print the object's type word");
cat.flag("size", help: "print the size of the object's content");
cat.flag("pretty", help: "print the object itself (the default)");
cat.positional("object", help: "an object name, or an unambiguous prefix of one", placeholder: "OBJECT");
args.Parser ls = p.command("ls-tree", "list a tree's entries");
ls.positional("tree", help: "a tree, or a commit whose tree to list", placeholder: "TREE");
args.Parser lg = p.command("log", "commits reachable from a revision, newest commit date first");
lg.integer("max", help: "stop after this many commits", placeholder: "N");
lg.optional("rev", "HEAD", help: "where to start", placeholder: "REV");
args.Parser rp = p.command("rev-parse", "the object name a revision resolves to");
rp.positional("rev", help: "a ref, or an object name", placeholder: "REV");
args.Parser rf = p.command("refs", "every ref in the repository, with what it points at");
List<str> argv = os.args();
match (p.parse(argv.slice(1, argv.size()))) {
    case Ok(args.Parsed r): {
        match (r.help()) {
            case Some(str h): {
                print(h);
            }
            case None: {
                os.exit(dispatch(p, r));
            }
        }
    }
    case Err(args.UsageError e): {
        io.eprint(e.to_str());
        io.eprint(p.usage());
        os.exit(2);
    }
}

/// Run every command on the line, in the order it was typed. The exit status
/// is 0 only if all of them worked.
///
/// The parser is a parameter because it cannot be anything else: it is built
/// at the top level, and the top level's variables are locals of the program
/// body that no function can see (reference §2). There is no module state to
/// put it in. See FRICTION.md.
int dispatch(args.Parser parser, args.Parsed r) {
    str gd = "";
    match (r.value("git-dir")) {
        case Some(str d): {
            gd = d;
        }
        case None: {
            match (discover(".")) {
                case Some(str d): {
                    gd = d;
                }
                case None: {
                    io.eprint("not a git repository (or any parent up to /): no .git directory");
                    return 128;
                }
            }
        }
    }
    List<args.Parsed> cmds = r.commands();
    if (cmds.size() == 0) {
        io.eprint(parser.usage());
        return 2;
    }
    int status = 0;
    for (args.Parsed c in cmds) {
        int rc = 0;
        if (c.word() == "cat-file") {
            rc = cat_file(gd, c);
        } else if (c.word() == "ls-tree") {
            rc = ls_tree(gd, c.positional("tree"));
        } else if (c.word() == "log") {
            rc = log(gd, c);
        } else if (c.word() == "rev-parse") {
            rc = rev_parse(gd, c.positional("rev"));
        } else {
            rc = list_refs(gd);
        }
        if (rc != 0) {
            status = rc;
        }
    }
    return status;
}

// --- the commands ------------------------------------------------------------

int cat_file(str gd, args.Parsed c) {
    str spec = c.positional("object");
    str id = "";
    match (refs.rev_parse(gd, spec)) {
        case Ok(str v): {
            id = v;
        }
        case Err(refs.Error e): {
            io.eprint(e.to_str());
            return 1;
        }
    }
    match (object.read(gd, id)) {
        case Ok(object.Object o): {
            if (c.flag("type")) {
                say(o.kind());
                return 0;
            }
            if (c.flag("size")) {
                say(o.raw.size().to_str());
                return 0;
            }
            match (o.body) {
                case Tree(List<object.Entry> es): {
                    write(tree_text(es));
                }
                case Blob: {
                    write(o.raw);
                }
                case Commit: {
                    write(o.raw);
                }
                case Tag: {
                    write(o.raw);
                }
            }
            return 0;
        }
        case Err(object.Error e): {
            io.eprint(e.to_str());
            return 1;
        }
    }
}

int ls_tree(str gd, str spec) {
    str id = "";
    match (refs.rev_parse(gd, spec)) {
        case Ok(str v): {
            id = v;
        }
        case Err(refs.Error e): {
            io.eprint(e.to_str());
            return 1;
        }
    }
    // `git ls-tree` takes a tree-ish, so a commit means its tree. A tag is
    // peeled to a commit first, and then the same rule applies.
    for (int hops in 0 .. 12) {
        match (object.read(gd, id)) {
            case Ok(object.Object o): {
                match (o.body) {
                    case Tree(List<object.Entry> es): {
                        write(tree_text(es));
                        return 0;
                    }
                    case Commit(object.Commit c): {
                        id = c.tree;
                    }
                    case Tag(object.Tag t): {
                        id = t.object;
                    }
                    case Blob: {
                        io.eprint("not a tree object: " + spec);
                        return 1;
                    }
                }
            }
            case Err(object.Error e): {
                io.eprint(e.to_str());
                return 1;
            }
        }
    }
    io.eprint("not a tree object: " + spec);
    return 1;
}

int rev_parse(str gd, str spec) {
    match (refs.rev_parse(gd, spec)) {
        case Ok(str id): {
            say(id);
            return 0;
        }
        case Err(refs.Error e): {
            io.eprint(e.to_str());
            return 1;
        }
    }
}

int list_refs(str gd) {
    match (refs.all(gd)) {
        case Ok(List<refs.Ref> rs): {
            for (refs.Ref one in rs) {
                say(one.id + " " + one.name);
            }
            return 0;
        }
        case Err(refs.Error e): {
            io.eprint(e.to_str());
            return 1;
        }
    }
}

int log(str gd, args.Parsed c) {
    str spec = c.optional("rev");
    int limit = -1;
    match (c.integer("max")) {
        case Some(int n): {
            limit = n;
        }
        case None: {
        }
    }
    // The walk itself -- git's date-ordered queue -- lives in `gitlog.m31`
    // now, shared with the interactive client (`gitui.m31`) so there is one
    // implementation of it rather than two (`apps/git/design.md`).
    match (gitlog.walk(gd, spec, limit)) {
        case Ok(List<gitlog.Entry> entries): {
            int shown = 0;
            for (gitlog.Entry en in entries) {
                // The blank line goes BETWEEN commits and not after each one:
                // git separates rather than terminates, so `log` of one
                // commit ends at the last line of its message.
                if (shown > 0) {
                    write("\n".to_bytes());
                }
                write(commit_text(en.id, en.commit));
                shown = shown + 1;
            }
            return 0;
        }
        case Err(gitlog.Error e): {
            io.eprint(e.to_str());
            return 1;
        }
    }
}

// --- formatting ---------------------------------------------------------------

// `git ls-tree` and `git cat-file -p` on a tree print the same four fields:
// the six-digit mode, the type word, the object name, a TAB, and the name --
// quoted if it needs it, which is why this builds `bytes` and not a `str`.
bytes tree_text(List<object.Entry> es) {
    bytes b = [];
    for (object.Entry e in es) {
        b.extend((e.mode_text() + " " + e.type_word() + " " + e.id + "\t").to_bytes());
        b.extend(quoted(e.name));
        b.push('\n');
    }
    return b;
}

// git's `quote_c_style`, which is what `core.quotePath` turns on and which
// is on by default.
//
// A name with nothing unusual in it is printed as it is. One containing a
// control character, a quote, a backslash, DEL, or any octet from 0x80 up is
// wrapped in double quotes and escaped C-style: the seven named escapes where
// there is one, a three-digit octal otherwise. So a UTF-8 name comes out as
// `"caf\303\251.txt"` -- the octets, not the characters, because git has no
// more idea than this does what encoding a path is in.
bytes quoted(bytes name) {
    bool need = false;
    for (int c in name) {
        if (c < ' ' || c == '"' || c == '\\' || c >= 127) {
            need = true;
        }
    }
    if (!need) {
        return name;
    }
    bytes b = [];
    b.push('"');
    for (int c in name) {
        if (c == 7) {
            escape(b, 97);
        } else if (c == 8) {
            escape(b, 98);
        } else if (c == '\t') {
            escape(b, 116);
        } else if (c == '\n') {
            escape(b, 110);
        } else if (c == 11) {
            escape(b, 118);
        } else if (c == 12) {
            escape(b, 102);
        } else if (c == '\r') {
            escape(b, 114);
        } else if (c == '"' || c == '\\') {
            escape(b, c);
        } else if (c < ' ' || c >= 127) {
            b.push('\\');
            b.push(48 + (c >> 6 & 7));
            b.push(48 + (c >> 3 & 7));
            b.push(48 + (c & 7));
        } else {
            b.push(c);
        }
    }
    b.push('"');
    return b;
}

void escape(bytes b, int c) {
    b.push('\\');
    b.push(c);
}

// One commit in `git log`'s default format.
bytes commit_text(str id, object.Commit c) {
    bytes b = [];
    b.extend(("commit " + id + "\n").to_bytes());
    if (c.parents.size() > 1) {
        str line = "Merge:";
        for (str par in c.parents) {
            line = line + " " + par.substr(0, 7);
        }
        b.extend((line + "\n").to_bytes());
    }
    b.extend("Author: ".to_bytes());
    b.extend(c.author.name);
    b.extend(" <".to_bytes());
    b.extend(c.author.email);
    b.extend((">\nDate:   " + stamp(c.author) + "\n\n").to_bytes());
    b.extend(indented(c.message));
    // git's `pretty_print_commit` trims trailing whitespace from the WHOLE
    // buffer and then `show_log` writes one newline. That is why a commit
    // whose message ends in blank lines shows none of them, why trailing
    // spaces on the last line are gone while the same spaces on a blank line
    // in the middle survive as an indent, and why a commit with no message at
    // all has no blank line after its `Date:`.
    int n = b.size();
    while (n > 0 && blank_octet(b[n - 1])) {
        n = n - 1;
    }
    b.truncate(n);
    b.push('\n');
    return b;
}

bool blank_octet(int c) {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 11 || c == 12;
}

const Array<str> WEEKDAY = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
const Array<str> MONTH = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

// `Tue Nov 14 21:43:20 2023 +0530`, which is git's `show_date` under
// `DATE_NORMAL`: the wall clock in the author's own zone, then the zone.
//
// The zone comes from the offset in minutes and not from the four characters
// the commit stored, because git does the same: it parses the field into a
// number and prints `%+05d` of it, so a commit written `-0000` prints
// `+0000`.
str stamp(object.Ident who) {
    date.Civil t = date.civil(who.when + who.offset * 60);
    return WEEKDAY[t.weekday] + " " + MONTH[t.month - 1] + " " + t.day.to_str() + " " + two(t.hour) + ":" + two(t.minute) + ":" + two(t.second) + " " + t.year.to_str() + " " + zone(who.offset);
}

str two(int v) {
    if (v < 10) {
        return "0" + v.to_str();
    }
    return v.to_str();
}

str zone(int minutes) {
    int m = minutes;
    str sign = "+";
    if (m < 0) {
        sign = "-";
        m = 0 - m;
    }
    return sign + two(m / 60) + two(m % 60);
}

// git's `pp_remainder` at indent 4, which is the `medium` format's body.
//
// Three rules, each of which is visible in `git log` and none of which is
// obvious:
//
//   - blank lines at the START of the message are dropped;
//   - a line that is ENTIRELY whitespace becomes the indent and nothing else,
//     so it comes out as four spaces -- trailing spaces on a line that has
//     content are left alone;
//   - TABS are expanded to the next multiple of eight, counting from the
//     start of the line's own text and NOT counting the four-space indent.
//     This is `--expand-tabs`, which is on by default for exactly the formats
//     that indent, and it is why `#\tsrc/lower.rs` in a commit message prints
//     with seven spaces and not with three.
bytes indented(bytes message) {
    bytes b = [];
    int at = 0;
    int n = message.size();
    bool first = true;
    while (at < n) {
        int e = at;
        while (e < n && message[e] != '\n') {
            e = e + 1;
        }
        int end = e;
        bool empty = true;
        for (int k in at .. e) {
            if (!blank_octet(message[k])) {
                empty = false;
            }
        }
        if (empty) {
            end = at;
            if (first) {
                at = e + 1;
                continue;
            }
        }
        first = false;
        b.extend("    ".to_bytes());
        int col = 0;
        for (int i in at .. end) {
            int c = message[i];
            if (c == '\t') {
                int width = 8 - col % 8;
                for (int s in 0 .. width) {
                    b.push(' ');
                }
                col = col + width;
            } else {
                b.push(c);
                col = col + 1;
            }
        }
        b.push('\n');
        at = e + 1;
    }
    return b;
}

// --- plumbing ------------------------------------------------------------------

void say(str s) {
    write((s + "\n").to_bytes());
}

void write(bytes b) {
    // `io.stdout()` afresh on every call, for the same reason `dispatch`
    // takes its parser as a parameter: a `File` held in a top-level local is
    // invisible inside a function, and the alternative was threading one
    // through every function that can print. It is safe -- closing a standard
    // stream's `File` marks that `File` closed and leaves the descriptor
    // alone (`lib/io.m31`, `File.release`).
    io.File out = io.stdout();
    match (out.write(b)) {
        case Ok: {
        }
        case Err: {
            // Standard output that will take no more is the end of the
            // program, not something to report through it -- a closed pipe is
            // the ordinary case, and git exits quietly on one too.
            os.exit(0);
        }
    }
}

// `.git` here, or in a parent, or the bare repository this already is.
Option<str> discover(str from) {
    str found = repo.find(from);
    if (found == "") {
        return Option<str>.None;
    }
    return Option<str>.Some(found);
}
