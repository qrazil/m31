// SHA-1 against Python's `hashlib`. Every digest this prints on stdout is
// printed again by `test.sh`'s Python twin, and the two files are diffed, so
// there is no expectation written down here that could drift from the
// standard -- the standard is the other program.
//
//   ./build.sh apps/git/t_sha1.src -o t_sha1 && ./t_sha1 [bigfile]
//
// With a file named on the command line it hashes that too, and reports the
// throughput on stderr, which is deliberately not on stdout: a timing is not
// something a diff can check.

import sha1;
import io;
import os;
import date;

// --- the three vectors everyone publishes ------------------------------------

print("empty " + sha1.hex("".to_bytes()));
print("abc " + sha1.hex("abc".to_bytes()));
print("448 " + sha1.hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".to_bytes()));

// --- every length from 0 to 200 ----------------------------------------------
//
// A deterministic pattern rather than random octets, so this case needs no
// fixture: the Python twin generates the same bytes from the same rule.

bytes pattern = [];
int n = 0;
while (n <= 200) {
    print("len" + n.to_str() + " " + sha1.hex(pattern));
    pattern.push(n * 7 + 13 & 0xFF);
    n = n + 1;
}

// --- the million-a test, whole and in pieces ---------------------------------
//
// The pieces matter more than the whole: `update` buffers a partial block and
// runs whole blocks straight out of the caller's buffer, so a chunk size that
// is not a multiple of 64 exercises a path the one-shot call never reaches.

bytes million = [97; 1_000_000];
print("million " + sha1.hex(million));

const Array<int> CHUNKS = [1, 3, 63, 64, 65, 1000, 4096];

for (int size in CHUNKS) {
    sha1.Hasher h = sha1.Hasher();
    int at = 0;
    while (at < million.size()) {
        int end = at + size;
        if (end > million.size()) {
            end = million.size();
        }
        h.update(million.substr(at, end));
        at = end;
    }
    print("million-by-" + size.to_str() + " " + h.digest().hex());
}

// --- a real file, if one was named -------------------------------------------

List<str> argv = os.args();
if (argv.size() > 1) {
    match (io.read_bytes(argv[1])) {
        case Ok(bytes data): {
            int t0 = date.now_ns();
            str got = sha1.hex(data);
            int ns = date.now_ns() - t0;
            print("file " + got);
            report(data.size(), ns);
        }
        case Err(io.Error e): {
            io.eprint("cannot read " + argv[1] + ": " + e.to_str());
        }
    }
}

// Throughput, on stderr, in whole MB/s -- computed in integers because a
// rounded megabyte per second is all anyone reads off a benchmark, and
// because `float` would drag the float-formatting module into a program that
// is otherwise pure integer work.
void report(int size, int ns) {
    if (ns <= 0) {
        return;
    }
    io.eprint("sha1: " + size.to_str() + " bytes in " + (ns / 1_000_000).to_str() + " ms = " + (size * 1_000 / ns).to_str() + " MB/s");
}
