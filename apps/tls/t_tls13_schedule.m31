// The TLS 1.3 key schedule (`lib/tls13_schedule.m31`) fed RFC 8448's traces.
// Every line this prints is printed again by `oracle_tls13_schedule.py`, which
// derives the same values from `hashlib`, `hmac` and the `cryptography`
// package's HKDF-Expand, and asserts RFC 8448's published ones against them.
// `test_tls13.sh` hands this program the RFC's messages as arguments:
//
//   shared_secret psk client_hello server_hello encrypted_extensions
//   certificate certificate_verify server_finished client_finished
//   psk_client_hello
//
//   ./build.sh apps/tls/t_tls13_schedule.m31 -o t_tls13_schedule
//   ./t_tls13_schedule <hex>...

import os;
import sha256;
import tls13_hex;
import tls13_schedule;

List<str> arguments = os.args();
if (arguments.size() != 11) {
    trap("t_tls13_schedule: expected 10 hex arguments");
}

type Trace {
    bytes shared_secret;
    bytes psk;
    bytes client_hello;
    bytes server_hello;
    bytes encrypted_extensions;
    bytes certificate;
    bytes certificate_verify;
    bytes server_finished;
    bytes client_finished;
    bytes psk_client_hello;
}

type Printer {
    str tag;
}

void Printer.show(str name, bytes value) {
    print(tag + name + " " + value.hex());
}

void Printer.show_keys(tls13_schedule.Suite suite, str name, bytes traffic_secret) {
    show(name + ".key", tls13_schedule.traffic_key(suite, traffic_secret));
    show(name + ".iv", tls13_schedule.traffic_iv(suite, traffic_secret));
    tls13_schedule.TrafficKeys both = tls13_schedule.traffic_keys(suite, traffic_secret);
    show(name + ".pair_key", both.key);
    show(name + ".pair_iv", both.iv);
}

void scenario(Trace trace, tls13_schedule.Suite suite, str label) {
    Printer out = Printer(label + ".");
    out.show("empty_hash", tls13_schedule.empty_hash(suite));
    // A full handshake without a PSK: RFC 8448 §3.
    bytes early = tls13_schedule.early_secret(suite, []);
    out.show("early", early);
    bytes handshake = tls13_schedule.handshake_secret(suite, early, trace.shared_secret);
    out.show("handshake", handshake);
    tls13_schedule.Transcript transcript = tls13_schedule.transcript();
    transcript.add(trace.client_hello);
    transcript.add(trace.server_hello);
    bytes hello_hash = transcript.digest(suite);
    out.show("hello_hash", hello_hash);
    out.show("hello_hash_again", transcript.digest(suite));
    bytes client_handshake = tls13_schedule.client_handshake_traffic_secret(suite, handshake, hello_hash);
    bytes server_handshake = tls13_schedule.server_handshake_traffic_secret(suite, handshake, hello_hash);
    out.show("client_handshake_traffic", client_handshake);
    out.show("server_handshake_traffic", server_handshake);
    out.show_keys(suite, "client_handshake", client_handshake);
    out.show_keys(suite, "server_handshake", server_handshake);
    out.show("client_finished_key", tls13_schedule.finished_key(suite, client_handshake));
    out.show("server_finished_key", tls13_schedule.finished_key(suite, server_handshake));
    transcript.add(trace.encrypted_extensions);
    transcript.add(trace.certificate);
    transcript.add(trace.certificate_verify);
    bytes verify_hash = transcript.digest(suite);
    out.show("verify_hash", verify_hash);
    out.show("server_verify_data", tls13_schedule.finished_verify_data(suite, tls13_schedule.finished_key(suite, server_handshake), verify_hash));
    transcript.add(trace.server_finished);
    bytes finished_hash = transcript.digest(suite);
    out.show("finished_hash", finished_hash);
    out.show("client_verify_data", tls13_schedule.finished_verify_data(suite, tls13_schedule.finished_key(suite, client_handshake), finished_hash));
    bytes master = tls13_schedule.master_secret(suite, handshake);
    out.show("master", master);
    bytes client_application = tls13_schedule.client_application_traffic_secret(suite, master, finished_hash);
    bytes server_application = tls13_schedule.server_application_traffic_secret(suite, master, finished_hash);
    out.show("client_application_traffic", client_application);
    out.show("server_application_traffic", server_application);
    out.show("exporter_master", tls13_schedule.exporter_master_secret(suite, master, finished_hash));
    out.show_keys(suite, "client_application", client_application);
    out.show_keys(suite, "server_application", server_application);
    transcript.add(trace.client_finished);
    out.show("resumption_master", tls13_schedule.resumption_master_secret(suite, master, transcript.digest(suite)));
    // KeyUpdate, RFC 8446 §7.2: twice, so that the second runs on the first's output.
    bytes client_next = tls13_schedule.next_traffic_secret(suite, client_application);
    bytes server_next = tls13_schedule.next_traffic_secret(suite, server_application);
    out.show("client_application_next", client_next);
    out.show("server_application_next", server_next);
    out.show("client_application_next2", tls13_schedule.next_traffic_secret(suite, client_next));
    out.show_keys(suite, "client_application_next", client_next);
    // A HelloRetryRequest rewrites the transcript to a message_hash of the first
    // ClientHello, then the HelloRetryRequest (stood in for by the ServerHello
    // bytes) and the second ClientHello (stood in for by the PSK one) follow.
    tls13_schedule.Transcript retried = tls13_schedule.transcript();
    retried.add(trace.client_hello);
    retried.restart_after_retry_request(suite);
    out.show("retry_restarted", retried.digest(suite));
    retried.add(trace.server_hello);
    retried.add(trace.psk_client_hello);
    out.show("retry_final", retried.digest(suite));
    // A resumed handshake with a PSK: RFC 8448 §4.
    bytes early_psk = tls13_schedule.early_secret(suite, trace.psk);
    out.show("psk_early", early_psk);
    out.show("psk_binder_key_resumption", tls13_schedule.binder_key(suite, early_psk, true));
    out.show("psk_binder_key_external", tls13_schedule.binder_key(suite, early_psk, false));
    tls13_schedule.Transcript psk_transcript = tls13_schedule.transcript();
    psk_transcript.add(trace.psk_client_hello);
    out.show("psk_client_early_traffic", tls13_schedule.client_early_traffic_secret(suite, early_psk, psk_transcript.digest(suite)));
}

Trace trace = Trace(tls13_hex.decode(arguments[1]), tls13_hex.decode(arguments[2]), tls13_hex.decode(arguments[3]), tls13_hex.decode(arguments[4]), tls13_hex.decode(arguments[5]), tls13_hex.decode(arguments[6]), tls13_hex.decode(arguments[7]), tls13_hex.decode(arguments[8]), tls13_hex.decode(arguments[9]), tls13_hex.decode(arguments[10]));
scenario(trace, tls13_schedule.Suite.Aes128GcmSha256, "aes128");
scenario(trace, tls13_schedule.Suite.ChaCha20Poly1305Sha256, "chacha");
scenario(trace, tls13_schedule.Suite.Aes256GcmSha384, "aes256");
// The suite table itself.
print("codes " + str(tls13_schedule.Suite.Aes128GcmSha256.code()) + " " + str(tls13_schedule.Suite.Aes256GcmSha384.code()) + " " + str(tls13_schedule.Suite.ChaCha20Poly1305Sha256.code()));
print("sizes " + str(tls13_schedule.Suite.Aes128GcmSha256.hash_size()) + " " + str(tls13_schedule.Suite.Aes256GcmSha384.hash_size()) + " " + str(tls13_schedule.Suite.Aes128GcmSha256.key_size()) + " " + str(tls13_schedule.Suite.Aes256GcmSha384.key_size()) + " " + str(tls13_schedule.Suite.ChaCha20Poly1305Sha256.key_size()));
List<int> probes = [0x1301, 0x1302, 0x1303, 0x1304, 0x1305, 0, 0xC02F];
for (int code in probes) {
    match (tls13_schedule.suite_for_code(code)) {
        case Some(tls13_schedule.Suite known): {
            print("suite " + str(code) + " " + known.to_str());
        }
        case None: {
            print("suite " + str(code) + " none");
        }
    }
}
