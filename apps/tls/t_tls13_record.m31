// One TLS 1.3 record at a time (`lib/tls13_record.m31`'s pure functions)
// against `oracle_tls13_record.py`, which seals and opens the same records
// with the `cryptography` package's ChaCha20Poly1305 and the RFC 8446 §5.3
// nonce rule, written out separately in Python. Every line this prints is
// printed again by the oracle; `test_tls13.sh` diffs the two.
//
//   ./build.sh apps/tls/t_tls13_record.m31 -o t_tls13_record && ./t_tls13_record

import chacha20poly1305;
import sha256;
import tls13_record;

// `n` octets of a deterministic pattern: `(i * multiplier + offset) & 0xFF`.
bytes pattern(int n, int multiplier, int offset) {
    bytes out = [];
    for (int i in 0 .. n) {
        out.push((i * multiplier + offset) & 0xFF);
    }
    return out;
}

str error_name(tls13_record.Error error) {
    match (error) {
        case Io: {
            return "Io";
        }
        case Truncated: {
            return "Truncated";
        }
        case BadVersion: {
            return "BadVersion";
        }
        case RecordOverflow: {
            return "RecordOverflow";
        }
        case BadRecordMac: {
            return "BadRecordMac";
        }
        case UnexpectedMessage: {
            return "UnexpectedMessage";
        }
        case DecodeError: {
            return "DecodeError";
        }
        case HandshakeTooLarge: {
            return "HandshakeTooLarge";
        }
        case PeerAlert: {
            return "PeerAlert";
        }
        case Closed: {
            return "Closed";
        }
        case SequenceExhausted: {
            return "SequenceExhausted";
        }
    }
}

bytes test_key() {
    return pattern(32, 5, 1);
}

bytes test_iv() {
    return pattern(12, 11, 7);
}

// Opens `record` (header and body, as on the wire) and says what came out.
str outcome(bytes wire, int sequence) {
    bytes header = wire.substr(0, 5);
    bytes body = wire.substr(5, wire.size());
    match (tls13_record.open_record(test_key(), test_iv(), sequence, header, body)) {
        case Ok(tls13_record.Opened opened): {
            return "Ok type=" + str(opened.content_type) + " size=" + str(opened.content.size()) + " sha256=" + sha256.sum(opened.content).hex();
        }
        case Err(tls13_record.Error error): {
            return error_name(error);
        }
    }
}

// A sealed record that the library itself would refuse to build: the AEAD
// applied to `inner` directly, under the header a record of that size has.
bytes forged(bytes inner, int sequence) {
    bytes wire = [tls13_record.CONTENT_APPLICATION_DATA, 3, 3, (inner.size() + 16) >> 8, (inner.size() + 16) & 0xFF];
    bytes sealed = chacha20poly1305.seal(test_key(), tls13_record.record_nonce(test_iv(), sequence), inner, wire);
    wire.extend(sealed);
    return wire;
}

bytes seal_ok(int sequence, int content_type, bytes content, int padding) {
    match (tls13_record.seal_record(test_key(), test_iv(), sequence, content_type, content, padding)) {
        case Ok(bytes wire): {
            return wire;
        }
        case Err(tls13_record.Error error): {
            trap("t_tls13_record: seal failed: " + error_name(error));
        }
    }
}

// --- the nonce -----------------------------------------------------------------

List<int> sequences = [0, 1, 2, 255, 256, 65535, 0xFFFF_FFFF, 0x1_0000_0000, 0x100_0000_0005, 0x4000_0000_0000_0003, 0x7FFF_FFFF_FFFF_FFFE];
for (int i in 0 .. sequences.size()) {
    print("nonce " + str(sequences[i]) + " " + tls13_record.record_nonce(test_iv(), sequences[i]).hex());
}

// --- a grid of records -----------------------------------------------------------

List<int> sizes = [0, 1, 2, 15, 16, 17, 63, 64, 65, 255, 1000, 16383, 16384];
List<int> types = [22, 23, 21, 23];
List<int> paddings = [0, 1, 7, 255];
for (int i in 0 .. sizes.size()) {
    int size = sizes[i];
    int content_type = types[i % 4];
    int padding = paddings[(i / 2) % 4];
    int room = tls13_record.MAX_CIPHERTEXT - 16 - 1 - size;
    if (padding > room) {
        padding = room;
    }
    int sequence = sequences[i % sequences.size()];
    bytes content = pattern(size, 7, 3);
    bytes wire = seal_ok(sequence, content_type, content, padding);
    str label = "seal seq=" + str(sequence) + " type=" + str(content_type) + " size=" + str(size) + " pad=" + str(padding);
    print(label + " wire=" + str(wire.size()) + " sha256=" + sha256.sum(wire).hex());
    if (size <= 255) {
        print(label + " hex=" + wire.hex());
    }
    print("open " + str(i) + " " + outcome(wire, sequence));
}
// Content that ends in zeros keeps them: only what follows the type octet is padding.
bytes zeros = [0; 10];
bytes zero_wire = seal_ok(4, 23, zeros, 3);
print("zero_content " + outcome(zero_wire, 4));
bytes trailing = [1, 2, 0, 0];
print("trailing_zero_content " + outcome(seal_ok(5, 22, trailing, 0), 5));

// --- records that must not open ---------------------------------------------------

bytes base = seal_ok(9, 23, pattern(40, 3, 1), 3);
print("neg base " + outcome(base, 9));
List<int> flip_places = [0, 1, 2, 3, 4, 5, 6, 20, base.size() - 17, base.size() - 16, base.size() - 1];
for (int flip in 0 .. flip_places.size()) {
    int place = flip_places[flip];
    bytes flipped = clone(base);
    flipped[place] = flipped[place] ^ 0x01;
    print("neg flip_bit_" + str(place) + " " + outcome(flipped, 9));
}
bytes flipped_high = clone(base);
flipped_high[30] = flipped_high[30] ^ 0x80;
print("neg flip_high_bit_30 " + outcome(flipped_high, 9));
print("neg replay_sequence_8 " + outcome(base, 8));
print("neg reorder_sequence_10 " + outcome(base, 10));
print("neg sequence_0 " + outcome(base, 0));
bytes cut_by_one = base.substr(0, base.size() - 1);
print("neg truncated_by_one " + outcome(cut_by_one, 9));
bytes cut_to_tag = base.substr(0, 5 + 16);
print("neg truncated_to_tag " + outcome(cut_to_tag, 9));
bytes cut_below_tag = base.substr(0, 5 + 15);
print("neg shorter_than_tag " + outcome(cut_below_tag, 9));
bytes cut_to_header = base.substr(0, 5);
print("neg header_only " + outcome(cut_to_header, 9));
bytes extended = clone(base);
extended.push(0);
print("neg extended_by_one " + outcome(extended, 9));
bytes other_key = pattern(32, 5, 2);
bytes base_header = base.substr(0, 5);
bytes base_body = base.substr(5, base.size());
match (tls13_record.open_record(other_key, test_iv(), 9, base_header, base_body)) {
    case Ok(tls13_record.Opened opened_other): {
        print("neg wrong_key Ok");
    }
    case Err(tls13_record.Error key_error): {
        print("neg wrong_key " + error_name(key_error));
    }
}
bytes other_iv = pattern(12, 11, 8);
match (tls13_record.open_record(test_key(), other_iv, 9, base_header, base_body)) {
    case Ok(tls13_record.Opened opened_iv): {
        print("neg wrong_iv Ok");
    }
    case Err(tls13_record.Error iv_error): {
        print("neg wrong_iv " + error_name(iv_error));
    }
}
// The limits.
bytes largest = seal_ok(0, 23, pattern(16384, 1, 0), 239);
print("limit largest_body " + str(largest.size() - 5) + " " + outcome(largest, 0));
bytes overlong_body = [tls13_record.CONTENT_APPLICATION_DATA, 3, 3, 0x41, 0x01];
overlong_body.extend(pattern(16641, 1, 0));
print("neg body_16641 " + outcome(overlong_body, 0));
bytes huge_body = [tls13_record.CONTENT_APPLICATION_DATA, 3, 3, 0xFF, 0xFF];
huge_body.extend(pattern(65535, 1, 0));
print("neg body_65535 " + outcome(huge_body, 0));
bytes content_too_long = pattern(16385, 1, 0);
content_too_long.push(23);
print("neg content_16385 " + outcome(forged(content_too_long, 3), 3));
bytes content_much_too_long = pattern(16600, 1, 0);
content_much_too_long.push(22);
print("neg content_16600 " + outcome(forged(content_much_too_long, 3), 3));
bytes content_fits_with_padding = pattern(16384, 1, 0);
content_fits_with_padding.push(22);
bytes hundred_zeros = [0; 100];
content_fits_with_padding.extend(hundred_zeros);
print("limit content_16384_padded " + outcome(forged(content_fits_with_padding, 3), 3));
// No content type to find.
bytes all_zero = [0; 20];
print("neg all_zero_plaintext " + outcome(forged(all_zero, 6), 6));
bytes empty_plaintext = [];
print("neg empty_plaintext " + outcome(forged(empty_plaintext, 6), 6));
bytes one_type_only = [22];
print("empty_content_with_type " + outcome(forged(one_type_only, 6), 6));
// The sequence counter's end.
match (tls13_record.seal_record(test_key(), test_iv(), tls13_record.MAX_SEQUENCE, 23, [1], 0)) {
    case Ok(bytes unexpected): {
        print("neg seal_at_max_sequence Ok");
    }
    case Err(tls13_record.Error exhausted_error): {
        print("neg seal_at_max_sequence " + error_name(exhausted_error));
    }
}
print("neg open_at_max_sequence " + outcome(base, tls13_record.MAX_SEQUENCE));
print("open_at_max_sequence_minus_one " + outcome(seal_ok(tls13_record.MAX_SEQUENCE - 1, 21, [1, 0], 0), tls13_record.MAX_SEQUENCE - 1));
// An unprotected record is only a header.
print("plain " + tls13_record.plain_record(22, [1, 2, 3]).hex());
print("plain_empty " + tls13_record.plain_record(23, []).hex());
