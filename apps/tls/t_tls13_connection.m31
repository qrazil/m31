// The TLS 1.3 record layer's `Connection` (`lib/tls13record.m31`): handshake
// messages across records, application data, KeyUpdate, alerts, close_notify
// against truncation, and the refusals. Every line this prints is printed
// again by `oracle_tls13_connection.py`, which builds the peer's records with
// the `cryptography` package and holds the expected outcome of each refusal.
//
// Three parts:
//   1. a scripted peer: `test_tls13.sh` passes the records the oracle built
//      (argument 1, hex); the connection reads them, sends a sequence of its
//      own, and the program prints what it read and what it wrote;
//   2. one line per refusal: a crafted byte stream, what `Connection` did
//      with it, and the alert it sent;
//   3. two `Connection`s over a loopback socket.
//
//   ./build.sh apps/tls/t_tls13_connection.m31 -o t_tls13_connection
//   ./t_tls13_connection <hex>

import chacha20poly1305;
import io;
import net;
import os;
import sha256;
import tls13_hex;
import tls13record;
import tls13schedule;

const int CHUNK = 7;

bytes pattern(int n, int multiplier, int offset) {
    bytes out = [];
    for (int i in 0 .. n) {
        out.push((i * multiplier + offset) & 0xFF);
    }
    return out;
}

bytes read_secret() {
    return pattern(32, 3, 1);
}

bytes application_secret() {
    return pattern(32, 13, 2);
}

bytes write_secret() {
    return pattern(32, 17, 3);
}

str describe(bytes data) {
    return "size=" + str(data.size()) + " sha256=" + sha256.sum(data).hex();
}

str error_name(tls13record.Error error) {
    match (error) {
        case Io: {
            return "Io";
        }
        case Truncated: {
            return "Truncated";
        }
        case BadVersion: {
            return "BadVersion";
        }
        case RecordOverflow: {
            return "RecordOverflow";
        }
        case BadRecordMac: {
            return "BadRecordMac";
        }
        case UnexpectedMessage: {
            return "UnexpectedMessage";
        }
        case DecodeError: {
            return "DecodeError";
        }
        case HandshakeTooLarge: {
            return "HandshakeTooLarge";
        }
        case PeerAlert: {
            return "PeerAlert";
        }
        case Closed: {
            return "Closed";
        }
        case SequenceExhausted: {
            return "SequenceExhausted";
        }
    }
}

// An in-memory peer: reads come from `inbound` at most CHUNK octets at a time,
// writes pile up in `outbound` for the program to look at.
type Pipe {
    io.Buffer inbound;
    io.Buffer outbound;
}

Result<bytes, io.Error> Pipe.read(int n) {
    int count = n;
    if (count > CHUNK) {
        count = CHUNK;
    }
    return inbound.read(count);
}

Result<bytes, io.Error> Pipe.read_all() {
    return inbound.read_all();
}

Result<bytes, io.Error> Pipe.read_until(bytes delim, int limit) {
    return inbound.read_until(delim, limit);
}

Result<int, io.Error> Pipe.write(bytes data) {
    return outbound.write(data);
}

Result<bool, io.Error> Pipe.close() {
    return Result<bool, io.Error>.Ok(true);
}

Pipe pipe(bytes inbound) {
    return Pipe(io.buffer_of(inbound), io.buffer());
}

// --- sending and receiving, with the failures turned into traps ----------------

void sent(str what, Result<void, tls13record.Error> result) {
    match (result) {
        case Ok: {
        }
        case Err(tls13record.Error error): {
            trap("t_tls13_connection: " + what + " failed: " + error_name(error));
        }
    }
}

void sent_data(str what, Result<int, tls13record.Error> result) {
    match (result) {
        case Ok(int count): {
        }
        case Err(tls13record.Error error): {
            trap("t_tls13_connection: " + what + " failed: " + error_name(error));
        }
    }
}

bytes handshake_of(tls13record.Connection connection) {
    match (connection.receive_handshake()) {
        case Ok(bytes message): {
            return message;
        }
        case Err(tls13record.Error error): {
            trap("t_tls13_connection: receive_handshake failed: " + error_name(error));
        }
    }
}

bytes application_of(tls13record.Connection connection) {
    match (connection.receive_application()) {
        case Ok(bytes data): {
            return data;
        }
        case Err(tls13record.Error error): {
            trap("t_tls13_connection: receive_application failed: " + error_name(error));
        }
    }
}

bytes handshake_message(int kind, bytes body) {
    bytes message = [kind, body.size() >> 16, (body.size() >> 8) & 0xFF, body.size() & 0xFF];
    message.extend(body);
    return message;
}

// --- 1. a scripted peer -----------------------------------------------------------

void scripted(bytes wire) {
    Pipe peer = pipe(wire);
    tls13record.Connection connection = tls13record.connection(peer);
    connection.install_write_keys(write_secret());
    sent("change_cipher_spec", connection.send_change_cipher_spec());
    sent("handshake", connection.send_handshake(handshake_message(11, pattern(39996, 5, 7))));
    sent_data("application", connection.send_application(pattern(40000, 5, 5)));
    connection.set_padding(10);
    sent_data("padded", connection.send_application(pattern(20, 1, 1)));
    connection.set_padding(255);
    sent_data("padded_full", connection.send_application(pattern(16384, 1, 2)));
    sent_data("padded_255", connection.send_application(pattern(100, 1, 3)));
    connection.set_padding(0);
    sent("key_update", connection.send_key_update(true));
    sent_data("after_update", connection.send_application(pattern(5, 1, 4)));
    sent_data("nothing", connection.send_application([]));
    print("scripted written_records=" + str(connection.write_records()));
    print("scripted handshake " + describe(handshake_of(connection)));
    sent("install_handshake_keys", connection.install_read_keys(read_secret()));
    print("scripted handshake " + describe(handshake_of(connection)));
    print("scripted handshake " + describe(handshake_of(connection)));
    print("scripted handshake " + describe(handshake_of(connection)));
    print("scripted read_records=" + str(connection.read_records()));
    sent("install_application_keys", connection.install_read_keys(application_secret()));
    bool open = true;
    while (open) {
        bytes data = application_of(connection);
        if (data.size() == 0) {
            open = false;
            print("scripted end close_notify=" + str(connection.received_close_notify()));
        } else {
            print("scripted data " + describe(data));
        }
    }
    print("scripted written_records=" + str(connection.write_records()));
    sent("user_canceled", connection.send_alert(tls13record.ALERT_USER_CANCELED));
    sent("close_notify", connection.send_close_notify());
    match (connection.send_application([1])) {
        case Ok(int count): {
            print("scripted send_after_close_notify Ok");
        }
        case Err(tls13record.Error error): {
            print("scripted send_after_close_notify " + error_name(error));
        }
    }
    print("scripted sent_close_notify=" + str(connection.sent_close_notify()));
    print("scripted written " + describe(peer.outbound.peek()));
}

// --- 2. refusals -------------------------------------------------------------------

bytes protected_record(int sequence, int content_type, bytes content) {
    tls13schedule.TrafficKeys keys = tls13schedule.traffic_keys(tls13schedule.Suite.ChaCha20Poly1305Sha256, read_secret());
    match (tls13record.seal_record(tls13schedule.Suite.ChaCha20Poly1305Sha256, keys.key, keys.iv, sequence, content_type, content, 0)) {
        case Ok(bytes wire): {
            return wire;
        }
        case Err(tls13record.Error error): {
            trap("t_tls13_connection: seal failed: " + error_name(error));
        }
    }
}

// The AEAD applied to `inner` under `outer_type`'s header, as the library
// itself would refuse to build it.
bytes forged(int outer_type, bytes inner, int sequence) {
    tls13schedule.TrafficKeys keys = tls13schedule.traffic_keys(tls13schedule.Suite.ChaCha20Poly1305Sha256, read_secret());
    bytes wire = [outer_type, 3, 3, (inner.size() + 16) >> 8, (inner.size() + 16) & 0xFF];
    wire.extend(chacha20poly1305.seal(keys.key, tls13record.record_nonce(keys.iv, sequence), inner, wire));
    return wire;
}

bytes joined(bytes first, bytes second) {
    bytes both = clone(first);
    both.extend(second);
    return both;
}

bytes plain(int content_type, bytes content) {
    return tls13record.plain_record(content_type, content);
}

str step_receive(tls13record.Connection connection) {
    match (connection.receive()) {
        case Ok(tls13record.Message message): {
            match (message.kind) {
                case Handshake: {
                    return "hs:" + str(message.data.size());
                }
                case ApplicationData: {
                    return "data:" + str(message.data.size());
                }
                case CloseNotify: {
                    return "end";
                }
            }
        }
        case Err(tls13record.Error error): {
            return "err:" + error_name(error);
        }
    }
}

str step_handshake(tls13record.Connection connection) {
    match (connection.receive_handshake()) {
        case Ok(bytes message): {
            return "hs:" + str(message.size());
        }
        case Err(tls13record.Error error): {
            return "err:" + error_name(error);
        }
    }
}

str step_application(tls13record.Connection connection) {
    match (connection.receive_application()) {
        case Ok(bytes data): {
            if (data.size() == 0) {
                return "end";
            }
            return "data:" + str(data.size());
        }
        case Err(tls13record.Error error): {
            return "err:" + error_name(error);
        }
    }
}

// mode 0: receive, 1: receive_handshake, 2: receive_application.
void refusal(str name, bytes wire, bool read_protected, bool write_protected, int mode, int steps) {
    Pipe peer = pipe(wire);
    tls13record.Connection connection = tls13record.connection(peer);
    if (read_protected) {
        sent("read keys", connection.install_read_keys(read_secret()));
    }
    if (write_protected) {
        connection.install_write_keys(write_secret());
    }
    str line = "case " + name + " |";
    for (int step in 0 .. steps) {
        str result = "";
        if (mode == 0) {
            result = step_receive(connection);
        } else if (mode == 1) {
            result = step_handshake(connection);
        } else {
            result = step_application(connection);
        }
        line = line + " " + result + " |";
    }
    line = line + " alert=" + str(connection.received_alert()) + " | sent=" + peer.outbound.peek().hex();
    print(line);
}

void refusals() {
    bytes data = pattern(10, 1, 1);
    bytes message_a = handshake_message(2, pattern(8, 1, 1));
    bytes message_b = handshake_message(15, pattern(4, 1, 0xC0));
    bytes finished = handshake_message(20, pattern(32, 1, 0x40));
    bytes flipped = protected_record(0, 23, data);
    flipped[7] = flipped[7] ^ 1;
    refusal("flipped_body", flipped, true, false, 2, 2);
    refusal("flipped_body_protected_alert", flipped, true, true, 2, 1);
    refusal("replayed_record", joined(protected_record(0, 23, data), protected_record(0, 23, data)), true, false, 2, 2);
    refusal("reordered_records", joined(protected_record(1, 23, data), protected_record(0, 23, data)), true, false, 2, 1);
    refusal("skipped_record", protected_record(1, 23, data), true, false, 2, 1);
    bytes huge_protected = [23, 3, 3, 0x41, 0x01];
    refusal("protected_header_over_16640", huge_protected, true, false, 2, 1);
    bytes at_limit_protected = [23, 3, 3, 0x41, 0x00];
    refusal("protected_header_16640_then_eof", at_limit_protected, true, false, 2, 1);
    bytes huge_plain = [22, 3, 3, 0x40, 0x01];
    refusal("plain_header_over_16384", huge_plain, false, false, 1, 1);
    refusal("content_16385", forged(23, joined(pattern(16385, 1, 1), [23]), 0), true, false, 2, 1);
    refusal("not_tls", "HTTP/1.1 400 Bad Request\r\n".to_bytes(), false, false, 0, 1);
    bytes old_version = [22, 2, 0, 0, 1, 0];
    refusal("version_2", old_version, false, false, 0, 1);
    bytes legacy_version = [22, 3, 1, 0, 12];
    legacy_version.extend(message_a);
    refusal("version_3_1_accepted", legacy_version, false, false, 1, 1);
    bytes cut_header = [23, 3];
    refusal("eof_in_header", cut_header, true, false, 2, 2);
    bytes cut_body = [23, 3, 3, 0, 100];
    cut_body.extend(pattern(10, 1, 1));
    refusal("eof_in_body", cut_body, true, false, 2, 1);
    refusal("eof_after_data", protected_record(0, 23, data), true, false, 2, 3);
    bytes nothing = [];
    refusal("eof_at_start", nothing, true, false, 2, 1);
    refusal("eof_after_partial_message", protected_record(0, 22, [11, 0, 0]), true, false, 1, 1);
    bytes close_notify = [1, 0];
    refusal("close_notify", joined(protected_record(0, 23, data), protected_record(1, 21, close_notify)), true, false, 2, 3);
    refusal("close_notify_in_receive", protected_record(0, 21, close_notify), true, false, 0, 2);
    refusal("close_notify_for_handshake", protected_record(0, 21, close_notify), true, false, 1, 1);
    refusal("close_notify_plain", plain(21, close_notify), false, false, 2, 2);
    bytes fatal = [2, 40];
    refusal("fatal_alert", protected_record(0, 21, fatal), true, false, 2, 2);
    bytes warning = [1, 40];
    refusal("warning_alert_is_fatal", protected_record(0, 21, warning), true, false, 0, 1);
    bytes user_canceled = [1, 90];
    refusal("user_canceled_ignored", joined(protected_record(0, 21, user_canceled), protected_record(1, 23, data)), true, false, 2, 1);
    bytes one_byte = [1];
    refusal("alert_one_octet", protected_record(0, 21, one_byte), true, false, 2, 1);
    bytes three_bytes = [1, 0, 1];
    refusal("alert_three_octets", protected_record(0, 21, three_bytes), true, false, 2, 1);
    bytes two_alerts = [1, 0, 1, 0];
    refusal("alerts_coalesced", protected_record(0, 21, two_alerts), true, false, 2, 1);
    bytes zero_octet = [0];
    refusal("alert_fragmented", joined(protected_record(0, 21, one_byte), protected_record(1, 21, zero_octet)), true, false, 2, 1);
    refusal("alert_empty", protected_record(0, 21, nothing), true, false, 2, 1);
    bytes message_start = [11, 0];
    refusal("alert_between_fragments", joined(protected_record(0, 22, message_start), protected_record(1, 21, close_notify)), true, false, 0, 1);
    refusal("data_between_fragments", joined(protected_record(0, 22, message_start), protected_record(1, 23, data)), true, false, 0, 1);
    refusal("empty_handshake_record", protected_record(0, 22, nothing), true, false, 0, 1);
    refusal("empty_handshake_record_plain", plain(22, nothing), false, false, 0, 1);
    refusal("outer_handshake", forged(22, joined(data, [23]), 0), true, false, 0, 1);
    refusal("outer_alert", forged(21, joined(close_notify, [21]), 0), true, false, 0, 1);
    bytes zeros = [0; 20];
    refusal("all_zero_plaintext", forged(23, zeros, 0), true, false, 0, 1);
    refusal("inner_change_cipher_spec", protected_record(0, 20, [1]), true, false, 0, 1);
    refusal("inner_unknown_type", protected_record(0, 25, data), true, false, 0, 1);
    refusal("plain_unknown_type", plain(25, data), false, false, 0, 1);
    refusal("plain_application_data", plain(23, data), false, false, 0, 1);
    refusal("ccs_between_plain_messages", joined(joined(plain(22, message_a), plain(20, [1])), plain(22, message_b)), false, false, 1, 2);
    refusal("ccs_while_protected", joined(plain(20, [1]), protected_record(0, 22, message_a)), true, false, 1, 1);
    refusal("ccs_body_2", plain(20, [2]), false, false, 0, 1);
    refusal("ccs_body_two_octets", plain(20, [1, 1]), false, false, 0, 1);
    refusal("ccs_empty", plain(20, nothing), false, false, 0, 1);
    refusal("ccs_after_finished", joined(protected_record(0, 22, finished), plain(20, [1])), true, false, 1, 2);
    refusal("ccs_before_finished_in_record", joined(protected_record(0, 22, message_a), plain(20, [1])), true, false, 1, 2);
    bytes oversized = [1, 3, 0, 0];
    refusal("handshake_message_196608", plain(22, oversized), false, false, 1, 1);
    bytes at_limit = [1, 1, 255, 252];
    bytes at_limit_wire = [];
    at_limit.extend(pattern(16380, 1, 1));
    at_limit_wire.extend(plain(22, at_limit));
    for (int piece in 0 .. 7) {
        at_limit_wire.extend(plain(22, pattern(16384, 1, piece)));
    }
    refusal("handshake_message_131072", at_limit_wire, false, false, 1, 2);
    bytes over_limit = [1, 1, 255, 253];
    over_limit.extend(pattern(16380, 1, 1));
    refusal("handshake_message_131073", plain(22, over_limit), false, false, 1, 1);
    refusal("handshake_for_application", protected_record(0, 23, data), true, false, 1, 1);
    refusal("certificate_after_handshake", protected_record(0, 22, handshake_message(11, [1, 2])), true, false, 2, 1);
    refusal("session_ticket_skipped", joined(protected_record(0, 22, handshake_message(4, [0; 5])), protected_record(1, 23, data)), true, false, 2, 1);
    refusal("key_update_value_2", protected_record(0, 22, handshake_message(24, [2])), true, true, 2, 1);
    refusal("key_update_two_octets", protected_record(0, 22, handshake_message(24, [0, 0])), true, true, 2, 1);
    refusal("key_update_empty", protected_record(0, 22, handshake_message(24, nothing)), true, true, 2, 1);
    refusal("key_update_without_write_keys", protected_record(0, 22, handshake_message(24, [0])), true, false, 2, 1);
    refusal("two_messages_in_a_record", protected_record(0, 22, joined(message_a, message_b)), true, false, 1, 3);
    refusal("message_across_records", joined(protected_record(0, 22, message_a.substr(0, 2)), protected_record(1, 22, message_a.substr(2, 12))), true, false, 1, 2);
    refusal("sends_after_failure", flipped, true, true, 0, 3);
}

void key_change_refusals() {
    bytes message_a = handshake_message(2, pattern(8, 1, 1));
    bytes partial = joined(message_a, [11, 0]);
    Pipe peer = pipe(plain(22, partial));
    tls13record.Connection connection = tls13record.connection(peer);
    print("case key_change_with_partial_message | " + step_handshake(connection) + " |");
    match (connection.install_read_keys(read_secret())) {
        case Ok: {
            print("case key_change_with_partial_message | install Ok");
        }
        case Err(tls13record.Error error): {
            print("case key_change_with_partial_message | install " + error_name(error) + " | sent=" + peer.outbound.peek().hex());
        }
    }
    match (connection.send_application([1])) {
        case Ok(int count): {
            print("case key_change_with_partial_message | send Ok");
        }
        case Err(tls13record.Error error): {
            print("case key_change_with_partial_message | send " + error_name(error));
        }
    }
    Pipe whole = pipe(plain(22, joined(message_a, message_a)));
    tls13record.Connection second = tls13record.connection(whole);
    print("case key_change_with_whole_message_buffered | " + step_handshake(second) + " |");
    match (second.install_read_keys(read_secret())) {
        case Ok: {
            print("case key_change_with_whole_message_buffered | install Ok");
        }
        case Err(tls13record.Error error): {
            print("case key_change_with_whole_message_buffered | install " + error_name(error));
        }
    }
}

// --- 3. a loopback socket ---------------------------------------------------------

net.Listener listening() {
    match (net.listen("127.0.0.1", 0)) {
        case Ok(net.Listener listener): {
            return listener;
        }
        case Err(net.Error listen_error): {
            trap("t_tls13_connection: listen failed: " + listen_error.to_str());
        }
    }
}

net.Conn connected(net.Listener listener) {
    match (net.connect("127.0.0.1", listener.local().port())) {
        case Ok(net.Conn client): {
            return client;
        }
        case Err(net.Error connect_error): {
            trap("t_tls13_connection: connect failed: " + connect_error.to_str());
        }
    }
}

net.Conn accepted(net.Listener listener) {
    match (listener.accept()) {
        case Ok(net.Conn server): {
            return server;
        }
        case Err(net.Error accept_error): {
            trap("t_tls13_connection: accept failed: " + accept_error.to_str());
        }
    }
}

bytes application_until(tls13record.Connection connection, int total) {
    bytes got = [];
    while (got.size() < total) {
        bytes data = application_of(connection);
        if (data.size() == 0) {
            trap("t_tls13_connection: the stream ended before " + str(total) + " octets");
        }
        got.extend(data);
    }
    return got;
}

void loopback(tls13schedule.Suite suite, str label) {
    str prefix = "loopback-" + label + " ";
    net.Listener listener = listening();
    net.Conn client_socket = connected(listener);
    net.Conn server_socket = accepted(listener);
    tls13record.Connection client = tls13record.connection(client_socket);
    tls13record.Connection server = tls13record.connection(server_socket);
    client.use_suite(suite);
    server.use_suite(suite);
    bytes up = pattern(suite.hash_size(), 5, 9);
    bytes down = pattern(suite.hash_size(), 7, 4);
    client.install_write_keys(up);
    sent("server read keys", server.install_read_keys(up));
    server.install_write_keys(down);
    sent("client read keys", client.install_read_keys(down));
    sent("client handshake", client.send_handshake(handshake_message(1, pattern(36000, 3, 3))));
    print(prefix + "server handshake " + describe(handshake_of(server)));
    sent_data("client data", client.send_application(pattern(50000, 7, 7)));
    print(prefix + "server data " + describe(application_until(server, 50000)));
    sent_data("server data", server.send_application(pattern(300, 3, 5)));
    print(prefix + "client data " + describe(application_until(client, 300)));
    sent("client key_update", client.send_key_update(true));
    sent_data("client data after update", client.send_application(pattern(1000, 1, 1)));
    print(prefix + "server data " + describe(application_until(server, 1000)));
    sent_data("server data after update", server.send_application(pattern(2000, 1, 2)));
    print(prefix + "client data " + describe(application_until(client, 2000)));
    print(prefix + "records client_sent=" + str(client.write_records()) + " server_read=" + str(server.read_records()));
    sent("client close_notify", client.send_close_notify());
    print(prefix + "server end " + describe(application_of(server)));
    sent("server close_notify", server.send_close_notify());
    print(prefix + "client end " + describe(application_of(client)));
    net.Conn cut_client_socket = connected(listener);
    net.Conn cut_server_socket = accepted(listener);
    tls13record.Connection cut_client = tls13record.connection(cut_client_socket);
    tls13record.Connection cut_server = tls13record.connection(cut_server_socket);
    cut_client.use_suite(suite);
    cut_server.use_suite(suite);
    cut_client.install_write_keys(up);
    sent("cut server read keys", cut_server.install_read_keys(up));
    sent_data("cut data", cut_client.send_application(pattern(10, 1, 1)));
    match (cut_client.close()) {
        case Ok(bool closed): {
        }
        case Err(tls13record.Error close_error): {
            trap("t_tls13_connection: close failed");
        }
    }
    print(prefix + "cut " + step_application(cut_server) + " " + step_application(cut_server));
}

List<str> arguments = os.args();
if (arguments.size() != 2) {
    trap("t_tls13_connection: expected the scripted peer's records as one hex argument");
}
scripted(tls13_hex.decode(arguments[1]));
refusals();
key_change_refusals();
loopback(tls13schedule.Suite.ChaCha20Poly1305Sha256, "chacha");
loopback(tls13schedule.Suite.Aes128GcmSha256, "aes128");
loopback(tls13schedule.Suite.Aes256GcmSha384, "aes256");
