// TLS 1.2 records (`lib/tls/tls13record.m31`'s `seal_record_legacy` and
// `open_record_legacy`) against `tls12_record_oracle.py`, which builds the same
// records from RFC 5246 §6.2.3.3, RFC 5288 §3 and RFC 7905 §2 with the
// `cryptography` package's AEADs. Every line is printed again by the oracle;
// `test_tls12.sh` diffs the two, once per suite.
//
//   ./build.sh apps/tls/tls12_record.m31 -o tls12_record
//   ./tls12_record chacha | aes128 | aes256

import os;
import crypto.sha256;
import tls.tls13record;
import tls.tls13schedule;

bytes pattern(int count, int multiplier, int offset) {
    bytes out = [];
    for (int i in 0 .. count) {
        out.push((i * multiplier + offset) & 0xFF);
    }
    return out;
}

str error_name(tls13record.Error error) {
    match (error) {
        case Io: {
            return "Io";
        }
        case Truncated: {
            return "Truncated";
        }
        case BadVersion: {
            return "BadVersion";
        }
        case RecordOverflow: {
            return "RecordOverflow";
        }
        case BadRecordMac: {
            return "BadRecordMac";
        }
        case UnexpectedMessage: {
            return "UnexpectedMessage";
        }
        case DecodeError: {
            return "DecodeError";
        }
        case HandshakeTooLarge: {
            return "HandshakeTooLarge";
        }
        case PeerAlert: {
            return "PeerAlert";
        }
        case Closed: {
            return "Closed";
        }
        case SequenceExhausted: {
            return "SequenceExhausted";
        }
    }
}

List<str> arguments = os.args();
if (arguments.size() != 2) {
    trap("tls12_record: expected one argument: chacha, aes128 or aes256");
}
tls13schedule.Suite suite = tls13schedule.Suite.ChaCha20Poly1305Sha256;
int salt_size = 12;
if (arguments[1] == "aes128") {
    suite = tls13schedule.Suite.Aes128GcmSha256;
    salt_size = 4;
} else if (arguments[1] == "aes256") {
    suite = tls13schedule.Suite.Aes256GcmSha384;
    salt_size = 4;
} else if (arguments[1] != "chacha") {
    trap("tls12_record: unknown suite " + arguments[1]);
}
bytes key = pattern(suite.key_size(), 5, 1);
bytes iv = pattern(salt_size, 11, 7);

str outcome(tls13schedule.Suite suite, bytes key, bytes iv, bytes wire, int sequence) {
    match (tls13record.open_record_legacy(suite, key, iv, sequence, wire.substr(0, 5), wire.substr(5, wire.size()))) {
        case Ok(tls13record.Opened opened): {
            return "Ok type=" + str(opened.content_type) + " size=" + str(opened.content.size()) + " sha256=" + sha256.sum(opened.content).hex();
        }
        case Err(tls13record.Error error): {
            return error_name(error);
        }
    }
}

bytes seal_ok(tls13schedule.Suite suite, bytes key, bytes iv, int sequence, int content_type, bytes content) {
    match (tls13record.seal_record_legacy(suite, key, iv, sequence, content_type, content)) {
        case Ok(bytes wire): {
            return wire;
        }
        case Err(tls13record.Error error): {
            trap("tls12_record: seal failed: " + error_name(error));
        }
    }
}

List<int> sizes = [0, 1, 2, 15, 16, 17, 63, 64, 65, 255, 1000, 16383, 16384];
List<int> types = [22, 23, 21, 23];
List<int> sequences = [0, 1, 2, 255, 256, 0xFFFF_FFFF, 0x1_0000_0000, 0x4000_0000_0000_0003];
for (int i in 0 .. sizes.size()) {
    int sequence = sequences[i % sequences.size()];
    int content_type = types[i % 4];
    bytes content = pattern(sizes[i], 3 + i, i);
    bytes wire = seal_ok(suite, key, iv, sequence, content_type, content);
    str shown = wire.hex();
    if (wire.size() > 100) {
        shown = str(wire.size()) + " " + sha256.sum(wire).hex();
    }
    print("seal " + str(sizes[i]) + " " + str(sequence) + " " + str(content_type) + " " + shown);
    print("open " + str(sizes[i]) + " " + outcome(suite, key, iv, wire, sequence));
}
// every way a record can be wrong
bytes good = seal_ok(suite, key, iv, 5, 23, pattern(40, 3, 1));
print("open_good " + outcome(suite, key, iv, good, 5));
print("open_wrong_sequence " + outcome(suite, key, iv, good, 6));
print("open_wrong_sequence_zero " + outcome(suite, key, iv, good, 0));
for (int i in 0 .. good.size()) {
    bytes bent = clone(good);
    bent[i] = bent[i] ^ 0x01;
    if (i < 5) {
        print("flip_header " + str(i) + " " + outcome(suite, key, iv, bent, 5));
    } else {
        print("flip_body " + str(i - 5) + " " + outcome(suite, key, iv, bent, 5));
    }
}
for (int cut in 5 .. good.size()) {
    print("short " + str(cut - 5) + " " + outcome(suite, key, iv, good.substr(0, cut), 5));
}
bytes with_trailing = clone(good);
with_trailing.push(0);
print("trailing_octet " + outcome(suite, key, iv, with_trailing, 5));
bytes empty = seal_ok(suite, key, iv, 9, 23, []);
print("empty_record " + outcome(suite, key, iv, empty, 9));
bytes retyped = clone(empty);
retyped[0] = 22;
print("empty_wrong_type " + outcome(suite, key, iv, retyped, 9));
print("exhausted " + outcome(suite, key, iv, good, 0x7FFF_FFFF_FFFF_FFFF));
