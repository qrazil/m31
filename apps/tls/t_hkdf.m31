// HKDF and the TLS 1.3 labelled forms against an independent Python
// implementation. Every line this prints on stdout is printed again by
// `oracle_hkdf.py`, and `test.sh` diffs the two. Structured like
// `apps/ssh/t_sha256.m31`.
//
//   ./build.sh apps/tls/t_hkdf.m31 -o t_hkdf && ./t_hkdf

import crypto.hkdf;
import crypto.sha256;
import crypto.sha512;

// `length` octets of a deterministic pattern: `(i * multiplier + offset) & 0xFF`.
bytes pattern(int length, int multiplier, int offset) {
    bytes out = [];
    for (int i in 0 .. length) {
        out.push(i * multiplier + offset & 0xFF);
    }
    return out;
}

// --- RFC 5869 Appendix A.1 to A.3: the SHA-256 test cases -----------------------
//
// The RFC's inputs are counting sequences and repeats, so they are generated
// here rather than pasted as hex; `oracle_hkdf.py` generates the same ones and
// asserts the RFC's published PRK and OKM against its own result.

bytes ikm1 = [0x0B; 22];
bytes salt1 = pattern(13, 1, 0);
bytes info1 = pattern(10, 1, 0xF0);
bytes prk1 = hkdf.sha256_extract(salt1, ikm1);
print("rfc5869-1 prk " + prk1.hex());
print("rfc5869-1 okm " + hkdf.sha256_expand(prk1, info1, 42).hex());
bytes ikm2 = pattern(80, 1, 0);
bytes salt2 = pattern(80, 1, 0x60);
bytes info2 = pattern(80, 1, 0xB0);
bytes prk2 = hkdf.sha256_extract(salt2, ikm2);
print("rfc5869-2 prk " + prk2.hex());
print("rfc5869-2 okm " + hkdf.sha256_expand(prk2, info2, 82).hex());
bytes ikm3 = [0x0B; 22];
bytes prk3 = hkdf.sha256_extract([], ikm3);
print("rfc5869-3 prk " + prk3.hex());
print("rfc5869-3 okm " + hkdf.sha256_expand(prk3, [], 42).hex());

// --- RFC 8448 §3: the start of the TLS 1.3 key schedule -------------------------
//
// Early Secret = Extract(0, 0), then Derive-Secret(., "derived", "") with the
// SHA-256 of the empty string, then Extract of that with the (EC)DHE secret.

bytes zero_key = [0; 32];
bytes empty_hash = sha256.sum([]);
bytes early_secret = hkdf.sha256_extract([], zero_key);
print("rfc8448 early " + early_secret.hex());
bytes derived_secret = hkdf.sha256_derive_secret(early_secret, "derived", empty_hash);
print("rfc8448 derived " + derived_secret.hex());
bytes shared_secret = [0x8B, 0xD4, 0x05, 0x4F, 0xB5, 0x5B, 0x9D, 0x63, 0xFD, 0xFB, 0xAC, 0xF9, 0xF0, 0x4B, 0x9F, 0x0D, 0x35, 0xE6, 0xD6, 0x3F, 0x53, 0x75, 0x63, 0xEF, 0xD4, 0x62, 0x72, 0x90, 0x0F, 0x89, 0x49, 0x2D];
print("rfc8448 handshake " + hkdf.sha256_extract(derived_secret, shared_secret).hex());

// --- Extract: every salt length against every input-keying-material length -------

const Array<int> SALT_SIZES = [0, 1, 32, 63, 64, 65];
const Array<int> IKM_SIZES = [0, 1, 22, 32, 64, 100];

for (int salt_size in SALT_SIZES) {
    for (int ikm_size in IKM_SIZES) {
        bytes salt = pattern(salt_size, 5, 3);
        bytes ikm = pattern(ikm_size, 9, 1);
        print("extract salt" + salt_size.to_str() + " ikm" + ikm_size.to_str() + " " + hkdf.sha256_extract(salt, ikm).hex());
    }
}

// --- Expand: lengths around the 32-octet block, and the 8160-octet maximum ------

const Array<int> OUTPUT_SIZES = [0, 1, 31, 32, 33, 63, 64, 65, 100, 255, 1000, 8160];
const Array<int> INFO_SIZES = [0, 1, 10, 80];

bytes expand_key = pattern(32, 3, 7);
for (int output_size in OUTPUT_SIZES) {
    for (int info_size in INFO_SIZES) {
        bytes info = pattern(info_size, 13, 2);
        print("expand len" + output_size.to_str() + " info" + info_size.to_str() + " " + hkdf.sha256_expand(expand_key, info, output_size).hex());
    }
}

// --- Expand-Label and Derive-Secret: the labels a TLS 1.3 client uses ---------------

const Array<str> LABELS = ["derived", "c hs traffic", "s hs traffic", "c ap traffic", "s ap traffic", "finished", "key", "iv", "res binder", "exp master"];
const Array<int> LABEL_OUTPUT_SIZES = [12, 16, 32, 100];
const Array<int> CONTEXT_SIZES = [0, 1, 32, 255];

bytes label_secret = pattern(32, 17, 29);
for (str label in LABELS) {
    for (int output_size in LABEL_OUTPUT_SIZES) {
        for (int context_size in CONTEXT_SIZES) {
            bytes context = pattern(context_size, 19, 31);
            print("label " + label + " len" + output_size.to_str() + " ctx" + context_size.to_str() + " " + hkdf.sha256_expand_label(label_secret, label, context, output_size).hex());
        }
    }
    bytes transcript = sha256.sum(label.to_bytes());
    print("derive " + label + " " + hkdf.sha256_derive_secret(label_secret, label, transcript).hex());
}
// The longest legal label: "tls13 " is 6 octets, so 249 more make 255.
str longest_label = "";
for (int i in 0 .. 249) {
    longest_label = longest_label + "k";
}
print("longest-label " + hkdf.sha256_expand_label(label_secret, longest_label, [], 16).hex());

// --- the SHA-384 flavour (TLS_AES_256_GCM_SHA384's key schedule) -------------------
//
// The same sweeps over a 48-octet key, with the 255 * 48 = 12240-octet maximum
// and the 48-octet transcript hash of SHA-384.

for (int salt_size in SALT_SIZES) {
    for (int ikm_size in IKM_SIZES) {
        bytes salt = pattern(salt_size, 5, 3);
        bytes ikm = pattern(ikm_size, 9, 1);
        print("extract384 salt" + salt_size.to_str() + " ikm" + ikm_size.to_str() + " " + hkdf.sha384_extract(salt, ikm).hex());
    }
}

const Array<int> OUTPUT_SIZES_384 = [0, 1, 47, 48, 49, 95, 96, 97, 100, 255, 1000, 12240];

bytes expand_key_384 = pattern(48, 3, 7);
for (int output_size in OUTPUT_SIZES_384) {
    for (int info_size in INFO_SIZES) {
        bytes info = pattern(info_size, 13, 2);
        print("expand384 len" + output_size.to_str() + " info" + info_size.to_str() + " " + hkdf.sha384_expand(expand_key_384, info, output_size).hex());
    }
}
bytes label_secret_384 = pattern(48, 17, 29);
for (str label in LABELS) {
    for (int output_size in LABEL_OUTPUT_SIZES) {
        for (int context_size in CONTEXT_SIZES) {
            bytes context = pattern(context_size, 19, 31);
            print("label384 " + label + " len" + output_size.to_str() + " ctx" + context_size.to_str() + " " + hkdf.sha384_expand_label(label_secret_384, label, context, output_size).hex());
        }
    }
    bytes transcript = sha512.sum384(label.to_bytes());
    print("derive384 " + label + " " + hkdf.sha384_derive_secret(label_secret_384, label, transcript).hex());
}
print("longest-label384 " + hkdf.sha384_expand_label(label_secret_384, longest_label, [], 16).hex());
