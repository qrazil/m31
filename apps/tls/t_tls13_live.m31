// A real server's bytes through `tls13record`: what `openssl s_server
// -tls1_3 -ciphersuites <suite>` sent a client, with the
// server's traffic secrets from its key log. `live_tls13.py` captures the
// bytes and checks what this prints; `test_tls13.sh` runs it and skips it,
// without failing, if OpenSSL is not there or does not cooperate.
//
//   t_tls13_live <server bytes> <server_handshake_traffic_secret>
//                <server_traffic_secret_0> <IANA suite name>      (hex, hex, hex, name)

import io;
import os;
import crypto.sha256;
import TLS13_hex;
import tls.tls13record;
import tls.tls13schedule;

void say(str text) {
    print(text);
}

List<str> arguments = os.arguments();
if (arguments.size() != 5) {
    trap("t_tls13_live: expected the capture, two traffic secrets as hex, and a suite name");
}
tls13schedule.Suite suite = tls13schedule.Suite.ChaCha20Poly1305Sha256;
if (arguments[4] == "TLS_AES_128_GCM_SHA256") {
    suite = tls13schedule.Suite.Aes128GcmSha256;
} else if (arguments[4] == "TLS_AES_256_GCM_SHA384") {
    suite = tls13schedule.Suite.Aes256GcmSha384;
} else if (arguments[4] != "TLS_CHACHA20_POLY1305_SHA256") {
    trap("t_tls13_live: unknown suite " + arguments[4]);
}
tls13record.Connection connection = tls13record.connection(io.buffer_of(TLS13_hex.decode(arguments[1])));
connection.use_suite(suite);
bytes handshake_secret = TLS13_hex.decode(arguments[2]);
bytes application_secret = TLS13_hex.decode(arguments[3]);
match (connection.receive_handshake()) {
    case Ok(bytes server_hello): {
        say("handshake type=" + str(server_hello[0]) + " size=" + str(server_hello.size()));
    }
    case Err(tls13record.Error hello_error): {
        say("error " + hello_error.to_str());
        os.exit(1);
    }
}
match (connection.install_read_keys(handshake_secret)) {
    case Ok: {
    }
    case Err(tls13record.Error key_error): {
        say("error " + key_error.to_str());
        os.exit(1);
    }
}
bool is_finished = false;
while (!is_finished) {
    match (connection.receive_handshake()) {
        case Ok(bytes message): {
            say("handshake type=" + str(message[0]) + " size=" + str(message.size()));
            is_finished = message[0] == 20;
        }
        case Err(tls13record.Error message_error): {
            say("error " + message_error.to_str());
            os.exit(1);
        }
    }
}
match (connection.install_read_keys(application_secret)) {
    case Ok: {
    }
    case Err(tls13record.Error key_error): {
        say("error " + key_error.to_str());
        os.exit(1);
    }
}
bytes received = [];
bool is_ended = false;
while (!is_ended) {
    match (connection.receive_application()) {
        case Ok(bytes data): {
            if (data.size() == 0) {
                is_ended = true;
            } else {
                received.extend(data);
            }
        }
        case Err(tls13record.Error data_error): {
            say("error " + data_error.to_str());
            os.exit(1);
        }
    }
}
say("application size=" + str(received.size()) + " sha256=" + sha256.sum(received).hex());
say("close_notify " + str(connection.has_received_close_notify()));
