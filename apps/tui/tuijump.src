// A synced jump list: a flat, selectable index of whatever an outline
// currently shows. See `apps/git/design.md`'s corrected description -- this
// is "closer to a synced table of contents than a directory browser", and
// the two-way part is the point: selecting a row here scrolls the outline to
// it, and moving the outline's own cursor highlights the row here. Neither
// direction alone would be this primitive; a static index that only jumps
// one way is a `tuilists.ListView` of labels, which already exists.
//
// API
// ---
//   tuijump.Entry(id, label, depth)   one row, matched to an outline node
//   tuijump.JumpList(entries)         the widget: selection, scroll, render
//   jump.sync_from(outline)           rebuild `entries` from the outline's
//                                     CURRENT flattened, visible rows
//   jump.follow(outline)              outline moved -> highlight the match here
//   jump.activate(outline)  -> bool   here selected -> move the outline there
//   jump.step(delta), jump.render(buf, area)
//
// --- why matching is by id, not by row number --------------------------------
//
// Folding a section in the outline changes every row number below the fold,
// but changes no `id`. `sync_from` copies the outline's rows (and their
// ids) fresh every time it is called -- after a toggle, after a reload -- and
// `follow`/`activate` always look a row up by `id`, never by position, which
// is what keeps the two lists in step with each other regardless of what is
// currently folded.

import tuibuf;
import tuigeom;
import tuioutline;
import tuiscroll;
import tuistyle;
import tuitext;

/// One row of the jump list: an outline node's `id` and `label`, and how deep
/// it was nested, copied out of an `Outline` by `sync_from`.
pub type Entry {
    pub str id;
    pub str label;
    pub int depth = 0;
}

/// The widget: a flat list of `Entry`, with its own selection and scroll,
/// kept in step with an `Outline` through `sync_from`, `follow` and
/// `activate` rather than owning the tree itself.
pub type JumpList {
    pub List<Entry> entries;
    pub int selected = -1;
    pub tuiscroll.Viewport view = tuiscroll.Viewport();
    pub tuistyle.Style style = tuistyle.Style();
    pub tuistyle.Style highlight_style = tuistyle.Style(attrs: tuistyle.REVERSE);
    pub int indent = 1;
}

/// An empty jump list, ready for `sync_from`.
pub static JumpList JumpList.empty() {
    return JumpList([]);
}

/// Rebuild `entries` from `o`'s current, flattened, visible rows. A folded
/// section contributes only itself -- the jump list shrinks when the
/// document folds, which is what "synced" means.
pub void JumpList.sync_from(tuioutline.Outline o) {
    List<Entry> out = [];
    for (tuioutline.Row r in o.rows()) {
        out.push(Entry(r.node.id, r.node.label, depth: r.depth));
    }
    entries = out;
}

/// The outline half of the sync: move the highlight to whatever row the
/// outline's cursor is on now. Call this after any move, toggle or reload of
/// the outline.
pub void JumpList.follow(tuioutline.Outline o) {
    match (o.current()) {
        case Some(tuioutline.Row r): {
            select_id(r.node.id);
        }
        case None: {
        }
    }
}

/// The jump-list half of the sync: move the outline's cursor (and its own
/// scroll, through `Outline.render`) to the entry selected here. Answers
/// whether the selection named a row the outline currently shows.
pub bool JumpList.activate(tuioutline.Outline o) {
    if (selected < 0 || selected >= entries.size()) {
        return false;
    }
    return o.select_id(entries[selected].id);
}

/// Select the entry with this `id`, if there is one. Answers whether one was
/// found.
pub bool JumpList.select_id(str id) {
    int i = 0;
    while (i < entries.size()) {
        if (entries[i].id == id) {
            selected = i;
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Move the selection by `delta`, stopping at the ends --
/// `tuilists.ListView.step`'s own rule.
pub void JumpList.step(int delta) {
    int n = entries.size();
    if (n == 0) {
        selected = -1;
        return;
    }
    int at = selected + delta;
    if (selected < 0 && delta > 0) {
        at = 0;
    }
    if (at < 0) {
        at = 0;
    }
    if (at >= n) {
        at = n - 1;
    }
    selected = at;
}

pub void JumpList.render(tuibuf.Buffer buf, tuigeom.Rect area) {
    if (area.is_empty()) {
        return;
    }
    buf.fill(area, " ", style);
    if (selected >= entries.size()) {
        selected = entries.size() - 1;
    }
    if (selected >= 0) {
        view.reveal(selected, entries.size(), area.h);
    }
    view.offset = view.clamped(entries.size(), area.h);
    int off = view.offset;
    int i = 0;
    while (i < area.h) {
        int k = off + i;
        if (k >= entries.size()) {
            return;
        }
        Entry e = entries[k];
        int y = area.y + i;
        tuistyle.Style st = style;
        if (k == selected) {
            st = st.merged(highlight_style);
            buf.fill(tuigeom.Rect(area.x, y, area.w, 1), " ", st);
        }
        int x = area.x + e.depth * indent;
        int room = area.right() - x;
        if (room > 0) {
            buf.set_str(x, y, tuitext.truncate(e.label, room), st, max: room);
        }
        i = i + 1;
    }
}
