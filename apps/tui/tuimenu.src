// A popup keyed by "what does the next keypress do" -- the which-key
// overlay -- and its sibling, the transient menu, built on the SAME
// underlying primitive rather than as two unrelated components. See
// `apps/git/design.md`: "a follow-up with flags opens the transient... built
// on top of the same overlay primitive".
//
// API
// ---
//   tuimenu.Item(key, label)                  one (key, label) pair
//   tuimenu.WhichKey(title, items)             the popup alone
//   tuimenu.Switch(key, label, flag)           one togglable flag
//   tuimenu.Transient(title, base, switches)   WhichKey's sibling: switches
//                                              plus a live command preview
//   transient.toggle(key)                      flip the switch bound to `key`
//   transient.preview()          -> str        the literal command line, as
//                                              it would run right now
//
// --- the shared base ---------------------------------------------------------
//
// Both are a `Popup`: a titled box, sized to its content and centred in
// whatever area it is given, drawn as plain text rows. `WhichKey` fills it
// with `key  label` rows; `Transient` fills it with `[x] key  label` rows for
// each switch, a blank line, and the rendered command -- but the box, the
// title, the centring and the border are one piece of code, not two.

import tuibuf;
import tuigeom;
import tuistyle;
import tuitext;
import tuiwidget;

/// One `(key, label)` pair -- one row of a `WhichKey` overlay.
pub type Item {
    pub str key;
    pub str label;
}

/// The shared base: a titled box, sized to its widest row and its title,
/// drawn centred in whatever area it is handed.
type Popup {
    str title;
    List<str> rows;
    tuistyle.Style style = tuistyle.Style();
    tuistyle.Style title_style = tuistyle.Style(attrs: tuistyle.BOLD);
    tuiwidget.Borders borders = tuiwidget.Borders.Rounded;
}

/// The box this popup needs, centred in `area` and never larger than it: as
/// wide as the title or the widest row plus the border and a column of
/// padding either side, as tall as the rows plus the border.
tuigeom.Rect Popup.sized(tuigeom.Rect area) {
    int w = tuitext.width(title);
    for (str r in rows) {
        int rw = tuitext.width(r);
        if (rw > w) {
            w = rw;
        }
    }
    w = w + 4;
    if (w > area.w) {
        w = area.w;
    }
    int h = rows.size() + 2;
    if (h > area.h) {
        h = area.h;
    }
    int x = area.x + (area.w - w) / 2;
    int y = area.y + (area.h - h) / 2;
    return tuigeom.Rect(x, y, w, h);
}

void Popup.render(tuibuf.Buffer buf, tuigeom.Rect area) {
    tuigeom.Rect box = sized(area);
    if (box.is_empty()) {
        return;
    }
    tuiwidget.Block block = tuiwidget.Block(title: title, borders: borders, style: style, title_style: title_style, pad_x: 1);
    block.render(buf, box);
    tuigeom.Rect inner = block.inner(box);
    int i = 0;
    while (i < inner.h && i < rows.size()) {
        buf.set_str(inner.x, inner.y + i, tuitext.truncate(rows[i], inner.w), style, max: inner.w);
        i = i + 1;
    }
}

/// `key`, padded to `keyw` columns, two spaces, then `label` -- the row
/// layout both overlays use.
str keyed_row(str key, str label, int keyw) {
    return tuitext.pad(key, keyw, tuitext.Align.Left) + "  " + label;
}

int widest(List<str> keys) {
    int w = 0;
    for (str k in keys) {
        int kw = tuitext.width(k);
        if (kw > w) {
            w = kw;
        }
    }
    return w;
}

/// A popup of "what does the next keypress do" -- a list of `(key, label)`
/// pairs, sized and centred by the shared `Popup`.
///
/// ```
/// tuimenu.WhichKey("commit", [tuimenu.Item("c", "commit"),
///     tuimenu.Item("a", "amend"), tuimenu.Item("f", "fixup")])
/// ```
pub type WhichKey {
    pub str title;
    pub List<Item> items;
    pub tuistyle.Style style = tuistyle.Style();
    pub tuistyle.Style title_style = tuistyle.Style(attrs: tuistyle.BOLD);
}

Popup WhichKey.popup() {
    List<str> keys = [];
    for (Item it in items) {
        keys.push(it.key);
    }
    int kw = widest(keys);
    List<str> rs = [];
    for (Item it in items) {
        rs.push(keyed_row(it.key, it.label, kw));
    }
    return Popup(title, rs, style: style, title_style: title_style);
}

pub void WhichKey.render(tuibuf.Buffer buf, tuigeom.Rect area) {
    popup().render(buf, area);
}

/// One togglable flag of a `Transient`: a key, a label to show for it, and
/// the literal command-line flag it contributes when it is on.
pub type Switch {
    pub str key;
    pub str label;
    pub str flag;
    pub bool on = false;
}

/// The which-key overlay's sibling: the same `Popup`, filled with togglable
/// switches instead of plain rows, plus a line showing the command exactly as
/// it would run right now.
///
/// `base` is the command with no flags -- `"commit"`, `"push"` -- and
/// `preview()` is `base` followed by the flag of every switch currently on,
/// in the order given. That string is both what is shown and what is meant
/// to actually run; there is deliberately no second copy of the logic that
/// decides which flags are active.
pub type Transient {
    pub str title;
    pub str base;
    pub List<Switch> switches;
    pub tuistyle.Style style = tuistyle.Style();
    pub tuistyle.Style title_style = tuistyle.Style(attrs: tuistyle.BOLD);
    pub tuistyle.Style preview_style = tuistyle.Style(attrs: tuistyle.DIM);
}

/// Flip the switch bound to `key`. Does nothing if no switch has that key.
pub void Transient.toggle(str key) {
    int i = 0;
    while (i < switches.size()) {
        if (switches[i].key == key) {
            switches[i].on = !switches[i].on;
            return;
        }
        i = i + 1;
    }
}

/// Is the switch bound to `key` currently on? False for a key with no switch.
pub bool Transient.is_on(str key) {
    for (Switch sw in switches) {
        if (sw.key == key) {
            return sw.on;
        }
    }
    return false;
}

/// The literal command line this transient would run right now.
pub str Transient.preview() {
    str s = base;
    for (Switch sw in switches) {
        if (sw.on) {
            s = s + " " + sw.flag;
        }
    }
    return s;
}

Popup Transient.popup() {
    List<str> keys = [];
    for (Switch sw in switches) {
        keys.push(sw.key);
    }
    int kw = widest(keys);
    List<str> rs = [];
    for (Switch sw in switches) {
        str mark = "[ ] ";
        if (sw.on) {
            mark = "[x] ";
        }
        rs.push(mark + keyed_row(sw.key, sw.label, kw));
    }
    rs.push("");
    rs.push(preview());
    return Popup(title, rs, style: style, title_style: title_style);
}

pub void Transient.render(tuibuf.Buffer buf, tuigeom.Rect area) {
    popup().render(buf, area);
}
