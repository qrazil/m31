// Colours, attributes, and the bytes a terminal wants for them.
//
// API
// ---
//   tuistyle.Colour           Default | Indexed(n) | Rgb(r, g, b)
//   tuistyle.Style            fg, bg, attrs -- constructed with named arguments
//   tuistyle.Depth            Ansi16 | Ansi256 | TrueColour
//   tuistyle.BOLD .. STRIKE   the attribute bits
//   style.pack()              a whole style as one `int`, which is what a
//                             `Buffer` stores and what the diff compares
//   tuistyle.sgr(out, from, to, depth)   the escape that turns one packed
//                             style into another, appended to `out`
//
// **A style is one `int`.** A buffer of 200x50 holds ten thousand cells, and
// a `Style` object per cell would be thirty thousand refcounted allocations
// per frame: one for the style and one for each of its two colours. So the
// public type is a struct, the stored form is a packed integer, and `pack`
// and `unpack` are the door between them. The packing is:
//
//     bits  0..24   foreground colour code
//     bits 25..49   background colour code
//     bits 50..55   attribute bits
//
// and a colour code is
//
//     0                      the terminal's default
//     1 + n                  palette entry n, 0..255
//     0x1000000 | 0xRRGGBB   a 24-bit colour
//
// Twenty-five bits each, six for the attributes, fifty-six in all: it fits
// in an `int` with room left, and the sign bit is never reached, so a packed
// style is always positive and `==` on two of them is the whole comparison
// the renderer needs.

/// Bold.
pub const int BOLD = 1;
/// Faint.
pub const int DIM = 2;
/// Italic.
pub const int ITALIC = 4;
/// Underlined.
pub const int UNDERLINE = 8;
/// Foreground and background swapped.
pub const int REVERSE = 16;
/// Struck through.
pub const int STRIKE = 32;
/// Every attribute bit, for masking.
pub const int ATTR_ALL = 63;
const int COL_BITS = 25;
const int COL_MASK = 0x1FF_FFFF;
const int COL_RGB = 0x100_0000;
const int ATTR_SHIFT = 50;

/// A colour, in the three forms a terminal understands.
///
/// `Indexed` is the 256-entry xterm palette, whose first sixteen entries are
/// the colours a 16-colour terminal has. `Rgb` is 24-bit. Either is written
/// out in whatever the `Depth` allows, converting down to the nearest entry
/// of the smaller palette -- so a program picks the colour it means and the
/// terminal decides what it gets.
pub enum Colour {
    Default;
    Indexed(int);
    Rgb(int, int, int);
}

/// The colour as its packed code. **Traps** on an index outside 0..255 or a
/// component outside 0..255: a palette entry the terminal has no name for is
/// the program's mistake, not the user's.
pub int Colour.code() {
    match (this) {
        case Default: {
            return 0;
        }
        case Indexed(int n): {
            if (n < 0 || n > 255) {
                trap("tuistyle.Colour.Indexed: a palette index is 0..255");
            }
            return 1 + n;
        }
        case Rgb(int r, int g, int b): {
            if (r < 0 || r > 255 || g < 0 || g > 255 || b < 0 || b > 255) {
                trap("tuistyle.Colour.Rgb: each component is 0..255");
            }
            return COL_RGB | r * 65536 | g * 256 | b;
        }
    }
}

/// The colour a packed code names. The inverse of `code`.
pub static Colour Colour.from_code(int c) {
    if (c == 0) {
        return Colour.Default;
    }
    if (c < COL_RGB) {
        return Colour.Indexed(c - 1);
    }
    int v = c & 0xFF_FFFF;
    return Colour.Rgb(v / 65536, v / 256 % 256, v % 256);
}

pub bool Colour.eq(Colour o) {
    return code() == o.code();
}

pub str Colour.to_str() {
    match (this) {
        case Default: {
            return "default";
        }
        case Indexed(int n): {
            return "index " + str(n);
        }
        case Rgb(int r, int g, int b): {
            return "rgb " + str(r) + "," + str(g) + "," + str(b);
        }
    }
}

/// How a cell is drawn: two colours and a set of attribute bits.
///
/// Every field has a default, so every field is named at construction and
/// `Style()` is the terminal's own idea of plain text:
///
/// ```
/// tuistyle.Style(fg: tuistyle.Colour.Indexed(3), attrs: tuistyle.BOLD)
/// ```
pub type Style {
    pub Colour fg = Colour.Default;
    pub Colour bg = Colour.Default;
    pub int attrs = 0;
}

/// The plain style: both colours the terminal's own, no attributes.
pub static Style Style.plain() {
    return Style();
}

/// The style as one `int`, the form a `Buffer` stores.
pub int Style.pack() {
    return fg.code() | bg.code() << COL_BITS | (attrs & ATTR_ALL) << ATTR_SHIFT;
}

/// The style a packed `int` holds. The inverse of `pack`.
pub static Style Style.unpack(int p) {
    return Style(fg: Colour.from_code(p & COL_MASK), bg: Colour.from_code(p >> COL_BITS & COL_MASK), attrs: p >> ATTR_SHIFT & ATTR_ALL);
}

pub bool Style.eq(Style o) {
    return pack() == o.pack();
}

/// This style with `c` as the foreground. A new `Style`; nothing is changed.
pub Style Style.with_fg(Colour c) {
    return Style(fg: c, bg: bg, attrs: attrs);
}

/// This style with `c` as the background.
pub Style Style.with_bg(Colour c) {
    return Style(fg: fg, bg: c, attrs: attrs);
}

/// This style with `a` added to its attributes.
pub Style Style.with_attrs(int a) {
    return Style(fg: fg, bg: bg, attrs: attrs | a & ATTR_ALL);
}

/// `over` laid on top of this one: each of `over`'s colours wins unless it
/// is `Default`, and their attributes are combined. This is what a widget
/// does with a highlight style.
pub Style Style.merged(Style over) {
    Colour f = fg;
    Colour b = bg;
    if (over.fg.code() != 0) {
        f = over.fg;
    }
    if (over.bg.code() != 0) {
        b = over.bg;
    }
    return Style(fg: f, bg: b, attrs: attrs | over.attrs);
}

pub str Style.to_str() {
    return "fg " + fg.to_str() + ", bg " + bg.to_str() + ", attrs " + str(attrs);
}

/// How many colours the terminal has. Stage 3 detects this; until then a
/// program says which it wants and the diff writes accordingly.
pub enum Depth {
    /// The original eight, and their bright forms: SGR 30-37 and 90-97.
    Ansi16;
    /// The xterm palette: SGR 38;5;n.
    Ansi256;
    /// 24-bit: SGR 38;2;r;g;b.
    TrueColour;
}

// --- the escape sequences ---------------------------------------------------

/// Append the decimal digits of `v` to `out`, without building a `str`.
///
/// `str(v).to_bytes()` is two allocations per number, and a frame writes a
/// few thousand numbers. This writes into the frame's own buffer.
pub void push_int(bytes out, int v) {
    if (v < 0) {
        out.push('-');
        push_int(out, -v);
        return;
    }
    if (v >= 10) {
        push_int(out, v / 10);
    }
    out.push(48 + v % 10);
}

/// Append `\x1b[` to `out`.
pub void push_csi(bytes out) {
    out.push(27);
    out.push('[');
}

/// The escape sequence that turns a terminal showing style `from` into one
/// showing style `to`, appended to `out`. Nothing at all when they are equal.
///
/// Only what changed is written: attributes that went away as their own
/// "off" codes rather than a reset, and a colour only when it is a different
/// colour. `from` is the pen the terminal is holding; at the start of a frame
/// that is `RESET_STYLE`, which is what `\x1b[0m` leaves behind.
pub void sgr(bytes out, int from, int to, Depth depth) {
    if (from == to) {
        return;
    }
    int pa = from >> ATTR_SHIFT & ATTR_ALL;
    int na = to >> ATTR_SHIFT & ATTR_ALL;
    int off = pa & ~na;
    int on = na & ~pa;
    List<int> codes = [];
    // SGR 22 turns off bold AND dim together, so whichever of the two
    // survives has to be written again after it.
    if ((off & (BOLD | DIM)) != 0) {
        codes.push(22);
        if ((na & BOLD) != 0) {
            codes.push(1);
        }
        if ((na & DIM) != 0) {
            codes.push(2);
        }
        on = on & ~(BOLD | DIM);
    }
    if ((off & ITALIC) != 0) {
        codes.push(23);
    }
    if ((off & UNDERLINE) != 0) {
        codes.push(24);
    }
    if ((off & REVERSE) != 0) {
        codes.push(27);
    }
    if ((off & STRIKE) != 0) {
        codes.push(29);
    }
    if ((on & BOLD) != 0) {
        codes.push(1);
    }
    if ((on & DIM) != 0) {
        codes.push(2);
    }
    if ((on & ITALIC) != 0) {
        codes.push(3);
    }
    if ((on & UNDERLINE) != 0) {
        codes.push(4);
    }
    if ((on & REVERSE) != 0) {
        codes.push(7);
    }
    if ((on & STRIKE) != 0) {
        codes.push(9);
    }
    int pf = from & COL_MASK;
    int nf = to & COL_MASK;
    if (pf != nf) {
        colour_codes(codes, nf, depth, false);
    }
    int pb = from >> COL_BITS & COL_MASK;
    int nb = to >> COL_BITS & COL_MASK;
    if (pb != nb) {
        colour_codes(codes, nb, depth, true);
    }
    if (codes.size() == 0) {
        return;
    }
    push_csi(out);
    for (int i in 0 .. codes.size()) {
        if (i > 0) {
            out.push(';');
        }
        push_int(out, codes[i]);
    }
    out.push('m');
}

/// `\x1b[0m`, the sequence that puts the terminal back to `RESET_STYLE`.
pub void push_reset(bytes out) {
    push_csi(out);
    out.push('0');
    out.push('m');
}

/// The packed style a terminal is in after `\x1b[0m`: both colours its own,
/// no attributes. A full redraw starts from here.
pub const int RESET_STYLE = 0;

/// The SGR parameters for colour code `c`, at this depth, on the foreground
/// or on the background.
void colour_codes(List<int> codes, int c, Depth depth, bool back) {
    int base = 30;
    if (back) {
        base = 40;
    }
    if (c == 0) {
        codes.push(base + 9);
        return;
    }
    if (c >= COL_RGB) {
        int v = c & 0xFF_FFFF;
        match (depth) {
            case TrueColour: {
                codes.push(base + 8);
                codes.push(2);
                codes.push(v / 65536);
                codes.push(v / 256 % 256);
                codes.push(v % 256);
            }
            case Ansi256: {
                codes.push(base + 8);
                codes.push(5);
                codes.push(rgb_to_256(v));
            }
            case Ansi16: {
                push_basic(codes, rgb_to_16(v), base);
            }
        }
        return;
    }
    int n = c - 1;
    match (depth) {
        case TrueColour: {
            if (n < 16) {
                push_basic(codes, n, base);
            } else {
                codes.push(base + 8);
                codes.push(5);
                codes.push(n);
            }
        }
        case Ansi256: {
            if (n < 16) {
                push_basic(codes, n, base);
            } else {
                codes.push(base + 8);
                codes.push(5);
                codes.push(n);
            }
        }
        case Ansi16: {
            if (n < 16) {
                push_basic(codes, n, base);
            } else {
                push_basic(codes, rgb_to_16(palette_rgb(n)), base);
            }
        }
    }
}

/// One of the sixteen, as SGR 30-37 or 90-97 (100-107 on a background).
void push_basic(List<int> codes, int n, int base) {
    if (n < 8) {
        codes.push(base + n);
    } else {
        codes.push(base + 52 + n);
    }
}

// The xterm palette. Sixteen named colours, then a 6x6x6 cube on the levels
// below, then twenty-four greys. Every terminal emulator agrees on these
// numbers; they are the ones xterm's `256colres.pl` generates.
const Array<int> ANSI16 = [0x000000, 0x800000, 0x008000, 0x808000, 0x000080, 0x800080, 0x008080, 0xC0C0C0, 0x808080, 0xFF0000, 0x00FF00, 0xFFFF00, 0x0000FF, 0xFF00FF, 0x00FFFF, 0xFFFFFF];
const Array<int> CUBE = [0, 95, 135, 175, 215, 255];

/// The 24-bit colour palette entry `n` stands for.
pub int palette_rgb(int n) {
    if (n < 0 || n > 255) {
        trap("tuistyle.palette_rgb: a palette index is 0..255");
    }
    if (n < 16) {
        return ANSI16[n];
    }
    if (n < 232) {
        int k = n - 16;
        return CUBE[k / 36] * 65536 | CUBE[k / 6 % 6] * 256 | CUBE[k % 6];
    }
    int g = 8 + (n - 232) * 10;
    return g * 65536 | g * 256 | g;
}

/// The palette entry closest to a 24-bit colour: the nearer of the cube
/// entry and the grey ramp entry, by squared distance in RGB.
pub int rgb_to_256(int v) {
    int r = v / 65536;
    int g = v / 256 % 256;
    int b = v % 256;
    int ci = 16 + cube_level(r) * 36 + cube_level(g) * 6 + cube_level(b);
    int cd = dist(palette_rgb(ci), r, g, b);
    int gi = grey_index(r, g, b);
    int gd = dist(palette_rgb(gi), r, g, b);
    if (gd < cd) {
        return gi;
    }
    return ci;
}

/// The one of the sixteen closest to a 24-bit colour.
pub int rgb_to_16(int v) {
    int r = v / 65536;
    int g = v / 256 % 256;
    int b = v % 256;
    int best = 0;
    int bd = dist(ANSI16[0], r, g, b);
    for (int i in 1 .. 16) {
        int d = dist(ANSI16[i], r, g, b);
        if (d < bd) {
            bd = d;
            best = i;
        }
    }
    return best;
}

int cube_level(int c) {
    int i = 0;
    int best = 0;
    int bd = 1000;
    while (i < 6) {
        int d = CUBE[i] - c;
        if (d < 0) {
            d = -d;
        }
        if (d < bd) {
            bd = d;
            best = i;
        }
        i = i + 1;
    }
    return best;
}

int grey_index(int r, int g, int b) {
    int avg = (r + g + b) / 3;
    if (avg < 8) {
        return 232;
    }
    if (avg > 238) {
        return 255;
    }
    return 232 + (avg - 8) / 10;
}

int dist(int v, int r, int g, int b) {
    int dr = v / 65536 - r;
    int dg = v / 256 % 256 - g;
    int db = v % 256 - b;
    return dr * dr + dg * dg + db * db;
}
