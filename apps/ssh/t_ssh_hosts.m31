// `lib/sshhosts.m31`, self-checked: the known_hosts rules (plain names,
// `[host]:port`, wildcards, negation, markers, comments, odd whitespace),
// one fixture per `sshhosts.Error` variant, and hashed entries -- both three
// lines written by a real `ssh-keygen -H` (pinned below) and, when `test.sh`
// passes two paths, a plain file and the `ssh-keygen -H` copy of it made at
// test time, which must answer identically for every name asked.
//
//     t_ssh_hosts [<plain known_hosts> <hashed copy>]
//
// A `trap` means a check failed.
import io;
import os;
import base64;
import ssh;
import sshhosts;

int check(int n, bool ok, str label) {
    if (!ok) {
        trap("check failed: " + label);
    }
    return n + 1;
}

int error_code(sshhosts.Error e) {
    match (e) {
        case Io: {
            return 0;
        }
        case MalformedLine: {
            return 1;
        }
        case BadKey: {
            return 2;
        }
        case UnknownHost: {
            return 3;
        }
        case Revoked: {
            return 4;
        }
    }
}

const int ERR_IO = 0;
const int ERR_MALFORMED = 1;
const int ERR_BAD_KEY = 2;
const int ERR_UNKNOWN = 3;
const int ERR_REVOKED = 4;

bytes key_of(int fill) {
    bytes out = [];
    int i = 0;
    while (i < 32) {
        out.push((fill + i) & 0xFF);
        i = i + 1;
    }
    return out;
}

// The base64 of `string "ssh-ed25519" || string key`, as a known_hosts line
// carries it.
str b64_of(bytes key) {
    bytes blob = [];
    ssh.push_string(blob, "ssh-ed25519".to_bytes());
    ssh.push_string(blob, key);
    return base64.encode(blob);
}

str ed(bytes key) {
    return "ssh-ed25519 " + b64_of(key);
}

// -1 if `text` parsed, else the error code.
int parse_refusal(str text) {
    match (sshhosts.parse(text)) {
        case Ok(sshhosts.KnownHosts kh): {
            return -1;
        }
        case Err(sshhosts.Error e): {
            return error_code(e);
        }
    }
}

// The keys `text` trusts for `host:port`, as one hex string of each key's
// first byte joined with commas ("" for a refusal); `code` receives -1 for a
// hit, or the refusal's code.
sshhosts.KnownHosts must_parse(str text) {
    match (sshhosts.parse(text)) {
        case Ok(sshhosts.KnownHosts kh): {
            return kh;
        }
        case Err(sshhosts.Error e): {
            trap("known_hosts did not parse: " + e.to_str());
        }
    }
}

// The first byte of every key returned for `host:port`, comma-joined, or
// "!<code>" for a refusal.
str answer(sshhosts.KnownHosts kh, str host, int port) {
    match (kh.keys_for(host, port)) {
        case Ok(List<bytes> keys): {
            List<str> firsts = [];
            for (bytes k in keys) {
                firsts.push(k[0].to_str());
            }
            return firsts.join(",");
        }
        case Err(sshhosts.Error e): {
            return "!" + error_code(e).to_str();
        }
    }
}

int checks = 0;
bytes k1 = key_of(10);
bytes k2 = key_of(50);
bytes k3 = key_of(90);

// --- 1. matching rules -------------------------------------------------------

str rules = "# a comment\n\n" + "example.com,10.0.0.1 " + ed(k1) + " comment on the line\n" + "[example.com]:2222 " + ed(k2) + "\n" + "  \t*.corp.example,!secret.corp.example\t" + ed(k3) + "\n" + "h?.lab " + ed(k1) + "\r\n" + "twice.example " + ed(k1) + "\n" + "twice.example " + ed(k2) + "\n";
sshhosts.KnownHosts kh = must_parse(rules);
checks = check(checks, answer(kh, "example.com", 22) == "10", "a plain name matches port 22");
checks = check(checks, answer(kh, "EXAMPLE.Com", 22) == "10", "host names compare case-insensitively");
checks = check(checks, answer(kh, "10.0.0.1", 22) == "10", "the second name of a list matches");
checks = check(checks, answer(kh, "example.com", 2222) == "50", "[host]:port matches only that port");
checks = check(checks, answer(kh, "example.com", 2223) == "!3", "another port is unknown");
checks = check(checks, answer(kh, "10.0.0.1", 2222) == "!3", "a plain name does not match a non-default port");
checks = check(checks, answer(kh, "a.corp.example", 22) == "90", "a * wildcard matches");
checks = check(checks, answer(kh, "x.y.corp.example", 22) == "90", "a * wildcard spans dots");
checks = check(checks, answer(kh, "secret.corp.example", 22) == "!3", "a ! pattern excludes");
checks = check(checks, answer(kh, "corp.example", 22) == "!3", "*.corp.example needs the dot");
checks = check(checks, answer(kh, "h1.lab", 22) == "10", "a ? wildcard matches one character");
checks = check(checks, answer(kh, "h.lab", 22) == "!3", "a ? wildcard does not match nothing");
checks = check(checks, answer(kh, "h12.lab", 22) == "!3", "a ? wildcard does not match two");
checks = check(checks, answer(kh, "twice.example", 22) == "10,50", "two entries for one host both come back, in file order");
checks = check(checks, answer(kh, "nowhere", 22) == "!3", "an unlisted host is unknown (there is no trust on first use)");
checks = check(checks, answer(kh, "", 22) == "!3", "an empty host is unknown");

// --- 2. markers and skipped lines -------------------------------------------

sshhosts.KnownHosts marks = must_parse("@revoked bad.example " + ed(k2) + "\n" + "bad.example " + ed(k1) + "\n" + "bad.example " + ed(k2) + "\n" + "onlyrevoked.example " + ed(k2) + "\n" + "@revoked onlyrevoked.example " + ed(k2) + "\n" + "@cert-authority *.ca.example " + ed(k3) + "\n" + "rsa.example ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC\n" + "ecdsa.example ecdsa-sha2-nistp256 notbase64!!\n");
checks = check(checks, answer(marks, "bad.example", 22) == "10", "a @revoked key is removed from the answer");
checks = check(checks, answer(marks, "onlyrevoked.example", 22) == "!4", "a host with only revoked keys is Revoked");
checks = check(checks, answer(marks, "x.ca.example", 22) == "!3", "a @cert-authority line grants nothing");
checks = check(checks, answer(marks, "rsa.example", 22) == "!3", "a non-ed25519 line is skipped");
checks = check(checks, answer(marks, "ecdsa.example", 22) == "!3", "a non-ed25519 line is skipped even if its key is junk");

// --- 3. one fixture per Error variant ---------------------------------------

match (sshhosts.load("/nonexistent/dir/known_hosts")) {
    case Ok(sshhosts.KnownHosts x): {
        trap("a missing file loaded");
    }
    case Err(sshhosts.Error e): {
        checks = check(checks, error_code(e) == ERR_IO, "a missing file is Error.Io");
    }
}
checks = check(checks, parse_refusal("example.com ssh-ed25519\n") == ERR_MALFORMED, "a line without a key is MalformedLine");
checks = check(checks, parse_refusal("example.com\n") == ERR_MALFORMED, "a line with one field is MalformedLine");
checks = check(checks, parse_refusal("@revoked example.com\n") == ERR_MALFORMED, "a marker with too few fields is MalformedLine");
checks = check(checks, parse_refusal("@bogus example.com " + ed(k1) + "\n") == ERR_MALFORMED, "an unknown marker is MalformedLine");
checks = check(checks, parse_refusal("a,,b " + ed(k1) + "\n") == ERR_MALFORMED, "an empty pattern is MalformedLine");
checks = check(checks, parse_refusal(",a " + ed(k1) + "\n") == ERR_MALFORMED, "a leading comma is MalformedLine");
checks = check(checks, parse_refusal("|1|AAAA|AAAA " + ed(k1) + "\n") == ERR_MALFORMED, "a hashed entry whose hash is the wrong size is MalformedLine");
checks = check(checks, parse_refusal("|1|!!!|!!! " + ed(k1) + "\n") == ERR_MALFORMED, "a hashed entry that is not base64 is MalformedLine");
checks = check(checks, parse_refusal("|2|AAAA|AAAAAAAAAAAAAAAAAAAAAAAAAAA= " + ed(k1) + "\n") == ERR_MALFORMED, "a hash scheme other than 1 is MalformedLine");
checks = check(checks, parse_refusal("|1|Lwm6H/DrNjLZVKRxcfktUhO3emc=|P2mvjY0ed6Chn7W0BSHQRDo3qgY=,other " + ed(k1) + "\n") == ERR_MALFORMED, "a hashed entry in a list is MalformedLine");
checks = check(checks, parse_refusal("example.com ssh-ed25519 !!!notbase64\n") == ERR_BAD_KEY, "an ed25519 key that is not base64 is BadKey");
bytes short_blob = [];
ssh.push_string(short_blob, "ssh-ed25519".to_bytes());
ssh.push_string(short_blob, key_of(1).substr(0, 31));
checks = check(checks, parse_refusal("example.com ssh-ed25519 " + base64.encode(short_blob) + "\n") == ERR_BAD_KEY, "a 31-byte key is BadKey");
bytes wrong_type = [];
ssh.push_string(wrong_type, "ssh-rsa".to_bytes());
ssh.push_string(wrong_type, key_of(1));
checks = check(checks, parse_refusal("example.com ssh-ed25519 " + base64.encode(wrong_type) + "\n") == ERR_BAD_KEY, "a blob whose inner type is not ssh-ed25519 is BadKey");
checks = check(checks, parse_refusal("example.com ssh-ed25519 AAAA\n") == ERR_BAD_KEY, "a truncated blob is BadKey");
checks = check(checks, parse_refusal("") == -1, "an empty file parses (and trusts nothing)");
checks = check(checks, answer(must_parse(""), "example.com", 22) == "!3", "an empty file trusts nothing");
// The refusal is for a malformed line even when other lines are fine.
checks = check(checks, parse_refusal("good.example " + ed(k1) + "\nbad line\n") == ERR_MALFORMED, "one malformed line fails the whole file");
// UnknownHost and Revoked are covered above (answer == "!3" / "!4").

// --- 4. hashed entries written by a real ssh-keygen -H ----------------------

str real_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPZYGbieg/cWYH9HrUZD9nZR4Z7pLUA4BfTZsQ62QZEZ";
sshhosts.KnownHosts hashed = must_parse("|1|Lwm6H/DrNjLZVKRxcfktUhO3emc=|P2mvjY0ed6Chn7W0BSHQRDo3qgY= " + real_key + "\n" + "|1|VApXcPyuk2mSBVAyUt/0M7YjF0I=|ykkNWpkUi53VZYp+2Szf7/zgxY4= " + real_key + "\n" + "|1|J1YZpIVbShFPYQ76yRscm/lAjVY=|wje222ou8hsDDYC7NrD6USQULNE= " + real_key + "\n");
// (ssh-keygen -H of: "example.com,10.0.0.1" and "[other.org]:2222".)
match (hashed.keys_for("example.com", 22)) {
    case Ok(List<bytes> keys): {
        checks = check(checks, keys.size() == 1 && keys[0].hex() == "f65819b89e83f716607f47ad4643f67651e19ee92d403805f4d9b10eb6419119", "a hashed entry yields the right key");
    }
    case Err(sshhosts.Error e): {
        trap("hashed example.com: " + e.to_str());
    }
}
checks = check(checks, answer(hashed, "EXAMPLE.COM", 22) != "!3", "a hashed entry matches case-insensitively");
checks = check(checks, answer(hashed, "10.0.0.1", 22) != "!3", "a hashed entry matches the second name of a list");
checks = check(checks, answer(hashed, "other.org", 2222) != "!3", "a hashed [host]:port entry matches that port");
checks = check(checks, answer(hashed, "other.org", 22) == "!3", "a hashed [host]:port entry does not match port 22");
checks = check(checks, answer(hashed, "example.com", 2222) == "!3", "a hashed plain entry does not match another port");
checks = check(checks, answer(hashed, "nope.example", 22) == "!3", "an unlisted host is unknown beside hashed entries");
print(checks.to_str() + " checks, 0 failures");

// --- 5. a plain file and its `ssh-keygen -H` copy agree ----------------------

List<str> arguments = os.args();
if (arguments.size() >= 3) {
    sshhosts.KnownHosts plain = kh;
    sshhosts.KnownHosts copy = kh;
    match (sshhosts.load(arguments[1])) {
        case Ok(sshhosts.KnownHosts x): {
            plain = x;
        }
        case Err(sshhosts.Error e): {
            trap("plain known_hosts: " + e.to_str());
        }
    }
    match (sshhosts.load(arguments[2])) {
        case Ok(sshhosts.KnownHosts x): {
            copy = x;
        }
        case Err(sshhosts.Error e): {
            trap("hashed known_hosts: " + e.to_str());
        }
    }
    List<str> names = ["oracle.example", "ORACLE.example", "other.example", "10.1.2.3", "unlisted.example", "lab.example"];
    List<int> ports = [22, 22, 2222, 22, 22, 2200];
    int i = 0;
    while (i < names.size()) {
        str a = answer(plain, names[i], ports[i]);
        str b = answer(copy, names[i], ports[i]);
        if (a != b) {
            trap("plain and hashed known_hosts disagree for " + names[i] + ": " + a + " vs " + b);
        }
        print(names[i] + ":" + ports[i].to_str() + " -> " + a);
        i = i + 1;
    }
}
