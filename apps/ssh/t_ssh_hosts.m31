// `lib/ssh/sshhosts.m31`, self-checked: the known_hosts rules (plain names,
// `[host]:port`, wildcards, negation, markers, comments, odd whitespace),
// one fixture per `sshhosts.Error` variant, and hashed entries -- both three
// lines written by a real `ssh-keygen -H` (pinned below) and, when `test.sh`
// passes two paths, a plain file and the `ssh-keygen -H` copy of it made at
// test time, which must answer identically for every name asked.
//
//     t_ssh_hosts [<plain known_hosts> <hashed copy>]
//
// A `trap` means a check failed.
import io;
import os;
import encoding.base64;
import ssh;
import ssh.sshhosts;

int check(int passed_count, bool is_ok, str label) {
    if (!is_ok) {
        trap("check failed: " + label);
    }
    return passed_count + 1;
}

int error_code(sshhosts.Error error) {
    match (error) {
        case Io: {
            return 0;
        }
        case MalformedLine: {
            return 1;
        }
        case BadKey: {
            return 2;
        }
        case UnknownHost: {
            return 3;
        }
        case Revoked: {
            return 4;
        }
        case Write: {
            return 5;
        }
    }
}

const int ERROR_IO = 0;
const int ERROR_MALFORMED = 1;
const int ERROR_BAD_KEY = 2;
const int ERROR_UNKNOWN = 3;
const int ERROR_REVOKED = 4;
const int ERROR_WRITE = 5;

bytes key_of(int fill) {
    bytes out = [];
    int index = 0;
    while (index < 32) {
        out.push((fill + index) & 0xFF);
        index = index + 1;
    }
    return out;
}

// The base64 of `string "ssh-ed25519" || string key`, as a known_hosts line
// carries it.
str b64_of(bytes key) {
    bytes blob = [];
    ssh.push_string(blob, "ssh-ed25519".to_bytes());
    ssh.push_string(blob, key);
    return base64.encode(blob);
}

str ed25519_line(bytes key) {
    return "ssh-ed25519 " + b64_of(key);
}

// -1 if `text` parsed, else the error code.
int parse_refusal(str text) {
    match (sshhosts.parse(text)) {
        case Ok(_): {
            return -1;
        }
        case Err(sshhosts.Error error): {
            return error_code(error);
        }
    }
}

// The keys `text` trusts for `host:port`, as one hex string of each key's
// first byte joined with commas ("" for a refusal); `code` receives -1 for a
// hit, or the refusal's code.
sshhosts.KnownHosts must_parse(str text) {
    match (sshhosts.parse(text)) {
        case Ok(sshhosts.KnownHosts known_hosts): {
            return known_hosts;
        }
        case Err(sshhosts.Error error): {
            trap("known_hosts did not parse: " + error.to_str());
        }
    }
}

// The first byte of every key returned for `host:port`, comma-joined, or
// "!<code>" for a refusal.
str answer(sshhosts.KnownHosts known_hosts, str host, int port) {
    match (known_hosts.keys_for(host, port)) {
        case Ok(List<bytes> keys): {
            List<str> firsts = [];
            for (bytes key in keys) {
                firsts.push(key[0].to_str());
            }
            return firsts.join(",");
        }
        case Err(sshhosts.Error error): {
            return "!" + error_code(error).to_str();
        }
    }
}

int checks = 0;
bytes first_key = key_of(10);
bytes second_key = key_of(50);
bytes third_key = key_of(90);

// --- 1. matching rules -------------------------------------------------------

str rules = "# a comment\n\n" + "example.com,10.0.0.1 " + ed25519_line(first_key) + " comment on the line\n" + "[example.com]:2222 " + ed25519_line(second_key) + "\n" + "  \t*.corp.example,!secret.corp.example\t" + ed25519_line(third_key) + "\n" + "h?.lab " + ed25519_line(first_key) + "\r\n" + "twice.example " + ed25519_line(first_key) + "\n" + "twice.example " + ed25519_line(second_key) + "\n";
sshhosts.KnownHosts rules_hosts = must_parse(rules);
checks = check(checks, answer(rules_hosts, "example.com", 22) == "10", "a plain name matches port 22");
checks = check(checks, answer(rules_hosts, "EXAMPLE.Com", 22) == "10", "host names compare case-insensitively");
checks = check(checks, answer(rules_hosts, "10.0.0.1", 22) == "10", "the second name of a list matches");
checks = check(checks, answer(rules_hosts, "example.com", 2222) == "50", "[host]:port matches only that port");
checks = check(checks, answer(rules_hosts, "example.com", 2223) == "!3", "another port is unknown");
checks = check(checks, answer(rules_hosts, "10.0.0.1", 2222) == "!3", "a plain name does not match a non-default port");
checks = check(checks, answer(rules_hosts, "a.corp.example", 22) == "90", "a * wildcard matches");
checks = check(checks, answer(rules_hosts, "x.y.corp.example", 22) == "90", "a * wildcard spans dots");
checks = check(checks, answer(rules_hosts, "secret.corp.example", 22) == "!3", "a ! pattern excludes");
checks = check(checks, answer(rules_hosts, "corp.example", 22) == "!3", "*.corp.example needs the dot");
checks = check(checks, answer(rules_hosts, "h1.lab", 22) == "10", "a ? wildcard matches one character");
checks = check(checks, answer(rules_hosts, "h.lab", 22) == "!3", "a ? wildcard does not match nothing");
checks = check(checks, answer(rules_hosts, "h12.lab", 22) == "!3", "a ? wildcard does not match two");
checks = check(checks, answer(rules_hosts, "twice.example", 22) == "10,50", "two entries for one host both come back, in file order");
checks = check(checks, answer(rules_hosts, "nowhere", 22) == "!3", "an unlisted host is unknown (there is no trust on first use)");
checks = check(checks, answer(rules_hosts, "", 22) == "!3", "an empty host is unknown");

// --- 2. markers and skipped lines -------------------------------------------

sshhosts.KnownHosts marks = must_parse("@revoked bad.example " + ed25519_line(second_key) + "\n" + "bad.example " + ed25519_line(first_key) + "\n" + "bad.example " + ed25519_line(second_key) + "\n" + "onlyrevoked.example " + ed25519_line(second_key) + "\n" + "@revoked onlyrevoked.example " + ed25519_line(second_key) + "\n" + "@cert-authority *.ca.example " + ed25519_line(third_key) + "\n" + "rsa.example ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC\n" + "ecdsa.example ecdsa-sha2-nistp256 notbase64!!\n");
checks = check(checks, answer(marks, "bad.example", 22) == "10", "a @revoked key is removed from the answer");
checks = check(checks, answer(marks, "onlyrevoked.example", 22) == "!4", "a host with only revoked keys is Revoked");
checks = check(checks, answer(marks, "x.ca.example", 22) == "!3", "a @cert-authority line grants nothing");
checks = check(checks, answer(marks, "rsa.example", 22) == "!3", "a non-ed25519 line is skipped");
checks = check(checks, answer(marks, "ecdsa.example", 22) == "!3", "a non-ed25519 line is skipped even if its key is junk");

// --- 3. one fixture per Error variant ---------------------------------------

match (sshhosts.load("/nonexistent/dir/known_hosts")) {
    case Ok(_): {
        trap("a missing file loaded");
    }
    case Err(sshhosts.Error error): {
        checks = check(checks, error_code(error) == ERROR_IO, "a missing file is Error.Io");
    }
}
checks = check(checks, parse_refusal("example.com ssh-ed25519\n") == ERROR_MALFORMED, "a line without a key is MalformedLine");
checks = check(checks, parse_refusal("example.com\n") == ERROR_MALFORMED, "a line with one field is MalformedLine");
checks = check(checks, parse_refusal("@revoked example.com\n") == ERROR_MALFORMED, "a marker with too few fields is MalformedLine");
checks = check(checks, parse_refusal("@bogus example.com " + ed25519_line(first_key) + "\n") == ERROR_MALFORMED, "an unknown marker is MalformedLine");
checks = check(checks, parse_refusal("a,,b " + ed25519_line(first_key) + "\n") == ERROR_MALFORMED, "an empty pattern is MalformedLine");
checks = check(checks, parse_refusal(",a " + ed25519_line(first_key) + "\n") == ERROR_MALFORMED, "a leading comma is MalformedLine");
checks = check(checks, parse_refusal("|1|AAAA|AAAA " + ed25519_line(first_key) + "\n") == ERROR_MALFORMED, "a hashed entry whose hash is the wrong size is MalformedLine");
checks = check(checks, parse_refusal("|1|!!!|!!! " + ed25519_line(first_key) + "\n") == ERROR_MALFORMED, "a hashed entry that is not base64 is MalformedLine");
checks = check(checks, parse_refusal("|2|AAAA|AAAAAAAAAAAAAAAAAAAAAAAAAAA= " + ed25519_line(first_key) + "\n") == ERROR_MALFORMED, "a hash scheme other than 1 is MalformedLine");
checks = check(checks, parse_refusal("|1|Lwm6H/DrNjLZVKRxcfktUhO3emc=|P2mvjY0ed6Chn7W0BSHQRDo3qgY=,other " + ed25519_line(first_key) + "\n") == ERROR_MALFORMED, "a hashed entry in a list is MalformedLine");
checks = check(checks, parse_refusal("example.com ssh-ed25519 !!!notbase64\n") == ERROR_BAD_KEY, "an ed25519 key that is not base64 is BadKey");
bytes short_blob = [];
ssh.push_string(short_blob, "ssh-ed25519".to_bytes());
ssh.push_string(short_blob, key_of(1).substr(0, 31));
checks = check(checks, parse_refusal("example.com ssh-ed25519 " + base64.encode(short_blob) + "\n") == ERROR_BAD_KEY, "a 31-byte key is BadKey");
bytes wrong_type = [];
ssh.push_string(wrong_type, "ssh-rsa".to_bytes());
ssh.push_string(wrong_type, key_of(1));
checks = check(checks, parse_refusal("example.com ssh-ed25519 " + base64.encode(wrong_type) + "\n") == ERROR_BAD_KEY, "a blob whose inner type is not ssh-ed25519 is BadKey");
checks = check(checks, parse_refusal("example.com ssh-ed25519 AAAA\n") == ERROR_BAD_KEY, "a truncated blob is BadKey");
checks = check(checks, parse_refusal("") == -1, "an empty file parses (and trusts nothing)");
checks = check(checks, answer(must_parse(""), "example.com", 22) == "!3", "an empty file trusts nothing");
// The refusal is for a malformed line even when other lines are fine.
checks = check(checks, parse_refusal("good.example " + ed25519_line(first_key) + "\nbad line\n") == ERROR_MALFORMED, "one malformed line fails the whole file");
// UnknownHost and Revoked are covered above (answer == "!3" / "!4").

// --- 4. hashed entries written by a real ssh-keygen -H ----------------------

str real_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPZYGbieg/cWYH9HrUZD9nZR4Z7pLUA4BfTZsQ62QZEZ";
sshhosts.KnownHosts hashed = must_parse("|1|Lwm6H/DrNjLZVKRxcfktUhO3emc=|P2mvjY0ed6Chn7W0BSHQRDo3qgY= " + real_key + "\n" + "|1|VApXcPyuk2mSBVAyUt/0M7YjF0I=|ykkNWpkUi53VZYp+2Szf7/zgxY4= " + real_key + "\n" + "|1|J1YZpIVbShFPYQ76yRscm/lAjVY=|wje222ou8hsDDYC7NrD6USQULNE= " + real_key + "\n");
// (ssh-keygen -H of: "example.com,10.0.0.1" and "[other.org]:2222".)
match (hashed.keys_for("example.com", 22)) {
    case Ok(List<bytes> keys): {
        checks = check(checks, keys.size() == 1 && keys[0].hex() == "f65819b89e83f716607f47ad4643f67651e19ee92d403805f4d9b10eb6419119", "a hashed entry yields the right key");
    }
    case Err(sshhosts.Error error): {
        trap("hashed example.com: " + error.to_str());
    }
}
checks = check(checks, answer(hashed, "EXAMPLE.COM", 22) != "!3", "a hashed entry matches case-insensitively");
checks = check(checks, answer(hashed, "10.0.0.1", 22) != "!3", "a hashed entry matches the second name of a list");
checks = check(checks, answer(hashed, "other.org", 2222) != "!3", "a hashed [host]:port entry matches that port");
checks = check(checks, answer(hashed, "other.org", 22) == "!3", "a hashed [host]:port entry does not match port 22");
checks = check(checks, answer(hashed, "example.com", 2222) == "!3", "a hashed plain entry does not match another port");
checks = check(checks, answer(hashed, "nope.example", 22) == "!3", "an unlisted host is unknown beside hashed entries");
// --- 7. writing a line: the presented key, its fingerprint, `line`, `hashed_line` ---
//
// Vectors computed with Python's hashlib/hmac (the same HMAC-SHA1 and SHA-256
// OpenSSH uses). The live half -- `add` writing real files, read back by the
// real ssh-keygen and ssh -- is in `test_auth_exec.sh`.

bytes blob7 = [];
ssh.push_string(blob7, "ssh-ed25519".to_bytes());
ssh.push_string(blob7, k1);
ssh.HostKey hk = ssh.HostKey("ssh-ed25519", blob7, k1);
checks = check(checks, hk.blob_base64() == "AAAAC3NzaC1lZDI1NTE5AAAAIAoLDA0ODxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJygp", "HostKey.blob_base64 is the known_hosts key column");
checks = check(checks, hk.fingerprint() == "SHA256:DZmPsbaWctxL57bCPdqkfYHPQS2xqBQI6Py0g0hWu20", "HostKey.fingerprint is SHA256: and unpadded base64 of the blob digest");
checks = check(checks, sshhosts.plain_line("example.com", 22, hk) == "example.com ssh-ed25519 " + hk.blob_base64(), "a port-22 line names the bare host");
checks = check(checks, sshhosts.plain_line("Example.COM", 2222, hk) == "[example.com]:2222 ssh-ed25519 " + hk.blob_base64(), "another port is [host]:port, lower-cased");
bytes salt7 = [];
int si = 1;
while (si <= 20) {
    salt7.push(si);
    si = si + 1;
}
checks = check(checks, sshhosts.hashed_line("example.com", 22, hk, salt7) == "|1|AQIDBAUGBwgJCgsMDQ4PEBESExQ=|qvtG0DaqrsqPDhV2Ni+wmYohchA= ssh-ed25519 " + hk.blob_base64(), "a hashed line has OpenSSH's |1|salt|HMAC-SHA1 name");
checks = check(checks, sshhosts.hashed_line("Example.com", 2222, hk, salt7) == "|1|AQIDBAUGBwgJCgsMDQ4PEBESExQ=|uVLj+YL3GsbtNOcCoC7AMM/WVh0= ssh-ed25519 " + hk.blob_base64(), "a hashed [host]:port line hashes the bracketed name");
sshhosts.KnownHosts written = must_parse(sshhosts.plain_line("example.com", 22, hk) + "\n" + sshhosts.plain_line("example.com", 2222, hk) + "\n" + sshhosts.hashed_line("hashed.example", 2200, hk, salt7) + "\n");
checks = check(checks, answer(written, "example.com", 22) == "10", "a written plain line is found again by keys_for");
checks = check(checks, answer(written, "EXAMPLE.com", 2222) == "10", "a written [host]:port line is found again, case-folded");
checks = check(checks, answer(written, "hashed.example", 2200) == "10", "a written hashed line is found again");
checks = check(checks, answer(written, "hashed.example", 22) == "!3", "a written hashed line does not match another port");
sshhosts.KnownHosts revoking = must_parse("@revoked revoked.example " + ed(k1) + "\n" + "@revoked *.wild.example " + ed(k2) + "\n" + "plain.example " + ed(k3) + "\n");
ssh.HostKey hk2 = ssh.HostKey("ssh-ed25519", [], k2);
ssh.HostKey hk3 = ssh.HostKey("ssh-ed25519", [], k3);
checks = check(checks, answer(revoking, "revoked.example", 22) == "!3", "a lone @revoked line leaves the host unknown to keys_for");
checks = check(checks, revoking.is_revoked("revoked.example", 22, hk), "is_revoked: the revoked key for that host");
checks = check(checks, !revoking.is_revoked("revoked.example", 22, hk2), "is_revoked: not another key for that host");
checks = check(checks, !revoking.is_revoked("other.example", 22, hk), "is_revoked: not the same key for another host");
checks = check(checks, !revoking.is_revoked("revoked.example", 2222, hk), "is_revoked: not on another port");
checks = check(checks, revoking.is_revoked("a.wild.example", 22, hk2), "is_revoked: a wildcard @revoked line");
checks = check(checks, !revoking.is_revoked("plain.example", 22, hk3), "is_revoked: a trusted key is not revoked");
checks = check(checks, ERROR_WRITE == error_code(sshhosts.Error.Write), "Error.Write has its own code");
print(checks.to_str() + " checks, 0 failures");

// --- 5. a plain file and its `ssh-keygen -H` copy agree ----------------------

List<str> arguments = os.arguments();
if (arguments.size() >= 3) {
    sshhosts.KnownHosts plain = rules_hosts;
    sshhosts.KnownHosts copy = rules_hosts;
    match (sshhosts.load(arguments[1])) {
        case Ok(sshhosts.KnownHosts loaded_hosts): {
            plain = loaded_hosts;
        }
        case Err(sshhosts.Error error): {
            trap("plain known_hosts: " + error.to_str());
        }
    }
    match (sshhosts.load(arguments[2])) {
        case Ok(sshhosts.KnownHosts loaded_hosts): {
            copy = loaded_hosts;
        }
        case Err(sshhosts.Error error): {
            trap("hashed known_hosts: " + error.to_str());
        }
    }
    List<str> names = ["oracle.example", "ORACLE.example", "other.example", "10.1.2.3", "unlisted.example", "lab.example"];
    List<int> ports = [22, 22, 2222, 22, 22, 2200];
    int name_index = 0;
    while (name_index < names.size()) {
        str plain_answer = answer(plain, names[name_index], ports[name_index]);
        str copy_answer = answer(copy, names[name_index], ports[name_index]);
        if (plain_answer != copy_answer) {
            trap("plain and hashed known_hosts disagree for " + names[name_index] + ": " + plain_answer + " vs " + copy_answer);
        }
        print(names[name_index] + ":" + ports[name_index].to_str() + " -> " + plain_answer);
        name_index = name_index + 1;
    }
}
