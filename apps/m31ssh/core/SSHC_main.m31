// m31ssh: connect, check the host key, authenticate, run a command or a
// shell. UNAUDITED -- docs/m31ssh.md says what that means.

import io;
import os;
import fs;
import net;
import term;
import ssh;
import ssh.sshkey;
import ssh.sshhosts;
import ssh.sshauth;
import ssh.sshexec;
import ssh.sshagent;
import ssh.sshconfig;
import ssh.sshshell;
import core.SSHC_cli;

const int EXIT_ERROR = 255;
const int HANDSHAKE_TIMEOUT_MS = 30000;
const int STALL_TIMEOUT_MS = 60000;

void warn(str message) {
    io.eprint("m31ssh: " + message);
}

// A server-supplied string made safe to print: control characters (except
// newline and tab) are dropped, so a banner or a name cannot move the cursor,
// retitle the window or inject escape sequences.
str sanitize(str text) {
    str out = "";
    for (int code in text.chars()) {
        if (code == 10 || code == 9 || (code >= 32 && code != 127 && !(code >= 128 && code < 160))) {
            out = out + str.from_chars([code]);
        }
    }
    return out;
}

str home_directory() {
    match (os.env("HOME")) {
        case Some(str home): {
            return home;
        }
        case None: {
            return "";
        }
    }
}

str local_user() {
    match (os.env("USER")) {
        case Some(str name): {
            if (name != "") {
                return name;
            }
        }
        case None: {
        }
    }
    match (os.env("LOGNAME")) {
        case Some(str name): {
            return name;
        }
        case None: {
            return "";
        }
    }
}

str read_text(str path) {
    if (!fs.is_file(path)) {
        return "";
    }
    match (io.read(path)) {
        case Ok(str text): {
            return text;
        }
        case Err(_): {
            return "";
        }
    }
}

// --- host key policy ------------------------------------------------------------

/// The decision about a server's host key, as the transport asks for it. It
/// never writes `known_hosts` for a key that changed, and writes for an
/// unknown one only after a yes (or under accept-new / no).
type HostCheck {
    str host;
    int port;
    str path;
    /// yes | ask | accept-new | no
    str policy;
    bool is_interactive;
    bool is_quiet;
    sshhosts.KnownHosts hosts;
    /// Why the key was refused ("" while it has not been).
    str failure = "";
}

bool HostCheck.is_confirmed(ssh.HostKey key) {
    int attempts = 0;
    while (attempts < 5) {
        io.eprint("The authenticity of host '" + display_name(host, port) + "' can't be established.");
        io.eprint("ED25519 key fingerprint is " + key.fingerprint() + ".");
        Result<int, io.Error> prompted = io.stderr().write("Are you sure you want to continue connecting (yes/no)? ".to_bytes());
        match (io.stdin().read_until("\n".to_bytes(), 256)) {
            case Ok(bytes line): {
                match (line.utf8()) {
                    case Some(str text): {
                        str answer = text.trim().to_lower();
                        if (answer == "yes") {
                            return true;
                        }
                        if (answer == "no") {
                            return false;
                        }
                    }
                    case None: {
                    }
                }
                if (line.size() == 0) {
                    return false;
                }
            }
            case Err(_): {
                return false;
            }
        }
        io.eprint("Please type 'yes' or 'no'.");
        attempts = attempts + 1;
    }
    return false;
}

pub bool HostCheck.is_acceptable(ssh.HostKey key) {
    if (hosts.is_revoked(host, port, key)) {
        failure = "the host key " + key.fingerprint() + " for " + display_name(host, port) + " is marked revoked in " + path;
        return false;
    }
    match (hosts.keys_for(host, port)) {
        case Ok(List<bytes> trusted): {
            for (bytes known in trusted) {
                if (known == key.key) {
                    return true;
                }
            }
            failure = "REMOTE HOST IDENTIFICATION HAS CHANGED for " + display_name(host, port) + ": the server presented ED25519 key " + key.fingerprint() + ", which is not the one in " + path + ". Refusing to connect (nothing was modified; if the change is expected, remove the old entry yourself)";
            return false;
        }
        case Err(sshhosts.Error error): {
            match (error) {
                case UnknownHost: {
                }
                case Revoked: {
                    failure = "every key listed for " + display_name(host, port) + " in " + path + " is revoked";
                    return false;
                }
                case Io: {
                    failure = "cannot read " + path;
                    return false;
                }
                case MalformedLine: {
                    failure = path + " has a malformed line; refusing to guess";
                    return false;
                }
                case BadKey: {
                    failure = path + " has a malformed ssh-ed25519 key; refusing to guess";
                    return false;
                }
                case Write: {
                    failure = "cannot write " + path;
                    return false;
                }
            }
        }
    }
    // Unknown host.
    if (policy == "yes") {
        failure = "host key verification failed: " + display_name(host, port) + " is not in " + path + " and StrictHostKeyChecking is yes (key " + key.fingerprint() + ")";
        return false;
    }
    if (policy == "ask") {
        if (!is_interactive) {
            failure = "host key verification failed: " + display_name(host, port) + " is not in " + path + " and there is no terminal to ask on (key " + key.fingerprint() + "); use StrictHostKeyChecking=accept-new to trust it on first use";
            return false;
        }
        if (!is_confirmed(key)) {
            failure = "host key verification failed: not accepted by the user";
            return false;
        }
    }
    match (sshhosts.add(path, host, port, key, false)) {
        case Ok(_): {
            if (!is_quiet) {
                warn("Warning: permanently added '" + display_name(host, port) + "' (ED25519) to the list of known hosts.");
            }
        }
        case Err(sshhosts.Error error): {
            warn("Warning: could not record the host key in " + path + ": " + error.to_str());
        }
    }
    return true;
}

str display_name(str host, int port) {
    if (port == 22) {
        return host;
    }
    return "[" + host + "]:" + port.to_str();
}

// --- identities -------------------------------------------------------------------

type Candidate {
    bytes blob;
    /// "" for a key file loaded here; else the agent socket to sign through.
    str agent_path;
    List<sshkey.PrivateKey> key;
    str label;
}

bool has_blob(List<Candidate> list, bytes blob) {
    for (Candidate entry in list) {
        if (entry.blob == blob) {
            return true;
        }
    }
    return false;
}

List<Candidate> gather(sshconfig.Settings settings, str home, bool is_quiet) {
    List<Candidate> out = [];
    List<str> files = settings.identity_files;
    bool is_default = false;
    if (files.size() == 0) {
        is_default = true;
        if (home != "") {
            files.push(home + "/.ssh/id_ed25519");
        }
    }
    List<Candidate> from_files = [];
    for (str file in files) {
        if (!fs.is_present(file)) {
            if (!is_default && !is_quiet) {
                warn("Warning: identity file " + file + " not accessible: No such file or directory.");
            }
            continue;
        }
        match (fs.stat(file)) {
            case Ok(fs.Stat info): {
                if (info.perm() & 0o077 != 0) {
                    warn("Warning: private key " + file + " is accessible by others (mode " + info.perm().to_str() + " decimal); ignoring it. Run: chmod 600 " + file);
                    continue;
                }
            }
            case Err(_): {
            }
        }
        match (sshkey.load(file)) {
            case Ok(sshkey.PrivateKey key): {
                from_files.push(Candidate(key.public_blob(), "", [key], file));
            }
            case Err(sshkey.Error error): {
                warn("Warning: " + file + ": " + error.to_str());
            }
        }
    }
    bool is_agent_allowed = !settings.is_identities_only;
    match (os.env("SSH_AUTH_SOCK")) {
        case Some(str socket): {
            if (socket != "" && socket != "none") {
                match (sshagent.connect(socket)) {
                    case Ok(sshagent.Agent agent): {
                        match (agent.identities()) {
                            case Ok(List<sshagent.Identity> keys): {
                                for (sshagent.Identity identity in keys) {
                                    bool is_listed = has_blob(from_files, identity.blob);
                                    if (is_agent_allowed || is_listed) {
                                        out.push(Candidate(identity.blob, socket, [], "agent: " + identity.comment));
                                    }
                                }
                            }
                            case Err(sshagent.Error error): {
                                warn("Warning: ssh-agent: " + error.to_str());
                            }
                        }
                    }
                    case Err(sshagent.Error error): {
                        warn("Warning: ssh-agent: " + error.to_str());
                    }
                }
            }
        }
        case None: {
        }
    }
    for (Candidate entry in from_files) {
        if (!has_blob(out, entry.blob)) {
            out.push(entry);
        }
    }
    return out;
}

// --- exit codes -------------------------------------------------------------------

int signal_number(str name) {
    if (name == "HUP") {
        return 1;
    }
    if (name == "INT") {
        return 2;
    }
    if (name == "QUIT") {
        return 3;
    }
    if (name == "ABRT") {
        return 6;
    }
    if (name == "KILL") {
        return 9;
    }
    if (name == "USR1") {
        return 10;
    }
    if (name == "SEGV") {
        return 11;
    }
    if (name == "USR2") {
        return 12;
    }
    if (name == "PIPE") {
        return 13;
    }
    if (name == "ALRM") {
        return 14;
    }
    if (name == "TERM") {
        return 15;
    }
    return 0;
}

// --- main -------------------------------------------------------------------------

str tty_notice(int mode, bool is_stdin_tty) {
    if (mode == 1 && !is_stdin_tty) {
        return "Pseudo-terminal will not be allocated because stdin is not a terminal.";
    }
    return "";
}

pub int start(List<str> argv) {
    List<str> arguments = [];
    if (argv.size() > 1) {
        arguments = argv.slice(1, argv.size());
    }
    SSHC_cli.Cli cli = SSHC_cli.Cli(0, "", [], [], "", "", "", 0, false, false, false, 126, "", [], [], false, false);
    match (SSHC_cli.parse(arguments)) {
        case Ok(SSHC_cli.Cli parsed): {
            cli = parsed;
        }
        case Err(str message): {
            io.eprint("m31ssh: " + message);
            io.eprint("try 'm31ssh --help'");
            return EXIT_ERROR;
        }
    }
    if (cli.is_help) {
        print(SSHC_cli.usage());
        return 0;
    }
    if (cli.is_version) {
        print("m31ssh " + SSHC_cli.VERSION + " (UNAUDITED)");
        return 0;
    }
    str home = home_directory();
    str login = local_user();
    // Configuration: command line first (first value wins), then the file.
    str config_text = "";
    if (cli.port > 0) {
        config_text = config_text + "Port " + cli.port.to_str() + "\n";
    }
    if (cli.user != "") {
        config_text = config_text + "User " + cli.user + "\n";
    }
    for (str option in cli.options) {
        str lower = option.to_lower();
        if (lower.starts_with("host ") || lower.starts_with("match ") || lower.starts_with("include ")) {
            warn("-o " + option + " is not supported");
            return EXIT_ERROR;
        }
        config_text = config_text + option + "\n";
    }
    for (str identity in cli.identities) {
        config_text = config_text + "IdentityFile \"" + identity + "\"\n";
    }
    if (cli.config_file != "") {
        if (!fs.is_file(cli.config_file)) {
            warn("cannot read configuration file " + cli.config_file);
            return EXIT_ERROR;
        }
        config_text = config_text + read_text(cli.config_file) + "\n";
    } else if (home != "") {
        config_text = config_text + read_text(home + "/.ssh/config") + "\n";
    }
    sshconfig.Settings settings = sshconfig.resolve(config_text, cli.host, login, home);
    if (settings.errors.size() > 0) {
        warn("configuration error: " + settings.errors[0]);
        return EXIT_ERROR;
    }
    if (cli.jump != "" || settings.proxy_jump != "") {
        warn("ProxyJump / -J is not supported yet");
        return EXIT_ERROR;
    }
    if (cli.local_forwards.size() > 0 || cli.remote_forwards.size() > 0 || cli.is_no_command) {
        warn("port forwarding (-L, -R, -N) is not supported yet");
        return EXIT_ERROR;
    }
    str user = settings.user;
    if (user == "") {
        user = login;
    }
    if (user == "") {
        warn("cannot determine the login name; use -l or user@host");
        return EXIT_ERROR;
    }
    int port = settings.port;
    if (port == 0) {
        port = 22;
    }
    str host_name = settings.host_name;
    str known_hosts_path = settings.known_hosts_file;
    if (known_hosts_path == "") {
        if (home == "") {
            warn("HOME is not set and no UserKnownHostsFile is configured");
            return EXIT_ERROR;
        }
        known_hosts_path = home + "/.ssh/known_hosts";
    }
    str policy = settings.strict_host_key_checking;
    if (policy == "") {
        policy = "ask";
    }
    if (policy == "off") {
        policy = "no";
    }
    bool is_stdin_tty = term.is_terminal(0);
    bool is_interactive = is_stdin_tty;
    str known_text = "";
    if (fs.is_present(known_hosts_path)) {
        match (io.read(known_hosts_path)) {
            case Ok(str text): {
                known_text = text;
            }
            case Err(io.Error error): {
                warn("cannot read " + known_hosts_path + ": " + error.to_str());
                return EXIT_ERROR;
            }
        }
    }
    List<sshhosts.KnownHosts> loaded_hosts = [];
    match (sshhosts.parse(known_text)) {
        case Ok(sshhosts.KnownHosts loaded): {
            loaded_hosts.push(loaded);
        }
        case Err(sshhosts.Error error): {
            warn(known_hosts_path + ": " + error.to_str() + "; refusing to continue");
            return EXIT_ERROR;
        }
    }
    HostCheck check = HostCheck(host_name, port, known_hosts_path, policy, is_interactive, cli.is_quiet, loaded_hosts[0]);
    // Keys are read before the connection so a bad -i fails fast.
    List<Candidate> candidates = gather(settings, home, cli.is_quiet);
    if (candidates.size() == 0) {
        warn("no usable identity: no key file and no agent key (tried IdentityFile and ~/.ssh/id_ed25519)");
        return EXIT_ERROR;
    }
    int handshake_ms = HANDSHAKE_TIMEOUT_MS;
    if (settings.connect_timeout > 0) {
        handshake_ms = settings.connect_timeout * 1000;
    }
    match (net.connect(host_name, port)) {
        case Ok(net.Conn connection): {
            match (ssh.connect_over(connection, check, timeout_ms: handshake_ms)) {
                case Ok(ssh.Transport transport): {
                    return run_session(transport, settings, cli, candidates, user, host_name, is_stdin_tty);
                }
                case Err(ssh.Error error): {
                    if (check.failure != "") {
                        warn(check.failure);
                    } else {
                        warn("connection to " + display_name(host_name, port) + " failed: " + error.to_str());
                    }
                    return EXIT_ERROR;
                }
            }
        }
        case Err(net.Error error): {
            warn("could not connect to " + display_name(host_name, port) + ": " + error.to_str());
            return EXIT_ERROR;
        }
    }
}

// Authenticates (trying each candidate), opens the channel and runs it.
int run_session(ssh.Transport transport, sshconfig.Settings settings, SSHC_cli.Cli cli, List<Candidate> candidates, str user, str host_name, bool is_stdin_tty) {
    match (sshauth.start(transport)) {
        case Ok: {
        }
        case Err(sshauth.Error error): {
            warn("authentication could not start: " + error.to_str());
            return EXIT_ERROR;
        }
    }
    bool is_authenticated = false;
    str banner = "";
    for (Candidate candidate in candidates) {
        sshauth.Signer signer = sshagent.AgentSigner(candidate.agent_path, candidate.blob);
        if (candidate.agent_path == "") {
            signer = sshauth.KeySigner(candidate.key[0]);
        }
        match (sshauth.try_key(transport, user, candidate.blob, signer)) {
            case Ok(str text): {
                banner = text;
                is_authenticated = true;
            }
            case Err(sshauth.Error error): {
                match (error) {
                    case KeyRejected: {
                    }
                    case AuthFailed: {
                    }
                    case SignerFailed: {
                        warn("signing with " + candidate.label + " failed");
                    }
                    case Transport(ssh.Error inner): {
                        warn("connection lost during authentication: " + inner.to_str());
                        return EXIT_ERROR;
                    }
                    case Truncated: {
                        warn("authentication failed: the server sent a malformed message");
                        return EXIT_ERROR;
                    }
                    case UnexpectedMessage: {
                        warn("authentication failed: the server sent an unexpected message");
                        return EXIT_ERROR;
                    }
                    case BadMessage: {
                        warn("authentication failed: the server sent a malformed message");
                        return EXIT_ERROR;
                    }
                }
            }
        }
        if (is_authenticated) {
            break;
        }
    }
    if (!is_authenticated) {
        warn(user + "@" + host_name + ": Permission denied (publickey).");
        Result<bool, ssh.Error> closed = transport.disconnect();
        return EXIT_ERROR;
    }
    if (banner != "" && !cli.is_quiet) {
        Result<int, io.Error> shown = io.stderr().write((sanitize(banner) + "\n").to_bytes());
    }
    match (transport.set_read_timeout(STALL_TIMEOUT_MS)) {
        case Ok: {
        }
        case Err(_): {
        }
    }
    // A terminal?
    int mode = cli.tty_mode;
    if (mode == 0) {
        if (settings.request_tty == "yes") {
            mode = 1;
        } else if (settings.request_tty == "force") {
            mode = 2;
        } else if (settings.request_tty == "no") {
            mode = -1;
        }
    }
    bool is_pty = false;
    if (mode == 2) {
        is_pty = true;
    } else if (mode == 1) {
        is_pty = is_stdin_tty;
        if (!is_stdin_tty && !cli.is_quiet) {
            warn(tty_notice(1, false));
        }
    } else if (mode == 0) {
        is_pty = is_stdin_tty && cli.command == "";
    }
    int columns = 80;
    int rows = 24;
    int size_fd = 1;
    if (is_stdin_tty) {
        size_fd = 0;
    }
    match (term.size(descriptor: size_fd)) {
        case Ok(term.Size size): {
            if (size.columns > 0 && size.rows > 0) {
                columns = size.columns;
                rows = size.rows;
            }
        }
        case Err(_): {
        }
    }
    str term_name = "xterm";
    match (os.env("TERM")) {
        case Some(str name): {
            if (name != "" && name.size() < 64) {
                term_name = name;
            }
        }
        case None: {
        }
    }
    Result<sshexec.Channel, sshexec.Error> opened = Result<sshexec.Channel, sshexec.Error>.Err(sshexec.Error.Closed);
    if (is_pty) {
        opened = sshexec.open_pty(transport, term_name, columns, rows, sshshell.default_modes(), cli.command);
    } else if (cli.command == "") {
        opened = sshexec.shell(transport);
    } else {
        opened = sshexec.exec(transport, cli.command);
    }
    match (opened) {
        case Ok(sshexec.Channel channel): {
            sshshell.Options options = sshshell.Options(0, 1, is_pty && is_stdin_tty, is_pty, cli.is_stdin_null, -1, 0, 3);
            if (is_pty && is_stdin_tty) {
                options.escape = cli.escape;
            }
            if (settings.server_alive_interval > 0) {
                options.alive_interval = settings.server_alive_interval;
            }
            if (settings.server_alive_count_max >= 0) {
                options.alive_count_max = settings.server_alive_count_max;
            }
            Result<sshshell.Ending, str> result = sshshell.run(transport, channel, options);
            Result<bool, ssh.Error> closed = transport.disconnect();
            match (result) {
                case Ok(sshshell.Ending ending): {
                    match (ending) {
                        case Exited(int code): {
                            return code;
                        }
                        case Signalled(str name): {
                            if (!cli.is_quiet) {
                                warn("Killed by signal " + name + ".");
                            }
                            int number = signal_number(name);
                            if (number == 0) {
                                return EXIT_ERROR;
                            }
                            return 128 + number;
                        }
                        case NoStatus: {
                            if (!cli.is_quiet) {
                                warn("Connection to " + host_name + " closed by remote host.");
                            }
                            return EXIT_ERROR;
                        }
                        case Escaped: {
                            if (!cli.is_quiet) {
                                io.eprint("Connection to " + host_name + " closed.");
                            }
                            return EXIT_ERROR;
                        }
                        case ServerSilent: {
                            warn("Timeout, server " + host_name + " not responding.");
                            return EXIT_ERROR;
                        }
                        case OutputClosed: {
                            return EXIT_ERROR;
                        }
                    }
                }
                case Err(str message): {
                    warn("connection to " + host_name + " lost: " + message);
                    return EXIT_ERROR;
                }
            }
        }
        case Err(sshexec.Error error): {
            warn("could not start the session: " + error.to_str());
            return EXIT_ERROR;
        }
    }
}
