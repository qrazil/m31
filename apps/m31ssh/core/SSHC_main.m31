// m31ssh: connect, check the host key, authenticate, run a command or a
// shell, forward ports. UNAUDITED -- docs/m31ssh.md says what that means.
// The connection (configuration, host keys, identities, jump hosts) is
// `lib/ssh/sshconnect.m31`; this file is the session.

import io;
import os;
import term;
import ssh;
import ssh.sshexec;
import ssh.sshconfig;
import ssh.sshshell;
import ssh.sshconnect;
import ssh.sshforward;
import core.SSHC_cli;

const int EXIT_ERROR = 255;
const int STALL_TIMEOUT_MS = 60000;

void warn(str message) {
    io.eprint("m31ssh: " + message);
}

// --- exit codes -------------------------------------------------------------------

int signal_number(str name) {
    if (name == "HUP") {
        return 1;
    }
    if (name == "INT") {
        return 2;
    }
    if (name == "QUIT") {
        return 3;
    }
    if (name == "ABRT") {
        return 6;
    }
    if (name == "KILL") {
        return 9;
    }
    if (name == "USR1") {
        return 10;
    }
    if (name == "SEGV") {
        return 11;
    }
    if (name == "USR2") {
        return 12;
    }
    if (name == "PIPE") {
        return 13;
    }
    if (name == "ALRM") {
        return 14;
    }
    if (name == "TERM") {
        return 15;
    }
    return 0;
}

str tty_notice(int mode, bool is_stdin_tty) {
    if (mode == 1 && !is_stdin_tty) {
        return "Pseudo-terminal will not be allocated because stdin is not a terminal.";
    }
    return "";
}

pub int start(List<str> argv) {
    List<str> arguments = [];
    if (argv.size() > 1) {
        arguments = argv.slice(1, argv.size());
    }
    SSHC_cli.Cli cli = SSHC_cli.Cli(0, "", [], [], "", "", "", 0, false, false, false, 126, "", [], [], false, false);
    match (SSHC_cli.parse(arguments)) {
        case Ok(SSHC_cli.Cli parsed): {
            cli = parsed;
        }
        case Err(str message): {
            io.eprint("m31ssh: " + message);
            io.eprint("try 'm31ssh --help'");
            return EXIT_ERROR;
        }
    }
    if (cli.is_help) {
        print(SSHC_cli.usage());
        return 0;
    }
    if (cli.is_version) {
        print("m31ssh " + SSHC_cli.VERSION + " (UNAUDITED)");
        return 0;
    }
    bool is_stdin_tty = term.is_terminal(0);
    sshconnect.Params parameters = sshconnect.Params(cli.host, cli.port, cli.user, cli.identities, cli.options, cli.config_file, cli.jump, cli.is_quiet, is_stdin_tty);
    match (sshconnect.connect(parameters)) {
        case Err(str reason): {
            warn(reason);
            return EXIT_ERROR;
        }
        case Ok(sshconnect.Connection connection): {
            return run_session(connection.transport, connection.settings, cli, connection.host_name, is_stdin_tty);
        }
    }
}

// Opens the channel on an authenticated transport and runs it.
int run_session(ssh.Transport transport, sshconfig.Settings settings, SSHC_cli.Cli cli, str host_name, bool is_stdin_tty) {
    match (transport.set_read_timeout(STALL_TIMEOUT_MS)) {
        case Ok: {
        }
        case Err(_): {
        }
    }
    // A terminal?
    int mode = cli.tty_mode;
    if (mode == 0) {
        if (settings.request_tty == "yes") {
            mode = 1;
        } else if (settings.request_tty == "force") {
            mode = 2;
        } else if (settings.request_tty == "no") {
            mode = -1;
        }
    }
    bool is_pty = false;
    if (mode == 2) {
        is_pty = true;
    } else if (mode == 1) {
        is_pty = is_stdin_tty;
        if (!is_stdin_tty && !cli.is_quiet) {
            warn(tty_notice(1, false));
        }
    } else if (mode == 0) {
        is_pty = is_stdin_tty && cli.command == "";
    }
    int columns = 80;
    int rows = 24;
    int size_fd = 1;
    if (is_stdin_tty) {
        size_fd = 0;
    }
    match (term.size(descriptor: size_fd)) {
        case Ok(term.Size size): {
            if (size.columns > 0 && size.rows > 0) {
                columns = size.columns;
                rows = size.rows;
            }
        }
        case Err(_): {
        }
    }
    str term_name = "xterm";
    match (os.env("TERM")) {
        case Some(str name): {
            if (name != "" && name.size() < 64) {
                term_name = name;
            }
        }
        case None: {
        }
    }
    // Forwards: command line first, then the configuration's.
    sshforward.Mux mux = sshforward.new_mux(transport, cli.is_quiet);
    int working = 0;
    List<str> local_specs = clone(cli.local_forwards);
    for (str text in settings.local_forwards) {
        local_specs.push(forward_text(text));
    }
    List<str> remote_specs = clone(cli.remote_forwards);
    for (str text in settings.remote_forwards) {
        remote_specs.push(forward_text(text));
    }
    for (str spec in local_specs) {
        match (sshforward.parse_rule(spec, false)) {
            case Err(str reason): {
                warn(reason);
                return EXIT_ERROR;
            }
            case Ok(sshforward.Rule rule): {
                match (mux.listen_local(rule)) {
                    case Ok: {
                        working = working + 1;
                    }
                    case Err(str reason): {
                        warn("Warning: " + reason);
                    }
                }
            }
        }
    }
    if (cli.is_no_command && working == 0) {
        warn("-N given but no forwarding could be set up");
        return EXIT_ERROR;
    }
    List<sshexec.Channel> session = [];
    if (!cli.is_no_command) {
        Result<sshexec.Channel, sshexec.Error> opened = Result<sshexec.Channel, sshexec.Error>.Err(sshexec.Error.Closed);
        if (is_pty) {
            opened = sshexec.open_pty(transport, term_name, columns, rows, sshshell.default_modes(), cli.command);
        } else if (cli.command == "") {
            opened = sshexec.shell(transport);
        } else {
            opened = sshexec.exec(transport, cli.command);
        }
        match (opened) {
            case Ok(sshexec.Channel channel): {
                session.push(channel);
            }
            case Err(sshexec.Error error): {
                warn("could not start the session: " + error.to_str());
                return EXIT_ERROR;
            }
        }
    }
    // Remote forwards are requested once the session channel is open: the
    // server's answers are then routed by the forwarding layer in the loop,
    // not mistaken for replies to the channel requests above.
    for (str spec in remote_specs) {
        match (sshforward.parse_rule(spec, true)) {
            case Err(str reason): {
                warn(reason);
                return EXIT_ERROR;
            }
            case Ok(sshforward.Rule rule): {
                match (mux.request_remote(rule)) {
                    case Ok: {
                        working = working + 1;
                    }
                    case Err(str reason): {
                        warn("Warning: " + reason);
                    }
                }
            }
        }
    }
    sshshell.Options options = sshshell.Options(0, 1, is_pty && is_stdin_tty && session.size() > 0, is_pty && session.size() > 0, cli.is_stdin_null, -1, 0, 3);
    if (is_pty && is_stdin_tty) {
        options.escape = cli.escape;
    }
    if (settings.server_alive_interval > 0) {
        options.alive_interval = settings.server_alive_interval;
    }
    if (settings.server_alive_count_max >= 0) {
        options.alive_count_max = settings.server_alive_count_max;
    }
    Result<sshshell.Ending, str> result = sshshell.run(transport, session, options, mux);
    Result<bool, ssh.Error> closed = transport.disconnect();
    match (result) {
        case Ok(sshshell.Ending ending): {
            match (ending) {
                case Exited(int code): {
                    return code;
                }
                case Signalled(str name): {
                    if (!cli.is_quiet) {
                        warn("Killed by signal " + name + ".");
                    }
                    int number = signal_number(name);
                    if (number == 0) {
                        return EXIT_ERROR;
                    }
                    return 128 + number;
                }
                case NoStatus: {
                    if (!cli.is_quiet) {
                        warn("Connection to " + host_name + " closed by remote host.");
                    }
                    return EXIT_ERROR;
                }
                case Escaped: {
                    if (!cli.is_quiet) {
                        io.eprint("Connection to " + host_name + " closed.");
                    }
                    return EXIT_ERROR;
                }
                case ServerSilent: {
                    warn("Timeout, server " + host_name + " not responding.");
                    return EXIT_ERROR;
                }
                case OutputClosed: {
                    return EXIT_ERROR;
                }
            }
        }
        case Err(str message): {
            warn("connection to " + host_name + " lost: " + message);
            return EXIT_ERROR;
        }
    }
}

// A configuration `LocalForward`/`RemoteForward` value is `[bind:]port
// host:hostport` with a space after the first part; the command line's is
// all colons.
str forward_text(str value) {
    int index = 0;
    while (index < value.size()) {
        if (value.byte_at(index) == 32) {
            return value.substr(0, index) + ":" + value.substr(index + 1, value.size()).trim();
        }
        index = index + 1;
    }
    return value;
}
