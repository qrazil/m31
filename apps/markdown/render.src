// The renderer: a `doc.Block` tree to HTML.
//
// The line breaks follow cmark's, and they are produced the way cmark
// produces them: every block asks for a newline with `cr()`, which writes one
// only if the output does not already end in one. Getting that rule right is
// most of what makes the output comparable with a reference implementation --
// the tags are easy and the whitespace is not.
import doc;
import html;
import inlines;
import text;

// An output buffer that knows whether it is at the start of a line. Text is
// pushed onto a list and joined once, because building a megabyte of HTML
// with `+` is quadratic.
type Out {
    List<str> parts;
    bool bol;
}

void Out.put(str s) {
    if (s.size() == 0) {
        return;
    }
    parts.push(s);
    bol = s.ends_with("\n");
}

void Out.cr() {
    if (!bol) {
        parts.push("\n");
        bol = true;
    }
}

str Out.text() {
    return parts.join("");
}

Out new_out() {
    return Out([], true);
}

/// `bs` as HTML: one line per block, cmark's layout.
pub str document(List<doc.Block> bs) {
    Out o = new_out();
    blocks(o, bs, false);
    return o.text();
}

void blocks(Out o, List<doc.Block> bs, bool tight) {
    for (doc.Block b in bs) {
        block(o, b, tight);
    }
}

void block(Out o, doc.Block b, bool tight) {
    match (b) {
        case Rule: {
            o.cr();
            o.put("<hr />");
            o.cr();
        }
        case Para(str raw): {
            // Inside a tight list a paragraph has no tags at all. That is
            // what "tight" means, and it is why the flag has to reach this
            // far down.
            if (tight) {
                o.put(inlines.render(raw));
            } else {
                o.cr();
                o.put("<p>");
                o.put(inlines.render(raw));
                o.put("</p>");
                o.cr();
            }
        }
        case Head(doc.Heading h): {
            str tag = str(h.level);
            o.cr();
            o.put("<h" + tag + ">");
            o.put(inlines.render(h.text));
            o.put("</h" + tag + ">");
            o.cr();
        }
        case Fence(doc.Code c): {
            o.cr();
            o.put("<pre><code");
            str lang = first_word(c.info);
            if (lang.size() > 0) {
                o.put(" class=\"language-" + html.escape(lang) + "\"");
            }
            o.put(">");
            o.put(html.escape(c.body));
            o.put("</code></pre>");
            o.cr();
        }
        case Quoted(doc.Quote q): {
            o.cr();
            o.put("<blockquote>");
            o.cr();
            blocks(o, q.kids, false);
            o.cr();
            o.put("</blockquote>");
            o.cr();
        }
        case Bullets(doc.Listing l): {
            o.cr();
            if (l.ordered) {
                if (l.start == 1) {
                    o.put("<ol>");
                } else {
                    o.put("<ol start=\"" + str(l.start) + "\">");
                }
            } else {
                o.put("<ul>");
            }
            o.cr();
            for (doc.Item it in l.items) {
                o.cr();
                o.put("<li>");
                blocks(o, it.kids, l.tight);
                o.put("</li>");
                o.cr();
            }
            o.cr();
            if (l.ordered) {
                o.put("</ol>");
            } else {
                o.put("</ul>");
            }
            o.cr();
        }
        case Grid(doc.Table t): {
            table(o, t);
        }
    }
}

void table(Out o, doc.Table t) {
    o.cr();
    o.put("<table>");
    o.cr();
    o.put("<thead>");
    o.cr();
    o.put("<tr>");
    o.cr();
    for (int i in 0 .. t.heads.size()) {
        o.put("<th" + align_attr(t.align, i) + ">");
        o.put(inlines.render(t.heads[i]));
        o.put("</th>");
        o.cr();
    }
    o.put("</tr>");
    o.cr();
    o.put("</thead>");
    o.cr();
    if (t.rows.size() > 0) {
        o.put("<tbody>");
        o.cr();
        for (List<str> row in t.rows) {
            o.put("<tr>");
            o.cr();
            for (int k in 0 .. row.size()) {
                o.put("<td" + align_attr(t.align, k) + ">");
                o.put(inlines.render(row[k]));
                o.put("</td>");
                o.cr();
            }
            o.put("</tr>");
            o.cr();
        }
        o.put("</tbody>");
        o.cr();
    }
    o.put("</table>");
    o.cr();
}

str align_attr(List<int> align, int i) {
    if (i >= align.size()) {
        return "";
    }
    if (align[i] == doc.ALIGN_LEFT) {
        return " align=\"left\"";
    }
    if (align[i] == doc.ALIGN_CENTER) {
        return " align=\"center\"";
    }
    if (align[i] == doc.ALIGN_RIGHT) {
        return " align=\"right\"";
    }
    return "";
}

// The language of a fence: the first word of its info string. The rest of it
// is dropped, which is what cmark does with "``` ruby extra words".
str first_word(str info) {
    List<str> words = text.split_whitespace(info);
    if (words.size() == 0) {
        return "";
    }
    return words[0];
}
