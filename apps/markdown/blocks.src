// The block parser: markdown source to a list of `doc.Block`.
//
// Line based and recursive. The document is split into lines once; every
// container -- a block quote, a list item -- strips its own marker off the
// lines it owns and hands the remainder back to `parse_lines`, so nesting
// costs a recursive call and nothing else.
//
// Inline content is NOT parsed here. A block keeps the raw source of its own
// text and `render` parses it later (see `doc`).
import doc;
import math;
import text;

/// `src` as blocks. Line endings are normalised and leading tabs expanded
/// before anything else looks at the text.
pub List<doc.Block> parse(str src) {
    return parse_lines(split_lines(src));
}

// --- lines -------------------------------------------------------------------

List<str> split_lines(str src) {
    List<str> out = [];
    for (str line in text.lines(src)) {
        out.push(expand_tabs(line));
    }
    return out;
}

// Tabs in the LEADING whitespace become spaces to the next four-column stop,
// which is the rule CommonMark indentation follows. A tab further along is
// left exactly as written: it is content, and a code block that held one
// should still hold one.
str expand_tabs(str line) {
    int n = line.size();
    int i = 0;
    int col = 0;
    bool any = false;
    while (i < n) {
        int c = line.byte_at(i);
        if (c == '\t') {
            any = true;
        } else if (c != ' ') {
            i = n;
            continue;
        }
        i = i + 1;
    }
    if (!any) {
        return line;
    }
    List<str> out = [];
    i = 0;
    while (i < n) {
        int c = line.byte_at(i);
        if (c == ' ') {
            out.push(" ");
            col = col + 1;
        } else if (c == '\t') {
            int pad = 4 - col % 4;
            out.push(" ".repeat(pad));
            col = col + pad;
        } else {
            out.push(line.substr(i, n));
            i = n;
            continue;
        }
        i = i + 1;
    }
    return out.join("");
}

int indent_of(str line) {
    int n = line.size();
    int i = 0;
    while (i < n && line.byte_at(i) == ' ') {
        i = i + 1;
    }
    return i;
}

// `line` without its first `k` characters, or "" if it is shorter.
str chop(str line, int k) {
    int n = line.size();
    if (k >= n) {
        return "";
    }
    return line.substr(k, n);
}

bool blank(str line) {
    return line.trim().size() == 0;
}

// --- line shapes -------------------------------------------------------------

// `***`, `---`, `___`: three or more of one character, spaces allowed
// between them, nothing else on the line. `r` has had its indent removed.
bool thematic(str r) {
    int n = r.size();
    if (n < 3) {
        return false;
    }
    int c = r.byte_at(0);
    if (c != '*' && c != '-' && c != '_') {
        return false;
    }
    int count = 0;
    int i = 0;
    while (i < n) {
        int b = r.byte_at(i);
        if (b == c) {
            count = count + 1;
        } else if (b != ' ' && b != '\t') {
            return false;
        }
        i = i + 1;
    }
    return count >= 3;
}

// The `#` count of an ATX heading, or 0.
int atx_level(str r) {
    int n = r.size();
    int i = 0;
    while (i < n && i < 7 && r.byte_at(i) == '#') {
        i = i + 1;
    }
    if (i == 0 || i > 6) {
        return 0;
    }
    if (i < n && r.byte_at(i) != ' ' && r.byte_at(i) != '\t') {
        return 0;
    }
    return i;
}

// The text of an ATX heading whose marker is `level` characters long: the
// rest of the line, with a closing run of `#` taken off.
str atx_text(str r, int level) {
    str body = chop(r, level).trim();
    int n = body.size();
    int i = n;
    while (i > 0 && body.byte_at(i - 1) == '#') {
        i = i - 1;
    }
    if (i == 0) {
        return "";
    }
    if (i < n && (body.byte_at(i - 1) == ' ' || body.byte_at(i - 1) == '\t')) {
        return body.substr(0, i).trim();
    }
    return body;
}

// The fence character of an opening code fence, or 0.
int fence_char(str r) {
    int n = r.size();
    if (n < 3) {
        return 0;
    }
    int c = r.byte_at(0);
    if (c != '`' && c != '~') {
        return 0;
    }
    int i = 0;
    while (i < n && r.byte_at(i) == c) {
        i = i + 1;
    }
    if (i < 3) {
        return 0;
    }
    // A backtick fence's info string may not hold a backtick, or ``a`` at the
    // start of a line would open a block instead of a code span.
    if (c == '`' && chop(r, i).contains("`")) {
        return 0;
    }
    return c;
}

int run_length(str r, int c) {
    int n = r.size();
    int i = 0;
    while (i < n && r.byte_at(i) == c) {
        i = i + 1;
    }
    return i;
}

// The level of a setext underline, or 0.
int setext_level(str r) {
    int n = r.size();
    if (n == 0) {
        return 0;
    }
    int c = r.byte_at(0);
    if (c != '=' && c != '-') {
        return 0;
    }
    int i = 0;
    while (i < n && r.byte_at(i) == c) {
        i = i + 1;
    }
    while (i < n && (r.byte_at(i) == ' ' || r.byte_at(i) == '\t')) {
        i = i + 1;
    }
    if (i < n) {
        return 0;
    }
    if (c == '=') {
        return 1;
    }
    return 2;
}

// A list marker at the start of `r`. `len` counts the marker's own
// characters -- 1 for `-`, 3 for `10.` -- and `ch` is `-`, `+`, `*`, `.` or
// `)`, which is what decides whether two items belong to one list.
type Marker {
    bool ok;
    bool ordered;
    int num;
    int ch;
    int len;
}

Marker marker_of(str r) {
    int n = r.size();
    if (n == 0) {
        return Marker(false, false, 0, 0, 0);
    }
    int c = r.byte_at(0);
    if (c == '-' || c == '+' || c == '*') {
        if (n > 1 && r.byte_at(1) != ' ' && r.byte_at(1) != '\t') {
            return Marker(false, false, 0, 0, 0);
        }
        return Marker(true, false, 0, c, 1);
    }
    int i = 0;
    while (i < n && i < 9 && r.byte_at(i) >= '0' && r.byte_at(i) <= '9') {
        i = i + 1;
    }
    if (i == 0 || i >= n) {
        return Marker(false, false, 0, 0, 0);
    }
    int d = r.byte_at(i);
    if (d != '.' && d != ')') {
        return Marker(false, false, 0, 0, 0);
    }
    if (i + 1 < n && r.byte_at(i + 1) != ' ' && r.byte_at(i + 1) != '\t') {
        return Marker(false, false, 0, 0, 0);
    }
    return Marker(true, true, r.substr(0, i).parse_int().or(0), d, i + 1);
}

// Does `r` begin a block that a paragraph cannot swallow?
bool starts_block(str r) {
    return thematic(r) || atx_level(r) > 0 || fence_char(r) != 0 || r.starts_with(">");
}

// A list item may interrupt a paragraph only when it is not empty, and an
// ordered one only when it is numbered 1 -- otherwise every line beginning
// "2024. " would start a list.
bool interrupts(str r) {
    Marker m = marker_of(r);
    if (!m.ok) {
        return false;
    }
    if (chop(r, m.len).trim().size() == 0) {
        return false;
    }
    return !m.ordered || m.num == 1;
}

// Add `line` to `held` as a LAZY continuation of the paragraph already
// there, by gluing it onto the previous line rather than pushing it.
//
// It has to be glued. A container strips its markers and hands the remaining
// lines back to `parse_lines`, which is what makes nesting one recursive
// call -- but that loses the fact that a line arrived lazily, and a lazy
// line is paragraph text and nothing else. Handed over on its own, `===`
// under `> quote` would become a setext underline and `- x` would become a
// list. Inside the previous line it cannot be either, and the paragraph
// joins its lines with a newline anyway, so the text comes out the same.
void lazily(List<str> held, str line) {
    int last = held.size() - 1;
    held[last] = held[last] + "\n" + text.trim_start(line);
}

// --- the parser --------------------------------------------------------------

List<doc.Block> parse_lines(List<str> lines) {
    List<doc.Block> out = [];
    int n = lines.size();
    int i = 0;
    while (i < n) {
        str line = lines[i];
        if (blank(line)) {
            i = i + 1;
            continue;
        }
        int ind = indent_of(line);
        str r = chop(line, ind);
        if (ind >= 4) {
            i = indented_code(out, lines, i);
            continue;
        }
        if (thematic(r)) {
            out.push(doc.Block.Rule);
            i = i + 1;
            continue;
        }
        int level = atx_level(r);
        if (level > 0) {
            out.push(doc.Block.Head(doc.Heading(level, atx_text(r, level))));
            i = i + 1;
            continue;
        }
        if (fence_char(r) != 0) {
            i = fenced_code(out, lines, i);
            continue;
        }
        if (r.starts_with(">")) {
            i = block_quote(out, lines, i);
            continue;
        }
        if (marker_of(r).ok) {
            i = list_at(out, lines, i);
            continue;
        }
        if (is_table_head(lines, i)) {
            i = table_at(out, lines, i);
            continue;
        }
        i = paragraph(out, lines, i);
    }
    return out;
}

// --- leaf blocks -------------------------------------------------------------

int indented_code(List<doc.Block> out, List<str> lines, int at) {
    int n = lines.size();
    List<str> body = [];
    int i = at;
    int last = at;
    while (i < n) {
        str line = lines[i];
        if (blank(line)) {
            body.push("");
            i = i + 1;
            continue;
        }
        if (indent_of(line) < 4) {
            i = n;
            continue;
        }
        body.push(chop(line, 4));
        last = i;
        i = i + 1;
    }
    while (body.size() > 0 && body[body.size() - 1].size() == 0) {
        body.pop();
    }
    out.push(doc.Block.Fence(doc.Code("", body.join("\n") + "\n")));
    return last + 1;
}

int fenced_code(List<doc.Block> out, List<str> lines, int at) {
    int n = lines.size();
    str open = lines[at];
    int ind = indent_of(open);
    str r = chop(open, ind);
    int c = fence_char(r);
    int width = run_length(r, c);
    str info = chop(r, width).trim();
    List<str> body = [];
    int i = at + 1;
    bool closed = false;
    while (i < n && !closed) {
        str line = lines[i];
        int li = indent_of(line);
        str lr = chop(line, li);
        if (li < 4 && run_length(lr, c) >= width && chop(lr, run_length(lr, c)).trim().size() == 0) {
            closed = true;
            i = i + 1;
            continue;
        }
        body.push(chop(line, math.min(ind, indent_of(line))));
        i = i + 1;
    }
    str text_of = "";
    if (body.size() > 0) {
        text_of = body.join("\n") + "\n";
    }
    out.push(doc.Block.Fence(doc.Code(info, text_of)));
    return i;
}

int block_quote(List<doc.Block> out, List<str> lines, int at) {
    int n = lines.size();
    List<str> inner = [];
    int i = at;
    bool done = false;
    while (i < n && !done) {
        str line = lines[i];
        int li = indent_of(line);
        str r = chop(line, li);
        if (li < 4 && r.starts_with(">")) {
            str body = chop(r, 1);
            if (body.starts_with(" ")) {
                body = chop(body, 1);
            }
            inner.push(body);
            i = i + 1;
            continue;
        }
        // Lazy continuation: a bare line carries on the quote's paragraph,
        // but only if a paragraph is what it would carry on.
        if (blank(line) || inner.size() == 0 || blank(inner[inner.size() - 1])) {
            done = true;
            continue;
        }
        // Any list marker ends the quote, not only one that could interrupt
        // a paragraph: a lazy line is matched against the DOCUMENT, where
        // there is no paragraph for the "must not be empty, must be
        // numbered 1" rule to protect.
        if (li < 4 && (starts_block(r) || marker_of(r).ok)) {
            done = true;
            continue;
        }
        lazily(inner, line);
        i = i + 1;
    }
    out.push(doc.Block.Quoted(doc.Quote(parse_lines(inner))));
    return i;
}

int paragraph(List<doc.Block> out, List<str> lines, int at) {
    int n = lines.size();
    List<str> para = [];
    int i = at;
    bool done = false;
    while (i < n && !done) {
        str line = lines[i];
        if (blank(line)) {
            done = true;
            continue;
        }
        int li = indent_of(line);
        str r = chop(line, li);
        if (li < 4 && para.size() > 0 && setext_level(r) > 0) {
            out.push(doc.Block.Head(doc.Heading(setext_level(r), para.join("\n").trim())));
            return i + 1;
        }
        if (li < 4 && (starts_block(r) || interrupts(r))) {
            done = true;
            continue;
        }
        para.push(text.trim_start(line));
        i = i + 1;
    }
    if (para.size() > 0) {
        // The trailing spaces of the LAST line are not a hard break -- there
        // is no line after them -- so the paragraph loses them here, where
        // the inline parser would otherwise print them.
        out.push(doc.Block.Para(para.join("\n").trim()));
    }
    return i;
}

// --- lists -------------------------------------------------------------------

int list_at(List<doc.Block> out, List<str> lines, int at) {
    int n = lines.size();
    Marker first = marker_of(chop(lines[at], indent_of(lines[at])));
    List<doc.Item> items = [];
    bool loose = false;
    int i = at;
    bool done = false;
    while (i < n && !done) {
        str line = lines[i];
        int li = indent_of(line);
        Marker m = marker_of(chop(line, li));
        // `- - -` is a thematic break and not three items: the break wins,
        // here as in `parse_lines`.
        if (li >= 4 || thematic(chop(line, li)) || !m.ok || m.ch != first.ch) {
            done = true;
            continue;
        }
        // Where this item's content starts. One to four spaces after the
        // marker indent to that column; five or more mean the content is an
        // indented code block that begins one space in.
        int after = li + m.len;
        int sp = 0;
        while (after + sp < line.size() && line.byte_at(after + sp) == ' ') {
            sp = sp + 1;
        }
        int cind = after + 1;
        if (after + sp < line.size() && sp >= 1 && sp <= 4) {
            cind = after + sp;
        }
        List<str> body = [];
        body.push(chop(line, cind));
        i = i + 1;
        bool pending = false;
        bool ended = false;
        while (i < n && !ended) {
            str l2 = lines[i];
            if (blank(l2)) {
                pending = true;
                i = i + 1;
                continue;
            }
            int l2i = indent_of(l2);
            if (l2i >= cind) {
                if (pending) {
                    body.push("");
                    loose = true;
                    pending = false;
                }
                body.push(chop(l2, cind));
                i = i + 1;
                continue;
            }
            str r2 = chop(l2, l2i);
            // A line indented four or more cannot be indented code here,
            // because indented code may not interrupt a paragraph -- so it
            // is lazy text whatever it looks like.
            // Any marker ends the item -- `2.` after `1.` is the next item,
            // and `*` alone is an empty item of a new list. The "must not be
            // empty, must be numbered 1" rule is only for interrupting a
            // paragraph, and a lazy line is matched against the document.
            bool lazy = l2i >= 4 || !starts_block(r2) && !marker_of(r2).ok;
            if (!pending && !blank(body[body.size() - 1]) && lazy) {
                lazily(body, l2);
                i = i + 1;
                continue;
            }
            ended = true;
        }
        items.push(doc.Item(parse_lines(body)));
        // A blank line between two items makes the whole list loose -- but
        // only if another item really follows. `- - -` after a blank line
        // looks like a marker and is a thematic break, which ends the list
        // and leaves it tight.
        if (pending && i < n) {
            str next = lines[i];
            int ni = indent_of(next);
            str nr = chop(next, ni);
            Marker nm = marker_of(nr);
            if (ni < 4 && !thematic(nr) && nm.ok && nm.ch == first.ch) {
                loose = true;
            }
        }
    }
    int start = 1;
    if (first.ordered) {
        start = first.num;
    }
    out.push(doc.Block.Bullets(doc.Listing(first.ordered, start, !loose, items)));
    return i;
}

// --- tables (a GFM extension, not CommonMark) --------------------------------

bool is_table_head(List<str> lines, int at) {
    if (at + 1 >= lines.size()) {
        return false;
    }
    if (!lines[at].contains("|")) {
        return false;
    }
    List<str> head = cells_of(lines[at]);
    List<str> rule = cells_of(lines[at + 1]);
    if (head.size() == 0 || head.size() != rule.size()) {
        return false;
    }
    for (str cell in rule) {
        if (align_of(cell) < 0) {
            return false;
        }
    }
    return true;
}

// `:-`, `-:`, `:-:` or `-`, with at least one dash. -1 means this is not a
// delimiter cell at all.
int align_of(str cell) {
    str c = cell.trim();
    int n = c.size();
    if (n == 0) {
        return -1;
    }
    bool lead = c.byte_at(0) == ':';
    bool tail = c.byte_at(n - 1) == ':';
    int i = 0;
    if (lead) {
        i = 1;
    }
    int j = n;
    if (tail) {
        j = n - 1;
    }
    if (j <= i) {
        return -1;
    }
    int k = i;
    while (k < j) {
        if (c.byte_at(k) != '-') {
            return -1;
        }
        k = k + 1;
    }
    if (lead && tail) {
        return doc.ALIGN_CENTER;
    }
    if (lead) {
        return doc.ALIGN_LEFT;
    }
    if (tail) {
        return doc.ALIGN_RIGHT;
    }
    return doc.ALIGN_NONE;
}

// One row split on its unescaped pipes, with the optional leading and
// trailing pipe dropped.
List<str> cells_of(str line) {
    str row = line.trim();
    if (row.starts_with("|")) {
        row = chop(row, 1);
    }
    if (row.ends_with("|") && !row.ends_with("\\|")) {
        row = row.substr(0, row.size() - 1);
    }
    List<str> out = [];
    List<str> part = [];
    int n = row.size();
    int i = 0;
    int from = 0;
    while (i < n) {
        int c = row.byte_at(i);
        if (c == '\\' && i + 1 < n && row.byte_at(i + 1) == '|') {
            part.push(row.substr(from, i));
            part.push("|");
            i = i + 2;
            from = i;
            continue;
        }
        if (c == '|') {
            part.push(row.substr(from, i));
            out.push(part.join("").trim());
            part.clear();
            i = i + 1;
            from = i;
            continue;
        }
        i = i + 1;
    }
    part.push(row.substr(from, n));
    out.push(part.join("").trim());
    return out;
}

int table_at(List<doc.Block> out, List<str> lines, int at) {
    List<str> heads = cells_of(lines[at]);
    List<int> align = [];
    for (str cell in cells_of(lines[at + 1])) {
        align.push(align_of(cell));
    }
    List<List<str>> rows = [];
    int n = lines.size();
    int i = at + 2;
    bool done = false;
    while (i < n && !done) {
        str line = lines[i];
        if (blank(line)) {
            done = true;
            continue;
        }
        int li = indent_of(line);
        str r = chop(line, li);
        if (li < 4 && (starts_block(r) || marker_of(r).ok)) {
            done = true;
            continue;
        }
        List<str> cells = cells_of(line);
        while (cells.size() < heads.size()) {
            cells.push("");
        }
        while (cells.size() > heads.size()) {
            cells.pop();
        }
        rows.push(cells);
        i = i + 1;
    }
    out.push(doc.Block.Grid(doc.Table(heads, align, rows)));
    return i;
}
