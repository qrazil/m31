// The inline parser: one block's raw markdown source to the HTML that goes
// inside its element.
//
// Two passes, which is what CommonMark's emphasis rules need and what a
// single left-to-right scan cannot do. The first pass walks the bytes and
// produces a list of `Node`s: a node is either FINISHED HTML (a code span, a
// link, an escaped run of text) or an unresolved RUN of `*` or `_`. The
// second pass, `emphasis`, pairs the runs up and hangs `<em>`/`<strong>` tags
// on them. `emit` then concatenates.
//
// Text is escaped as it is pushed, not at the end, so a node is either final
// HTML or a delimiter run and there is no third state to keep straight.
//
// The module is named `inlines` and not `inline` because `inline` is a C
// keyword and this compiler emits C.
import html;
import text;

// --- character classes -------------------------------------------------------
//
// Everything here is ASCII, and looks at BYTES. That is exact for the classes
// it needs -- every byte of a non-ASCII character is >= 128, so a multi-byte
// character is uniformly "other", which is what a letter is -- and it is the
// one place this parser knowingly differs from CommonMark, which classifies
// by Unicode category. `é` and `字` are "other" here and there; U+00A0 and
// `»` are "other" here and whitespace/punctuation there. See README.

bool space_byte(int c) {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 11 || c == 12;
}

bool punct_byte(int c) {
    if (c >= '!' && c <= '/') {
        return true;
    }
    if (c >= ':' && c <= '@') {
        return true;
    }
    if (c >= '[' && c <= '`') {
        return true;
    }
    return c >= '{' && c <= '~';
}

bool alpha_byte(int c) {
    return c >= 65 && c <= 90 || c >= 97 && c <= 122;
}

bool digit_byte(int c) {
    return c >= '0' && c <= '9';
}

bool alnum_byte(int c) {
    return alpha_byte(c) || digit_byte(c);
}

// --- URL escaping ------------------------------------------------------------
//
// cmark's `houdini_escape_href`, reproduced: `&` becomes `&amp;`, `'` becomes
// `&#x27;`, and every byte outside the safe set becomes `%XX` with upper-case
// hex. The safe set is alphanumerics plus this punctuation, which is what
// cmark's HREF_SAFE table holds -- note that `<`, `>`, `"`, `[`, `\`, `]`,
// `^`, `{`, `|`, `}`, space and DEL are NOT in it.
const str HREF_SAFE = "!#$%&'()*+,-./:;=?@_~`";
const str HEX = "0123456789ABCDEF";

bool href_safe(int c) {
    if (alnum_byte(c)) {
        return true;
    }
    return HREF_SAFE.index_of(str.from_chars([c])).is_some();
}

// `dest` percent-encoded for an `href=".."` attribute.
str escape_href(str dest) {
    List<str> out = [];
    int n = dest.size();
    for (int i in 0 .. n) {
        int c = dest.byte_at(i);
        if (c == '&') {
            out.push("&amp;");
        } else if (c == '\'') {
            out.push("&#x27;");
        } else if (href_safe(c)) {
            out.push(dest.substr(i, i + 1));
        } else {
            out.push("%");
            out.push(HEX.substr(c / 16, c / 16 + 1));
            out.push(HEX.substr(c % 16, c % 16 + 1));
        }
    }
    return out.join("");
}

// --- nodes -------------------------------------------------------------------

// Either finished HTML (`delim` false, `out` is it) or an unresolved run of
// `*` or `_`. `orig` is how many were written, `count` how many are still
// unpaired; `open_tags` grows leftwards and `close_tags` rightwards as the
// second pass hangs tags on the run, which is the order that makes
// `***x***` come out `<em><strong>x</strong></em>`.
type Node {
    bool delim;
    str out;
    int ch;
    int orig;
    int count;
    // What the flanking rules said when the run was scanned. These never
    // change: the rule of three asks what a run IS, not what is left of it.
    bool opener;
    bool closer;
    // Off the delimiter stack. A dead run is no longer a candidate for
    // pairing, but its unspent characters are still printed -- which is what
    // "unlinking the delimiter but not the text node" means in cmark.
    bool dead;
    str open_tags;
    str close_tags;
}

Node html_node(str h) {
    return Node(false, h, 0, 0, 0, false, false, false, "", "");
}

Node delim_node(int c, int len, bool opens, bool closes) {
    return Node(true, "", c, len, len, opens, closes, false, "", "");
}

str mark_of(int c) {
    if (c == '*') {
        return "*";
    }
    return "_";
}

// --- the scan ----------------------------------------------------------------

/// `s`, a block's raw inline source, as the HTML that goes inside its element.
pub str render(str s) {
    return render_at(s, 0);
}

// The same, with the plain text only: every tag removed. This is what an
// image's `alt` attribute holds, and rendering then stripping is how the
// literal-vs-emphasis question is answered without a second parser.
str plain(str s) {
    return strip_tags(render_at(s, 0));
}

str render_at(str s, int depth) {
    List<Node> ns = scan(s, brackets(s), depth);
    emphasis(ns);
    return emit(ns);
}

// For every `[` in `s`, the offset of the `]` that closes it, or -1. An empty
// list means there is no `[` at all.
//
// One pass with a stack, which is the whole reason this exists: searching
// forward for the matching `]` at each `[` is quadratic, and 50 000
// unmatched `[` -- 50 KB, an entirely possible thing to be handed -- took
// four and a half seconds that way. It is the same answer, because a
// stack's match and a depth count's match are the same bracket.
//
// A backslash escapes a bracket and a code span hides one, so a `]` inside
// a code span does not close the link that contains it.
List<int> brackets(str s) {
    int n = s.size();
    if (s.index_of("[").is_none()) {
        return [];
    }
    List<int> shut = [-1; n];
    List<int> open = [];
    int i = 0;
    while (i < n) {
        int c = s.byte_at(i);
        if (c == '\\') {
            i = i + 2;
            continue;
        }
        if (c == '`') {
            i = skip_code(s, i);
            continue;
        }
        if (c == '[') {
            open.push(i);
        } else if (c == ']' && open.size() > 0) {
            shut[open.pop()] = i;
        }
        i = i + 1;
    }
    return shut;
}

List<Node> scan(str s, List<int> shut, int depth) {
    List<Node> ns = [];
    int n = s.size();
    int i = 0;
    int from = 0;
    while (i < n) {
        int c = s.byte_at(i);
        if (c == '\\') {
            // A backslash escapes ASCII punctuation, and ends a line hard.
            if (i + 1 < n && s.byte_at(i + 1) == '\n') {
                flush(ns, s, from, i);
                ns.push(html_node("<br />\n"));
                i = i + 2;
                i = skip_indent(s, i);
                from = i;
                continue;
            }
            if (i + 1 < n && punct_byte(s.byte_at(i + 1))) {
                flush(ns, s, from, i);
                ns.push(html_node(html.escape(s.substr(i + 1, i + 2))));
                i = i + 2;
                from = i;
                continue;
            }
            i = i + 1;
            continue;
        }
        if (c == '`') {
            int after = code_span(ns, s, i, from);
            if (after > i) {
                i = after;
                from = i;
                continue;
            }
            // Not a span: the run is literal, and skipping it whole stops the
            // next backtick from opening one inside it.
            int j = i;
            while (j < n && s.byte_at(j) == '`') {
                j = j + 1;
            }
            i = j;
            continue;
        }
        if (c == '<') {
            int after = autolink(ns, s, i, from);
            if (after > i) {
                i = after;
                from = i;
                continue;
            }
            i = i + 1;
            continue;
        }
        if (c == '[' || c == '!' && i + 1 < n && s.byte_at(i + 1) == '[') {
            int after = link(ns, s, shut, i, from, depth);
            if (after > i) {
                i = after;
                from = i;
                continue;
            }
            i = i + 1;
            continue;
        }
        if (c == '\n') {
            // A line break. Two or more trailing spaces make it hard; the
            // trailing spaces go either way, and so does the next line's
            // indent.
            int back = i;
            while (back > from && s.byte_at(back - 1) == ' ') {
                back = back - 1;
            }
            flush(ns, s, from, back);
            if (i - back >= 2) {
                ns.push(html_node("<br />\n"));
            } else {
                ns.push(html_node("\n"));
            }
            i = skip_indent(s, i + 1);
            from = i;
            continue;
        }
        if (c == '*' || c == '_') {
            int j = i;
            while (j < n && s.byte_at(j) == c) {
                j = j + 1;
            }
            flush(ns, s, from, i);
            ns.push(run_at(s, i, j, c));
            i = j;
            from = i;
            continue;
        }
        i = i + 1;
    }
    flush(ns, s, from, n);
    return ns;
}

void flush(List<Node> ns, str s, int from, int to) {
    if (to > from) {
        ns.push(html_node(html.escape(s.substr(from, to))));
    }
}

int skip_indent(str s, int at) {
    int n = s.size();
    int i = at;
    while (i < n && (s.byte_at(i) == ' ' || s.byte_at(i) == '\t')) {
        i = i + 1;
    }
    return i;
}

// The delimiter run `s[i..j)` of `c`, classified. The rules are CommonMark's
// left-flanking and right-flanking, over the byte before and the byte after.
Node run_at(str s, int i, int j, int c) {
    int before = 32;
    if (i > 0) {
        before = s.byte_at(i - 1);
    }
    int after = 32;
    if (j < s.size()) {
        after = s.byte_at(j);
    }
    bool bw = space_byte(before);
    bool bp = punct_byte(before);
    bool aw = space_byte(after);
    bool ap = punct_byte(after);
    bool left = !aw && (!ap || bw || bp);
    bool right = !bw && (!bp || aw || ap);
    if (c == '_') {
        return delim_node(c, j - i, left && (!right || bp), right && (!left || ap));
    }
    return delim_node(c, j - i, left, right);
}

// --- code spans --------------------------------------------------------------

// Returns the offset just past the span, or `i` if the backtick run at `i`
// opens nothing.
int code_span(List<Node> ns, str s, int i, int from) {
    int n = s.size();
    int j = i;
    while (j < n && s.byte_at(j) == '`') {
        j = j + 1;
    }
    int want = j - i;
    int k = j;
    int found = -1;
    while (k < n && found < 0) {
        if (s.byte_at(k) == '`') {
            int m = k;
            while (m < n && s.byte_at(m) == '`') {
                m = m + 1;
            }
            if (m - k == want) {
                found = k;
            } else {
                k = m;
            }
        } else {
            k = k + 1;
        }
    }
    if (found < 0) {
        return i;
    }
    str body = text.replace(s.substr(j, found), "\n", " ");
    if (body.size() >= 2 && body.starts_with(" ") && body.ends_with(" ") && body.trim().size() > 0) {
        body = body.substr(1, body.size() - 1);
    }
    flush(ns, s, from, i);
    ns.push(html_node("<code>" + html.escape(body) + "</code>"));
    return found + want;
}

// --- autolinks ---------------------------------------------------------------

int autolink(List<Node> ns, str s, int i, int from) {
    int n = s.size();
    int j = i + 1;
    while (j < n) {
        int c = s.byte_at(j);
        if (c == '>') {
            break;
        }
        if (c == '<' || space_byte(c)) {
            return i;
        }
        j = j + 1;
    }
    if (j >= n) {
        return i;
    }
    str body = s.substr(i + 1, j);
    if (is_uri(body)) {
        flush(ns, s, from, i);
        ns.push(html_node("<a href=\"" + escape_href(body) + "\">" + html.escape(body) + "</a>"));
        return j + 1;
    }
    if (is_email(body)) {
        flush(ns, s, from, i);
        ns.push(html_node("<a href=\"mailto:" + escape_href(body) + "\">" + html.escape(body) + "</a>"));
        return j + 1;
    }
    return i;
}

// `scheme:rest`, where the scheme is 2 to 32 characters starting with a
// letter. The characters that would have ended the scan -- space, `<`, `>` --
// are already gone.
bool is_uri(str body) {
    int n = body.size();
    if (n == 0 || !alpha_byte(body.byte_at(0))) {
        return false;
    }
    for (int i in 1 .. n) {
        int c = body.byte_at(i);
        if (c == ':') {
            return i >= 2 && i <= 32;
        }
        if (!alnum_byte(c) && c != '+' && c != '-' && c != '.') {
            return false;
        }
    }
    return false;
}

bool is_email(str body) {
    Option<int> at = body.index_of("@");
    match (at) {
        case None: {
            return false;
        }
        case Some(int k): {
            if (k == 0 || k + 1 >= body.size()) {
                return false;
            }
            for (int i in 0 .. k) {
                int c = body.byte_at(i);
                if (!alnum_byte(c) && MAIL_LOCAL.index_of(str.from_chars([c])).is_none()) {
                    return false;
                }
            }
            return labels_ok(body.substr(k + 1, body.size()));
        }
    }
}

const str MAIL_LOCAL = ".!#$%&'*+/=?^_`{|}~-";

bool labels_ok(str host) {
    for (str label in host.split(".")) {
        int n = label.size();
        if (n == 0 || n > 63) {
            return false;
        }
        if (!alnum_byte(label.byte_at(0)) || !alnum_byte(label.byte_at(n - 1))) {
            return false;
        }
        int i = 1;
        while (i < n - 1) {
            int c = label.byte_at(i);
            if (!alnum_byte(c) && c != '-') {
                return false;
            }
            i = i + 1;
        }
    }
    return host.size() > 0;
}

// --- links and images --------------------------------------------------------

// What a `(dest "title")` clause came to.
type Target {
    bool ok;
    str href;
    str title;
    int at;
}

int link(List<Node> ns, str s, List<int> shuts, int i, int from, int depth) {
    int bang = 0;
    if (s.byte_at(i) == '!') {
        bang = 1;
    }
    // A link may not hold another link, so inside one a `[` is literal. An
    // image may, because its content becomes plain text either way.
    if (bang == 0 && depth > 0) {
        return i;
    }
    int open = i + bang;
    if (open >= shuts.size()) {
        return i;
    }
    int shut = shuts[open];
    if (shut < 0 || shut + 1 >= s.size() || s.byte_at(shut + 1) != 40) {
        return i;
    }
    Target t = target(s, shut + 2);
    if (!t.ok) {
        return i;
    }
    str inner = s.substr(open + 1, shut);
    flush(ns, s, from, i);
    List<str> out = [];
    if (bang == 1) {
        out.push("<img src=\"");
        out.push(escape_href(t.href));
        out.push("\" alt=\"");
        out.push(plain(inner));
        out.push("\"");
        if (t.title.size() > 0) {
            out.push(" title=\"");
            out.push(html.escape(t.title));
            out.push("\"");
        }
        out.push(" />");
    } else {
        out.push("<a href=\"");
        out.push(escape_href(t.href));
        out.push("\"");
        if (t.title.size() > 0) {
            out.push(" title=\"");
            out.push(html.escape(t.title));
            out.push("\"");
        }
        out.push(">");
        out.push(render_at(inner, depth + 1));
        out.push("</a>");
    }
    ns.push(html_node(out.join("")));
    return t.at;
}

int skip_code(str s, int i) {
    int n = s.size();
    int j = i;
    while (j < n && s.byte_at(j) == '`') {
        j = j + 1;
    }
    int want = j - i;
    int k = j;
    while (k < n) {
        if (s.byte_at(k) == '`') {
            int m = k;
            while (m < n && s.byte_at(m) == '`') {
                m = m + 1;
            }
            if (m - k == want) {
                return m;
            }
            k = m;
        } else {
            k = k + 1;
        }
    }
    return j;
}

// `(dest)`, `(dest "title")`, `()` -- `at` is just past the `(`.
Target target(str s, int at) {
    int n = s.size();
    int i = skip_ws(s, at);
    str href = "";
    if (i < n && s.byte_at(i) == '<') {
        int j = i + 1;
        while (j < n && s.byte_at(j) != '>' && s.byte_at(j) != '\n') {
            if (s.byte_at(j) == '\\') {
                j = j + 1;
            }
            j = j + 1;
        }
        if (j >= n || s.byte_at(j) != '>') {
            return Target(false, "", "", at);
        }
        href = unescape(s.substr(i + 1, j));
        i = j + 1;
    } else {
        int j = i;
        int depth = 0;
        while (j < n) {
            int c = s.byte_at(j);
            if (c == '\\' && j + 1 < n) {
                j = j + 2;
                continue;
            }
            if (space_byte(c)) {
                break;
            }
            if (c == 40) {
                depth = depth + 1;
            } else if (c == ')') {
                if (depth == 0) {
                    break;
                }
                depth = depth - 1;
            }
            j = j + 1;
        }
        href = unescape(s.substr(i, j));
        i = j;
    }
    int k = skip_ws(s, i);
    str title = "";
    if (k > i || k < n && s.byte_at(k) == 41) {
        if (k < n && (s.byte_at(k) == 34 || s.byte_at(k) == 39 || s.byte_at(k) == 40)) {
            int shut = 34;
            if (s.byte_at(k) == '\'') {
                shut = 39;
            }
            if (s.byte_at(k) == 40) {
                shut = 41;
            }
            int j = k + 1;
            while (j < n && s.byte_at(j) != shut) {
                if (s.byte_at(j) == '\\') {
                    j = j + 1;
                }
                j = j + 1;
            }
            if (j >= n) {
                return Target(false, "", "", at);
            }
            title = unescape(s.substr(k + 1, j));
            k = skip_ws(s, j + 1);
        }
    }
    if (k >= n || s.byte_at(k) != ')') {
        return Target(false, "", "", at);
    }
    return Target(true, href, title, k + 1);
}

int skip_ws(str s, int at) {
    int n = s.size();
    int i = at;
    while (i < n && space_byte(s.byte_at(i))) {
        i = i + 1;
    }
    return i;
}

// Backslash escapes resolved, for text that is about to become an attribute
// rather than inline content.
str unescape(str s) {
    if (s.index_of("\\").is_none()) {
        return s;
    }
    List<str> out = [];
    int n = s.size();
    int i = 0;
    int from = 0;
    while (i < n) {
        if (s.byte_at(i) == '\\' && i + 1 < n && punct_byte(s.byte_at(i + 1))) {
            out.push(s.substr(from, i));
            i = i + 1;
            from = i;
        }
        i = i + 1;
    }
    out.push(s.substr(from, n));
    return out.join("");
}

str strip_tags(str s) {
    if (s.index_of("<").is_none()) {
        return s;
    }
    List<str> out = [];
    int n = s.size();
    int i = 0;
    int from = 0;
    while (i < n) {
        if (s.byte_at(i) == '<') {
            out.push(s.substr(from, i));
            while (i < n && s.byte_at(i) != '>') {
                i = i + 1;
            }
            if (i < n) {
                i = i + 1;
            }
            from = i;
        } else {
            i = i + 1;
        }
    }
    out.push(s.substr(from, n));
    return out.join("");
}

// --- emphasis ----------------------------------------------------------------

// CommonMark's "process emphasis", and it is reproduced here down to the
// parts that look like accidents, because they decide real documents:
//
//   * closers are walked left to right; for each, openers are walked
//     backwards to the `bottom` for that character;
//   * `bottom` is raised when a closer finds nothing -- but ONLY if the last
//     candidate it looked at was not refused by the rule of three, because a
//     `**` that fails to match an earlier `*` may still become an opener;
//   * `odd` therefore leaks out of the search loop carrying the LAST
//     candidate's verdict, which is what makes `_c` on the line above change
//     whether `**a*b**` is strong. That is not a typo here; it is what the
//     reference implementation does, and matching it is the point.
//
// A matched pair spends two delimiters if both runs have two, otherwise one,
// and everything still on the stack between the pair comes off it.
void emphasis(List<Node> ns) {
    List<int> ds = [];
    for (int at in 0 .. ns.size()) {
        if (ns[at].delim) {
            ds.push(at);
        }
    }
    // One bottom per delimiter character: -1 is the bottom of the stack.
    int bottom_star = -1;
    int bottom_score = -1;
    int p = 0;
    while (p < ds.size()) {
        Node cn = ns[ds[p]];
        if (cn.dead || !cn.closer) {
            p = p + 1;
            continue;
        }
        int bottom = bottom_star;
        if (cn.ch == 95) {
            bottom = bottom_score;
        }
        int prev = alive_before(ns, ds, p);
        int q = p - 1;
        int found = -1;
        bool odd = false;
        while (q >= 0 && found < 0) {
            Node on = ns[ds[q]];
            if (on.dead) {
                q = q - 1;
                continue;
            }
            if (ds[q] == bottom) {
                q = -1;
                continue;
            }
            odd = (cn.opener || on.closer) && cn.orig % 3 != 0 && (on.orig + cn.orig) % 3 == 0;
            if (on.ch == cn.ch && on.opener && !odd) {
                found = q;
            } else {
                q = q - 1;
            }
        }
        if (found < 0) {
            p = p + 1;
            if (!odd) {
                if (cn.ch == 95) {
                    bottom_score = prev;
                } else {
                    bottom_star = prev;
                }
                if (!cn.opener) {
                    cn.dead = true;
                }
            }
            continue;
        }
        Node on = ns[ds[found]];
        int use = 1;
        if (cn.count >= 2 && on.count >= 2) {
            use = 2;
        }
        on.count = on.count - use;
        cn.count = cn.count - use;
        if (use == 2) {
            on.open_tags = "<strong>" + on.open_tags;
            cn.close_tags = cn.close_tags + "</strong>";
        } else {
            on.open_tags = "<em>" + on.open_tags;
            cn.close_tags = cn.close_tags + "</em>";
        }
        for (int k in found + 1 .. p) {
            ns[ds[k]].dead = true;
        }
        if (on.count == 0) {
            on.dead = true;
        }
        if (cn.count == 0) {
            cn.dead = true;
            p = p + 1;
        }
    }
}

// The node index of the nearest delimiter still on the stack before `p`, or
// -1 for the bottom of it.
int alive_before(List<Node> ns, List<int> ds, int p) {
    int q = p - 1;
    while (q >= 0) {
        if (!ns[ds[q]].dead) {
            return ds[q];
        }
        q = q - 1;
    }
    return -1;
}

str emit(List<Node> ns) {
    List<str> out = [];
    for (Node nd in ns) {
        if (nd.delim) {
            out.push(nd.close_tags);
            if (nd.count > 0) {
                out.push(mark_of(nd.ch).repeat(nd.count));
            }
            out.push(nd.open_tags);
        } else {
            out.push(nd.out);
        }
    }
    return out.join("");
}
