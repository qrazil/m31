import net;
import io;

// N real TCP connections to one local listener, all at once, each its own
// `spawn`ed green thread on both ends (a server-side accept loop spawning
// one handler per connection, and N independent client green threads) --
// proving that real socket I/O through the reactor (lib/net.m31's
// non-blocking sockets, `__wait_io`) does not serialize on a carrier the
// way a blocking `read`/`write`/`accept`/`connect` would.
//
// Every connection does a full round trip (write, read the echo back,
// check it matches byte for byte) so a bug that crossed wires between two
// connections -- the reactor waking the wrong green thread for a ready fd,
// say -- would show up as a mismatch, not just a slow or missing one.
// Run under a small, explicit LANG_NUM_CARRIERS by the dedicated
// concurrency test script (not this ordinary corpus run), the same way
// corpus/core's 1303/1304 test `Chan` contention: if a parked green thread
// blocked its carrier instead of freeing it, N connections on a handful of
// carriers would not merely be slow, several of them would never even be
// accepted, because the accept loop itself needs a carrier turn.

const int N = 200;

void handler(net.Conn c) {
    match (c.read_until([10], 256)) {
        case Ok(bytes line): {
            match (c.write(line)) {
                case Ok(int n): {
                }
                case Err(io.Error e): {
                    trap("handler write: " + e.to_str());
                }
            }
        }
        case Err(io.Error e): {
            trap("handler read: " + e.to_str());
        }
    }
    Result<bool, io.Error> closed = c.close();
}

void serve(net.Listener ln, int n) {
    int i = 0;
    while (i < n) {
        match (ln.accept()) {
            case Ok(net.Conn c): {
                spawn handler(c);
            }
            case Err(net.Error e): {
                trap("accept: " + e.to_str());
            }
        }
        i = i + 1;
    }
    Result<bool, net.Error> closed = ln.close();
}

// listen()'s backlog argument is a request, not a guarantee: the kernel
// clamps it to its own ceiling (somaxconn) regardless of what this program
// asks for, and a real macOS CI run showed the N+56 backlog above making
// no difference at all -- byte-for-byte the same "connection was broken by
// the peer" as the unmodified default, which only makes sense if both
// requests were silently clamped to the same real kernel ceiling. This is
// standard BSD/POSIX behavior under a genuine connection burst, not a bug
// in this runtime's reactor: once N real connect()s fire at once on a
// single carrier, some will race ahead of the accept loop's own turn and
// land on a backlog the kernel has already decided is full, and BSD
// kernels are documented to answer that with a RST (ECONNRESET) rather
// than Linux's more common silent-drop-and-let-the-client's-own-SYN-retry
// handle it. A production TCP client retries exactly this the same way.
//
// No stdlib sleep/yield primitive exists to wait between attempts.
// connect() IS a blocking FFI call (every call site already goes through
// enter_blocking/exit_blocking, see the compiler's own warnings above),
// but that only yields the carrier when the syscall actually blocks --
// confirmed locally (artificially set backlog: 1 to force every
// connection past the first to be refused synchronously) that a
// same-carrier RST-and-immediate-retry loop with no real wait in it can
// come back so fast it never actually parks, starving the accept loop of
// a turn forever on a single carrier. yield_once() below forces a real
// scheduling round trip the same way: park on a channel recv, let a
// spawned green thread (necessarily a separate scheduling turn) wake it.
const int CONNECT_RETRIES = 20;

void send_tick(Chan<int> tick) {
    send(tick, 1);
}

void yield_once() {
    Chan<int> tick = Chan<int>(1);
    spawn send_tick(tick);
    int ignored = recv(tick);
}

void client(int id, int port, Chan<int> results) {
    Result<net.Conn, net.Error> attempt = net.connect("127.0.0.1", port);
    int tries = 0;
    while (true) {
        bool retry = false;
        match (attempt) {
            case Ok(net.Conn c): {
            }
            case Err(net.Error e): {
                match (e) {
                    case Reset: {
                        tries = tries + 1;
                        if (tries < CONNECT_RETRIES) {
                            retry = true;
                        }
                    }
                    case Refused: {
                    }
                    case TimedOut: {
                    }
                    case Unreachable: {
                    }
                    case InUse: {
                    }
                    case NameNotFound: {
                    }
                    case Other(int code): {
                    }
                }
            }
        }
        if (retry) {
            yield_once();
            attempt = net.connect("127.0.0.1", port);
            continue;
        }
        break;
    }
    match (attempt) {
        case Ok(net.Conn c): {
            bytes line = (id.to_str() + "\n").to_bytes();
            match (c.write(line)) {
                case Ok(int n): {
                }
                case Err(io.Error e): {
                    trap("client write: " + e.to_str());
                }
            }
            match (c.read_until([10], 256)) {
                case Ok(bytes echoed): {
                    if (echoed.utf8().or("?") == id.to_str() + "\n") {
                        send(results, 1);
                    } else {
                        send(results, 0);
                    }
                }
                case Err(io.Error e): {
                    trap("client read: " + e.to_str());
                }
            }
            Result<bool, io.Error> closed = c.close();
        }
        case Err(net.Error e): {
            trap("connect: " + e.to_str());
        }
    }
}

// N + 56, comfortably above N, so this demo tests the concurrency claim
// rather than a backlog size nobody chose on purpose -- though client()'s
// own comment above is why this alone does not make the demo bulletproof
// on every kernel: the real ceiling is somaxconn, which this argument
// cannot raise past.
match (net.listen("127.0.0.1", 0, backlog: N + 56)) {
    case Ok(net.Listener ln): {
        int port = ln.local().port();
        Chan<int> results = Chan<int>(N);
        spawn serve(ln, N);
        int i = 0;
        while (i < N) {
            spawn client(i, port, results);
            i = i + 1;
        }
        int sum = 0;
        i = 0;
        while (i < N) {
            sum = sum + recv(results);
            i = i + 1;
        }
        print(sum);
    }
    case Err(net.Error e): {
        trap("listen: " + e.to_str());
    }
}
