import net;
import io;
import date;

// The stall `set_read_timeout` used to cause, measured (docs/net-timeouts-
// decision.md). Run by runtime/net_timeout_stall_test.sh with
// LANG_NUM_CARRIERS=2, not by the ordinary corpus: its output is timings.
//
// N clients connect to a server and say nothing. The server gives each
// connection a 400 ms read timeout. Then one more client connects and sends
// a line at once. When a timeout held its carrier in ppoll(2), N silent
// connections occupied both carriers for the whole 400 ms, and the one live
// connection -- and the accept loop, and this program's own main -- waited
// behind them. When a timeout parks only the green thread, the live
// connection is served the moment its line arrives.
//
// What is printed, per case, in milliseconds:
//
//   live    from the start of the case to the live connection's line being
//           read. The case itself needs about 2 * SETTLE (120) ms, spent
//           letting the silent handlers get into their reads and the live
//           connection into its own; anything above that is a stall.
//   silent  the longest any silent connection took to report its timeout.
//
// The numbers go through `date.now_ns()`, one clock, so they are comparable.

const int TIMEOUT_MS = 400;
const int SETTLE_MS = 60;

bytes newline_bytes() {
    bytes newline = [10];
    return newline;
}

// A sleep that parks only the calling green thread: wait for a connection
// on a listener nobody connects to.
void pause(net.Listener idle, int milliseconds) {
    match (idle.wait(milliseconds)) {
        case Ok(_): {
        }
        case Err(net.Error error): {
            trap("wait: " + error.to_str());
        }
    }
}

void silent_client(int port, Chan<int> release) {
    match (net.connect("127.0.0.1", port)) {
        case Ok(net.Conn connection): {
            int ignored = recv(release);
            Result<bool, io.Error> closed = connection.close();
        }
        case Err(net.Error error): {
            trap("silent connect: " + error.to_str());
        }
    }
}

void live_client(int port, Chan<int> start_signal) {
    match (net.connect("127.0.0.1", port)) {
        case Ok(net.Conn connection): {
            int ignored = recv(start_signal);
            match (connection.write("hello\n".to_bytes())) {
                case Ok(_): {
                }
                case Err(io.Error error): {
                    trap("live write: " + error.to_str());
                }
            }
            Result<bool, io.Error> closed = connection.close();
        }
        case Err(net.Error error): {
            trap("live connect: " + error.to_str());
        }
    }
}

void silent_handler(net.Conn connection, Chan<int> started, Chan<int> report) {
    match (connection.set_read_timeout(TIMEOUT_MS)) {
        case Ok(_): {
        }
        case Err(net.Error error): {
            trap("set_read_timeout: " + error.to_str());
        }
    }
    int start_time = date.now_ns();
    send(started, 1);
    match (connection.read_until(newline_bytes(), 100)) {
        case Ok(_): {
            trap("a silent client sent something");
        }
        case Err(io.Error error): {
            if (net.error_of(error).to_str() != "timed out") {
                trap("silent read: " + net.error_of(error).to_str());
            }
        }
    }
    send(report, date.now_ns() - start_time);
    Result<bool, io.Error> closed = connection.close();
}

void live_handler(net.Conn connection, Chan<int> report) {
    match (connection.set_read_timeout(TIMEOUT_MS)) {
        case Ok(_): {
        }
        case Err(net.Error error): {
            trap("set_read_timeout: " + error.to_str());
        }
    }
    match (connection.read_until(newline_bytes(), 100)) {
        case Ok(_): {
            send(report, date.now_ns());
        }
        case Err(io.Error error): {
            trap("live read: " + net.error_of(error).to_str());
        }
    }
    Result<bool, io.Error> closed = connection.close();
}

void acceptor(net.Listener listener, int silent, Chan<int> started, Chan<int> report, Chan<int> live_report) {
    int accepted_count = 0;
    while (accepted_count < silent) {
        match (listener.accept()) {
            case Ok(net.Conn connection): {
                spawn silent_handler(connection, started, report);
            }
            case Err(net.Error error): {
                trap("accept: " + error.to_str());
            }
        }
        accepted_count = accepted_count + 1;
    }
    match (listener.accept()) {
        case Ok(net.Conn connection): {
            spawn live_handler(connection, live_report);
        }
        case Err(net.Error error): {
            trap("accept: " + error.to_str());
        }
    }
    Result<bool, net.Error> closed = listener.close();
}

void run_case(int silent, net.Listener idle) {
    int t_start = date.now_ns();
    match (net.listen("127.0.0.1", 0)) {
        case Ok(net.Listener listener): {
            int port = listener.local().port();
            Chan<int> started = Chan<int>(silent + 1);
            Chan<int> report = Chan<int>(silent + 1);
            Chan<int> live_report = Chan<int>(1);
            Chan<int> release = Chan<int>(silent + 1);
            Chan<int> start_signal = Chan<int>(1);
            spawn acceptor(listener, silent, started, report, live_report);
            int loop_index = 0;
            while (loop_index < silent) {
                spawn silent_client(port, release);
                loop_index = loop_index + 1;
            }
            loop_index = 0;
            while (loop_index < silent) {
                int ignored = recv(started);
                loop_index = loop_index + 1;
            }
            pause(idle, SETTLE_MS);
            spawn live_client(port, start_signal);
            pause(idle, SETTLE_MS);
            send(start_signal, 1);
            int t_live = recv(live_report);
            int worst = 0;
            loop_index = 0;
            while (loop_index < silent) {
                int took = recv(report);
                if (took > worst) {
                    worst = took;
                }
                loop_index = loop_index + 1;
            }
            // Only now: a client that closed early would turn a handler's
            // timeout into an end of file.
            loop_index = 0;
            while (loop_index < silent) {
                send(release, 1);
                loop_index = loop_index + 1;
            }
            print("silent=" + silent.to_str() + " live_ms=" + ((t_live - t_start) / 1000000).to_str() + " silent_max_ms=" + (worst / 1000000).to_str());
        }
        case Err(net.Error error): {
            trap("listen: " + error.to_str());
        }
    }
}

match (net.listen("127.0.0.1", 0)) {
    case Ok(net.Listener idle): {
        run_case(2, idle);
        run_case(16, idle);
        Result<bool, net.Error> closed = idle.close();
    }
    case Err(net.Error error): {
        trap("listen: " + error.to_str());
    }
}
