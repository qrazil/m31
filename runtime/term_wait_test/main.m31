import date;
import term;
import timer;

// **`term.Reader.read` parks only the green thread.** Driven by
// runtime/term_wait_test.sh over a pty (raw mode needs a terminal) and, with
// stdin from /dev/null, over a descriptor the reactor cannot wait on.

void ticker(Chan<int> done) {
    int tick_count = 0;
    while (tick_count < 10) {
        timer.sleep_ms(10);
        tick_count = tick_count + 1;
    }
    send(done, date.now_ns());
}

Chan<int> done = Chan<int>(1);
spawn ticker(done);
term.Reader reader = term.reader();
Result<term.Session, term.Error> session_result = term.raw();
match (session_result) {
    case Ok(term.Session sess): {
        print("ready");
        int start_time = date.now_ns();
        match (reader.read(400)) {
            case Ok(term.Input got): {
                match (got) {
                    case Timeout: {
                        print("timeout");
                    }
                    case End: {
                        print("end");
                    }
                    case Got(term.Event event): {
                        print("early: " + event.to_str());
                    }
                }
            }
            case Err(_): {
                print("error");
            }
        }
        int end_time = date.now_ns();
        print("waited at least 400 ms: " + ((end_time - start_time) >= 400 * 1000000).to_str());
        print("the ticker ran during the wait: " + (recv(done) < end_time).to_str());
        bool is_going = true;
        while (is_going) {
            match (reader.read(-1)) {
                case Ok(term.Input got): {
                    match (got) {
                        case Got(term.Event event): {
                            print("got " + event.to_str());
                            if (event.to_str() == "q") {
                                is_going = false;
                            }
                        }
                        case Timeout: {
                            print("timeout");
                        }
                        case End: {
                            is_going = false;
                        }
                    }
                }
                case Err(_): {
                    print("error");
                    is_going = false;
                }
            }
        }
        print("done");
    }
    case Err(_): {
        // Not a terminal: read what is there. /dev/null ends at once.
        match (reader.read(400)) {
            case Ok(term.Input got): {
                match (got) {
                    case End: {
                        print("not a tty: end");
                    }
                    case Timeout: {
                        print("not a tty: timeout");
                    }
                    case Got(_): {
                        print("not a tty: got");
                    }
                }
            }
            case Err(_): {
                print("not a tty: error");
            }
        }
    }
}
