// `ssh.sanitize_text`: controls and invisible characters are dropped, the
// rest kept, in time linear in the length. Pure; a `trap` is a failure.
import ssh;
import timer;
import crypto.ed25519;

int check(int passed_count, bool is_ok, str label) {
    if (!is_ok) {
        trap("check failed: " + label);
    }
    return passed_count + 1;
}

int checks = 0;
checks = check(checks, ssh.sanitize_text("plain text\tand\nlines") == "plain text\tand\nlines", "plain text, tab and newline survive");
checks = check(checks, ssh.sanitize_text("a\u{1b}]0;title\u{7}b\u{1b}[2Jc") == "a]0;titleb[2Jc", "ESC and BEL are dropped");
checks = check(checks, ssh.sanitize_text("x\u{7f}y\u{9b}z") == "xyz", "DEL and C1 controls are dropped");
checks = check(checks, ssh.sanitize_text("a\u{202e}b\u{200b}c\u{feff}d\u{2066}e") == "abcde", "bidi, zero-width and BOM are dropped");
checks = check(checks, ssh.sanitize_text("héllo wörld ✓") == "héllo wörld ✓", "ordinary non-ASCII survives");
str big = "";
int block = 0;
while (block < 400000) {
    big = big + "0123456789abcdefghijklmnopqrstuvwxyz\u{1b}[0m\n";
    block = block + 40;
}
int started = timer.monotonic_ns();
str cleaned = ssh.sanitize_text(big);
int elapsed_ms = (timer.monotonic_ns() - started) / 1000000;
checks = check(checks, cleaned.size() < big.size() && elapsed_ms < 2000, "400 KB is cleaned in linear time (took " + elapsed_ms.to_str() + " ms)");
// Ed25519: a public key of small order "verifies" a forged signature (R =
// identity, S = 0) in a cofactorless check; it must be refused.
bytes identity_key = [];
bytes forged = [];
for (int index in 0 .. 32) {
    identity_key.push(0);
    forged.push(0);
}
identity_key[0] = 1;
forged[0] = 1;
for (int index in 0 .. 32) {
    forged.push(0);
}
checks = check(checks, !ed25519.is_valid_signature(identity_key, "anything".to_bytes(), forged), "a small-order public key is refused");
print(checks.to_str() + " checks, 0 failures");
