// `lib/ssh/sshexec.m31`, self-checked against in-memory peers (no network):
//
//  * a *canned* peer replays fixed messages -- the layout of each message,
//    every parser on every proper prefix, one fixture per `sshexec.Error`
//    variant, stdout/stderr separation, exit status and signal, the replies
//    to requests this client does not implement;
//  * a *reactive* peer models a real server's side of the flow control (it
//    honours the client's window and maximum packet size, grants and tops up
//    its own window, and records any violation) as `wc -c`, `cat` and a
//    producer -- so multi-megabyte transfers and a tiny peer window are
//    checked without a network.
//
// `test_auth_exec.sh` runs the same operations against a real `sshd`. A
// `trap` means a check failed.
import ssh;
import ssh.sshexec;

int check(int passed_count, bool is_ok, str label) {
    if (!is_ok) {
        trap("check failed: " + label);
    }
    return passed_count + 1;
}

int error_code(sshexec.Error error) {
    match (error) {
        case Transport(ssh.Error inner): {
            return 0;
        }
        case Truncated: {
            return 1;
        }
        case UnexpectedMessage: {
            return 2;
        }
        case BadMessage: {
            return 3;
        }
        case BadChannel: {
            return 4;
        }
        case OpenRefused(int reason): {
            return 5;
        }
        case ExecRefused: {
            return 6;
        }
        case DataTooLarge: {
            return 7;
        }
        case Closed: {
            return 8;
        }
        case BadArgument: {
            return 9;
        }
    }
}

const int ERROR_TRANSPORT = 0;
const int ERROR_TRUNCATED = 1;
const int ERROR_UNEXPECTED = 2;
const int ERROR_BAD_MESSAGE = 3;
const int ERROR_BAD_CHANNEL = 4;
const int ERROR_OPEN_REFUSED = 5;
const int ERROR_EXEC_REFUSED = 6;
const int ERROR_TOO_LARGE = 7;
const int ERROR_CLOSED = 8;
const int ERROR_BAD_ARGUMENT = 9;
const int MODE_CANNED = 0;
const int MODE_WC = 1;
const int MODE_CAT = 2;
const int MODE_PRODUCE = 3;
const int PEER_ID = 7;

void push_u32(bytes out, int value) {
    out.push(value >> 24 & 0xFF);
    out.push(value >> 16 & 0xFF);
    out.push(value >> 8 & 0xFF);
    out.push(value & 0xFF);
}

int be32(bytes buffer, int offset) {
    return buffer[offset] << 24 | buffer[offset + 1] << 16 | buffer[offset + 2] << 8 | buffer[offset + 3];
}

// --- message builders (the server's side; recipient is our channel 0) --------

bytes message_confirm(int window, int max_packet) {
    bytes message = [sshexec.SSH_MESSAGE_CHANNEL_OPEN_CONFIRMATION];
    push_u32(message, 0);
    push_u32(message, PEER_ID);
    push_u32(message, window);
    push_u32(message, max_packet);
    return message;
}

bytes message_open_failure(int reason) {
    bytes message = [sshexec.SSH_MESSAGE_CHANNEL_OPEN_FAILURE];
    push_u32(message, 0);
    push_u32(message, reason);
    ssh.push_string(message, "no".to_bytes());
    ssh.push_string(message, "".to_bytes());
    return message;
}

bytes message_simple(int kind, int recipient) {
    bytes message = [kind];
    push_u32(message, recipient);
    return message;
}

bytes message_data(bytes data) {
    bytes message = message_simple(sshexec.SSH_MESSAGE_CHANNEL_DATA, 0);
    ssh.push_string(message, data);
    return message;
}

bytes message_ext(int code, bytes data) {
    bytes message = message_simple(sshexec.SSH_MESSAGE_CHANNEL_EXTENDED_DATA, 0);
    push_u32(message, code);
    ssh.push_string(message, data);
    return message;
}

bytes message_adjust(int add) {
    bytes message = message_simple(sshexec.SSH_MESSAGE_CHANNEL_WINDOW_ADJUST, 0);
    push_u32(message, add);
    return message;
}

bytes message_exit_status(int code) {
    bytes message = message_simple(sshexec.SSH_MESSAGE_CHANNEL_REQUEST, 0);
    ssh.push_string(message, "exit-status".to_bytes());
    message.push(0);
    push_u32(message, code);
    return message;
}

bytes message_exit_signal(bytes name) {
    bytes message = message_simple(sshexec.SSH_MESSAGE_CHANNEL_REQUEST, 0);
    ssh.push_string(message, "exit-signal".to_bytes());
    message.push(0);
    ssh.push_string(message, name);
    message.push(1);
    ssh.push_string(message, "killed".to_bytes());
    ssh.push_string(message, "".to_bytes());
    return message;
}

bytes message_request(str name, bool needs_reply) {
    bytes message = message_simple(sshexec.SSH_MESSAGE_CHANNEL_REQUEST, 0);
    ssh.push_string(message, name.to_bytes());
    if (needs_reply) {
        message.push(1);
    } else {
        message.push(0);
    }
    return message;
}

bytes message_global(str name, bool needs_reply) {
    bytes message = [sshexec.SSH_MESSAGE_GLOBAL_REQUEST];
    ssh.push_string(message, name.to_bytes());
    if (needs_reply) {
        message.push(1);
    } else {
        message.push(0);
    }
    return message;
}

// --- the peer ------------------------------------------------------------------

pub type Peer {
    pub List<bytes> out;
    int head;
    pub List<bytes> sent;
    int mode;
    int peer_window;
    int peer_max;
    int window_left;
    int client_window;
    int client_max;
    pub int stdin_total;
    pub int stdin_sum;
    pub int max_data;
    pub bool is_violated;
    int produce_total;
    int produced;
    bytes pending;
    bool has_client_sent_eof;
    bool is_finished;
    bool has_sent_close;
    bytes sid;
}

pub Result<int, ssh.Error> Peer.send(bytes payload) {
    if (mode == MODE_CANNED) {
        sent.push(clone(payload));
        return Result<int, ssh.Error>.Ok(payload.size());
    }
    int kind = payload[0];
    if (kind == sshexec.SSH_MESSAGE_CHANNEL_OPEN) {
        sent.push(clone(payload));
        client_window = be32(payload, 16);
        client_max = be32(payload, 20);
        window_left = peer_window;
        out.push(message_confirm(peer_window, peer_max));
    } else if (kind == sshexec.SSH_MESSAGE_CHANNEL_REQUEST) {
        sent.push(clone(payload));
        out.push(message_simple(sshexec.SSH_MESSAGE_CHANNEL_SUCCESS, 0));
        if (mode == MODE_PRODUCE) {
            out.push(message_ext(1, "err\n".to_bytes()));
            client_window = client_window - 4;
            produce_more();
        }
    } else if (kind == sshexec.SSH_MESSAGE_CHANNEL_DATA) {
        int length = be32(payload, 5);
        if (length > peer_max || length > window_left || be32(payload, 1) != PEER_ID) {
            is_violated = true;
        }
        if (length > max_data) {
            max_data = length;
        }
        window_left = window_left - length;
        stdin_total = stdin_total + length;
        int byte_index = 9;
        while (byte_index < 9 + length) {
            stdin_sum = (stdin_sum + payload[byte_index]) & 0xFFFFFFFF;
            byte_index = byte_index + 1;
        }
        if (window_left <= peer_window / 2) {
            out.push(message_adjust(peer_window - window_left));
            window_left = peer_window;
        }
        if (mode == MODE_CAT) {
            pending.extend(payload.substr(9, 9 + length));
            flush_pending();
        }
    } else if (kind == sshexec.SSH_MESSAGE_CHANNEL_EOF) {
        sent.push(clone(payload));
        has_client_sent_eof = true;
        if (mode == MODE_WC) {
            out.push(message_data((stdin_total.to_str() + "\n").to_bytes()));
            finish();
        } else if (mode == MODE_CAT) {
            flush_pending();
        }
    } else if (kind == sshexec.SSH_MESSAGE_CHANNEL_WINDOW_ADJUST) {
        sent.push(clone(payload));
        client_window = client_window + be32(payload, 5);
        if (mode == MODE_PRODUCE) {
            produce_more();
        } else if (mode == MODE_CAT) {
            flush_pending();
        }
    } else if (kind == sshexec.SSH_MESSAGE_CHANNEL_CLOSE) {
        sent.push(clone(payload));
        if (!has_sent_close) {
            out.push(message_simple(sshexec.SSH_MESSAGE_CHANNEL_CLOSE, 0));
            has_sent_close = true;
        }
    } else {
        sent.push(clone(payload));
    }
    return Result<int, ssh.Error>.Ok(payload.size());
}

pub Result<bytes, ssh.Error> Peer.recv() {
    if (head >= out.size()) {
        return Result<bytes, ssh.Error>.Err(ssh.Error.Disconnected);
    }
    head = head + 1;
    return Result<bytes, ssh.Error>.Ok(out[head - 1]);
}

pub bytes Peer.session_id() {
    return sid;
}

void Peer.finish() {
    if (is_finished) {
        return;
    }
    is_finished = true;
    int code = 0;
    if (mode == MODE_PRODUCE) {
        code = 3;
    }
    out.push(message_exit_status(code));
    out.push(message_simple(sshexec.SSH_MESSAGE_CHANNEL_EOF, 0));
    out.push(message_simple(sshexec.SSH_MESSAGE_CHANNEL_CLOSE, 0));
    has_sent_close = true;
}

void Peer.flush_pending() {
    while (pending.size() > 0 && client_window > 0) {
        int chunk_size = pending.size();
        if (chunk_size > client_window) {
            chunk_size = client_window;
        }
        if (chunk_size > client_max) {
            chunk_size = client_max;
        }
        if (chunk_size > 32768) {
            chunk_size = 32768;
        }
        out.push(message_data(pending.substr(0, chunk_size)));
        pending.drop_front(chunk_size);
        client_window = client_window - chunk_size;
    }
    if (has_client_sent_eof && pending.size() == 0) {
        finish();
    }
}

void Peer.produce_more() {
    while (produced < produce_total && client_window > 0) {
        int chunk_size = produce_total - produced;
        if (chunk_size > client_window) {
            chunk_size = client_window;
        }
        if (chunk_size > client_max) {
            chunk_size = client_max;
        }
        if (chunk_size > 32768) {
            chunk_size = 32768;
        }
        bytes chunk = [];
        int byte_index = 0;
        while (byte_index < chunk_size) {
            chunk.push(pattern(produced + byte_index));
            byte_index = byte_index + 1;
        }
        out.push(message_data(chunk));
        produced = produced + chunk_size;
        client_window = client_window - chunk_size;
    }
    if (produced == produce_total) {
        finish();
    }
}

Peer canned(List<bytes> out) {
    return peer(MODE_CANNED, out, 0, 0, 0);
}

Peer peer(int mode, List<bytes> out, int peer_window, int peer_max, int produce_total) {
    List<bytes> sent = [];
    bytes pending = [];
    return Peer(out, 0, sent, mode, peer_window, peer_max, 0, 0, 0, 0, 0, 0, false, produce_total, 0, pending, false, false, false, [9, 9, 9]);
}

// The producer's byte at offset `offset`.
int pattern(int offset) {
    return (offset * 31 + offset / 251) & 0xFF;
}

// --- helpers --------------------------------------------------------------------

// An open channel on a canned peer: the confirmation, the exec's SUCCESS,
// then `rest`.
Peer ready(int window, int max_packet, List<bytes> rest) {
    List<bytes> out = [message_confirm(window, max_packet), message_simple(sshexec.SSH_MESSAGE_CHANNEL_SUCCESS, 0)];
    for (bytes message in rest) {
        out.push(message);
    }
    return canned(out);
}

sshexec.Channel must_exec(Peer scripted_peer, str command) {
    match (sshexec.exec(scripted_peer, command)) {
        case Ok(sshexec.Channel channel): {
            return channel;
        }
        case Err(sshexec.Error error): {
            trap("exec failed: " + error.to_str());
        }
    }
}

int exec_code(Peer scripted_peer) {
    match (sshexec.exec(scripted_peer, "cmd")) {
        case Ok(_): {
            return -1;
        }
        case Err(sshexec.Error error): {
            return error_code(error);
        }
    }
}

// The code of the first error a channel on `rest` hits while reading stdout
// to the end and waiting for the close, or -1.
int read_code(List<bytes> rest) {
    Peer scripted_peer = ready(1000, 1000, rest);
    sshexec.Channel channel = must_exec(scripted_peer, "cmd");
    match (channel.read_all()) {
        case Ok(_): {
            match (channel.wait()) {
                case Ok(_): {
                    return -1;
                }
                case Err(sshexec.Error error): {
                    return error_code(error);
                }
            }
        }
        case Err(sshexec.Error error): {
            return error_code(error);
        }
    }
}

int code_of_bytes(Result<bytes, sshexec.Error> result) {
    match (result) {
        case Ok(_): {
            return -1;
        }
        case Err(sshexec.Error error): {
            return error_code(error);
        }
    }
}

bytes must_bytes(Result<bytes, sshexec.Error> result) {
    match (result) {
        case Ok(bytes data): {
            return data;
        }
        case Err(sshexec.Error error): {
            trap("unexpected error: " + error.to_str());
        }
    }
}

sshexec.Exit must_wait(sshexec.Channel channel) {
    match (channel.wait()) {
        case Ok(sshexec.Exit channel_exit): {
            return channel_exit;
        }
        case Err(sshexec.Error error): {
            trap("wait failed: " + error.to_str());
        }
    }
}

int write_code(sshexec.Channel channel, bytes data) {
    match (channel.write(data)) {
        case Ok(_): {
            return -1;
        }
        case Err(sshexec.Error error): {
            return error_code(error);
        }
    }
}

int close_write_code(sshexec.Channel channel) {
    match (channel.close_write()) {
        case Ok: {
            return -1;
        }
        case Err(sshexec.Error error): {
            return error_code(error);
        }
    }
}

bool is_exit_status(sshexec.Exit channel_exit, int code) {
    match (channel_exit) {
        case Status(int status_code): {
            return status_code == code;
        }
        case Signal(_): {
            return false;
        }
        case Unknown: {
            return false;
        }
    }
}

bool is_exit_signal(sshexec.Exit channel_exit, str name) {
    match (channel_exit) {
        case Status(_): {
            return false;
        }
        case Signal(str signal_name): {
            return signal_name == name;
        }
        case Unknown: {
            return false;
        }
    }
}

bool is_exit_unknown(sshexec.Exit channel_exit) {
    match (channel_exit) {
        case Status(_): {
            return false;
        }
        case Signal(_): {
            return false;
        }
        case Unknown: {
            return true;
        }
    }
}

int kind_count(Peer scripted_peer, int kind) {
    int count = 0;
    for (bytes message in scripted_peer.sent) {
        if (message.size() > 0 && message[0] == kind) {
            count = count + 1;
        }
    }
    return count;
}

int checks = 0;

// --- 1. message layouts ---------------------------------------------------------

bytes want_open = [90];
ssh.push_string(want_open, "session".to_bytes());
push_u32(want_open, 0);
push_u32(want_open, 2097152);
push_u32(want_open, 32768);
checks = check(checks, sshexec.build_open(0, sshexec.LOCAL_WINDOW, sshexec.LOCAL_MAX_PACKET) == want_open, "CHANNEL_OPEN layout");
bytes want_exec = [98];
push_u32(want_exec, 7);
ssh.push_string(want_exec, "exec".to_bytes());
want_exec.push(1);
ssh.push_string(want_exec, "git-upload-pack 'r'".to_bytes());
checks = check(checks, sshexec.build_exec(7, "git-upload-pack 'r'") == want_exec, "the exec request layout");
bytes want_data = [94, 0, 0, 0, 7, 0, 0, 0, 3, 1, 2, 3];
checks = check(checks, sshexec.build_data(7, [1, 2, 3]) == want_data, "CHANNEL_DATA layout");
bytes want_adjust = [93, 0, 0, 0, 7, 0, 0, 1, 2];
checks = check(checks, sshexec.build_window_adjust(7, 258) == want_adjust, "WINDOW_ADJUST layout");
bytes want_eof = [96, 0, 0, 0, 7];
checks = check(checks, sshexec.build_simple(96, 7) == want_eof, "EOF layout");

// --- 2. exec, output, status -----------------------------------------------------

List<bytes> echo_rest = [message_data("hello\n".to_bytes()), message_ext(1, "oops\n".to_bytes()), message_data("world\n".to_bytes()), message_exit_status(7), message_simple(96, 0), message_simple(97, 0)];
Peer echo_peer = ready(65536, 16384, echo_rest);
sshexec.Channel echo_channel = must_exec(echo_peer, "echo hello");
checks = check(checks, echo_peer.sent.size() == 2 && echo_peer.sent[0] == want_open_with_id() && echo_peer.sent[1] == sshexec.build_exec(PEER_ID, "echo hello"), "exec sends OPEN then the exec request to the server's channel number");
checks = check(checks, is_exit_unknown(echo_channel.exit()), "the exit status is unknown before it arrives");
bytes out1 = must_bytes(echo_channel.read(3));
checks = check(checks, out1 == "hel".to_bytes(), "read(3) returns at most 3 bytes");
checks = check(checks, must_bytes(echo_channel.read(100)) == "lo\n".to_bytes(), "read returns what is buffered, not more");
checks = check(checks, must_bytes(echo_channel.read_all()) == "world\n".to_bytes(), "read_all returns the rest of stdout");
checks = check(checks, must_bytes(echo_channel.read(10)).size() == 0, "read at EOF is empty");
checks = check(checks, must_bytes(echo_channel.read_all_error()) == "oops\n".to_bytes(), "stderr is kept apart from stdout");
checks = check(checks, is_exit_status(must_wait(echo_channel), 7) && is_exit_status(echo_channel.exit(), 7), "exit-status is reported");
checks = check(checks, echo_peer.sent[echo_peer.sent.size() - 1] == sshexec.build_simple(97, PEER_ID), "the client answers the server's CLOSE with its own");
checks = check(checks, kind_count(echo_peer, 97) == 1, "exactly one CLOSE is sent");

bytes want_open_with_id() {
    return sshexec.build_open(0, sshexec.LOCAL_WINDOW, sshexec.LOCAL_MAX_PACKET);
}

// A signal.
Peer signal_peer = ready(1000, 1000, [message_exit_signal("KILL".to_bytes()), message_simple(96, 0), message_simple(97, 0)]);
sshexec.Channel signal_channel = must_exec(signal_peer, "x");
checks = check(checks, is_exit_signal(must_wait(signal_channel), "KILL"), "exit-signal is reported");
// No exit status at all.
Peer no_status_peer = ready(1000, 1000, [message_simple(96, 0), message_simple(97, 0)]);
sshexec.Channel no_status_channel = must_exec(no_status_peer, "x");
checks = check(checks, is_exit_unknown(must_wait(no_status_channel)), "a close with no exit status is Exit.Unknown");
checks = check(checks, must_bytes(no_status_channel.read(1)).size() == 0, "stdout is empty");
// Things the server may send that this client does not implement.
Peer unknown_request_peer = ready(1000, 1000, [message_global("hostkeys-00@openssh.com", false), message_global("probe@example", true), message_request("keepalive@openssh.com", true), message_request("break", false), message_data("x".to_bytes()), message_exit_status(0), message_simple(96, 0), message_simple(97, 0)]);
sshexec.Channel unknown_request_channel = must_exec(unknown_request_peer, "x");
checks = check(checks, must_bytes(unknown_request_channel.read_all()) == "x".to_bytes(), "unknown requests do not disturb the data");
checks = check(checks, kind_count(unknown_request_peer, 82) == 1, "a global request that wants a reply gets REQUEST_FAILURE (and one that does not, nothing)");
checks = check(checks, kind_count(unknown_request_peer, 100) == 1, "an unknown channel request that wants a reply gets CHANNEL_FAILURE");
// A global request between OPEN and its confirmation.
Peer early_global_peer = canned([message_global("hostkeys-00@openssh.com", true), message_confirm(1000, 1000), message_simple(99, 0)]);
sshexec.Channel early_global_channel = must_exec(early_global_peer, "x");
checks = check(checks, kind_count(early_global_peer, 82) == 1, "a global request before the confirmation is answered");
// close(): CLOSE out, the rest discarded, until the server's CLOSE.
Peer discard_peer = ready(1000, 1000, [message_data("discard me".to_bytes()), message_simple(97, 0)]);
sshexec.Channel discard_channel = must_exec(discard_peer, "x");
match (discard_channel.close()) {
    case Ok: {
        checks = check(checks, kind_count(discard_peer, 97) == 1 && discard_peer.sent[discard_peer.sent.size() - 1] == sshexec.build_simple(97, PEER_ID), "close() sends one CLOSE");
    }
    case Err(sshexec.Error error): {
        trap("close: " + error.to_str());
    }
}
checks = check(checks, write_code(discard_channel, [1]) == ERROR_CLOSED, "write after close is Closed");

// --- 3. flow control on writes, with canned grants ---------------------------

// A window of 4, then 3 more: 7 bytes go out as 4 + 3.
Peer window_peer = ready(4, 1000, [message_adjust(3), message_simple(97, 0)]);
sshexec.Channel window_channel = must_exec(window_peer, "x");
checks = check(checks, write_code(window_channel, [1, 2, 3, 4, 5, 6, 7]) == -1, "a write larger than the window completes once the window is topped up");
checks = check(checks, window_peer.sent.size() == 4 && window_peer.sent[2] == sshexec.build_data(PEER_ID, [1, 2, 3, 4]) && window_peer.sent[3] == sshexec.build_data(PEER_ID, [5, 6, 7]), "data is split at the window");
// max packet 2: 5 bytes go as 2 + 2 + 1.
Peer small_packet_peer = ready(100, 2, []);
sshexec.Channel small_packet_channel = must_exec(small_packet_peer, "x");
checks = check(checks, write_code(small_packet_channel, [1, 2, 3, 4, 5]) == -1, "a write larger than the max packet completes");
checks = check(checks, small_packet_peer.sent.size() == 5 && small_packet_peer.sent[2] == sshexec.build_data(PEER_ID, [1, 2]) && small_packet_peer.sent[4] == sshexec.build_data(PEER_ID, [5]), "data is split at the max packet size");
// An empty write sends nothing.
checks = check(checks, write_code(small_packet_channel, []) == -1 && small_packet_peer.sent.size() == 5, "an empty write sends nothing");
// A window that never reopens: the peer goes quiet, which is an error, not a hang.
Peer closed_window_peer = ready(0, 1000, []);
sshexec.Channel closed_window_channel = must_exec(closed_window_peer, "x");
checks = check(checks, write_code(closed_window_channel, [1]) == ERROR_TRANSPORT, "a write into a closed window with a silent peer is Transport(Disconnected)");
// The server closes the channel while we wait for window.
Peer p10 = ready(0, 1000, [message_simple(97, 0)]);
sshexec.Channel c10 = must_exec(p10, "x");
checks = check(checks, write_code(c10, [1]) == ERROR_CLOSED, "a write after the server closed is Closed");
// close_write: EOF once, a second call is a no-op, a write after is Closed.
Peer p11 = ready(100, 100, []);
sshexec.Channel c11 = must_exec(p11, "x");
checks = check(checks, close_write_code(c11) == -1 && close_write_code(c11) == -1 && kind_count(p11, 96) == 1, "close_write sends EOF once");
checks = check(checks, write_code(c11, [1]) == ERROR_CLOSED, "write after close_write is Closed");
// close_write after the server closed.
Peer p11b = ready(100, 100, [message_simple(97, 0)]);
sshexec.Channel c11b = must_exec(p11b, "x");
checks = check(checks, must_bytes(c11b.read_all()).size() == 0, "the server closing ends stdout");
checks = check(checks, close_write_code(c11b) == ERROR_CLOSED, "close_write after the server closed is Closed");

// --- 4. one fixture per Error variant ------------------------------------------

checks = check(checks, exec_code(canned([])) == ERROR_TRANSPORT, "no reply to OPEN: Transport(Disconnected)");
checks = check(checks, exec_code(canned([message_confirm(1, 1)])) == ERROR_TRANSPORT, "no reply to exec: Transport(Disconnected)");
checks = check(checks, exec_code(canned([[]])) == ERROR_TRUNCATED, "an empty payload is Truncated");
checks = check(checks, exec_code(canned([[ssh.SSH_MESSAGE_SERVICE_ACCEPT]])) == ERROR_UNEXPECTED, "a non-channel message in answer to OPEN is UnexpectedMessage");
checks = check(checks, exec_code(canned([message_confirm(1, 0)])) == ERROR_BAD_MESSAGE, "a zero max packet size is BadMessage");
bytes elsewhere = message_confirm(1, 1);
elsewhere[4] = 5;
checks = check(checks, exec_code(canned([elsewhere])) == ERROR_BAD_CHANNEL, "a confirmation for another channel is BadChannel");
checks = check(checks, exec_code(canned([message_open_failure(2)])) == ERROR_OPEN_REFUSED, "OPEN_FAILURE is OpenRefused");
match (sshexec.exec(canned([message_open_failure(4)]), "x")) {
    case Ok(_): {
        trap("expected a refusal");
    }
    case Err(sshexec.Error error): {
        checks = check(checks, error.to_str() == "the server refused to open a session channel (reason 4)", "OpenRefused names the reason code");
    }
}
checks = check(checks, exec_code(canned([message_confirm(1, 1), message_simple(100, 0)])) == ERROR_EXEC_REFUSED, "CHANNEL_FAILURE in answer to exec is ExecRefused");
checks = check(checks, exec_code(canned([message_confirm(1, 1), message_simple(99, 4)])) == ERROR_BAD_CHANNEL, "a SUCCESS for another channel is BadChannel");
checks = check(checks, exec_code(canned([message_confirm(1, 1), message_simple(99, 0)])) == -1, "the minimal successful exec");
// Errors while reading.
checks = check(checks, read_code([[sshexec.SSH_MESSAGE_CHANNEL_DATA]]) == ERROR_TRUNCATED, "a DATA with no channel number is Truncated");
checks = check(checks, read_code([[94, 0, 0, 0, 0, 0, 0, 0, 9, 1]]) == ERROR_TRUNCATED, "a DATA whose length overruns the message is Truncated");
checks = check(checks, read_code([[]]) == ERROR_TRUNCATED, "an empty payload while reading is Truncated");
checks = check(checks, read_code([message_simple(94, 3)]) == ERROR_BAD_CHANNEL, "DATA for another channel is BadChannel");
checks = check(checks, read_code([message_simple(96, 3)]) == ERROR_BAD_CHANNEL, "EOF for another channel is BadChannel");
checks = check(checks, read_code([message_simple(97, 3)]) == ERROR_BAD_CHANNEL, "CLOSE for another channel is BadChannel");
checks = check(checks, read_code([message_ext(2, "x".to_bytes())]) == ERROR_BAD_MESSAGE, "extended data of an unknown type is BadMessage");
checks = check(checks, read_code([message_adjust(0xFFFFFFFF)]) == ERROR_BAD_MESSAGE, "a window past 2^32-1 is BadMessage");
checks = check(checks, read_code([message_exit_signal([0xFF, 0xFE])]) == ERROR_BAD_MESSAGE, "a signal name that is not UTF-8 is BadMessage");
checks = check(checks, read_code([message_simple(99, 0)]) == ERROR_UNEXPECTED, "a stray CHANNEL_SUCCESS while reading is UnexpectedMessage");
checks = check(checks, read_code([[200]]) == ERROR_UNEXPECTED, "an unknown message type while reading is UnexpectedMessage");
checks = check(checks, read_code([message_simple(96, 0), message_data("late".to_bytes())]) == ERROR_UNEXPECTED, "DATA after EOF is UnexpectedMessage");
checks = check(checks, read_code([message_data("x".to_bytes())]) == ERROR_TRANSPORT, "the peer vanishing mid-stream is Transport(Disconnected)");
bytes too_big = [];
int fill_index = 0;
while (fill_index < 32769) {
    too_big.push(1);
    fill_index = fill_index + 1;
}
checks = check(checks, read_code([message_data(too_big)]) == ERROR_TOO_LARGE, "a packet over the advertised max is DataTooLarge");
bytes at_max = too_big.substr(0, 32768);
checks = check(checks, read_code([message_data(at_max), message_simple(96, 0), message_simple(97, 0)]) == -1, "a packet at the advertised max is fine");
Peer pbad = ready(1000, 1000, [message_data("x".to_bytes())]);
sshexec.Channel cbad = must_exec(pbad, "x");
checks = check(checks, code_of_bytes(cbad.read(0)) == ERROR_BAD_ARGUMENT, "read(0) is BadArgument");
checks = check(checks, code_of_bytes(cbad.read_error(-1)) == ERROR_BAD_ARGUMENT, "read_err(-1) is BadArgument");
// Every parser refuses every proper prefix of a valid message.
List<bytes> valids = [message_confirm(5, 5), message_open_failure(1), message_adjust(9), message_data("abc".to_bytes()), message_ext(1, "abc".to_bytes()), message_exit_status(3), message_exit_signal("TERM".to_bytes())];
int fixture_index = 0;
while (fixture_index < valids.size()) {
    bytes full = valids[fixture_index];
    int cut = 0;
    while (cut < full.size()) {
        bytes part = full.substr(0, cut);
        bool is_refused = false;
        if (fixture_index == 0) {
            is_refused = is_confirmation_refused(part);
        } else if (fixture_index == 1) {
            is_refused = is_open_failure_refused(part);
        } else if (fixture_index == 2) {
            is_refused = is_adjust_refused(part);
        } else if (fixture_index == 3) {
            is_refused = code_of_bytes(sshexec.parse_data(part)) != -1;
        } else if (fixture_index == 4) {
            is_refused = code_of_bytes(sshexec.parse_extended_data(part)) != -1;
        } else {
            is_refused = is_request_refused(part);
        }
        if (!is_refused) {
            trap("a " + cut.to_str() + "-byte prefix of message " + fixture_index.to_str() + " parsed");
        }
        cut = cut + 1;
    }
    fixture_index = fixture_index + 1;
}
checks = check(checks, true, "no proper prefix of any server message parses");

bool is_confirmation_refused(bytes part) {
    match (sshexec.parse_confirmation(part)) {
        case Ok(_): {
            return false;
        }
        case Err(_): {
            return true;
        }
    }
}

bool is_open_failure_refused(bytes part) {
    match (sshexec.parse_open_failure(part)) {
        case Ok(_): {
            return false;
        }
        case Err(_): {
            return true;
        }
    }
}

bool is_adjust_refused(bytes part) {
    match (sshexec.parse_window_adjust(part)) {
        case Ok(_): {
            return false;
        }
        case Err(_): {
            return true;
        }
    }
}

bool is_request_refused(bytes part) {
    match (sshexec.parse_request(part)) {
        case Ok(_): {
            return false;
        }
        case Err(_): {
            return true;
        }
    }
}

// --- 5. reactive peers: flow control under load ------------------------------

// A deterministic payload.
bytes payload_of(int size) {
    bytes out = [];
    int byte_index = 0;
    while (byte_index < size) {
        out.push(pattern(byte_index));
        byte_index = byte_index + 1;
    }
    return out;
}

int sum_of(bytes data) {
    int total = 0;
    for (int octet in data) {
        total = (total + octet) & 0xFFFFFFFF;
    }
    return total;
}

// wc -c over a peer that grants `window` and takes `max_packet`.
void run_wc(str label, int window, int max_packet, int size, int write_chunk) {
    Peer scripted_peer = peer(MODE_WC, [], window, max_packet, 0);
    sshexec.Channel channel = must_exec(scripted_peer, "wc -c");
    bytes data = payload_of(size);
    int offset = 0;
    while (offset < size) {
        int chunk_end = offset + write_chunk;
        if (chunk_end > size) {
            chunk_end = size;
        }
        if (write_code(channel, data.substr(offset, chunk_end)) != -1) {
            trap(label + ": write failed");
        }
        offset = chunk_end;
    }
    if (close_write_code(channel) != -1) {
        trap(label + ": close_write failed");
    }
    bytes got = must_bytes(channel.read_all());
    if (got != (size.to_str() + "\n").to_bytes()) {
        trap(label + ": wc answered " + got.hex());
    }
    if (!is_exit_status(must_wait(channel), 0)) {
        trap(label + ": exit status");
    }
    if (scripted_peer.is_violated) {
        trap(label + ": the client broke the peer's window or packet limit");
    }
    if (scripted_peer.stdin_total != size || scripted_peer.stdin_sum != sum_of(data)) {
        trap(label + ": the peer received different bytes");
    }
    int limit = max_packet;
    if (limit > 32768) {
        limit = 32768;
    }
    if (scripted_peer.max_data > limit) {
        trap(label + ": a packet larger than the limit was sent");
    }
}

run_wc("tiny window, tiny packets", 1, 1, 3000, 1000);
run_wc("window 100, packet 33", 100, 33, 20000, 7777);
run_wc("window 65536, packet 16384", 65536, 16384, 1000000, 100000);
run_wc("openssh-like 2MiB window", 2097152, 32768, 5000000, 65536);
run_wc("peer packet larger than ours", 2097152, 262144, 300000, 300000);
checks = check(checks, true, "wc -c over five window/packet shapes (up to 5 MB)");
// 8 MB written to wc -c in 32 KiB writes.
run_wc("8 MB", 2097152, 32768, 8388608, 32768);
checks = check(checks, true, "8 MB written to wc -c");
// cat: the peer echoes while the client is still writing.
Peer pcat = peer(MODE_CAT, [], 262144, 32768, 0);
sshexec.Channel ccat = must_exec(pcat, "cat");
bytes cat_data = payload_of(6000000);
if (write_code(ccat, cat_data) != -1) {
    trap("cat: write failed");
}
if (close_write_code(ccat) != -1) {
    trap("cat: close_write failed");
}
bytes cat_back = must_bytes(ccat.read_all());
checks = check(checks, cat_back.size() == 6000000 && sum_of(cat_back) == sum_of(cat_data) && cat_back == cat_data, "cat: 6 MB written while being echoed comes back intact (no deadlock)");
checks = check(checks, is_exit_status(must_wait(ccat), 0) && !pcat.is_violated, "cat: exit status and no window violation");
// A producer: the client must top up its window to receive 8 MB.
Peer pprod = peer(MODE_PRODUCE, [], 100, 100, 8388608);
sshexec.Channel cprod = must_exec(pprod, "head -c 8388608 /dev/zero");
bytes first = must_bytes(cprod.read(5));
checks = check(checks, first == payload_of(5), "the first bytes of the producer");
bytes rest = must_bytes(cprod.read_all());
checks = check(checks, first.size() + rest.size() == 8388608, "8 MB read from the producer");
bool is_intact = true;
int stream_index = 0;
while (stream_index < rest.size()) {
    if (rest[stream_index] != pattern(5 + stream_index)) {
        is_intact = false;
        break;
    }
    stream_index = stream_index + 1;
}
checks = check(checks, is_intact, "every byte of the 8 MB stream is where it should be");
checks = check(checks, must_bytes(cprod.read_all_error()) == "err\n".to_bytes(), "stderr arrives separately from the producer's stdout");
checks = check(checks, is_exit_status(must_wait(cprod), 3), "the producer's exit status");
// The client topped its window up (it started with 2 MiB and read 8 MB).
checks = check(checks, kind_count(pprod, 93) >= 3, "the client sent WINDOW_ADJUST to receive more than its initial window");
print(checks.to_str() + " checks, 0 failures");
