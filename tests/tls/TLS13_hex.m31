// Hex text to `bytes`, for the TLS 1.3 test harnesses that are handed RFC
// 8448's messages on their command line. Test support only; nothing in `lib/`
// uses it.

int digit_value(int octet) {
    if (octet >= 48 && octet <= 57) {
        return octet - 48;
    }
    if (octet >= 97 && octet <= 102) {
        return octet - 87;
    }
    if (octet >= 65 && octet <= 70) {
        return octet - 55;
    }
    trap("TLS13_hex: not a hex digit");
}

/// The octets `text` spells, two hex digits to an octet, either case.
/// Traps on an odd length or a character that is not a hex digit.
pub bytes decode(str text) {
    bytes digits = text.to_bytes();
    if (digits.size() % 2 != 0) {
        trap("TLS13_hex: odd number of hex digits");
    }
    bytes out = [];
    for (int i in 0 .. digits.size() / 2) {
        out.push(digit_value(digits[2 * i]) * 16 + digit_value(digits[2 * i + 1]));
    }
    return out;
}
