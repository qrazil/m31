// `Option<int>` returned from a function called 50 million times.
//
// The A/B partner is `option-boxed.m31`, which is this file plus one line.
// See `bench/value-enums.md`.

Option<int> half(int number) {
    if (number % 2 == 0) {
        return Option<int>.Some(number / 2);
    }
    return Option<int>.None;
}

int total = 0;
int index = 0;
while (index < 50000000) {
    match (half(index)) {
        case Some(int halved): {
            total = total + halved;
        }
        case None: {
        }
    }
    index = index + 1;
}
print(total);
