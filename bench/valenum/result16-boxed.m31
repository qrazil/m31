// `result16.m31` with `Error` forced back onto the heap. See `result-boxed.m31`.
//
// `result16.m31` with an `Error` that carries nothing, so the `Result` is 16
// bytes instead of 32 -- the System V boundary between "returned in two
// registers" and "returned through a hidden pointer into the caller's stack".
//
// Everything else about the loop is the same, so the gap between this and
// `result.m31` is that boundary and nothing else. It is the reason a `Result`
// whose error type is rich is still not free: see `bench/value-enums.md`.

enum Error {
    Truncated;
    BadCode;
}

List<Error> sink = [];

Result<int, Error> take(int number) {
    if (number % 1024 == 1023) {
        return Result<int, Error>.Err(Error.Truncated);
    }
    return Result<int, Error>.Ok(number & 15);
}

int total = 0;
int bad = 0;
int index = 0;
while (index < 50000000) {
    match (take(index)) {
        case Ok(int value): {
            total = total + value;
        }
        case Err(Error error): {
            bad = bad + 1;
        }
    }
    index = index + 1;
}
print(total);
print(bad);
print(sink.size());
