// `Result<int, Error>` returned from a function called 50 million times,
// with `Error` a value enum of its own -- the shape `apps/git/zlib.m31`'s bit
// reader wanted and could not afford.
//
// The A/B partner is `result-boxed.m31`.

enum Error {
    Truncated(int);
    BadCode(int, int);
}

Result<int, Error> take(int number) {
    if (number % 1024 == 1023) {
        return Result<int, Error>.Err(Error.Truncated(number));
    }
    return Result<int, Error>.Ok(number & 15);
}

int total = 0;
int bad = 0;
int index = 0;
while (index < 50000000) {
    match (take(index)) {
        case Ok(int value): {
            total = total + value;
        }
        case Err(Error error): {
            bad = bad + 1;
        }
    }
    index = index + 1;
}
print(total);
print(bad);
