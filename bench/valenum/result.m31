// `Result<int, Error>` returned from a function called 50 million times,
// with `Error` a value enum of its own -- the shape `apps/git/zlib.m31`'s bit
// reader wanted and could not afford.
//
// The A/B partner is `result-boxed.m31`.

enum Error {
    Truncated(int);
    BadCode(int, int);
}

Result<int, Error> take(int n) {
    if (n % 1024 == 1023) {
        return Result<int, Error>.Err(Error.Truncated(n));
    }
    return Result<int, Error>.Ok(n & 15);
}

int total = 0;
int bad = 0;
int i = 0;
while (i < 50000000) {
    match (take(i)) {
        case Ok(int v): {
            total = total + v;
        }
        case Err(Error e): {
            bad = bad + 1;
        }
    }
    i = i + 1;
}
print(total);
print(bad);
