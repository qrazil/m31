// `Option<int>` returned from a function called 50 million times.
//
// The A/B partner is `option-boxed.src`, which is this file plus one line.
// See `bench/value-enums.md`.

Option<int> half(int n) {
    if (n % 2 == 0) {
        return Option<int>.Some(n / 2);
    }
    return Option<int>.None;
}

int total = 0;
int i = 0;
while (i < 50000000) {
    match (half(i)) {
        case Some(int h): {
            total = total + h;
        }
        case None: {
        }
    }
    i = i + 1;
}
print(total);
