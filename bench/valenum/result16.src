// `result.src` with an `Error` that carries nothing, so the `Result` is 16
// bytes instead of 32 -- the System V boundary between "returned in two
// registers" and "returned through a hidden pointer into the caller's stack".
//
// Everything else about the loop is the same, so the gap between this and
// `result.src` is that boundary and nothing else. It is the reason a `Result`
// whose error type is rich is still not free: see `bench/value-enums.md`.

enum Error {
    Truncated;
    BadCode;
}

Result<int, Error> take(int n) {
    if (n % 1024 == 1023) {
        return Result<int, Error>.Err(Error.Truncated);
    }
    return Result<int, Error>.Ok(n & 15);
}

int total = 0;
int bad = 0;
int i = 0;
while (i < 50000000) {
    match (take(i)) {
        case Ok(int v): {
            total = total + v;
        }
        case Err(Error e): {
            bad = bad + 1;
        }
    }
    i = i + 1;
}
print(total);
print(bad);
