// `result.m31`, with one line added: a `List<Error>` the program never
// touches, which takes `Error` back to being a heap object -- and with it
// `Result<int, Error>`, whose payload would otherwise have to hold an object
// in a machine-word slot. Two allocations per call instead of none.

enum Error {
    Truncated(int);
    BadCode(int, int);
}

List<Error> sink = [];

Result<int, Error> take(int number) {
    if (number % 1024 == 1023) {
        return Result<int, Error>.Err(Error.Truncated(number));
    }
    return Result<int, Error>.Ok(number & 15);
}

int total = 0;
int bad = 0;
int index = 0;
while (index < 50000000) {
    match (take(index)) {
        case Ok(int value): {
            total = total + value;
        }
        case Err(Error error): {
            bad = bad + 1;
        }
    }
    index = index + 1;
}
print(total);
print(bad);
print(sink.size());
