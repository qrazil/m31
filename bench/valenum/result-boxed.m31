// `result.m31`, with one line added: a `List<Error>` the program never
// touches, which takes `Error` back to being a heap object -- and with it
// `Result<int, Error>`, whose payload would otherwise have to hold an object
// in a machine-word slot. Two allocations per call instead of none.

enum Error {
    Truncated(int);
    BadCode(int, int);
}

List<Error> sink = [];

Result<int, Error> take(int n) {
    if (n % 1024 == 1023) {
        return Result<int, Error>.Err(Error.Truncated(n));
    }
    return Result<int, Error>.Ok(n & 15);
}

int total = 0;
int bad = 0;
int i = 0;
while (i < 50000000) {
    match (take(i)) {
        case Ok(int v): {
            total = total + v;
        }
        case Err(Error e): {
            bad = bad + 1;
        }
    }
    i = i + 1;
}
print(total);
print(bad);
print(sink.size());
