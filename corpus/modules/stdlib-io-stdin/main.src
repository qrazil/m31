import io;

// Standard input, lines and octets, through ONE `io.File`. main.in beside
// this file is binary on purpose:
//
//   alpha\n  beta\r\n  \n  \xff\xfe\n  gamma\n  (300 z)\r\n  \0\xff\n  tail
//
// There is one line reader, `io.read_line_of`, and it reads through the
// stream's own buffer -- so the `File` has to be made once and kept. A
// second `io.stdin()` would be a second buffer, holding input the first
// never sees. That is also why the octet reads further down carry on exactly
// where the lines stopped: it is the same buffer.
str show(Result<Option<str>, io.Error> l) {
    match (l) {
        case Ok(Option<str> o): {
            match (o) {
                case Some(str s): {
                    return "[" + s + "]";
                }
                case None: {
                    return "none";
                }
            }
        }
        case Err(io.Error e): {
            return "<" + e.to_str() + ">";
        }
    }
}

io.File input = io.stdin();
print(show(io.read_line_of(input, 4096)));  // [alpha]
print(show(io.read_line_of(input, 4096)));  // [beta] -- the \r goes with the \n
print(show(io.read_line_of(input, 4096)));  // [] -- an empty line is a line, not the end
// \xff\xfe is not UTF-8. A Result says so, where the removed `io.read_line`
// could only answer None -- and the next call goes on after it, not stuck on
// it, because the line was consumed either way.
print(show(io.read_line_of(input, 4096)));  // <not valid UTF-8 text>
print(show(io.read_line_of(input, 4096)));  // [gamma]
// A long line, well inside the limit, ending in \r\n: the ending still comes
// off whole.
match (io.read_line_of(input, 4096)) {
    case Ok(Option<str> o): {
        match (o) {
            case Some(str s): {
                print(s.size());  // 300
                print(s == "z".repeat(300));  // true
            }
            case None: {
                print("none");
            }
        }
    }
    case Err(io.Error e): {
        print(e.to_str());
    }
}
// The rest as octets, off the same buffered `File`: `read_until` picks up
// exactly where the last line ended.
bytes nl = "\n".to_bytes();
match (input.read_until(nl, 100)) {
    case Ok(bytes b): {
        print(b.hex());  // 00ff0a -- a NUL and 0xff come through untouched
    }
    case Err(io.Error e): {
        print(e.to_str());
    }
}
match (input.read_all()) {
    case Ok(bytes b): {
        print(b.utf8().or("?"));  // tail -- the last line, with no newline
    }
    case Err(io.Error e): {
        print(e.to_str());
    }
}
match (input.read(1)) {
    case Ok(bytes b): {
        print(b.size());  // 0
    }
    case Err(io.Error e): {
        print(e.to_str());
    }
}
print(show(io.read_line_of(input, 4096)));  // none -- the end
