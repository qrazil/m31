import os;

// The command line is `main.args`, one argument per line. argv[0] is the
// path the binary was run as, which differs between run.sh and the gates, so
// only its presence is printed.
//
// os.arguments() is a plain list: an argument that is not UTF-8 traps and names
// arguments_bytes, which is Rust's trade. Every argument here is text.
List<str> argv = os.arguments();
print(argv.size());  // 5: the program, then four arguments
print(argv[0].size() > 0);  // true
print(argv[1]);  // -serve
print(argv[2]);  // --port
print(argv[3]);  // two words -- one argument, spaces and all
print(argv[4].size());  // 0 -- an empty argument is still an argument
// A fresh list every call: changing one copy changes nothing else.
argv.push("extra");
print(os.arguments_bytes().size());  // 5
// The same arguments as octets, whether or not they are text.
print(os.arguments_bytes()[1].hex());  // 2d7365727665 -- "-serve"
// An unset variable is None, and so is a name that could never be one.
print(os.env("LANG_CORPUS_SURELY_NOT_SET").is_none());  // true
print(os.env("").is_none());  // true
print(os.env("A=B").is_none());  // true
print(os.env_bytes("LANG_CORPUS_SURELY_NOT_SET").is_none());  // true
// Every variable that is text, as a map: PATH is in it, a name that could
// never be a variable is not.
print(os.env_map().contains("PATH"));  // true
print(os.env_map().contains("LANG_CORPUS_SURELY_NOT_SET"));  // false
print(os.env_map().get("PATH").is_some());  // true
// PATH is set in any environment that can run this corpus.
match (os.env("PATH")) {
    case Some(str p): {
        print(p.size() > 0);
    }  // true
    case None: {
        print("PATH is not set");
    }
}
