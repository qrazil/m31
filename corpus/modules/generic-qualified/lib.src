pub enum Maybe<T> {
    Nothing;
    Just(T);
}

pub type Pair<A, B> {
    A a;
    B b;
}

pub Maybe<T> just<T>(T v) {
    return Maybe<T>.Just(v);
}

pub T or_else<T>(Maybe<T> m, T d) {
    match (m) {
        case Nothing: {
            return d;
        }
        case Just(T v): {
            return v;
        }
    }
}

pub Pair<A, B> pair<A, B>(A a, B b) {
    return Pair<A, B>(a, b);
}

pub T first<T>(List<T> xs) {
    return xs[0];
}

pub int count<K, V>(Map<K, V> m) {
    return m.size();
}

// Reached only through `lib.twice`: a generic function calling a private
// generic helper of its own module, instantiated from another module.
T echo<T>(T v) {
    return v;
}

pub List<T> twice<T>(T v) {
    return [echo(v), echo(v)];
}
