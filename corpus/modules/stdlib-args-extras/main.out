usage: tool [options] -<command> [...]

do a thing

commands:
  -s, -serve                run the server
      -init                 create the files

options:
       --help               show this help
       --version            print the version and exit
  --o, --out PATH           where to write
  --p, --port PORT          the port
       --jobs JOBS          how many
  --q, --quiet
       --completions SHELL  print a shell completion script (bash, zsh or fish) and exit

exit status: 0 ok, 1 failure, 2 usage
---- version
tool 1.2.3
tool 1.2.3
unknown option '--version'
---- ranges
in range -> ok
too high -> error: '--port' needs a whole number from 1 to 65535, and got '70000'
too low -> error: '--port' needs a whole number from 1 to 65535, and got '0'
only a minimum -> error: '--jobs' needs a whole number of at least 1, and got '0'
not a number -> error: '--port' needs a whole number, and got 'x'
---- suggestions by edit distance
swapped -> error: unknown option '--prot' -- did you mean '--port'?
one letter off -> error: unknown option '--quite' -- did you mean '--quiet'?
a prefix -> error: unknown option '--qui' -- did you mean '--quiet'?
far off -> error: unknown option '--frobnicate'
a command -> error: unknown command '-sreve' -- did you mean '-serve'?
a command, far -> error: unknown command '-zzzzz' -- one of -serve, -init
---- completions
# bash completion for tool (generated by `tool --completions bash`)
_tool_complete() {
    local cur prev word command
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    command=""
    for word in "${COMP_WORDS[@]:1:COMP_CWORD-1}"; do
        case "$word" in
            -serve|-s) command=serve ;;
            -init) command=init ;;
        esac
    done
    case "$command:$prev" in
        :--out) COMPREPLY=($(compgen -f -- "$cur")); return ;;
        :--port) return ;;
        :--jobs) return ;;
        :--completions) return ;;
        serve:--host) return ;;
    esac
    if [[ "$cur" == -* ]]; then
        case "$command" in
            serve) COMPREPLY=($(compgen -W "--host --verbose --help -serve -s -init" -- "$cur")) ;;
            init) COMPREPLY=($(compgen -W "--help -serve -s -init" -- "$cur")) ;;
            *) COMPREPLY=($(compgen -W "-serve -s -init --out --o --port --p --jobs --quiet --q --completions --help --version" -- "$cur")) ;;
        esac
    else
        COMPREPLY=($(compgen -f -- "$cur"))
    fi
}
complete -o filenames -F _tool_complete tool
# fish completion for tool (generated by `tool --completions fish`)
complete -c tool -o serve -d 'run the server'
complete -c tool -o s -d 'run the server'
complete -c tool -o init -d 'create the files'
complete -c tool -l out -r -F -d 'where to write'
complete -c tool -l o -x -d 'where to write'
complete -c tool -l port -x -d 'the port'
complete -c tool -l p -x -d 'the port'
complete -c tool -l jobs -x -d 'how many'
complete -c tool -l quiet -d ''
complete -c tool -l q -d ''
complete -c tool -l completions -x -d 'print a shell completion script (bash, zsh or fish) and exit'
complete -c tool -l help -d 'show this help'
complete -c tool -l version -d 'print the version and exit'
complete -c tool -n '__fish_seen_argument -o serve' -l host -x -d 'bind here'
complete -c tool -n '__fish_seen_argument -o serve' -l verbose -d ''
#compdef tool
# zsh completion for tool (generated by `tool --completions zsh`)
_tool() {
    local -a choices
    local word command=""
    for word in ${words[2,CURRENT-1]}; do [[ $word == -serve ]] && command=serve; done
    for word in ${words[2,CURRENT-1]}; do [[ $word == -init ]] && command=init; done
    if [[ $PREFIX == -* ]]; then
        case $command in
            serve) choices=('-serve:run the server' '-init:create the files' '--host:bind here' '--verbose:' '--help:show this help') ;;
            init) choices=('-serve:run the server' '-init:create the files' '--help:show this help') ;;
            *) choices=('-serve:run the server' '-init:create the files' '--out:where to write' '--o:where to write' '--port:the port' '--p:the port' '--jobs:how many' '--quiet:' '--q:' '--completions:print a shell completion script (bash, zsh or fish) and exit' '--help:show this help' '--version:print the version and exit') ;;
        esac
        _describe 'option' choices
    else
        _files
    fi
}
compdef _tool tool
a shell it does not know -> error: '--completions' needs bash, zsh or fish, and got 'csh'
no shell -> error: '--completions' needs a value and is the last argument
true
