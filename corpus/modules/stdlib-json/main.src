import json;

// JSON, RFC 8259. Every document that parses is written back compact, and
// the expected text is CPython's `json.loads` then `json.dumps` with sorted
// keys, compact separators and no ASCII escaping -- except floats, which are
// spelled the way this language's `to_str` spells them, plus `.0` for a whole
// number. The error messages are Oro's, with byte positions.
void round(str text) {
    match (json.parse(text)) {
        case Ok(json.Value v): {
            match (json.stringify(v)) {
                case Ok(str s): {
                    print(s);
                }
                case Err(json.Error e): {
                    print("stringify error: " + json.message(e));
                }
            }
        }
        case Err(json.Error e): {
            print("error: " + json.message(e));
        }
    }
}

void pretty(str text, int indent) {
    match (json.parse(text)) {
        case Ok(json.Value v): {
            match (json.stringify(v, indent: indent)) {
                case Ok(str s): {
                    print(s);
                }
                case Err(json.Error e): {
                    print("stringify error: " + json.message(e));
                }
            }
        }
        case Err(json.Error e): {
            print("error: " + json.message(e));
        }
    }
}

void written(json.Value v) {
    match (json.stringify(v)) {
        case Ok(str s): {
            print(s);
        }
        case Err(json.Error e): {
            print("stringify error: " + json.message(e));
        }
    }
}

round("{\"a\": [1, 2.5, true, null]}");
round("{\"b\": 1, \"a\": {\"z\": [], \"y\": {}}, \"c\": \"x\"}");
round("[0, -0, 1.0, -1.5e3, 1e-400, 123456789012345678, 0.1, 1e16, 1e17, 2.5e-5, 1E2, 1e+2]");
round("[9223372036854775807, -9223372036854775808, 0.30000000000000004, 5e-324]");
round("\"a\\\"b\\\\c\\/d\\n\\r\\t\"");
round("\"\\u00e9\\u65E5\\ud83d\\ude00 \\u0041\\u0000\"");
round("\"é日😀\"");
round(" \t\n\r[ 1 , 2 ]\r\n");
round("{\"a\":1,\"a\":2}");
round("\"x\"");
round("42");
round("true");
round("false");
round("null");
round("[[[[]]], {}, [{}], \"\"]");
round("{\"k\": {\"deep\": [1, [2, [3, {\"x\": null}]]]}}");
// The escapes stringify writes are the ones CPython writes.
round("\"\\u0000 \\n \\r \\t \\\" \\\\ \\/\"");
pretty("{\"b\": [1, 2, {\"c\": null}], \"a\": {}, \"d\": []}", 2);
pretty("[1, [2, []], {\"x\": \"y\"}]", 4);
pretty("7", 2);
pretty("[]", 2);
// A float too large for a double is an infinity, as in CPython -- and then
// has no JSON spelling to be written back as.
round("[1E400]");
round("-1e400");
// Every refusal, and where it points.
round("{");
round("[1,]");
round("[1 2]");
round("{\"a\" 1}");
round("{\"a\":1,}");
round("{1:2}");
round("[1");
round("{\"a\":1");
round("\"abc");
round("\"a\\u00\"");
round("\"\\u12G4\"");
round("\"\\x\"");
round("\"\\");
round("\"\\ud800\"");
round("\"\\ud800\\u0041\"");
round("\"\\ud800\\uzzzz\"");
round("\"\\udc00\"");
round("\"a\tb\"");
round("01");
round("-");
round("-a");
round("1.");
round("1.e5");
round("1e");
round("1.5e+");
round(".5");
round("+1");
round("tru");
round("nul");
round("[1] x");
round("");
round("   ");
round("NaN");
round("'a'");
round("[é]");
round("99999999999999999999");
round("-9223372036854775809");
round("[1, 2] // comment");
// Raw bytes in a string must be UTF-8: a lone lead byte, and an encoded
// surrogate (ED A0 80), are both refused.
round("\"" + "é".substr(0, 1) + "\"");
round("[\"ok\", \"" + "퀀".substr(0, 1) + "렀".substr(1, 3) + "\"]");
// Escapes whose UTF-8 needs any octet at all: the control characters, which
// are escaped again on the way out, U+0301 (CC 81), U+E000 (EE 80 80) and
// U+50000 (F1 90 80 80), which are written through.
round("\"\\b\"");
round("\"ab\\f\"");
round("\"\\u0301\"");
round("\"\\u0001\"");
round("\"\\ue000\"");
round("\"\\ud900\\udc00\"");
// Nesting: 10 000 levels are fine, the next one is not, and an empty
// innermost container does not count as a level.
str opens = "[".repeat(10000);
str closes = "]".repeat(10000);
match (json.parse(opens + closes)) {
    case Ok(json.Value v): {
        match (json.stringify(v)) {
            case Ok(str s): {
                print(s == opens + closes);
            }
            case Err(json.Error e): {
                print(json.message(e));
            }
        }
    }
    case Err(json.Error e): {
        print(json.message(e));
    }
}
round("[" + opens + "1" + closes + "]");
match (json.parse(opens + "[]" + closes)) {
    case Ok(json.Value v): {
        print("10001 with an empty innermost: ok");
    }
    case Err(json.Error e): {
        print(json.message(e));
    }
}
round("[ " + opens + "1" + closes + "]");
// stringify refuses what JSON cannot spell.
float zero = 0.0;
written(json.Value.Float(zero / zero));
written(json.Value.Float(1.0 / zero));
written(json.Value.Array([json.Value.Float(-1.0 / zero)]));
written(json.Value.Str("ok " + "é".substr(0, 1)));
written(json.Value.Object({"é".substr(0, 1): json.Value.Null}));
written(json.Value.Float(3.0));
written(json.Value.Float(-0.0));
written(json.Value.Float(1.0e300));
// A value that contains itself is stopped by the depth bound, not the stack.
List<json.Value> items = [];
json.Value loop = json.Value.Array(items);
items.push(loop);
written(loop);
items.clear();
// A parsed document is an ordinary enum to take apart.
match (json.parse("{\"name\": \"lang\", \"tags\": [\"a\", \"b\"], \"n\": 3}")) {
    case Ok(json.Value v): {
        match (v) {
            case Object(Map<str, json.Value> m): {
                match (m.get("tags")) {
                    case Some(json.Value t): {
                        match (t) {
                            case Array(List<json.Value> xs): {
                                print(xs.size());
                            }
                            case Null: {
                                print("null");
                            }
                            case Bool(bool b): {
                                print(b);
                            }
                            case Int(int i): {
                                print(i);
                            }
                            case Float(float f): {
                                print(f.to_str());
                            }
                            case Str(str s): {
                                print(s);
                            }
                            case Object(Map<str, json.Value> o): {
                                print(o.size());
                            }
                        }
                    }
                    case None: {
                        print("no tags");
                    }
                }
            }
            case Null: {
                print("null");
            }
            case Bool(bool b): {
                print(b);
            }
            case Int(int i): {
                print(i);
            }
            case Float(float f): {
                print(f.to_str());
            }
            case Str(str s): {
                print(s);
            }
            case Array(List<json.Value> xs): {
                print(xs.size());
            }
        }
    }
    case Err(json.Error e): {
        print(json.message(e));
    }
}
