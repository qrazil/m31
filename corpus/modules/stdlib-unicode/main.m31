// unicode.upper, unicode.lower and unicode.fold, against Python.
//
// Every expected line in main.out is what CPython's str.upper(), str.lower()
// and str.casefold() print for the same input -- generated, not recorded, so
// the file is an oracle rather than a copy of what this module did. The one
// thing Python is not asked is `str.to_upper`, the language's ASCII-only
// method, which is here to show the division: it leaves every non-ASCII
// character alone (docs/text-decision.md §7).

import unicode;

print(unicode.VERSION);
print("");
print("empty");
print("  in    " + "");
print("  upper " + unicode.upper(""));
print("  lower " + unicode.lower(""));
print("  fold  " + unicode.fold(""));
print("  ascii " + "".to_upper() + " " + "".to_lower());
print("");
print("ascii");
print("  in    " + "Hello, World! 42");
print("  upper " + unicode.upper("Hello, World! 42"));
print("  lower " + unicode.lower("Hello, World! 42"));
print("  fold  " + unicode.fold("Hello, World! 42"));
print("  ascii " + "Hello, World! 42".to_upper() + " " + "Hello, World! 42".to_lower());
print("");
print("ascii upper");
print("  in    " + "SHOUTING");
print("  upper " + unicode.upper("SHOUTING"));
print("  lower " + unicode.lower("SHOUTING"));
print("  fold  " + unicode.fold("SHOUTING"));
print("  ascii " + "SHOUTING".to_upper() + " " + "SHOUTING".to_lower());
print("");
print("latin-1");
print("  in    " + "\u{e9}cole");
print("  upper " + unicode.upper("\u{e9}cole"));
print("  lower " + unicode.lower("\u{e9}cole"));
print("  fold  " + unicode.fold("\u{e9}cole"));
print("  ascii " + "\u{e9}cole".to_upper() + " " + "\u{e9}cole".to_lower());
print("");
print("latin-1 upper");
print("  in    " + "\u{c9}COLE");
