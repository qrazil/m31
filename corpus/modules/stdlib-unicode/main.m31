print("  lower " + unicode.lower("\u{c9}COLE"));
print("  fold  " + unicode.fold("\u{c9}COLE"));
print("  ascii " + "\u{c9}COLE".to_upper() + " " + "\u{c9}COLE".to_lower());
print("");
print("accents");
print("  in    " + "\u{c6}r\u{f8} \u{c5}ngstr\u{f6}m na\u{ef}ve");
print("  upper " + unicode.upper("\u{c6}r\u{f8} \u{c5}ngstr\u{f6}m na\u{ef}ve"));
print("  lower " + unicode.lower("\u{c6}r\u{f8} \u{c5}ngstr\u{f6}m na\u{ef}ve"));
print("  fold  " + unicode.fold("\u{c6}r\u{f8} \u{c5}ngstr\u{f6}m na\u{ef}ve"));
print("  ascii " + "\u{c6}r\u{f8} \u{c5}ngstr\u{f6}m na\u{ef}ve".to_upper() + " " + "\u{c6}r\u{f8} \u{c5}ngstr\u{f6}m na\u{ef}ve".to_lower());
print("");
print("sharp s");
print("  in    " + "stra\u{df}e");
print("  upper " + unicode.upper("stra\u{df}e"));
print("  lower " + unicode.lower("stra\u{df}e"));
print("  fold  " + unicode.fold("stra\u{df}e"));
print("  ascii " + "stra\u{df}e".to_upper() + " " + "stra\u{df}e".to_lower());
print("");
print("sharp s upper");
print("  in    " + "STRASSE");
print("  upper " + unicode.upper("STRASSE"));
print("  lower " + unicode.lower("STRASSE"));
print("  fold  " + unicode.fold("STRASSE"));
print("  ascii " + "STRASSE".to_upper() + " " + "STRASSE".to_lower());
print("");
