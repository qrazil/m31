print("caseless pairs");
print("  " + (unicode.fold("Stra\u{df}e") == unicode.fold("STRASSE")).to_str() + " " + ("Stra\u{df}e" == "STRASSE").to_str());
print("  " + (unicode.fold("\u{3a3}\u{38a}\u{3a3}\u{3a5}\u{3a6}\u{39f}\u{3a3}") == unicode.fold("\u{3c3}\u{3af}\u{3c3}\u{3c5}\u{3c6}\u{3bf}\u{3c2}")).to_str() + " " + ("\u{3a3}\u{38a}\u{3a3}\u{3a5}\u{3a6}\u{39f}\u{3a3}" == "\u{3c3}\u{3af}\u{3c3}\u{3c5}\u{3c6}\u{3bf}\u{3c2}").to_str());
print("  " + (unicode.fold("\u{130}") == unicode.fold("i\u{307}")).to_str() + " " + ("\u{130}" == "i\u{307}").to_str());
print("  " + (unicode.fold("Hello") == unicode.fold("hELLO")).to_str() + " " + ("Hello" == "hELLO").to_str());
print("  " + (unicode.fold("\u{e9}") == unicode.fold("e\u{301}")).to_str() + " " + ("\u{e9}" == "e\u{301}").to_str());
print("  " + (unicode.fold("\u{1c5}") == unicode.fold("\u{1c6}")).to_str() + " " + ("\u{1c5}" == "\u{1c6}").to_str());
