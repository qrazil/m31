// unicode.nfc and unicode.nfd, against the Unicode conformance test.
//
// The named cases are read by a person. The rest is NormalizationTest.txt:
// every case of Part0, Part3 and Part5, and a sample of the three parts that
// repeat themselves -- one case per character (Part1), one per permutation of
// combining classes (Part2), one per canonical closure (Part4). Each case gives
// two sources, its first column (whose NFC is the second column and whose
// NFD is the third) and its fourth (whose NFC is itself and whose NFD is the
// fifth); main.out holds those forms. All 19,965 cases were run against this
// module while it was written.
//
// The cases are a constant in the program -- a length and that many code
// points, one after another -- rather than a file read at run time: a corpus
// case that needs no input cannot disagree with the runner about where its
// input comes from.

import text.unicode;

/// A string's code points in decimal.
str show(str s) {
    List<str> cps = [];
    for (int c in s.chars()) {
        cps.push(c.to_str());
    }
    return cps.join(" ");
}

/// Both forms of one case, on one line.
str forms(str s) {
    return "nfc " + show(unicode.nfc(s)) + " | nfd " + show(unicode.nfd(s));
}

print("e + combining acute: " + forms("e\u{301}"));
print("precomposed e acute: " + forms("\u{e9}"));
print("angstrom sign: " + forms("\u{212b}"));
print("a + ring above: " + forms("a\u{30a}"));
print("two marks, wrong order: " + forms("q\u{307}\u{323}"));
print("hangul syllable: " + forms("\u{d55c}"));
print("hangul jamo: " + forms("\u{1100}\u{1161}\u{11ab}"));
print("greek with iota subscript: " + forms("\u{1fa7}"));
print("vietnamese: " + forms("Ti\u{1ebf}ng Vi\u{1ec7}t"));
print("ligature is not canonical: " + forms("\u{fb01}"));
print("ascii: " + forms("plain text"));
print("empty: " + forms(""));
print("cjk: " + forms("\u{6f22}\u{5b57}"));
print("emoji: " + forms("\u{1f44d}\u{1f3fd}"));
print("singleton: " + forms("\u{2126}"));
print("excluded from composition: " + forms("\u{958}"));
print("composition exclusion, decomposed: " + forms("\u{915}\u{93c}"));
// The conformance cases: a length, then that many code points.
int at = 0;
while (at < CASES.size()) {
    int n = CASES[at];
    List<int> cps = [];
    int i = 0;
    while (i < n) {
        cps.push(CASES[at + 1 + i]);
        i = i + 1;
    }
    at = at + 1 + n;
    print(forms(str.from_chars(cps)));
}

