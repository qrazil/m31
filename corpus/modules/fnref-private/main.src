// A private function of another module is not a value here either. Naming it
// is refused on the same terms as calling it: privacy is about the name, and
// a function's name used as a value is still its name.
import lib;
interface Less { int cmp(lib.Point a, lib.Point b); }
Less l = lib.by_y;
print(l.cmp(lib.Point(1, 2), lib.Point(3, 4)));
