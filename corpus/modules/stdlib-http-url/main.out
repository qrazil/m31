quote(/a b/c, safe: '/') = /a%20b/c
quote(/a b/c, safe: '') = %2Fa%20b%2Fc
quote(a&b=c, safe: '') = a%26b%3Dc
quote(a&b=c, safe: '&=') = a&b=c
quote(café, safe: '/') = caf%C3%A9
quote(~-._, safe: '/') = ~-._
quote(100%, safe: '') = 100%25
unquote(%2Fa%20b, plus: false) = /a b
unquote(a+b, plus: false) = a+b
unquote(a+b, plus: true) = a b
unquote(a%2Bb, plus: true) = a+b
unquote(caf%C3%A9, plus: false) = café
