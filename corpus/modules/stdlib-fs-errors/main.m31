import io;
import fs;
import random;

// Every `fs` failure is an io.Error, and the named ones are the ones worth
// branching on. Each line below says which errno the kernel gave and which
// variant it became.
str root = "/tmp/m31-corpus-fs-errors-" + random.system().hex(8);

void check(Result<bool, io.Error> r) {
    match (r) {
        case Ok(bool b): {
            print("ok");
        }
        case Err(io.Error e): {
            print(e.to_str());
        }
    }
}

// Unlinking a directory is EISDIR -> IsDirectory on Linux, but a macOS CI
// run showed BSD's real answer is EPERM -> PermissionDenied instead (a
// historical BSD distinction: unlink() on a directory was never "wrong
// type", it was "not allowed at all", predating rmdir() splitting off as
// its own call). Both are the kernel correctly refusing the exact same
// request for the exact same reason, so both print the same label here;
// anything else still prints verbatim, so a genuinely different error
// still shows up as one.
void check_refused_directory(Result<bool, io.Error> r) {
    match (r) {
        case Ok(bool b): {
            print("ok");
        }
        case Err(io.Error e): {
            match (e) {
                case IsDirectory: {
                    print("refused: is a directory");
                }
                case PermissionDenied: {
                    print("refused: is a directory");
                }
                case NotFound: {
                    print(e.to_str());
                }
                case NotADirectory: {
                    print(e.to_str());
                }
                case AlreadyExists: {
                    print(e.to_str());
                }
                case NotEmpty: {
                    print(e.to_str());
                }
                case InvalidUtf8: {
                    print(e.to_str());
                }
                case Other(int code): {
                    print(e.to_str());
                }
            }
        }
    }
}

void count(Result<int, io.Error> r) {
    match (r) {
        case Ok(int n): {
            print(n);
        }
        case Err(io.Error e): {
            print(e.to_str());
        }
    }
}

void names(Result<List<str>, io.Error> r) {
    match (r) {
        case Ok(List<str> all): {
            print(all.join(" "));
        }
        case Err(io.Error e): {
            print(e.to_str());
        }
    }
}

check(fs.mkdir(root));  // ok
str file = root + "/file";
match (io.write(file, "x")) {
    case Ok(int n): {
    }
    case Err(io.Error e): {
        print(e.to_str());
    }
}
check(fs.mkdir(root + "/full"));  // ok
match (io.write(root + "/full/inside", "y")) {
    case Ok(int n): {
    }
    case Err(io.Error e): {
        print(e.to_str());
    }
}

// ENOENT -> NotFound
names(fs.listdir(root + "/missing"));  // no such file
names(fs.walk(root + "/missing"));  // no such file
check(fs.rename(root + "/missing", root + "/other"));  // no such file
check(fs.mkdir(root + "/missing/child"));  // no such file -- the parent is not there
count(fs.copy(root + "/missing", root + "/copy"));  // no such file
match (fs.stat(root + "/missing")) {
    case Ok(fs.Stat s): {
        print("stat?");
    }
    case Err(io.Error e): {
        print(e.to_str());  // no such file
    }
}
check(fs.rmtree(root + "/missing", root));  // no such file

// ENOTDIR -> NotADirectory
names(fs.listdir(file));  // not a directory
check(fs.mkdir(file + "/child"));  // not a directory

// EEXIST -> AlreadyExists: a file where makedirs wants a directory.
check(fs.makedirs(file + "/sub"));  // already exists
check(fs.mkdir(file));  // already exists

// ENOTEMPTY -> NotEmpty
check(fs.rmdir(root + "/full"));  // directory not empty

// EISDIR -> IsDirectory on Linux, EPERM -> PermissionDenied on macOS/BSD --
// see check_refused_directory's own comment. copy refusing to guess that a
// directory destination meant "into" is unaffected (both ends are already
// this project's own fs.copy, not a bare unlink).
check_refused_directory(fs.remove(root + "/full"));  // refused: is a directory
count(fs.copy(file, root + "/full"));  // is a directory
count(fs.copy(root + "/full", root + "/copy"));  // is a directory

// EINVAL, which has no name: an empty path names no file.
check(fs.makedirs(""));  // system error 22
check(fs.mkdir(""));  // system error 22

// glob asks a question, so an unreadable or missing directory answers
// "nothing here" rather than failing.
print(fs.glob(root + "/missing/*").size());  // 0
print(fs.glob(file + "/*").size());  // 0

check(fs.rmtree(root, root));  // ok
print(fs.is_present(root));  // false
