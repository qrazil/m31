import base64;

// RFC 4648 base64. The expected output is CPython's `base64` module over the
// same inputs (b64encode / urlsafe_b64encode, and b64decode with
// validate=True for the strict decoder).
void show(Result<bytes, base64.Error> r) {
    match (r) {
        case Ok(bytes b): {
            print("ok " + b.utf8().or("(not UTF-8) " + b.hex()));
        }
        case Err(base64.Error e): {
            print("error: " + e.to_str());
        }
    }
}

// The octets as hex, for those that are not printable text.
void show_hex(Result<bytes, base64.Error> r) {
    match (r) {
        case Ok(bytes b): {
            print("ok " + b.hex());
        }
        case Err(base64.Error e): {
            print("error: " + e.to_str());
        }
    }
}

// Every length modulo 3, including the RFC 4648 §10 test vectors.
List<str> vectors = ["", "f", "fo", "foo", "foob", "fooba", "foobar"];
for (str v in vectors) {
    print(base64.encode(v.to_bytes()));
}
print(base64.encode("user:pass".to_bytes()));
print(base64.encode("é".to_bytes()));
print(base64.encode("日本語のテキスト".to_bytes()));
// The two alphabets differ only in their last two digits.
print(base64.encode("ÿþ?>".to_bytes()));
print(base64.encode("ÿþ?>".to_bytes(), url: true));
print(base64.encode("\0\0\0".to_bytes()));
print(base64.encode("\n\t\r".to_bytes()));
// Decoding reverses it, in either alphabet.
for (str v in vectors) {
    show(base64.decode(base64.encode(v.to_bytes())));
}
show(base64.decode("dXNlcjpwYXNz"));
show(base64.decode("w6k="));
show(base64.decode("5pel5pys6Kqe44Gu44OG44Kt44K544OI"));
show(base64.decode("w7/Dvj8+"));
show(base64.decode("w7_Dvj8-", url: true));
// A decoded NUL is an ordinary byte.
match (base64.decode("AAAA")) {
    case Ok(bytes b): {
        print(b.size());
        print(b == "\0\0\0".to_bytes());
    }
    case Err(base64.Error e): {
        print(e);
    }
}
// CPython's one leniency: unused low bits need not be zero.
show(base64.decode("QQ=="));
show(base64.decode("QR=="));
show(base64.decode("QUI="));
show(base64.decode("QUJ="));
// Every refusal, and where it points.
show(base64.decode("QQ="));
show(base64.decode("QQ=A"));
show(base64.decode("QUJ-"));
show(base64.decode("QUJ_"));
show(base64.decode("QUJ+", url: true));
show(base64.decode("QUJ/", url: true));
show(base64.decode("QU I="));
show(base64.decode("QUJD\n"));
show(base64.decode("QUJDé"));
show(base64.decode("Q==="));
show(base64.decode("===="));
show(base64.decode("QQ==QQ=="));
show(base64.decode("A"));
// A character error is reported before a length error, and a length error
// before a padding one: the first thing wrong, in reading order.
show(base64.decode("Q=!"));
show(base64.decode("Q=="));
// Any octet at all comes back, including ones that are not text: "AQ==" is
// 0x01, "/w==" is 0xFF, and "-_8=" in the URL alphabet is 0xFB 0xFF.
show_hex(base64.decode("AQ=="));
show_hex(base64.decode("QUJD/w=="));
show_hex(base64.decode("-_8=", url: true));
// The error is a value a caller can branch on.
match (base64.decode("QQ=")) {
    case Ok(bytes b): {
        print(b.hex());
    }
    case Err(base64.Error e): {
        match (e) {
            case Length(int n): {
                print("length was " + n.to_str());
            }
            case Character(int at, int c, bool url): {
                print("character");
            }
            case PaddingThenData(int p, int d): {
                print("padding then data");
            }
            case Padding(int count, int at): {
                print("padding");
            }
        }
    }
}
// Round trip over every prefix of a string holding ASCII, Latin-1 letters and
// wider characters, in both alphabets: all 2 * 70 must come back unchanged.
str mixed = "The quick brown fox ÀÁÂÃ ÿþ 日本語 😀 ~!@#$%^&*()_+{}|:<>?";
int same = 0;
int k = 0;
while (k <= mixed.size()) {
    str part = mixed.substr(0, k);
    List<bool> flags = [false, true];
    for (bool u in flags) {
        match (base64.decode(base64.encode(part.to_bytes(), url: u), url: u)) {
            case Ok(bytes back): {
                if (back == part.to_bytes()) {
                    same = same + 1;
                }
            }
            case Err(base64.Error e): {
                print(e);
            }
        }
    }
    k = k + 1;
}
print(same);
print(base64.encode(mixed.to_bytes()));
print(base64.encode(mixed.to_bytes(), url: true));
// Every single byte value, decoded from its own two-character spelling,
// comes back as exactly that byte.
str std = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
int held = 0;
int b = 0;
while (b < 256) {
    str text = std.substr(b >> 2, (b >> 2) + 1) + std.substr((b & 3) << 4, ((b & 3) << 4) + 1) + "==";
    match (base64.decode(text)) {
        case Ok(bytes got): {
            if (got.size() == 1 && got[0] == b) {
                held = held + 1;
            }
        }
        case Err(base64.Error e): {
            print(e.to_str());
        }
    }
    b = b + 1;
}
print(held);
// All 256 octets in one run, in both alphabets, and back.
bytes all = [];
b = 0;
while (b < 256) {
    all.push(b);
    b = b + 1;
}
List<bool> both = [false, true];
for (bool u in both) {
    str text = base64.encode(all, url: u);
    print(text);
    match (base64.decode(text, url: u)) {
        case Ok(bytes back): {
            print(back == all);
        }
        case Err(base64.Error e): {
            print(e.to_str());
        }
    }
}
// A UTF-8 byte-order mark, EF BB BF.
match (base64.decode("77u/")) {
    case Ok(bytes s): {
        print(s.size().to_str() + " " + s[0].to_str() + " " + s[1].to_str() + " " + s[2].to_str());
    }
    case Err(base64.Error e): {
        print(e);
    }
}
