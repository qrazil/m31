import math;

// The standard library is carried inside the compiler: there is no `math.m31`
// beside this file, and `import math` finds it anyway.
print(math.sqrt(9.0));  // 3
print(math.sqrt(2.0));  // 1.4142135623730951
print(math.pow(2.0, 10.0));  // 1024
print(math.floor(2.7));  // 2
print(math.floor(0.0 - 2.7));  // -3 -- towards negative infinity
print(math.ceil(2.1));  // 3
print(math.ceil(0.0 - 2.1));  // -2
print(math.round(2.5));  // 3 -- halves away from zero
print(math.round(0.0 - 2.5));  // -3
print(math.abs(0 - 7));  // 7
print(math.abs(7));  // 7
print(math.min(3, 4));  // 3
print(math.max(3, 4));  // 4
print(math.fabs(0.0 - 1.5));  // 1.5
print(math.fmin(3.5, 4.5));  // 3.5
print(math.fmax(3.5, 4.5));  // 4.5
// A library function is an ordinary function: it composes, and it can be
// passed the result of another one.
print(math.sqrt(math.pow(3.0, 2.0)));  // 3
// A `prim` is not reachable from here. `math.__sqrt(9.0)` is two errors at
// once -- the name is reserved, and it is not `pub`.
float acc = 0.0;
int i = 1;
while (i <= 4) {
    acc = acc + math.sqrt(float(i) * float(i));
    i = i + 1;
}
print(acc);  // 10
// Edges, each checked against C's libm rather than against this compiler.
// There is no exponent notation, so the extremes are built by exact halving
// and doubling: the smallest subnormal, 2^-1074, and the largest float,
// (2 - 2^-52) * 2^1023.
float tiny = 1.0;
int h = 0;
while (h < 1074) {
    tiny = tiny / 2.0;
    h = h + 1;
}
// (2 - 2^-52), then 1023 exact doublings.
float most = 2.0 - 1.0 / 4503599627370496.0;
h = 0;
while (h < 1023) {
    most = most * 2.0;
    h = h + 1;
}
print(math.trunc(0.0 - 2.7));  // -2
print(math.trunc(0.0 - 0.5));  // -0 -- the sign of a zero survives
print(math.floor(-0.0));  // -0
print(math.ceil(0.0 - 0.5));  // -0
print(math.round(0.49999999999999994));  // 0 -- not floor(x + 0.5), which gives 1
print(math.round(4503599627370497.0));  // 4503599627370497 -- already whole
print(math.sqrt(0.0 - 1.0));  // nan
print(math.sqrt(math.inf()));  // inf
print(math.sqrt(tiny));  // 2.2227587494850775e-162 -- subnormal input
print(math.sqrt(most));  // 1.3407807929942596e+154
print(math.exp(0.0));  // 1
print(math.exp(1000.0));  // inf
print(math.exp(0.0 - 1000.0));  // 0
print(math.log(1.0));  // 0
print(math.log(0.0));  // -inf
print(math.log(0.0 - 1.0));  // nan
print(math.pow(0.0 - 8.0, 3.0));  // -512
print(math.pow(0.0 - 8.0, 0.5));  // nan -- a fractional power of a negative
print(math.pow(2.0, 0.0 - 1074.0));  // 5e-324
print(math.pow(10.0, 308.0));  // 1e+308
print(tiny);  // 5e-324
print(most);  // 1.7976931348623157e+308
print(math.pow(2.0, math.inf()));  // inf
print(math.pow(0.5, math.inf()));  // 0
print(math.is_nan(math.nan()));  // true
print(math.is_finite(math.inf()));
// false
