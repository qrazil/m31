// Types another module constructs by their qualified names.
pub type Point { pub int x; pub int y; }
pub int Point.sum() { return x + y; }

// Optional fields are named at the construction site, qualified or not.
pub type Opts { pub int size; pub str name = "anon"; pub bool loud = false; }

pub type Box<T> { pub T item; }

pub enum Colour { Red; Green; }
pub enum Shape { Circle(int); Square(int, int); }
pub enum Res<T> { Ok(T); Fail(str); }

pub distinct List<int> Bag;
