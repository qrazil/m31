// unicode.graphemes and unicode.grapheme_count, against UAX #29.
//
// The second half of this program is the Unicode Character Database's own
// conformance test, auxiliary/GraphemeBreakTest.txt: all 1,093 of its cases
// are in the constant below -- each one a length and that many code points --
// and the expected split in main.out is the one the file marks with division
// signs. The cases are data in the program rather than a file it reads
// because a corpus case is one directory and a test that needs no input
// cannot disagree with the runner about where its input comes from.
//
// Nothing here was written by hand except the named cases, and each of those
// is written as the clusters it must come out as, so the spelling of the
// case is the expectation.
//
// A cluster is printed as its code points in decimal, and clusters are
// separated by `/`, so a failure says where a boundary moved.

import unicode;

/// The clusters of `s`, as decimal code points with `/` between clusters.
str split(str s) {
    List<str> parts = [];
    for (str g in unicode.graphemes(s)) {
        List<str> cps = [];
        for (int c in g.chars()) {
            cps.push(c.to_str());
        }
        parts.push(cps.join(" "));
    }
    return parts.join(" / ");
}

/// A case: the count, then the split, so both entry points are checked.
str line(str s) {
    return unicode.grapheme_count(s).to_str() + ": " + split(s);
}

print("empty -> " + line(""));
print("ascii -> " + line("abc"));
print("combining acute -> " + line("e\u{301}"));
print("two combining -> " + line("a\u{301}\u{328}b"));
print("crlf -> " + line("\u{d}\u{a}"));
print("lf cr -> " + line("\u{a}\u{d}"));
print("cr a -> " + line("\u{d}a"));
print("tab -> " + line("\u{9}a"));
print("cjk -> " + line("\u{6f22}\u{5b57}"));
print("hangul syllable -> " + line("\u{d55c}\u{ae00}"));
print("hangul jamo -> " + line("\u{1100}\u{1161}\u{11a8}"));
print("thumbs up -> " + line("\u{1f44d}"));
print("skin tone -> " + line("\u{1f44d}\u{1f3fd}"));
print("flag -> " + line("\u{1f1ec}\u{1f1e7}"));
print("two flags -> " + line("\u{1f1ec}\u{1f1e7}\u{1f1eb}\u{1f1f7}"));
print("three regional indicators -> " + line("\u{1f1ec}\u{1f1e7}\u{1f1eb}"));
print("zwj family -> " + line("\u{1f468}\u{200d}\u{1f469}\u{200d}\u{1f467}"));
print("zwj couple with tones -> " + line("\u{1f469}\u{1f3fb}\u{200d}\u{2764}\u{fe0f}\u{200d}\u{1f468}\u{1f3ff}"));
print("keycap -> " + line("1\u{fe0f}\u{20e3}"));
print("devanagari conjunct -> " + line("\u{915}\u{94d}\u{937}"));
print("devanagari vowel sign -> " + line("\u{915}\u{93e}"));
print("thai prepend -> " + line("\u{e01}\u{e33}"));
print("arabic prepend -> " + line("\u{600}\u{627}"));
print("emoji then text -> " + line("\u{1f44d}a"));
print("zwj between letters -> " + line("a\u{200d}b"));
print("mixed -> " + line("Stra\u{df}e\u{301} \u{1f1ec}\u{1f1e7}"));
// The conformance file, case by case: a length, then that many code points.
int at = 0;
while (at < CASES.size()) {
    int n = CASES[at];
    List<int> cps = [];
    int i = 0;
    while (i < n) {
        cps.push(CASES[at + 1 + i]);
        i = i + 1;
    }
    at = at + 1 + n;
    print(line(str.from_chars(cps)));
}

