import io;
import fs;
import random;

// `io.Buffer`: bytes in memory with a read position -- write appends, read
// consumes from the front -- and `io.Stream`, the protocol it shares with
// `io.File`. The file the last section needs lives under a directory named
// from the random source, so two runs of the corpus at once cannot touch
// each other's files, and it is removed at the end.

// A Buffer's Err arm is unreachable: it has no kernel to say no to it. The
// helpers say so by trapping, so that a future change which made one fail
// would fail this test rather than pass it quietly.
bytes got(Result<bytes, io.Error> r) {
    match (r) {
        case Ok(bytes b): {
            return b;
        }
        case Err(io.Error e): {
            trap("a Buffer cannot fail: " + e.to_str());
        }
    }
}

int put(Result<int, io.Error> r) {
    match (r) {
        case Ok(int n): {
            return n;
        }
        case Err(io.Error e): {
            trap("a Buffer cannot fail: " + e.to_str());
        }
    }
}

// Text when it is text, hex in angle brackets when it is not.
str show(bytes b) {
    match (b.utf8()) {
        case Some(str s): {
            return s;
        }
        case None: {
            return "<" + b.hex() + ">";
        }
    }
}

// --- a round trip -----------------------------------------------------------
io.Buffer b = io.buffer();
print(b.size());  // 0
print(put(b.write("hello, world".to_bytes())));  // 12
print(b.size());  // 12
print(show(b.peek()));  // hello, world
print(b.size());  // 12 -- peek consumes nothing
print(show(got(b.read_all())));  // hello, world
print(b.size());  // 0
// --- partial reads, and the end ---------------------------------------------
io.Buffer s = io.buffer_of("abcdef".to_bytes());
print(show(got(s.read(2))));  // ab
print(show(got(s.read(1))));  // c
print(s.size());  // 3
print(show(got(s.read(99))));  // def -- fewer than asked for is not the end
print(got(s.read(4)).size());  // 0 -- this is the end
print(got(s.read(4)).size());  // 0 -- and it stays the end
print(got(s.read_all()).size());  // 0
print(got(s.read_until("f".to_bytes(), 9)).size());  // 0
// --- buffer_of copies its argument ------------------------------------------
bytes shared = "xy".to_bytes();
io.Buffer c = io.buffer_of(shared);
shared.push(122);  // 'z' -- into the caller's bytes, not into the Buffer
print(show(got(c.read_all())));  // xy
// --- writing and reading, interleaved ----------------------------------------
io.Buffer q = io.buffer();
print(put(q.write("one ".to_bytes())));  // 4
print(show(got(q.read(2))));  // on
print(put(q.write("two".to_bytes())));  // 3 -- appended behind the read position
print(show(got(q.read_all())));  // e two
print(q.size());  // 0
print(put(q.write("again".to_bytes())));  // 5 -- a drained Buffer is a fresh one
print(show(got(q.read_all())));  // again
// --- read_until, with the delimiter split across writes -----------------------
bytes crlf = "\r\n".to_bytes();
io.Buffer r = io.buffer();
print(put(r.write("head\r".to_bytes())));  // 5
// Only the first half of the delimiter has been written. Running out of
// unread bytes is the end of the stream as far as read_until can tell, so it
// takes what is there and reports no delimiter -- exactly what it would do
// at the end of a file, which is why the result has to be checked and not
// assumed.
bytes part = got(r.read_until(crlf, 100));
print(part.hex());  // 686561640d
print(part.ends_with(crlf));  // false
print(put(r.write("\ntail\r\n".to_bytes())));  // 7
bytes rest = got(r.read_until(crlf, 100));
print(rest.hex());  // 0a7461696c0d0a
print(rest.ends_with(crlf));  // true
// Both halves written before the read: one delimiter, found across what were
// two writes, because a Buffer is one run of bytes and not a list of them.
io.Buffer r2 = io.buffer();
print(put(r2.write("head\r".to_bytes())));  // 5
print(put(r2.write("\ntail".to_bytes())));  // 5
bytes whole = got(r2.read_until(crlf, 100));
print(whole.hex());  // 686561640d0a
print(whole.ends_with(crlf));  // true
print(show(got(r2.read_all())));  // tail
// A limit smaller than the distance to the delimiter: exactly `limit` bytes,
// no delimiter, and the rest still there for the next call.
io.Buffer r3 = io.buffer_of("aaaaaaaa".to_bytes());
bytes capped = got(r3.read_until("b".to_bytes(), 3));
print(show(capped));  // aaa
print(capped.ends_with("b".to_bytes()));  // false
print(r3.size());  // 5
// --- binary: NUL, 0xff, and bytes that are not UTF-8 ---------------------------
// 0xc3 0x28 is a two-byte lead followed by something that is not a
// continuation byte: invalid UTF-8, and a Buffer neither notices nor cares.
bytes data = [0, 1, 255, 195, 40, 0, 10];
io.Buffer bin = io.buffer_of(data);
print(bin.size());  // 7
print(got(bin.read(3)).hex());  // 0001ff
print(bin.peek().hex());  // c328000a
print(show(got(bin.read_all())));  // <c328000a> -- not text, and not damaged
// A NUL as the delimiter is an ordinary byte here, as it is everywhere else.
bytes nul = [0];
io.Buffer z = io.buffer_of(data);
print(got(z.read_until(nul, 100)).hex());  // 00
print(got(z.read_until(nul, 100)).hex());  // 01ffc32800
print(got(z.read_until(nul, 100)).hex());  // 0a -- the end, no delimiter
// --- the compaction path -------------------------------------------------------
// 100,000 bytes read one at a time. The dead prefix is dropped only once it
// is half the buffer, so the copying across the whole loop is 50,000 +
// 25,000 + ... < 100,000 bytes: linear in the bytes, not quadratic.
bytes block = [88; 100000];
io.Buffer big = io.buffer();
print(put(big.write(block)));  // 100000
int count = 0;
while (big.size() > 0) {
    count = count + got(big.read(1)).size();
}
print(count);  // 100000
print(big.size());  // 0
// Writing and reading it all back, over and over: `at` reaches the end of
// the buffer every cycle, which clears it in place and keeps the storage. No
// copy and no allocation, however many cycles there are.
io.Buffer pp = io.buffer();
bytes eight = "12345678".to_bytes();
int cycles = 0;
int moved = 0;
while (cycles < 100000) {
    int w = put(pp.write(eight));
    moved = moved + got(pp.read(8)).size();
    cycles = cycles + 1;
}
print(moved);  // 800000
print(pp.size());  // 0
// Reads that leave the tail in place: a hundred thousand two-byte reads out
// of a buffer that is topped up with three bytes each time, so the dead
// prefix keeps crossing the halfway mark and the compaction runs again and
// again.
io.Buffer tide = io.buffer();
int i = 0;
int seen = 0;
while (i < 100000) {
    int w2 = put(tide.write("abc".to_bytes()));
    seen = seen + got(tide.read(2)).size();
    i = i + 1;
}
print(seen);  // 200000
print(tide.size());  // 100000 -- one byte a cycle left behind
print(show(got(tide.read(3))));  // cab -- 200,000 bytes into "abcabc..."
// --- a Stream: a Buffer, a File and standard input, through one helper ---------
str dir = "/tmp/m31-corpus-io-buffer-" + random.system().hex(8);
match (fs.mkdir(dir)) {
    case Ok(bool made): {
        print("dir made");
    }
    case Err(io.Error e): {
        print(e.to_str());
    }
}
str path = dir + "/lines";
match (io.write(path, "file line\nsecond file line\n")) {
    case Ok(int n): {
        print(n);  // 27
    }
    case Err(io.Error e): {
        print(e.to_str());
    }
}

// `io.read_line_of` is written against `io.Stream` and knows nothing about either
// type. Each call below passes a concrete type where the interface is
// expected, which is the whole claim: `io.File` satisfies `io.Stream` with
// no change to `io.File`.
str one_line(io.Stream st) {
    match (io.read_line_of(st, 4096)) {
        case Ok(Option<str> o): {
            match (o) {
                case Some(str t): {
                    return "[" + t + "]";
                }
                case None: {
                    return "<end>";
                }
            }
        }
        case Err(io.Error e): {
            return "<" + e.to_str() + ">";
        }
    }
}

match (io.open(path)) {
    case Ok(io.File f): {
        print(one_line(f));  // [file line]
        print(one_line(f));  // [second file line]
        print(one_line(f));  // <end>
        Result<bool, io.Error> fc = f.close();
    }
    case Err(io.Error e): {
        print(e.to_str());
    }
}
// Standard input is a File too, so it is a Stream too. One File, kept, so
// that the second line comes out of the buffer the first one filled.
io.File input = io.stdin();
print(one_line(input));  // [stdin line]
print(one_line(input));  // [second stdin line]
print(one_line(input));  // <end>
// And a Buffer, through the same helper. The last line has no newline, and
// is still a line.
io.Buffer text = io.buffer_of("buffer line\nlast, unterminated".to_bytes());
print(one_line(text));  // [buffer line]
print(one_line(text));  // [last, unterminated]
print(one_line(text));  // <end>
// Text that is not UTF-8 stops the line rather than ending the stream:
// `io.read_line_of` has a Result to say why, where an Option would have to
// call it the end of the input.
bytes bad = [104, 105, 255, 254, 10, 111, 107, 10];
io.Buffer rough = io.buffer_of(bad);
print(one_line(rough));  // <not valid UTF-8 text>
print(one_line(rough));  // [ok]
// `io.copy` moves bytes from any stream to any other. A file into a Buffer:
io.Buffer into = io.buffer();
match (io.open(path)) {
    case Ok(io.File f): {
        match (io.copy(f, into)) {
            case Ok(int n): {
                print(n);  // 27
            }
            case Err(io.Error e): {
                print(e.to_str());
            }
        }
        Result<bool, io.Error> fc = f.close();
    }
    case Err(io.Error e): {
        print(e.to_str());
    }
}
print(into.size());  // 27
print(one_line(into));  // [file line]
// A Buffer into a file, which is the same call with the arguments the other
// way round.
str out_path = dir + "/copied";
match (io.open(out_path, mode: io.Mode.Write)) {
    case Ok(io.File f): {
        io.Buffer from = io.buffer_of("through a Stream".to_bytes());
        match (io.copy(from, f)) {
            case Ok(int n): {
                print(n);  // 16
            }
            case Err(io.Error e): {
                print(e.to_str());
            }
        }
        // copy closes neither stream: it opened neither.
        print(from.size());  // 0
        match (f.close()) {
            case Ok(bool done): {
                print("copy closed");
            }
            case Err(io.Error e): {
                print(e.to_str());
            }
        }
    }
    case Err(io.Error e): {
        print(e.to_str());
    }
}
match (io.read(out_path)) {
    case Ok(str got_text): {
        print(got_text);  // through a Stream
    }
    case Err(io.Error e): {
        print(e.to_str());
    }
}
// --- close ---------------------------------------------------------------------
io.Buffer done = io.buffer_of("gone".to_bytes());
match (done.close()) {
    case Ok(bool ok): {
        print("closed");
    }
    case Err(io.Error e): {
        print(e.to_str());
    }
}
// A second close is not an error, as on a File. Any other use traps
// (corpus/traps/027, 028).
match (done.close()) {
    case Ok(bool ok): {
        print("closed again");
    }
    case Err(io.Error e): {
        print(e.to_str());
    }
}
match (fs.rmtree(dir, dir)) {
    case Ok(bool gone): {
        print("cleaned up");
    }
    case Err(io.Error e): {
        print(e.to_str());
    }
}
print(fs.exists(dir));  // false
