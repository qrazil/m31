import io;
import fs;

// Standard output is buffered by the runtime itself, over the sys layer
// (docs/sys-layer.md), not by C stdio. The corpus runs every program with
// stderr joined to stdout, so this checks what that buffer must get right:
// output crosses the buffer's size more than once, and a write to stderr in
// the middle still lands exactly between the lines printed around it.
int i = 0;
while (i < 14000) {
    if (i == 7000) {
        io.eprint("stderr, between 6999 and 7000");
    }
    print(i);
    i = i + 1;
}
// A file larger than the first read, so the read loop runs more than once
// and the result is the whole file, not the size fstat guessed.
str s = "0123456789";
int k = 0;
while (k < 14) {
    s = s + s;
    k = k + 1;
}
str path = "/tmp/lang-corpus-sys-streams.txt";
match (io.write(path, s)) {
    case Ok(int n): {
        print(n);
    }  // 163840
    case Err(io.Error e): {
        print(io.message(e));
    }
}
match (io.append(path, "end")) {
    case Ok(int n): {
        print(n);
    }  // 3
    case Err(io.Error e): {
        print(io.message(e));
    }
}
match (io.read(path)) {
    case Ok(str got): {
        print(got.size());
    }  // 163843
    case Err(io.Error e): {
        print(io.message(e));
    }
}
io.eprint("last, after everything printed");
// Leave nothing behind in /tmp.
match (fs.remove(path)) {
    case Ok(bool b): {
    }
    case Err(io.Error e): {
        print(io.message(e));
    }
}
