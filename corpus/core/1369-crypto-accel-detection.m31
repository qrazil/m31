// lib/crypto/accel.m31 decides which assembly kernels may run. Its pure parts
// are run here over synthetic input, so the logic the aarch64 Linux and macOS
// paths use (which no x86-64 test machine can reach on its own) is checked on
// every build: the AT_HWCAP parser, the HWCAP bits, and the M31_CRYPTO_ACCEL
// grammar. (docs/ffi-decision.md, "CPU feature detection, in m31".)
import crypto.accel;

void put64(bytes out, int value) {
    for (int index in 0 .. 8) {
        out.push(value >> (8 * index) & 0xFF);
    }
}

// An auxiliary vector as Linux lays it out: (type, value) pairs of 64-bit
// words, ended by type 0.
bytes vector(int hwcap) {
    bytes out = [];
    put64(out, 33);
    put64(out, 0x7FFF_0000);
    put64(out, 16);
    put64(out, hwcap);
    put64(out, 51);
    put64(out, 1);
    put64(out, 0);
    put64(out, 0);
    return out;
}

// HWCAP_AES 1<<3, PMULL 1<<4, SHA1 1<<5, SHA2 1<<6 (arch/arm64/include/uapi/asm/hwcap.h)
int all_four = 8 | 16 | 32 | 64;
print(accel.hwcap_of_auxv(vector(all_four)));
print(accel.hwcap_of_auxv(vector(0)));
print(accel.hwcap_of_auxv([]));
bytes truncated = vector(all_four);
truncated.truncate(24);
print(accel.hwcap_of_auxv(truncated));
bytes without = [];
put64(without, 33);
put64(without, 1);
put64(without, 0);
put64(without, 0);
print(accel.hwcap_of_auxv(without));

// the kernel set a CPU's HWCAP allows: the always-present 92, plus
//   AES (1) needs AES and PMULL, SHA256 (2) needs SHA2, SHA1 (32) needs SHA1
print(accel.from_hwcap(0));
print(accel.from_hwcap(all_four));
print(accel.from_hwcap(8));
print(accel.from_hwcap(8 | 16));
print(accel.from_hwcap(64));
print(accel.from_hwcap(32));

// M31_CRYPTO_ACCEL
print(accel.restrict(127, Option<str>.None));
print(accel.restrict(127, Option<str>.Some("off")));
print(accel.restrict(127, Option<str>.Some("0")));
print(accel.restrict(127, Option<str>.Some("")));
print(accel.restrict(127, Option<str>.Some("-aes")));
print(accel.restrict(127, Option<str>.Some("-aes,-sha256,-sha1")));
print(accel.restrict(127, Option<str>.Some("-chacha,-poly,-fe,-sha512")));
print(accel.restrict(127, Option<str>.Some("-bogus,-aes")));
print(accel.restrict(93, Option<str>.Some("-sha256")));
