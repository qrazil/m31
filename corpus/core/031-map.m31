// Open addressing with linear probing: one allocation for the whole table,
// no per-entry node, and deletion leaves a tombstone so a probe sequence is
// never broken.
//
// `get` on a missing key TRAPS, the same as an out-of-range index -- there
// is no null to return, so the honest choices are to trap or to force every
// read through a check. `has` is the check.
//
// Keys here are int and str, which the runtime hashes itself. A user type
// can be a key too, by declaring `hash` and `eq` -- corpus/core/902.

Map<str, int> counts = {};
counts.set("a", 1);
counts.set("b", 2);
counts.set("a", 10);        // replaces, does not grow
print(counts.size());
print(counts.get("a").or(0));
print(counts.contains("b"));
print(counts.contains("zz"));
counts.remove("b");
print(counts.size());
print(counts.contains("b"));

// str keys compare by content, not by identity.
str built = "a" + "";
print(counts.contains(built));

Map<int, str> names = {};
names.set(1, "one");
names.set(2, "tw" + "o");
print(names.get(2).or("?"));

// Enough entries to force several growths and exercise probing.
Map<int, int> big = {};
int i = 0;
while (i < 200) {
    big.set(i, i * i);
    i = i + 1;
}
print(big.size());
print(big.get(7).or(-1));
print(big.get(199).or(-1));

// Removing then re-adding must reuse the tombstone, not lose the key.
big.remove(7);
print(big.contains(7));
big.set(7, 777);
print(big.get(7).or(-1));
print(big.size());
