// math.pow at every special case of C99 Annex F (F.9.4.4), and at whole
// exponents of 2^53 and beyond, where every float is an even integer. The
// expected output is glibc's pow on the same arguments.
import math;

print(math.pow(-1.0, 1.0e300));
print(math.pow(-2.0, 1.0e20));
print(math.pow(-0.5, 1.0e20));
print(math.pow(-1.0, 9007199254740992.0));
print(math.pow(-1.0, 9007199254740994.0));
print(math.pow(-1.0, 1.0e19));
print(math.pow(-2.0, -1.0e20));
print(math.pow(-0.5, -1.0e20));
print(math.pow(-3.0, 9007199254740992.0));
print(math.pow(-1.0000000000000002, 1.0e300));
print(math.pow(-0.9999999999999999, 1.0e300));
print(math.pow(-1.0e-300, 1.0e20));
print(math.pow(-1.0000000000000002, 9007199254740992.0));
print(math.pow(-0.9999999999999999, 18014398509481984.0));
print(math.pow(1.0000000000000002, 18014398509481984.0));
print(math.pow(-1.0, 9007199254740991.0));
print(math.pow(-1.0, 9007199254740990.0));
print(math.pow(-3.0, 9007199254740991.0));
print(math.pow(-0.5, 9007199254740991.0));
print(math.pow(1.0, math.nan()));
print(math.pow(1.0, math.inf()));
print(math.pow(1.0, -math.inf()));
print(math.pow(1.0, 1.0e300));
print(math.pow(math.nan(), 0.0));
print(math.pow(math.nan(), -0.0));
print(math.pow(math.inf(), 0.0));
print(math.pow(-math.inf(), -0.0));
print(math.pow(0.0, 0.0));
print(math.pow(math.nan(), 1.0));
print(math.pow(2.0, math.nan()));
print(math.pow(-1.0, math.nan()));
print(math.pow(0.0, math.nan()));
print(math.pow(-1.0, math.inf()));
print(math.pow(-1.0, -math.inf()));
print(math.pow(0.0, -math.inf()));
print(math.pow(-0.0, -math.inf()));
print(math.pow(0.0, math.inf()));
print(math.pow(-0.0, math.inf()));
print(math.pow(0.0, -3.0));
print(math.pow(-0.0, -3.0));
print(math.pow(0.0, -4.0));
print(math.pow(-0.0, -4.0));
print(math.pow(0.0, -0.5));
print(math.pow(-0.0, -0.5));
print(math.pow(0.0, 3.0));
print(math.pow(-0.0, 3.0));
print(math.pow(-0.0, 4.0));
print(math.pow(-0.0, 0.5));
print(math.pow(-0.0, 1.0e300));
print(math.pow(-0.0, -1.0e300));
print(math.pow(-0.0, 9007199254740991.0));
print(math.pow(-0.0, -9007199254740991.0));
print(math.pow(-math.inf(), -3.0));
print(math.pow(-math.inf(), -4.0));
print(math.pow(-math.inf(), -0.5));
print(math.pow(-math.inf(), 3.0));
print(math.pow(-math.inf(), 4.0));
print(math.pow(-math.inf(), 0.5));
print(math.pow(-math.inf(), 1.0e300));
print(math.pow(-math.inf(), -1.0e300));
print(math.pow(math.inf(), -0.5));
print(math.pow(math.inf(), 0.5));
print(math.pow(math.inf(), -2.0));
print(math.pow(math.inf(), 3.0));
print(math.pow(0.5, math.inf()));
print(math.pow(0.5, -math.inf()));
print(math.pow(2.0, math.inf()));
print(math.pow(2.0, -math.inf()));
print(math.pow(-0.5, math.inf()));
print(math.pow(-0.5, -math.inf()));
print(math.pow(-2.0, math.inf()));
print(math.pow(-2.0, -math.inf()));
print(math.pow(-8.0, 0.5));
print(math.pow(-2.0, -1.5));
print(math.pow(-3.0, 3.0));
print(math.pow(-2.0, -3.0));
print(math.pow(-2.0, 1024.0));
print(math.pow(-2.0, 1025.0));
print(math.pow(-2.0, -1075.0));
print(math.pow(-2.0, -1076.0));
