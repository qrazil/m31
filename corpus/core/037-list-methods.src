// The List and Array method surface beyond push/pop/len.

List<int> xs = List<int>();
xs.push(1);
xs.push(2);
xs.push(4);
xs.insert(2, 3);            // in the middle
xs.insert(0, 0);            // at the front
print(xs.size());            // 5
print(xs[0]);               // 0
print(xs[3]);               // 3
print(xs[4]);               // 4

print(xs.remove_at(0));     // 0 -- returns what it removed
print(xs.size());            // 4
print(xs[0]);               // 1

xs.reverse();
print(xs[0]);               // 4
print(xs[3]);               // 1

print(xs.contains(3));      // true
print(xs.contains(99));     // false

xs.clear();
print(xs.size());            // 0
xs.push(7);                 // still usable after clear
print(xs[0]);               // 7

// Reference elements: the list retains what it is given and hands the
// reference back when it gives one up.
List<str> ws = List<str>();
ws.push(concat("a", "b"));
ws.insert(0, concat("c", "d"));
print(ws[0]);               // cd
print(ws.contains("ab"));   // true -- str compares by value, as `==` does
print(ws.contains("zz"));   // false

str taken = ws.remove_at(0);
print(taken);               // cd
print(ws.size());            // 1
ws.clear();
print(ws.size());            // 0

// Insert at the very end is allowed; one past that is not.
List<int> tail = List<int>();
tail.push(1);
tail.insert(1, 2);
print(tail[1]);             // 2

// Arrays are fixed length, so only the non-resizing operations apply.
Array<int> a = Array<int>(3, 0);
a[0] = 1;
a[1] = 2;
a[2] = 3;
a.reverse();
print(a[0]);                // 3
print(a[2]);                // 1
print(a.contains(2));       // true
print(a.contains(9));       // false

Array<str> sa = Array<str>(2, "x");
sa[0] = concat("y", "z");
print(sa.contains("yz"));   // true
sa.reverse();
print(sa[1]);               // yz
