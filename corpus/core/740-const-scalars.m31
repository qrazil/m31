// Module constants of every scalar type, computed by the compiler: literals,
// operators, and other constants -- including ones declared further down,
// because declarations are order-independent (reference §4.4).

const int LIMIT = 10;
const int AREA = WIDTH * HEIGHT;
const int WIDTH = 3;
const int HEIGHT = LIMIT + 4;
const int MIN = -9223372036854775807 - 1;
const int MASK = ~(-1 << 8);
const int SHIFTED = 1 << 62 >> 60;
const int NEG_SHIFT = -64 >> 3;
const int QUOT = -7 / 2;
const int REM = -7 % 2;
const float HALF = 1.0 / 2.0;
const float NEG_ZERO = -0.0;
const float THIRD = 1.0 / 3.0;
const bool BIG = AREA > 40;
const bool BOTH = BIG && !(LIMIT == 10);
const str NAME = "wor" + "ld";
const str GREETING = "hello, " + NAME;
const bool SAME = NAME == "world";

// A default argument may name a constant; it means what it means in the
// declaring module.
int scaled(int n, int by = LIMIT) {
    return n * by;
}

print(LIMIT);
print(AREA);
print(MIN);
print(MASK);
print(SHIFTED);
print(NEG_SHIFT);
print(QUOT);
print(REM);
print(HALF);
print(NEG_ZERO);
print(THIRD);
print(BIG);
print(BOTH);
print(GREETING);
print(SAME);
print(scaled(4));
print(scaled(4, by: WIDTH));

// A constant used in a loop is folded into every use: nothing to carry.
int i = 0;
int t = 0;
while (i < LIMIT) {
    t = t + i;
    i = i + 1;
}
print(t);
