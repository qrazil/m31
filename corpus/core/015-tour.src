// A tour of everything the language does today.
//
// Run it:   ./build.sh examples/tour.src && ./tour
// This file is also in the corpus, so it cannot rot.

// ---- user types -------------------------------------------------------
// Reference types: heap allocated, refcounted, aliased by assignment.
// Constructed by field name, so reordering fields never transposes values.

type Point {
    int x;
    int y;
}

type Rect {
    Point origin;
    int   w;
    int   h;
}

// ---- generics ---------------------------------------------------------
// Java-shaped angle brackets. Monomorphised, so Box<int> and Box<str>
// become two separate concrete types at compile time.

type Box<T> {
    T value;
}

type Pair<A, B> {
    A first;
    B second;
}

// ---- functions --------------------------------------------------------
// Type-first, like C and Java. Type arguments on a generic function are
// inferred from the call, never written.

int area(Rect r) {
    return r.w * r.h;
}

T unwrap<T>(Box<T> b) {
    return b.value;
}

int fib(int n) {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

// Overflow traps rather than wrapping, so this cannot silently go negative.
int factorial(int n) {
    int acc = 1;
    int i = 2;
    while (i <= n) {
        acc = acc * i;
        i = i + 1;
    }
    return acc;
}

str banner(str label, int width) {
    str out = "";
    int i = 0;
    while (i < width) {
        out = concat(out, "=");
        i = i + 1;
    }
    return concat(concat(out, " "), label);
}

void main() {
    // ---- const and arithmetic -----------------------------------------
    const int scale = 3;
    print(2 + 3 * 4);          // C precedence
    print(fib(20));
    print(factorial(20));      // the largest that fits in an int

    // ---- types and fields ---------------------------------------------
    Rect r = Rect(origin: Point(x: 0, y: 0), w: 4, h: 5);
    print(area(r) * scale);
    print(r.origin.x);

    r.w = 10;                  // field assignment
    print(area(r));

    // ---- aliasing ------------------------------------------------------
    // Assignment aliases; both names see the change. `clone` will be the
    // explicit way to copy, once it exists.
    Rect same = r;
    same.h = 1;
    print(area(r));

    // ---- generics ------------------------------------------------------
    Box<int> bi = Box<int>(value: 21);
    print(unwrap(bi) * 2);

    Box<str> bs = Box<str>(value: "boxed");
    print(unwrap(bs));

    Pair<int, str> p = Pair<int, str>(first: 7, second: "seven");
    print(p.first);
    print(p.second);

    // ---- strings -------------------------------------------------------
    str title = banner("tour", 8);
    print(title);
    print(len(title));

    // ---- control flow --------------------------------------------------
    int i = 0;
    int evens = 0;
    while (true) {
        i = i + 1;
        if (i > 20) {
            break;
        }
        if (i % 2 != 0) {
            continue;
        }
        evens = evens + i;
    }
    print(evens);

    // Short-circuit: the right side would divide by zero if it ran.
    int z = 0;
    if (z != 0 && 10 / z > 1) {
        print(-1);
    } else {
        print(0);
    }

    bool ok = len(title) > 3;
    print(ok);
}
