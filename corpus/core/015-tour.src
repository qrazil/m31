// A tour of everything the language does today.
//
// Run it:   ./build.sh examples/tour.src && ./tour
// This file is also in the corpus, so it cannot rot.

// ---- user types --------------------------------------------------------
// Reference types: heap allocated, refcounted, aliased by assignment.
// Constructed by field name, so reordering fields never transposes values.

type Point {
    int x;
    int y;
}

type Rect {
    Point origin;
    int   w;
    int   h;
}

// ---- generics ----------------------------------------------------------
// Java-shaped angle brackets. Monomorphised, so Cell<int> and Cell<str>
// become two separate concrete types at compile time.

type Cell<T> {
    T value;
}

type Pair<A, B> {
    A first;
    B second;
}

// ---- methods -----------------------------------------------------------
// Declared by qualified name, outside the type body, so they can be added to
// any type. Fields are reached by BARE NAME -- there is no `this`, because
// nothing shadows anything anywhere, so a bare name means one thing.

int Rect.area() {
    return w * h;
}

void Rect.scale(int f) {
    w = w * f;
    h = h * f;
}

bool Rect.is_square() {
    return w == h;
}

// ---- functions ---------------------------------------------------------
// Type-first, like C and Java. Type arguments on a generic function are
// inferred from the call, never written.

T unwrap<T>(Cell<T> b) {
    return b.value;
}

int fib(int n) {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

// Overflow traps rather than wrapping, so this cannot silently go negative.
int factorial(int n) {
    int acc = 1;
    int i = 2;
    while (i <= n) {
        acc = acc * i;
        i = i + 1;
    }
    return acc;
}

str banner(str label, int width) {
    str out = "";
    int i = 0;
    while (i < width) {
        out = concat(out, "=");
        i = i + 1;
    }
    return concat(concat(out, " "), label);
}

// ---- const and arithmetic ----------------------------------------------
const int scale = 3;
print(2 + 3 * 4);          // C precedence
print(fib(20));
print(factorial(20));      // the largest that fits in an int

// ---- types and fields --------------------------------------------------
Rect r = Rect(Point(0, 0), 4, 5);
print(r.area() * scale);
print(r.origin.x);

r.w = 10;                  // field assignment
print(r.area());

// ---- aliasing ----------------------------------------------------------
// Assignment aliases; both names see the change. `clone` will be the
// explicit way to copy, once it exists.
Rect same = r;
same.h = 1;
print(r.area());

// ---- generics ----------------------------------------------------------
Cell<int> bi = Cell<int>(21);
print(unwrap(bi) * 2);

Cell<str> bs = Cell<str>("boxed");
print(unwrap(bs));

Pair<int, str> p = Pair<int, str>(7, "seven");
print(p.first);
print(p.second);

// ---- strings -----------------------------------------------------------
str title = banner("tour", 8);
print(title);
print(len(title));

// ---- interfaces ----------------------------------------------------
// Structural: having the methods is the proof, no `implements` clause.

interface Sized {
    int area();
}

Sized shape = r;
print(shape.area());

// ---- concurrency ---------------------------------------------------
// Threads and channels. A reference sent to another thread is MOVED, which
// is what keeps refcounts non-atomic. A channel is exempt -- it is how
// threads share.

void adder(Chan<int> out, int from, int to) {
    int i = from;
    int total = 0;
    while (i <= to) {
        total = total + i;
        i = i + 1;
    }
    send(out, total);
}

Chan<int> sums = Chan<int>(4);
spawn adder(sums, 1, 50);
spawn adder(sums, 51, 100);
print(recv(sums) + recv(sums));   // order-independent

// ---- control flow ------------------------------------------------------
int i = 0;
int evens = 0;
while (true) {
    i = i + 1;
    if (i > 20) {
        break;
    }
    if (i % 2 != 0) {
        continue;
    }
    evens = evens + i;
}
print(evens);

// Short-circuit: the right side would divide by zero if it ran.
int z = 0;
if (z != 0 && 10 / z > 1) {
    print(-1);
} else {
    print(0);
}

bool ok = len(title) > 3;
print(ok);
