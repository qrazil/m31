// `prim "c"` (docs/ffi-decision.md): library code calling assembly kernels
// through compiler-checked spans. The kernels are runtime/ffitest_<arch>.S,
// declared in runtime/tests/ffitest.m31, which the compiler can import only
// under M31C_FFITEST (scripts/run.sh sets it). A program can never write a
// `prim`; it reaches this the way it would reach any library.
import ffitest;

const bytes TABLE = [1, 2, 3, 4, 5, 6, 7, 8];

bytes a = [1, 2, 3, 4, 5, 6, 7, 8];
bytes b = [8, 8, 8, 8, 8, 8, 8, 8];
bytes d = [0; 8];

// out[o..o+n] = a ^ b, and nothing outside that range is written
ffitest.xor(d, a, b, 2, 4);
print(d.hex());

// in place: out is one of the inputs
ffitest.xor(a, a, b, 0, 8);
print(a.hex());

// the empty span at the very end is inside the buffer
ffitest.xor(d, a, b, 8, 0);
print(d.hex());

// a constant buffer is a fine `in`, and is not written
ffitest.xor(d, TABLE, TABLE, 0, 8);
print(d.hex());

// an Array<int> span is in elements; `from` is a range parameter
Array<int> xs = [10, 20, 30, 40];
print(ffitest.sum(xs, 0, 4));
print(ffitest.sum(xs, 1, 3));
print(ffitest.sum(xs, 4, 0));
ffitest.double_all(xs, 4);
print(xs[0]);
print(xs[3]);

// every argument register
print(ffitest.mix(1, 2, 3, 4, 5, 6));
print(ffitest.mix(-1, 0, 0, 0, 0, 1));

// a scalar the declaration restricts (and a callee that is not `nonblocking`)
print(ffitest.scale(1, TABLE, 8));
print(ffitest.scale(2, TABLE, 4));
print(ffitest.scale(4, a, 0));

// a write through a span leaves the size alone
bytes e = [9; 5];
ffitest.fill(e, 3, 255);
print(e.hex());
print(e.size());
