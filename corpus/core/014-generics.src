// Generics are erased before lowering, so the IR never sees them. Each
// instantiation becomes an ordinary type: Holder$int, Holder$str, Pair$int$str.
type Holder<T> {
    T value;
}

type Pair<A, B> {
    A first;
    B second;
}

T unwrap<T>(Holder<T> b) {
    return b.value;
}

Holder<int> bi = Holder<int>(21);
print(unwrap(bi) * 2);

Holder<str> bs = Holder<str>(concat("hel", "lo"));
print(unwrap(bs));

Pair<int, str> p = Pair<int, str>(7, "seven");
print(p.first);
print(p.second);

// A generic instantiated at another instantiation of itself.
Holder<Holder<int>> nested = Holder<Holder<int>>(bi);
Holder<int> inner = unwrap(nested);
print(unwrap(inner));
