// Generics are erased before lowering, so the IR never sees them. Each
// instantiation becomes an ordinary type: Box$int, Box$str, Pair$int$str.
type Box<T> {
    T value;
}

type Pair<A, B> {
    A first;
    B second;
}

T unwrap<T>(Box<T> b) {
    return b.value;
}

Box<int> bi = Box<int>(21);
print(unwrap(bi) * 2);

Box<str> bs = Box<str>(concat("hel", "lo"));
print(unwrap(bs));

Pair<int, str> p = Pair<int, str>(7, "seven");
print(p.first);
print(p.second);

// A generic instantiated at another instantiation of itself.
Box<Box<int>> nested = Box<Box<int>>(bi);
Box<int> inner = unwrap(nested);
print(unwrap(inner));
