// Methods are declared by qualified name, outside the type body, so they can
// be added to any type and a type declaration stays a list of fields.
//
// Fields are reached by BARE NAME -- no `this`. That is safe only because
// nothing shadows anything: see corpus/core/018-no-shadowing.src.

type Rect {
    int w;
    int h;
}

type Counter {
    int n;
    str label;
}

int Rect.area() {
    return w * h;
}

void Rect.scale(int f) {
    w = w * f;
    h = h * f;
}

bool Rect.is_square() {
    return w == h;
}

// Methods take the same argument rule as functions.
str Counter.render(str sep = ": ") {
    return concat(label, sep);
}

void Counter.bump(int by = 1) {
    n = n + by;
}

Rect r = Rect(4, 5);
print(r.area());
print(r.is_square());

r.scale(3);
print(r.area());
print(r.w);

Rect sq = Rect(6, 6);
print(sq.is_square());

Counter c = Counter(0, "hits");
c.bump();
c.bump(by: 10);
print(c.n);
print(c.render());
print(c.render(sep: " = "));
