// Every concrete claim docs/reference.md makes about the language surface,
// in one program. If the reference and the compiler disagree, this fails.

// --- 3.2 reference semantics: assignment aliases -----------------------
type Point { int x; int y; }

Point a = Point(1, 2);
Point b = a;
b.x = 99;
print(a.x);                 // 99 -- one object, two names

Point c = clone(a);
c.x = 7;
print(a.x);                 // 99 -- clone is a second object

// --- 3.3 mandatory positional, optional named --------------------------
type Label { int n; str tag = "none"; }

Label l1 = Label(1);
Label l2 = Label(1, tag: "corner");
print(l1.tag);              // none
print(l2.tag);              // corner

// --- 3.5 embedding promotes fields and methods -------------------------
type Animal { str name; }
str Animal.speak() { return concat(name, " makes a sound"); }

type Dog { Animal; int legs; }
str Dog.speak() { return concat(name, " barks"); }

type Puppy { Dog; }

Dog d = Dog(Animal("Rex"), 4);
print(d.name);              // Rex -- promoted field
print(d.speak());           // Rex barks -- outer method shadows forwarder

Puppy p = Puppy(Dog(Animal("Cub"), 4));
print(p.name);              // Cub -- promoted twice, to a fixpoint
print(p.speak());           // Cub barks -- forwarder of a shadowing method

// --- 3.4 interfaces are structural, dispatched at runtime --------------
interface Speaker { str speak(); }

str announce(Speaker s) { return s.speak(); }
print(announce(d));         // Rex barks
print(announce(p));         // Cub barks

// --- 3.6 distinct types keep their identity through arithmetic ---------
distinct int Price;

Price unit = Price(250);
Price total = unit + unit;
print(int(total));          // 500

// --- 3.7 generics monomorphise -----------------------------------------
type Box<T> { T item; }
T unwrap<T>(Box<T> b) { return b.item; }

Box<int> bi = Box<int>(41);
Box<str> bs = Box<str>("boxed");
print(unwrap(bi) + 1);      // 42
print(unwrap(bs));          // boxed

// --- 3.8 collections ----------------------------------------------------
Array<int> arr = Array<int>(3, 0);
arr[0] = 10;
arr[2] = 30;
print(arr[0] + arr[2]);     // 40
print(arr.len());           // 3

List<str> xs = List<str>();
xs.push("first");
xs.push("second");
print(xs.len());            // 2
print(xs.pop());            // second
print(xs.len());            // 1

Map<str, int> m = Map<str, int>();
m.set("one", 1);
m.set("two", 2);
print(m.len());             // 2
print(m.get("two"));        // 2
print(m.has("three"));      // false
m.remove("one");
print(m.len());             // 1

// --- 4.2 mandatory positional, optional named, for functions -----------
int scale(int v, int by = 2) { return v * by; }
print(scale(10));           // 20
print(scale(10, by: 3));    // 30

// --- 5.5 for-in borrows each element ------------------------------------
Array<int> nums = Array<int>(4, 1);
nums[1] = 2;
nums[2] = 3;
nums[3] = 4;
int sum = 0;
for (int v in nums) {
    sum = sum + v;
}
print(sum);                 // 10

// --- 5.6 break and continue hit the innermost loop ----------------------
int found = 0;
int i = 0;
while (i < 10) {
    i = i + 1;
    if (i % 2 == 0) { continue; }
    if (i > 5) { break; }
    found = found + i;
}
print(found);               // 1 + 3 + 5 = 9

// --- 6.1 precedence is C's, and && / || short-circuit -------------------
print(2 + 3 * 4);           // 14, not 20
print((2 + 3) * 4);         // 20
print(7 / 2);               // 3 -- integer division
print(7 % 2);               // 1
print(-3 + 1);              // -2

bool never() { print("not evaluated"); return true; }
print(false && never());    // false, and never() does not run
print(true || never());     // true, and never() does not run

// --- 6.2 operators on a user type are method calls ----------------------
type V { int x; int y; }
V    V.add(V o) { return V(x + o.x, y + o.y); }
V    V.sub(V o) { return V(x - o.x, y - o.y); }
bool V.eq(V o)  { return x == o.x && y == o.y; }
int  V.cmp(V o) { return (x + y) - (o.x + o.y); }

V v1 = V(1, 2);
V v2 = V(3, 4);
V v3 = v1 + v2;
print(v3.x);                // 4
print(v3.y);                // 6
print((v2 - v1).x);         // 2
print(v1 == v2);            // false
print(v1 != v2);            // true -- `eq` negated
print(v1 < v2);             // true -- via cmp
print(v2 >= v1);            // true -- via cmp, one implementation

// --- 6.5 str is length-carrying and compares by value -------------------
str s1 = concat("ab", "cd");
str s2 = concat("ab", "cd");
print(s1 == s2);            // true -- by value, not identity
print(len(s1));             // 4
print(len("a\0b"));         // 3 -- not NUL-terminated
