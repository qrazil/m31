// Methods on a generic type, and methods with type parameters of their own.
//
// A method on a generic type names the type's parameters on its receiver,
// `T Wrap<T>.get()`, so its signature says what `T` is without a trip to the
// type declaration. It is instantiated with each instantiation of the type.

type Wrap<T> {
    T item;
}

T Wrap<T>.get() {
    return item;
}

void Wrap<T>.set(T v) {
    item = v;
}

// The receiver's parameters may take other names; they are the method's.
bool Wrap<E>.same(E other) {
    return item == other;
}

static Wrap<T> Wrap<T>.of(T v) {
    return Wrap<T>(v);
}

// A method with a type parameter of its own, on a generic type.
Wrap<U> Wrap<T>.swap<U>(U v) {
    return Wrap<U>(v);
}

type Pair<A, B> {
    A a;
    B b;
}

Pair<B, A> Pair<A, B>.flip() {
    return Pair<B, A>(b, a);
}

// A generic method on a plain type.
type Picker {
    int at;
}

T Picker.pick<T>(List<T> xs) {
    return xs[at];
}

int Picker.count<K, V>(Map<K, V> m) {
    return m.size();
}

// Inside a method, a receiver field has a written type too.
type Shelf {
    List<str> names;
    Picker p;
}

str Shelf.chosen() {
    return p.pick(names);
}

Wrap<int> b = Wrap<int>(1);
print(b.get());
b.set(5);
print(b.get());
print(b.same(5));
print(b.same(6));

Wrap<str> s = Wrap<str>.of("text");
print(s.get());
Wrap<str> t = b.swap("swapped");
print(t.get());
print(b.swap(2.5).get());

Pair<int, str> p = Pair<int, str>(1, "one");
Pair<str, int> q = p.flip();
print(q.a);
print(q.b);

Picker k = Picker(1);
print(k.pick([10, 20, 30]));
print(k.pick(["x", "y"]));
print(k.count({1: true}));
print(Picker(0).pick([true, false]));

Shelf sh = Shelf(["a", "b"], Picker(1));
print(sh.chosen());

// A static method with a type parameter of its own.
static List<T> Picker.two<T>(T v) {
    return [v, v];
}

print(Picker.two("again").size());
