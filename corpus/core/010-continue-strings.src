// Same for `continue`: the jump back to the header leaves the body scope, so
// each skipped iteration must still release what it allocated.

int i = 0;
int n = 0;
while (i < 5) {
    i = i + 1;
    str tmp = concat("ab", "cd");
    if (i % 2 == 0) {
        continue;
    }
    n = n + len(tmp);
}
print(n);
