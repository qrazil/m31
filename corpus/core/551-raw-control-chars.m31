// Raw bytes between the quotes are taken as they are: a control character,
// a tab, a BOM and a combining accent written raw, not escaped. This is the
// file that `m31c fmt` used to break -- it wrote them back as `\u{1}`,
// Rust's spelling, which the lexer refuses -- so the formatter gate runs
// it through fmt and back.

void bytes_of(str s) {
    bytes b = s.to_bytes();
    str line = str(b.size()) + ":";
    for (int x in b) {
        line = line + " " + str(x);
    }
    print(line);
}

bytes_of("");
bytes_of("a	b");
bytes_of("﻿");
bytes_of("é");
bytes_of("");
print("" == "\x01");
print("é" == "e\u{301}");
