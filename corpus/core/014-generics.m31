// Generics are erased before lowering, so the IR never sees them. Each
// instantiation becomes an ordinary type: Wrap$int, Wrap$str, Pair$int$str.
type Wrap<T> {
    T value;
}

type Pair<A, B> {
    A first;
    B second;
}

T unwrap<T>(Wrap<T> b) {
    return b.value;
}

Wrap<int> bi = Wrap<int>(21);
print(unwrap(bi) * 2);

Wrap<str> bs = Wrap<str>(concat("hel", "lo"));
print(unwrap(bs));

Pair<int, str> p = Pair<int, str>(7, "seven");
print(p.first);
print(p.second);

// A generic instantiated at another instantiation of itself.
Wrap<Wrap<int>> nested = Wrap<Wrap<int>>(bi);
Wrap<int> inner = unwrap(nested);
print(unwrap(inner));
