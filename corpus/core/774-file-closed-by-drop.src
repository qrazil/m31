import io;
import fs;

// `io.File` has a destructor that closes it, so a descriptor cannot leak --
// not when the program forgets `close()`, and not when a `?` leaves between
// open and close. Observed from outside: the number of entries in
// /proc/self/fd, relative to where the program started, since the runner
// decides what the first few are.

int open_fds() {
    match (fs.listdir("/proc/self/fd")) {
        case Ok(List<str> names): {
            return names.size();
        }
        case Err(io.Error e): {
            trap("cannot list /proc/self/fd: " + e.to_str());
        }
    }
}

void report(Result<int, io.Error> r) {
    match (r) {
        case Ok(int n): {
            print(n);
        }
        case Err(io.Error e): {
            print(e.to_str());
        }
    }
}

int base = open_fds();

// Opened, never closed, and let go at the end of the function.
Result<int, io.Error> forgotten(int base) {
    io.File f = io.open("/dev/null")?;
    print(open_fds() - base);   // 1
    return Result<int, io.Error>.Ok(0);
}

report(forgotten(base));
print(open_fds() - base);       // 0

// A `?` between open and close: the second open fails, the function
// returns its error, and the first file is closed on the way out.
Result<int, io.Error> both(str a, str b, int base) {
    io.File first = io.open(a)?;
    print(open_fds() - base);   // 1
    io.File second = io.open(b)?;
    return Result<int, io.Error>.Ok(2);
}

report(both("/dev/null", "/nonexistent/lang-drop-test", base));
print(open_fds() - base);       // 0

// Reassigning a File variable closes the one it held. Then `close()` by
// hand, and the destructor after it: closing twice is a no-op, so the
// destructor does not close a descriptor number someone else now has.
Result<int, io.Error> reassign(int base) {
    io.File g = io.open("/dev/null")?;
    g = io.open("/dev/zero")?;
    print(open_fds() - base);   // 1
    bool closed = g.close()?;
    print(closed);
    print(open_fds() - base);   // 0
    return Result<int, io.Error>.Ok(3);
}

report(reassign(base));
print(open_fds() - base);       // 0

// The standard streams are marked closed when dropped, never released: the
// program can still print afterwards.
if (true) {
    io.File out = io.stdout();
    io.File err = io.stderr();
}
print("stdout still open");
print(open_fds() - base);       // 0
