// User types are reference types: refcounted, heap allocated, aliased by
// assignment. A type holding no references gets no drop function at all;
// Named holds two, so it gets one, and __rc_live=0 proves it runs.
type Point {
    int x;
    int y;
}

type Named {
    str   label;
    Point at;
}

int sum(Point p) {
    return p.x + p.y;
}

void main() {
    Point p = Point(x: 3, y: 4);
    print(sum(p));

    Named n = Named(label: concat("pt-", "A"), at: p);
    print(n.label);
    print(n.at.x);

    // Reassigning a reference field must release the old value.
    n.at = Point(x: 10, y: 20);
    print(sum(n.at));
    print(p.x);
}
