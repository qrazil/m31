// The first mistake everyone arriving from C, Java, Go, Rust or Python
// makes. §9 exists so that an absence is a decision; a decision should reach
// the person who trips over it, so the message names the construct that is
// missing and the two that replace it.
int n = 3;
for (int i = 0; i < n; i = i + 1) {
    print(i);
}
