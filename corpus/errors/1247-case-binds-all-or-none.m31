// A case binds a position for every value its variant carries, or none of
// them: naming one of two is refused, and the message says how to discard the
// other (`case Both(int a, _)`).
enum Pair {
    None;
    Both(int, str);
}

int first(Pair p) {
    match (p) {
        case None: {
            return 0;
        }
        case Both(int a): {
            return a;
        }
    }
}

print(first(Pair.Both(1, "x")));
