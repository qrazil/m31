// One doubling past the cap: 2^21 bytes. Refused before the string is built,
// so a chain of doublings that would reach gigabytes cannot exhaust the
// compiler's memory first.
const str S0 = "0123456789abcdef";
const str S1 = S0 + S0;
const str S2 = S1 + S1;
const str S3 = S2 + S2;
const str S4 = S3 + S3;
const str S5 = S4 + S4;
const str S6 = S5 + S5;
const str S7 = S6 + S6;
const str S8 = S7 + S7;
const str S9 = S8 + S8;
const str S10 = S9 + S9;
const str S11 = S10 + S10;
const str S12 = S11 + S11;
const str S13 = S12 + S12;
const str S14 = S13 + S13;
const str S15 = S14 + S14;
const str S16 = S15 + S15;
const str S17 = S16 + S16;
const str S18 = S17 + S17;
const str S39 = S18 + S18;
print(S39.size());
