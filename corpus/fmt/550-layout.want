// A fixture for `m31c fmt`: laid out badly on purpose. 550-layout.want is
// the layout the formatter must produce, written by hand.

// --- shapes ---

// A point on the grid.
type Point {
    int x;
    int y;
}

// --- Point's methods: a divider inside a type's group stays put ---

int Point.sum() {
    return x + y;
}  // on the closing line

// scattered: joins Point, taking this comment and no other
int Point.dist() {
    int d = sum();
    for (int i in [1, 2]) {
        d = d + i;  // twice
    }
    while (d > 100) {
        d = d - 100;
        // wrapped
    }
    return d;
}

type Cell {
    int v;
}

// declared above its type: moves below it
int Cell.get() {
    return v;
}

// --- free functions ---

int sign(int n) {
    if (n < 0) {
        return -1;  // negative
    } else if (n == 0) {
        return 0;  // zero
    } else {
        return 1;  // positive
    }
}

enum Shape {
    Dot;
    Line(int);
}

int size(Shape s) {
    match (s) {
        case Dot: {
            return 0;  // a dot
        }
        case Line(int n): {
            return n;
        }
        // no third shape
    }
}

// --- the program ---

print(sign(-4));
print(Point(1, 2).dist());
print(size(Shape.Line(3)));
print(Cell(7).get());
