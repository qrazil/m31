// A fixture for `m31c fmt`: every integer literal keeps its spelling. The
// value alone would print `0o755` as 493 and `1_000_000` as 1000000, and the
// author chose those spellings to be read.
int perm = 0o755;
int mask = 0xFFFF_FFFF_FFFF_FFFF;
int flags = 0b1010_0101 | 0x0F;
int big = 1_000_000;
bytes b = [0x00, 0x7f, 0xFF];
print(perm);
print(mask);
print(flags);
print(big);
print(b[2] - 0xFe);
