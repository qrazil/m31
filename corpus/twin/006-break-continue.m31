int first_square_over(int limit) {
    int i = 0;
    while (i < 1000) {
        if (i * i > limit) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

print(first_square_over(50));

// break out with a value carried past the loop
int i = 0;
int found = 0;
while (i < 100) {
    if (i * i > 50) {
        found = i;
        break;
    }
    i = i + 1;
}
print(found);

// continue skips the accumulate
int j = 0;
int odd = 0;
while (j < 10) {
    j = j + 1;
    if (j % 2 == 0) {
        continue;
    }
    odd = odd + j;
}
print(odd);

// break in a nested loop leaves only the inner one
int a = 0;
int hits = 0;
while (a < 4) {
    int b = 0;
    while (b < 4) {
        if (b == 2) {
            break;
        }
        hits = hits + 1;
        b = b + 1;
    }
    a = a + 1;
}
print(hits);
