// Go agrees with us on what each bit operation does to an int64 -- `>>` is
// arithmetic, `<<` discards what falls off, `^x` is our `~x` -- but not on
// precedence, so the twin writes its parentheses out and this file does not.
// Go's `*` wraps where ours traps, which is exactly `wrapping_mul`.

int x = 1234567;
print(x & 255 | 4096);
print(x ^ x >> 3);
print(~x & 65535);
print(x << 40 >> 20);
print(-x >> 5);
print(-x << 50);
print(x & 1 == 1);

// A little mixing function, run until the bits are thoroughly stirred.
int h = 17;
int i = 0;
while (i < 20) {
    h = h ^ h << 7;
    h = h ^ h >> 9;
    h = h.wrapping_mul(-7046029254386353131).wrapping_add(i);
    i = i + 1;
}
print(h);

// Population count, the slow way.
int v = -1234567;
int n = 0;
int k = 0;
while (k < 64) {
    n = n + (v >> k & 1);
    k = k + 1;
}
print(n);
