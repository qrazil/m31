type Pair<A, B> {
    A first;
    B second;
}

A left<A, B>(Pair<A, B> p) {
    return p.first;
}

void main() {
    Pair<int, int> a = Pair<int, int>(first: 12, second: 30);
    print(left(a));
    print(a.second % 7);

    Pair<int, bool> b = Pair<int, bool>(first: -5, second: true);
    print(left(b) * 3);
}
