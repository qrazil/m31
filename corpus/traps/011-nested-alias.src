// A unique wrapper around a SHARED reference. Each Holder really is unique,
// so a check that looked only at the moved object let this through -- and
// every Holder pointed at one Str whose non-atomic refcount was then
// touched from several threads at once.
type Holder { str s; }

void eat(Holder h, int n) {
    int i = 0;
    int t = 0;
    while (i < n) {
        str x = h.s;
        t = t + len(x);
        i = i + 1;
    }
}

str shared = concat("ab", "cd");
int k = 0;
while (k < 8) {
    spawn eat(Holder(shared), 200000);
    k = k + 1;
}
print(len(shared));
