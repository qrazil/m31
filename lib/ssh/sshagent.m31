// An ssh-agent client (draft-miller-ssh-agent): list the Ed25519 identities
// an agent holds and have it sign, so a private key never has to be read by
// this process.
//
// API
// ---
//   sshagent.connect(path)            -> Result<Agent, Error>
//   sshagent.from_environment()       -> Result<Agent, Error>   $SSH_AUTH_SOCK
//   agent.identities()                -> Result<List<Identity>, Error>
//   sshagent.AgentSigner(path, blob)  an sshauth.Signer over a fresh connection
//   agent.sign(blob, data)            -> Result<bytes, Error>   signature blob
//   sshagent.build_identities_request() / parse_identities(payload)
//   sshagent.build_sign_request(blob, data) / parse_sign_response(payload)
//
// Identities of the key types this client can use (`ssh-ed25519`,
// `ecdsa-sha2-nistp256`, `ssh-rsa`) are kept; others the agent holds are
// skipped. A signature the agent returns is **verified against the public
// key before it is used** (a new check on every type), so a confused agent
// cannot make this client send garbage and a wrong one is reported as
// `BadSignature`, not as a server refusal. For RSA the request carries the
// SHA-2 flag (2 for `rsa-sha2-256`, 4 for `rsa-sha2-512`); `ssh-rsa`
// (SHA-1) signatures are never requested and never accepted.
//
// The agent is trusted with signing and nothing else: no message is sent
// that is not REQUEST_IDENTITIES or SIGN_REQUEST (flags 0), no key is ever
// added, removed or locked here, and a reply longer than 262144 bytes is
// refused rather than buffered. Every read of the agent is bounded by a
// 10-second wait: a hung agent is `Error.TimedOut`, not a hung client.
//
// The socket is a plain blocking AF_UNIX stream used through the runtime's
// own primitives (`lib/net.m31` is TCP only); one request is in flight at a
// time.

import os;
import crypto.ed25519;
import crypto.ecdsa;
import crypto.rsa;
import crypto.sha256;
import crypto.sha512;
import ssh;
import ssh.sshauth;

prim int __socket(int domain, int kind, int protocol);
prim int __connect_path(int file_descriptor, str path);
prim int __read(int file_descriptor, bytes buffer, int off, int byte_count);
prim int __write(int file_descriptor, bytes buffer, int off, int byte_count);
prim int __close(int file_descriptor);
prim int __wait_io_timeout(int file_descriptor, int events, int timeout_ms);
prim int __ignore_sigpipe();

const int AF_UNIX = 1;
const int SOCK_STREAM = 1;
const int IO_READABLE = 1;
const int MAX_REPLY = 262144;
const int WAIT_MS = 10000;
const int AGENT_FAILURE = 5;
const int AGENT_REQUEST_IDENTITIES = 11;
const int AGENT_IDENTITIES_ANSWER = 12;
const int AGENT_SIGN_REQUEST = 13;
const int AGENT_SIGN_RESPONSE = 14;
const str KEY_TYPE = "ssh-ed25519";

pub enum Error {
    /// `SSH_AUTH_SOCK` is not set.
    NoAgent;
    /// The socket could not be reached.
    Connect;
    /// The connection to the agent failed or closed part way.
    Io;
    /// The agent did not answer within ten seconds.
    TimedOut;
    /// The agent answered with something that is not valid for the request.
    BadReply;
    /// The agent refused (SSH_AGENT_FAILURE), e.g. a key it does not hold.
    Refused;
    /// The signature the agent returned does not verify under the key.
    BadSignature;
}

pub str Error.to_str() {
    match (this) {
        case NoAgent: {
            return "SSH_AUTH_SOCK is not set";
        }
        case Connect: {
            return "could not connect to the ssh-agent socket";
        }
        case Io: {
            return "the ssh-agent connection failed";
        }
        case TimedOut: {
            return "the ssh-agent did not answer";
        }
        case BadReply: {
            return "the ssh-agent sent a malformed reply";
        }
        case Refused: {
            return "the ssh-agent refused the request";
        }
        case BadSignature: {
            return "the ssh-agent returned a signature that does not verify";
        }
    }
}

/// One identity an agent holds.
pub type Identity {
    /// The public key blob (`string "ssh-ed25519", string key`).
    pub bytes blob;
    /// The agent's comment for it.
    pub str comment;
}

void push_u32(bytes out, int value) {
    out.push(value >> 24 & 0xFF);
    out.push(value >> 16 & 0xFF);
    out.push(value >> 8 & 0xFF);
    out.push(value & 0xFF);
}

// --- pure message builders and parsers ---------------------------------------

pub bytes build_identities_request() {
    return [AGENT_REQUEST_IDENTITIES];
}

pub bytes build_sign_request(bytes blob, bytes data) {
    return build_sign_request_flags(blob, data, 0);
}

/// `SIGN_REQUEST` with the RFC 8332 flags (2: rsa-sha2-256, 4: rsa-sha2-512).
pub bytes build_sign_request_flags(bytes blob, bytes data, int flags) {
    bytes out = [];
    out.push(AGENT_SIGN_REQUEST);
    ssh.push_string(out, blob);
    ssh.push_string(out, data);
    push_u32(out, flags);
    return out;
}

Result<ssh.Field, Error> field_at(bytes buffer, int offset) {
    match (ssh.parse_string(buffer, offset)) {
        case Ok(ssh.Field field): {
            return Result<ssh.Field, Error>.Ok(field);
        }
        case Err(_): {
            return Result<ssh.Field, Error>.Err(Error.BadReply);
        }
    }
}

// The key type named by a public key blob, or "" if the blob is not a
// well-formed `string type, ...`.
str blob_type(bytes blob) {
    match (ssh.parse_string(blob, 0)) {
        case Ok(ssh.Field field): {
            match (field.value.utf8()) {
                case Some(str name): {
                    return name;
                }
                case None: {
                    return "";
                }
            }
        }
        case Err(_): {
            return "";
        }
    }
}

bool is_usable_type(str name) {
    return name == KEY_TYPE || name == "ecdsa-sha2-nistp256" || name == "ssh-rsa";
}

/// An `IDENTITIES_ANSWER`, keeping only identities of a usable key type.
pub Result<List<Identity>, Error> parse_identities(bytes payload) {
    if (payload.size() < 5 || payload[0] != AGENT_IDENTITIES_ANSWER) {
        return Result<List<Identity>, Error>.Err(Error.BadReply);
    }
    int count = (payload[1] << 24) | (payload[2] << 16) | (payload[3] << 8) | payload[4];
    // Each entry is at least two length prefixes.
    if (count > (payload.size() - 5) / 8) {
        return Result<List<Identity>, Error>.Err(Error.BadReply);
    }
    List<Identity> out = [];
    int offset = 5;
    int index = 0;
    while (index < count) {
        ssh.Field blob = field_at(payload, offset)?;
        ssh.Field comment = field_at(payload, blob.next)?;
        offset = comment.next;
        if (is_usable_type(blob_type(blob.value))) {
            str text = "";
            match (comment.value.utf8()) {
                case Some(str value): {
                    text = value;
                }
                case None: {
                }
            }
            out.push(Identity(blob.value, text));
        }
        index = index + 1;
    }
    return Result<List<Identity>, Error>.Ok(out);
}

/// A `SIGN_RESPONSE`'s signature blob (`string algorithm, string data`),
/// checked for shape: the algorithm name and the data are returned.
pub type AgentSignature {
    pub str algorithm;
    pub bytes data;
}

pub Result<AgentSignature, Error> parse_sign_response_full(bytes payload) {
    if (payload.size() >= 1 && payload[0] == AGENT_FAILURE) {
        return Result<AgentSignature, Error>.Err(Error.Refused);
    }
    if (payload.size() < 1 || payload[0] != AGENT_SIGN_RESPONSE) {
        return Result<AgentSignature, Error>.Err(Error.BadReply);
    }
    ssh.Field outer = field_at(payload, 1)?;
    if (outer.next != payload.size()) {
        return Result<AgentSignature, Error>.Err(Error.BadReply);
    }
    ssh.Field kind = field_at(outer.value, 0)?;
    ssh.Field raw = field_at(outer.value, kind.next)?;
    if (raw.next != outer.value.size()) {
        return Result<AgentSignature, Error>.Err(Error.BadReply);
    }
    match (kind.value.utf8()) {
        case Some(str name): {
            return Result<AgentSignature, Error>.Ok(AgentSignature(name, raw.value));
        }
        case None: {
            return Result<AgentSignature, Error>.Err(Error.BadReply);
        }
    }
}

/// An ed25519 `SIGN_RESPONSE`'s 64 raw octets (kept for its callers and
/// tests; `Agent.sign` accepts every key type).
pub Result<bytes, Error> parse_sign_response(bytes payload) {
    AgentSignature signature = parse_sign_response_full(payload)?;
    if (signature.algorithm != KEY_TYPE || signature.data.size() != 64) {
        return Result<bytes, Error>.Err(Error.BadReply);
    }
    return Result<bytes, Error>.Ok(signature.data);
}

// --- the connection ----------------------------------------------------------

pub type Agent {
    int descriptor;
    bool is_live = true;
}

void Agent.drop() {
    if (is_live) {
        is_live = false;
        int ignored = __close(descriptor);
    }
}

Result<void, Error> Agent.write_all(bytes data) {
    int sent = 0;
    while (sent < data.size()) {
        int written = __write(descriptor, data, sent, data.size() - sent);
        if (written == -4) {
            continue;
        }
        if (written <= 0) {
            return Result<void, Error>.Err(Error.Io);
        }
        sent = sent + written;
    }
    return Result<void, Error>.Ok;
}

Result<bytes, Error> Agent.read_exact(int count) {
    bytes out = [];
    while (out.size() < count) {
        int ready = __wait_io_timeout(descriptor, IO_READABLE, WAIT_MS);
        if (ready < 0) {
            return Result<bytes, Error>.Err(Error.Io);
        }
        if (ready == 1) {
            return Result<bytes, Error>.Err(Error.TimedOut);
        }
        bytes chunk = [0; count - out.size()];
        int got = __read(descriptor, chunk, 0, chunk.size());
        if (got == -4) {
            continue;
        }
        if (got <= 0) {
            return Result<bytes, Error>.Err(Error.Io);
        }
        out.extend(chunk.substr(0, got));
    }
    return Result<bytes, Error>.Ok(out);
}

Result<bytes, Error> Agent.call(bytes request) {
    bytes framed = [];
    push_u32(framed, request.size());
    framed.extend(request);
    write_all(framed)?;
    bytes header = read_exact(4)?;
    int length = (header[0] << 24) | (header[1] << 16) | (header[2] << 8) | header[3];
    if (length < 1 || length > MAX_REPLY) {
        return Result<bytes, Error>.Err(Error.BadReply);
    }
    return read_exact(length);
}

/// The Ed25519 identities the agent holds.
pub Result<List<Identity>, Error> Agent.identities() {
    bytes reply = call(build_identities_request())?;
    return parse_identities(reply);
}

/// Has the agent sign `data` with the key whose blob is `blob`, using the
/// signature `algorithm` (`ssh-ed25519`, `ecdsa-sha2-nistp256`,
/// `rsa-sha2-256`, `rsa-sha2-512`); the answer is the signature blob ready
/// for USERAUTH_REQUEST, **verified under the key** before it is returned.
pub Result<bytes, Error> Agent.sign_for(bytes blob, bytes data, str algorithm) {
    int flags = 0;
    if (algorithm == "rsa-sha2-256") {
        flags = 2;
    } else if (algorithm == "rsa-sha2-512") {
        flags = 4;
    }
    bytes reply = call(build_sign_request_flags(blob, data, flags))?;
    AgentSignature signature = parse_sign_response_full(reply)?;
    if (signature.algorithm != algorithm) {
        return Result<bytes, Error>.Err(Error.BadReply);
    }
    match (ssh.parse_host_key(blob)) {
        case Ok(ssh.HostKey key): {
            if (key.algorithm == KEY_TYPE) {
                if (algorithm != KEY_TYPE || signature.data.size() != 64 || !ed25519.is_valid_signature(key.key, data, signature.data)) {
                    return Result<bytes, Error>.Err(Error.BadSignature);
                }
            } else if (key.algorithm == "ecdsa-sha2-nistp256") {
                bytes raw = ecdsa_raw(signature.data);
                match (ecdsa.parse_public_key(ecdsa.p256(), key.key)) {
                    case Some(ecdsa.PublicKey point): {
                        if (algorithm != key.algorithm || raw.size() != 64 || !ecdsa.is_valid_raw_signature(ecdsa.p256(), point, sha256.sum(data), raw)) {
                            return Result<bytes, Error>.Err(Error.BadSignature);
                        }
                    }
                    case None: {
                        return Result<bytes, Error>.Err(Error.BadSignature);
                    }
                }
            } else {
                // ssh-rsa: modulus and exponent out of the blob.
                ssh.Field type_field = field_at(blob, 0)?;
                ssh.Field e_field = field_at(blob, type_field.next)?;
                ssh.Field n_field = field_at(blob, e_field.next)?;
                rsa.Hash hash = rsa.Hash.Sha256;
                bytes digest = sha256.sum(data);
                if (algorithm == "rsa-sha2-512") {
                    hash = rsa.Hash.Sha512;
                    digest = sha512.sum(data);
                } else if (algorithm != "rsa-sha2-256") {
                    return Result<bytes, Error>.Err(Error.BadSignature);
                }
                match (rsa.parse_public_key(n_field.value, e_field.value)) {
                    case Some(rsa.PublicKey public_key): {
                        if (!rsa.is_valid_pkcs1_v15_signature(public_key, hash, digest, signature.data)) {
                            return Result<bytes, Error>.Err(Error.BadSignature);
                        }
                    }
                    case None: {
                        return Result<bytes, Error>.Err(Error.BadSignature);
                    }
                }
            }
        }
        case Err(_): {
            return Result<bytes, Error>.Err(Error.BadSignature);
        }
    }
    bytes out = [];
    ssh.push_string(out, algorithm.to_bytes());
    ssh.push_string(out, signature.data);
    return Result<bytes, Error>.Ok(out);
}

/// `sign_for` with `ssh-ed25519`.
pub Result<bytes, Error> Agent.sign(bytes blob, bytes data) {
    return sign_for(blob, data, KEY_TYPE);
}

/// Connects to the agent listening at `path`.
pub Result<Agent, Error> connect(str path) {
    int ignored = __ignore_sigpipe();
    int descriptor = __socket(AF_UNIX, SOCK_STREAM, 0);
    if (descriptor < 0) {
        return Result<Agent, Error>.Err(Error.Connect);
    }
    if (__connect_path(descriptor, path) < 0) {
        int closed = __close(descriptor);
        return Result<Agent, Error>.Err(Error.Connect);
    }
    return Result<Agent, Error>.Ok(Agent(descriptor));
}

/// The agent named by `$SSH_AUTH_SOCK`.
pub Result<Agent, Error> from_environment() {
    match (os.env("SSH_AUTH_SOCK")) {
        case Some(str path): {
            if (path == "") {
                return Result<Agent, Error>.Err(Error.NoAgent);
            }
            return connect(path);
        }
        case None: {
            return Result<Agent, Error>.Err(Error.NoAgent);
        }
    }
}

// The ECDSA signature data (`mpint r, mpint s`) as raw 64 octets, or empty.
bytes ecdsa_raw(bytes data) {
    bytes none = [];
    match (ssh.parse_string(data, 0)) {
        case Ok(ssh.Field r_field): {
            match (ssh.parse_string(data, r_field.next)) {
                case Ok(ssh.Field s_field): {
                    if (s_field.next != data.size() || r_field.value.size() == 0 || s_field.value.size() == 0) {
                        return none;
                    }
                    if ((r_field.value[0] & 0x80) != 0 || (s_field.value[0] & 0x80) != 0) {
                        return none;
                    }
                    bytes r_value = strip_zeros(r_field.value);
                    bytes s_value = strip_zeros(s_field.value);
                    if (r_value.size() > 32 || s_value.size() > 32) {
                        return none;
                    }
                    bytes raw = [0; 32 - r_value.size()];
                    raw.extend(r_value);
                    bytes pad_s = [0; 32 - s_value.size()];
                    raw.extend(pad_s);
                    raw.extend(s_value);
                    return raw;
                }
                case Err(_): {
                    return none;
                }
            }
        }
        case Err(_): {
            return none;
        }
    }
}

bytes strip_zeros(bytes value) {
    int start = 0;
    while (start < value.size() - 1 && value[start] == 0) {
        start = start + 1;
    }
    return value.substr(start, value.size());
}

/// An `sshauth.Signer` for one identity: each signature opens a fresh
/// connection to the agent at `path` (an `Agent` owns a descriptor and a
/// signer is a plain value), asks, and hangs up.
pub type AgentSigner {
    pub str path;
    pub bytes blob;
}

pub Result<bytes, str> AgentSigner.sign_blob(bytes message, str algorithm) {
    match (connect(path)) {
        case Ok(Agent agent): {
            match (agent.sign_for(blob, message, algorithm)) {
                case Ok(bytes signature): {
                    return Result<bytes, str>.Ok(signature);
                }
                case Err(Error error): {
                    return Result<bytes, str>.Err(error.to_str());
                }
            }
        }
        case Err(Error error): {
            return Result<bytes, str>.Err(error.to_str());
        }
    }
}
