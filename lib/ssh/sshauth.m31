// SSH Phase 3 (`docs/ssh-decision.md`): RFC 4252 publickey authentication
// with an Ed25519 key, run over a finished transport (`lib/ssh.m31`).
//
// API
// ---
//   sshauth.authenticate(link, user, key)  -> Result<str, Error>
//   sshauth.authenticate_as(link, user, public_blob, signer) -> Result<str, Error>
//
// `link` is anything satisfying `ssh.Link` -- in practice an `ssh.Transport`.
// `key` is an `sshkey.PrivateKey`. `Ok` carries the text of any
// `SSH_MSG_USERAUTH_BANNER` the server sent along the way ("" if none): a
// pre-login notice is the server's to show, and this library does not print.
// The server is trusted only as far as the host-key check the transport
// already did; nothing here weakens or repeats it.
//
// --- the exchange (RFC 4252 §5, §7) -----------------------------------------
//
//   C: SSH_MSG_SERVICE_REQUEST "ssh-userauth"     S: SSH_MSG_SERVICE_ACCEPT
//   C: USERAUTH_REQUEST user "ssh-connection" "publickey" FALSE alg blob
//   S: USERAUTH_PK_OK alg blob          (the key is acceptable)
//      or USERAUTH_FAILURE              (it is not: unknown user, key not
//                                        authorized, method not offered)
//   C: USERAUTH_REQUEST ... "publickey" TRUE alg blob signature
//   S: USERAUTH_SUCCESS  or  USERAUTH_FAILURE (the signature was refused)
//
// The first request asks without signing -- RFC 4252 §7's own probe, which
// is what makes `PK_OK` a message this client really receives, and splits a
// refused key (`Error.KeyRejected`: nothing was signed or proven) from a
// refused signature (`Error.AuthFailed`). `SSH_MSG_USERAUTH_BANNER` may
// arrive at any point before the end and is collected, never mistaken for an
// answer. The signature covers (§7) `string session_id || byte 50 || string
// user || string "ssh-connection" || string "publickey" || boolean TRUE ||
// string "ssh-ed25519" || string public_key_blob`, so it cannot be replayed
// on another connection (the session id is this connection's exchange hash)
// or for another user.
//
// A server that wants more than one method (`partial success`) cannot be
// satisfied by a publickey-only client: that too is `Error.AuthFailed`.

import ssh;
import ssh.sshkey;

/// Why authentication did not complete.
pub enum Error {
    /// The transport failed underneath (a reset, a MAC failure, a
    /// disconnect); the `ssh.Error` says which.
    Transport(ssh.Error);
    /// A server message named more bytes than it held.
    Truncated;
    /// A message type that cannot appear at this step (including a
    /// `SERVICE_ACCEPT` for some other service, or too many banners).
    UnexpectedMessage;
    /// A message arrived with the right type but a wrong content: a `PK_OK`
    /// for a different key than the one offered, or a banner that is not
    /// UTF-8.
    BadMessage;
    /// The server answered the unsigned probe with `USERAUTH_FAILURE`: it
    /// does not accept this key for this user (unknown user, key not in
    /// `authorized_keys`, or publickey not offered). Nothing was signed.
    KeyRejected;
    /// The server answered the signed request with `USERAUTH_FAILURE`, or
    /// asked for a further method this client does not have.
    AuthFailed;
}

pub str Error.to_str() {
    match (this) {
        case Transport(ssh.Error e): {
            return "the connection failed during authentication: " + e.to_str();
        }
        case Truncated: {
            return "an authentication message named more bytes than arrived";
        }
        case UnexpectedMessage: {
            return "an unexpected message type arrived during authentication";
        }
        case BadMessage: {
            return "an authentication message was malformed";
        }
        case KeyRejected: {
            return "the server does not accept this key for this user";
        }
        case AuthFailed: {
            return "the server refused the signed authentication request";
        }
    }
}

pub const int SSH_MSG_USERAUTH_REQUEST = 50;
pub const int SSH_MSG_USERAUTH_FAILURE = 51;
pub const int SSH_MSG_USERAUTH_SUCCESS = 52;
pub const int SSH_MSG_USERAUTH_BANNER = 53;
pub const int SSH_MSG_USERAUTH_PK_OK = 60;
const str SERVICE_NAME = "ssh-userauth";
const str CONNECTION_SERVICE = "ssh-connection";
const str METHOD = "publickey";
const str KEY_ALGO = "ssh-ed25519";
/// More banners than this in one authentication is a server playing games,
/// not a notice.
const int MAX_BANNERS = 32;

// --- Part 0: message builders (pure) ----------------------------------------

/// `SSH_MSG_SERVICE_REQUEST "ssh-userauth"` (RFC 4253 §10).
pub bytes build_service_request() {
    bytes out = [];
    out.push(ssh.SSH_MSG_SERVICE_REQUEST);
    ssh.push_string(out, SERVICE_NAME.to_bytes());
    return out;
}

// The body every `publickey` request shares, up to and including the key
// blob (RFC 4252 §7), with `have_sig` as the boolean.
bytes request_prefix(str user, bool have_sig, bytes public_blob) {
    bytes out = [];
    out.push(SSH_MSG_USERAUTH_REQUEST);
    ssh.push_string(out, user.to_bytes());
    ssh.push_string(out, CONNECTION_SERVICE.to_bytes());
    ssh.push_string(out, METHOD.to_bytes());
    if (have_sig) {
        out.push(1);
    } else {
        out.push(0);
    }
    ssh.push_string(out, KEY_ALGO.to_bytes());
    ssh.push_string(out, public_blob);
    return out;
}

/// The unsigned probe: "would you accept this key for this user?"
pub bytes build_query(str user, bytes public_blob) {
    return request_prefix(user, false, public_blob);
}

/// What the signature covers (RFC 4252 §7): the session id as a `string`,
/// then the signed request's body without the signature itself.
pub bytes signature_data(bytes session_id, str user, bytes public_blob) {
    bytes out = [];
    ssh.push_string(out, session_id);
    out.extend(request_prefix(user, true, public_blob));
    return out;
}

/// The signed request: the same fields as the probe with the boolean set,
/// followed by the signature blob as one more `string`.
pub bytes build_signed_request(str user, bytes public_blob, bytes signature_blob) {
    bytes out = request_prefix(user, true, public_blob);
    ssh.push_string(out, signature_blob);
    return out;
}

// --- Part 1: message parsers (pure, every read bounds-checked) -------------

/// `USERAUTH_FAILURE`: the methods that can continue, and `partial success`.
pub type Failure {
    pub List<str> methods;
    pub bool partial_success;
}

pub Result<Failure, Error> parse_failure(bytes payload) {
    if (payload.size() < 1 || payload[0] != SSH_MSG_USERAUTH_FAILURE) {
        return Result<Failure, Error>.Err(Error.UnexpectedMessage);
    }
    ssh.NameList names = name_list_at(payload, 1)?;
    if (names.next + 1 > payload.size()) {
        return Result<Failure, Error>.Err(Error.Truncated);
    }
    return Result<Failure, Error>.Ok(Failure(names.names, payload[names.next] != 0));
}

/// `USERAUTH_BANNER`: the message text (UTF-8). The language tag after it is
/// parsed for bounds and dropped.
pub Result<str, Error> parse_banner(bytes payload) {
    if (payload.size() < 1 || payload[0] != SSH_MSG_USERAUTH_BANNER) {
        return Result<str, Error>.Err(Error.UnexpectedMessage);
    }
    ssh.Field message = string_at(payload, 1)?;
    string_at(payload, message.next)?;
    match (message.value.utf8()) {
        case Some(str text): {
            return Result<str, Error>.Ok(text);
        }
        case None: {
            return Result<str, Error>.Err(Error.BadMessage);
        }
    }
}

/// `USERAUTH_PK_OK`: it must echo the algorithm and key blob that were
/// offered, byte for byte.
pub Result<bool, Error> parse_pk_ok(bytes payload, bytes public_blob) {
    if (payload.size() < 1 || payload[0] != SSH_MSG_USERAUTH_PK_OK) {
        return Result<bool, Error>.Err(Error.UnexpectedMessage);
    }
    ssh.Field algo = string_at(payload, 1)?;
    ssh.Field blob = string_at(payload, algo.next)?;
    if (algo.value != KEY_ALGO.to_bytes() || blob.value != public_blob) {
        return Result<bool, Error>.Err(Error.BadMessage);
    }
    return Result<bool, Error>.Ok(true);
}

/// `SERVICE_ACCEPT` for `ssh-userauth`.
pub Result<bool, Error> parse_service_accept(bytes payload) {
    if (payload.size() < 1 || payload[0] != ssh.SSH_MSG_SERVICE_ACCEPT) {
        return Result<bool, Error>.Err(Error.UnexpectedMessage);
    }
    ssh.Field name = string_at(payload, 1)?;
    if (name.value != SERVICE_NAME.to_bytes()) {
        return Result<bool, Error>.Err(Error.UnexpectedMessage);
    }
    return Result<bool, Error>.Ok(true);
}

Result<ssh.Field, Error> string_at(bytes buf, int at) {
    match (ssh.parse_string(buf, at)) {
        case Ok(ssh.Field f): {
            return Result<ssh.Field, Error>.Ok(f);
        }
        case Err(ssh.Error e): {
            return Result<ssh.Field, Error>.Err(Error.Truncated);
        }
    }
}

Result<ssh.NameList, Error> name_list_at(bytes buf, int at) {
    match (ssh.parse_name_list(buf, at)) {
        case Ok(ssh.NameList n): {
            return Result<ssh.NameList, Error>.Ok(n);
        }
        case Err(ssh.Error e): {
            return Result<ssh.NameList, Error>.Err(Error.Truncated);
        }
    }
}

// --- Part 2: the exchange ----------------------------------------------------

Result<void, Error> send_message(ssh.Link link, bytes payload) {
    match (link.send(payload)) {
        case Ok(int n): {
            return Result<void, Error>.Ok;
        }
        case Err(ssh.Error e): {
            return Result<void, Error>.Err(Error.Transport(e));
        }
    }
}

Result<bytes, Error> recv_message(ssh.Link link) {
    match (link.recv()) {
        case Ok(bytes payload): {
            return Result<bytes, Error>.Ok(payload);
        }
        case Err(ssh.Error e): {
            return Result<bytes, Error>.Err(Error.Transport(e));
        }
    }
}

/// Authenticates as `user` with `key` over `link`. `Ok` is the server's
/// banner text, possibly empty.
pub Result<str, Error> authenticate(ssh.Link link, str user, sshkey.PrivateKey key) {
    return authenticate_as(link, user, key.public_blob(), key);
}

/// As `authenticate`, but the key blob announced (and echoed back in the
/// signed data) is `public_blob`, signed by `signer`. `authenticate` passes
/// the signer's own public blob; the two differ only in a test that proves a
/// signature by the wrong key is refused.
pub Result<str, Error> authenticate_as(ssh.Link link, str user, bytes public_blob, sshkey.PrivateKey signer) {
    send_message(link, build_service_request())?;
    bytes accept = recv_message(link)?;
    parse_service_accept(accept)?;
    send_message(link, build_query(user, public_blob))?;
    str banner = "";
    int seen = 0;
    bool probed = false;
    while (!probed) {
        bytes reply = recv_message(link)?;
        if (reply.size() == 0) {
            return Result<str, Error>.Err(Error.Truncated);
        }
        int kind = reply[0];
        if (kind == SSH_MSG_USERAUTH_BANNER) {
            seen = seen + 1;
            if (seen > MAX_BANNERS) {
                return Result<str, Error>.Err(Error.UnexpectedMessage);
            }
            banner = banner + parse_banner(reply)?;
        } else if (kind == SSH_MSG_USERAUTH_PK_OK) {
            parse_pk_ok(reply, public_blob)?;
            probed = true;
        } else if (kind == SSH_MSG_USERAUTH_FAILURE) {
            parse_failure(reply)?;
            return Result<str, Error>.Err(Error.KeyRejected);
        } else {
            return Result<str, Error>.Err(Error.UnexpectedMessage);
        }
    }
    bytes signed_data = signature_data(link.session_id(), user, public_blob);
    bytes signature = signer.signature_blob(signed_data);
    send_message(link, build_signed_request(user, public_blob, signature))?;
    while (true) {
        bytes reply = recv_message(link)?;
        if (reply.size() == 0) {
            return Result<str, Error>.Err(Error.Truncated);
        }
        int kind = reply[0];
        if (kind == SSH_MSG_USERAUTH_BANNER) {
            seen = seen + 1;
            if (seen > MAX_BANNERS) {
                return Result<str, Error>.Err(Error.UnexpectedMessage);
            }
            banner = banner + parse_banner(reply)?;
        } else if (kind == SSH_MSG_USERAUTH_SUCCESS) {
            return Result<str, Error>.Ok(banner);
        } else if (kind == SSH_MSG_USERAUTH_FAILURE) {
            parse_failure(reply)?;
            return Result<str, Error>.Err(Error.AuthFailed);
        } else {
            return Result<str, Error>.Err(Error.UnexpectedMessage);
        }
    }
}
