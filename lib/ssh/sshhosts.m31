// SSH host-key handling (`docs/ssh-decision.md` §1 left "where the expected
// host key comes from" to the caller): an OpenSSH `known_hosts` reader that
// answers one question -- which `ssh-ed25519` keys does this file trust for
// `host:port` -- and hands the answer to `ssh.connect_any`.
//
// API
// ---
//   sshhosts.parse(text)        -> Result<KnownHosts, Error>
//   sshhosts.load(path)         -> Result<KnownHosts, Error>
//   kh.keys_for(host, port)     -> Result<List<bytes>, Error>   32-octet keys
//   kh.is_revoked(host, port, key)              -> bool          ssh.HostKey
//   sshhosts.add(path, host, port, key, hashed)  -> Result<bool, Error>
//   sshhosts.plain_line(host, port, key)         -> str
//   sshhosts.hashed_line(host, port, key, salt)  -> str
//
// **No trust on first use.** A host with no entry is `Error.UnknownHost`;
// there is no "add it and carry on" path, and an empty result is never
// returned as success (`ssh.connect_any` also refuses an empty list, so a
// caller who ignores this module's error still cannot connect).
//
// **Asking a person is the caller's job, and `add` is what it does after a
// yes.** The flow OpenSSH calls "the authenticity of host ... can't be
// established": on `UnknownHost`, `ssh.presented_host_key(host, port)` says
// which key the server offers (`key.fingerprint()` is the `SHA256:...` string
// to show); if the person agrees, `add` appends it and the next connection
// succeeds -- through the same refusing check as any other. `add` writes
// whatever it is given: it asks nobody, and it does not look for an existing
// entry. So a caller must not call it
//   - for a host whose key *changed* (`ssh.Error.HostKeyMismatch`): that is a
//     refusal, which OpenSSH too leaves to the person to resolve by editing
//     the file; nor
//   - before checking `kh.is_revoked(host, port, key)`: a lone `@revoked`
//     line makes `keys_for` answer `UnknownHost`, not `Revoked`, so a prompt
//     would otherwise be shown for a key that can never be trusted.
//
// `add` writes plain `host key` lines by default (`[host]:port` for any port
// but 22, lower-cased -- exactly what `keys_for` matches) and, with
// `hashed: true`, OpenSSH's `HashKnownHosts` form (`|1|salt|HMAC-SHA1`, a
// fresh random 20-octet salt each time). Which to use is the caller's call;
// this module never reads `~/.ssh/config`.
//
// --- the format (sshd(8), "SSH_KNOWN_HOSTS FILE FORMAT") --------------------
//
//   [@marker] hostnames keytype base64-key [comment]
//
// `hostnames` is a comma-separated list of patterns: a plain host name
// (`example.com`) for port 22, `[host]:port` for any other port, `*` and `?`
// wildcards, a leading `!` to negate a pattern -- or a single hashed entry
// `|1|base64(salt)|base64(HMAC-SHA1(salt, name))` where `name` is spelled
// the same way (`host`, or `[host]:port`), which is what `ssh-keygen -H` and
// `HashKnownHosts yes` write. Any other pattern that starts with `|` (a
// different hash scheme, a hashed entry in a list) is a malformed line. Host names are compared case-insensitively.
//
// `@revoked` lines name keys that must never be accepted for a matching
// host: a key listed there is removed from the answer, and if that leaves
// nothing, the answer is `Error.Revoked` rather than `UnknownHost`. Lines
// marked `@cert-authority` describe certificate authorities, which this
// client does not support (it never negotiates a certificate algorithm), so
// they are skipped. Lines for key types other than `ssh-ed25519` are valid
// but useless to this client (it proposes only that host-key algorithm), so
// they are skipped too. A line that is not even well-formed is an error, not
// something to step over: a silently ignored `@revoked` line would turn into
// trust.
//
// Never reads or writes `~/.ssh`: the caller names the file.

import io;
import encoding.base64;
import crypto.sha1digest;
import fs;
import random;
import ssh;

/// Why a `known_hosts` file could not answer.
pub enum Error {
    /// The file could not be read.
    Io;
    /// A line is not `[marker] hostnames keytype key [comment]`, or a hashed
    /// host entry is not `|1|salt|hash` with a 20-octet hash.
    MalformedLine;
    /// An `ssh-ed25519` line whose key does not decode to a 32-octet
    /// Ed25519 public key.
    BadKey;
    /// No entry for this host and port.
    UnknownHost;
    /// Every key the file lists for this host is marked `@revoked`.
    Revoked;
    /// `add` could not create the file's directory or append to the file.
    Write;
}

pub str Error.to_str() {
    match (this) {
        case Io: {
            return "the known_hosts file could not be read";
        }
        case MalformedLine: {
            return "a known_hosts line is malformed";
        }
        case BadKey: {
            return "a known_hosts ssh-ed25519 key is malformed";
        }
        case UnknownHost: {
            return "the host is not listed in known_hosts";
        }
        case Revoked: {
            return "the host's key is revoked in known_hosts";
        }
        case Write: {
            return "the known_hosts file could not be written";
        }
    }
}

const str KEY_TYPE = "ssh-ed25519";
const str HASH_PREFIX = "|1|";
const int SHA1_SIZE = 20;
const int SHA1_BLOCK = 64;

type Entry {
    List<str> patterns;
    bytes key;
    bool is_revoked;
}

/// The ed25519 entries of one `known_hosts` file, in file order.
pub type KnownHosts {
    List<Entry> entries;
}

/// The 32-octet `ssh-ed25519` keys this file trusts for `host` on `port`,
/// minus any `@revoked` ones. `Err(UnknownHost)` if there are none because
/// the host is not listed, `Err(Revoked)` if there are none because every
/// listed key is revoked.
pub Result<List<bytes>, Error> KnownHosts.keys_for(str host, int port) {
    str id = host_id(host, port);
    List<bytes> keys = [];
    List<bytes> revoked_keys = [];
    for (Entry entry in entries) {
        if (!is_entry_match(entry.patterns, id)) {
            continue;
        }
        if (entry.is_revoked) {
            revoked_keys.push(entry.key);
        } else {
            keys.push(entry.key);
        }
    }
    List<bytes> usable = [];
    for (bytes key in keys) {
        bool is_revoked = false;
        for (bytes revoked_key in revoked_keys) {
            if (revoked_key == key) {
                is_revoked = true;
            }
        }
        if (!is_revoked) {
            usable.push(key);
        }
    }
    if (usable.size() == 0) {
        if (keys.size() > 0) {
            return Result<List<bytes>, Error>.Err(Error.Revoked);
        }
        return Result<List<bytes>, Error>.Err(Error.UnknownHost);
    }
    return Result<List<bytes>, Error>.Ok(usable);
}

/// Whether this file marks `key` `@revoked` for `host` on `port`. Ask this
/// before offering a person a "trust this key?" prompt: `keys_for` answers
/// `Revoked` only when a revoked key is also listed as trusted.
pub bool KnownHosts.is_revoked(str host, int port, ssh.HostKey key) {
    str id = host_id(host, port);
    for (Entry e in entries) {
        if (e.revoked && e.key == key.key && entry_matches(e.patterns, id)) {
            return true;
        }
    }
    return false;
}

// HMAC-SHA-1 (RFC 2104). Not in `lib/crypto/hmac.m31` (which has only the SHA-2
// family) and needed here for exactly one thing: OpenSSH hashes host names
// with it. It is a name-matching aid, not an authenticator -- the host key's
// signature, not this, is what authenticates a server.
bytes hmac_sha1(bytes key, bytes message) {
    bytes block_key = key;
    if (key.size() > SHA1_BLOCK) {
        block_key = sha1digest.sum(key);
    }
    bytes inner = [];
    bytes outer = [];
    int byte_index = 0;
    while (byte_index < SHA1_BLOCK) {
        int key_byte = 0;
        if (byte_index < block_key.size()) {
            key_byte = block_key[byte_index];
        }
        inner.push(key_byte ^ 0x36);
        outer.push(key_byte ^ 0x5C);
        byte_index = byte_index + 1;
    }
    inner.extend(message);
    outer.extend(sha1digest.sum(inner));
    return sha1digest.sum(outer);
}

// A glob with `*` (any run, including none) and `?` (any one byte).
bool is_glob_match(str pattern, int pattern_index, str text, int text_index) {
    while (pattern_index < pattern.size()) {
        int pattern_byte = pattern.byte_at(pattern_index);
        if (pattern_byte == '*') {
            int skip = text_index;
            while (skip <= text.size()) {
                if (is_glob_match(pattern, pattern_index + 1, text, skip)) {
                    return true;
                }
                skip = skip + 1;
            }
            return false;
        }
        if (text_index >= text.size()) {
            return false;
        }
        if (pattern_byte != '?' && pattern_byte != text.byte_at(text_index)) {
            return false;
        }
        pattern_index = pattern_index + 1;
        text_index = text_index + 1;
    }
    return text_index == text.size();
}

// How OpenSSH spells the name it matches and hashes: the bare host for port
// 22, `[host]:port` otherwise.
str host_id(str host, int port) {
    if (port == 22) {
        return host.to_lower();
    }
    return "[" + host.to_lower() + "]:" + port.to_str();
}

// `|1|salt|hash` decoded to its salt and hash; `None` if it is not that.
Option<List<bytes>> parse_hashed(str pattern) {
    List<str> parts = pattern.split("|");
    if (parts.size() != 4 || parts[0] != "" || parts[1] != "1") {
        return Option<List<bytes>>.None;
    }
    bytes salt = [];
    bytes hash = [];
    match (base64.decode(parts[2])) {
        case Ok(bytes decoded_salt): {
            salt = decoded_salt;
        }
        case Err(_): {
            return Option<List<bytes>>.None;
        }
    }
    match (base64.decode(parts[3])) {
        case Ok(bytes decoded_hash): {
            hash = decoded_hash;
        }
        case Err(_): {
            return Option<List<bytes>>.None;
        }
    }
    if (hash.size() != SHA1_SIZE) {
        return Option<List<bytes>>.None;
    }
    List<bytes> out = [salt, hash];
    return Option<List<bytes>>.Some(out);
}

// Whether the comma-separated patterns of one entry cover `id`: some
// non-negated pattern matches and no negated one does.
bool is_entry_match(List<str> patterns, str id) {
    bool is_matched = false;
    for (str pattern in patterns) {
        if (pattern.starts_with(HASH_PREFIX)) {
            match (parse_hashed(pattern)) {
                case Some(List<bytes> salt_and_hash): {
                    if (hmac_sha1(salt_and_hash[0], id.to_bytes()) == salt_and_hash[1]) {
                        is_matched = true;
                    }
                }
                case None: {
                }
            }
        } else if (pattern.starts_with("!")) {
            if (is_glob_match(pattern.substr(1, pattern.size()).to_lower(), 0, id, 0)) {
                return false;
            }
        } else if (is_glob_match(pattern.to_lower(), 0, id, 0)) {
            is_matched = true;
        }
    }
    return is_matched;
}

// The space- or tab-separated fields of a line, empty ones dropped.
List<str> fields_of(str line) {
    List<str> out = [];
    int start = -1;
    int byte_index = 0;
    while (byte_index <= line.size()) {
        bool is_blank = byte_index == line.size() || line.byte_at(byte_index) == ' ' || line.byte_at(byte_index) == '\t';
        if (is_blank && start >= 0) {
            out.push(line.substr(start, byte_index));
            start = -1;
        } else if (!is_blank && start < 0) {
            start = byte_index;
        }
        byte_index = byte_index + 1;
    }
    return out;
}

/// Parses a whole `known_hosts` file. See the module header for what is
/// skipped (comments, blank lines, other key types, `@cert-authority`) and
/// what is an error.
pub Result<KnownHosts, Error> parse(str text) {
    List<Entry> entries = [];
    for (str raw in text.split("\n")) {
        str line = raw.trim();
        if (line.size() == 0 || line.starts_with("#")) {
            continue;
        }
        List<str> fields = fields_of(line);
        bool is_revoked = false;
        bool is_authority = false;
        int field_offset = 0;
        if (fields[0].starts_with("@")) {
            if (fields[0] == "@revoked") {
                is_revoked = true;
            } else if (fields[0] == "@cert-authority") {
                is_authority = true;
            } else {
                return Result<KnownHosts, Error>.Err(Error.MalformedLine);
            }
            field_offset = 1;
        }
        if (fields.size() < field_offset + 3) {
            return Result<KnownHosts, Error>.Err(Error.MalformedLine);
        }
        List<str> patterns = fields[field_offset].split(",");
        for (str pattern in patterns) {
            if (pattern.size() == 0) {
                return Result<KnownHosts, Error>.Err(Error.MalformedLine);
            }
            if (pattern.starts_with("|") && (patterns.size() != 1 || !pattern.starts_with(HASH_PREFIX) || parse_hashed(pattern).is_none())) {
                return Result<KnownHosts, Error>.Err(Error.MalformedLine);
            }
        }
        if (is_authority || fields[field_offset + 1] != KEY_TYPE) {
            continue;
        }
        bytes key = decode_key(fields[field_offset + 2])?;
        entries.push(Entry(patterns, key, is_revoked));
    }
    return Result<KnownHosts, Error>.Ok(KnownHosts(entries));
}

// The 32 raw octets from an `ssh-ed25519` line's base64 blob.
Result<bytes, Error> decode_key(str b64) {
    bytes blob = [];
    match (base64.decode(b64)) {
        case Ok(bytes decoded_blob): {
            blob = decoded_blob;
        }
        case Err(_): {
            return Result<bytes, Error>.Err(Error.BadKey);
        }
    }
    match (ssh.parse_host_key_blob(blob)) {
        case Ok(bytes key): {
            if (key.size() != 32) {
                return Result<bytes, Error>.Err(Error.BadKey);
            }
            return Result<bytes, Error>.Ok(key);
        }
        case Err(_): {
            return Result<bytes, Error>.Err(Error.BadKey);
        }
    }
}

/// Reads the file at `path` and parses it.
pub Result<KnownHosts, Error> load(str path) {
    match (io.read(path)) {
        case Ok(str text): {
            return parse(text);
        }
        case Err(_): {
            return Result<KnownHosts, Error>.Err(Error.Io);
        }
    }
}

/// The plain `known_hosts` line for `key` on `host:port`, without the
/// newline: `host ssh-ed25519 base64` (`[host]:port` unless the port is 22).
pub str plain_line(str host, int port, ssh.HostKey key) {
    return host_id(host, port) + " " + key.algorithm + " " + key.blob_base64();
}

/// The same line in OpenSSH's hashed form (`ssh-keygen -H`,
/// `HashKnownHosts yes`): the name becomes `|1|base64(salt)|base64(HMAC-SHA1
/// (salt, name))`. OpenSSH uses a random 20-octet salt; `add` draws one.
pub str hashed_line(str host, int port, ssh.HostKey key, bytes salt) {
    bytes mac = hmac_sha1(salt, host_id(host, port).to_bytes());
    return HASH_PREFIX + base64.encode(salt) + "|" + base64.encode(mac) + " " + key.algorithm + " " + key.blob_base64();
}

// The directory part of `path`, "" if it has none.
str dir_of(str path) {
    int cut = path.size() - 1;
    while (cut > 0 && path.byte_at(cut) != '/') {
        cut = cut - 1;
    }
    if (cut <= 0) {
        return "";
    }
    return path.substr(0, cut);
}

/// Appends `key` as the key for `host:port` to the `known_hosts` file at
/// `path`: plain, or with `hashed` in OpenSSH's `HashKnownHosts` form. The
/// file (and its directory, with the process umask's permissions) is created
/// if missing; a last line lacking its newline is not run into. See the
/// module header for when to call this -- never for a changed key.
pub Result<bool, Error> add(str path, str host, int port, ssh.HostKey key, bool hashed) {
    str directory = dir_of(path);
    if (directory != "" && !fs.exists(directory)) {
        match (fs.makedirs(directory)) {
            case Ok(bool made): {
            }
            case Err(io.Error e): {
                return Result<bool, Error>.Err(Error.Write);
            }
        }
    }
    str prefix = "";
    if (fs.exists(path)) {
        match (io.read(path)) {
            case Ok(str current): {
                if (current != "" && !current.ends_with("\n")) {
                    prefix = "\n";
                }
            }
            case Err(io.Error e): {
                return Result<bool, Error>.Err(Error.Io);
            }
        }
    }
    str text = plain_line(host, port, key);
    if (hashed) {
        text = hashed_line(host, port, key, random.system().octets(20));
    }
    match (io.append(path, prefix + text + "\n")) {
        case Ok(int n): {
            return Result<bool, Error>.Ok(true);
        }
        case Err(io.Error e): {
            return Result<bool, Error>.Err(Error.Write);
        }
    }
}
