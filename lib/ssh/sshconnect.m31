// The part of an SSH client that is not the protocol and not the session:
// resolving the configuration for a host, deciding about its host key,
// finding and unlocking identities, authenticating, and walking a chain of
// jump hosts -- shared by `m31ssh`, `m31scp` and `m31sftp` so that they trust
// the same hosts the same way.
//
// API
// ---
//   sshconnect.connect(parameters)   -> Result<Connection, str>
//   sshconnect.connect_reporting(parameters, report)
//                                    -> Result<Connection, str>   see `Report`
//   sshconnect.resolve(parameters)   -> Result<Resolved, str>   no connection
//   sshconnect.sanitize(text)    -> str      server text made safe to print
//   sshconnect.home_directory()  -> str
//   sshconnect.local_user()      -> str
//
// What it decides, in one place:
//
//   * **configuration**: `~/.ssh/config` (or `-F`) for every hop, and the
//     command line's `-p -l -i -o` for the destination only (ssh(1) -J);
//   * **host keys**: `known_hosts` is consulted mid-handshake, after the
//     server has proved it holds the key and before any credential is
//     offered. A key that differs from the file's is a hard refusal in every
//     mode and the file is never rewritten; an unknown host is refused, asked
//     about, or recorded according to `StrictHostKeyChecking`;
//   * **identities**: ssh-agent keys, then key files (ed25519, ECDSA P-256,
//     RSA, plain or passphrase-protected: the passphrase is read from the
//     terminal with echo off and goes only to `sshkey`);
//   * **jump hosts**: each hop's connection runs inside a `direct-tcpip`
//     channel of the previous one and is checked and authenticated on its
//     own.
//
// Warnings (a key file with loose permissions, an agent that cannot be
// reached, a host recorded) go to standard error as one `Warning: ...` line;
// failures come back as the `Err` text, one line, for the caller to prefix
// with its own name.

import io;
import os;
import fs;
import net;
import term;
import ssh;
import ssh.sshkey;
import ssh.sshhosts;
import ssh.sshauth;
import ssh.sshagent;
import ssh.sshconfig;
import ssh.sshjump;

const int HANDSHAKE_TIMEOUT_MS = 30000;

// One `Warning: ...` line: to standard error, or into `report.warnings` when
// the caller asked for them to be collected (a program with the terminal in
// raw mode must not have stderr written under it).
void warn(Report report, str message) {
    if (report.is_silent) {
        report.warnings.push("Warning: " + message);
    } else {
        io.eprint("Warning: " + message);
    }
}

/// What a connection attempt reports besides its result, for a caller that
/// holds the object: the `Warning:` lines it would have written to standard
/// error (collected when `is_silent`), and, when a host key was refused, the
/// facts a program needs to ask a person about it instead of parsing the
/// error line. Used by `sshclient.connect_detailed`; `connect` makes its own
/// (noisy, no collection), so `m31ssh`, `m31scp` and `m31sftp` behave as
/// before.
pub type Report {
    /// true: `Warning:` lines are appended to `warnings` and nothing is
    /// written to standard error by the library (interactive prompts are only
    /// ever written when `Params.is_interactive` is true).
    pub bool is_silent = false;
    pub List<str> warnings = [];
    /// Why a host key was refused: "" (not for that reason), "unknown",
    /// "changed" or "revoked".
    pub str refusal = "";
    /// The host as checked (after `HostName`), its port and the known_hosts
    /// file consulted; set with `refusal`.
    pub str refusal_host = "";
    pub int refusal_port = 0;
    pub str refusal_path = "";
    /// HashKnownHosts for this host: how a recorded key should be written.
    pub bool is_hashed = false;
    /// The key the server presented (a list of zero or one).
    pub List<ssh.HostKey> presented = [];
    /// For "changed": the fingerprints of the keys the file lists for the
    /// host.
    pub List<str> known_fingerprints = [];
}

/// What to connect to and how to treat it.
pub type Params {
    pub str host;
    /// 0: the configuration's, else 22.
    pub int port;
    /// "": the configuration's, else the local user.
    pub str user;
    pub List<str> identities;
    /// `-o` lines, `Key=value` or `Key value`: the destination's.
    pub List<str> options;
    pub str config_file;
    /// `-J`: "" for the configuration's `ProxyJump`.
    pub str jump;
    pub bool is_quiet;
    /// Whether a person can be asked (a terminal on standard input).
    pub bool is_interactive;
}

/// An authenticated connection to the destination.
pub type Connection {
    pub ssh.Transport transport;
    pub sshconfig.Settings settings;
    pub str host_name;
    pub int port;
    pub str user;
}

/// Server-supplied text made safe to print: control characters (except
/// newline and tab) are dropped, so a banner or a name cannot move the
/// cursor, retitle the window or inject escape sequences.
pub str sanitize(str text) {
    return ssh.sanitize_text(text);
}

/// $HOME, or "".
pub str home_directory() {
    match (os.env("HOME")) {
        case Some(str home): {
            return home;
        }
        case None: {
            return "";
        }
    }
}

/// $USER or $LOGNAME, or "".
pub str local_user() {
    match (os.env("USER")) {
        case Some(str name): {
            if (name != "") {
                return name;
            }
        }
        case None: {
        }
    }
    match (os.env("LOGNAME")) {
        case Some(str name): {
            return name;
        }
        case None: {
            return "";
        }
    }
}

str read_text(str path) {
    if (!fs.is_file(path)) {
        return "";
    }
    match (io.read(path)) {
        case Ok(str text): {
            return text;
        }
        case Err(_): {
            return "";
        }
    }
}

// `Include` lines expanded in place, as OpenSSH does for a user's file: a
// relative path is relative to `~/.ssh`, `~` and globs work, the matches go
// in lexical order, a file that does not exist is skipped, and the depth is
// bounded (16, as in OpenSSH) so a file that includes itself ends. The text
// is spliced where the line was, so an included file's `Host` and `Match`
// lines open blocks exactly as if written there.
str expand_includes(str text, str home, int depth) {
    if (depth > 16) {
        return text;
    }
    str out = "";
    for (str line in text.split("\n")) {
        List<str> words = line.trim().split(" ");
        if (words.size() >= 2 && words[0].to_lower() == "include") {
            for (str raw in words.slice(1, words.size())) {
                str pattern = raw;
                if (pattern.size() >= 2 && pattern.starts_with("\"") && pattern.ends_with("\"")) {
                    pattern = pattern.substr(1, pattern.size() - 1);
                }
                if (pattern == "~") {
                    pattern = home;
                } else if (pattern.starts_with("~/")) {
                    pattern = home + pattern.substr(1, pattern.size());
                } else if (!pattern.starts_with("/")) {
                    pattern = home + "/.ssh/" + pattern;
                }
                for (str path in fs.glob(pattern)) {
                    if (fs.is_file(path)) {
                        out = out + expand_includes(read_text(path), home, depth + 1) + "\n";
                    }
                }
            }
        } else {
            out = out + line + "\n";
        }
    }
    return out;
}

// --- host key policy ------------------------------------------------------------

/// The decision about a server's host key, as the transport asks for it. It
/// never writes `known_hosts` for a key that changed, and writes for an
/// unknown one only after a yes (or under accept-new / no).
type HostCheck {
    str host;
    int port;
    str path;
    /// yes | ask | accept-new | no
    str policy;
    bool is_interactive;
    bool is_quiet;
    /// HashKnownHosts: record a new host hashed.
    bool is_hashed;
    sshhosts.KnownHosts hosts;
    Report report;
    /// Why the key was refused ("" while it has not been).
    str failure = "";
}

bool HostCheck.is_confirmed(ssh.HostKey key) {
    int attempts = 0;
    while (attempts < 5) {
        io.eprint("The authenticity of host '" + display_name(host, port) + "' can't be established.");
        io.eprint(key_label(key) + " key fingerprint is " + key.fingerprint() + ".");
        Result<int, io.Error> prompted = io.stderr().write("Are you sure you want to continue connecting (yes/no)? ".to_bytes());
        match (io.stdin().read_until("\n".to_bytes(), 256)) {
            case Ok(bytes line): {
                match (line.utf8()) {
                    case Some(str text): {
                        str answer = text.trim().to_lower();
                        if (answer == "yes") {
                            return true;
                        }
                        if (answer == "no") {
                            return false;
                        }
                    }
                    case None: {
                    }
                }
                if (line.size() == 0) {
                    return false;
                }
            }
            case Err(_): {
                return false;
            }
        }
        io.eprint("Please type 'yes' or 'no'.");
        attempts = attempts + 1;
    }
    return false;
}

void HostCheck.refuse(str kind, ssh.HostKey key) {
    report.refusal = kind;
    report.refusal_host = host;
    report.refusal_port = port;
    report.refusal_path = path;
    report.is_hashed = is_hashed;
    report.presented = [key];
}

pub bool HostCheck.is_acceptable(ssh.HostKey key) {
    if (hosts.is_revoked(host, port, key)) {
        refuse("revoked", key);
        failure = "the host key " + key.fingerprint() + " for " + display_name(host, port) + " is marked revoked in " + path;
        return false;
    }
    match (hosts.blobs_for(host, port)) {
        case Ok(List<bytes> trusted): {
            for (bytes known in trusted) {
                if (known == key.blob) {
                    return true;
                }
            }
            refuse("changed", key);
            for (bytes known in trusted) {
                match (ssh.parse_host_key(known)) {
                    case Ok(ssh.HostKey listed): {
                        report.known_fingerprints.push(listed.fingerprint());
                    }
                    case Err(_): {
                    }
                }
            }
            failure = "REMOTE HOST IDENTIFICATION HAS CHANGED for " + display_name(host, port) + ": the server presented " + key_label(key) + " key " + key.fingerprint() + ", which is not any of the keys in " + path + " for this host. Refusing to connect (nothing was modified; if the change is expected, remove the old entry yourself)";
            return false;
        }
        case Err(sshhosts.Error error): {
            match (error) {
                case UnknownHost: {
                }
                case Revoked: {
                    refuse("revoked", key);
                    failure = "every key listed for " + display_name(host, port) + " in " + path + " is revoked";
                    return false;
                }
                case Io: {
                    failure = "cannot read " + path;
                    return false;
                }
                case MalformedLine: {
                    failure = path + " has a malformed line; refusing to guess";
                    return false;
                }
                case BadKey: {
                    failure = path + " has a malformed ssh-ed25519 key; refusing to guess";
                    return false;
                }
                case Write: {
                    failure = "cannot write " + path;
                    return false;
                }
                case Unverifiable: {
                    failure = display_name(host, port) + " is listed in " + path + " only with a key type this client cannot verify (certificate authority, another curve, a short RSA key); refusing to trust a new key for it. Connect with OpenSSH, or remove that entry";
                    return false;
                }
            }
        }
    }
    // Unknown host.
    if (policy == "yes") {
        refuse("unknown", key);
        failure = "host key verification failed: " + display_name(host, port) + " is not in " + path + " and StrictHostKeyChecking is yes (key " + key.fingerprint() + ")";
        return false;
    }
    if (policy == "ask") {
        if (!is_interactive) {
            refuse("unknown", key);
            failure = "host key verification failed: " + display_name(host, port) + " is not in " + path + " and there is no terminal to ask on (key " + key.fingerprint() + "); use StrictHostKeyChecking=accept-new to trust it on first use";
            return false;
        }
        if (!is_confirmed(key)) {
            failure = "host key verification failed: not accepted by the user";
            return false;
        }
    }
    match (sshhosts.add(path, host, port, key, is_hashed)) {
        case Ok(_): {
            if (!is_quiet) {
                warn(report, "permanently added '" + display_name(host, port) + "' (" + key_label(key) + ") to the list of known hosts.");
            }
        }
        case Err(sshhosts.Error error): {
            warn(report, "could not record the host key in " + path + ": " + error.to_str());
        }
    }
    return true;
}

str key_label(ssh.HostKey key) {
    if (key.algorithm == "ssh-ed25519") {
        return "ED25519";
    }
    if (key.algorithm == "ecdsa-sha2-nistp256") {
        return "ECDSA";
    }
    if (key.algorithm == "ssh-rsa") {
        return "RSA";
    }
    return key.algorithm;
}

str display_name(str host, int port) {
    if (port == 22) {
        return host;
    }
    return "[" + host + "]:" + port.to_str();
}

// --- identities -------------------------------------------------------------------

type Candidate {
    bytes blob;
    /// "" for a key file; else the agent socket to sign through.
    str agent_path;
    /// The key, once loaded: zero or one.
    List<sshkey.PrivateKey> key;
    str label;
    /// The file, and whether it needs a passphrase (asked for only when this
    /// candidate is reached and no agent key already covered it).
    str file;
    bool is_encrypted;
}

// The key type's userauth signature algorithms, best first, from a blob.
List<str> algorithms_of(bytes blob) {
    match (ssh.parse_string(blob, 0)) {
        case Ok(ssh.Field field): {
            match (field.value.utf8()) {
                case Some(str name): {
                    if (name == "ssh-rsa") {
                        return ["rsa-sha2-512", "rsa-sha2-256"];
                    }
                    return [name];
                }
                case None: {
                    return [];
                }
            }
        }
        case Err(_): {
            return [];
        }
    }
}

// A passphrase read from the terminal with echo off, or None when there is
// no terminal, the person gave up (Ctrl-C, Ctrl-D on an empty line), or the
// terminal could not be put in raw mode. Never printed, never logged; the
// bytes go only to `sshkey`.
Option<bytes> read_passphrase(str prompt) {
    if (!term.is_terminal(0)) {
        return Option<bytes>.None;
    }
    match (term.raw(in_fd: 0, out_fd: 2)) {
        case Err(_): {
            return Option<bytes>.None;
        }
        case Ok(term.Session raw): {
            Result<int, io.Error> shown = io.stderr().write(prompt.to_bytes());
            bytes typed = [];
            bool is_aborted = false;
            bool is_done = false;
            io.File input = io.stdin();
            while (!is_done) {
                match (input.read(1)) {
                    case Ok(bytes got): {
                        if (got.size() == 0) {
                            is_aborted = typed.size() == 0;
                            is_done = true;
                        } else if (got[0] == 13 || got[0] == 10) {
                            is_done = true;
                        } else if (got[0] == 3) {
                            is_aborted = true;
                            is_done = true;
                        } else if (got[0] == 4 && typed.size() == 0) {
                            is_aborted = true;
                            is_done = true;
                        } else if (got[0] == 127 || got[0] == 8) {
                            // erase one UTF-8 character
                            while (typed.size() > 0 && (typed[typed.size() - 1] & 0xC0) == 0x80) {
                                typed.pop();
                            }
                            if (typed.size() > 0) {
                                typed.pop();
                            }
                        } else if (got[0] == 21) {
                            typed.clear();
                        } else if (got[0] >= 32) {
                            typed.push(got[0]);
                        }
                    }
                    case Err(_): {
                        is_aborted = true;
                        is_done = true;
                    }
                }
            }
            Result<bool, term.Error> restored = raw.restore();
            Result<int, io.Error> newline = io.stderr().write("\n".to_bytes());
            if (is_aborted) {
                return Option<bytes>.None;
            }
            return Option<bytes>.Some(typed);
        }
    }
}

// The key of an encrypted candidate, asking for the passphrase up to three
// times; None when it cannot be had.
Option<sshkey.PrivateKey> unlock(Candidate candidate, Report report) {
    int attempts = 0;
    while (attempts < 3) {
        match (read_passphrase("Enter passphrase for key '" + candidate.file + "': ")) {
            case None: {
                warn(report, "no passphrase for " + candidate.file + " (no terminal to ask on, or cancelled); skipping this key");
                return Option<sshkey.PrivateKey>.None;
            }
            case Some(bytes passphrase): {
                Result<sshkey.PrivateKey, sshkey.Error> loaded = sshkey.load_with_passphrase(candidate.file, passphrase);
                // best effort: the typed bytes do not linger in this buffer
                for (int index in 0 .. passphrase.size()) {
                    passphrase[index] = 0;
                }
                match (loaded) {
                    case Ok(sshkey.PrivateKey key): {
                        return Option<sshkey.PrivateKey>.Some(key);
                    }
                    case Err(sshkey.Error error): {
                        match (error) {
                            case WrongPassphrase: {
                                io.eprint("Permission denied, please try again.");
                            }
                            case Io: {
                                warn(report, candidate.file + ": " + error.to_str());
                                return Option<sshkey.PrivateKey>.None;
                            }
                            case NotOpenSshKey: {
                                warn(report, candidate.file + ": " + error.to_str());
                                return Option<sshkey.PrivateKey>.None;
                            }
                            case Encrypted: {
                                warn(report, candidate.file + ": " + error.to_str());
                                return Option<sshkey.PrivateKey>.None;
                            }
                            case Truncated: {
                                warn(report, candidate.file + ": " + error.to_str());
                                return Option<sshkey.PrivateKey>.None;
                            }
                            case UnsupportedKeyType: {
                                warn(report, candidate.file + ": " + error.to_str());
                                return Option<sshkey.PrivateKey>.None;
                            }
                            case UnsupportedKeyCount: {
                                warn(report, candidate.file + ": " + error.to_str());
                                return Option<sshkey.PrivateKey>.None;
                            }
                            case BadCheck: {
                                warn(report, candidate.file + ": " + error.to_str());
                                return Option<sshkey.PrivateKey>.None;
                            }
                            case BadKey: {
                                warn(report, candidate.file + ": " + error.to_str());
                                return Option<sshkey.PrivateKey>.None;
                            }
                            case BadPadding: {
                                warn(report, candidate.file + ": " + error.to_str());
                                return Option<sshkey.PrivateKey>.None;
                            }
                            case UnsupportedCipher: {
                                warn(report, candidate.file + ": " + error.to_str());
                                return Option<sshkey.PrivateKey>.None;
                            }
                            case UnsupportedKdf: {
                                warn(report, candidate.file + ": " + error.to_str());
                                return Option<sshkey.PrivateKey>.None;
                            }
                        }
                    }
                }
            }
        }
        attempts = attempts + 1;
    }
    warn(report, candidate.file + ": too many incorrect passphrases; skipping this key");
    return Option<sshkey.PrivateKey>.None;
}

bool has_blob(List<Candidate> list, bytes blob) {
    for (Candidate entry in list) {
        if (entry.blob == blob) {
            return true;
        }
    }
    return false;
}

List<Candidate> gather(sshconfig.Settings settings, str home, bool is_quiet, Report report) {
    List<Candidate> out = [];
    List<str> files = settings.identity_files;
    bool is_default = false;
    if (files.size() == 0) {
        is_default = true;
        if (home != "") {
            files.push(home + "/.ssh/id_ed25519");
            files.push(home + "/.ssh/id_ecdsa");
            files.push(home + "/.ssh/id_rsa");
        }
    }
    List<Candidate> from_files = [];
    for (str file in files) {
        if (!fs.is_present(file)) {
            if (!is_default && !is_quiet) {
                warn(report, "identity file " + file + " not accessible: No such file or directory.");
            }
            continue;
        }
        match (fs.stat(file)) {
            case Ok(fs.Stat info): {
                if (info.perm() & 0o077 != 0) {
                    warn(report, "private key " + file + " is accessible by others (mode " + info.perm().to_str() + " decimal); ignoring it. Run: chmod 600 " + file);
                    continue;
                }
            }
            case Err(_): {
            }
        }
        match (io.read(file)) {
            case Err(io.Error error): {
                warn(report, "" + file + ": " + error.to_str());
            }
            case Ok(str text): {
                match (sshkey.inspect(text)) {
                    case Err(sshkey.Error error): {
                        warn(report, "" + file + ": " + error.to_str());
                    }
                    case Ok(sshkey.Info info): {
                        if (info.is_encrypted) {
                            from_files.push(Candidate(info.blob, "", [], file, file, true));
                        } else {
                            match (sshkey.parse(text)) {
                                case Ok(sshkey.PrivateKey key): {
                                    from_files.push(Candidate(info.blob, "", [key], file, file, false));
                                }
                                case Err(sshkey.Error error): {
                                    warn(report, "" + file + ": " + error.to_str());
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    bool is_agent_allowed = !settings.is_identities_only;
    match (os.env("SSH_AUTH_SOCK")) {
        case Some(str socket): {
            if (socket != "" && socket != "none") {
                match (sshagent.connect(socket)) {
                    case Ok(sshagent.Agent agent): {
                        match (agent.identities()) {
                            case Ok(List<sshagent.Identity> keys): {
                                for (sshagent.Identity identity in keys) {
                                    bool is_listed = has_blob(from_files, identity.blob);
                                    if (is_agent_allowed || is_listed) {
                                        out.push(Candidate(identity.blob, socket, [], "agent: " + identity.comment, "", false));
                                    }
                                }
                            }
                            case Err(sshagent.Error error): {
                                warn(report, "ssh-agent: " + error.to_str());
                            }
                        }
                    }
                    case Err(sshagent.Error error): {
                        warn(report, "ssh-agent: " + error.to_str());
                    }
                }
            }
        }
        case None: {
        }
    }
    for (Candidate entry in from_files) {
        if (!has_blob(out, entry.blob)) {
            out.push(entry);
        }
    }
    return out;
}

/// One host on the way: the jump hosts, then the target.
type Hop {
    /// The name as typed (what config `Host` patterns match).
    str alias;
    str host_name;
    int port;
    str user;
    sshconfig.Settings settings;
}

// `[user@]host[:port]` of a ProxyJump entry.
Result<Hop, str> hop_of(str spec, str base_config, str login, str home, Report report) {
    str text = spec.trim();
    str user = "";
    int at_sign = -1;
    int index = 0;
    while (index < text.size()) {
        if (text.byte_at(index) == 64) {
            at_sign = index;
        }
        index = index + 1;
    }
    if (at_sign >= 0) {
        user = text.substr(0, at_sign);
        text = text.substr(at_sign + 1, text.size());
    }
    int port = 0;
    int colon = -1;
    index = 0;
    while (index < text.size()) {
        if (text.byte_at(index) == 58) {
            colon = index;
        }
        index = index + 1;
    }
    if (colon >= 0) {
        Option<int> number = text.substr(colon + 1, text.size()).parse_int();
        match (number) {
            case Some(int value): {
                if (value < 1 || value > 65535) {
                    return Result<Hop, str>.Err("bad port in jump host '" + spec + "'");
                }
                port = value;
            }
            case None: {
                return Result<Hop, str>.Err("bad port in jump host '" + spec + "'");
            }
        }
        text = text.substr(0, colon);
    }
    if (text == "" || text.starts_with("-")) {
        return Result<Hop, str>.Err("bad jump host '" + spec + "'");
    }
    if (!is_plain_word(text) || !is_plain_word(user)) {
        return Result<Hop, str>.Err("bad jump host '" + spec + "'");
    }
    sshconfig.Settings settings = sshconfig.resolve(base_config, text, login, home);
    if (settings.errors.size() > 0) {
        return Result<Hop, str>.Err("configuration error: " + settings.errors[0]);
    }
    check_ignored(settings, text, false, report)?;
    if (user == "") {
        user = settings.user;
    }
    if (user == "") {
        user = login;
    }
    if (port == 0) {
        port = settings.port;
    }
    if (port == 0) {
        port = 22;
    }
    return Result<Hop, str>.Ok(Hop(text, settings.host_name, port, user, settings));
}

// The host-key policy object for one hop.
Result<HostCheck, str> check_for(Hop hop, str home, bool is_quiet, bool is_interactive, Report report) {
    str known_hosts_path = hop.settings.known_hosts_file;
    if (known_hosts_path == "") {
        if (home == "") {
            return Result<HostCheck, str>.Err("HOME is not set and no UserKnownHostsFile is configured");
        }
        known_hosts_path = home + "/.ssh/known_hosts";
    }
    str policy = hop.settings.strict_host_key_checking;
    if (policy == "") {
        policy = "ask";
    }
    if (policy == "off") {
        policy = "no";
    }
    str known_text = "";
    if (fs.is_present(known_hosts_path)) {
        match (io.read(known_hosts_path)) {
            case Ok(str text): {
                known_text = text;
            }
            case Err(io.Error error): {
                return Result<HostCheck, str>.Err("cannot read " + known_hosts_path + ": " + error.to_str());
            }
        }
    }
    match (sshhosts.parse(known_text)) {
        case Ok(sshhosts.KnownHosts loaded): {
            return Result<HostCheck, str>.Ok(HostCheck(hop.host_name, hop.port, known_hosts_path, policy, is_interactive, is_quiet, hop.settings.is_hash_known_hosts, loaded, report));
        }
        case Err(sshhosts.Error error): {
            return Result<HostCheck, str>.Err(known_hosts_path + ": " + error.to_str() + "; refusing to continue");
        }
    }
}

// Tries each candidate identity over the transport; `Ok` carries the
// server's banner.
Result<str, str> authenticate(ssh.Transport transport, str user, str host_name, List<Candidate> candidates, Report report) {
    match (sshauth.start(transport)) {
        case Ok: {
        }
        case Err(sshauth.Error error): {
            return Result<str, str>.Err("authentication could not start: " + error.to_str());
        }
    }
    bool is_authenticated = false;
    str banner = "";
    for (Candidate candidate in candidates) {
        sshauth.Signer signer = sshagent.AgentSigner(candidate.agent_path, candidate.blob);
        if (candidate.agent_path == "") {
            if (candidate.is_encrypted) {
                match (unlock(candidate, report)) {
                    case Some(sshkey.PrivateKey unlocked): {
                        signer = sshauth.KeySigner(unlocked);
                    }
                    case None: {
                        continue;
                    }
                }
            } else {
                signer = sshauth.KeySigner(candidate.key[0]);
            }
        }
        for (str algorithm in algorithms_of(candidate.blob)) {
            if (is_authenticated) {
                break;
            }
            match (sshauth.try_key(transport, user, algorithm, candidate.blob, signer)) {
                case Ok(str text): {
                    banner = text;
                    is_authenticated = true;
                }
                case Err(sshauth.Error error): {
                    match (error) {
                        case KeyRejected: {
                        }
                        case AuthFailed: {
                        }
                        case SignerFailed: {
                            warn(report, "signing with " + candidate.label + " failed");
                        }
                        case Transport(ssh.Error inner): {
                            return Result<str, str>.Err("connection lost during authentication: " + inner.to_str());
                        }
                        case Truncated: {
                            return Result<str, str>.Err("authentication failed: the server sent a malformed message");
                        }
                        case UnexpectedMessage: {
                            return Result<str, str>.Err("authentication failed: the server sent an unexpected message");
                        }
                        case BadMessage: {
                            return Result<str, str>.Err("authentication failed: the server sent a malformed message");
                        }
                    }
                }
            }
        }
        if (is_authenticated) {
            break;
        }
    }
    if (!is_authenticated) {
        Result<bool, ssh.Error> closed = transport.disconnect();
        return Result<str, str>.Err(user + "@" + host_name + ": Permission denied (publickey).");
    }
    return Result<str, str>.Ok(banner);
}

// Handshake, host-key decision and authentication over `wire` for one hop;
// the authenticated transport, or a one-line reason.
Result<ssh.Transport, str> open_hop(ssh.Wire wire, Hop hop, str home, bool is_quiet, bool is_interactive, bool is_target, Report report) {
    HostCheck check = check_for(hop, home, is_quiet, is_interactive, report)?;
    List<Candidate> candidates = gather(hop.settings, home, is_quiet, report);
    if (candidates.size() == 0) {
        return Result<ssh.Transport, str>.Err("no usable identity for " + hop.alias + ": no key file and no agent key (tried IdentityFile and ~/.ssh/id_ed25519, id_ecdsa, id_rsa)");
    }
    int handshake_ms = HANDSHAKE_TIMEOUT_MS;
    if (hop.settings.connect_timeout > 0) {
        handshake_ms = hop.settings.connect_timeout * 1000;
    }
    ssh.Offer offer = ssh.offer_preferring(check.hosts.algorithms_for(hop.host_name, hop.port));
    match (ssh.connect_with_offer(wire, check, offer, timeout_ms: handshake_ms)) {
        case Err(ssh.Error error): {
            if (check.failure != "") {
                return Result<ssh.Transport, str>.Err(check.failure);
            }
            return Result<ssh.Transport, str>.Err("connection to " + display_name(hop.host_name, hop.port) + " failed: " + error.to_str());
        }
        case Ok(ssh.Transport transport): {
            match (authenticate(transport, hop.user, hop.host_name, candidates, report)) {
                case Err(str reason): {
                    return Result<ssh.Transport, str>.Err(reason);
                }
                case Ok(str banner): {
                    if (banner != "" && !is_quiet && is_target) {
                        Result<int, io.Error> shown = io.stderr().write((sanitize(banner) + "\n").to_bytes());
                    }
                    return Result<ssh.Transport, str>.Ok(transport);
                }
            }
        }
    }
}

// The first hop's byte stream: a TCP connection, or the standard input and
// output of its `ProxyCommand`.
Result<ssh.Wire, str> first_wire(Hop first) {
    if (first.settings.proxy_command != "") {
        match (sshjump.start_command(first.settings.proxy_command, first.host_name, first.port, first.user)) {
            case Err(str reason): {
                return Result<ssh.Wire, str>.Err(reason);
            }
            case Ok(sshjump.ProcWire through_command): {
                ssh.Wire wire = through_command;
                return Result<ssh.Wire, str>.Ok(wire);
            }
        }
    }
    int connect_ms = 0;
    if (first.settings.connect_timeout > 0) {
        connect_ms = first.settings.connect_timeout * 1000;
    }
    // The connection never sits in a reactor wait: this program has one
    // thread of control and every wait for the network is a poll(2).
    match (net.connect_polled(first.host_name, first.port, timeout_ms: connect_ms)) {
        case Err(net.Error error): {
            return Result<ssh.Wire, str>.Err("could not connect to " + display_name(first.host_name, first.port) + ": " + error.to_str());
        }
        case Ok(net.Conn connection): {
            ssh.Wire wire = ssh.PollWire(connection);
            return Result<ssh.Wire, str>.Ok(wire);
        }
    }
}

// Walks `hops`: the first over TCP (or its ProxyCommand), then each next hop
// over a direct-tcpip channel on the previous one. Every hop's host key is
// checked against its own `known_hosts` entry and every hop authenticates
// for itself.
Result<ssh.Transport, str> establish(List<Hop> hops, str home, bool is_quiet, bool is_interactive, Report report) {
    ssh.Wire wire = first_wire(hops[0])?;
    int index = 0;
    while (true) {
        bool is_target = index == hops.size() - 1;
        match (open_hop(wire, hops[index], home, is_quiet, is_interactive, is_target, report)) {
            case Err(str reason): {
                return Result<ssh.Transport, str>.Err(reason);
            }
            case Ok(ssh.Transport transport): {
                if (is_target) {
                    return Result<ssh.Transport, str>.Ok(transport);
                }
                Hop next = hops[index + 1];
                match (sshjump.open(transport, next.host_name, next.port)) {
                    case Err(str reason): {
                        return Result<ssh.Transport, str>.Err("jump host " + hops[index].alias + " could not reach " + display_name(next.host_name, next.port) + ": " + reason);
                    }
                    case Ok(sshjump.ChannelWire through): {
                        wire = through;
                    }
                }
            }
        }
        index = index + 1;
    }
}

// Whether `text` is a single word with no control character or space in it:
// what a user name or host name must be to be put into generated
// configuration text without becoming a second directive.
bool is_plain_word(str text) {
    for (int code in text.chars()) {
        if (code <= 32 || code == 127 || (code >= 128 && code < 160)) {
            return false;
        }
    }
    return true;
}

// Keywords whose being ignored would silently weaken the connection: a
// `RevokedHostKeys` file not consulted lets a revoked key be trusted again,
// and a `Match` with a criterion this client cannot evaluate (`exec`,
// `canonical`, ...) hides the settings of its block, which may be security
// settings. A file that uses one is refused until the line is removed.
// Everything else that is not understood (Ciphers, HostKeyAlgorithms,
// ForwardAgent, Compression, ...) is a warning: this client's fixed offer is
// all strong and it never forwards an agent, so ignoring those cannot widen
// what it trusts.
bool is_unsafe_to_ignore(str keyword) {
    List<str> unsafe = ["revokedhostkeys"];
    return unsafe.contains(keyword) || keyword.starts_with("match ");
}

// What to do about the lines of `settings` that were understood by nobody:
// `Err` for any that cannot safely be ignored, a `Warning:` line for the rest.
Result<void, str> check_ignored(sshconfig.Settings settings, str name, bool is_quiet, Report report) {
    List<str> seen = [];
    for (str keyword in settings.ignored) {
        if (seen.contains(keyword)) {
            continue;
        }
        seen.push(keyword);
        if (is_unsafe_to_ignore(keyword)) {
            return Result<void, str>.Err("configuration for " + name + " uses '" + keyword + "', which this client does not support and cannot ignore safely; remove it from the configuration");
        }
        if (!is_quiet) {
            warn(report, "configuration option '" + keyword + "' is not supported and is ignored (" + name + ")");
        }
    }
    return Result<void, str>.Ok;
}

/// The configuration of a destination, resolved: everything `connect` decides
/// before any byte goes on the wire.
type Prepared {
    str home;
    str login;
    sshconfig.Settings settings;
    str user;
    int port;
    List<Hop> hops;
}

// The resolution half of `connect`: option lines, the configuration file with
// its `Include`s expanded, the destination's settings, and the chain of hops.
Result<Prepared, str> prepare(Params parameters, Report report) {
    str home = home_directory();
    str login = local_user();
    str options_text = "";
    for (str option in parameters.options) {
        str lower = option.to_lower();
        str key_end = lower;
        int cut = 0;
        while (cut < lower.size() && lower.byte_at(cut) != 32 && lower.byte_at(cut) != 61 && lower.byte_at(cut) != 9) {
            cut = cut + 1;
        }
        key_end = lower.substr(0, cut);
        if (key_end == "host" || key_end == "match" || key_end == "include" || option.contains("\n") || option.contains("\r")) {
            return Result<Prepared, str>.Err("-o " + option + " is not supported");
        }
        options_text = options_text + option + "\n";
    }
    str file_text = "";
    if (parameters.config_file != "") {
        if (!fs.is_file(parameters.config_file)) {
            return Result<Prepared, str>.Err("cannot read configuration file " + parameters.config_file);
        }
        file_text = read_text(parameters.config_file) + "\n";
    } else if (home != "") {
        file_text = read_text(home + "/.ssh/config") + "\n";
    }
    // OpenSSH's rule (ssh(1), -J): "configuration directives supplied on the
    // command line generally apply to the destination host and not any
    // specified jump hosts", so a jump host sees the configuration file only.
    file_text = expand_includes(file_text, home, 0);
    str base_config = file_text;
    str target_config = "";
    if (parameters.port > 0) {
        target_config = target_config + "Port " + parameters.port.to_str() + "\n";
    }
    if (parameters.user != "") {
        target_config = target_config + "User " + parameters.user + "\n";
    }
    if (!is_plain_word(parameters.host) || parameters.host.starts_with("-")) {
        return Result<Prepared, str>.Err("bad host name");
    }
    if (!is_plain_word(parameters.user)) {
        return Result<Prepared, str>.Err("bad user name");
    }
    str identity_lines = "";
    for (str identity in parameters.identities) {
        if (identity.contains("\"") || identity.contains("\n") || identity.contains("\r")) {
            return Result<Prepared, str>.Err("bad identity file name");
        }
        identity_lines = identity_lines + "IdentityFile \"" + identity + "\"\n";
    }
    sshconfig.Settings settings = sshconfig.resolve(target_config + options_text + identity_lines + file_text, parameters.host, login, home);
    if (settings.errors.size() > 0) {
        return Result<Prepared, str>.Err("configuration error: " + settings.errors[0]);
    }
    check_ignored(settings, parameters.host, parameters.is_quiet, report)?;
    str user = settings.user;
    if (user == "") {
        user = login;
    }
    if (user == "") {
        return Result<Prepared, str>.Err("cannot determine the login name; use -l or user@host");
    }
    int port = settings.port;
    if (port == 0) {
        port = 22;
    }
    List<Hop> hops = [];
    str jump_text = parameters.jump;
    if (jump_text == "") {
        jump_text = settings.proxy_jump;
    }
    if (jump_text != "" && jump_text.to_lower() != "none") {
        for (str spec in jump_text.split(",")) {
            Hop jump = hop_of(spec, base_config, login, home, report)?;
            hops.push(jump);
        }
    }
    hops.push(Hop(parameters.host, settings.host_name, port, user, settings));
    return Result<Prepared, str>.Ok(Prepared(home, login, settings, user, port, hops));
}

/// The destination as it will be connected to, after `~/.ssh/config` (with
/// `Include`s expanded), `-o` lines and the other parameters have been
/// resolved. Nothing is connected and nothing is written.
pub type Resolved {
    /// The name as given.
    pub str alias;
    /// `HostName`, or the name as given.
    pub str host;
    pub int port;
    pub str user;
    /// `IdentityFile`s in order; the default key files when none is
    /// configured (`is_default_identities`).
    pub List<str> identity_files;
    pub bool is_default_identities;
    /// `UserKnownHostsFile`, else `~/.ssh/known_hosts` ("" when neither can
    /// be known).
    pub str known_hosts_file;
    /// `StrictHostKeyChecking`: yes, ask (the default), accept-new or no.
    pub str host_key_policy;
    /// `HashKnownHosts`.
    pub bool is_hashed;
    /// The jump hosts, as `host:port`, outermost first.
    pub List<str> jump_hosts;
}

/// Resolves `parameters` like `connect` does, without connecting. `Err` is
/// the same one-line configuration error `connect` would return.
pub Result<Resolved, str> resolve(Params parameters) {
    Report report = Report(is_silent: true);
    Prepared prepared = prepare(parameters, report)?;
    sshconfig.Settings settings = prepared.settings;
    List<str> files = settings.identity_files;
    bool is_default = false;
    if (files.size() == 0) {
        is_default = true;
        if (prepared.home != "") {
            files.push(prepared.home + "/.ssh/id_ed25519");
            files.push(prepared.home + "/.ssh/id_ecdsa");
            files.push(prepared.home + "/.ssh/id_rsa");
        }
    }
    str known_hosts = settings.known_hosts_file;
    if (known_hosts == "" && prepared.home != "") {
        known_hosts = prepared.home + "/.ssh/known_hosts";
    }
    str policy = settings.strict_host_key_checking;
    if (policy == "") {
        policy = "ask";
    }
    if (policy == "off") {
        policy = "no";
    }
    List<str> jumps = [];
    for (int index in 0 .. prepared.hops.size() - 1) {
        jumps.push(prepared.hops[index].host_name + ":" + prepared.hops[index].port.to_str());
    }
    return Result<Resolved, str>.Ok(Resolved(parameters.host, settings.host_name, prepared.port, prepared.user, files, is_default, known_hosts, policy, settings.is_hash_known_hosts, jumps));
}

/// Resolves the configuration for `parameters.host`, connects through any jump
/// hosts, checks every host key, and authenticates. `Err` is one line.
pub Result<Connection, str> connect(Params parameters) {
    return connect_reporting(parameters, Report());
}

/// `connect`, reporting into `report` (see `Report`): warnings can be
/// collected instead of written, and a refused host key is described there
/// in structured form as well as in the `Err` line. The policy is the same:
/// nothing is trusted that the configuration does not say to trust.
pub Result<Connection, str> connect_reporting(Params parameters, Report report) {
    Prepared prepared = prepare(parameters, report)?;
    sshconfig.Settings settings = prepared.settings;
    ssh.Transport transport = establish(prepared.hops, prepared.home, parameters.is_quiet, parameters.is_interactive, report)?;
    if (settings.rekey_limit >= 0) {
        transport.set_rekey_limit(settings.rekey_limit);
    }
    return Result<Connection, str>.Ok(Connection(transport, settings, settings.host_name, prepared.port, prepared.user));
}
