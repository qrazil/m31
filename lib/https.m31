// https -- the http client, over TLS
// ==================================
//
// `http.fetch` speaks `http://` only. This module is the same client for
// `https://`: it connects, proves the server's certificate (`lib/tls.m31`),
// and then runs `http.write_request` and `http.read_response` over the
// encrypted stream, which is why it is this short. It is a separate module,
// and `http` does not import it, because TLS is bignums, curves and X.509 --
// most of a megabyte of generated code that a program which only speaks
// `http://` should not compile or carry.
//
//   https.get(url)                       -> Result<http.Response, http.Error>
//   https.fetch(request, redirects:, timeout_ms:, trust:)
//                                        -> Result<http.Response, http.Error>
//
// `trust` is whom the server must prove it is: the operating system's roots
// by default, a CA file, or a pinned key (`tls.Trust`). It has no value that
// skips the check, and nothing else does either.
//
// Both take `http://` URLs too (no TLS is involved), and follow the same
// redirect rules as `http.fetch`, because they are `http.fetch_via`: five
// same-origin hops, never from `https` to `http`, and the one change of
// origin followed is the same host from `http` to `https`.
//
// Errors are `http.Error`, so a caller handles one vocabulary:
// `CertificateUntrusted`, `CertificateExpired`, `HostnameMismatch`, and
// `TlsFailed` for the rest. The exact reason is `tls`'s `last_error()`, for a
// caller who holds the connection.

import http;
import net;
import tls;

// `tls.Error`, in `http`'s vocabulary. The three a caller acts on differently
// -- an untrusted certificate, an expired one, one for another host -- keep
// their own names; the rest of the thirty-odd reasons a TLS connection can
// stop are `TlsFailed`. The socket's own failures, which `tls` reports as
// `Connect`, never reach here: `http.open` opens the socket itself.
http.Error from_tls(tls.Error e) {
    match (e) {
        case Connect: {
            return http.Error.TlsFailed;
        }
        case Io: {
            return http.Error.TlsFailed;
        }
        case Truncated: {
            return http.Error.TlsFailed;
        }
        case PeerAlert: {
            return http.Error.TlsFailed;
        }
        case Record: {
            return http.Error.TlsFailed;
        }
        case BadRecordMac: {
            return http.Error.TlsFailed;
        }
        case Closed: {
            return http.Error.TlsFailed;
        }
        case UnsupportedVersion: {
            return http.Error.TlsFailed;
        }
        case MissingExtendedMasterSecret: {
            return http.Error.TlsFailed;
        }
        case CertificateRevoked: {
            return http.Error.CertificateUntrusted;
        }
        case BadStapledResponse: {
            return http.Error.CertificateUntrusted;
        }
        case StapleRequired: {
            return http.Error.CertificateUntrusted;
        }
        case BadRenegotiationInfo: {
            return http.Error.TlsFailed;
        }
        case Downgrade: {
            return http.Error.TlsFailed;
        }
        case RetryRequested: {
            return http.Error.TlsFailed;
        }
        case IllegalParameter: {
            return http.Error.TlsFailed;
        }
        case UnsupportedExtension: {
            return http.Error.TlsFailed;
        }
        case Malformed: {
            return http.Error.TlsFailed;
        }
        case UnexpectedMessage: {
            return http.Error.TlsFailed;
        }
        case ClientCertificateRequested: {
            return http.Error.TlsFailed;
        }
        case ClientCertificateUnusable: {
            return http.Error.TlsFailed;
        }
        case BadCertificate: {
            return http.Error.CertificateUntrusted;
        }
        case UntrustedKey: {
            return http.Error.CertificateUntrusted;
        }
        case TrustStore: {
            return http.Error.TlsFailed;
        }
        case UnknownAuthority: {
            return http.Error.CertificateUntrusted;
        }
        case CertificateExpired: {
            return http.Error.CertificateExpired;
        }
        case CertificateNotYetValid: {
            return http.Error.CertificateExpired;
        }
        case HostnameMismatch: {
            return http.Error.HostnameMismatch;
        }
        case InvalidChain: {
            return http.Error.CertificateUntrusted;
        }
        case WeakCertificate: {
            return http.Error.CertificateUntrusted;
        }
        case UnsupportedSignature: {
            return http.Error.TlsFailed;
        }
        case BadSignature: {
            return http.Error.TlsFailed;
        }
        case BadFinished: {
            return http.Error.TlsFailed;
        }
    }
}

type Carrier {
    tls.Trust trust;
}

Result<http.Response, http.Error> Carrier.round_trip(http.Request req, int timeout_ms) {
    net.Conn c = http.open(req, timeout_ms)?;
    if (req.url().scheme() == "https") {
        match (tls.connect_over(c, req.url().host(), trust)) {
            case Ok(tls.Conn secure): {
                http.write_request(secure, req)?;
                return http.read_response(secure, req.method());
            }
            case Err(tls.Error te): {
                return Result<http.Response, http.Error>.Err(from_tls(te));
            }
        }
    }
    http.write_request(c, req)?;
    return http.read_response(c, req.method());
}

/// `GET url`, with the body read and the connection closed, over TLS for an
/// `https://` URL. `http.get`, with a certificate check.
pub Result<http.Response, http.Error> get(str url, tls.Trust trust = tls.Trust.SystemRoots) {
    return fetch(http.request("GET", url)?, trust: trust);
}

/// `http.fetch`, for `https://` as well. `trust` is whom an `https` server
/// must prove it is; it is ignored by `http://` URLs.
pub Result<http.Response, http.Error> fetch(http.Request req, int redirects = http.MAX_REDIRECTS, int timeout_ms = http.TIMEOUT_MS, tls.Trust trust = tls.Trust.SystemRoots) {
    return http.fetch_via(Carrier(trust), req, redirects: redirects, timeout_ms: timeout_ms);
}
