// JSON, RFC 8259: parse text into a `Value`, and stringify a `Value` back.
//
// `parse` is strict. It accepts exactly the grammar of RFC 8259 -- no
// comments, no trailing commas, no single quotes, no leading zeros, no `NaN`
// -- and a document that is not JSON is `Err(Error.Syntax)`. `Error` is
// payload-free (docs/errors-decision.md §4), so it says only that parsing
// failed; a caller that wants to say where reports it at the call site.
//
// Numbers: a literal containing `.`, `e` or `E` is a `Float`; anything else
// is an `Int`. A float literal too large for a double is an infinity, as in
// CPython's `json`; an integer literal outside the 64-bit range is refused,
// because there is no bigger integer to put it in and quietly turning it into
// a float would lose digits nobody asked to lose.
//
// Strings: every escape RFC 8259 defines, `\uXXXX` included, with a UTF-16
// surrogate pair combined into the one character it spells and an unpaired
// surrogate refused; every code point an escape can spell is decoded. Control
// characters must be escaped. RFC 8259 requires the text to be UTF-8, and
// nothing here checks it: the text is a `str`, which is valid UTF-8 by
// construction (reference §3). A document that arrives as octets is decoded
// with `bytes.utf8()` -- or `io.read` -- before it gets here.
//
// `stringify` writes the compact form -- no incidental whitespace at all --
// unless `indent` is positive, which gives one value per line, indented that
// many spaces per level, with `": "` after a key. Pretty-printing is a detail
// of the one operation, not a second one. Only what RFC 8259 requires is
// escaped: `"` and `\`, the short forms `\n \r \t \b \f`, and `\u00xx` for
// the rest of the C0 controls. Everything else, non-ASCII included, is written
// through: the output is UTF-8 and `ensure_ascii` is a second spelling of the
// same document. A float that is a whole number keeps a `.0`, so that it reads
// back as a `Float` and not an `Int`.
//
// Depth: `parse` accepts 10 000 levels of nesting and refuses the next. A
// document off a socket chooses its own shape, and one byte of `[` buys a
// heap container; the cap bounds that amplification. Neither direction
// recurses -- each walks an explicit stack, as Oro's codec does -- so depth
// costs heap, never C stack. `stringify` has the same bound, which is also
// what stops it on a `Value` that contains itself.
//
// --- what differs from Oro's json -------------------------------------------
//
// - The value is a typed enum, not a dynamic dict/list/int. An object is a
//   `Map<str, Value>`, whose order is the hash table's, so `stringify` writes
//   keys SORTED (bytewise, which for UTF-8 is code point order) to make its
//   output a function of the value. A repeated key in a document keeps the
//   last value, as Oro and CPython do.
// - Positions count bytes, not characters: every offset in the language is a
//   byte offset, and one always lands on a character boundary here.
// - `stringify` returns a `Result`, because NaN, an infinity and a too-deep
//   value have no JSON spelling. Oro raised.
// - Integers past 64 bits are an error rather than a bignum (see above).

/// A JSON value.
pub enum Value {
    Null;
    Bool(bool);
    Int(int);
    Float(float);
    Str(str);
    Array(List<Value>);
    Object(Map<str, Value>);
}

/// Why `parse` or `stringify` failed. Payload-free by design
/// (docs/errors-decision.md §4): the position or value that made `parse` or
/// `stringify` fail is context the caller already has when it reports, not
/// something this value carries.
pub enum Error {
    /// The text is not JSON.
    Syntax;
    /// `stringify` met a NaN or an infinity, which JSON has no spelling for.
    NotFinite;
    /// `stringify` went deeper than 10 000 levels -- a value that contains
    /// itself, or near enough.
    TooDeep;
}

/// A sentence saying what went wrong. A method named `to_str`, so
/// `print(e)` prints it.
pub str Error.to_str() {
    match (this) {
        case Syntax: {
            return "invalid JSON";
        }
        case NotFinite: {
            return "nan and infinity are not JSON serializable";
        }
        case TooDeep: {
            return "maximum nesting depth (" + max_depth().to_str() + ") exceeded";
        }
    }
}

// Where the parser is.
type Parser {
    str text;
    int position = 0;
}

// A container the parser is in the middle of: its items or members so far,
// and for an object the key whose value is being read.
type Frame {
    bool is_object;
    List<Value> items = [];
    Map<str, Value> members = {};
    str key = "";
}

// One step `write` still has to take: write `value` at `level` (`at` is -1),
// or write entry `at` of a container of `size` entries, where `at == size`
// closes it.
type Job {
    Value value;
    int level;
    int position = -1;
    int size = 0;
    bool is_object = false;
    List<Value> items = [];
    Map<str, Value> members = {};
    List<str> keys = [];
}

/// The value `text` spells.
///
///     json.parse("{\"a\": [1, 2.5, true, null]}")
///         -> Ok(Object({"a": Array([Int(1), Float(2.5), Bool(true), Null])}))
pub Result<Value, Error> parse(str text) {
    Parser parser = Parser(text);
    skip_ws(parser);
    Value document = value(parser)?;
    skip_ws(parser);
    if (parser.position < text.size()) {
        return Result<Value, Error>.Err(unexpected(parser));
    }
    return Result<Value, Error>.Ok(document);
}

/// `document` as JSON text: compact, or one value per line with `indent` spaces per
/// level when `indent` is positive.
///
///     json.stringify(v)              -> Ok("{\"a\":1,\"b\":[true,null]}")
///     json.stringify(v, indent: 2)   -> Ok("{\n  \"a\": 1,\n  ...")
pub Result<str, Error> stringify(Value document, int indent = 0) {
    List<str> out = [];
    write(out, document, indent)?;
    return Result<str, Error>.Ok(out.join(""));
}

// The deepest nesting either direction goes. Three orders of magnitude above
// anything a real document reaches, and the same order as CPython's.
int max_depth() {
    return 10000;
}

// --- decoding ----------------------------------------------------------------
// One complete value, with `p.at` on or before its first byte.
//
// Iterative, not recursive: a container being built is pushed onto `stack`,
// so nesting costs heap and never the C stack. Recursion was tried first and
// overflowed an 8 MiB stack at 10 000 levels in an unoptimised build -- a
// document chooses its own depth, so the parser must not let it choose how
// much stack it uses.
Result<Value, Error> value(Parser parser) {
    str text = parser.text;
    int text_length = text.size();
    List<Frame> stack = [];
    // Whether the next thing to read is an object key rather than a value.
    bool is_key_expected = false;
    while (true) {
        if (is_key_expected) {
            is_key_expected = false;
            skip_ws(parser);
            if (parser.position >= text_length || text.byte_at(parser.position) != '"') {
                return fail("expected a string key", parser.position);
            }
            str key = string(parser)?;
            skip_ws(parser);
            if (parser.position >= text_length || text.byte_at(parser.position) != ':') {
                return fail("expected ':'", parser.position);
            }
            parser.position = parser.position + 1;
            stack[stack.size() - 1].key = key;
        }
        skip_ws(parser);
        if (parser.position >= text_length) {
            return fail("unexpected end of input", parser.position);
        }
        int first_byte = text.byte_at(parser.position);
        Value item = Value.Null;
        if (first_byte == '{' || first_byte == '[') {
            int open = parser.position;
            parser.position = parser.position + 1;
            skip_ws(parser);
            if (first_byte == '{' && parser.position < text_length && text.byte_at(parser.position) == '}') {
                parser.position = parser.position + 1;
                item = Value.Object({});
            } else if (first_byte == '[' && parser.position < text_length && text.byte_at(parser.position) == ']') {
                parser.position = parser.position + 1;
                item = Value.Array([]);
            } else {
                // Only a container with something in it is a level: an
                // empty one is finished where it opens.
                if (stack.size() >= max_depth()) {
                    return fail("maximum nesting depth (" + max_depth().to_str() + ") exceeded", open);
                }
                stack.push(Frame(first_byte == '{'));
                is_key_expected = first_byte == '{';
                continue;
            }
        } else if (first_byte == '"') {
            item = Value.Str(string(parser)?);
        } else if (first_byte == '-' || is_digit(first_byte)) {
            item = number(parser)?;
        } else if (has_word(parser, "true")) {
            item = Value.Bool(true);
        } else if (has_word(parser, "false")) {
            item = Value.Bool(false);
        } else if (!has_word(parser, "null")) {
            return Result<Value, Error>.Err(unexpected(parser));
        }
        // A value is finished: hand it to the container underneath, and keep
        // handing containers up for as long as they close here.
        bool is_closing = true;
        while (is_closing) {
            if (stack.size() == 0) {
                return Result<Value, Error>.Ok(item);
            }
            Frame top = stack[stack.size() - 1];
            if (top.is_object) {
                // A repeated key keeps the last value.
                top.members.set(top.key, item);
            } else {
                top.items.push(item);
            }
            skip_ws(parser);
            if (parser.position >= text_length) {
                if (top.is_object) {
                    return fail("unterminated object", parser.position);
                }
                return fail("unterminated array", parser.position);
            }
            int delimiter = text.byte_at(parser.position);
            if (delimiter == ',') {
                parser.position = parser.position + 1;
                is_key_expected = top.is_object;
                is_closing = false;
            } else if (top.is_object && delimiter == '}') {
                parser.position = parser.position + 1;
                stack.pop();
                item = Value.Object(top.members);
            } else if (!top.is_object && delimiter == ']') {
                parser.position = parser.position + 1;
                stack.pop();
                item = Value.Array(top.items);
            } else {
                return Result<Value, Error>.Err(unexpected(parser));
            }
        }
    }
}

// A string literal, with `p.at` on its opening quote.
Result<str, Error> string(Parser parser) {
    str text = parser.text;
    int text_length = text.size();
    parser.position = parser.position + 1;
    List<str> parts = [];
    while (true) {
        // Copy the longest run that needs no decoding in one go -- the whole
        // string, for nearly every key and value.
        int from = parser.position;
        while (parser.position < text_length) {
            int octet = text.byte_at(parser.position);
            // Every byte that stops the run is ASCII, and UTF-8 never uses
            // an ASCII byte inside a character, so the run ends on a
            // character boundary and the substr below cannot cut one. The
            // text needs no UTF-8 check: it is a `str`, so it is valid.
            if (octet == '"' || octet == '\\' || octet < ' ') {
                break;
            }
            parser.position = parser.position + 1;
        }
        if (parser.position > from) {
            parts.push(text.substr(from, parser.position));
        }
        if (parser.position >= text_length) {
            return Result<str, Error>.Err(Error.Syntax);
        }
        int stop_byte = text.byte_at(parser.position);
        if (stop_byte == '"') {
            parser.position = parser.position + 1;
            return Result<str, Error>.Ok(parts.join(""));
        }
        if (stop_byte == '\\') {
            parts.push(escape(parser)?);
        } else {
            return Result<str, Error>.Err(Error.Syntax);
        }
    }
}

// One escape sequence, with `p.at` on its backslash.
Result<str, Error> escape(Parser parser) {
    str text = parser.text;
    parser.position = parser.position + 1;
    if (parser.position >= text.size()) {
        return Result<str, Error>.Err(Error.Syntax);
    }
    int escape_char = text.byte_at(parser.position);
    if (escape_char == 'u') {
        int code_point = unicode_escape(parser)?;
        // Never a surrogate and never past U+10FFFF -- `unicode_escape` has
        // refused the one and cannot build the other -- so from_chars, which
        // traps on both, never does here.
        return Result<str, Error>.Ok(str.from_chars([code_point]));
    }
    parser.position = parser.position + 1;
    if (escape_char == '"') {
        return Result<str, Error>.Ok("\"");
    }
    if (escape_char == '\\') {
        return Result<str, Error>.Ok("\\");
    }
    if (escape_char == '/') {
        return Result<str, Error>.Ok("/");
    }
    if (escape_char == 'n') {
        return Result<str, Error>.Ok("\n");
    }
    if (escape_char == 'r') {
        return Result<str, Error>.Ok("\r");
    }
    if (escape_char == 't') {
        return Result<str, Error>.Ok("\t");
    }
    if (escape_char == 'b') {
        return Result<str, Error>.Ok("\x08");
    }
    if (escape_char == 'f') {
        return Result<str, Error>.Ok("\x0c");
    }
    parser.position = parser.position - 1;
    return Result<str, Error>.Err(Error.Syntax);
}

// The code point of a `\uXXXX`, or of a surrogate pair of them, with `p.at`
// on the `u`.
Result<int, Error> unicode_escape(Parser parser) {
    str text = parser.text;
    int code_point = hex4(parser)?;
    if (code_point >= 55296 && code_point <= 56319) {
        // A high surrogate (D800-DBFF) must be followed by a low one.
        int text_length = text.size();
        if (parser.position + 1 < text_length && text.byte_at(parser.position) == '\\' && text.byte_at(parser.position + 1) == 'u') {
            int save = parser.position;
            parser.position = parser.position + 1;
            int low = hex4(parser)?;
            if (low >= 56320 && low <= 57343) {
                // 0x10000 + ((hi - 0xD800) << 10 | lo - 0xDC00)
                return Result<int, Error>.Ok(65536 + (code_point - 55296 << 10 | low - 56320));
            }
            parser.position = save;
        }
        return Result<int, Error>.Err(Error.Syntax);
    }
    if (code_point >= 56320 && code_point <= 57343) {
        return Result<int, Error>.Err(Error.Syntax);
    }
    return Result<int, Error>.Ok(code_point);
}

// The four hex digits after a `u`, with `p.at` on the `u`. Four CHARACTERS
// are taken, as Oro does, so a message quotes what was written even when it
// is not ASCII.
Result<int, Error> hex4(Parser parser) {
    str text = parser.text;
    int text_length = text.size();
    parser.position = parser.position + 1;
    int end = parser.position;
    for (int character_index in 0 .. 4) {
        if (end >= text_length) {
            return Result<int, Error>.Err(Error.Syntax);
        }
        end = end + char_length(text, end);
    }
    int code_point = 0;
    for (int i in parser.position .. end) {
        int digit = hex_digit(text.byte_at(i));
        if (digit < 0) {
            return Result<int, Error>.Err(Error.Syntax);
        }
        code_point = code_point * 16 + digit;
    }
    parser.position = end;
    return Result<int, Error>.Ok(code_point);
}

// A number literal, with `p.at` on its first byte. The grammar is RFC 8259's
// exactly: an optional minus, then 0 or a digit run not starting with 0, then
// an optional fraction, then an optional exponent.
Result<Value, Error> number(Parser parser) {
    str text = parser.text;
    int text_length = text.size();
    int start = parser.position;
    if (text.byte_at(parser.position) == '-') {
        parser.position = parser.position + 1;
    }
    if (parser.position >= text_length || !is_digit(text.byte_at(parser.position))) {
        return fail("invalid number", parser.position);
    }
    if (text.byte_at(parser.position) == '0') {
        parser.position = parser.position + 1;
        if (parser.position < text_length && is_digit(text.byte_at(parser.position))) {
            return fail("invalid number: a leading zero cannot be followed by more digits", parser.position);
        }
    } else {
        skip_digits(parser);
    }
    bool is_float = false;
    if (parser.position < text_length && text.byte_at(parser.position) == '.') {
        is_float = true;
        parser.position = parser.position + 1;
        if (parser.position >= text_length || !is_digit(text.byte_at(parser.position))) {
            return fail("invalid number: expected a digit after '.'", parser.position);
        }
        skip_digits(parser);
    }
    if (parser.position < text_length && (text.byte_at(parser.position) == 'e' || text.byte_at(parser.position) == 'E')) {
        is_float = true;
        parser.position = parser.position + 1;
        if (parser.position < text_length && (text.byte_at(parser.position) == '+' || text.byte_at(parser.position) == '-')) {
            parser.position = parser.position + 1;
        }
        if (parser.position >= text_length || !is_digit(text.byte_at(parser.position))) {
            return fail("invalid number: expected a digit in the exponent", parser.position);
        }
        skip_digits(parser);
    }
    str literal = text.substr(start, parser.position);
    if (is_float) {
        match (literal.parse_float()) {
            case Some(float float_value): {
                return Result<Value, Error>.Ok(Value.Float(float_value));
            }
            case None: {
                // The literal is valid, so the only way it fails to parse is
                // being too large for a double: an infinity, as in CPython.
                float zero = 0.0;
                if (text.byte_at(start) == '-') {
                    return Result<Value, Error>.Ok(Value.Float(-1.0 / zero));
                }
                return Result<Value, Error>.Ok(Value.Float(1.0 / zero));
            }
        }
    }
    match (literal.parse_int()) {
        case Some(int int_value): {
            return Result<Value, Error>.Ok(Value.Int(int_value));
        }
        case None: {
            return fail("integer out of range", start);
        }
    }
}

void skip_digits(Parser parser) {
    while (parser.position < parser.text.size() && is_digit(parser.text.byte_at(parser.position))) {
        parser.position = parser.position + 1;
    }
}

// Whether `expected` is at `p.at`, stepping over it if so.
//
// Compared byte by byte rather than with substr: `end` is a byte count from
// `p.at`, and in a document like `tru😀` it falls inside a character, where
// substr traps. A mismatch there is a syntax error, not a bug.
bool has_word(Parser parser, str expected) {
    int end = parser.position + expected.size();
    if (end > parser.text.size()) {
        return false;
    }
    for (int i in 0 .. expected.size()) {
        if (parser.text.byte_at(parser.position + i) != expected.byte_at(i)) {
            return false;
        }
    }
    parser.position = end;
    return true;
}

// Whitespace is exactly space, tab, LF and CR.
void skip_ws(Parser parser) {
    str text = parser.text;
    int text_length = text.size();
    while (parser.position < text_length) {
        int octet = text.byte_at(parser.position);
        if (octet != ' ' && octet != '\t' && octet != '\n' && octet != '\r') {
            return;
        }
        parser.position = parser.position + 1;
    }
}

Error unexpected(Parser parser) {
    if (parser.position >= parser.text.size()) {
        return Error.Syntax;
    }
    return Error.Syntax;
}

Result<Value, Error> fail(str what, int error_offset) {
    return Result<Value, Error>.Err(Error.Syntax);
}

// --- encoding ----------------------------------------------------------------
// Append `document` to `out`.
//
// Iterative for the same reason `value` is: every step still to take is a
// `Job` on an explicit stack, so a deep value costs heap and not C stack, and
// a value that contains itself runs into the depth bound instead of off the
// end of the stack.
Result<int, Error> write(List<str> out, Value document, int indent) {
    List<Job> jobs = [Job(document, 0)];
    while (jobs.size() > 0) {
        Job job = jobs.pop();
        if (job.position < 0) {
            write_one(out, jobs, job.value, job.level, indent)?;
        } else if (job.position == job.size) {
            newline(out, job.level, indent);
            if (job.is_object) {
                out.push("}");
            } else {
                out.push("]");
            }
        } else {
            if (job.position > 0) {
                out.push(",");
            }
            newline(out, job.level + 1, indent);
            Value item = Value.Null;
            if (job.is_object) {
                str key = job.keys[job.position];
                quote(out, key);
                out.push(":");
                if (indent > 0) {
                    out.push(" ");
                }
                item = job.members.get(key).or(Value.Null);
            } else {
                item = job.items[job.position];
            }
            job.position = job.position + 1;
            jobs.push(job);
            jobs.push(Job(item, job.level + 1));
        }
    }
    return Result<int, Error>.Ok(0);
}

// Write a scalar, or open a container and queue its contents.
Result<int, Error> write_one(List<str> out, List<Job> jobs, Value node, int level, int indent) {
    if (level > max_depth()) {
        return Result<int, Error>.Err(Error.TooDeep);
    }
    match (node) {
        case Null: {
            out.push("null");
        }
        case Bool(bool bool_value): {
            out.push(bool_value.to_str());
        }
        case Int(int int_value): {
            out.push(int_value.to_str());
        }
        case Float(float float_value): {
            if (float_value != float_value || float_value - float_value != 0.0) {
                return Result<int, Error>.Err(Error.NotFinite);
            }
            str rendered = float_value.to_str();
            out.push(rendered);
            // 1.0 prints as `1`; without the `.0` it would read back as an Int.
            if (!rendered.contains(".") && !rendered.contains("e")) {
                out.push(".0");
            }
        }
        case Str(str text): {
            quote(out, text);
        }
        case Array(List<Value> items): {
            if (items.size() == 0) {
                out.push("[]");
            } else {
                out.push("[");
                jobs.push(Job(node, level, position: 0, size: items.size(), items: items));
            }
        }
        case Object(Map<str, Value> members): {
            if (members.size() == 0) {
                out.push("{}");
            } else {
                List<str> keys = members.keys();
                keys.sort();
                out.push("{");
                jobs.push(Job(node, level, position: 0, size: keys.size(), is_object: true, members: members, keys: keys));
            }
        }
    }
    return Result<int, Error>.Ok(0);
}

// In pretty output, a line break and the indent for `level`; nothing in
// compact output.
void newline(List<str> out, int level, int indent) {
    if (indent > 0) {
        out.push("\n");
        out.push(" ".repeat(indent * level));
    }
}

// `text` as a JSON string literal, quotes included.
void quote(List<str> out, str text) {
    out.push("\"");
    int text_length = text.size();
    int run = 0;
    int byte_index = 0;
    while (byte_index < text_length) {
        int octet = text.byte_at(byte_index);
        // Non-ASCII is written through, a byte at a time: `text` is a `str`, so
        // it is valid UTF-8 already, and the bytes that need escaping are
        // all ASCII, so `run` and `byte_index` only ever stop on a boundary.
        if (octet >= ' ' && octet != '"' && octet != '\\') {
            byte_index = byte_index + 1;
            continue;
        }
        out.push(text.substr(run, byte_index));
        if (octet == '"') {
            out.push("\\\"");
        } else if (octet == '\\') {
            out.push("\\\\");
        } else if (octet == '\n') {
            out.push("\\n");
        } else if (octet == '\r') {
            out.push("\\r");
        } else if (octet == '\t') {
            out.push("\\t");
        } else if (octet == 8) {
            out.push("\\b");
        } else if (octet == 12) {
            out.push("\\f");
        } else {
            // The other C0 controls: one byte below 0x20, as `\u00xx`.
            bytes one = [octet];
            out.push("\\u00" + one.hex());
        }
        byte_index = byte_index + 1;
        run = byte_index;
    }
    out.push(text.substr(run, text_length));
    out.push("\"");
}

// --- bytes -------------------------------------------------------------------
// How many bytes the character at `byte_index` takes, by its lead byte alone, never
// running past the end. For quoting text in a message, not for validating.
int char_length(str text, int byte_index) {
    int lead_byte = text.byte_at(byte_index);
    int byte_count = 1;
    if (lead_byte >= 240) {
        byte_count = 4;
    } else if (lead_byte >= 224) {
        byte_count = 3;
    } else if (lead_byte >= 192) {
        byte_count = 2;
    }
    if (byte_index + byte_count > text.size()) {
        return text.size() - byte_index;
    }
    return byte_count;
}

// The character at `byte_index`, for a message.
str char_at(str text, int byte_index) {
    return text.substr(byte_index, byte_index + char_length(text, byte_index));
}

bool is_digit(int octet) {
    return octet >= '0' && octet <= '9';
}

// The value of one hex digit, either case, or -1.
int hex_digit(int octet) {
    if (octet >= '0' && octet <= '9') {
        return octet - 48;
    }
    if (octet >= 'a' && octet <= 'f') {
        return octet - 87;
    }
    if (octet >= 'A' && octet <= 'F') {
        return octet - 55;
    }
    return -1;
}
