// Unpredictable randomness from the operating system, and, separately, a
// seeded generator you can replay. Written in this language over one
// primitive that asks the kernel for octets. A port of Oro's `random`.
//
// API -- unpredictable, from the OS
// ---------------------------------
//   random.octets(n)           -> bytes, n of them
//   random.hex(n)              -> str, n octets as 2n lowercase hex digits
//   random.integer(low, high)  -> int in [low, high], both ends included
//   random.fraction()          -> float in [0.0, 1.0)
//   random.permutation(n)      -> List<int>, 0..n-1 in a random order
//   random.uuid4()             -> str, an RFC 4122 version 4 UUID
//
// API -- reproducible, from a seed
// --------------------------------
//   random.Seeded g = random.Seeded(42)
//   g.octets(n) / g.hex(n) / g.integer(low, high) / g.fraction()
//   g.permutation(n) / g.uuid4()
//
// --- two generators, told apart by where the call is -------------------------
//
// "Randomness nobody can predict" and "the same sequence again tomorrow" are
// different operations, so there are two generators and no `seed()`:
//
//   random.integer(1, 6)              unpredictable, always
//   random.Seeded(42).integer(1, 6)   reproducible, always; you hold it
//
// A reader of a call site knows which they are looking at without reading
// anything else, and nothing at a distance can turn one into the other the
// way CPython's global `random.seed(0)` can.
//
// The operations are written once. Every algorithm below takes a `Source`
// and asks it for octets with `fill`; the two generators differ in that one
// function and nothing else, so a difference in behaviour between them
// cannot be written.
//
// `Seeded` is PCG-XSH-RR 64/32 (Melissa O'Neill's `pcg32`), seeded and
// consumed exactly as Oro's is, so `random.Seeded(42)` gives the same
// octets, integers, fractions and UUIDs here as it does in Oro.
//
// --- where this differs from Oro, and why ------------------------------------
//
// There is no `choice(xs)` or `shuffle(xs)` yet. Both are generic over the
// element type, and a generic function cannot be called from another module
// yet (`lib.first(xs)` is "`lib` has no function `first`"), nor can a method
// have type parameters, which the seeded forms would need. What they are
// built from is here and is not generic:
//
//   choice:   xs[random.integer(0, xs.size() - 1)]
//   shuffle:  for (int i in random.permutation(xs.size())) { out.push(xs[i]); }
//
// `permutation(n)` is Fisher-Yates over 0..n-1, drawing exactly what Oro's
// `shuffle` draws, so a seeded permutation is the order Oro's seeded shuffle
// would put the same list in, and `xs[g.integer(0, n - 1)]` is Oro's seeded
// `choice`. When generic calls cross modules, `choice` and `shuffle` return
// as functions over these.
//
// The system generator is not buffered. Oro reads 256 octets at a time and
// hands them out, which needs state that outlives a call; this language has
// no module-level state, so every draw is one getentropy call. That is
// slower per call and holds no future output in memory.
//
// The kernel's octets arrive in a `List<int>`, because that is what the one
// primitive fills; `fill` copies them into `bytes` at once, so nothing past
// it sees the difference.
//
// Failures: a range with high below low and a negative count are bugs in the caller and trap, as an index out of range
// does. So does the kernel refusing to supply randomness, which Go's
// crypto/rand also treats as fatal: there is nothing a caller could do with
// the error.

prim int __entropy(int n, List<int> out);

/// A reproducible generator: the same seed gives the same sequence, on every
/// platform and every release, because every step of it is integer
/// arithmetic written here.
///
/// The seed is required, so a generator seeded from somewhere the caller did
/// not choose cannot be written. A negative seed is its 64-bit two's
/// complement pattern, a seed like any other.
///
/// `state` is the generator's own: one element, the PCG state, filled on the
/// first draw; leave it out. (It is a field only because this language has no
/// private fields, and a list only so a draw can advance it in place.)
pub type Seeded {
    int seed;
    List<int> state = [];
}

/// n octets.
pub bytes Seeded.octets(int n) {
    return octets_from(seeded(seed, state), n);
}

/// n octets as 2n lowercase hex digits.
pub str Seeded.hex(int n) {
    return hex_from(seeded(seed, state), n);
}

/// A uniform integer in [low, high], both ends included.
pub int Seeded.integer(int low, int high) {
    return integer_from(seeded(seed, state), low, high);
}

/// A float in [0.0, 1.0).
pub float Seeded.fraction() {
    return fraction_from(seeded(seed, state));
}

/// 0..n-1 in a uniformly random order.
pub List<int> Seeded.permutation(int n) {
    return permutation_from(seeded(seed, state), n);
}

/// A version 4 UUID by construction but not in spirit: anyone who knows the
/// seed can predict it. It belongs in a test fixture, never in a database.
pub str Seeded.uuid4() {
    return uuid4_from(seeded(seed, state));
}

// Where octets come from: the one thing the two generators differ in. `state` is the seeded generator's own list, so a
// draw through a Source advances the Seeded it was made from.
type Source {
    bool is_seeded;
    List<int> state;
}

/// n octets from the operating system.
pub bytes octets(int n) {
    return octets_from(system(), n);
}

/// n octets from the operating system as 2n lowercase hex digits. The count
/// is of octets, not characters: `hex(16)` is 128 bits however it is written.
pub str hex(int n) {
    return hex_from(system(), n);
}

/// A uniform integer in [low, high], both ends included -- the bound a caller
/// almost always means (a die is `integer(1, 6)`), and the one that can name
/// the whole range of `int`.
pub int integer(int low, int high) {
    return integer_from(system(), low, high);
}

/// A float in [0.0, 1.0), with all 53 bits of a double's mantissa.
pub float fraction() {
    return fraction_from(system());
}

/// 0..n-1 in a uniformly random order: a shuffle of any list of n
/// elements, by index. See the header for why it is not `shuffle(xs)`.
pub List<int> permutation(int n) {
    return permutation_from(system(), n);
}

/// An RFC 4122 version 4 UUID.
pub str uuid4() {
    return uuid4_from(system());
}

// --- the two sources -------------------------------------------------------
Source system() {
    return Source(false, []);
}

// The seeded source, starting the generator on its first use: the standard
// `pcg32_srandom_r` -- state zero, step, add the seed, step again -- so that
// adjacent seeds do not open with correlated output.
Source seeded(int seed, List<int> state) {
    if (state.size() == 0) {
        state.push(step(step(0).wrapping_add(seed)));
    }
    return Source(true, state);
}

// n octets from the source.
bytes fill(Source s, int n) {
    if (s.is_seeded) {
        return pcg_fill(s.state, n);
    }
    List<int> got = [];
    int e = __entropy(n, got);
    if (e != 0) {
        trap("random: the operating system supplied no randomness (errno " + e.to_str() + ")");
    }
    bytes out = [];
    for (int b in got) {
        out.push(b);
    }
    return out;
}

// --- the algorithms, once ---------------------------------------------------
bytes octets_from(Source s, int n) {
    check_count(n, "octets");
    return fill(s, n);
}

str hex_from(Source s, int n) {
    check_count(n, "hex");
    return fill(s, n).hex();
}

// By rejection sampling, never `% span`. A byte modulo 3 maps 256 values
// onto 3, and 256 is not a multiple of 3, so one outcome is 2% rarer than
// the others -- from one line that looks obviously correct. Instead: keep
// only the low bits that cover the span, which is uniform because every bit
// pattern is equally likely, and redraw anything past the end. The redraw
// costs at most one extra draw on average.
//
// Keeping the low `bits` bits is exactly the mask Oro applies; the octets are
// read most significant first, as Oro reads them, so a seeded generator
// answers the same integers in both.
int integer_from(Source s, int low, int high) {
    if (high < low) {
        trap("random.integer(" + low.to_str() + ", " + high.to_str() + "): the range is empty -- high is below low, and both ends are included");
    }
    if (low == high) {
        return low;
    }
    // A span wider than 2^63 does not fit an int; it takes its own path.
    if (low < 0 && high > max_int() + low) {
        return integer_wide(s, low, high);
    }
    int last = high - low;
    int bits = bit_length(last);
    int count = (bits + 7) / 8;
    int drawn = low_bits(fill(s, count), bits);
    while (drawn > last) {
        drawn = low_bits(fill(s, count), bits);
    }
    return low + drawn;
}

// [low, high] spanning more than 2^63 values: all 64 bits are drawn, read as
// an unsigned number `top * 2^63 + rest`, and kept when low plus it is at
// most high -- which accepts more than half of all draws.
int integer_wide(Source s, int low, int high) {
    while (true) {
        bytes b = fill(s, 8);
        int top = b[0] >> 7;
        int rest = low_bits(b, 63);
        if (top == 0) {
            // low < 0 and rest < 2^63, and high - low exceeds 2^63 - 1, so
            // this is always inside the range.
            return low + rest;
        }
        // low + 2^63, written so that no step overflows: low is negative.
        int base = low + max_int() + 1;
        if (rest <= high - base) {
            return base + rest;
        }
    }
}

// Seven octets, three bits dropped: 53 bits over 2^53, which is CPython's
// construction and the only one that cannot round up to exactly 1.0.
float fraction_from(Source s) {
    int n = low_bits(fill(s, 7), 56) >> 3;
    return float(n) / 9007199254740992.0;
}

// Fisher-Yates over 0..n-1, downwards, which is its own direction: element
// `i` is settled by swapping it with one chosen from 0..i, so every
// permutation is reachable exactly once.
List<int> permutation_from(Source s, int n) {
    check_count(n, "permutation");
    List<int> out = [];
    int k = 0;
    while (k < n) {
        out.push(k);
        k = k + 1;
    }
    int i = n - 1;
    while (i > 0) {
        int j = integer_from(s, 0, i);
        int held = out[i];
        out[i] = out[j];
        out[j] = held;
        i = i - 1;
    }
    return out;
}

// 122 random bits, with the version nibble (4) and the two-bit variant (10)
// written over the draw where RFC 4122 puts them. The hyphens are part of the
// format: this string is the UUID.
str uuid4_from(Source s) {
    bytes b = fill(s, 16);
    b[6] = b[6] & 0x0f | 0x40;
    b[8] = b[8] & 0b0011_1111 | 0b1000_0000;
    str h = b.hex();
    return h.substr(0, 8) + "-" + h.substr(8, 12) + "-" + h.substr(12, 16) + "-" + h.substr(16, 20) + "-" + h.substr(20, 32);
}

// --- PCG-XSH-RR 64/32 ---------------------------------------------------------
//
// The state advances as a 64-bit LCG, state * 6364136223846793005 + inc,
// modulo 2^64; the output is the OLD state xor-shifted down to 32 bits and
// rotated by its own top five bits. With the reference demo's arguments (seed
// 42, stream 54) this produces PCG's published output, a15c02b7 7b47f409
// ba1d3330 ...
//
// The state is an `int` holding the 64-bit pattern, so the LCG is the two
// wrapping methods and the output function is bit operators. `>>` copies the
// sign bit in, and PCG means the unsigned shift, so every right shift of the
// state goes through `shr`.
//
// step: state * multiplier + increment, mod 2^64. The increment is Oro's stream
// constant, shifted left once with its low bit set:
// (1442695040888963407 << 1) | 1.
int step(int state) {
    return state.wrapping_mul(6364136223846793005).wrapping_add(2885390081777926815);
}

// One 32-bit output: the previous state is what gets permuted, so the
// multiply and the output function are independent of each other.
int next32(List<int> state) {
    int old = state[0];
    state[0] = step(old);
    int xorshifted = shr(shr(old, 18) ^ old, 27) & 0xFFFF_FFFF;
    int rot = shr(old, 59);
    // Rotate right by rot within 32 bits. A shift by 32 is in range, so
    // rot == 0 needs no case of its own; the mask drops what it pushes up.
    return (xorshifted >> rot | xorshifted << 32 - rot) & 0xFFFF_FFFF;
}

// n octets: each 32-bit output gives four, most significant first, and what
// is left of the last one is dropped -- Oro's order, octet for octet.
bytes pcg_fill(List<int> state, int n) {
    bytes out = [];
    while (out.size() < n) {
        int v = next32(state);
        int shift = 24;
        while (shift >= 0 && out.size() < n) {
            out.push(v >> shift & 255);
            shift = shift - 8;
        }
    }
    return out;
}

// The logical right shift, `x >>> n` for 1 <= n <= 63: the arithmetic shift
// with the copied-in sign bits masked off, as the reference spells it (§6.1).
int shr(int x, int n) {
    return x >> n & ~(-1 << 64 - n);
}

// --- small arithmetic -------------------------------------------------------
int max_int() {
    return 0x7FFF_FFFF_FFFF_FFFF;
}

// How many bits it takes to write `n`, which is positive here.
int bit_length(int n) {
    int bits = 0;
    int rest = n;
    while (rest > 0) {
        bits = bits + 1;
        rest = rest >> 1;
    }
    return bits;
}

// The octets as one number, most significant first, keeping only the low
// `bits` bits (1..63). The top octet is masked before anything is shifted
// past it, so eight octets never reach the sign bit.
int low_bits(bytes b, int bits) {
    int n = b.size();
    int top = bits - 8 * (n - 1);
    int out = b[0] & (1 << top) - 1;
    int i = 1;
    while (i < n) {
        out = out << 8 | b[i];
        i = i + 1;
    }
    return out;
}

void check_count(int n, str who) {
    if (n < 0) {
        trap("random." + who + "(" + n.to_str() + "): a count cannot be negative");
    }
}
