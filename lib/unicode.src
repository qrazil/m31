// What a reader means by a character: case, and the tables that answer it.
//
// **Unicode 16.0.0.** Every table below is generated from the Unicode
// Character Database, and the command that generated it is quoted above it.
// `unicode.VERSION` is the version those files were, so a program can print
// what it was built against.
//
// --- why this is a module and not a method ---------------------------------
//
// `s.to_upper()` and `s.to_lower()` stay **ASCII only**: `"école".to_upper()`
// is `"éCOLE"`. This module's `unicode.upper(s)` is `"ÉCOLE"`. Both exist,
// and the division is deliberate:
//
//   - A method on every `str` is a promise the language keeps everywhere,
//     and the language is one binary with no data files. Full case mapping
//     is ~28 KB of tables; putting it behind a method would put it in every
//     program that uppercases an option name.
//   - The ASCII rule is total and needs nothing: it is right for a protocol
//     token, a header name, a file extension, a hex digit -- which is most
//     of what a program uppercases, and all of what the standard library
//     does. It is also the one mapping that is the same in every language.
//   - Full case mapping is not a function from one character to one
//     character (`ß` is `SS`, one code point becoming two), it depends on
//     the rest of the string (a final sigma), and in three languages it
//     depends on the human language the text is in. None of that belongs
//     behind a name as innocent as `to_upper`.
//
// So: `str` answers the ASCII question, `unicode` answers the Unicode one,
// and a reader of a call site can tell which was meant. Importing this
// module is what costs the tables -- a program that does not import it emits
// none of them, because a module's constants are emitted only when the
// module is loaded.
//
// --- no locale ---------------------------------------------------------------
//
// `SpecialCasing.txt` has sixteen conditional mappings. One is conditional on
// the text alone -- the Greek final sigma, `Σ` at the end of a word lowercases
// to `ς`, not `σ` -- and this module implements it, because the condition is
// in the string and an implementation that ignored it would be wrong about
// ordinary Greek. The other fifteen are conditional on a **language**:
// Turkish and Azeri map `I` to `ı` and `i` to `İ`, and Lithuanian keeps a dot
// above a lowercase i under an accent.
//
// Those are not implemented, and `upper`/`lower` take no locale, because a
// locale is not a property of a `str`. The language has no locale type, no
// notion of a current one, and a `str` carries no tag saying what language
// its text is in -- so the only honest spelling would be an extra argument
// on every call, which every call site would have to answer, almost always
// with "none". A program that genuinely needs Turkish casing knows it does,
// and can map `I` and `i` itself before calling: the two code points are
// spelled out, in the open, in that program, rather than hidden behind a
// flag that is wrong by default. Getting this wrong silently is the famous
// bug (`"I".to_lower() == "i"` is false in Turkish), and it is worse when a
// library guesses the locale from the environment, as C's `tolower` does.
//
// Turkic **case folding** (`CaseFolding.txt` status T) is dropped for the
// same reason: `fold` is the default, language-independent folding, which is
// what a caseless comparison of text of unknown origin wants.
//
// --- the shape of the tables ------------------------------------------------
//
// Simple mapping is a list of runs, `(lo, hi, step, delta)`: every code point
// from `lo` to `hi`, `step` apart, maps by adding `delta`. The step is what
// makes it small -- Latin Extended-A is 256 alternating upper/lower pairs,
// `0100 0102 0104 ...` all mapping by -1, which is one run with a step of 2
// rather than 128 runs. 1,477 upper mappings come to 205 runs, and a lookup
// is a binary search over them.
//
// A mapping that is not one-to-one -- `ß` to `SS` -- cannot be a delta, so it
// is a second, smaller table looked up first: sorted keys, and the values
// flattened into one array with an offset per key.

/// The version of the Unicode Character Database these tables come from.
pub const str VERSION = "16.0.0";

/// `s` with every character replaced by its uppercase form.
///
/// Full mapping, so the result may be longer than the input in characters as
/// well as in bytes: `unicode.upper("straße")` is `"STRASSE"`. Not
/// locale-sensitive; see the module header.
pub str upper(str s) {
    List<int> out = [];
    for (int c in s.chars()) {
        int at = key_index(SPECIAL_UPPER_FROM, c);
        if (at >= 0) {
            append_slice(out, SPECIAL_UPPER_TO, SPECIAL_UPPER_AT[at], SPECIAL_UPPER_AT[at + 1]);
        } else {
            out.push(c + run_delta(UPPER_RUNS, c));
        }
    }
    return str.from_chars(out);
}

/// `s` with every character replaced by its lowercase form.
///
/// A capital sigma at the end of a word becomes `ς` rather than `σ`, which
/// is the one context-dependent rule this module implements (see the header);
/// `unicode.lower("ΟΔΟΣ")` is `"οδος"`.
pub str lower(str s) {
    List<int> cps = s.chars();
    List<int> out = [];
    int n = cps.size();
    int i = 0;
    while (i < n) {
        int c = cps[i];
        if (c == CAPITAL_SIGMA && final_sigma(cps, i)) {
            out.push(FINAL_SIGMA);
        } else {
            int at = key_index(SPECIAL_LOWER_FROM, c);
            if (at >= 0) {
                append_slice(out, SPECIAL_LOWER_TO, SPECIAL_LOWER_AT[at], SPECIAL_LOWER_AT[at + 1]);
            } else {
                out.push(c + run_delta(LOWER_RUNS, c));
            }
        }
        i = i + 1;
    }
    return str.from_chars(out);
}

/// `s` folded for caseless comparison: `unicode.fold(a) == unicode.fold(b)`
/// is the caseless equality of `a` and `b`.
///
/// This is Unicode's full, default case folding (`CaseFolding.txt`, statuses
/// C and F), which is *not* the same thing as lowercasing: it maps `ß` to
/// `ss` and `ς` to `σ` so that the pairs compare equal, and it is defined to
/// be stable under itself. The result is not text to show anyone -- it is a
/// key. Folding does not normalise, so `"é"` and `"e\u{301}"` still differ;
/// that is `nfc` first (§NFC), and neither is a collation.
pub str fold(str s) {
    List<int> out = [];
    for (int c in s.chars()) {
        int at = key_index(FOLD_FULL_FROM, c);
        if (at >= 0) {
            append_slice(out, FOLD_FULL_TO, FOLD_FULL_AT[at], FOLD_FULL_AT[at + 1]);
        } else {
            out.push(c + run_delta(FOLD_RUNS, c));
        }
    }
    return str.from_chars(out);
}

// --- the lookups -------------------------------------------------------------

/// What to add to `c` to map it, or 0 if this table leaves it alone.
///
/// A binary search over `(lo, hi, step, delta)` runs of four. A table is a
/// module constant, so it is static data in the emitted program and this is
/// four bounds-checked loads a step.
int run_delta(Array<int> runs, int c) {
    int lo = 0;
    int hi = runs.size() / 4 - 1;
    while (lo <= hi) {
        int mid = (lo + hi) / 2;
        int at = mid * 4;
        if (c < runs[at]) {
            hi = mid - 1;
        } else if (c > runs[at + 1]) {
            lo = mid + 1;
        } else if ((c - runs[at]) % runs[at + 2] == 0) {
            return runs[at + 3];
        } else {
            // Inside a run, but on one of the code points it steps over.
            return 0;
        }
    }
    return 0;
}

/// Where `c` is in a sorted array of keys, or -1.
int key_index(Array<int> keys, int c) {
    int lo = 0;
    int hi = keys.size() - 1;
    while (lo <= hi) {
        int mid = (lo + hi) / 2;
        if (c < keys[mid]) {
            hi = mid - 1;
        } else if (c > keys[mid]) {
            lo = mid + 1;
        } else {
            return mid;
        }
    }
    return -1;
}

/// Append `from[at .. end]` to `out`.
void append_slice(List<int> out, Array<int> from, int at, int end) {
    int i = at;
    while (i < end) {
        out.push(from[i]);
        i = i + 1;
    }
}

/// Is `c` in a sorted list of `(lo, hi)` ranges?
bool in_ranges(Array<int> ranges, int c) {
    int lo = 0;
    int hi = ranges.size() / 2 - 1;
    while (lo <= hi) {
        int mid = (lo + hi) / 2;
        int at = mid * 2;
        if (c < ranges[at]) {
            hi = mid - 1;
        } else if (c > ranges[at + 1]) {
            lo = mid + 1;
        } else {
            return true;
        }
    }
    return false;
}

// --- the final sigma ----------------------------------------------------------

/// U+03A3 GREEK CAPITAL LETTER SIGMA.
const int CAPITAL_SIGMA = 931;
/// U+03C2 GREEK SMALL LETTER FINAL SIGMA.
const int FINAL_SIGMA = 962;

/// Is the sigma at `cps[i]` at the end of a word?
///
/// UAX #21's `Final_Sigma` condition, word for word: it is preceded by a
/// cased character, and not followed by one -- looking through characters
/// that carry no case of their own (accents, the apostrophe in `ΜΑΪΟΣ'`) in
/// both directions. `"ΣΣ"` lowercases to `"σς"`: the first sigma has nothing
/// cased before it, the second has nothing cased after it.
bool final_sigma(List<int> cps, int i) {
    int j = i - 1;
    while (j >= 0 && in_ranges(CASE_IGNORABLE, cps[j])) {
        j = j - 1;
    }
    if (j < 0 || !in_ranges(CASED, cps[j])) {
        return false;
    }
    int n = cps.size();
    int k = i + 1;
    while (k < n && in_ranges(CASE_IGNORABLE, cps[k])) {
        k = k + 1;
    }
    return k >= n || !in_ranges(CASED, cps[k]);
}

// --- the tables ---------------------------------------------------------------
//
// Generated, not written. Every array below came out of
//
//     python3 gen.py case
//
// reading the Unicode Character Database 16.0.0 as installed at
// /usr/share/unicode/ucd. The script is not in the repository (it is a
// build-time tool for a file that changes once a Unicode version); what it
// does to each table is written above that table, and the counts are its
// output, so a regeneration that disagrees with them is a change to report.
//
// The run encoder both simple tables use, and the whole of the compression:
// a code point maps by adding `delta`, runs of code points that share one
// delta become one entry, and a run whose members are two apart -- the
// alternating upper/lower pairs Latin Extended-A and Cyrillic are built from
// -- becomes one entry with a step of 2 rather than one entry each.
//
//     def runs_of(m):                    # m: cp -> mapped cp, from the UCD
//         cps = sorted(m); out = []; i = 0
//         while i < len(cps):
//             cp = cps[i]; d = m[cp] - cp; j = i; k = i
//             while (j + 1 < len(cps) and cps[j+1] == cps[j] + 1
//                    and m[cps[j+1]] - cps[j+1] == d): j += 1
//             while (k + 1 < len(cps) and cps[k+1] == cps[k] + 2
//                    and m[cps[k+1]] - cps[k+1] == d): k += 1
//             if k > j: out.append([cp, cps[k], 2, d]); i = k + 1
//             else:     out.append([cp, cps[j], 1, d]); i = j + 1
//         return out

