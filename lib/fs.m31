// The file system: names, directories and trees. A port of Oro's `fs`, with
// the path-level verbs Oro keeps in `os` brought in beside it.
//
// API
// ---
//   fs.stat(path)            -> Result<Stat, io.Error>        follows symlinks
//   fs.is_present(path)          -> bool                          (a dangling link is not there)
//   fs.is_file(path), fs.is_directory(path)  -> bool                follow symlinks
//   fs.is_link(path)         -> bool                          the name itself
//   fs.listdir(path)         -> Result<List<str>, io.Error>   names, sorted
//   fs.mkdir(path)           -> Result<bool, io.Error>        one directory
//   fs.remove(path)          -> Result<bool, io.Error>        a file or a link
//   fs.rmdir(path)           -> Result<bool, io.Error>        an empty directory
//   fs.rename(from, to)      -> Result<bool, io.Error>
//   fs.symlink(target, path) -> Result<bool, io.Error>        a link at path, to target
//   fs.join(a, b)            -> str
//   fs.makedirs(path)        -> Result<bool, io.Error>        every missing component
//   fs.walk(root)            -> Result<List<str>, io.Error>   every entry below root
//   fs.glob(pattern)         -> List<str>                     *, ?, [abc], [!abc], [a-z]
//   fs.rmtree(path, within)  -> Result<bool, io.Error>        recursive delete, guarded
//   fs.copy(src, dst)        -> Result<int, io.Error>         contents and permission bits
//
// Every failure is an `io.Error`, built by `io.from_errno`: one vocabulary
// for everything that touches a file, so a program handling `NotFound`
// handles it the same from `io.open` and from `fs.listdir`.
//
// As in Oro, the verbs that matter -- the recursive delete above all -- are
// language source over a handful of one-call primitives. A recursive delete
// you can read in forty lines of the language you are already writing is one
// you can audit.
//
// Not here, for Oro's reasons: no `copytree` (walk + makedirs + copy, and
// every real use wants a decision this cannot make), no `**` in glob (`walk`
// is the recursive answer), and no `lstat` or `follow_symlinks=` -- `stat`
// follows, `walk` and `rmtree` never do, and `is_link` asks about the name.

import io;

prim int __stat(str path, bool is_follow, List<int> out);
prim int __mkdir(str path, int mode);
prim int __unlink(str path);
prim int __rmdir(str path);
prim int __rename(str from, str to_path);
prim int __symlink(str target, str path);
prim int __listdir(str path, bytes buffer);

// File type bits in a mode, the historical Unix values and the same on
// every system (runtime/sys.h), in octal as they are usually written: type
// mask 0o170000, directory 0o040000, regular file 0o100000, symlink
// 0o120000, permission bits 0o777.
/// What `stat` reports about a file.
///
/// `mode` is the whole Unix mode: the type in its high bits, the
/// permissions in the low nine. `mtime_ns` is the last modification, in
/// nanoseconds since 1970 -- an int, so two stamps compare exactly, which a
/// float of seconds cannot promise.
pub type Stat {
    pub int size;
    pub int mode;
    pub int mtime_ns;
}

/// Is it a directory?
pub bool Stat.is_directory() {
    return mode & 0o170000 == 0o040000;
}

/// Is it a regular file -- not a directory, a device, a FIFO or a socket?
pub bool Stat.is_file() {
    return mode & 0o170000 == 0o100000;
}

/// The permission bits alone, `mode & 0o777`: what `chmod` takes.
pub int Stat.perm() {
    return mode & 0o777;
}

Result<Stat, io.Error> stat_of(str path, bool is_follow) {
    List<int> got = [];
    int status_code = __stat(path, is_follow, got);
    if (status_code < 0) {
        return Result<Stat, io.Error>.Err(io.from_errno(-status_code));
    }
    return Result<Stat, io.Error>.Ok(Stat(got[0], got[1], got[2]));
}

// A void result for a primitive that answers 0 or -errno.
Result<bool, io.Error> done(int status_code) {
    if (status_code < 0) {
        return Result<bool, io.Error>.Err(io.from_errno(-status_code));
    }
    return Result<bool, io.Error>.Ok(true);
}

// --- one name at a time ------------------------------------------------------
/// What the file at `path` is, following symlinks: a link reports its
/// target, and a dangling link is `NotFound`.
pub Result<Stat, io.Error> stat(str path) {
    return stat_of(path, true);
}

/// Is there something at `path`? A symlink whose target is missing is not
/// there, because every operation on it would fail as if it were not; ask
/// `is_link` about the name itself.
pub bool is_present(str path) {
    match (stat_of(path, true)) {
        case Ok: {
            return true;
        }
        case Err: {
            return false;
        }
    }
}

/// Is `path` a directory, or a symlink to one?
pub bool is_directory(str path) {
    match (stat_of(path, true)) {
        case Ok(Stat file_status): {
            return file_status.is_directory();
        }
        case Err: {
            return false;
        }
    }
}

/// Is `path` a regular file, or a symlink to one?
pub bool is_file(str path) {
    match (stat_of(path, true)) {
        case Ok(Stat file_status): {
            return file_status.is_file();
        }
        case Err: {
            return false;
        }
    }
}

/// Is the name `path` itself a symlink? The one question here that does
/// not follow the link.
pub bool is_link(str path) {
    match (stat_of(path, false)) {
        case Ok(Stat file_status): {
            return file_status.mode & 0o170000 == 0o120000;
        }
        case Err: {
            return false;
        }
    }
}

/// The names in the directory `path`, without `.` and `..`, **sorted**.
///
/// Oro's `os.listdir` answers in the file system's order, which is arbitrary
/// and differs between two machines holding the same tree; sorting here
/// means every caller gets one answer, and a test of it is stable. Sorted is
/// by bytes, which for UTF-8 is by code point.
///
/// A name that is not valid UTF-8 cannot become a `str`, so a directory
/// holding one is `Err(InvalidUtf8)` rather than a listing that silently
/// leaves it out.
pub Result<List<str>, io.Error> listdir(str path) {
    return list_names(path, true);
}

// The listing behind `listdir` and `glob`. `is_strict` says what a name that is
// not valid UTF-8 does: fails the whole listing (`listdir`, whose caller
// asked for every name and must not be told a partial answer is complete),
// or is skipped (`glob`, which only ever asks "which names match this
// pattern" -- and a name that is not text can match no `str` pattern, nor be
// handed back as a `str` if it did).
Result<List<str>, io.Error> list_names(str path, bool is_strict) {
    bytes buffer = [0; 4096];
    int need = __listdir(path, buffer);
    // Too small: the answer is the size the listing needs, so ask again
    // with that much. It loops because the directory may grow in between.
    while (need > buffer.size()) {
        buffer = [0; need + need / 4];
        need = __listdir(path, buffer);
    }
    if (need < 0) {
        return Result<List<str>, io.Error>.Err(io.from_errno(-need));
    }
    List<str> out = [];
    int start = 0;
    for (int i in 0 .. need) {
        if (buffer[i] == 0) {
            match (buffer.substr(start, i).utf8()) {
                case Some(str name): {
                    out.push(name);
                }
                case None: {
                    if (is_strict) {
                        return Result<List<str>, io.Error>.Err(io.Error.InvalidUtf8);
                    }
                }
            }
            start = i + 1;
        }
    }
    out.sort();
    return Result<List<str>, io.Error>.Ok(out);
}

/// Create the directory `path`. Its parent must exist; `makedirs` makes
/// them all. The permissions are `0o777` less the umask, as `mkdir(1)` gives.
pub Result<bool, io.Error> mkdir(str path) {
    return done(__mkdir(path, 0o777));
}

/// Remove the file `path`. A symlink is removed itself, never its target.
/// A directory is `IsDirectory` on Linux (`rmdir` removes an empty one,
/// `rmtree` a full one).
pub Result<bool, io.Error> remove(str path) {
    return done(__unlink(path));
}

/// Remove the empty directory `path`; one with anything in it is
/// `NotEmpty`.
pub Result<bool, io.Error> rmdir(str path) {
    return done(__rmdir(path));
}

/// Rename `from` to `to_path`, replacing a file already at `to_path`. Within one file
/// system this is atomic, which is what makes write-then-rename the way to
/// replace a file other programs read; across two it fails with
/// `Other(18)` (EXDEV), and copying is the caller's decision.
pub Result<bool, io.Error> rename(str from, str to_path) {
    return done(__rename(from, to_path));
}

/// Make `path` a symbolic link to `target`. The target is stored as
/// written and not checked -- a link may dangle, and a relative target
/// is resolved from the link's own directory, not from here. A name
/// already at `path` is `AlreadyExists`; links are never replaced.
pub Result<bool, io.Error> symlink(str target, str path) {
    return done(__symlink(target, path));
}

/// `child` below `parent`: `join("src", "a.txt")` is `src/a.txt`.
///
/// Unlike Python's `os.path.join`, an absolute `child` does NOT replace `parent`:
/// `join(root, name)` with a name from outside stays inside `root`'s
/// spelling, which is what the call looks like it means. An empty `parent` is
/// `child` unchanged, so a relative walk from "" stays relative.
pub str join(str parent, str child) {
    if (parent == "") {
        return child;
    }
    if (parent.ends_with("/")) {
        if (child.starts_with("/")) {
            return parent + child.substr(1, child.size());
        }
        return parent + child;
    }
    if (child.starts_with("/")) {
        return parent + child;
    }
    return parent + "/" + child;
}

// --- trees ---------------------------------------------------------------------
/// Create `path` and every missing directory above it.
///
/// **Not an error if it is already there** -- `makedirs` exists to make a
/// path usable, and a caller who needs "it must not exist yet" has `mkdir`,
/// which is exactly that. It IS an error if a component exists and is not a
/// directory: `AlreadyExists` from `mkdir`, because a file where a directory
/// should be is a real fault. A symlink to a directory counts as one.
pub Result<bool, io.Error> makedirs(str path) {
    if (path == "") {
        return Result<bool, io.Error>.Err(io.from_errno(22));
    }
    str prefix = "";
    if (path.starts_with("/")) {
        prefix = "/";
    }
    for (str part in path.split("/")) {
        // Empty parts come from a leading, doubled or trailing separator.
        if (part == "") {
            continue;
        }
        prefix = join(prefix, part);
        if (is_directory(prefix)) {
            continue;
        }
        int status_code = __mkdir(prefix, 0o777);
        // Another process may have made it between the check and the
        // mkdir. That race is the ordinary case for a shared build
        // directory, and its outcome is what was wanted.
        if (status_code < 0 && !is_directory(prefix)) {
            return Result<bool, io.Error>.Err(io.from_errno(-status_code));
        }
    }
    return Result<bool, io.Error>.Ok(true);
}

/// Every entry below `root`, files and directories both.
///
/// **Order is deterministic**: depth first, each directory's entries sorted
/// by name, and a directory listed just before what is inside it.
///
/// **Symlinks are never followed.** A link appears as the entry it is,
/// even one to a directory, and nothing below it is visited: following
/// would mean cycles (`a/link -> a`) and escapes (`a/link -> /`).
///
/// Each path is `root` joined to the names, spelled as `root` was: a
/// relative root gives relative paths. `root` itself is not in the list. A
/// directory that cannot be listed is an error, not a gap -- a walk that
/// skipped what it could not read would be lying about what it walked.
pub Result<List<str>, io.Error> walk(str root) {
    List<str> out = [];
    walk_into(root, out)?;
    return Result<List<str>, io.Error>.Ok(out);
}

Result<bool, io.Error> walk_into(str directory, List<str> out) {
    for (str name in listdir(directory)?) {
        str path = join(directory, name);
        out.push(path);
        // One stat that does not follow: a link is not a directory here,
        // whatever it points at, and that is the whole symlink rule.
        match (stat_of(path, false)) {
            case Ok(Stat file_status): {
                if (file_status.is_directory()) {
                    walk_into(path, out)?;
                }
            }
            case Err(io.Error error): {
                return Result<bool, io.Error>.Err(error);
            }
        }
    }
    return Result<bool, io.Error>.Ok(true);
}

/// Every path matching `pattern`, sorted.
///
///     fs.glob("*.src")
///     fs.glob("/etc/*.conf")
///     fs.glob("src/[a-z]*/main.src")
///
/// `*` is any run of characters, `?` exactly one, `[abc]` one of a set,
/// `[!abc]` one not in it, `[a-z]` one in a range. **None of them crosses a
/// `/`**: the pattern is matched one component at a time. Characters, not
/// bytes: `?` matches `é`, all two bytes of it.
///
/// **A wildcard does not match a leading dot**, the rule every shell has:
/// `*` does not find `.git`, and `.*` does.
///
/// A pattern that matches nothing is an empty list, not an error: this asks
/// a question. A directory that cannot be listed contributes nothing, which
/// is what makes `glob("*/*.conf")` usable across a tree the caller does
/// not wholly own. A symlink is an entry like any other, dangling or not.
///
/// **A name that is not valid UTF-8 is skipped**, and the directory's other
/// names still match. Such a name cannot match a `str` pattern and could not
/// be returned as a `str` if it did; `listdir` is the call that refuses a
/// directory holding one rather than leave it out, because it promises every
/// name.
pub List<str> glob(str pattern) {
    List<str> none = [];
    if (pattern == "") {
        return none;
    }
    str base = "";
    if (pattern.starts_with("/")) {
        base = "/";
    }
    List<str> parts = [];
    for (str part in pattern.split("/")) {
        if (part != "") {
            parts.push(part);
        }
    }
    if (parts.size() == 0) {
        // The pattern was "/": the root directory itself.
        List<str> root = [base];
        return root;
    }
    List<str> out = [];
    glob_step(base, parts, 0, out);
    return out;
}

void glob_step(str base, List<str> parts, int part_index, List<str> out) {
    if (part_index == parts.size()) {
        out.push(base);
        return;
    }
    str part = parts[part_index];
    if (!has_magic(part)) {
        // A literal component is not a search: join it and check it is
        // there, a dangling link included.
        str next = join(base, part);
        if (is_present(next) || is_link(next)) {
            glob_step(next, parts, part_index + 1, out);
        }
        return;
    }
    str directory = base;
    if (directory == "") {
        directory = ".";
    }
    // A directory that cannot be listed matches nothing: unreadable and
    // empty are the same answer to "what matches here". walk does not do
    // this; see there. Not `listdir`: one name that is not UTF-8 would make
    // the whole directory unlistable, hiding every name that does match.
    match (list_names(directory, false)) {
        case Ok(List<str> names): {
            List<int> pattern = chars(part);
            for (str name in names) {
                if (is_match(chars(name), pattern)) {
                    glob_step(join(base, name), parts, part_index + 1, out);
                }
            }
        }
        case Err: {
        }
    }
}

bool has_magic(str part) {
    return part.contains("*") || part.contains("?") || part.contains("[");
}

// The code points of a str, so that `?` and a class match a character
// rather than a byte. The input came from utf8() or a literal, so it is
// well formed; a truncated tail is taken as far as it goes.
List<int> chars(str text) {
    List<int> out = [];
    int index = 0;
    int byte_count = text.size();
    while (index < byte_count) {
        int lead_byte = text.byte_at(index);
        int sequence_length = 1;
        int code_point = lead_byte;
        if (lead_byte >= 240) {
            sequence_length = 4;
            code_point = lead_byte & 7;
        } else if (lead_byte >= 224) {
            sequence_length = 3;
            code_point = lead_byte & 15;
        } else if (lead_byte >= 192) {
            sequence_length = 2;
            code_point = lead_byte & 31;
        }
        int offset = 1;
        while (offset < sequence_length && index + offset < byte_count) {
            code_point = code_point << 6 | text.byte_at(index + offset) & 63;
            offset = offset + 1;
        }
        out.push(code_point);
        index = index + sequence_length;
    }
    return out;
}

// Does the component `name` match the one-component pattern `pattern`?
//
// Oro's matcher, and the classic one: the last `*` is remembered and
// resumed from one character further on a mismatch, so a pattern full of
// stars costs O(len(name) * len(pat)) instead of the exponential a naive
// recursion takes on `*a*a*a*...`. Characters: `*` 42, `?` 63, `[` 91,
// `.` 46.
bool is_match(List<int> name, List<int> pattern) {
    int name_length = name.size();
    int pattern_length = pattern.size();
    // The leading-dot rule, where the shell applies it: to a wildcard, not
    // to a pattern that asked for the dot by writing it.
    if (name_length > 0 && name[0] == 46 && (pattern_length == 0 || pattern[0] != 46)) {
        return false;
    }
    int name_index = 0;
    int pattern_index = 0;
    int star = -1;
    int star_ni = 0;
    while (true) {
        if (pattern_index < pattern_length) {
            int pattern_code = pattern[pattern_index];
            if (pattern_code == 42) {
                star = pattern_index;
                star_ni = name_index;
                pattern_index = pattern_index + 1;
                continue;
            }
            if (name_index < name_length) {
                bool is_hit = false;
                if (pattern_code == 91) {
                    int shut = class_end(pattern, pattern_index);
                    if (shut == -1) {
                        // An unterminated `[` is a literal `[`, as fnmatch
                        // has it.
                        is_hit = name[name_index] == 91;
                        if (is_hit) {
                            pattern_index = pattern_index + 1;
                        }
                    } else {
                        is_hit = is_class_match(pattern, pattern_index + 1, shut, name[name_index]);
                        if (is_hit) {
                            pattern_index = shut + 1;
                        }
                    }
                } else if (pattern_code == 63) {
                    is_hit = true;
                    pattern_index = pattern_index + 1;
                } else {
                    is_hit = pattern_code == name[name_index];
                    if (is_hit) {
                        pattern_index = pattern_index + 1;
                    }
                }
                if (is_hit) {
                    name_index = name_index + 1;
                    continue;
                }
            }
        } else if (name_index == name_length) {
            return true;
        }
        // No match here: resume one character further into the last `*`,
        // or fail if there was none.
        if (star == -1) {
            return false;
        }
        star_ni = star_ni + 1;
        if (star_ni > name_length) {
            return false;
        }
        name_index = star_ni;
        pattern_index = star + 1;
    }
}

// The index of the `]` closing the class that opens at `open_at`, or -1.
// A `]` straight after the `[`, or after a negating `!`, is a member and
// not the end: fnmatch's rule, which makes `[]]` and `[!]]` mean what they
// look like. `!` 33, `]` 93.
int class_end(List<int> pattern, int open_at) {
    int index = open_at + 1;
    if (index < pattern.size() && pattern[index] == 33) {
        index = index + 1;
    }
    if (index < pattern.size() && pattern[index] == 93) {
        index = index + 1;
    }
    while (index < pattern.size()) {
        if (pattern[index] == 93) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// Is `code_point` in the class whose body is pat[start .. close]? A `-` between
// two characters is a range; one at either end is a literal hyphen. `-` 45.
bool is_class_match(List<int> pattern, int start, int close, int code_point) {
    int index = start;
    bool is_negate = false;
    if (index < close && pattern[index] == 33) {
        is_negate = true;
        index = index + 1;
    }
    bool is_hit = false;
    while (index < close) {
        if (index + 2 < close && pattern[index + 1] == 45) {
            if (pattern[index] <= code_point && code_point <= pattern[index + 2]) {
                is_hit = true;
            }
            index = index + 3;
        } else {
            if (pattern[index] == code_point) {
                is_hit = true;
            }
            index = index + 1;
        }
    }
    return is_hit != is_negate;
}

/// Remove the directory tree at `path`, which must be inside `within`.
///
///     fs.rmtree(dir, dir)                       // the tree I made is the tree I may delete
///     fs.rmtree(fs.join(cache, key), cache)
///
/// **`within` is required.** This is the one verb that can destroy a
/// machine from one wrong string, and the defence is that the caller must
/// say, at the call site, which tree it may delete inside. Oro checks that
/// by resolving both paths; this has no `realpath`, so it checks the
/// spelling and then the file system, and refuses rather than guesses:
///
///   - `path` must be `within` or spelled below it, with no `.` or `..`
///     component on the way down. Anything else **traps**: the two
///     arguments disagree about which tree this is, and that is a bug at
///     the call site, not a condition to handle.
///   - no component from below `within` down to `path` may be a symlink,
///     and `path` itself must not be one: `Err(Other(40))`, ELOOP, the
///     errno the kernel itself answers when told not to follow a link. A
///     link there would take the delete outside the tree it names.
///   - `path` missing is `NotFound`; `path` a file is `NotADirectory` --
///     remove a file with `remove`.
///
/// **A symlink inside the tree is unlinked, not followed**; its target
/// survives. There is no `ignore_errors`: a failure part way leaves the tree
/// partly deleted and says so, because that is what happened.
pub Result<bool, io.Error> rmtree(str path, str within) {
    str boundary = within;
    while (boundary.size() > 1 && boundary.ends_with("/")) {
        boundary = boundary.substr(0, boundary.size() - 1);
    }
    str rest = "";
    if (path == boundary || path == boundary + "/") {
        rest = "";
    } else if (boundary == "/" && path.starts_with("/")) {
        rest = path.substr(1, path.size());
    } else if (path.starts_with(boundary + "/")) {
        rest = path.substr(boundary.size() + 1, path.size());
    } else {
        trap("rmtree refused: '" + path + "' is not inside '" + within + "'");
    }
    // Every component on the way down: spelled plainly, and not a link.
    str current_path = boundary;
    for (str part in rest.split("/")) {
        if (part == "") {
            continue;
        }
        if (part == "." || part == "..") {
            trap("rmtree refused: '" + path + "' climbs with '" + part + "'; name the directory plainly");
        }
        current_path = join(current_path, part);
        Stat file_status = stat_of(current_path, false)?;
        if (file_status.mode & 0o170000 == 0o120000) {
            return Result<bool, io.Error>.Err(io.Error.Other(40));
        }
    }
    Stat top = stat_of(path, false)?;
    if (top.mode & 0o170000 == 0o120000) {
        return Result<bool, io.Error>.Err(io.Error.Other(40));
    }
    if (!top.is_directory()) {
        return Result<bool, io.Error>.Err(io.Error.NotADirectory);
    }
    return rm_into(path);
}

Result<bool, io.Error> rm_into(str directory) {
    for (str name in listdir(directory)?) {
        str path = join(directory, name);
        // Not following: a link, to a directory or anywhere else, is
        // removed as the name it is and costs its target nothing.
        Stat file_status = stat_of(path, false)?;
        if (file_status.is_directory()) {
            rm_into(path)?;
        } else {
            done(__unlink(path))?;
        }
    }
    return done(__rmdir(directory));
}

/// Copy the file `source` to `destination`: its contents and its permission bits.
/// Returns the number of bytes copied.
///
/// **`destination` is the file to write, never a directory to write into.** An
/// existing directory is `IsDirectory`; write `join(dst, name)` to say
/// which file. That is the guess `cp` makes and this does not. So is a
/// directory `source`: there is no `copytree`.
///
/// An existing `destination` file is overwritten in place and keeps its own
/// permissions, as `cp` without `-p` does; a new one gets `source`'s
/// permission bits less the umask, and never the setuid, setgid or sticky
/// bits -- a copy that quietly became setuid would be a privilege
/// escalation wearing a file operation's clothes. The mode is set when the
/// file is created, before any content exists, so the data is never under
/// a wider mode than the original had. For an atomic replacement, copy to
/// a temporary name beside `destination` and `rename` it over.
///
/// It streams, 64 KiB at a time, so a file larger than memory is fine.
///
/// **A failure leaves `destination` holding however much got through**, and the
/// `Err` does not say how much -- `io.File.write`'s rule, one level up: a
/// `Result` carries a count or a cause. So an `Err` from here means `destination`
/// is a truncated copy to be deleted or written over, never a copy to
/// resume. The atomic recipe above is the answer when that matters: copy to
/// a temporary name and `rename` only after this returns `Ok`.
pub Result<int, io.Error> copy(str source, str destination) {
    if (is_directory(destination)) {
        return Result<int, io.Error>.Err(io.Error.IsDirectory);
    }
    Stat source_status = stat_of(source, true)?;
    if (source_status.is_directory()) {
        return Result<int, io.Error>.Err(io.Error.IsDirectory);
    }
    io.File reader = io.open(source)?;
    // Both files would be closed by `io.File`'s destructor on any path out,
    // but that close is silent, and the writer's close is where a delayed
    // write failure shows. So the copy loop is its own function -- its `?`
    // returns to here -- and the writer is closed by hand and checked.
    match (io.open(destination, mode: io.Mode.Write, perm: source_status.perm())) {
        case Ok(io.File writer): {
            Result<int, io.Error> got = pump(reader, writer);
            Result<bool, io.Error> reader_close = reader.close();
            Result<bool, io.Error> writer_close = writer.close();
            int byte_count = got?;
            // The writer's close counts: it is where a delayed write
            // failure shows. The reader's cannot lose anything.
            bool was_closed = writer_close?;
            return Result<int, io.Error>.Ok(byte_count);
        }
        case Err(io.Error error): {
            Result<bool, io.Error> reader_close = reader.close();
            return Result<int, io.Error>.Err(error);
        }
    }
}

Result<int, io.Error> pump(io.File reader, io.File writer) {
    int total = 0;
    while (true) {
        bytes chunk = reader.read(65536)?;
        if (chunk.size() == 0) {
            return Result<int, io.Error>.Ok(total);
        }
        total = total + writer.write(chunk)?;
    }
}
