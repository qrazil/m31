// The command line, parsed. Written in this language on nothing at all -- the
// one primitive below is how a declaration mistake traps. A port of Oro's
// `args`, with Oro's grammar exactly.
//
// API
// ---
//   args.Parser p = args.Parser(prog, summary: "")
//
//   p.flag(name, short:, help:)                                 a switch
//   p.value(name, short:, help:, placeholder:, default:)        one str
//   p.values(name, short:, help:, placeholder:)                 greedy list
//   p.integer(name, short:, help:, placeholder:, default:)      one int
//   p.number(name, short:, help:, placeholder:, default:)       one float
//
//   p.positional(name, help:, placeholder:)        must be given
//   p.optional(name, default, help:, placeholder:) may be left out
//   p.tail(name, help:, placeholder:)              zero or more
//
//   p.command(word, summary, short:)   -> args.Parser, that command's own
//
//   p.usage()        -> str, the one `usage:` line
//   p.help()         -> str, the whole help text, generated
//   p.parse(argv)    -> Result<args.Parsed, args.UsageError>
//
//   r.flag(name)       -> bool
//   r.value(name)      -> Option<str>      the text, or the default, or None
//   r.values(name)     -> List<str>
//   r.integer(name)    -> Option<int>
//   r.number(name)     -> Option<float>
//   r.positional(name) -> str
//   r.optional(name)   -> str              the text, or the default
//   r.tail(name)       -> List<str>
//   r.given(name)      -> bool             was it on the command line at all?
//   r.help()           -> Option<str>      the help `--help` asked for
//   r.commands()       -> List<args.Parsed>, the commands typed, in order
//   c.word()           -> str              which command, "" at the top
//
// --- what this port adds to Oro's `args` ----------------------------------------
//
// All of it additive; none of it changes a form or a message of the grammar.
//
//   p.version = "1.2.3"       `--version` is answered like `--help`: anywhere,
//                             before validation (`r.version()`); `version` is a
//                             reserved option name, as `help` is
//   p.epilog = "..."          text printed after the options table
//   p.completions()           adds `--completions SHELL` (bash, zsh, fish),
//                             answered before validation (`r.completions()`);
//                             `p.completion(shell)` is the same, as a Result
//   p.integer(..., min:, max:) a range: `'--port' needs a whole number from 1
//                             to 65535, and got '70000'`
//   p.parse_or_exit(argv, status) parse, then do what every program does the
//                             same way: print --help/--version/--completions
//                             and exit 0, or print the usage error and exit
//                             `status`; `p.fail(message, status)` is the same
//                             for a mistake only the program can see
//   args.migrate(prog, argv, pairs)  old spellings of a released program,
//                             rewritten with a one-line warning, for one release
//
// A mistyped option or command also names the closest one by EDIT DISTANCE
// (swapped neighbours count as one) when no unique prefix matches; it is only
// ever a suggestion, never accepted.
//
// `os.arguments()` is not read here: a parser is handed the tokens, without the
// program's own name, which is what makes one testable from a corpus program
// that has no command line of its own.
//
// --- the grammar: one dash commands, two dashes options -----------------------
//
// A token's first character says what it is, and nothing else has to:
//
//   -word     a COMMAND          the verb: -addrepo, -grant, -serve
//   --word    an OPTION          named, and belongs to the command on its left
//   word      DATA               an operand of the option or command on its left
//
//     orogit -addrepo site --public -grant site alice write
//
// It exists because the conventional grammar -- a bare word for the command --
// cannot say whether the word after `grant site alice` is a fourth operand or
// a second command without forbidding data to collide with command names.
// With the dash the question never arises, and a repository may be called
// `serve`.
//
// Several commands may appear on one line and run in the order typed; the
// same one may appear twice. Options attach leftwards: before any command
// they belong to the program, after one to that command. There is no third
// level -- `p.command` returns a parser whose own `command` traps -- so the
// tree is two deep by construction.
//
// Data is anything that does not begin with a dash, with the exceptions every
// unix machine already agrees on: `-` alone is data (stdin), `-5` and `-1.5`
// are data (a sign), and `--opt=value` carries a value that itself begins
// with a dash. A value taken from the NEXT token never begins with a dash, or
// a forgotten value would silently eat the following command.
//
// A lone `--` is refused: data is data because of how it is spelled, not
// where it sits, so there is nothing for "end of options" to mark.
//
// Help is `--help` and only `--help`. `-h` would be a command called `h` under
// this grammar, and a short form would take `h` from every `--host`; `-h`,
// `-help`, `--h` and a bare `help` each get an error naming `--help`.
//
// Short options do not cluster (`--abc` is refused and rewritten as
// `--a --b --c`), and an abbreviation is never accepted -- only suggested --
// because a parser that accepts a prefix changes the meaning of existing
// command lines the day a new option is declared.
//
// `values` takes every operand up to the next dash. `--tag a --tag b` is
// refused: the dash already ends the clause, so the greedy form needs no
// second spelling.
//
// An option is always optional; a value the command cannot run without is a
// positional. `parse` validates the whole line before returning anything, so
// a typo in the third command is found before the first one has run. `--help`
// anywhere wins before any validation, and answers with the help of the
// parser it belongs to: `prog -serve --help` is `-serve`'s.
//
// This module prints nothing and never exits. A bad command line is an
// `Err(UsageError)`; a mistake in the program's own declarations (a repeated
// name, a reserved `--help`, a command inside a command) traps, because no
// command line can cause or fix it.
//
// --- where this differs from Oro, and why --------------------------------------
//
// Results are read with one typed accessor per declaration method -- the
// name you declared with is the name you ask with -- instead of Oro's single
// `r.get(name)`, because there is no dynamic typing to answer "whatever it
// was". Asking with the wrong accessor, or for a name never declared, traps.
//
// `int` and `float` are keywords here, so those two declaration methods are
// `integer` and `number` -- the same words their error messages always used
// ("needs a whole number", "needs a number").
//
// A default is written as the text a user would type: `default: "80"` on an
// `integer`, `default: "7.5"` on a `number`. There is no "int or nothing"
// parameter type, and the help table prints the default as written. An
// integer or number default that does not parse traps at declaration. The
// empty string means "no default", so a `value` whose default is "" answers
// None when absent rather than Some("").
//
// `short:`, `placeholder:` and `default:` use "" for "not given", where Oro
// uses null.
//
// `r.word()` is "" at the top level, where Oro answers null: dispatch is
// `if (c.word() == "serve")`, and "" can never be a command's word.
//
// A `Parser`'s declarations and everything in a `Parsed` are private fields,
// so the only way to change a parser is a declaring method that checks what
// it is given, and the only way to make a `Parsed` is `parse`.
import io;
import os;
import text;

/// A bad command line, and only that. Print it, print `p.usage()`, and exit
/// with whatever status your program uses for usage errors: that is the
/// caller's decision, not this module's.
pub type UsageError {
    str message;
}

pub str UsageError.to_str() {
    return message;
}

/// The parser for one program, or for one of its commands.
///
///     args.Parser p = args.Parser("mktag", summary: "write a tag file");
///     p.flag("quiet", short: "q", help: "say nothing on success");
///     p.integer("width", default: "80", help: "wrap at this column");
///     p.positional("out", help: "the file to write");
///
/// `prog` is the name the usage line starts with and is required: the name a
/// program is invoked as is rarely the name it should call itself in a
/// message.
///
/// `prog` and `summary` are the two public fields: what construction takes,
/// and what the usage line and help read, whenever they are asked. Every
/// other field is the declarations, private so that only the declaring
/// methods -- which check each one -- can add to them.
pub type Parser {
    pub str prog;
    pub str summary = "";
    /// Set it and `--version` is recognised like `--help`: anywhere on the
    /// line, before any validation, answering `prog VERSION`.
    pub str version = "";
    /// Printed after the options table: exit status, environment, examples.
    pub str epilog = "";
    bool is_command = false;
    bool has_completions = false;
    // `shorts` maps a letter to an option's long name; `cmd_shorts` maps a
    // letter to a command word.
    List<Opt> opts = [];
    Map<str, str> shorts = {};
    List<Pos> position = [];
    List<str> words = [];
    List<Parser> cmds = [];
    Map<str, str> cmd_shorts = {};
}

// --- declaring ---------------------------------------------------------------
/// A switch: absent is false, present is true.
pub void Parser.flag(str name, str short = "", str help = "") {
    declare(this, name, short, help, "", "", "flag");
}

/// One value, as a str. `default` is what `r.value` answers when it is left
/// out; without one, it answers None.
pub void Parser.value(str name, str short = "", str help = "", str placeholder = "", str default = "") {
    declare(this, name, short, help, placeholder, default, "value");
}

/// Every operand up to the next dash, in the order given. Absent is an empty
/// list; given with no operands is a usage error, because an empty list is
/// what leaving it out already means.
pub void Parser.values(str name, str short = "", str help = "", str placeholder = "") {
    declare(this, name, short, help, placeholder, "", "values");
}

/// One value, which must be a whole number. `default` is written as it would
/// be typed: `default: "80"`.
pub void Parser.integer(str name, str short = "", str help = "", str placeholder = "", str default = "", str min = "", str max = "") {
    if (default != "" && default.parse_int().is_none()) {
        trap("integer(): --" + name + " default: '" + default + "' is not a whole number");
    }
    if ((min != "" && min.parse_int().is_none()) || (max != "" && max.parse_int().is_none())) {
        trap("integer(): --" + name + " min:/max: are written as the numbers they are, e.g. min: \"1\"");
    }
    declare(this, name, short, help, placeholder, default, "integer");
    Opt added = opts[opts.size() - 1];
    added.min = min;
    added.max = max;
}

/// One value, which must be a number; a whole number is accepted and
/// widened, because a reader who types `--cfg 7` has not made a mistake.
pub void Parser.number(str name, str short = "", str help = "", str placeholder = "", str default = "") {
    if (default != "" && default.parse_float().is_none()) {
        trap("number(): --" + name + " default: '" + default + "' is not a number");
    }
    declare(this, name, short, help, placeholder, default, "number");
}

/// A positional that must be given.
pub void Parser.positional(str name, str help = "", str placeholder = "") {
    declare_position(this, name, help, placeholder, "", "positional");
}

/// A positional that may be left out. The default is positional, not
/// `default:`: for a positional the default IS the operand when it is absent,
/// and a caller who leaves it out has not said what that means.
pub void Parser.optional(str name, str fallback, str help = "", str placeholder = "") {
    declare_position(this, name, help, placeholder, fallback, "optional");
}

/// Every remaining positional. Zero of them is an empty list, not an error.
pub void Parser.tail(str name, str help = "", str placeholder = "") {
    declare_position(this, name, help, placeholder, "", "tail");
}

/// One command: the word typed after a dash, one line about it, and the
/// parser it is given -- the only declaration that returns anything, because
/// it creates rather than modifies.
///
///     args.Parser add = p.command("addrepo", "create a bare repository", short: "a");
///     add.positional("name");
pub Parser Parser.command(str word, str about, str short = "") {
    return add_command(this, word, about, short);
}

/// Adds `--completions SHELL` (bash, zsh or fish): a value option like any
/// other, answered like `--help`. The script is generated from this parser's
/// own table; read it with `r.completions()`.
pub void Parser.completions() {
    if (is_command) {
        trap("completions(): declare it on the program's parser, not on a command");
    }
    declare(this, "completions", "", "print a shell completion script (bash, zsh or fish) and exit", "SHELL", "", "value");
    has_completions = true;
}

// --- the generated text --------------------------------------------------------
/// The one `usage:` line. `[options]` stands in for the table rather than
/// spelling every option out.
pub str Parser.usage() {
    return usage_line(this);
}

/// The whole help text: the usage line, the summary, then a table of the
/// commands, the arguments and the options, in declaration order. No trailing
/// newline.
pub str Parser.help() {
    return help_text(this);
}

// --- parsing -------------------------------------------------------------------
/// Parse `argv` -- the arguments WITHOUT the program's name. The whole line is
/// validated before anything is returned.
pub Result<Parsed, UsageError> Parser.parse(List<str> argv) {
    return parse_line(this, argv);
}

// --- the convenience around parse ---------------------------------------------------
/// `parse`, plus what every program writes the same way: `--help`,
/// `--version` and `--completions` print to standard output and exit 0; a
/// usage error prints `prog: message`, the usage line and a pointer to
/// `--help` to standard error and exits `status`. This is OUTSIDE the
/// module's core contract (which prints nothing and never exits); a program
/// that wants another stream, prefix or status calls `parse`.
pub Parsed Parser.parse_or_exit(List<str> argv, int status = 2) {
    match (parse(argv)) {
        case Err(UsageError error): {
            io.eprint(prog + ": " + error.message);
            io.eprint(usage_line(this));
            io.eprint("try '" + prog + " --help' for more information");
            os.exit(status);
        }
        case Ok(Parsed parsed): {
            match (parsed.help()) {
                case Some(str help_message): {
                    print(help_message);
                    os.exit(0);
                }
                case None: {
                }
            }
            match (parsed.version()) {
                case Some(str version_line): {
                    print(version_line);
                    os.exit(0);
                }
                case None: {
                }
            }
            match (parsed.completions()) {
                case Some(str generated): {
                    print(generated);
                    os.exit(0);
                }
                case None: {
                }
            }
            return parsed;
        }
    }
    // Unreachable: the error arm exits. Here because `os.exit` does not end a
    // block the way `return` does.
    return Parsed(this, "", {}, {}, {}, [], []);
}

/// Report a mistake of the command line that only the program can see
/// (`--index needs --root`) the way the parser reports its own, and exit.
pub void Parser.fail(str message, int status = 2) {
    io.eprint(prog + ": " + message);
    io.eprint(usage_line(this));
    io.eprint("try '" + prog + " --help' for more information");
    os.exit(status);
}

/// A shell completion script, `bash`, `zsh` or `fish`, from this parser's table.
pub Result<str, str> Parser.completion(str shell) {
    return completion_text(this, shell);
}

/// What `parse` answers, and what each command on the line answers. Built
/// only by `parse`.
pub type Parsed {
    Parser parser;
    str cmd_word;
    Map<str, str> texts;
    Map<str, List<str>> lists;
    Map<str, bool> marks;
    List<str> asked;
    List<Parsed> cmds;
    str version_line = "";
    str script = "";
}

// --- reading a result --------------------------------------------------------
/// Was the flag given?
pub bool Parsed.is_flag_set(str name) {
    want_opt(parser, name, "flag");
    return marks.contains(name);
}

/// The value given, or the declared default, or None.
pub Option<str> Parsed.value(str name) {
    Opt option = want_opt(parser, name, "value");
    return text_or_default(texts, name, option.default);
}

/// The operands given to a `values` option, empty if it was left out.
pub List<str> Parsed.values(str name) {
    want_opt(parser, name, "values");
    return list_or_empty(lists, name);
}

/// The whole number given, or the declared default, or None.
pub Option<int> Parsed.integer(str name) {
    Opt option = want_opt(parser, name, "integer");
    match (text_or_default(texts, name, option.default)) {
        case Some(str value_text): {
            return value_text.parse_int();
        }
        case None: {
            return Option<int>.None;
        }
    }
}

/// The number given, or the declared default, or None.
pub Option<float> Parsed.number(str name) {
    Opt option = want_opt(parser, name, "number");
    match (text_or_default(texts, name, option.default)) {
        case Some(str value_text): {
            return value_text.parse_float();
        }
        case None: {
            return Option<float>.None;
        }
    }
}

/// A positional that had to be given. (After `--help` nothing had to be, and
/// it is "".)
pub str Parsed.positional(str name) {
    Pos operand = want_position(parser, name, "positional");
    return texts.get(name).or(operand.default);
}

/// An optional positional: what was given, or its default.
pub str Parsed.optional(str name) {
    Pos operand = want_position(parser, name, "optional");
    return texts.get(name).or(operand.default);
}

/// Every remaining positional.
pub List<str> Parsed.tail(str name) {
    want_position(parser, name, "tail");
    return list_or_empty(lists, name);
}

/// Was `name` on the command line at all? The only way to tell an absent
/// option from one given its own default value.
pub bool Parsed.is_given(str name) {
    if (find_opt(parser, name).is_none() && find_position(parser, name).is_none()) {
        trap("given(): '" + name + "' is not a declared argument of " + parser.prog);
    }
    return marks.contains(name);
}

/// The help text `--help` asked for, or None. It is the help of whichever
/// parser the `--help` belonged to.
pub Option<str> Parsed.help() {
    if (asked.size() == 0) {
        return Option<str>.None;
    }
    return Option<str>.Some(asked[0]);
}

/// `prog 1.2.3` when `--version` was asked (the parser's `version:` field is
/// set), or None. Like the help it wins before validation.
pub Option<str> Parsed.version() {
    if (version_line == "") {
        return Option<str>.None;
    }
    return Option<str>.Some(version_line);
}

/// The completion script `--completions SHELL` asked for, or None.
pub Option<str> Parsed.completions() {
    if (script == "") {
        return Option<str>.None;
    }
    return Option<str>.Some(script);
}

/// The commands on the line, in the order typed, each its own result. A
/// parser that declares no commands traps rather than answering an empty
/// list that could be mistaken for "none given".
pub List<Parsed> Parsed.commands() {
    if (parser.words.size() == 0) {
        trap("commands(): " + parser.prog + " has no commands -- declare them with p.command(word, summary)");
    }
    return cmds;
}

/// Which command this result is, as the word without its dash; "" for the
/// top-level result.
pub str Parsed.word() {
    return cmd_word;
}

// One declared option. `kind` is the declaration method's name: "flag",
// "value", "values", "integer" or "number". `placeholder` is resolved.
type Opt {
    str name;
    str short;
    str help;
    str placeholder;
    str default;
    str kind;
    str min = "";
    str max = "";
}

// One declared positional. `kind` is "positional", "optional" or "tail".
type Pos {
    str name;
    str help;
    str placeholder;
    str default;
    str kind;
}

// One stretch of the command line: the program's own tokens, or one
// command's, with the parser that declared them. `word` is "" for the first.
type Clause {
    Parser parser;
    str word;
    List<str> tokens;
}

// --- the private half ----------------------------------------------------------
// Record one option, checking everything that can only be wrong in the
// program. These trap: nothing a user types can reach them.
void declare(Parser parser, str name, str short, str help, str placeholder, str default, str kind) {
    if (name == "" || name.starts_with("-") || name.contains(" ") || name.contains("=")) {
        trap(kind + "(): '" + name + "' is not a usable option name -- write it as you would type it after the dashes, e.g. 'skip-missing' for --skip-missing");
    }
    if (name == "help") {
        trap(kind + "(): --help is always there and cannot be declared");
    }
    if (name == "version") {
        trap(kind + "(): --version is reserved: set `version:` on the parser and it is there, like --help");
    }
    if (name.chars().size() == 1) {
        trap(kind + "(): '" + name + "' is a short spelling -- declare the long name and pass short: \"" + name + "\"");
    }
    if (find_opt(parser, name).is_some()) {
        trap(kind + "(): --" + name + " is already an option of " + parser.prog);
    }
    if (short != "") {
        if (short.chars().size() != 1 || short == "-") {
            trap(kind + "(): short: must be one character, not '" + short + "'");
        }
        match (parser.shorts.get(short)) {
            case Some(str taken): {
                trap(kind + "(): --" + short + " is already --" + taken + " of " + parser.prog);
            }
            case None: {
            }
        }
    }
    str shown = placeholder;
    if (shown == "") {
        shown = text.replace(name.to_upper(), "-", "_");
    }
    parser.opts.push(Opt(name, short, help, shown, default, kind));
    if (short != "") {
        parser.shorts.set(short, name);
    }
}

// Record one positional. The order they are declared in is the order they
// are read in, and two of the three orders a reader could write are
// unparseable, so each is refused where it is written.
void declare_position(Parser parser, str name, str help, str placeholder, str default, str kind) {
    if (name == "") {
        trap(kind + "(): a positional needs a name");
    }
    if (parser.words.size() > 0) {
        trap(kind + "(): " + parser.prog + " dispatches to commands -- '" + name + "' belongs to one of them");
    }
    for (Pos operand in parser.position) {
        if (operand.name == name) {
            trap(kind + "(): '" + name + "' is already an argument of " + parser.prog);
        }
        if (operand.kind == "tail") {
            trap(kind + "(): '" + operand.name + "' already takes every remaining argument, so '" + name + "' could never be given one");
        }
        if (operand.kind == "optional" && kind == "positional") {
            trap(kind + "(): '" + name + "' must be given but follows the optional '" + operand.name + "' -- a command line cannot leave out the middle one");
        }
    }
    str shown = placeholder;
    if (shown == "") {
        shown = name;
    }
    parser.position.push(Pos(name, help, shown, default, kind));
}

Parser add_command(Parser parser, str word, str about, str short) {
    if (parser.is_command) {
        trap("command(): '" + parser.prog + "' is itself a command -- the grammar is two deep, so its arguments are options (--" + word + "), not commands");
    }
    if (word == "" || word.starts_with("-") || word.contains(" ") || word.contains("=")) {
        trap("command(): '" + word + "' is not a usable command name -- write it as you would type it after the dash, e.g. 'addrepo' for -addrepo");
    }
    if (parser.words.contains(word)) {
        trap("command(): -" + word + " is already a command of " + parser.prog);
    }
    if (parser.position.size() > 0) {
        trap("command(): " + parser.prog + " already has positional arguments -- a dispatching program's operands belong to its commands");
    }
    if (short != "") {
        if (short.chars().size() != 1 || short == "-") {
            trap("command(): short: must be one character, not '" + short + "'");
        }
        match (parser.cmd_shorts.get(short)) {
            case Some(str taken): {
                trap("command(): -" + short + " is already -" + taken + " of " + parser.prog);
            }
            case None: {
            }
        }
    }
    Parser sub = Parser(parser.prog + " -" + word, summary: about);
    sub.is_command = true;
    parser.words.push(word);
    parser.cmds.push(sub);
    if (short != "") {
        parser.cmd_shorts.set(short, word);
    }
    return sub;
}

// `from 1 to 65535`, `of at least 1`, `of at most 9`.
str range_words(Opt opt) {
    if (opt.min != "" && opt.max != "") {
        return "from " + opt.min + " to " + opt.max;
    }
    if (opt.min != "") {
        return "of at least " + opt.min;
    }
    return "of at most " + opt.max;
}

// --- the text ------------------------------------------------------------------
str usage_line(Parser parser) {
    List<str> parts = ["usage: " + parser.prog];
    if (parser.opts.size() > 0) {
        parts.push("[options]");
    }
    for (Pos operand in parser.position) {
        parts.push(position_column(operand));
    }
    if (parser.words.size() > 0) {
        parts.push("-<command>");
        parts.push("[...]");
    }
    return parts.join(" ");
}

// One column width for every row in the document, so the three sections
// line up with each other and not just with themselves.
str help_text(Parser parser) {
    int width = columns(help_column());
    if (parser.version != "") {
        width = wider(width, "     --version");
    }
    for (str word in parser.words) {
        width = wider(width, cmd_column(word, parser.cmd_shorts));
    }
    for (Pos operand in parser.position) {
        width = wider(width, position_column(operand));
    }
    for (Opt option in parser.opts) {
        width = wider(width, opt_column(option));
    }
    List<str> lines = [usage_line(parser)];
    if (parser.summary != "") {
        lines.push("");
        lines.push(parser.summary);
    }
    if (parser.words.size() > 0) {
        lines.push("");
        lines.push("commands:");
        for (int i in 0 .. parser.words.size()) {
            lines.push(row(cmd_column(parser.words[i], parser.cmd_shorts), width, parser.cmds[i].summary));
        }
    }
    if (parser.position.size() > 0) {
        lines.push("");
        lines.push("arguments:");
        for (Pos operand in parser.position) {
            lines.push(row(position_column(operand), width, described(operand.help, operand.default)));
        }
    }
    lines.push("");
    lines.push("options:");
    lines.push(row(help_column(), width, "show this help"));
    if (parser.version != "") {
        lines.push(row("     --version", width, "print the version and exit"));
    }
    for (Opt option in parser.opts) {
        // A flag has no default and a greedy option's absence is an empty
        // list by definition, so neither prints one.
        str shown_default = option.default;
        if (option.kind == "flag" || option.kind == "values") {
            shown_default = "";
        }
        lines.push(row(opt_column(option), width, described(option.help, shown_default)));
    }
    if (parser.epilog != "") {
        lines.push("");
        lines.push(parser.epilog);
    }
    return lines.join("\n");
}

int wider(int width, str column) {
    if (columns(column) > width) {
        return columns(column);
    }
    return width;
}

// How wide `content` is in the help table: its code points, not its bytes. By
// bytes, `--größe` counted two columns more than it takes and every row
// beside it was padded short. One code point is still not always one column
// on a terminal -- a CJK character or most emoji take two, a combining
// accent none -- and getting that right needs the Unicode width tables,
// which this module does not carry. Such a name misaligns its rows by that
// difference; everything else lines up.
//
// `text.pad_right`, which fills the column, measures the same way, so the
// width computed here and the padding that reaches it cannot disagree.
int columns(str content) {
    return content.chars().size();
}

// The left column of the always-there help row, so nothing may disagree
// about what it says.
str help_column() {
    return "     --help";
}

// `--n, --count N`, or `     --host HOST` for one with no short spelling, so
// the long names stay in one column.
str opt_column(Opt option) {
    str left = "     ";
    if (option.short != "") {
        left = "--" + option.short + ", ";
    }
    left = left + "--" + option.name;
    if (option.kind == "flag") {
        return left;
    }
    if (option.kind == "values") {
        return left + " " + option.placeholder + "...";
    }
    return left + " " + option.placeholder;
}

// `<url>`, `[<dir>]`, `[<files>...]`.
str position_column(Pos operand) {
    if (operand.kind == "positional") {
        return "<" + operand.placeholder + ">";
    }
    if (operand.kind == "tail") {
        return "[<" + operand.placeholder + ">...]";
    }
    return "[<" + operand.placeholder + ">]";
}

// `-a, -addrepo`, or `    -list` for one with no short spelling.
str cmd_column(str word, Map<str, str> shorts) {
    for (str letter in shorts.keys()) {
        if (shorts.get(letter).or("") == word) {
            return "-" + letter + ", -" + word;
        }
    }
    return "    -" + word;
}

// `  <left>   <description>`, one row of the help table.
str row(str left, int width, str description) {
    if (description == "") {
        return "  " + left;
    }
    return "  " + text.pad_right(left, width) + "  " + description;
}

// A description with its generated tail, `(default 80)`. The default is
// printed by the module rather than written into the help text, because a
// hand-written copy of the number is the one that goes stale. An empty
// default has nothing to print.
str described(str help, str default) {
    if (default == "") {
        return help;
    }
    if (help == "") {
        return "(default " + default + ")";
    }
    return help + " (default " + default + ")";
}

// --- the parse -----------------------------------------------------------------
Result<Parsed, UsageError> parse_line(Parser parser, List<str> argv) {
    // Split the line at the commands first, so every clause is parsed by the
    // parser that declared it and nothing has to guess.
    List<Clause> clauses = split_line(parser, argv)?;
    // `--help` anywhere wins, before any validation: a command line asking
    // what the arguments are cannot also be required to get them right. The
    // first one on the line is the one answered.
    for (Clause clause in clauses) {
        if (clause.tokens.contains("--help")) {
            return Result<Parsed, UsageError>.Ok(Parsed(parser, "", {}, {}, {}, [help_text(clause.parser)], []));
        }
    }
    // `--version` and `--completions SHELL` are answers like `--help`: they
    // win before any validation, so they work on a line that is otherwise
    // missing its operands.
    for (Clause clause in clauses) {
        if (parser.version != "" && clause.tokens.contains("--version")) {
            Parsed answered = Parsed(parser, "", {}, {}, {}, [], []);
            answered.version_line = parser.prog + " " + parser.version;
            return Result<Parsed, UsageError>.Ok(answered);
        }
    }
    if (parser.has_completions) {
        for (int at_token in 0 .. clauses[0].tokens.size()) {
            str token = clauses[0].tokens[at_token];
            str shell = "";
            if (token == "--completions" && at_token + 1 < clauses[0].tokens.size()) {
                shell = clauses[0].tokens[at_token + 1];
            } else if (token.starts_with("--completions=")) {
                shell = token.substr(14, token.size());
            } else if (token == "--completions") {
                return refuse("'--completions' needs a value and is the last argument");
            }
            if (shell != "") {
                match (completion_text(parser, shell)) {
                    case Ok(str generated): {
                        Parsed answered = Parsed(parser, "", {}, {}, {}, [], []);
                        answered.script = generated;
                        return Result<Parsed, UsageError>.Ok(answered);
                    }
                    case Err(str reason): {
                        return refuse("'--completions' needs bash, zsh or fish, and got '" + shell + "'");
                    }
                }
            }
        }
    }
    List<Parsed> commands = [];
    Parsed top = parse_clause(clauses[0].parser, clauses[0].tokens, "")?;
    for (int i in 1 .. clauses.size()) {
        commands.push(parse_clause(clauses[i].parser, clauses[i].tokens, clauses[i].word)?);
    }
    if (parser.words.size() > 0 && commands.size() == 0) {
        return refuse(parser.prog + " needs a command -- one of " + command_list(parser));
    }
    return Result<Parsed, UsageError>.Ok(Parsed(parser, "", top.texts, top.lists, top.marks, [], commands));
}

// Cut `argv` into clauses at the `-command` tokens. The command words are
// resolved here, so an unknown one is refused before any of its operands
// are looked at.
Result<List<Clause>, UsageError> split_line(Parser parser, List<str> argv) {
    List<Clause> clauses = [Clause(parser, "", [])];
    for (str token in argv) {
        str kind = token_kind(token);
        if (kind == "bare-dashes") {
            return refuse_split("'--' has no meaning here -- data is data because it does not start with a dash, so nothing has to be marked off");
        }
        if (kind != "command") {
            // A command typed without its dash reaches the program as data,
            // where a program with commands can never want it. Say which
            // spelling was meant, before an option of that command is read
            // as one of ours.
            if (parser.words.size() > 0 && clauses.size() == 1 && parser.words.contains(token)) {
                return refuse_split("'" + token + "' is a command, so it is written with a dash: '-" + token + "'");
            }
            clauses[clauses.size() - 1].tokens.push(token);
            continue;
        }
        str word = command_for(parser, token)?;
        int command_index = parser.words.index_of(word).or(0);
        clauses.push(Clause(parser.cmds[command_index], word, []));
    }
    return Result<List<Clause>, UsageError>.Ok(clauses);
}

// The command word a `-token` names, refusing an unknown one.
Result<str, UsageError> command_for(Parser parser, str token) {
    str body = token.substr(1, token.size());
    // `-h` and `-help` are the one wrong guess everyone makes once: under
    // this grammar they are commands, and help is an option.
    if ((body == "h" || body == "help") && !parser.words.contains(body)) {
        return refuse_word("'" + token + "' would be a command here, and there is none called '" + body + "' -- help is an option, so write '--help'");
    }
    if (parser.words.size() == 0) {
        return refuse_word(parser.prog + " takes no commands, and got '" + token + "'");
    }
    if (body.size() == 1) {
        match (parser.cmd_shorts.get(body)) {
            case Some(str word): {
                return Result<str, UsageError>.Ok(word);
            }
            case None: {
                return refuse_word("unknown command '" + token + "' -- one of " + command_list(parser));
            }
        }
    }
    if (parser.words.contains(body)) {
        return Result<str, UsageError>.Ok(body);
    }
    match (nearest(body, parser.words)) {
        case Some(str near): {
            return refuse_word("unknown command '" + token + "' -- did you mean '-" + near + "'?");
        }
        case None: {
            return refuse_word("unknown command '" + token + "' -- one of " + command_list(parser));
        }
    }
}

str command_list(Parser parser) {
    List<str> spelled = [];
    for (str word in parser.words) {
        spelled.push("-" + word);
    }
    return spelled.join(", ");
}

// Parse one clause's tokens -- the options and operands of a single command,
// or of the program itself. The `-command` tokens are already gone.
Result<Parsed, UsageError> parse_clause(Parser parser, List<str> tokens, str word) {
    Parsed parsed = Parsed(parser, word, {}, {}, {}, [], []);
    List<str> positionals = [];
    int index = 0;
    int token_count = tokens.size();
    while (index < token_count) {
        str token = tokens[index];
        index = index + 1;
        if (token_kind(token) != "option") {
            positionals.push(token);
            continue;
        }
        // An option. `spelled` is what the user typed, minus any `=value`,
        // so every message below quotes their spelling and not the other one.
        str name = token.substr(2, token.size());
        bool has_inline = false;
        str inline = "";
        match (name.index_of("=")) {
            case Some(int equals_index): {
                has_inline = true;
                inline = name.substr(equals_index + 1, name.size());
                name = name.substr(0, equals_index);
            }
            case None: {
            }
        }
        str spelled = "--" + name;
        if (name == "") {
            return refuse("'" + token + "' is not an option -- a long option needs a name after the dashes");
        }
        if (name.size() == 1) {
            match (parser.shorts.get(name)) {
                case Some(str long): {
                    name = long;
                }
                case None: {
                    // `h` is an ordinary letter here and a program may
                    // declare it for `--host`; it is only worth a word of its
                    // own when nobody has.
                    if (name == "h") {
                        return refuse("'" + token + "' is not an option -- help has one spelling, and it is '--help'");
                    }
                    return refuse("unknown option '" + token + "'");
                }
            }
        } else if (find_opt(parser, name).is_none()) {
            // A cluster is the one wrong guess worth naming: `--abc` when
            // `--a`, `--b` and `--c` are all declared is plainly three.
            if (is_cluster(name, parser.shorts)) {
                return refuse(cluster_refusal(token, name));
            }
            return refuse(unknown_option(spelled, parser));
        }
        Opt opt = want_opt(parser, name, "");
        if (opt.kind == "flag") {
            if (has_inline) {
                return refuse("'" + spelled + "' is a flag and takes no value -- you wrote '" + token + "'");
            }
            if (parsed.marks.contains(name)) {
                return refuse("'" + spelled + "' was given more than once");
            }
            parsed.marks.set(name, true);
            continue;
        }
        if (opt.kind == "values") {
            if (parsed.marks.contains(name)) {
                return refuse("'" + spelled + "' was given more than once -- it already takes every value up to the next dash, so write them together: '" + spelled + " a b c'");
            }
            List<str> collected = [];
            if (has_inline) {
                collected.push(inline);
            }
            while (index < token_count && token_kind(tokens[index]) == "data") {
                collected.push(tokens[index]);
                index = index + 1;
            }
            if (collected.size() == 0) {
                return refuse("'" + spelled + "' needs at least one value -- leaving it out is how an empty list is spelled");
            }
            parsed.lists.set(name, collected);
            parsed.marks.set(name, true);
            continue;
        }
        str raw = inline;
        if (!has_inline) {
            if (index >= token_count) {
                return refuse("'" + spelled + "' needs a value and is the last argument");
            }
            if (token_kind(tokens[index]) != "data") {
                return refuse("'" + spelled + "' needs a value, and '" + tokens[index] + "' starts with a dash -- write '" + spelled + "=" + tokens[index] + "' if that is the value you meant");
            }
            raw = tokens[index];
            index = index + 1;
        }
        if (parsed.marks.contains(name)) {
            return refuse("'" + spelled + "' was given more than once and takes a single value");
        }
        // The conversion is checked here, the only place that still knows
        // which option the text came from.
        if (opt.kind == "integer" && raw.parse_int().is_none()) {
            return refuse("'" + spelled + "' needs a whole number, and got '" + raw + "'");
        }
        if (opt.kind == "integer" && (opt.min != "" || opt.max != "")) {
            int whole = raw.parse_int().or(0);
            bool is_low = opt.min != "" && whole < opt.min.parse_int().or(0);
            bool is_high = opt.max != "" && whole > opt.max.parse_int().or(0);
            if (is_low || is_high) {
                return refuse("'" + spelled + "' needs a whole number " + range_words(opt) + ", and got '" + raw + "'");
            }
        }
        if (opt.kind == "number" && raw.parse_float().is_none()) {
            return refuse("'" + spelled + "' needs a number, and got '" + raw + "'");
        }
        parsed.texts.set(name, raw);
        parsed.marks.set(name, true);
    }
    bind(parser, positionals, parsed)?;
    return Result<Parsed, UsageError>.Ok(parsed);
}

// Hand the collected positionals to the declared ones, in order.
Result<bool, UsageError> bind(Parser parser, List<str> positionals, Parsed parsed) {
    int next_index = 0;
    for (Pos operand in parser.position) {
        if (operand.kind == "tail") {
            List<str> rest = [];
            while (next_index < positionals.size()) {
                rest.push(positionals[next_index]);
                next_index = next_index + 1;
            }
            if (rest.size() > 0) {
                parsed.marks.set(operand.name, true);
            }
            parsed.lists.set(operand.name, rest);
            continue;
        }
        if (next_index < positionals.size()) {
            parsed.texts.set(operand.name, positionals[next_index]);
            parsed.marks.set(operand.name, true);
            next_index = next_index + 1;
            continue;
        }
        if (operand.kind == "positional") {
            return refuse_bind("missing <" + operand.placeholder + "> -- " + usage_line(parser));
        }
    }
    if (next_index < positionals.size()) {
        str extra = positionals[next_index];
        // The other half of the muscle-memory error: a command typed without
        // its dash arrives here as data.
        if (parser.words.contains(extra)) {
            return refuse_bind("'" + extra + "' is a command, so it is written with a dash: '-" + extra + "'");
        }
        if (parser.position.size() == 0) {
            // `prog help` is the third spelling someone reaches for, after
            // `-h` and `-help`. Only where no operand could be meant: a
            // program that takes filenames may be handed one called `help`.
            if (extra == "help") {
                return refuse_bind("'help' is an option here, not a command -- write '--help' (or '" + parser.prog + " -<command> --help' for one command's)");
            }
            return refuse_bind(parser.prog + " takes no arguments of its own, and got '" + extra + "'");
        }
        return refuse_bind("unexpected argument '" + extra + "' -- " + usage_line(parser));
    }
    return Result<bool, UsageError>.Ok(true);
}

// What a token is, by its first characters and nothing else: `-` and a
// negative number are data, and a lone `--` is neither.
str token_kind(str token) {
    if (!token.starts_with("-") || token == "-") {
        return "data";
    }
    if (token == "--") {
        return "bare-dashes";
    }
    if (token.starts_with("--")) {
        return "option";
    }
    // A sign, not a command: `-5`, `-1.5`, `-.5`. Byte 1 is compared as a
    // byte because the token is whatever was typed: in `-é` it is the first
    // half of a character, where substr(1, 2) would trap.
    int second_byte = token.byte_at(1);
    if (second_byte >= '0' && second_byte <= '9' || second_byte == '.') {
        return "data";
    }
    return "command";
}

// Is `name` plainly a run-together cluster of declared short options? Only if
// every letter is one, which is what makes the rewrite safe to suggest.
// A letter is a character, not a byte, so `--éa` is read as two letters:
// cutting it byte by byte would trap inside the é.
bool is_cluster(str name, Map<str, str> shorts) {
    List<int> letters = name.chars();
    if (letters.size() < 2) {
        return false;
    }
    for (int letter in letters) {
        if (!shorts.contains(str.from_chars([letter]))) {
            return false;
        }
    }
    return true;
}

str cluster_refusal(str token, str name) {
    List<str> spread = [];
    for (int letter in name.chars()) {
        spread.push("--" + str.from_chars([letter]));
    }
    return "'" + token + "': short options do not cluster -- write '" + spread.join(" ") + "'";
}

// The unknown-option message, with one guess when there is exactly one.
// `help` is in the pool because it is an option like any other here.
str unknown_option(str spelled, Parser parser) {
    List<str> names = ["help"];
    if (parser.version != "") {
        names.push("version");
    }
    for (Opt option in parser.opts) {
        names.push(option.name);
    }
    match (nearest(spelled.substr(2, spelled.size()), names)) {
        case Some(str near): {
            return "unknown option '" + spelled + "' -- did you mean '--" + near + "'?";
        }
        case None: {
            return "unknown option '" + spelled + "'";
        }
    }
}

// The one candidate `given` was plainly meant to be, or None.
//
// Two cheap rules, and no edit distance: separators are ignored, so
// `--lastoutput` finds `--last-output`; and one word that starts with the
// other is a match, which catches an abbreviation and one character too
// many. A guess is offered only when exactly one candidate matches, because
// a message that guesses wrong costs more than one that does not guess.
Option<str> nearest(str given, List<str> names) {
    List<str> hits = [];
    str flat = flatten(given);
    for (str name in names) {
        str other = flatten(name);
        if (other == flat || other.starts_with(flat) || flat.starts_with(other)) {
            hits.push(name);
        }
    }
    if (hits.size() == 1) {
        return Option<str>.Some(hits[0]);
    }
    if (hits.size() > 1) {
        return Option<str>.None;
    }
    // No prefix or separator match: a typo. The closest by edit distance, if
    // it is close enough to be one. Still only a suggestion, never accepted.
    int limit = 1;
    int size = given.chars().size();
    if (size > 4) {
        limit = 2;
    }
    if (size > 8) {
        limit = 3;
    }
    int best = limit + 1;
    str chosen = "";
    for (str name in names) {
        int far = distance(given, name);
        if (far < best) {
            best = far;
            chosen = name;
        }
    }
    if (best <= limit) {
        return Option<str>.Some(chosen);
    }
    return Option<str>.None;
}

// Edit distance in code points: insert, delete, replace, or swap two
// neighbours (the commonest typo: `--prot`).
int distance(str first, str second) {
    List<int> left = first.chars();
    List<int> right = second.chars();
    List<List<int>> grid = [];
    for (int i in 0 .. left.size() + 1) {
        List<int> costs = [i];
        for (int j in 1 .. right.size() + 1) {
            if (i == 0) {
                costs.push(j);
            } else {
                int cost = 1;
                if (left[i - 1] == right[j - 1]) {
                    cost = 0;
                }
                int best = smallest(smallest(grid[i - 1][j] + 1, costs[j - 1] + 1), grid[i - 1][j - 1] + cost);
                if (i > 1 && j > 1 && left[i - 1] == right[j - 2] && left[i - 2] == right[j - 1]) {
                    best = smallest(best, grid[i - 2][j - 2] + 1);
                }
                costs.push(best);
            }
        }
        grid.push(costs);
    }
    return grid[left.size()][right.size()];
}

int smallest(int first, int second) {
    if (first < second) {
        return first;
    }
    return second;
}

// A name with its separators taken out, for comparison only.
str flatten(str name) {
    return name.split("-").join("").split("_").join("");
}

// --- lookups -------------------------------------------------------------------
Option<Opt> find_opt(Parser parser, str name) {
    for (Opt option in parser.opts) {
        if (option.name == name) {
            return Option<Opt>.Some(option);
        }
    }
    return Option<Opt>.None;
}

Option<Pos> find_position(Parser parser, str name) {
    for (Pos operand in parser.position) {
        if (operand.name == name) {
            return Option<Pos>.Some(operand);
        }
    }
    return Option<Pos>.None;
}

// The option `name`, declared with `kind` ("" for any). Asking for a name
// that was never declared, or with the wrong accessor, is a bug in the
// program -- the command line cannot invent a name -- so it traps.
Opt want_opt(Parser parser, str name, str kind) {
    match (find_opt(parser, name)) {
        case Some(Opt option): {
            if (kind != "" && option.kind != kind) {
                trap(kind + "(): --" + name + " was declared with " + option.kind + "(), so read it with r." + option.kind + "(\"" + name + "\")");
            }
            return option;
        }
        case None: {
            trap(kind + "(): '" + name + "' is not a declared option of " + parser.prog);
        }
    }
}

Pos want_position(Parser parser, str name, str kind) {
    match (find_position(parser, name)) {
        case Some(Pos operand): {
            if (operand.kind != kind) {
                trap(kind + "(): '" + name + "' was declared with " + operand.kind + "(), so read it with r." + operand.kind + "(\"" + name + "\")");
            }
            return operand;
        }
        case None: {
            trap(kind + "(): '" + name + "' is not a declared argument of " + parser.prog);
        }
    }
}

Option<str> text_or_default(Map<str, str> texts, str name, str default) {
    match (texts.get(name)) {
        case Some(str stored_text): {
            return Option<str>.Some(stored_text);
        }
        case None: {
            if (default == "") {
                return Option<str>.None;
            }
            return Option<str>.Some(default);
        }
    }
}

List<str> list_or_empty(Map<str, List<str>> lists, str name) {
    match (lists.get(name)) {
        case Some(List<str> items): {
            return items;
        }
        case None: {
            return [];
        }
    }
}

// --- refusals, one per return type -----------------------------------------------
Result<Parsed, UsageError> refuse(str message) {
    return Result<Parsed, UsageError>.Err(UsageError(message));
}

Result<List<Clause>, UsageError> refuse_split(str message) {
    return Result<List<Clause>, UsageError>.Err(UsageError(message));
}

Result<str, UsageError> refuse_word(str message) {
    return Result<str, UsageError>.Err(UsageError(message));
}

Result<bool, UsageError> refuse_bind(str message) {
    return Result<bool, UsageError>.Err(UsageError(message));
}

/// Old spellings of a released program, accepted for one release: every token
/// of `argv` that is `old` (or `old=value`) is replaced by `new`, with one line
/// on standard error. `pairs` is `[old, new, old, new, ...]`. An old spelling
/// ending in `+` also matches with its value attached (`-p+` matches `-p22`,
/// which becomes `--port 22`). A rewrite is the only thing this does: the
/// grammar itself never accepts a second spelling.
pub List<str> migrate(str prog, List<str> argv, List<str> pairs) {
    List<str> out = [];
    for (str token in argv) {
        bool is_done = false;
        int index = 0;
        while (index + 1 < pairs.size() && !is_done) {
            str old = pairs[index];
            str replacement = pairs[index + 1];
            index = index + 2;
            bool is_attached = old.ends_with("+");
            if (is_attached) {
                old = old.substr(0, old.size() - 1);
            }
            if (token == old) {
                io.eprint(prog + ": warning: '" + old + "' is deprecated, use '" + replacement + "'");
                out.push(replacement);
                is_done = true;
            } else if (token.starts_with(old + "=") && old.starts_with("--")) {
                io.eprint(prog + ": warning: '" + old + "' is deprecated, use '" + replacement + "'");
                out.push(replacement);
                out.push(token.substr(old.size() + 1, token.size()));
                is_done = true;
            } else if (is_attached && token.starts_with(old) && token.size() > old.size() && !token.starts_with(old + "-")) {
                io.eprint(prog + ": warning: '" + old + "' is deprecated, use '" + replacement + "'");
                out.push(replacement);
                out.push(token.substr(old.size(), token.size()));
                is_done = true;
            }
        }
        if (!is_done) {
            out.push(token);
        }
    }
    return out;
}

/// Is this line in the OpenSSH/POSIX style an old program used to read: any
/// single-dash word that is not a number (`-p`, `-tt`) or a bare `--`? Under
/// this grammar a single dash is a command, so a program with no commands can
/// tell, and read such a line with its old parser for one release.
pub bool is_old_style(List<str> argv) {
    for (str word in argv) {
        if (word == "--") {
            return true;
        }
        if (word.starts_with("-") && !word.starts_with("--") && word.size() > 1) {
            int second = word.byte_at(1);
            if (second < 48 || second > 57) {
                return true;
            }
        }
    }
    return false;
}

// --- shell completion ------------------------------------------------------------------
Result<str, str> completion_text(Parser parser, str shell) {
    if (shell == "bash") {
        return Result<str, str>.Ok(completion_bash(parser));
    }
    if (shell == "zsh") {
        return Result<str, str>.Ok(completion_zsh(parser));
    }
    if (shell == "fish") {
        return Result<str, str>.Ok(completion_fish(parser));
    }
    return Result<str, str>.Err("unknown shell");
}

// What a shell completes for one parser: every option (`--out`, `--o`, `--help`)
// and, for a parser with commands, every command (`-serve`, `-s`).
List<str> completion_words(Parser parser, bool is_root) {
    List<str> shown = [];
    for (int i in 0 .. parser.words.size()) {
        shown.push("-" + parser.words[i]);
        for (str letter in parser.cmd_shorts.keys()) {
            if (parser.cmd_shorts.get(letter).or("") == parser.words[i]) {
                shown.push("-" + letter);
            }
        }
    }
    for (Opt option in parser.opts) {
        shown.push("--" + option.name);
        if (option.short != "") {
            shown.push("--" + option.short);
        }
    }
    shown.push("--help");
    if (is_root && parser.version != "") {
        shown.push("--version");
    }
    return shown;
}

str completion_ident(str prog) {
    return text.replace(prog, "-", "_");
}

bool is_path_option(Opt option) {
    str shown = option.placeholder;
    if (shown == "") {
        shown = option.name.to_upper();
    }
    return shown.ends_with("FILE") || shown.ends_with("PATH") || shown.ends_with("DIR");
}

str completion_bash(Parser parser) {
    str function_name = "_" + completion_ident(parser.prog) + "_complete";
    List<str> lines = ["# bash completion for " + parser.prog + " (generated by `" + parser.prog + " --completions bash`)"];
    lines.push(function_name + "() {");
    lines.push("    local cur prev word command");
    lines.push("    cur=\"${COMP_WORDS[COMP_CWORD]}\"");
    lines.push("    prev=\"${COMP_WORDS[COMP_CWORD-1]}\"");
    lines.push("    command=\"\"");
    if (parser.words.size() > 0) {
        lines.push("    for word in \"${COMP_WORDS[@]:1:COMP_CWORD-1}\"; do");
        lines.push("        case \"$word\" in");
        for (int i in 0 .. parser.words.size()) {
            str alternatives = "-" + parser.words[i];
            for (str letter in parser.cmd_shorts.keys()) {
                if (parser.cmd_shorts.get(letter).or("") == parser.words[i]) {
                    alternatives = alternatives + "|-" + letter;
                }
            }
            lines.push("            " + alternatives + ") command=" + parser.words[i] + " ;;");
        }
        lines.push("        esac");
        lines.push("    done");
    }
    lines.push("    case \"$command:$prev\" in");
    for (Opt option in parser.opts) {
        if (option.kind != "flag" && is_path_option(option)) {
            lines.push("        :--" + option.name + ") COMPREPLY=($(compgen -f -- \"$cur\")); return ;;");
        } else if (option.kind != "flag") {
            lines.push("        :--" + option.name + ") return ;;");
        }
    }
    for (int i in 0 .. parser.words.size()) {
        for (Opt option in parser.cmds[i].opts) {
            if (option.kind != "flag" && is_path_option(option)) {
                lines.push("        " + parser.words[i] + ":--" + option.name + ") COMPREPLY=($(compgen -f -- \"$cur\")); return ;;");
            } else if (option.kind != "flag") {
                lines.push("        " + parser.words[i] + ":--" + option.name + ") return ;;");
            }
        }
    }
    lines.push("    esac");
    lines.push("    if [[ \"$cur\" == -* ]]; then");
    lines.push("        case \"$command\" in");
    for (int i in 0 .. parser.words.size()) {
        List<str> offered = completion_words(parser.cmds[i], false);
        for (str word in completion_words(parser, true)) {
            if (word.starts_with("-") && !word.starts_with("--") && !offered.contains(word)) {
                offered.push(word);
            }
        }
        lines.push("            " + parser.words[i] + ") COMPREPLY=($(compgen -W \"" + offered.join(" ") + "\" -- \"$cur\")) ;;");
    }
    lines.push("            *) COMPREPLY=($(compgen -W \"" + completion_words(parser, true).join(" ") + "\" -- \"$cur\")) ;;");
    lines.push("        esac");
    lines.push("    else");
    lines.push("        COMPREPLY=($(compgen -f -- \"$cur\"))");
    lines.push("    fi");
    lines.push("}");
    lines.push("complete -o filenames -F " + function_name + " " + parser.prog);
    return lines.join("\n");
}

str zsh_text(str raw) {
    return text.replace(text.replace(raw, "'", "'\\''"), ":", "\\:");
}

// zsh: one `_describe` list per parser, offered when the word starts with a dash.
str completion_zsh(Parser parser) {
    str function_name = "_" + completion_ident(parser.prog);
    List<str> lines = ["#compdef " + parser.prog];
    lines.push("# zsh completion for " + parser.prog + " (generated by `" + parser.prog + " --completions zsh`)");
    lines.push(function_name + "() {");
    lines.push("    local -a choices");
    lines.push("    local word command=\"\"");
    for (int i in 0 .. parser.words.size()) {
        lines.push("    for word in ${words[2,CURRENT-1]}; do [[ $word == -" + parser.words[i] + " ]] && command=" + parser.words[i] + "; done");
    }
    lines.push("    if [[ $PREFIX == -* ]]; then");
    lines.push("        case $command in");
    for (int i in 0 .. parser.words.size()) {
        lines.push("            " + parser.words[i] + ") choices=(" + zsh_choices(parser.cmds[i], parser, false) + ") ;;");
    }
    lines.push("            *) choices=(" + zsh_choices(parser, parser, true) + ") ;;");
    lines.push("        esac");
    lines.push("        _describe 'option' choices");
    lines.push("    else");
    lines.push("        _files");
    lines.push("    fi");
    lines.push("}");
    lines.push("compdef " + function_name + " " + parser.prog);
    return lines.join("\n");
}

// `'-serve:run the server' '--out:where to write'` for one parser; the root's
// commands are offered everywhere, since several commands share a line.
str zsh_choices(Parser here, Parser root, bool is_root) {
    List<str> items = [];
    for (int i in 0 .. root.words.size()) {
        items.push("'-" + root.words[i] + ":" + zsh_text(root.cmds[i].summary) + "'");
    }
    for (Opt option in here.opts) {
        items.push("'--" + option.name + ":" + zsh_text(option.help) + "'");
        if (option.short != "") {
            items.push("'--" + option.short + ":" + zsh_text(option.help) + "'");
        }
    }
    items.push("'--help:show this help'");
    if (is_root && root.version != "") {
        items.push("'--version:print the version and exit'");
    }
    return items.join(" ");
}

str fish_text(str raw) {
    return text.replace(text.replace(raw, "\\", "\\\\"), "'", "\\'");
}

// fish: a single-dash word is an old-style option (`-o`), which is what a
// command is here; `-l` is a double-dash one.
str completion_fish(Parser parser) {
    List<str> lines = ["# fish completion for " + parser.prog + " (generated by `" + parser.prog + " --completions fish`)"];
    str base = "complete -c " + parser.prog;
    for (int i in 0 .. parser.words.size()) {
        lines.push(base + " -o " + parser.words[i] + " -d '" + fish_text(parser.cmds[i].summary) + "'");
        for (str letter in parser.cmd_shorts.keys()) {
            if (parser.cmd_shorts.get(letter).or("") == parser.words[i]) {
                lines.push(base + " -o " + letter + " -d '" + fish_text(parser.cmds[i].summary) + "'");
            }
        }
    }
    for (Opt option in parser.opts) {
        lines.push(fish_option(base, "", option));
    }
    lines.push(base + " -l help -d 'show this help'");
    if (parser.version != "") {
        lines.push(base + " -l version -d 'print the version and exit'");
    }
    for (int i in 0 .. parser.words.size()) {
        str condition = " -n '__fish_seen_argument -o " + parser.words[i] + "'";
        for (Opt option in parser.cmds[i].opts) {
            lines.push(fish_option(base, condition, option));
        }
    }
    return lines.join("\n");
}

str fish_option(str base, str condition, Opt option) {
    str line = base + condition + " -l " + option.name;
    if (option.kind != "flag") {
        if (is_path_option(option)) {
            line = line + " -r -F";
        } else {
            line = line + " -x";
        }
    }
    str out = line + " -d '" + fish_text(option.help) + "'";
    if (option.short != "") {
        str second = base + condition + " -l " + option.short;
        if (option.kind != "flag") {
            second = second + " -x";
        }
        out = out + "\n" + second + " -d '" + fish_text(option.help) + "'";
    }
    return out;
}
