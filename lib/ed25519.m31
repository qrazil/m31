// Ed25519 (RFC 8032): signing and verification on the twisted Edwards curve
// `edwards25519`, `-x^2 + y^2 = 1 + d*x^2*y^2` mod `2^255 - 19` -- the same
// base field `x25519.m31` uses, in its Edwards rather than Montgomery form.
//
// API
// ---
//   bytes pub = ed25519.public_key(seed);        // 32 octets, from a 32-octet seed
//   bytes sig = ed25519.sign(seed, msg);          // 64 octets
//   bool  ok  = ed25519.verify(pub, msg, sig);
//
// --- which operations need to be constant time, and which do not -----------
//
// **Signing's point multiplications are on the critical path and are
// constant time.** `sign` computes `[a]B` (the public key, from the
// secret expanded scalar `a`) and `[r]B` (the nonce point, from the
// per-message secret nonce `r`) -- both multiply the fixed base point by a
// SECRET scalar, which is exactly the shape `x25519.m31`'s Montgomery
// ladder exists for. Ed25519 is on a different curve model, so it cannot
// reuse that ladder directly, but it needs the same property from its own
// scalar multiplication: `scalar_mult` below is double-and-add-ALWAYS --
// every bit does a double, computes an add unconditionally, and SELECTS
// (via `field25519.cselect`, never a branch) whether to keep the addition
// -- over a FIXED 256 iterations regardless of the scalar's actual size.
// This works because edwards25519's extended-coordinate addition law
// (`point_add` below) is COMPLETE: unlike an affine or a Weierstrass
// addition formula, it has no exceptional input (P + P, P + O, P + (-P) all
// go through the same four field operations as any other pair), so
// "compute the add every time and decide afterwards whether to use it" is
// always well-defined, never a division by zero in disguise.
//
// **Verification's point multiplications are on public data and are NOT
// constant time here, deliberately, rather than by accident.** `verify`
// computes `[S]B` and `[k]A`, where `S` is the signature's own scalar, `k`
// is a hash of public values, and `A` is the public key -- nothing in that
// list is secret, so a timing difference in how long verification takes
// leaks nothing an attacker does not already have. This file still runs
// `verify`'s multiplications through the SAME `scalar_mult` as signing,
// which costs verification some speed it did not have to spend, in
// exchange for one scalar multiplication implementation to get right and
// test instead of two. If verification's speed ever matters enough to be
// worth a second, variable-time implementation, that is a distinct,
// separately-justified change, not something this file does by half.
//
// **Everything else -- point compression/decompression, the hash calls,
// `scalar25519`'s arithmetic on `S`, `k`, and the reduced `a` -- runs on
// secret data too (the seed, the expanded scalar, the nonce) wherever it
// touches signing**, and inherits its constant-time argument from
// `field25519.m31`, `sha512.m31` and `scalar25519.m31`'s own headers rather
// than repeating it here.

import field25519;
import scalar25519;
import sha512;

/// A point on edwards25519, in extended coordinates `(X : Y : Z : T)`,
/// representing the affine point `(X/Z, Y/Z)` with the redundant `T = XY/Z`
/// that makes `point_add` complete. Private: nothing outside this file
/// should construct or inspect one directly.
type Point {
    Array<int> x;
    Array<int> y;
    Array<int> z;
    Array<int> t;
}

// The curve constant `d` (its double is computed where `point_add` needs
// it, not precomputed -- one extra `field25519.mul` per call is not worth a
// second constant to keep in agreement with the first), `sqrt(-1) mod p`
// (needed to pick the right square root when decompressing a point, RFC
// 8032 §5.1.3), and the base point's coordinates -- all generated by, and
// checked against, the derivations this module's report documents (`d`
// from `-121665/121666`, `sqrt(-1)` from `2^((p-1)/4)`, the base point from
// `y = 4/5` and the x-recovery formula), never copied from another
// implementation by hand.
const Array<int> D = [
    0x78A3, 0x1359, 0x4DCA, 0x75EB, 0xD8AB, 0x4141, 0x0A4D, 0x0070,
    0xE898, 0x7779, 0x4079, 0x8CC7, 0xFE73, 0x2B6F, 0x6CEE, 0x5203
];

const Array<int> SQRTM1 = [
    0xA0B0, 0x4A0E, 0x1B27, 0xC4EE, 0xE478, 0xAD2F, 0x1806, 0x2F43,
    0xD7A7, 0x3DFB, 0x0099, 0x2B4D, 0xDF0B, 0x4FC1, 0x2480, 0x2B83
];

const Array<int> BASE_X = [
    0xD51A, 0x8F25, 0x2D60, 0xC956, 0xA7B2, 0x9525, 0xC760, 0x692C,
    0xDC5C, 0xFDD6, 0xE231, 0xC0A4, 0x53FE, 0xCD6E, 0x36D3, 0x2169
];

const Array<int> BASE_Y = [
    0x6658, 0x6666, 0x6666, 0x6666, 0x6666, 0x6666, 0x6666, 0x6666,
    0x6666, 0x6666, 0x6666, 0x6666, 0x6666, 0x6666, 0x6666, 0x6666
];

Point identity() {
    return Point(field25519.zero(), field25519.one(), field25519.one(), field25519.zero());
}

// An affine `(x, y)` lifted to extended coordinates.
Point of_affine(Array<int> x, Array<int> y) {
    return Point(x, y, field25519.one(), field25519.mul(x, y));
}

Point base_point() {
    return of_affine(clone(BASE_X), clone(BASE_Y));
}

// The complete extended-coordinates addition law for `a = -1` (Hisil,
// Wong, Carter, Dawson 2008), valid for ANY two points on this curve,
// doubling included -- see the header for why completeness is what makes
// `scalar_mult`'s "always add, then select" pattern correct.
//
//   A = (Y1-X1)*(Y2-X2);  B = (Y1+X1)*(Y2+X2);  C = T1*2d*T2;  D = 2*Z1*Z2
//   E = B-A;  F = D-C;  G = D+C;  H = B+A
//   X3 = E*F;  Y3 = G*H;  T3 = E*H;  Z3 = F*G
//
// Verified independently against `pynacl` over 300 random signatures and
// every RFC 8032 §7.1 test vector before this file existed -- see the
// report.
Point point_add(Point p1, Point p2) {
    Array<int> two = field25519.small(2);
    Array<int> a = field25519.mul(field25519.sub(p1.y, p1.x), field25519.sub(p2.y, p2.x));
    Array<int> b = field25519.mul(field25519.add(p1.y, p1.x), field25519.add(p2.y, p2.x));
    Array<int> twod_t2 = field25519.mul(field25519.mul(two, D), p2.t);
    Array<int> c = field25519.mul(p1.t, twod_t2);
    Array<int> dd = field25519.mul(field25519.mul(two, p1.z), p2.z);
    Array<int> e = field25519.sub(b, a);
    Array<int> f = field25519.sub(dd, c);
    Array<int> g = field25519.add(dd, c);
    Array<int> h = field25519.add(b, a);
    Array<int> x3 = field25519.mul(e, f);
    Array<int> y3 = field25519.mul(g, h);
    Array<int> t3 = field25519.mul(e, h);
    Array<int> z3 = field25519.mul(f, g);
    return Point(x3, y3, z3, t3);
}

// `a` if `cond` is 1, `b` if `cond` is 0 -- `field25519.cselect` applied to
// all four coordinates, so a whole point is chosen with the same
// constant-time guarantee as one field element.
Point point_cselect(int cond, Point a, Point b) {
    return Point(field25519.cselect(cond, a.x, b.x), field25519.cselect(cond, a.y, b.y), field25519.cselect(cond, a.z, b.z), field25519.cselect(cond, a.t, b.t));
}

// Bit `i` (0 = least significant) of `b`, a 32-octet little-endian scalar.
// Safe regardless of whether `b` holds secret data, for the same reason
// `x25519.m31`'s `bit_at` is: a `bytes` element is always in [0, 255],
// never negative, so the `>>` below never exercises the sign-dependent
// branch `field25519.m31`'s header describes.
int bit_at(bytes b, int i) {
    int byte_idx = i / 8;
    int bit_idx = i % 8;
    return b[byte_idx] >> bit_idx & 1;
}

// `[scalar]base`, scalar given as 32 little-endian octets. Constant-time,
// unconditionally, for every caller -- see the header for why `verify`
// uses this too even though it does not have to.
//
// Fixed 256 iterations regardless of `scalar`'s actual magnitude: looping
// to the scalar's own bit length (as a variable-time implementation would)
// leaks that length through the iteration count, which is exactly the kind
// of thing this function exists to not do.
Point scalar_mult(bytes scalar, Point base) {
    Point r = identity();
    int i = 255;
    while (i >= 0) {
        r = point_add(r, r);
        Point added = point_add(r, base);
        int bit = bit_at(scalar, i);
        r = point_cselect(bit, added, r);
        i = i - 1;
    }
    return r;
}

// `p`'s affine `y`, with `x`'s parity riding in the spare top bit -- RFC
// 8032 §5.1.2's point encoding. Not constant time in itself (`field25519`'s
// `invert`, called here, is; the point being encoded, `A` or `R`, is
// public once computed), but see `sign`'s own note on what stays secret.
bytes compress(Point p) {
    Array<int> zinv = field25519.invert(p.z);
    Array<int> x = field25519.mul(p.x, zinv);
    Array<int> y = field25519.mul(p.y, zinv);
    bytes out = field25519.to_bytes(y);
    int sign_bit = field25519.parity(x);
    out[31] = out[31] | sign_bit << 7;
    return out;
}

// The inverse of `compress`, RFC 8032 §5.1.3: recover `x` from `y` and the
// sign bit via `x^2 = (y^2-1) / (d*y^2+1)`, taking the square root with
// `field25519.pow_p_minus_5_over_8` and correcting it by `sqrt(-1)` when
// the first candidate is the wrong one of the two roots -- exactly RFC
// 8032's own recipe, ported from the big-integer model this module's report
// verified against `pynacl` before this file existed.
//
// `d*y^2 + 1 = 0` has no solution for this curve's `d` (checked separately,
// mod p: `-1/d` is not a quadratic residue), so the inversion below never
// divides by zero for a `y` that reaches it -- and a non-canonical `y`
// (>= p) is refused before that, by comparing the reduced encoding to the
// one handed in.
pub Option<Point> decompress(bytes enc) {
    int sign_bit = enc[31] >> 7 & 1;
    bytes yb = clone(enc);
    yb[31] = yb[31] & 0x7F;
    Array<int> y = field25519.from_bytes(yb);
    if (field25519.to_bytes(y) != yb) {
        return Option<Point>.None;
    }
    Array<int> yy = field25519.sq(y);
    Array<int> u = field25519.sub(yy, field25519.one());
    Array<int> v = field25519.add(field25519.mul(D, yy), field25519.one());
    Array<int> xx = field25519.mul(u, field25519.invert(v));
    // RFC 8032 §5.1.3: the candidate root is `xx^((p+3)/8)`, and
    // `(p+3)/8 == (p-5)/8 + 1`, so this is `field25519.pow_p_minus_5_over_8`
    // (which computes the `(p-5)/8` power) times one more factor of `xx` --
    // reusing that function rather than adding a second, near-identical
    // exponentiation loop for a one-off exponent.
    Array<int> x = field25519.mul(field25519.pow_p_minus_5_over_8(xx), xx);
    if (!field25519.eq(field25519.sq(x), xx)) {
        x = field25519.mul(x, SQRTM1);
        if (!field25519.eq(field25519.sq(x), xx)) {
            return Option<Point>.None;
        }
    }
    if (field25519.is_zero(x) && sign_bit == 1) {
        return Option<Point>.None;
    }
    if (field25519.parity(x) != sign_bit) {
        x = field25519.neg(x);
    }
    return Option<Point>.Some(of_affine(x, y));
}

// Whether `p1` and `p2` are the same affine point, compared projectively
// (`x1*z2 == x2*z1` and `y1*z2 == y2*z1`) so neither side needs an
// inversion. Both sides of `verify`'s check are public, so this makes no
// constant-time claim.
bool point_eq(Point p1, Point p2) {
    bool xok = field25519.eq(field25519.mul(p1.x, p2.z), field25519.mul(p2.x, p1.z));
    bool yok = field25519.eq(field25519.mul(p1.y, p2.z), field25519.mul(p2.y, p1.z));
    return xok && yok;
}

// RFC 8032 §5.1.5's clamp: clear the low 3 bits, clear the top bit, set the
// second-highest -- the same three lines `x25519.m31`'s `clamp_scalar` has,
// because RFC 8032 and RFC 7748 specify the identical clamp. Kept as its
// own copy rather than shared, the way `field25519.m31`'s and
// `scalar25519.m31`'s `cselect` are each their own copy: two three-line
// functions cost less than a dependency neither module otherwise needs.
bytes clamp(bytes k) {
    bytes out = clone(k);
    out[0] = out[0] & 0xF8;
    out[31] = out[31] & 0x7F;
    out[31] = out[31] | 0x40;
    return out;
}

// One SHA-512 over two pieces, without building a concatenated copy first.
bytes hash2(bytes a, bytes b) {
    sha512.Hasher h = sha512.Hasher();
    h.update(a);
    h.update(b);
    return h.digest();
}

bytes hash3(bytes a, bytes b, bytes c) {
    sha512.Hasher h = sha512.Hasher();
    h.update(a);
    h.update(b);
    h.update(c);
    return h.digest();
}

/// RFC 8032 §5.1.5: expand a 32-octet seed into the clamped scalar `a`
/// (still as 32 octets -- callers needing it reduced mod `L` do that
/// themselves) and the 32-octet nonce prefix.
Array<bytes> secret_expand(bytes seed) {
    bytes h = sha512.sum(seed);
    bytes a_raw = clamp(h.substr(0, 32));
    bytes prefix = h.substr(32, 64);
    Array<bytes> out = [a_raw, prefix];
    return out;
}

/// The 32-octet public key for the 32-octet seed `seed` -- RFC 8032
/// §5.1.5, `A = [a]B`, encoded.
pub bytes public_key(bytes seed) {
    Array<bytes> expanded = secret_expand(seed);
    Point a_point = scalar_mult(expanded[0], base_point());
    return compress(a_point);
}

/// Sign `msg` with the 32-octet seed `seed`, RFC 8032 §5.1.6. `sign` and
/// `public_key` agree: `verify(public_key(seed), msg, sign(seed, msg))` is
/// always `true`.
pub bytes sign(bytes seed, bytes msg) {
    Array<bytes> expanded = secret_expand(seed);
    bytes a_raw = expanded[0];
    bytes prefix = expanded[1];
    Array<int> a = scalar25519.reduce256(scalar25519.from_bytes(a_raw));
    Point big_a = scalar_mult(a_raw, base_point());
    bytes a_enc = compress(big_a);
    Array<int> r = scalar25519.reduce64(hash2(prefix, msg));
    bytes r_bytes = scalar25519.to_bytes(r);
    Point big_r = scalar_mult(r_bytes, base_point());
    bytes r_enc = compress(big_r);
    Array<int> k = scalar25519.reduce64(hash3(r_enc, a_enc, msg));
    Array<int> s = scalar25519.muladd(k, a, r);
    bytes out = clone(r_enc);
    out.extend(scalar25519.to_bytes(s));
    return out;
}

/// Verify `sig` (64 octets) over `msg` under the 32-octet public key `pub`,
/// RFC 8032 §5.1.7. Rejects a malformed length, a non-canonical `S`
/// (`S >= L`), an `R` or a public key that does not decompress to a point
/// on the curve, and a signature that does not satisfy `[S]B = R + [k]A`.
pub bool verify(bytes pub_key, bytes msg, bytes sig) {
    if (sig.size() != 64 || pub_key.size() != 32) {
        return false;
    }
    bytes r_enc = sig.substr(0, 32);
    bytes s_bytes = sig.substr(32, 64);
    Array<int> s = scalar25519.from_bytes(s_bytes);
    if (!scalar25519.is_reduced(s)) {
        return false;
    }
    match (decompress(pub_key)) {
        case None: {
            return false;
        }
        case Some(Point big_a): {
            match (decompress(r_enc)) {
                case None: {
                    return false;
                }
                case Some(Point big_r): {
                    Array<int> k = scalar25519.reduce64(hash3(r_enc, pub_key, msg));
                    Point lhs = scalar_mult(s_bytes, base_point());
                    Point rhs = point_add(big_r, scalar_mult(scalar25519.to_bytes(k), big_a));
                    return point_eq(lhs, rhs);
                }
            }
        }
    }
}
