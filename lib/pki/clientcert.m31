// A TLS client's own certificate chain and private key: what it sends when a
// server's CertificateRequest asks who the client is (RFC 8446 §4.3.2, §4.4.2,
// §4.4.3). Used through `tls.connect_identified` and its relatives.
//
// API
// ---
//   Result<Identity, Error> identity = clientcert.load(chain_pem, key_pem);
//   Result<Identity, Error> identity = clientcert.load_files(chain_path, key_path);
//   identity.leaf                      the first certificate (x509.Certificate)
//   identity.chain                     every certificate's DER, leaf first
//   identity.signature_scheme()        -> 0x0807 (Ed25519) | 0x0403 (ECDSA P-256 / SHA-256)
//   identity.fingerprint()             -> "sha256:" + colon-separated hex of the leaf's DER hash
//
// The chain is PEM, leaf first, then intermediates (the root is normally left
// out); the key is one PEM block as `signingkey.m31` reads it (PKCS#8 for
// Ed25519 or P-256, or SEC1 for P-256; encrypted keys and RSA are refused).
// The key must be the one the leaf certifies, checked at load time: a
// mismatch is `KeyMismatch`, not a handshake that fails later at the server.
// There is exactly one signer in this library: this module calls
// `signingkey.SigningKey.sign`, which calls `ecdsasign` or `ed25519`. It
// adds none of its own.
//
// --- the private key: what is and is not constant time --------------------------
//
// This is the first place in the client where a long-lived secret is used.
// (The client's ECDHE scalar is ephemeral; this one signs every handshake.)
//
//   * ECDSA P-256 signing (`ecdsasign.m31`): the scalar multiplications, the
//     field arithmetic and the nonce derivation are written constant-time-style
//     -- no branch, memory index or loop count depends on a secret -- and the
//     nonce is deterministic (RFC 6979), so there is no random-number failure
//     that leaks the key. The header of `ecdsasign.m31` has the full list,
//     including the one rejection loop of probability 2^-32.
//   * Ed25519 signing (`ed25519.m31`): the same claim for `[scalar]B`, the
//     SHA-512 and the arithmetic mod L; see its header.
//   * **Both claims are about the source.** Nobody has audited the machine
//     code the C compiler emits or measured timing across secret inputs. Treat
//     the signers as hardened in design, not as certified.
//   * NOT constant time, because it handles the secret once at load time: the
//     PEM, base64 and DER parsing of the key file, and the check that the key
//     matches the certificate (which compares public values).
//   * **The key is not wiped.** The runtime cannot zero a freed buffer, so a
//     core dump or a swapped page of the process may hold the key. Run
//     clients that hold keys with core dumps off, and do not log or print one:
//     errors here carry no key material, and `Identity.to_str` shows only the
//     subject-independent kind and fingerprint.
//   * Which key signs is chosen by the server's list of acceptable schemes,
//     which is public. The signature is over a transcript hash the server
//     already knows.

import io;
import crypto.sha256;
import pki.signingkey;
import pki.x509;

const str OID_ED25519 = "1.3.101.112";

/// Why an identity could not be loaded. Payload-free: nothing here names a
/// byte of either file.
pub enum Error {
    /// A file could not be read.
    Unreadable;
    /// The chain holds no PEM certificate, or a block is malformed.
    BadPem;
    /// A certificate in the chain could not be parsed.
    BadCertificate;
    /// The key file holds no usable private key.
    BadKey;
    /// The private key is passphrase-protected.
    EncryptedKey;
    /// A key of a kind this library cannot sign with (RSA, another curve).
    UnsupportedKey;
    /// The private key is not the one the first certificate certifies.
    KeyMismatch;
}

pub str Error.to_str() {
    match (this) {
        case Unreadable: {
            return "a certificate or key file could not be read";
        }
        case BadPem: {
            return "the certificate chain is not PEM certificates";
        }
        case BadCertificate: {
            return "a certificate in the chain could not be parsed";
        }
        case BadKey: {
            return "no usable private key in the key file";
        }
        case EncryptedKey: {
            return "the private key is passphrase-protected";
        }
        case UnsupportedKey: {
            return "the private key is not Ed25519 or ECDSA P-256";
        }
        case KeyMismatch: {
            return "the private key is not the one the first certificate certifies";
        }
    }
}

/// A chain and the key for its first certificate.
pub type Identity {
    pub x509.Certificate leaf;
    pub List<bytes> chain;
    signingkey.SigningKey key;
}

pub str Identity.to_str() {
    return "Identity(" + key.kind().to_str() + " " + fingerprint() + ")";
}

/// The TLS SignatureScheme this identity signs with.
pub int Identity.signature_scheme() {
    return key.signature_scheme();
}

/// Signs `message` (what TLS calls the CertificateVerify content) under the
/// private key. Ed25519: the signature of the message itself; P-256: SHA-256 of
/// it, signed, as DER.
pub Result<bytes, signingkey.Error> Identity.sign(bytes message) {
    return key.sign(message);
}

/// The SHA-256 of the leaf certificate's DER, as `sha256:` and colon-separated
/// lower-case hex octets, the form `openssl x509 -fingerprint -sha256` prints.
pub str Identity.fingerprint() {
    bytes digest = sha256.sum(leaf.encoded);
    str digits = "0123456789abcdef";
    str text = "sha256";
    for (int index in 0 .. digest.size()) {
        int octet = digest[index];
        int high = octet >> 4;
        int low = octet & 15;
        text = text + ":" + digits.substr(high, high + 1) + digits.substr(low, low + 1);
    }
    return text;
}

bool key_matches(signingkey.SigningKey key, x509.Certificate leaf) {
    match (key.kind()) {
        case Ed25519: {
            return leaf.public_key.algorithm == OID_ED25519 && leaf.public_key.key_bytes == key.public_key;
        }
        case EcdsaP256: {
            return leaf.public_key.algorithm == x509.OID_EC_PUBLIC_KEY && leaf.public_key.curve == x509.OID_CURVE_P256 && leaf.public_key.key_bytes == key.public_key;
        }
    }
}

Error error_of(signingkey.Error error) {
    match (error) {
        case BadKey: {
            return Error.BadKey;
        }
        case Encrypted: {
            return Error.EncryptedKey;
        }
        case Unsupported: {
            return Error.UnsupportedKey;
        }
        case SigningFailed: {
            return Error.BadKey;
        }
    }
}

/// An `Identity` from PEM text: the chain (leaf first) and one private key.
pub Result<Identity, Error> load(str chain_pem, str key_pem) {
    List<bytes> blobs = [];
    match (x509.pem_certificates(chain_pem)) {
        case Ok(List<bytes> found): {
            blobs = found;
        }
        case Err(x509.Error pem_error): {
            return Result<Identity, Error>.Err(Error.BadPem);
        }
    }
    if (blobs.size() == 0) {
        return Result<Identity, Error>.Err(Error.BadPem);
    }
    List<x509.Certificate> parsed = [];
    for (bytes blob in blobs) {
        match (x509.parse(blob)) {
            case Ok(x509.Certificate certificate): {
                parsed.push(certificate);
            }
            case Err(x509.Error certificate_error): {
                return Result<Identity, Error>.Err(Error.BadCertificate);
            }
        }
    }
    match (signingkey.parse_pem(key_pem)) {
        case Err(signingkey.Error key_error): {
            return Result<Identity, Error>.Err(error_of(key_error));
        }
        case Ok(signingkey.SigningKey key): {
            if (!key_matches(key, parsed[0])) {
                return Result<Identity, Error>.Err(Error.KeyMismatch);
            }
            return Result<Identity, Error>.Ok(Identity(parsed[0], blobs, key));
        }
    }
}

/// `load` from two files.
pub Result<Identity, Error> load_files(str chain_path, str key_path) {
    match (io.read(chain_path)) {
        case Err(io.Error chain_error): {
            return Result<Identity, Error>.Err(Error.Unreadable);
        }
        case Ok(str chain_text): {
            match (io.read(key_path)) {
                case Err(io.Error key_error): {
                    return Result<Identity, Error>.Err(Error.Unreadable);
                }
                case Ok(str key_text): {
                    return load(chain_text, key_text);
                }
            }
        }
    }
}
