// A small regular expression engine: a Thompson NFA, simulated breadth-first
// (Pike's VM), compiled straight from the pattern with no separate AST.
//
// The scope, and the reasons behind every cut from a "real" regex engine,
// are `docs/regex-decision.md`. The one that matters most while reading this
// file: **there are no backreferences and no lookaround, which is what lets
// every pattern this module accepts match in O(n*m) time, n the subject's
// length and m the compiled program's size, with no input that is slow.** A
// backtracking engine (PCRE, Perl, Python's `re`, JavaScript's RegExp) cannot
// promise that for any pattern, whether or not it uses the features that
// break the promise; this one can, because the algorithm is different, not
// because the input is trusted.
//
// API
// ---
//   Result<regex.Regex, regex.CompileError> compile(pattern)
//
//   re.is_match(s)     -> bool             does `s` contain a match anywhere
//   re.find(s)         -> Option<Match>    the leftmost match, if any
//   re.find_all(s)     -> List<Match>      every non-overlapping match, left to right
//   re.group_count()   -> int              how many capturing groups `re` has
//
//   Match.whole                -> Group            the whole match
//   Match.groups                -> List<Option<Group>>   1-indexed: groups[k] is `(...)` number k;
//                                                          groups[0] is unused and always None
//   Group.start, Group.end     -> int              CODE POINT offsets into `s.chars()` (docs/regex-decision.md §2)
//   Group.text                 -> str              the matched text
//
// Syntax: literals, `.`, `[abc]` `[a-z]` `[^...]`, `\d \w \s \D \W \S`
// (ASCII; `\D \W \S` only outside a class -- §2b of the decision), `^` `$`
// (string anchors, not line anchors -- §2c), `* + ? {m} {m,} {m,n}`
// (greedy), `|`, `(...)` (capturing), and `\` before any of
// `. * + ? ( ) [ ] { } | ^ $ \` to mean that character literally, plus
// `\n \t \r`. Nothing else is in v0; see the decision doc for what was cut
// and why.

// --- compile errors ----------------------------------------------------------
/// Why `compile` refused a pattern. Payload-free (docs/errors-decision.md
/// §4): the pattern is the caller's own string, so where in it things went
/// wrong is context the caller already has when it reports.
pub enum CompileError {
    /// A `(` with no matching `)`, or a `)` with no matching `(`.
    UnbalancedParen;
    /// A `[` with no matching `]`.
    UnbalancedBracket;
    /// `*`, `+`, `?` or `{..}` with nothing before it to repeat -- including
    /// a second quantifier stacked directly on the first (`a**`).
    DanglingQuantifier;
    /// `\` followed by a letter or digit that names nothing (`\q`).
    BadEscape;
    /// The pattern ends in a lone `\`.
    TrailingBackslash;
    /// A `{...}` that is not `{m}`, `{m,}` or `{m,n}`, or where `n < m`.
    BadRepeat;
    /// A `{m,n}` (or `{m}` or `{m,}`) whose bound is past `MAX_REPEAT`.
    RepeatTooLarge;
    /// `[z-a]`: the range's low end is above its high end.
    BadRange;
    /// `[]`: a character class with nothing in it matches nothing, which is
    /// never useful and is almost always a stray bracket.
    EmptyClass;
}

/// A sentence saying what was wrong. A method named `to_str`, so
/// `print(e)` prints it.
pub str CompileError.to_str() {
    match (this) {
        case UnbalancedParen: {
            return "unbalanced parenthesis";
        }
        case UnbalancedBracket: {
            return "unterminated character class: missing ]";
        }
        case DanglingQuantifier: {
            return "quantifier has nothing to repeat";
        }
        case BadEscape: {
            return "invalid escape sequence";
        }
        case TrailingBackslash: {
            return "pattern ends with a lone backslash";
        }
        case BadRepeat: {
            return "invalid {m,n} repeat";
        }
        case RepeatTooLarge: {
            return "repeat count is too large";
        }
        case BadRange: {
            return "character class range is reversed";
        }
        case EmptyClass: {
            return "character class matches nothing";
        }
    }
}

// --- compiled program ---------------------------------------------------------
// The textbook seven Thompson-NFA instructions (docs/regex-decision.md §3).
// `Jmp` and `Split`'s targets, and `Save`'s slot, are absolute once a
// fragment is folded into the final program; while a fragment is being
// built they are relative to that fragment's own start (`frag_append`
// below is what relocates them).
enum Inst {
    Char(int);
    Any;
    Class(int);
    Bol;
    Eol;
    Save(int);
    Jmp(int);
    Split(int, int);
    Match;
}

// A character class: the union of `[lo[i], hi[i]]`, inclusive, for every i,
// negated as a whole if `negate`.
type ClassDef {
    List<int> low;
    List<int> high;
    bool is_negated = false;
}

bool is_in_class(List<ClassDef> classes, int class_index, int code_point) {
    ClassDef class_def = classes[class_index];
    bool is_found = false;
    int range_index = 0;
    int range_count = class_def.low.size();
    while (range_index < range_count) {
        if (code_point >= class_def.low[range_index] && code_point <= class_def.high[range_index]) {
            is_found = true;
            break;
        }
        range_index = range_index + 1;
    }
    if (class_def.is_negated) {
        return !is_found;
    }
    return is_found;
}

// --- fragments: a self-contained piece of program, addressed from 0 ----------
//
// Each parse production returns one of these. Composing two fragments is
// `frag_append`: copy `b`'s instructions onto the end of `a`, adding `a`'s
// current length to every `Jmp`/`Split` target in the copy -- the "shift the
// addresses" half of Thompson's construction, done by relocation instead of
// a patch list because there is nothing here to point a pointer at. A `Save`
// slot is a group number, not an address, so it is copied unchanged.
type Frag {
    List<Inst> code;
}

void frag_append(Frag destination, Frag source) {
    int base = destination.code.size();
    for (Inst instruction in source.code) {
        match (instruction) {
            case Char(int code_point): {
                destination.code.push(Inst.Char(code_point));
            }
            case Any: {
                destination.code.push(Inst.Any);
            }
            case Class(int class_index): {
                destination.code.push(Inst.Class(class_index));
            }
            case Bol: {
                destination.code.push(Inst.Bol);
            }
            case Eol: {
                destination.code.push(Inst.Eol);
            }
            case Save(int slot): {
                destination.code.push(Inst.Save(slot));
            }
            case Jmp(int target): {
                destination.code.push(Inst.Jmp(target + base));
            }
            case Split(int x, int y): {
                destination.code.push(Inst.Split(x + base, y + base));
            }
            case Match: {
                destination.code.push(Inst.Match);
            }
        }
    }
}

// `atom*`, greedy: prefer entering `atom` again over leaving.
//
//     0: split 1, END     -- END is patched once `atom`'s length is known
//     1: <atom>
//        jmp 0
//     END:
Frag star(Frag atom) {
    Frag out = Frag([]);
    out.code.push(Inst.Split(1, -1));
    frag_append(out, atom);
    out.code.push(Inst.Jmp(0));
    int end = out.code.size();
    out.code[0] = Inst.Split(1, end);
    return out;
}

// `atom+`, greedy: `atom` once, then loop like `*`. No patch needed -- the
// fragment ends right where the `Split`'s "stop" branch wants to land, which
// is exactly the current length at the point it is written.
Frag plus(Frag atom) {
    Frag out = Frag([]);
    frag_append(out, atom);
    int split_pc = out.code.size();
    out.code.push(Inst.Split(0, split_pc + 1));
    return out;
}

// `atom?`, greedy: prefer matching `atom` over skipping it.
Frag quest(Frag atom) {
    Frag out = Frag([]);
    out.code.push(Inst.Split(1, -1));
    frag_append(out, atom);
    int end = out.code.size();
    out.code[0] = Inst.Split(1, end);
    return out;
}

// `atom{m,n}` (`n < 0` means unbounded, `atom{m,}`): `minimum` mandatory copies,
// then either `n - m` independently-optional copies or, if unbounded, a
// `*` -- RE2's own translation (docs/regex-decision.md §3). `atom` is only
// ever read here, never mutated, so appending it `minimum` (or more) times is
// safe: each `frag_append` or `quest`/`star` call makes an independent copy
// of its instructions.
Frag repeat(Frag atom, int minimum, int maximum) {
    Frag out = Frag([]);
    int copy_index = 0;
    while (copy_index < minimum) {
        frag_append(out, atom);
        copy_index = copy_index + 1;
    }
    if (maximum < 0) {
        frag_append(out, star(atom));
    } else {
        int optional_index = minimum;
        while (optional_index < maximum) {
            frag_append(out, quest(atom));
            optional_index = optional_index + 1;
        }
    }
    return out;
}

// --- escapes, shared between bare patterns and inside a class ----------------

// `\n`, `\t`, `\r`, or `escape` itself if `escape` is punctuation (anything that is
// not a letter or digit may always be escaped to mean itself: `\.` `\*`
// `\\` and so on). A letter or digit that names none of the above
// (`\q`, `\9`) is refused rather than silently meaning the bare letter --
// a typo in a pattern should not compile into a different pattern.
Result<int, CompileError> escape_literal(int escape) {
    if (escape == 'n') {
        return Result<int, CompileError>.Ok(10);
    }
    if (escape == 't') {
        return Result<int, CompileError>.Ok(9);
    }
    if (escape == 'r') {
        return Result<int, CompileError>.Ok(13);
    }
    bool is_alnum = (escape >= 'a' && escape <= 'z') || (escape >= 'A' && escape <= 'Z') || (escape >= '0' && escape <= '9');
    if (is_alnum) {
        return Result<int, CompileError>.Err(CompileError.BadEscape);
    }
    return Result<int, CompileError>.Ok(escape);
}

// `\w`'s ranges: ASCII letters, digits, underscore.
void word_ranges(ClassDef class_def) {
    class_def.low.push('a');
    class_def.high.push('z');
    class_def.low.push('A');
    class_def.high.push('Z');
    class_def.low.push('0');
    class_def.high.push('9');
    class_def.low.push('_');
    class_def.high.push('_');
}

// `\s`'s ranges: the same six ASCII bytes `lib/text.m31`'s `is_space`
// treats as space -- space, tab, \n, \r, \f, \v -- reused rather than
// redefined, so the two modules can never disagree about what whitespace is
// (docs/text-decision.md's consistency argument for `trim`).
void space_ranges(ClassDef class_def) {
    class_def.low.push(32);
    class_def.high.push(32);
    class_def.low.push(9);
    class_def.high.push(9);
    class_def.low.push(10);
    class_def.high.push(10);
    class_def.low.push(13);
    class_def.high.push(13);
    class_def.low.push(12);
    class_def.high.push(12);
    class_def.low.push(11);
    class_def.high.push(11);
}

// The largest bound a `{m,n}` may name. A guard on `compile`'s own memory
// use -- how large one bound may make the program -- and unrelated to the
// matching engine's time complexity, which stays O(n*m) for whatever this
// let through (docs/regex-decision.md §3).
const int MAX_REPEAT = 1000;

// --- the parser: recursive descent straight to a Frag, no AST ----------------
//
// Grammar (standard, precedence lowest to highest): `alt = concat ('|'
// concat)*`, `concat = repeat*`, `repeat = atom ('*' | '+' | '?' |
// bound)?`, `atom = literal | '.' | class | '^' | '$' | '(' alt ')' |
// escape`.
type Parser {
    List<int> pattern;
    int position = 0;
    int ngroups = 0;
    List<ClassDef> classes = [];
}

bool Parser.is_at_end() {
    return position >= pattern.size();
}

int Parser.peek() {
    return pattern[position];
}

int Parser.next() {
    int code_point = pattern[position];
    position = position + 1;
    return code_point;
}

// One or more ASCII digits, or `None` if there are none at all -- `{`'s
// bound needs to tell "no number here" from "the number 0".
Option<int> Parser.parse_digits() {
    int start = position;
    int number = 0;
    while (!is_at_end() && peek() >= '0' && peek() <= '9') {
        // Clamped rather than left to overflow: a pattern spelling a huge
        // bound is refused by the MAX_REPEAT check right after this runs,
        // and int overflow traps, which `{99999999999999999999}` would hit
        // first and for the wrong reason.
        if (number < MAX_REPEAT + 1) {
            number = number * 10 + (next() - '0');
        } else {
            next();
        }
    }
    if (position == start) {
        return Option<int>.None;
    }
    return Option<int>.Some(number);
}

Result<Frag, CompileError> Parser.parse_alt() {
    Frag first = parse_concat()?;
    if (is_at_end() || peek() != '|') {
        return Result<Frag, CompileError>.Ok(first);
    }
    next();
    Frag rest = parse_alt()?;
    // 0: split 1, REST   -- try `first` before `rest`, left-biased
    // 1: <first>
    //    jmp END
    // REST: <rest>
    // END:
    Frag out = Frag([]);
    out.code.push(Inst.Split(1, -1));
    frag_append(out, first);
    int jmp_pc = out.code.size();
    out.code.push(Inst.Jmp(-1));
    int rest_start = out.code.size();
    out.code[0] = Inst.Split(1, rest_start);
    frag_append(out, rest);
    int end = out.code.size();
    out.code[jmp_pc] = Inst.Jmp(end);
    return Result<Frag, CompileError>.Ok(out);
}

Result<Frag, CompileError> Parser.parse_concat() {
    Frag out = Frag([]);
    while (!is_at_end() && peek() != '|' && peek() != ')') {
        Frag part = parse_repeat()?;
        frag_append(out, part);
    }
    return Result<Frag, CompileError>.Ok(out);
}

Result<Frag, CompileError> Parser.parse_repeat() {
    Frag atom = parse_atom()?;
    if (is_at_end()) {
        return Result<Frag, CompileError>.Ok(atom);
    }
    int code_point = peek();
    Frag result = atom;
    bool is_quantified = false;
    if (code_point == '*') {
        next();
        result = star(atom);
        is_quantified = true;
    } else if (code_point == '+') {
        next();
        result = plus(atom);
        is_quantified = true;
    } else if (code_point == '?') {
        next();
        result = quest(atom);
        is_quantified = true;
    } else if (code_point == '{') {
        match (parse_bound(atom)) {
            case Ok(Frag bounded): {
                result = bounded;
                is_quantified = true;
            }
            case Err(CompileError error): {
                return Result<Frag, CompileError>.Err(error);
            }
        }
    }
    if (is_quantified && !is_at_end()) {
        int following = peek();
        if (following == '*' || following == '+' || following == '?' || following == '{') {
            return Result<Frag, CompileError>.Err(CompileError.DanglingQuantifier);
        }
    }
    return Result<Frag, CompileError>.Ok(result);
}

// `{m}`, `{m,}` or `{m,n}`. `atom` has already been parsed; `{` is the
// current character.
Result<Frag, CompileError> Parser.parse_bound(Frag atom) {
    next();
    int mval = 0;
    match (parse_digits()) {
        case Some(int lower_bound): {
            mval = lower_bound;
        }
        case None: {
            return Result<Frag, CompileError>.Err(CompileError.BadRepeat);
        }
    }
    int nval = mval;
    if (!is_at_end() && peek() == ',') {
        next();
        match (parse_digits()) {
            case Some(int upper_bound): {
                nval = upper_bound;
            }
            case None: {
                nval = -1;
            }
        }
    }
    if (is_at_end() || peek() != '}') {
        return Result<Frag, CompileError>.Err(CompileError.BadRepeat);
    }
    next();
    if (nval >= 0 && nval < mval) {
        return Result<Frag, CompileError>.Err(CompileError.BadRepeat);
    }
    if (mval > MAX_REPEAT || nval > MAX_REPEAT) {
        return Result<Frag, CompileError>.Err(CompileError.RepeatTooLarge);
    }
    return Result<Frag, CompileError>.Ok(repeat(atom, mval, nval));
}

Result<Frag, CompileError> Parser.parse_atom() {
    int code_point = peek();
    if (code_point == '*' || code_point == '+' || code_point == '?' || code_point == '{') {
        return Result<Frag, CompileError>.Err(CompileError.DanglingQuantifier);
    }
    if (code_point == '(') {
        next();
        ngroups = ngroups + 1;
        int group_number = ngroups;
        Frag inner = parse_alt()?;
        if (is_at_end() || peek() != ')') {
            return Result<Frag, CompileError>.Err(CompileError.UnbalancedParen);
        }
        next();
        Frag out = Frag([]);
        out.code.push(Inst.Save(2 * group_number));
        frag_append(out, inner);
        out.code.push(Inst.Save(2 * group_number + 1));
        return Result<Frag, CompileError>.Ok(out);
    }
    if (code_point == ')') {
        return Result<Frag, CompileError>.Err(CompileError.UnbalancedParen);
    }
    if (code_point == '.') {
        next();
        Frag out = Frag([]);
        out.code.push(Inst.Any);
        return Result<Frag, CompileError>.Ok(out);
    }
    if (code_point == '^') {
        next();
        Frag out = Frag([]);
        out.code.push(Inst.Bol);
        return Result<Frag, CompileError>.Ok(out);
    }
    if (code_point == '$') {
        next();
        Frag out = Frag([]);
        out.code.push(Inst.Eol);
        return Result<Frag, CompileError>.Ok(out);
    }
    if (code_point == '[') {
        return parse_class();
    }
    if (code_point == '\\') {
        return parse_escape_atom();
    }
    next();
    Frag out = Frag([]);
    out.code.push(Inst.Char(code_point));
    return Result<Frag, CompileError>.Ok(out);
}

// `\d \w \s` (bare, outside a class) are their own one-shorthand class;
// `\D \W \S` are the same, negated; everything else is `escape_literal`.
Result<Frag, CompileError> Parser.parse_escape_atom() {
    next();
    if (is_at_end()) {
        return Result<Frag, CompileError>.Err(CompileError.TrailingBackslash);
    }
    int escape = next();
    if (escape == 'd' || escape == 'D' || escape == 'w' || escape == 'W' || escape == 's' || escape == 'S') {
        ClassDef class_def = ClassDef([], [], is_negated: (escape == 'D' || escape == 'W' || escape == 'S'));
        if (escape == 'd' || escape == 'D') {
            class_def.low.push('0');
            class_def.high.push('9');
        } else if (escape == 'w' || escape == 'W') {
            word_ranges(class_def);
        } else {
            space_ranges(class_def);
        }
        classes.push(class_def);
        int class_index = classes.size() - 1;
        Frag out = Frag([]);
        out.code.push(Inst.Class(class_index));
        return Result<Frag, CompileError>.Ok(out);
    }
    match (escape_literal(escape)) {
        case Ok(int code_point): {
            Frag out = Frag([]);
            out.code.push(Inst.Char(code_point));
            return Result<Frag, CompileError>.Ok(out);
        }
        case Err(CompileError error): {
            return Result<Frag, CompileError>.Err(error);
        }
    }
}

// One literal code point inside `[...]`: an escape (punctuation, or
// `\n \t \r`) or an ordinary character. `\d \w \s \D \W \S` are handled by
// the caller before this is reached (docs/regex-decision.md §2b) -- if one
// reaches here anyway (nothing else consumed it), `escape_literal` refuses
// it as every other letter-escape it does not recognise.
Result<int, CompileError> Parser.class_literal() {
    if (is_at_end()) {
        return Result<int, CompileError>.Err(CompileError.UnbalancedBracket);
    }
    int code_point = next();
    if (code_point == '\\') {
        if (is_at_end()) {
            return Result<int, CompileError>.Err(CompileError.TrailingBackslash);
        }
        int escape = next();
        return escape_literal(escape);
    }
    return Result<int, CompileError>.Ok(code_point);
}

// `[...]`, `[^...]`. A literal `]` must be escaped (`\]`) -- there is no
// POSIX "a `]` right after `[` or `[^` is literal" rule here
// (docs/regex-decision.md §4).
Result<Frag, CompileError> Parser.parse_class() {
    next();
    bool is_negate = false;
    if (!is_at_end() && peek() == '^') {
        next();
        is_negate = true;
    }
    ClassDef class_def = ClassDef([], [], is_negated: is_negate);
    bool is_any_item = false;
    while (true) {
        if (is_at_end()) {
            return Result<Frag, CompileError>.Err(CompileError.UnbalancedBracket);
        }
        if (peek() == ']') {
            next();
            break;
        }
        if (peek() == '\\' && position + 1 < pattern.size()) {
            int nxt = pattern[position + 1];
            if (nxt == 'd' || nxt == 'w' || nxt == 's') {
                next();
                next();
                if (nxt == 'd') {
                    class_def.low.push('0');
                    class_def.high.push('9');
                } else if (nxt == 'w') {
                    word_ranges(class_def);
                } else {
                    space_ranges(class_def);
                }
                is_any_item = true;
                continue;
            }
            if (nxt == 'D' || nxt == 'W' || nxt == 'S') {
                return Result<Frag, CompileError>.Err(CompileError.BadEscape);
            }
        }
        int range_start = 0;
        match (class_literal()) {
            case Ok(int first_point): {
                range_start = first_point;
            }
            case Err(CompileError error): {
                return Result<Frag, CompileError>.Err(error);
            }
        }
        if (!is_at_end() && peek() == '-' && position + 1 < pattern.size() && pattern[position + 1] != ']') {
            next();
            int range_end = 0;
            match (class_literal()) {
                case Ok(int last_point): {
                    range_end = last_point;
                }
                case Err(CompileError error): {
                    return Result<Frag, CompileError>.Err(error);
                }
            }
            if (range_end < range_start) {
                return Result<Frag, CompileError>.Err(CompileError.BadRange);
            }
            class_def.low.push(range_start);
            class_def.high.push(range_end);
        } else {
            class_def.low.push(range_start);
            class_def.high.push(range_start);
        }
        is_any_item = true;
    }
    if (!is_any_item) {
        return Result<Frag, CompileError>.Err(CompileError.EmptyClass);
    }
    classes.push(class_def);
    int class_index = classes.size() - 1;
    Frag out = Frag([]);
    out.code.push(Inst.Class(class_index));
    return Result<Frag, CompileError>.Ok(out);
}

// --- the compiled regex -------------------------------------------------------
pub type Regex {
    List<Inst> prog;
    List<ClassDef> classes;
    int ngroups;
}

/// Does `text` contain a match anywhere?
pub bool Regex.is_match(str text) {
    return run(this, text.chars(), 0).is_some();
}

/// The leftmost match in `text`, if there is one.
///
///     re.find("x42y")      -- for `re` from `regex.compile("\\d+")`
pub Option<Match> Regex.find(str text) {
    List<int> chars = text.chars();
    match (run(this, chars, 0)) {
        case Some(List<int> saved): {
            return Option<Match>.Some(build_match(chars, ngroups, saved));
        }
        case None: {
            return Option<Match>.None;
        }
    }
}

/// Every non-overlapping match in `text`, left to right. An empty match (a
/// pattern like `a*` can match zero characters) advances by one code point
/// afterwards so the search makes progress, the same rule Python's
/// `re.finditer` and Go's `FindAllString` use.
pub List<Match> Regex.find_all(str text) {
    List<int> chars = text.chars();
    int code_point_count = chars.size();
    List<Match> out = [];
    int position = 0;
    while (position <= code_point_count) {
        match (run(this, chars, position)) {
            case None: {
                break;
            }
            case Some(List<int> saved): {
                out.push(build_match(chars, ngroups, saved));
                if (saved[1] == saved[0]) {
                    position = saved[1] + 1;
                } else {
                    position = saved[1];
                }
            }
        }
    }
    return out;
}

/// How many capturing groups `this` has. `m.groups.size()` on a `Match` from
/// it is always this plus one (index 0 is unused -- see the module header).
pub int Regex.group_count() {
    return ngroups;
}

/// Compile `pattern`. See the module header for the syntax and
/// `docs/regex-decision.md` for what is deliberately not in it.
///
///     regex.compile("[a-z]+")           -> Ok(..)
///     regex.compile("a(b")              -> Err(UnbalancedParen)
pub Result<Regex, CompileError> compile(str pattern) {
    Parser parser = Parser(pattern.chars());
    Frag body = parser.parse_alt()?;
    if (!parser.is_at_end()) {
        // Only an unconsumed `)` can stop `parse_alt` before eof.
        return Result<Regex, CompileError>.Err(CompileError.UnbalancedParen);
    }
    Frag real = Frag([]);
    real.code.push(Inst.Save(0));
    frag_append(real, body);
    real.code.push(Inst.Save(1));
    real.code.push(Inst.Match);
    // Unanchored search, built once here rather than re-run per start
    // position: try the real pattern at this code point first (higher
    // priority); only once every thread from that attempt has died does the
    // lower-priority "skip one code point, try the next position" thread
    // run (docs/regex-decision.md §3).
    Frag prog = Frag([]);
    prog.code.push(Inst.Split(1, -1));
    frag_append(prog, real);
    int skip_at = prog.code.size();
    prog.code.push(Inst.Any);
    prog.code.push(Inst.Jmp(0));
    prog.code[0] = Inst.Split(1, skip_at);
    return Result<Regex, CompileError>.Ok(Regex(prog.code, parser.classes, parser.ngroups));
}

// --- matching: Pike's VM -------------------------------------------------------

type Thread {
    int program_counter;
    List<int> saved;
}

// Follows every epsilon transition (Jmp, Split, Save, and the zero-width
// Bol/Eol assertions) from `program_counter` and adds the live thread(s) it reaches to
// `list`. `marked` is this step's "already added" bitmap, keyed by `program_counter`: it
// is what stops a loop of epsilon transitions (`(a*)*`'s inner `*` feeding
// the outer one) from adding the same thread twice or recursing forever,
// and it is the reason this simulation is O(m) threads per code point
// rather than unbounded.
//
// `saved` is never mutated in place -- only `Save` writes to one, and it
// always `clone`s first (see its case below) -- so handing the SAME
// reference to both of `Split`'s branches is safe: neither can see the
// other's later writes, because there never are any to the shared object.
void addthread(List<Inst> prog, List<Thread> list, Array<bool> marked, int program_counter, List<int> saved, int position, int input_length) {
    if (marked[program_counter]) {
        return;
    }
    marked[program_counter] = true;
    match (prog[program_counter]) {
        case Jmp(int target): {
            addthread(prog, list, marked, target, saved, position, input_length);
        }
        case Split(int x, int y): {
            addthread(prog, list, marked, x, saved, position, input_length);
            addthread(prog, list, marked, y, saved, position, input_length);
        }
        case Save(int slot): {
            List<int> saved_copy = clone(saved);
            saved_copy[slot] = position;
            addthread(prog, list, marked, program_counter + 1, saved_copy, position, input_length);
        }
        case Bol: {
            if (position == 0) {
                addthread(prog, list, marked, program_counter + 1, saved, position, input_length);
            }
        }
        case Eol: {
            if (position == input_length) {
                addthread(prog, list, marked, program_counter + 1, saved, position, input_length);
            }
        }
        case Char: {
            list.push(Thread(program_counter, saved));
        }
        case Any: {
            list.push(Thread(program_counter, saved));
        }
        case Class: {
            list.push(Thread(program_counter, saved));
        }
        case Match: {
            list.push(Thread(program_counter, saved));
        }
    }
}

// Run `compiled`'s program against `chars`, seeded at code point `from`, and
// return the first (highest-priority, i.e. leftmost-greedy) match's capture
// slots, if any. One pass, O((n - from) * m): every code point is visited
// once, and `marked` keeps each step's thread count at or below `m`.
Option<List<int>> run(Regex compiled, List<int> chars, int from) {
    int input_length = chars.size();
    int nslots = 2 * (compiled.ngroups + 1);
    List<int> seed = [-1; nslots];
    List<Thread> clist = [];
    Array<bool> marked0 = [false; compiled.prog.size()];
    addthread(compiled.prog, clist, marked0, 0, seed, from, input_length);
    Option<List<int>> matched = Option<List<int>>.None;
    int position = from;
    while (clist.size() > 0) {
        bool has_char = position < input_length;
        int code_point = 0;
        if (has_char) {
            code_point = chars[position];
        }
        List<Thread> nlist = [];
        Array<bool> marked = [false; compiled.prog.size()];
        int thread_index = 0;
        int thread_count = clist.size();
        while (thread_index < thread_count) {
            Thread thread = clist[thread_index];
            match (compiled.prog[thread.program_counter]) {
                case Char(int expected): {
                    if (has_char && expected == code_point) {
                        addthread(compiled.prog, nlist, marked, thread.program_counter + 1, thread.saved, position + 1, input_length);
                    }
                }
                case Any: {
                    if (has_char) {
                        addthread(compiled.prog, nlist, marked, thread.program_counter + 1, thread.saved, position + 1, input_length);
                    }
                }
                case Class(int class_index): {
                    if (has_char && is_in_class(compiled.classes, class_index, code_point)) {
                        addthread(compiled.prog, nlist, marked, thread.program_counter + 1, thread.saved, position + 1, input_length);
                    }
                }
                case Match: {
                    matched = Option<List<int>>.Some(thread.saved);
                    break;
                }
                case Jmp: {
                    trap("regex: Jmp cannot be on a thread list -- addthread already followed it");
                }
                case Split: {
                    trap("regex: Split cannot be on a thread list -- addthread already followed it");
                }
                case Save: {
                    trap("regex: Save cannot be on a thread list -- addthread already followed it");
                }
                case Bol: {
                    trap("regex: Bol cannot be on a thread list -- addthread already followed it");
                }
                case Eol: {
                    trap("regex: Eol cannot be on a thread list -- addthread already followed it");
                }
            }
            thread_index = thread_index + 1;
        }
        clist = nlist;
        if (!has_char) {
            break;
        }
        position = position + 1;
    }
    return matched;
}

// --- results --------------------------------------------------------------------
pub type Group {
    pub int start;
    pub int end;
    pub str text;
}

pub type Match {
    pub Group whole;
    pub List<Option<Group>> groups;
}

Match build_match(List<int> chars, int ngroups, List<int> saved) {
    Group whole = Group(saved[0], saved[1], str.from_chars(chars.slice(saved[0], saved[1])));
    List<Option<Group>> groups = [Option<Group>.None];
    int group_number = 1;
    while (group_number <= ngroups) {
        int group_start = saved[2 * group_number];
        int group_end = saved[2 * group_number + 1];
        if (group_start < 0 || group_end < 0) {
            groups.push(Option<Group>.None);
        } else {
            groups.push(Option<Group>.Some(Group(group_start, group_end, str.from_chars(chars.slice(group_start, group_end)))));
        }
        group_number = group_number + 1;
    }
    return Match(whole, groups);
}
