// The process: its command line, its environment, and how it ends.
//
// API
// ---
//   os.args()             -> List<str>, every argument, the program's own
//                            name first
//   os.args_bytes()       -> List<bytes>, the same, exactly as the OS passed them
//   os.env(name)          -> Option<str>, one environment variable, as text
//   os.env_bytes(name)    -> Option<bytes>, the same, exactly as the OS holds it
//   os.env_map()          -> Map<str, str>, every variable that is text
//
// A name ends in the shape it answers with: `_bytes` gives octets, `_map`
// gives a map, and a plain name gives text or a list of it.
//   os.exit(code)         -> does not return; standard output is flushed first
//
// Three facts the operating system hands a process, and nothing built on
// them: parsing the command line is `args`, and it is handed these tokens
// rather than reading them itself, which is what makes a parser testable
// from a program that has no command line of its own.
//
// Text or octets is decided here, at the door, as `io.read` decides it for a
// file. On Unix an argument or a variable is any run of non-NUL bytes, and a
// `str` is always valid UTF-8 (reference §3), so the runtime hands over
// `bytes` and `utf8()` -- the one conversion into `str` -- checks each.
// docs/text-decision.md compares this with Rust, whose `env::args()` panics
// here and whose `args_os()` is `args_bytes`.

prim void __args(List<bytes> out);
prim int __env(str name, List<bytes> out);
prim void __env_map(List<bytes> out);
prim void __exit(int code);

/// Every argument the program was started with, `argv[0]` -- the name it was
/// invoked as -- first.
///
/// Including it is Go's `os.Args`, Oro's `sys.argv` and C's `argv`, and the
/// agreement is the reason: a list that is exactly what the operating system
/// passed has one meaning everywhere, where a list with the first element
/// quietly removed is a second convention to remember at every index. A
/// parser is handed the rest; see `args`.
///
/// An argument that is not UTF-8 -- a file name from a Latin-1 disk, say --
/// **traps**, naming the argument and `args_bytes`. This is Rust's trade
/// (`env::args()` panics, `args_os()` does not): nearly every program wants
/// its arguments as text and would otherwise carry a `match` for a case it
/// never meets, and the program that really does take any file name reads
/// `args_bytes` instead. It is neither dropped nor repaired: dropping one
/// would move every later index, and a replacement character would hand the
/// program a file name that names no file.
///
/// A fresh list per call: changing it changes nothing but the copy.
pub List<str> args() {
    List<str> out = [];
    int i = 0;
    for (bytes a in args_bytes()) {
        match (a.utf8()) {
            case Some(str s): {
                out.push(s);
            }
            case None: {
                trap("os.args(): argument " + i.to_str() + " is not valid UTF-8; read os.args_bytes() instead");
            }
        }
        i = i + 1;
    }
    return out;
}

/// Every argument, exactly the octets the operating system passed, whether
/// or not they are text: Rust's `args_os`. A fresh list per call.
pub List<bytes> args_bytes() {
    List<bytes> out = [];
    __args(out);
    return out;
}

/// The value of the environment variable `name` as text, or None if it is
/// not set.
///
/// Set-but-empty is `Some("")`, not None: the two are different facts and
/// programs do branch on them. A name that could never be a variable -- empty,
/// or holding an `=` or a NUL -- is simply not set.
///
/// A value that is not valid UTF-8 is None as well: there is no text by that
/// name, which is the question asked, and a program that falls back to a
/// default when `LANG` is unset does the right thing when it is not text.
/// `env_bytes` tells the two apart. `args` cannot, because a list cannot
/// leave one element out without moving the rest.
///
/// Oro spells this `os.env` too, having renamed Python's `os.environ`. There
/// is no way to set or list variables: a program that needs to change the
/// environment is starting another program, and that belongs with whatever
/// starts it.
pub Option<str> env(str name) {
    match (env_bytes(name)) {
        case Some(bytes v): {
            return v.utf8();
        }
        case None: {
            return Option<str>.None;
        }
    }
}

/// The value of the environment variable `name`, exactly the octets the
/// operating system holds, or None if it is not set.
pub Option<bytes> env_bytes(str name) {
    List<bytes> got = [];
    if (__env(name, got) == 0) {
        return Option<bytes>.None;
    }
    return Option<bytes>.Some(got[0]);
}

/// Every environment variable whose name and value are both text.
///
/// One that is not -- a value from a Latin-1 disk, a name the shell smuggled
/// through -- is left out rather than repaired, for the reason `env` answers
/// None: there is no text by that name. `env_bytes` still finds it by name.
/// A fresh map per call, so changing it changes nothing but the copy.
pub Map<str, str> env_map() {
    List<bytes> flat = [];
    __env_map(flat);
    Map<str, str> out = {};
    int i = 0;
    while (i + 1 < flat.size()) {
        match (flat[i].utf8()) {
            case Some(str name): {
                match (flat[i + 1].utf8()) {
                    case Some(str value): {
                        out.set(name, value);
                    }
                    case None: {
                    }
                }
            }
            case None: {
            }
        }
        i = i + 2;
    }
    return out;
}

/// End the program now with status `code`, after flushing standard output so
/// nothing already printed is lost.
///
/// The code must be 0 through 255, and anything else traps: the operating
/// system keeps only the low eight bits, so `exit(256)` would report success,
/// which is the one thing a program exiting with a non-zero code cannot have
/// meant. Threads still running are not waited for, which is the difference
/// between this and reaching the end of the program.
pub void exit(int code) {
    if (code < 0 || code > 255) {
        trap("os.exit(" + code.to_str() + "): an exit status is 0 through 255");
    }
    __exit(code);
}
