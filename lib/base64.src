// RFC 4648 base64, in both of its alphabets.
//
// `url: false` is RFC 4648 §4, the standard alphabet (`+` and `/`); `url:
// true` is §5, the URL- and filename-safe alphabet (`-` and `_`). Both are
// padded with `=` in both directions. The alphabet is a flag on the one
// operation rather than a second pair of names, because it is one codec with
// one table swapped, not a second codec.
//
// **The two halves compose**: `decode(encode(b))` is `b` again for every
// `bytes`, in either alphabet.
//
// **`decode` is strict, and there is no lenient mode.** A character outside
// the chosen alphabet, a length that is not a multiple of four, and padding
// that is in the wrong place or of the wrong length are each an `Error` saying
// which it was and at what position. There is no whitespace skipping (base64
// in a header or a JSON string has none, and MIME's 76-column lines are a MIME
// problem: strip them first, in the open) and no guessing the alphabet from
// what arrived -- a `-` handed to the standard decoder is refused, with a
// message pointing at `url: true`, rather than quietly accepted. A decoder
// that accepts more than one spelling of the same octets is one that two
// parsers can disagree about.
//
// One leniency is kept, and it is CPython's: the unused low bits of the last
// character before the padding are not required to be zero, so `"QR=="` and
// `"QQ=="` both decode to the one byte `A`. RFC 4648 §3.5 lets a decoder go either way,
// and a caller who needs the canonical spelling can compare
// `encode(decode(t)) == t`.
//
// --- the types ---------------------------------------------------------------
//
// `encode` takes `bytes` and answers a `str`; `decode` takes a `str` and
// answers `bytes`. What comes out of base64 is text by construction -- sixty-
// five ASCII characters -- bound for a header, a URL or a JSON string, every
// one of which is a `str`. What goes in is octets, and only the caller knows
// whether they were UTF-8, so `decode` hands back octets and `utf8()` is the
// decode, in the open. These are Oro's shapes.
//
// Oro's `encode` also accepts a `str` and takes its UTF-8. Here a parameter
// has one static type, so text is passed as `s.to_bytes()`: one entry point,
// and the crossing from text to octets written where it happens, as it is
// everywhere else `str` meets `bytes` (reference §3.10), rather than a second
// function that differs only in the conversion it hides.

/// Why `decode` refused its input. Every variant carries the position, in
/// bytes from the start of the text, of what was wrong.
pub enum Error {
    /// A byte that is neither in the chosen alphabet nor `=`: its position,
    /// the byte, and whether the URL-safe alphabet was the one asked for.
    Character(int, int, bool);
    /// The text's length, which is not a multiple of four.
    Length(int);
    /// Where the padding starts, and where data follows it.
    PaddingThenData(int, int);
    /// How many padding characters there are, and where they start.
    Padding(int, int);
}

/// A sentence saying what was wrong, and where. A method named `to_str`, so
/// `print(e)` prints it.
pub str Error.to_str() {
    match (this) {
        case Character(int at, int c, bool url): {
            str head = "invalid base64 " + shown(c) + " at position " + at.to_str();
            if (url && (c == '+' || c == '/')) {
                return head + ": that is the standard alphabet, and url: true is the URL-safe one";
            }
            if (!url && (c == '-' || c == '_')) {
                return head + ": that is the URL-safe alphabet, which is url: true";
            }
            return head;
        }
        case Length(int n): {
            return "base64 text length " + n.to_str() + " is not a multiple of 4";
        }
        case PaddingThenData(int pad, int data): {
            return "base64 padding at position " + pad.to_str() + " is followed by data at position " + data.to_str();
        }
        case Padding(int count, int at): {
            return "base64 text ends in " + count.to_str() + " padding characters at position " + at.to_str() + "; at most 2 are allowed";
        }
    }
}

/// `data`, as base64 text.
///
///     base64.encode("user:pass".to_bytes())    == "dXNlcjpwYXNz"
///     base64.encode("é".to_bytes())            == "w6k="
pub str encode(bytes data, bool url = false) {
    List<str> digits = alphabet(url);
    int n = data.size();
    int whole = n - n % 3;
    List<str> out = [];
    int i = 0;
    while (i < whole) {
        int v = data[i] << 16 | data[i + 1] << 8 | data[i + 2];
        out.push(digits[v >> 18]);
        out.push(digits[v >> 12 & 0x3F]);
        out.push(digits[v >> 6 & 0x3F]);
        out.push(digits[v & 0x3F]);
        i = i + 3;
    }
    if (n - whole == 1) {
        int v = data[whole] << 16;
        out.push(digits[v >> 18]);
        out.push(digits[v >> 12 & 0x3F]);
        out.push("==");
    } else if (n - whole == 2) {
        int v = data[whole] << 16 | data[whole + 1] << 8;
        out.push(digits[v >> 18]);
        out.push(digits[v >> 12 & 0x3F]);
        out.push(digits[v >> 6 & 0x3F]);
        out.push("=");
    }
    return out.join("");
}

/// The octets base64 `text` spells.
///
///     base64.decode("dXNlcjpwYXNz")         -> Ok("user:pass".to_bytes())
///     base64.decode("-_8=", url: true)      -> Ok([251, 255])
///
/// The refusals are checked in reading order -- first a character that is not
/// base64 at all, then the length, then the padding -- so the error names the
/// first thing wrong with the input rather than whichever check ran first.
pub Result<bytes, Error> decode(str text, bool url = false) {
    int n = text.size();
    int i = 0;
    while (i < n) {
        int c = text.byte_at(i);
        if (c != '=' && value(c, url) < 0) {
            return Result<bytes, Error>.Err(Error.Character(i, c, url));
        }
        i = i + 1;
    }
    if (n % 4 != 0) {
        return Result<bytes, Error>.Err(Error.Length(n));
    }
    // Everything is now alphabet or `=`, so the first `=` is where the padding
    // starts, and the padding must run from there to the end.
    int data = 0;
    while (data < n && text.byte_at(data) != '=') {
        data = data + 1;
    }
    if (data < n) {
        int after = data;
        while (after < n && text.byte_at(after) == '=') {
            after = after + 1;
        }
        if (after < n) {
            return Result<bytes, Error>.Err(Error.PaddingThenData(data, after));
        }
        if (n - data > 2) {
            return Result<bytes, Error>.Err(Error.Padding(n - data, data));
        }
    }
    int pad = n - data;
    int whole = n;
    if (pad > 0) {
        whole = n - 4;
    }
    bytes out = [];
    i = 0;
    while (i < whole) {
        int v = quad(text, i, 4, url);
        out.push(v >> 16);
        out.push(v >> 8 & 0xFF);
        out.push(v & 0xFF);
        i = i + 4;
    }
    if (pad == 2) {
        int v = quad(text, whole, 2, url);
        out.push(v >> 16);
    } else if (pad == 1) {
        int v = quad(text, whole, 3, url);
        out.push(v >> 16);
        out.push(v >> 8 & 0xFF);
    }
    return Result<bytes, Error>.Ok(out);
}

// The first `count` characters of the group at `at`, packed six bits each
// from the top: `a << 18 | b << 12 | c << 6 | d`, with the missing ones zero.
int quad(str text, int at, int count, bool url) {
    int v = 0;
    int k = 0;
    while (k < 4) {
        v = v << 6;
        if (k < count) {
            v = v | value(text.byte_at(at + k), url);
        }
        k = k + 1;
    }
    return v;
}

// The six-bit value of byte `c` in the chosen alphabet, or -1 if it is not
// in it: A-Z are 0-25, a-z 26-51, 0-9 52-61, and the two alphabets differ
// only in 62 and 63 -- `+ /` for the standard one, `- _` for the URL one.
int value(int c, bool url) {
    if (c >= 'A' && c <= 'Z') {
        return c - 65;
    }
    if (c >= 'a' && c <= 'z') {
        return c - 71;
    }
    if (c >= '0' && c <= '9') {
        return c + 4;
    }
    if (url && c == '-' || !url && c == '+') {
        return 62;
    }
    if (url && c == '_' || !url && c == '/') {
        return 63;
    }
    return -1;
}

// The sixty-four digits of the chosen alphabet, one str each. Written out
// rather than assembled, because they are quotations: a reader checking this
// against RFC 4648's tables should read the same characters in both places.
List<str> alphabet(bool url) {
    str chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    if (url) {
        chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
    }
    List<str> out = [];
    int i = 0;
    while (i < 64) {
        out.push(chars.substr(i, i + 1));
        i = i + 1;
    }
    return out;
}

// A byte as a message names it: the character, quoted, if it is printable
// ASCII, and its value in hex if it is not -- a byte of a multi-byte UTF-8
// character is not a character on its own. One printable ASCII byte is always
// valid UTF-8, so the `or` is never taken.
str shown(int c) {
    bytes one = [c];
    if (c >= ' ' && c <= '~') {
        return "character '" + one.utf8().or("?") + "'";
    }
    return "byte 0x" + one.hex();
}
