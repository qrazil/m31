// TCP: connections, listeners and the addresses they are made of.
//
// API
// ---
//   net.connect(host, port)          -> Result<Conn, Error>
//   net.listen(host, port, backlog:) -> Result<Listener, Error>
//
//   c.read(n)                  -> Result<bytes, io.Error>  1..n bytes; empty at the end
//   c.read_all()               -> Result<bytes, io.Error>  everything until the peer stops
//   c.read_until(delim, limit) -> Result<bytes, io.Error>  through `delim`, at most `limit`
//   c.write(b)                 -> Result<int, io.Error>    all of `b`
//   c.write_some(b)            -> Result<int, io.Error>    one attempt; what was taken
//   c.close()                  -> Result<bool, io.Error>
//   c.peer()                   -> Addr                     who is at the other end
//   c.shutdown_write()         -> Result<bool, Error>      half-close: send an end of file
//   c.set_read_timeout(ms), c.set_write_timeout(ms)        0 clears; expiry is TimedOut
//   c.set_nodelay(on)          -> Result<bool, Error>      send small writes at once
//   c.wait(timeout_ms)         -> Result<bool, Error>      false if nothing arrived in time
//
//   ln.accept()                -> Result<Conn, Error>
//   ln.local()                 -> Addr                     the port a bind to 0 got
//   ln.wait(timeout_ms)        -> Result<bool, Error>
//   ln.close()                 -> Result<bool, Error>
//
//   net.parse_ip(text)         -> Option<Ip>    a literal address, v4 or v6
//   ip.to_str(), ip.is_v6(), ip.octets()
//   net.Addr: a.ip(), a.port(), a.to_str()
//
//   net.Error                  enum             why a connection could not be made
//   e.to_str(), e.is_transient()                  the sentence; may an accept loop go on
//   net.from_errno(e), net.error_of(io_error)
//
// **A `Conn` is an `io.Stream`.** Its first five methods are exactly the five
// `io.Stream` declares, with the same shapes, so `io.copy(conn, file)`,
// `io.read_line_of(conn, 8192)` and anything else written against a stream
// take a socket with no new code -- and an `io.Buffer` stands in for one in a
// test. That is also why those five answer with `io.Error` and not with this
// module's `Error`: see "Two error types" below.
//
// **A timeout is where that promise is cashed.** `io.Stream` says a read
// that fails has consumed nothing and a write that fails has written an
// unknown amount, and a socket is the type those two rules were written
// for: a read timeout is an ordinary, expected failure of a read that had
// already collected half a message, and a send timeout is an ordinary,
// expected failure of a write that had already put megabytes on the wire.
// So `read`, `read_all` and `read_until` put back what they took -- the
// retry gets the whole message, not the tail of it -- and `write` says so
// loudly and offers `write_some` to anyone who has to keep count.
//
// Everything here is language source down to one system call per primitive
// (runtime/sys.h, docs/sys-layer.md §9): the address parser and printer, the
// read buffer, the short-write loop, the retry on EINTR, SO_REUSEADDR's
// default, and what every errno means. A primitive answers a value or -errno
// and decides nothing.
//
// **Every socket this module makes is non-blocking** (`socket_for`), and
// every wait on one -- a connect finishing, more to read, room to write, a
// connection to accept -- goes through `__wait_io`, which parks the green
// thread on the epoll reactor instead of blocking the carrier OS thread on
// the syscall (docs/concurrency-decision.md's whole argument for `spawn`
// meaning a green thread). A bounded wait -- a `set_read_timeout`/
// `set_write_timeout` deadline, or `wait(ms)` -- goes through
// `__wait_io_timeout`, which parks the green thread the same way and adds a
// deadline kept by the reactor, so a silent peer holds no carrier for its
// timeout (docs/net-timeouts-decision.md).
//
// What is deliberately not here: UDP, Unix sockets, TLS, a connect timeout,
// and name resolution beyond "the first address the resolver gave". Each is
// noted where it would have gone.

import io;

// A socket is a descriptor, so reading, writing and closing one are `io`'s
// primitives and not new ones (docs/sys-layer.md §9). They are re-declared
// here rather than reached through `io` because a `prim` is a declaration
// like any other and `__` names are each module's own; both declarations
// lower to the same `rt_read`, `rt_write` and `rt_close`.
prim int __read(int file_descriptor, bytes buffer, int off, int byte_count);
prim int __write(int file_descriptor, bytes buffer, int off, int byte_count);
prim int __close(int file_descriptor);
// Like `__read`, but `out` is filled rather than written into: the read
// lands in a scratch buffer the runtime keeps per carrier, and `out` (an
// empty `bytes` the caller passes) ends up holding exactly the bytes that
// arrived, not padded to `max_n`. Lets `Conn.fill` stop keeping a whole
// CHUNK alive for every connection's whole lifetime -- see its own comment.
prim int __read_chunk(int file_descriptor, int max_n, bytes out);
// `kind` and not `type`, which docs/sys-layer.md §9 writes and this language
// reserves (§1.4). The C side is one symbol and one order of arguments, so
// only the spelling of the name moves.
prim int __socket(int domain, int kind, int protocol);
prim int __listen(int file_descriptor, int backlog);
prim int __shutdown(int file_descriptor, int how);
prim int __bind(int file_descriptor, int family, int port, bytes addr);
prim int __connect(int file_descriptor, int family, int port, bytes addr);
prim int __accept(int file_descriptor, List<int> out, bytes addr);
prim int __sockname(int file_descriptor, int peer, List<int> out, bytes addr);
prim int __setsockopt(int file_descriptor, int opt, int value);
prim int __getsockopt(int file_descriptor, int opt);
prim int __resolve(str host, int port, int family, List<int> out, bytes addrs);
prim int __ignore_sigpipe();
// Park the current green thread until `file_descriptor` is ready for `events`
// (IO_READABLE/IO_WRITABLE below), instead of blocking the carrier on the
// syscall itself -- the epoll reactor's seam (runtime/reactor.h), through
// the scheduler's park/unpark (docs/concurrency-decision.md, Phase 3).
// Always succeeds (0) or traps on a genuine caller bug; it is the UNBOUNDED
// wait. The bounded one is `__wait_io_timeout`.
prim int __wait_io(int file_descriptor, int events);
// `__wait_io` with a deadline, and the same parking: only the green thread
// waits, the carrier goes on running others. Answers 0 when `file_descriptor` became ready
// for `events` (an error or hang-up counts: a read or write will not block),
// 1 when `timeout_ms` ran out first, or -errno when the fd cannot be waited
// on (a closed or invalid one). `timeout_ms` of 0 is a poll that never
// waits; negative waits without a deadline, like `__wait_io`.
prim int __wait_io_timeout(int file_descriptor, int events, int timeout_ms);

// The sys layer's own constants (runtime/sys.h), written here as numbers for
// exactly the reason `io` writes the open flags as numbers: they are the
// LAYER's constants and not the host's, so 10 means IPv6 on every target and
// a number here cannot drift from a header somewhere else.
const int AF_INET = 2;
const int AF_INET6 = 10;
const int SOCK_STREAM = 1;
const int SO_REUSEADDR = 1;
const int SO_ERROR = 3;
const int SO_RCVTIMEO = 4;
const int SO_SNDTIMEO = 5;
const int TCP_NODELAY = 6;
const int SO_NONBLOCK = 7;
const int SHUT_WR = 1;
// `__wait_io`'s and `__wait_io_timeout`'s event bits (runtime/reactor.h's
// RT_REACTOR_READ/WRITE), which are the layer's own and not the kernel's
// poll(2) bits.
const int IO_READABLE = 1;
const int IO_WRITABLE = 2;
// errno numbers this module checks for by name rather than leaving as a
// bare number at the call site, now that making every socket non-blocking
// means these two are checked often (runtime/sys.h).
const int EAGAIN = 11;
const int EINPROGRESS = 115;
// How much of a connection is read from the kernel at once, and the size of
// a `Conn`'s buffer: the same 64 KiB `io.File` reads a file in.
const int CHUNK = 65536;
// For the hex groups of an IPv6 address. A literal is immortal (§7.3), so
// indexing into one allocates nothing.
const str HEX = "0123456789abcdef";

/// Why a connection could not be made, or could not go on.
///
/// The named variants are the failures a caller plausibly branches on --
/// a server that is not running, a network that cannot be reached, a port
/// already taken -- and `Other(int)` is what keeps the enum from ever having
/// to grow: `match` is exhaustive and has no default, so a new variant would
/// break every program that handles a network error. The number in `Other`
/// is a Linux errno on every host, as `io.Error`'s is.
///
/// ### Two error types, and where the line is
///
/// **The five methods `io.Stream` declares answer with `io.Error`.
/// Everything else `net` offers answers with this one.** That is not a
/// hedge; it is forced, and it is the right force. An interface is its
/// signatures (reference §3.4), so a `read` that answered with `net.Error`
/// would not satisfy `io.Stream` -- `io.copy` and `io.read_line_of` could
/// not take a socket at all, and the whole point of a connection being a
/// stream would be gone. Reusing `io.Error` for the *rest* of the module was
/// the other way out and is worse: `connect` would report a refused
/// connection as `Other(111)`, and "connection refused" is the single most
/// branched-on outcome in this module.
///
/// The seam between the two is exact rather than lossy, which is what makes
/// it liveable. Every errno a socket produces -- ECONNRESET, EPIPE,
/// ETIMEDOUT, EAGAIN -- is one `io.from_errno` does not name, so it arrives
/// through a stream method as `io.Error.Other(n)` carrying the number, and
/// `net.error_of(e)` turns it back into the variant here. Nothing is lost on
/// the way.
///
/// The third option, adding these six variants to `io.Error`, is the one
/// that would give a program a single vocabulary, and it is not this
/// module's to take: it breaks every exhaustive `match` on `io.Error` in
/// every program, which docs/stdlib-seam.md §4 says is affordable once and
/// spent that once already.
pub enum Error {
    Refused;
    TimedOut;
    Unreachable;
    Reset;
    InUse;
    NameNotFound;
    OutOfDescriptors;
    Aborted;
    Other(int);
}

/// A sentence saying what went wrong, so `print(e)` prints it.
pub str Error.to_str() {
    match (this) {
        case Refused: {
            return "connection refused";
        }
        case TimedOut: {
            return "timed out";
        }
        case Unreachable: {
            return "network unreachable";
        }
        case Reset: {
            return "the connection was broken by the peer";
        }
        case InUse: {
            return "the address is already in use";
        }
        case NameNotFound: {
            return "no such host";
        }
        case OutOfDescriptors: {
            return "out of file descriptors";
        }
        case Aborted: {
            return "the connection was aborted before it was accepted";
        }
        case Other(int code): {
            // ENOSYS from this module means one thing and it is worth
            // saying: the raw system call backend cannot resolve names --
            // not "has not got round to it", cannot, because resolving is
            // getaddrinfo and getaddrinfo dlopens the NSS modules
            // (docs/sys-layer.md §9). A program that must run on both
            // backends connects to a literal address, and this message is
            // how it finds that out rather than by reading the runtime.
            if (code == 38) {
                return "this build cannot resolve host names; use a literal IP address";
            }
            return "system error " + code.to_str();
        }
    }
}

/// Whether the failure belongs to the moment and not to the call: the
/// listener or the connection that produced it is still good, and the same
/// call may succeed shortly.
///
/// **This is the answer to "may a server loop carry on after a failed
/// `accept`?"** -- `true` for exactly the failures accept(2) says to treat
/// like "try again": out of descriptors, a connection aborted in the
/// backlog, and the kernel short of memory or buffers (`ENOMEM`, `ENOBUFS`),
/// a network that went away (`Unreachable`, `ENETDOWN`, `EHOSTDOWN`,
/// `ENONET`), a protocol error on one connection (`EPROTO`), one the firewall
/// refused (`EPERM`) and an operation the connection's protocol lacked
/// (`ENOPROTOOPT`, `EOPNOTSUPP`). Everything else -- a closed or invalid
/// listener above all -- is `false`, and a loop that gets it should stop.
///
/// It is read from `accept`'s point of view. A `connect` that answers
/// `Unreachable` has a different question to ask, and `Refused` and
/// `TimedOut` are deliberately not here for that reason.
///
/// Out of descriptors answers `true` but does not heal by itself: the
/// pending connection stays queued, so an immediate retry fails the same
/// way. A loop that carries on should pause before it asks again.
pub bool Error.is_transient() {
    match (this) {
        case OutOfDescriptors: {
            return true;
        }
        case Aborted: {
            return true;
        }
        case Unreachable: {
            return true;
        }
        case Refused: {
            return false;
        }
        case TimedOut: {
            return false;
        }
        case Reset: {
            return false;
        }
        case InUse: {
            return false;
        }
        case NameNotFound: {
            return false;
        }
        case Other(int code): {
            // ENOMEM, ENOBUFS, EPROTO, EPERM, ENETDOWN, EHOSTDOWN, ENONET,
            // ENOPROTOOPT, EOPNOTSUPP.
            return code == 12 || code == 105 || code == 71 || code == 1 || code == 100 || code == 112 || code == 64 || code == 92 || code == 95;
        }
    }
}

/// The `Error` for a Linux errno -- positive, as errno is written; a
/// primitive's `r < 0` is `from_errno(-r)`.
///
/// Public because a program that holds a raw errno from somewhere else
/// should reach the same vocabulary, and because `error_of` is written on
/// top of it.
pub Error from_errno(int error_number) {
    if (error_number == 111) {
        return Error.Refused;
    }
    // ETIMEDOUT is the kernel giving up on a connection; EAGAIN reaching
    // here at all means `wait_read_timeout`/`wait_write_timeout` bounded the
    // wait (a timeout was set) and it ran out -- every socket
    // this module hands out is non-blocking, so an EAGAIN this module does
    // not otherwise retry on its own (the unbounded, no-timeout case never
    // surfaces one: it parks until ready instead) means exactly that. They
    // are one outcome to a caller either way -- "it did not happen in time"
    // -- so they are one variant.
    if (error_number == 110 || error_number == 11) {
        return Error.TimedOut;
    }
    if (error_number == 101 || error_number == 113) {
        return Error.Unreachable;
    }
    // ECONNRESET and EPIPE are the same event seen from the two sides: the
    // peer is gone. Which one the kernel picks depends on whether this end
    // was reading or writing when it found out, which is not something to
    // make a caller branch on.
    if (error_number == 104 || error_number == 32) {
        return Error.Reset;
    }
    if (error_number == 98) {
        return Error.InUse;
    }
    // ENFILE and EMFILE: the system's table or this process's is full. Named
    // because it is the failure an `accept` loop must survive -- the
    // connection that could not be accepted is still queued, and descriptors
    // come back as other connections close.
    if (error_number == 23 || error_number == 24) {
        return Error.OutOfDescriptors;
    }
    // ECONNABORTED: the peer gave up while its connection sat in the backlog.
    if (error_number == 103) {
        return Error.Aborted;
    }
    // ENOENT is what the layer answers when a name has no address
    // (runtime/sys_libc.c maps EAI_NONAME to it).
    if (error_number == 2) {
        return Error.NameNotFound;
    }
    return Error.Other(error_number);
}

/// The `net.Error` for an `io.Error` that came off a `Conn`.
///
/// Exact for everything a socket can produce: those errnos are all ones
/// `io.from_errno` leaves in `Other`, so the number is still there to read.
/// The named `io.Error` variants below it are file failures a socket does
/// not have, and each is mapped to the errno it stands for so that nothing
/// silently becomes a different error.
pub Error error_of(io.Error error) {
    match (error) {
        case Other(int code): {
            return from_errno(code);
        }
        case NotFound: {
            return Error.NameNotFound;
        }
        case PermissionDenied: {
            return Error.Other(13);
        }
        case IsDirectory: {
            return Error.Other(21);
        }
        case NotADirectory: {
            return Error.Other(20);
        }
        case AlreadyExists: {
            return Error.Other(17);
        }
        case NotEmpty: {
            return Error.Other(39);
        }
        case InvalidUtf8: {
            // EILSEQ, which is what "these octets are not the text they were
            // supposed to be" is called everywhere else.
            return Error.Other(84);
        }
    }
}

// --- addresses -------------------------------------------------------------
/// An IP address: four octets or sixteen, in wire order.
///
/// **The size is the family.** There is no separate tag, because a tag and a
/// length are two facts that can disagree and this way there is only one:
/// `is_v6()` asks the `bytes` how long it is. Wire order means 127.0.0.1 is
/// the octets 127, 0, 0, 1 -- already what the kernel wants, and already
/// what the text form is written in, so neither the parser, the printer nor
/// the sys layer swaps anything (runtime/sys.h).
///
/// The field is private and no method changes it, so an `Ip` is effectively
/// immutable; `octets()` hands back a copy so that holding the octets cannot
/// reach back into the address they came from.
///
/// Made by `parse_ip`, or handed over by a `Conn` or a `Listener`.
pub type Ip {
    bytes raw;
}

/// Whether this is an IPv6 address.
pub bool Ip.is_v6() {
    return raw.size() == 16;
}

/// The address bytes, in wire order: four of them, or sixteen.
pub bytes Ip.octets() {
    return clone(raw);
}

/// Two addresses are the same when their octets are. An IPv4 address and the
/// IPv4-mapped IPv6 address that carries it are **not** equal here, because
/// they are not the same address: one names a host over IPv4 and the other
/// names it over IPv6, and a program that treats them as one will bind the
/// wrong socket. Python's `ipaddress` draws it the same way.
pub bool Ip.eq(Ip other) {
    return raw == other.raw;
}

/// The text form, which `parse_ip` reads back exactly.
///
/// IPv4 is the dotted quad. IPv6 is **RFC 5952**: lowercase, no leading
/// zeros in a group, and the longest run of two or more zero groups replaced
/// by `::` -- the leftmost when two runs tie. One zero group is never
/// compressed, because `::` standing for a single group is longer to read
/// and no shorter to write. That is the same canonical form Python's
/// `ipaddress` prints, which is how the corpus checks this.
///
/// There is no IPv4-mapped spelling: `::ffff:1.2.3.4` prints as
/// `::ffff:102:304`, again as Python does. A second text form for one
/// address is a second thing a round trip has to be true of.
pub str Ip.to_str() {
    if (raw.size() == 4) {
        return raw[0].to_str() + "." + raw[1].to_str() + "." + raw[2].to_str() + "." + raw[3].to_str();
    }
    List<int> groups = [];
    int byte_index = 0;
    while (byte_index < 16) {
        groups.push(raw[byte_index] * 256 + raw[byte_index + 1]);
        byte_index = byte_index + 2;
    }
    // The longest run of zero groups, leftmost on a tie -- `>` and not `>=`
    // is what makes it leftmost.
    int best = -1;
    int best_length = 0;
    int group_index = 0;
    while (group_index < 8) {
        if (groups[group_index] != 0) {
            group_index = group_index + 1;
        } else {
            int run_end = group_index;
            while (run_end < 8 && groups[run_end] == 0) {
                run_end = run_end + 1;
            }
            if (run_end - group_index > best_length) {
                best_length = run_end - group_index;
                best = group_index;
            }
            group_index = run_end;
        }
    }
    if (best_length < 2) {
        best = -1;
        best_length = 0;
    }
    str out = "";
    group_index = 0;
    while (group_index < 8) {
        if (group_index == best) {
            // The two colons of `::` are this run's own separators, so the
            // group after it must not add a third -- which is what the
            // `k != best + best_len` below says.
            out = out + "::";
            group_index = group_index + best_length;
        } else {
            if (group_index > 0 && group_index != best + best_length) {
                out = out + ":";
            }
            out = out + hex16(groups[group_index]);
            group_index = group_index + 1;
        }
    }
    return out;
}

// One group as lowercase hex with no leading zeros. Written out rather than
// built from `bytes.hex()`, which pads each octet to two digits and would
// print `2001:0db8` where RFC 5952 asks for `2001:db8`.
str hex16(int group) {
    if (group == 0) {
        return "0";
    }
    str out = "";
    int shift = 12;
    while (shift >= 0) {
        int digit = group >> shift & 15;
        if (digit != 0 || out.size() > 0) {
            out = out + HEX.substr(digit, digit + 1);
        }
        shift = shift - 4;
    }
    return out;
}

/// An IP address and a port: one end of a connection.
///
/// Made by this module, never by a caller: `Listener.local()` and
/// `Conn.peer()` are where one comes from.
pub type Addr {
    Ip host;
    int number;
}

/// The address half.
pub Ip Addr.ip_address() {
    return host;
}

/// The port, 0..65535.
pub int Addr.port() {
    return number;
}

/// Two ends are the same when both halves are.
pub bool Addr.eq(Addr other) {
    return host == other.host && number == other.number;
}

/// `1.2.3.4:80`, or `[::1]:80` for IPv6.
///
/// The brackets are not decoration: an IPv6 address is full of colons, so
/// without them `::1:80` could be an address with a port or an address
/// without one. Go, curl and the URL syntax itself all bracket it.
pub str Addr.to_str() {
    if (host.is_v6()) {
        return "[" + host.to_str() + "]:" + number.to_str();
    }
    return host.to_str() + ":" + number.to_str();
}

/// A literal IPv4 or IPv6 address, or `None` if the text is not one.
///
/// **It is a literal address and never a host name**: nothing here touches
/// the network or the resolver, so it answers the same on both sys-layer
/// backends and in any sandbox. `connect` is what falls back to a name.
///
/// What is accepted is what Python's `ipaddress` accepts, which the corpus
/// checks against it over a table of ninety-four forms:
///
///   - **IPv4** is exactly four decimal fields of one to three digits, each
///     0..255. A **leading zero is refused** -- `010.1.1.1` is not an
///     address -- because C's `inet_aton` reads a leading zero as octal and
///     most other readers do not, and an address that means two things has
///     been a security advisory more than once. Go and Python both refuse
///     it; the BSD libc does not.
///   - **IPv6** is eight groups of one to four hex digits, upper or lower
///     case, with at most one `::` standing for one or more groups of zeros,
///     and optionally a dotted quad in place of the last two groups
///     (`::ffff:1.2.3.4`).
///   - A **zone id** (`fe80::1%eth0`) is refused, and this is the one place
///     this parser is stricter than Python. A zone is an interface index or
///     name, which means it is only meaningful on the host that wrote it and
///     the sys layer has nowhere to put it (`SysAddr` has no scope field).
///     Accepting text this module would then have to throw away would be
///     worse than refusing it.
///
/// Surrounding space is not trimmed, `[::1]` is not an address (that is a
/// URL authority), and the empty string is not one either.
pub Option<Ip> parse_ip(str text) {
    if (text.contains(":")) {
        return parse_v6(text);
    }
    return parse_v4(text);
}

// The dotted quad. Also used for the tail of an IPv6 address, where it is
// handed the whole of what is left and must consume all of it.
Option<Ip> parse_v4(str text) {
    int text_length = text.size();
    int index = 0;
    int fields = 0;
    bytes out = [];
    while (fields < 4) {
        int start = index;
        int field_value = 0;
        // At most three digits, so `field_value` cannot pass 999 and the 0..255 test
        // below cannot be reached by overflow.
        while (index < text_length && index - start < 3 && is_digit(text.byte_at(index))) {
            field_value = field_value * 10 + text.byte_at(index) - 48;
            index = index + 1;
        }
        int length = index - start;
        if (length == 0 || field_value > 255) {
            return Option<Ip>.None;
        }
        // `010` is ten here and eight to anything that reads it as octal.
        if (length > 1 && text.byte_at(start) == '0') {
            return Option<Ip>.None;
        }
        out.push(field_value);
        fields = fields + 1;
        if (fields < 4) {
            if (index >= text_length || text.byte_at(index) != '.') {
                return Option<Ip>.None;
            }
            index = index + 1;
        }
    }
    // Four fields and nothing after them: a trailing dot, a fifth field or
    // a space is not an address.
    if (index != text_length) {
        return Option<Ip>.None;
    }
    return Option<Ip>.Some(Ip(out));
}

// The hex-group form. Groups are collected as they are read and the `::` is
// remembered as the index it stood at, so the zeros are filled in once at
// the end where the total is known -- there is no other point at which how
// many groups it stands for is knowable.
Option<Ip> parse_v6(str text) {
    int text_length = text.size();
    List<int> groups = [];
    int ell = -1;
    int index = 0;
    // A leading colon is only ever the first colon of a leading `::`. Dealt
    // with here so that the loop below can assume every group has a group
    // before it or is the first.
    if (text.byte_at(0) == ':') {
        if (text_length < 2 || text.byte_at(1) != ':') {
            return Option<Ip>.None;
        }
        index = 2;
        ell = 0;
    }
    while (index < text_length) {
        // Nine groups is not an address however the ninth is spelled, and
        // stopping here keeps the list from growing on hostile input.
        if (groups.size() >= 8) {
            return Option<Ip>.None;
        }
        int start = index;
        int group_value = 0;
        while (index < text_length && index - start < 4 && hex_value(text.byte_at(index)) >= 0) {
            group_value = group_value * 16 + hex_value(text.byte_at(index));
            index = index + 1;
        }
        if (index == start) {
            return Option<Ip>.None;
        }
        if (index < text_length && text.byte_at(index) == '.') {
            // A dot: the group just read was the first field of a dotted
            // quad, so the whole tail from where it started is one, and it
            // fills the last two groups. `groups` may reach nine this way, which
            // the count at the end refuses.
            match (parse_v4(text.substr(start, text_length))) {
                case Some(Ip four): {
                    bytes octets = four.raw;
                    groups.push(octets[0] * 256 + octets[1]);
                    groups.push(octets[2] * 256 + octets[3]);
                    index = text_length;
                }
                case None: {
                    return Option<Ip>.None;
                }
            }
        } else {
            groups.push(group_value);
            if (index < text_length) {
                if (text.byte_at(index) != ':') {
                    return Option<Ip>.None;
                }
                index = index + 1;
                // A colon at the very end is a group that never came.
                if (index >= text_length) {
                    return Option<Ip>.None;
                }
                if (text.byte_at(index) == ':') {
                    if (ell >= 0) {
                        return Option<Ip>.None;
                    }
                    ell = groups.size();
                    index = index + 1;
                }
            }
        }
    }
    int have = groups.size();
    if (ell < 0) {
        if (have != 8) {
            return Option<Ip>.None;
        }
    } else if (have >= 8) {
        // `::` stands for AT LEAST one group of zeros, so eight groups plus
        // an ellipsis is not an address -- `::1:2:3:4:5:6:7:8` is refused,
        // while `1:2:3:4:5:6:7::` is the same address as `...:7:0`.
        return Option<Ip>.None;
    }
    int fill = 8 - have;
    bytes out = [];
    for (int group_index in 0 .. 8) {
        int group_value = 0;
        if (ell < 0 || group_index < ell) {
            group_value = groups[group_index];
        } else if (group_index >= ell + fill) {
            group_value = groups[group_index - fill];
        }
        out.push(group_value >> 8);
        out.push(group_value & 255);
    }
    return Option<Ip>.Some(Ip(out));
}

bool is_digit(int character) {
    return character >= 48 && character <= 57;
}

// A hex digit's value, or -1 for anything else -- which is how the parsers
// above tell "the group ended" from "the group had a digit".
int hex_value(int character) {
    if (character >= 48 && character <= 57) {
        return character - 48;
    }
    if (character >= 97 && character <= 102) {
        return character - 87;
    }
    if (character >= 65 && character <= 70) {
        return character - 55;
    }
    return -1;
}

// --- connections -----------------------------------------------------------
/// One end of a TCP connection.
///
/// **It is an `io.Stream`**: `read`, `read_all`, `read_until`, `write` and
/// `close`, with a `File`'s signatures and a `File`'s meanings, so code
/// written against the protocol cannot tell a socket from a file. Reads are
/// buffered 64 KiB at a time, as a `File`'s are; writes are not, so there is
/// no `flush` to forget. `write_some` is a sixth method and deliberately
/// not in the interface, for the reason `io.Stream` gives; a `File` and an
/// `io.Buffer` have it too, so code that needs it is still written once.
///
/// **A `Conn` closes itself when its last reference goes** -- at the end of
/// a scope, on a `return` or a `?` that leaves it -- so no path leaks a
/// descriptor. That close is silent: a writer that needs to know whether the
/// close failed calls `close()` and looks (docs/destructors-decision.md).
///
/// Every field is private: a `Conn` comes from `connect` or `accept`, and
/// only its own methods move its buffer.
pub type Conn {
    int descriptor;
    Addr remote;
    bool is_live = true;
    // Allocated on the first read, so a connection only ever written to
    // costs nothing. buf[at .. end] has arrived and not been handed out.
    bytes buffer = [];
    int position = 0;
    int end = 0;
    // 0 means "wait forever" (the default). The fd is always non-blocking
    // (socket_for), so these can no longer be a kernel SO_RCVTIMEO/SNDTIMEO
    // -- a non-blocking read never waits in the kernel for one to expire --
    // and are instead consulted by `fill`/`write`/`write_some` themselves:
    // 0 waits for readiness via `__wait_io` (parks, no carrier blocked,
    // no bound), and anything else waits via `__wait_io_timeout` for at most
    // that many milliseconds -- parked the same way, with a deadline.
    int read_timeout_ms = 0;
    int write_timeout_ms = 0;
}

/// Between 1 and `byte_count` bytes, or an empty `bytes` once the peer has stopped
/// sending.
///
/// **It may return fewer than `byte_count` without the connection being over** --
/// more than on a file, in fact: `byte_count` is a maximum and the answer is what has
/// arrived. Code that needs everything calls `read_all`, and code that needs
/// a specific amount loops. `byte_count` below 1 traps, so an empty result has one
/// meaning.
pub Result<bytes, io.Error> Conn.read(int byte_count) {
    if (byte_count < 1) {
        trap("read(" + byte_count.to_str() + "): read at least one byte; read_all() reads everything");
    }
    if (position == end) {
        if (fill()? == 0) {
            bytes none = [];
            return Result<bytes, io.Error>.Ok(none);
        }
    }
    int take = end - position;
    if (take > byte_count) {
        take = byte_count;
    }
    bytes out = buffer.substr(position, position + take);
    position = position + take;
    return Result<bytes, io.Error>.Ok(out);
}

/// Everything until the peer shuts down its writing end.
///
/// There is no size hint to ask for, unlike `io.File.read_all`: a connection
/// has no length, and the only way to learn it is over. A peer that never
/// closes therefore never returns from here, which is why a server reads
/// with `read_until` and a limit instead.
///
/// **A failure keeps what had arrived.** With a read timeout set, that is
/// the normal way out of this call -- the peer is slow, not finished -- and
/// everything collected so far goes back into the connection's buffer
/// before the error is handed out. Calling it again after more has arrived
/// answers with the whole thing, from the first byte.
pub Result<bytes, io.Error> Conn.read_all() {
    check_live();
    bytes out = [];
    if (position < end) {
        out = buffer.substr(position, end);
        position = end;
    }
    while (fill_keeping(out)? > 0) {
        if (end == buffer.size()) {
            out.extend(buffer);
        } else {
            out.extend(buffer.substr(0, end));
        }
        position = end;
    }
    return Result<bytes, io.Error>.Ok(out);
}

/// Bytes up to and including the first `delim`, reading no more than
/// `limit` of them.
///
/// The three outcomes are `io.File`'s and are told apart the same way: it
/// ends with `delim`; it is `limit` long and does not (no delimiter within
/// the limit -- call again for the rest); or it is shorter and does not (the
/// peer stopped first; empty means it had already). The limit is what makes
/// this safe on a connection nobody controls -- without one, a client that
/// never sends a newline is a request for all of memory, which is a way to
/// take a server down from the outside.
///
/// **A failure keeps the part of the line that had arrived.** A read
/// timeout with half a request in hand puts that half back in the
/// connection's buffer, so the call that follows it reads the request
/// whole. That is what makes "wait 200 ms, then do something else, then try
/// again" a correct way to write a server rather than a way to lose the
/// first half of every slow request.
///
/// An empty `delim` or a `limit` below 1 traps.
pub Result<bytes, io.Error> Conn.read_until(bytes delim, int limit) {
    if (delim.size() == 0) {
        trap("read_until: the delimiter is empty");
    }
    if (limit < 1) {
        trap("read_until(" + limit.to_str() + "): the limit must be at least 1");
    }
    int last = delim[delim.size() - 1];
    bytes out = [];
    while (out.size() < limit) {
        if (position == end) {
            if (fill_keeping(out)? == 0) {
                break;
            }
        }
        int byte_value = buffer[position];
        position = position + 1;
        out.push(byte_value);
        if (byte_value == last && out.ends_with(delim)) {
            break;
        }
    }
    return Result<bytes, io.Error>.Ok(out);
}

/// Write all of `data`, returning its size.
///
/// "All" is the promise, and on a socket it is the promise that earns its
/// keep: a kernel takes a large write in pieces whenever the connection's
/// send buffer is fuller than what is offered, so a short write is the
/// normal case rather than the strange one. The loop that hands it the rest
/// is here so that no caller writes one.
///
/// A write to a peer that has gone away is `Err` -- EPIPE, which
/// `net.error_of` calls `Reset` -- and not a dead process, because the
/// module ignores SIGPIPE when it makes a socket (docs/sys-layer.md §2).
///
/// **`Err` means an unknown number of bytes reached the peer**, and on a
/// socket that is not a corner case: set a send timeout, write eight
/// megabytes to a peer that is not reading, and the `TimedOut` that comes
/// back can sit on top of megabytes the peer already has. The count cannot
/// come with it -- a `Result` holds a count or a cause, and unlike a failed
/// read there is nothing to put back, the bytes are the peer's now -- so
/// this error means **the connection is finished**: `close()` it. Writing
/// again would resume in the middle of a record the peer has half of, and
/// a protocol that does that desynchronises without anyone noticing, which
/// is the failure this doc exists to prevent. A caller that must stay on
/// the connection uses `write_some` and keeps the offset itself.
pub Result<int, io.Error> Conn.write(bytes data) {
    if (!is_live) {
        trap("write on a closed connection");
    }
    int off = 0;
    while (off < data.size()) {
        int written = __write(descriptor, data, off, data.size() - off);
        // A signal that arrives before anything was written is not a
        // failure of the connection, so it is not reported.
        if (written == -4) {
            continue;
        }
        if (written == -EAGAIN) {
            bool is_timed_out = wait_write_timeout()?;
            if (is_timed_out) {
                return Result<int, io.Error>.Err(io.from_errno(EAGAIN));
            }
            continue;
        }
        if (written < 0) {
            return Result<int, io.Error>.Err(io.from_errno(-written));
        }
        // A write of nothing makes no progress and never will; calling it
        // an I/O error beats looping forever.
        if (written == 0) {
            return Result<int, io.Error>.Err(io.from_errno(5));
        }
        off = off + written;
    }
    return Result<int, io.Error>.Ok(off);
}

/// One attempt at sending `data`: how many bytes the kernel took, at least 1
/// and at most `b.size()`. An empty `data` sends nothing and is 0.
///
/// `write` with the loop taken out, and the whole point is what the error
/// now means: **`Err` from here is "nothing was sent"**, never "some of it
/// was". A send that is cut short by `SO_SNDTIMEO` after moving any bytes
/// at all returns their count, not an error (`man 7 socket`), so the two
/// answers do not overlap and a sender always knows its offset:
///
///     int off = 0;
///     while (off < b.size()) {
///         off = off + c.write_some(b.substr(off, b.size()))?;
///     }
///
/// which is `write`, except that the caller holding `off` can stop, wait,
/// poll with `wait`, give up on this record and resume on the next one --
/// anything but guess. That is the resync `write`'s `Err` cannot offer.
///
/// A signal that arrives before any byte was sent is retried here, as in
/// `write`, so it is not one of the errors either.
pub Result<int, io.Error> Conn.write_some(bytes data) {
    if (!is_live) {
        trap("write on a closed connection");
    }
    if (data.size() == 0) {
        return Result<int, io.Error>.Ok(0);
    }
    while (true) {
        int written = __write(descriptor, data, 0, data.size());
        if (written == -4) {
            continue;
        }
        if (written == -EAGAIN) {
            bool is_timed_out = wait_write_timeout()?;
            if (is_timed_out) {
                return Result<int, io.Error>.Err(io.from_errno(EAGAIN));
            }
            continue;
        }
        if (written < 0) {
            return Result<int, io.Error>.Err(io.from_errno(-written));
        }
        // A write of nothing makes no progress and never will; calling it
        // an I/O error beats a caller looping on a zero forever.
        if (written == 0) {
            return Result<int, io.Error>.Err(io.from_errno(5));
        }
        return Result<int, io.Error>.Ok(written);
    }
}

/// Close the connection. Closing twice is not an error; any other use of a
/// closed `Conn` traps.
///
/// It returns a `Result` because a close is where a connection reports what
/// it could not deliver, and because `io.Stream` says so. It is never
/// retried on EINTR: on Linux the descriptor is already gone by then, and a
/// retry could close one another thread has just been given.
pub Result<bool, io.Error> Conn.close() {
    return release();
}

// What `close()` and the destructor share, so the same rules hold for both.
// A separate name because the destructor cannot call `close()` bare -- that
// also names the channel builtin, which the language refuses as ambiguous.
Result<bool, io.Error> Conn.release() {
    if (!is_live) {
        return Result<bool, io.Error>.Ok(true);
    }
    is_live = false;
    bytes none = [];
    buffer = none;
    position = 0;
    end = 0;
    int status = __close(descriptor);
    if (status < 0 && status != -4) {
        return Result<bool, io.Error>.Err(io.from_errno(-status));
    }
    return Result<bool, io.Error>.Ok(true);
}

// The destructor: close whatever `close()` was not called on. Its error is
// discarded because a destructor has nobody to hand one to; `close()` is how
// a program sees it.
void Conn.drop() {
    Result<bool, io.Error> ignored = release();
}

/// Who is at the other end.
///
/// Recorded when the connection was made -- `accept` is handed it and
/// `connect` chose it -- so this is a field and not a system call, and it
/// still answers after the peer has gone. There is deliberately no
/// `local()` to go with it: the only local address anyone asks for is a
/// listener's, and `Listener.local()` is that one.
pub Addr Conn.peer() {
    return remote;
}

/// Send the peer an end of file while this side goes on reading: the
/// half-close a client uses to say "that is the whole request" without
/// losing the answer to it.
///
/// After it, the peer's next `read` gives an empty `bytes`, and a `write` on
/// this side fails with `EPIPE` -- an error value, not a trap and not a
/// signal, because this module ignores SIGPIPE. The connection is not
/// closed; this direction of it is over, and reading goes on.
pub Result<bool, Error> Conn.shutdown_write() {
    check_live();
    int status = __shutdown(descriptor, SHUT_WR);
    if (status < 0) {
        return Result<bool, Error>.Err(from_errno(-status));
    }
    return Result<bool, Error>.Ok(true);
}

/// Give up on a read that has waited `timeout_milliseconds` milliseconds; 0 waits forever,
/// which is where a connection starts.
///
/// The expiry arrives as an ordinary failure of the read -- EAGAIN from the
/// kernel, `io.Error.Other(11)` through a stream method, `TimedOut` through
/// `net.error_of` -- and **the bytes that had already arrived are still in
/// the buffer**: a timeout does not lose data, it only stops waiting for
/// more.
///
/// That holds for the reads that collect as they go, too, which is the
/// whole of its value: a `read_until` or a `read_all` that times out having
/// taken four bytes puts those four bytes back, so the next call reads the
/// message from its first byte and not from its fifth, and `wait` answers
/// `true` because they are there to be read. A timeout is therefore "not
/// yet", never "you have lost the start of this".
///
/// It is the socket option and not a deadline over a whole operation, so a
/// `read_all` of a slow peer can take much longer than `timeout_milliseconds` while never
/// waiting that long for one packet.
pub Result<bool, Error> Conn.set_read_timeout(int timeout_milliseconds) {
    return set_ms_read(timeout_milliseconds);
}

/// The same for a write that cannot hand anything to the kernel because the
/// peer is not reading.
///
/// **The read side's promise has no mirror here**, and it is worth knowing
/// before setting this: a `write` stopped by this timeout has already given
/// the peer some unknown prefix of what it was asked to send, and cannot
/// take it back or say how much. So a `Conn` with a write timeout is a
/// `Conn` whose failed `write` must be followed by `close()` -- or one that
/// is written with `write_some`, which reports every byte it moved and
/// fails only when it moved none.
pub Result<bool, Error> Conn.set_write_timeout(int timeout_milliseconds) {
    return set_ms_write(timeout_milliseconds);
}

// The fd is always non-blocking (socket_for), so there is no kernel
// SO_RCVTIMEO/SNDTIMEO to set any more -- a non-blocking read or write
// never waits in the kernel at all, so that option has no effect on it.
// `read_timeout_ms`/`write_timeout_ms` are this module's own replacement,
// consulted by `fill`/`write`/`write_some` on every EAGAIN. Still a
// `Result`, unchanged from before: the signature is part of this module's
// public surface and a caller should not need to change to keep compiling,
// even though setting a local field cannot actually fail any more.
Result<bool, Error> Conn.set_ms_read(int timeout_milliseconds) {
    check_live();
    if (timeout_milliseconds < 0) {
        trap("a timeout is a count of milliseconds, 0 to wait forever");
    }
    read_timeout_ms = timeout_milliseconds;
    return Result<bool, Error>.Ok(true);
}

Result<bool, Error> Conn.set_ms_write(int timeout_milliseconds) {
    check_live();
    if (timeout_milliseconds < 0) {
        trap("a timeout is a count of milliseconds, 0 to wait forever");
    }
    write_timeout_ms = timeout_milliseconds;
    return Result<bool, Error>.Ok(true);
}

// After an EAGAIN on a read: wait for more to arrive. 0 (the default)
// parks on the reactor with no bound; otherwise parks for at most
// `read_timeout_ms` and says whether that time ran out. Either way only the
// green thread waits.
Result<bool, io.Error> Conn.wait_read_timeout() {
    if (read_timeout_ms <= 0) {
        int ignored = __wait_io(descriptor, IO_READABLE);
        return Result<bool, io.Error>.Ok(false);
    }
    int wait_status = __wait_io_timeout(descriptor, IO_READABLE, read_timeout_ms);
    if (wait_status < 0) {
        return Result<bool, io.Error>.Err(io.from_errno(-wait_status));
    }
    return Result<bool, io.Error>.Ok(wait_status == 1);
}

// The same, for a write that got EAGAIN because the send buffer is full.
Result<bool, io.Error> Conn.wait_write_timeout() {
    if (write_timeout_ms <= 0) {
        int ignored = __wait_io(descriptor, IO_WRITABLE);
        return Result<bool, io.Error>.Ok(false);
    }
    int wait_status = __wait_io_timeout(descriptor, IO_WRITABLE, write_timeout_ms);
    if (wait_status < 0) {
        return Result<bool, io.Error>.Err(io.from_errno(-wait_status));
    }
    return Result<bool, io.Error>.Ok(wait_status == 1);
}

/// Send a small write at once instead of waiting to fill a packet (turn
/// Nagle's algorithm off).
///
/// Worth it for a request/response protocol, where the next thing to send
/// does not exist until the answer to this one arrives, so waiting for more
/// to say adds a round trip to every exchange. Not worth it for a stream of
/// small writes that are going the same way anyway.
pub Result<bool, Error> Conn.set_nodelay(bool is_enabled) {
    check_live();
    int option_value = 0;
    if (is_enabled) {
        option_value = 1;
    }
    int status = __setsockopt(descriptor, TCP_NODELAY, option_value);
    if (status < 0) {
        return Result<bool, Error>.Err(from_errno(-status));
    }
    return Result<bool, Error>.Ok(true);
}

/// Whether a `read` would find something, waiting up to `timeout_ms` for it;
/// a negative timeout waits forever.
///
/// `true` means a read will not block, which includes the peer having
/// closed -- that read answers empty rather than waiting, and both are
/// "there is something to find out". `false` means the time ran out.
///
/// This is the poll-based half of the timeout story, and it is here because
/// the socket option cannot answer "is anything there" without consuming
/// it. **Bytes already in this `Conn`'s own buffer count**: asking the
/// kernel while the answer is sitting in the buffer would say "no" to a
/// caller that can in fact read at once.
pub Result<bool, Error> Conn.wait(int timeout_ms) {
    check_live();
    if (position < end) {
        return Result<bool, Error>.Ok(true);
    }
    return ready(descriptor, IO_READABLE, timeout_ms);
}

// A read on a closed connection is a bug in the program, not a failure of
// the connection -- the same call `io.File` makes.
void Conn.check_live() {
    if (!is_live) {
        trap("read on a closed connection");
    }
}

// Refill an empty buffer. The number of bytes now buffered, 0 at the end.
//
// `buf` is replaced, not reused: `__read_chunk` reads into a scratch buffer
// the runtime keeps per carrier (not per connection) and hands back a fresh
// `bytes` sized to exactly what arrived, so a connection sitting idle holds
// only the bytes it has actually buffered -- never a whole CHUNK it is not
// using -- and the one real CHUNK-sized buffer per carrier is shared by
// every connection that carrier ever serves. Safe because green threads are
// cooperative: only one runs per carrier at a time, and nothing between the
// read and the copy-out below crosses `rt_stack_check`, the only point this
// runtime can switch which one is running (docs/concurrency-decision.md).
Result<int, io.Error> Conn.fill() {
    check_live();
    bytes next = [];
    while (true) {
        int received = __read_chunk(descriptor, CHUNK, next);
        if (received == -4) {
            continue;
        }
        if (received == -EAGAIN) {
            bool is_timed_out = wait_read_timeout()?;
            if (is_timed_out) {
                return Result<int, io.Error>.Err(io.from_errno(EAGAIN));
            }
            continue;
        }
        if (received < 0) {
            return Result<int, io.Error>.Err(io.from_errno(-received));
        }
        buffer = next;
        position = 0;
        end = received;
        return Result<int, io.Error>.Ok(received);
    }
}

// `fill`, except that a failure first puts `held` back in front of the
// connection. Every accumulating read calls this instead of `fill` and may
// then propagate with `?`: the bytes are safe before the error moves.
Result<int, io.Error> Conn.fill_keeping(bytes held) {
    match (fill()) {
        case Ok(int buffered_count): {
            return Result<int, io.Error>.Ok(buffered_count);
        }
        case Err(io.Error error): {
            unread(held);
            return Result<int, io.Error>.Err(error);
        }
    }
}

// Put `data` back in front of the connection: the next read hands those bytes
// out before anything new arrives, and `wait` counts them as ready.
//
// Only a failing read calls it, and a failing read has drained the buffer
// before asking `fill` for more -- `at == end` everywhere this is reached
// -- so `data` simply becomes the buffer, with nothing to merge. `data` can be
// far larger than a chunk, which is why `fill` checks the buffer's size and
// not just whether there is one.
void Conn.unread(bytes data) {
    if (data.size() == 0) {
        return;
    }
    buffer = data;
    position = 0;
    end = data.size();
}

// --- listeners -------------------------------------------------------------
/// A bound, listening socket: the server half.
///
/// **It is not a stream.** It has no bytes to read -- `accept` is the only
/// thing it does -- so it deliberately has none of `io.Stream`'s methods
/// rather than methods that trap.
///
/// Like a `Conn`, it closes itself when its last reference goes.
pub type Listener {
    int descriptor;
    Addr bound;
    bool is_live = true;
}

/// The next connection, waiting for one if none is ready.
///
/// **A failed accept is an `Err`, never a trap**, and some failures are the
/// ordinary weather of a server: `OutOfDescriptors` while a burst of clients
/// holds every descriptor, `Aborted` for a client that hung up in the
/// backlog. Ask `e.is_transient()`: `true` means the listener is intact and
/// the loop may log and ask again, `false` means stop. A signal (`EINTR`)
/// and "nothing pending" (`EAGAIN`) never surface here at all -- this method
/// retries the one and parks on the reactor for the other.
///
/// Out of descriptors leaves the pending connection queued, so asking again
/// at once fails again at once: pause before the retry, as `http.serve` does.
/// A listener that has been closed is not a failure of the world but a bug in
/// the program, and still traps.
pub Result<Conn, Error> Listener.accept() {
    if (!is_live) {
        trap("accept on a closed listener");
    }
    List<int> out = [];
    bytes address_bytes = [0; 16];
    while (true) {
        int accepted_descriptor = __accept(descriptor, out, address_bytes);
        // A signal during a wait for a connection has not accepted one, so
        // the wait goes on. Nothing was pushed onto `out`.
        if (accepted_descriptor == -4) {
            continue;
        }
        // The listening socket is non-blocking (socket_for), so "nothing
        // pending" is EAGAIN rather than a wait inside the kernel. There is
        // no accept timeout to honor -- this type has never had one, only
        // `wait` -- so this always parks on the reactor rather than
        // checking a bound.
        if (accepted_descriptor == -EAGAIN) {
            int ignored = __wait_io(descriptor, IO_READABLE);
            continue;
        }
        if (accepted_descriptor < 0) {
            return Result<Conn, Error>.Err(from_errno(-accepted_descriptor));
        }
        // Accept does not pass the listener's own non-blocking flag on to
        // the new connection (docs/sys-layer.md §9's own note on
        // SYS_SO_NONBLOCK) -- an accepted socket is exactly one that must
        // not block a future read or write, so it is set here, once, before
        // anything else can touch it.
        int nonblocking_status = __setsockopt(accepted_descriptor, SO_NONBLOCK, 1);
        if (nonblocking_status < 0) {
            return Result<Conn, Error>.Err(close_and(accepted_descriptor, -nonblocking_status));
        }
        return Result<Conn, Error>.Ok(Conn(accepted_descriptor, Addr(ip_of(out[0], address_bytes), out[1])));
    }
}

/// The address this listener is bound to.
///
/// **This is how a program learns the port it got** after binding to port 0:
/// the kernel picks a free one, and this is where it says which. A test that
/// hard-codes a port is a test that fails when something else is using it,
/// so every test in this module's corpus binds 0 and reads it back from
/// here.
pub Addr Listener.local() {
    return bound;
}

/// Whether `accept` would return at once, waiting up to `timeout_ms`;
/// a negative timeout waits forever.
pub Result<bool, Error> Listener.wait(int timeout_ms) {
    if (!is_live) {
        trap("wait on a closed listener");
    }
    return ready(descriptor, IO_READABLE, timeout_ms);
}

/// Stop listening and release the port. Closing twice is not an error.
pub Result<bool, Error> Listener.close() {
    return shut();
}

Result<bool, Error> Listener.shut() {
    if (!is_live) {
        return Result<bool, Error>.Ok(true);
    }
    is_live = false;
    int status = __close(descriptor);
    if (status < 0 && status != -4) {
        return Result<bool, Error>.Err(from_errno(-status));
    }
    return Result<bool, Error>.Ok(true);
}

void Listener.drop() {
    Result<bool, Error> ignored = shut();
}

// --- making them -----------------------------------------------------------
/// Listen on `host` and `port`, and answer the socket that does it.
///
/// `host` names an **address**, not an interface: `"127.0.0.1"` is loopback
/// only, `"0.0.0.0"` is every IPv4 address this machine has, `"::"` every
/// IPv6 one. A name is resolved like `connect`'s, which is a thing to avoid
/// in a server -- there is no empty-string shorthand for "everywhere"
/// precisely so that a program says which of the two it meant.
///
/// **Port 0 asks the kernel for a free one**, which `local()` then reports.
///
/// `backlog` is how many connections may wait to be accepted before the
/// kernel starts refusing them; the kernel clamps it to its own
/// `somaxconn` besides. 128 is the default because it is Rust's
/// `TcpListener::bind`, and because a backlog is a buffer for bursts rather
/// than a capacity: a server 128 connections behind is behind, and a larger
/// number only moves the refusal later and makes the queueing delay longer.
/// It is a named argument, so a server that knows better says so and a
/// reader sees the number at the call.
///
/// **A server that genuinely expects bursts of concurrent connections --
/// hundreds or thousands arriving close together, not steady traffic --
/// should pass a deliberately large number** (`apps/httpserver` asks for
/// 65535) rather than guess at its own host's real ceiling: the clamp
/// above means the kernel's own configured maximum wins regardless, so
/// asking for more than any real deployment needs is how a caller gets
/// "whatever this host actually allows" without reading `/proc/sys/net/
/// core/somaxconn` (Linux-only, and not how a program would even ask the
/// equivalent `kern.ipc.somaxconn` on BSD/macOS) itself. Measured directly:
/// at the historical 128, a burst of 10,000 near-simultaneous connections
/// produced 32,000-44,000 dropped SYNs (`ListenOverflows`,
/// `/proc/net/netstat`) in a single ten-second window and correspondingly
/// wide, unpredictable throughput -- every refused connection forces the
/// client into a TCP retransmit, often a second or more before the first
/// retry. Asking for 65535 against the same host (its actual ceiling
/// turned out to be lower, clamped automatically) eliminated the drops
/// entirely. A deployment that needs a specific, audited number instead of
/// whatever its host's clamp happens to be -- a security-hardened host
/// with a deliberately low ceiling, or a value chosen to match a load
/// balancer's own behavior rather than this host's -- still names it
/// explicitly here, exactly as this parameter already allows.
///
/// ### SO_REUSEADDR is always on, and there is no switch
///
/// Without it, a server that stops cannot start again until every
/// connection it had is out of TIME_WAIT -- up to a minute in which the
/// port it has always used is refused with "address already in use". That is
/// the ordinary case for a restart, not an unusual one, and a library whose
/// defaults make a restart fail is a library every program works around the
/// same way.
///
/// It is safe to have no switch because of what SO_REUSEADDR does **not** do
/// on the systems this runs on: it does not let two live sockets listen on
/// one port. That is SO_REUSEPORT, a different option this module does not
/// offer, so turning this one on cannot silently split a program's
/// connections between two processes. Go's `net.Listen` sets it
/// unconditionally for the same reason.
pub Result<Listener, Error> listen(str host, int port, int backlog = 128) {
    check_port(port);
    if (backlog < 1) {
        trap("listen(backlog: " + backlog.to_str() + "): the backlog must be at least 1");
    }
    Ip address = host_ip(host)?;
    int file_descriptor = socket_for(address)?;
    int reuse_status = __setsockopt(file_descriptor, SO_REUSEADDR, 1);
    if (reuse_status < 0) {
        return Result<Listener, Error>.Err(close_and(file_descriptor, -reuse_status));
    }
    int bind_status = __bind(file_descriptor, family_of(address), port, sixteen(address));
    if (bind_status < 0) {
        return Result<Listener, Error>.Err(close_and(file_descriptor, -bind_status));
    }
    int listen_status = __listen(file_descriptor, backlog);
    if (listen_status < 0) {
        return Result<Listener, Error>.Err(close_and(file_descriptor, -listen_status));
    }
    // Asked for rather than assumed: with port 0 the kernel chose one, and
    // even with a port given, binding "0.0.0.0" leaves the address for the
    // kernel to fill in.
    List<int> out = [];
    bytes got = [0; 16];
    int name_status = __sockname(file_descriptor, 0, out, got);
    if (name_status < 0) {
        return Result<Listener, Error>.Err(close_and(file_descriptor, -name_status));
    }
    return Result<Listener, Error>.Ok(Listener(file_descriptor, Addr(ip_of(out[0], got), out[1])));
}

/// Connect to `host` and `port`.
///
/// `host` is a **literal IPv4 or IPv6 address** if it parses as one
/// (`parse_ip`), and a host name otherwise. A literal works identically on
/// both sys-layer backends; a name does not, and that is not a bug that will
/// be fixed:
///
/// **On the raw system-call backend a name cannot be resolved at all**, and
/// the answer is `Err(Other(38))`, whose message says so in those words.
/// Resolving is `getaddrinfo`, and `getaddrinfo` is the NSS machinery, which
/// `dlopen`s `libnss_*` at run time to obey `nsswitch.conf`; a static binary
/// with no C library cannot `dlopen` anything (docs/sys-layer.md §9). What
/// replaces it is a DNS client written in this language over UDP sockets,
/// which is the same road Go took and the reason a static Go binary resolves
/// names at all. Until then: a program that must run on both backends
/// connects to a literal address, and one that meets `Other(38)` is being
/// told which build it is running on rather than crashing.
///
/// A name with several addresses uses **the first the resolver gave**, which
/// on the C library backend is already sorted by RFC 6724. There is no
/// Happy Eyeballs here -- trying the addresses in parallel and keeping the
/// first to answer -- because it needs several connects raced against each
/// other with a per-address timer, not the one this function makes; the
/// connect itself is already non-blocking (`socket_for`/`finish`), but
/// racing several and a timer are not built.
///
/// There is also **no connect timeout**. It would need the same machinery,
/// and the kernel's own is a couple of minutes; a program that cannot wait
/// that long wants the whole operation on a deadline, which is a scheduler's
/// job (docs/concurrency-decision.md) and not a socket option.
pub Result<Conn, Error> connect(str host, int port) {
    check_port(port);
    Ip address = host_ip(host)?;
    int file_descriptor = socket_for(address)?;
    int status = __connect(file_descriptor, family_of(address), port, sixteen(address));
    // The socket is non-blocking (socket_for), so the ordinary case is
    // EINPROGRESS at once, not a wait inside the kernel -- the comment this
    // replaced predates that and was written for a connect interrupted by a
    // signal (POSIX: it goes on in the background, and calling connect
    // again answers EALREADY rather than finishing it); EINTR is kept here
    // too, defensively, though a non-blocking connect has little room to
    // produce it. Either way the wait is the same: for the socket to become
    // writable, then ask it how the connect came to.
    if (status == -EINPROGRESS || status == -4) {
        status = finish(file_descriptor);
    }
    if (status < 0) {
        return Result<Conn, Error>.Err(close_and(file_descriptor, -status));
    }
    return Result<Conn, Error>.Ok(Conn(file_descriptor, Addr(address, port)));
}

// Wait for a connect in progress, and report what it came to. The pending
// error is positive (runtime/sys.h), so 0 is success and anything else is
// the errno the connect would have returned. There is no connect timeout
// (this function's own callers have never offered one, and the module's
// doc comment above says why), so this always parks on the reactor rather
// than bounding the wait -- `__wait_io` cannot itself fail (its own comment
// in lib/net.m31's prim list), so there is no error path to check here
// before reading SO_ERROR.
int finish(int file_descriptor) {
    int ignored = __wait_io(file_descriptor, IO_WRITABLE);
    int pending_error = __getsockopt(file_descriptor, SO_ERROR);
    if (pending_error <= 0) {
        return pending_error;
    }
    return -pending_error;
}

// Whether `file_descriptor` is ready for `events` (IO_READABLE/IO_WRITABLE) within
// `timeout_ms`; a negative timeout waits forever and 0 only looks. Only the
// green thread waits. An error or hang-up on the descriptor is reported as
// readiness whether or not it was asked for, because it means a read or a
// write will return at once rather than wait -- which is what this answers.
Result<bool, Error> ready(int file_descriptor, int events, int timeout_ms) {
    int ready_status = __wait_io_timeout(file_descriptor, events, timeout_ms);
    if (ready_status < 0) {
        return Result<bool, Error>.Err(from_errno(-ready_status));
    }
    return Result<bool, Error>.Ok(ready_status == 0);
}

// A socket of the right family, with SIGPIPE already ignored.
//
// The ignore goes here rather than at startup because a module cannot hold
// the flag that would say it had already been done
// (docs/module-state-decision.md), and it does not need to: the disposition
// is per process and setting it again is one idempotent system call, which
// is nothing beside the connect or the bind that follows. Its failure is
// reported rather than swallowed -- a program whose writes could still kill
// it should not be handed a socket and told nothing.
Result<int, Error> socket_for(Ip address) {
    int ignore_status = __ignore_sigpipe();
    if (ignore_status < 0) {
        return Result<int, Error>.Err(from_errno(-ignore_status));
    }
    int file_descriptor = __socket(family_of(address), SOCK_STREAM, 0);
    if (file_descriptor < 0) {
        return Result<int, Error>.Err(from_errno(-file_descriptor));
    }
    // Non-blocking from the moment it exists, for both the connecting and
    // the listening socket this builds: every wait this module does on a
    // socket -- a connect finishing, a read or write that would otherwise
    // wait on the kernel, a listener with nothing pending -- goes through
    // `__wait_io`/`__wait_io_timeout` instead of the syscall itself blocking the
    // carrier (docs/concurrency-decision.md). An ACCEPTED connection is a
    // separate fd the kernel hands back and does not inherit this, so
    // `Listener.accept` sets it again there.
    int nonblocking_status = __setsockopt(file_descriptor, SO_NONBLOCK, 1);
    if (nonblocking_status < 0) {
        return Result<int, Error>.Err(close_and(file_descriptor, -nonblocking_status));
    }
    return Result<int, Error>.Ok(file_descriptor);
}

// Close a descriptor that is being abandoned because something after it
// failed, and hand back the error that caused it. The close's own result is
// dropped: there is nothing on a socket nobody ever used for it to report,
// and replacing the real reason with it would hide why this happened.
Error close_and(int file_descriptor, int errno) {
    int ignored = __close(file_descriptor);
    return from_errno(errno);
}

void check_port(int port) {
    if (port < 0 || port > 65535) {
        trap("port " + port.to_str() + ": a port is 0..65535");
    }
}

// A literal address if `host` is one, and otherwise whatever the resolver
// says -- which on the raw backend is always ENOSYS.
Result<Ip, Error> host_ip(str host) {
    match (parse_ip(host)) {
        case Some(Ip literal): {
            return Result<Ip, Error>.Ok(literal);
        }
        case None: {
        }
    }
    return resolve_one(host);
}

// The first address a name has. Four are asked for because that is enough
// for the answer to be the resolver's choice rather than this buffer's, and
// only the first is used.
Result<Ip, Error> resolve_one(str host) {
    List<int> out = [];
    bytes addrs = [0; 64];
    int found = __resolve(host, 0, 0, out, addrs);
    if (found < 0) {
        return Result<Ip, Error>.Err(from_errno(-found));
    }
    // A name the resolver knows nothing about usually arrives as an errno
    // above; zero addresses is the other way it can say the same thing.
    if (found == 0) {
        return Result<Ip, Error>.Err(Error.NameNotFound);
    }
    return Result<Ip, Error>.Ok(ip_of(out[0], addrs));
}

// The `Ip` in the first 4 or 16 bytes of `raw`, by the family beside it. The
// primitives always write all sixteen; which of them mean anything is the
// family's business, and this is the one place that knows.
Ip ip_of(int family, bytes raw) {
    if (family == AF_INET6) {
        return Ip(raw.substr(0, 16));
    }
    return Ip(raw.substr(0, 4));
}

int family_of(Ip address) {
    if (address.is_v6()) {
        return AF_INET6;
    }
    return AF_INET;
}

// The sixteen bytes `__bind` and `__connect` read, whatever the family: the
// runtime checks the size and never trusts it, so a four-octet IPv4 address
// is padded here rather than at the seam.
bytes sixteen(Ip address) {
    bytes out = address.octets();
    while (out.size() < 16) {
        out.push(0);
    }
    return out;
}
