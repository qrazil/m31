// Ed25519 (RFC 8032): signing and verification on the twisted Edwards curve
// `edwards25519`, `-x^2 + y^2 = 1 + d*x^2*y^2` mod `2^255 - 19` -- the same
// base field `x25519.m31` uses, in its Edwards rather than Montgomery form.
//
// API
// ---
//   bytes pub = ed25519.public_key(seed);        // 32 octets, from a 32-octet seed
//   bytes sig = ed25519.sign(seed, msg);          // 64 octets
//   bool  ok  = ed25519.is_valid_signature(pub, msg, sig);
//
// --- which operations need to be constant time, and which do not -----------
//
// **Signing's point multiplications are on the critical path and are
// constant time.** `sign` computes `[a]B` (the public key, from the
// secret expanded scalar `a`) and `[r]B` (the nonce point, from the
// per-message secret nonce `r`) -- both multiply the fixed base point by a
// SECRET scalar, which is exactly the shape `x25519.m31`'s Montgomery
// ladder exists for. Ed25519 is on a different curve model, so it cannot
// reuse that ladder directly, but it needs the same property from its own
// scalar multiplication: `scalar_mult` below is double-and-add-ALWAYS --
// every bit does a double, computes an add unconditionally, and SELECTS
// (via `field25519.cselect`, never a branch) whether to keep the addition
// -- over a FIXED 256 iterations regardless of the scalar's actual size.
// This works because edwards25519's extended-coordinate addition law
// (`point_add` below) is COMPLETE: unlike an affine or a Weierstrass
// addition formula, it has no exceptional input (P + P, P + O, P + (-P) all
// go through the same four field operations as any other pair), so
// "compute the add every time and decide afterwards whether to use it" is
// always well-defined, never a division by zero in disguise.
//
// **Verification's point multiplications are on public data and are NOT
// constant time here, deliberately, rather than by accident.** `verify`
// computes `[S]B` and `[k]A`, where `S` is the signature's own scalar, `k`
// is a hash of public values, and `A` is the public key -- nothing in that
// list is secret, so a timing difference in how long verification takes
// leaks nothing an attacker does not already have. This file still runs
// `verify`'s multiplications through the SAME `scalar_mult` as signing,
// which costs verification some speed it did not have to spend, in
// exchange for one scalar multiplication implementation to get right and
// test instead of two. If verification's speed ever matters enough to be
// worth a second, variable-time implementation, that is a distinct,
// separately-justified change, not something this file does by half.
//
// **Everything else -- point compression/decompression, the hash calls,
// `scalar25519`'s arithmetic on `S`, `k`, and the reduced `a` -- runs on
// secret data too (the seed, the expanded scalar, the nonce) wherever it
// touches signing**, and inherits its constant-time argument from
// `field25519.m31`, `sha512.m31` and `scalar25519.m31`'s own headers rather
// than repeating it here.

import crypto.field25519;
import crypto.scalar25519;
import crypto.sha512;

/// A point on edwards25519, in extended coordinates `(X : Y : Z : T)`,
/// representing the affine point `(X/Z, Y/Z)` with the redundant `T = XY/Z`
/// that makes `point_add` complete. Private: nothing outside this file
/// should construct or inspect one directly.
type Point {
    Array<int> x_coordinate;
    Array<int> y_coordinate;
    Array<int> z_coordinate;
    Array<int> t_coordinate;
}

// The curve constant `d` (its double is computed where `point_add` needs
// it, not precomputed -- one extra `field25519.mul` per call is not worth a
// second constant to keep in agreement with the first), `sqrt(-1) mod p`
// (needed to pick the right square root when decompressing a point, RFC
// 8032 §5.1.3), and the base point's coordinates -- all generated by, and
// checked against, the derivations this module's report documents (`d`
// from `-121665/121666`, `sqrt(-1)` from `2^((p-1)/4)`, the base point from
// `y = 4/5` and the x-recovery formula), never copied from another
// implementation by hand.
const Array<int> EDWARDS_D = [
    0x35978A3, 0x0D37284, 0x3156EBD, 0x06A0A0E, 0x001C029,
    0x179E898, 0x3A03CBB, 0x1CE7198, 0x2E2B6FF, 0x1480DB3
];

const Array<int> SQRTM1 = [
    0x20EA0B0, 0x186C9D2, 0x08F189D, 0x035697F, 0x0BD0C60,
    0x1FBD7A7, 0x2804C9E, 0x1E16569, 0x004FC1D, 0x0AE0C92
];

const Array<int> BASE_X = [
    0x325D51A, 0x18B5823, 0x0F6592A, 0x104A92D, 0x1A4B31D,
    0x1D6DC5C, 0x27118FE, 0x07FD814, 0x13CD6E5, 0x085A4DB
];

const Array<int> BASE_Y = [
    0x2666658, 0x1999999, 0x0CCCCCC, 0x1333333, 0x1999999,
    0x0666666, 0x3333333, 0x0CCCCCC, 0x2666666, 0x1999999
];

Point identity() {
    return Point(field25519.zero(), field25519.one(), field25519.one(), field25519.zero());
}

// An affine `(x, y)` lifted to extended coordinates.
Point of_affine(Array<int> x_coordinate, Array<int> y_coordinate) {
    return Point(x_coordinate, y_coordinate, field25519.one(), field25519.mul(x_coordinate, y_coordinate));
}

Point base_point() {
    return of_affine(clone(BASE_X), clone(BASE_Y));
}

// The complete extended-coordinates addition law for `a = -1` (Hisil,
// Wong, Carter, Dawson 2008), valid for ANY two points on this curve,
// doubling included -- see the header for why completeness is what makes
// `scalar_mult`'s "always add, then select" pattern correct.
//
//   A = (Y1-X1)*(Y2-X2);  B = (Y1+X1)*(Y2+X2);  C = T1*2d*T2;  D = 2*Z1*Z2
//   E = B-A;  F = D-C;  G = D+C;  H = B+A
//   X3 = E*F;  Y3 = G*H;  T3 = E*H;  Z3 = F*G
//
// Verified independently against `pynacl` over 300 random signatures and
// every RFC 8032 §7.1 test vector before this file existed -- see the
// report.
Point point_add(Point first_point, Point second_point) {
    Point out = identity();
    point_add_into(out, first_point, second_point, scratch_elements(), two_d());
    return out;
}

// Ten scratch elements for `point_add_into`, allocated by the caller once so
// a whole scalar multiplication allocates nothing per step.
Array<Array<int>> scratch_elements() {
    Array<Array<int>> out = [field25519.zero(), field25519.zero(), field25519.zero(), field25519.zero(), field25519.zero(), field25519.zero(), field25519.zero(), field25519.zero(), field25519.zero(), field25519.zero()];
    return out;
}

// `2d`, computed rather than kept as a second constant that could disagree
// with the first.
Array<int> two_d() {
    return field25519.mul(field25519.small(2), EDWARDS_D);
}

// `point_add` written into `out`, which may be either input (everything the
// inputs contribute is read into the scratch elements first). Same law, same
// values; `2*Z1*Z2` is a doubling by addition and `T1*2d*T2` is `T1*T2*2d`,
// which are equal mod p to what the allocating form computes.
void point_add_into(Point out, Point first_point, Point second_point, Array<Array<int>> s, Array<int> twice_d) {
    field25519.sub_into(s[0], first_point.y_coordinate, first_point.x_coordinate);
    field25519.sub_into(s[1], second_point.y_coordinate, second_point.x_coordinate);
    field25519.mul_into(s[2], s[0], s[1]);  // RFC 8032 §5.1.4: A
    field25519.add_into(s[0], first_point.y_coordinate, first_point.x_coordinate);
    field25519.add_into(s[1], second_point.y_coordinate, second_point.x_coordinate);
    field25519.mul_into(s[3], s[0], s[1]);  // RFC 8032 §5.1.4: B
    field25519.mul_into(s[0], first_point.t_coordinate, second_point.t_coordinate);
    field25519.mul_into(s[4], s[0], twice_d);  // RFC 8032 §5.1.4: C
    field25519.mul_into(s[0], first_point.z_coordinate, second_point.z_coordinate);
    field25519.add_into(s[5], s[0], s[0]);  // RFC 8032 §5.1.4: D
    field25519.sub_into(s[6], s[3], s[2]);  // RFC 8032 §5.1.4: E
    field25519.sub_into(s[7], s[5], s[4]);  // RFC 8032 §5.1.4: F
    field25519.add_into(s[8], s[5], s[4]);  // RFC 8032 §5.1.4: G
    field25519.add_into(s[9], s[3], s[2]);  // RFC 8032 §5.1.4: H
    field25519.mul_into(out.x_coordinate, s[6], s[7]);
    field25519.mul_into(out.y_coordinate, s[8], s[9]);
    field25519.mul_into(out.t_coordinate, s[6], s[9]);
    field25519.mul_into(out.z_coordinate, s[7], s[8]);
}

// `point_if_one` if `cond` is 1, `point_if_zero` if `cond` is 0, written into
// `out` (which may be either): `field25519.cselect_into` on all four coordinates.
void point_cselect_into(int cond, Point out, Point point_if_one, Point point_if_zero) {
    field25519.cselect_into(cond, out.x_coordinate, point_if_one.x_coordinate, point_if_zero.x_coordinate);
    field25519.cselect_into(cond, out.y_coordinate, point_if_one.y_coordinate, point_if_zero.y_coordinate);
    field25519.cselect_into(cond, out.z_coordinate, point_if_one.z_coordinate, point_if_zero.z_coordinate);
    field25519.cselect_into(cond, out.t_coordinate, point_if_one.t_coordinate, point_if_zero.t_coordinate);
}

// Bit `bit_position` (0 = least significant) of `scalar`, a 32-octet little-endian scalar.
// Safe regardless of whether `scalar` holds secret data, for the same reason
// `x25519.m31`'s `bit_at` is: a `bytes` element is always in [0, 255],
// never negative, so the `>>` below never exercises the sign-dependent
// branch `field25519.m31`'s header describes.
int bit_at(bytes scalar, int bit_position) {
    int byte_index = bit_position / 8;
    int bit_index = bit_position % 8;
    return scalar[byte_index] >> bit_index & 1;
}

// `[scalar]base`, scalar given as 32 little-endian octets. Constant-time,
// unconditionally, for every caller -- see the header for why `verify`
// uses this too even though it does not have to.
//
// Fixed 256 iterations regardless of `scalar`'s actual magnitude: looping
// to the scalar's own bit length (as a variable-time implementation would)
// leaks that length through the iteration count, which is exactly the kind
// of thing this function exists to not do.
Point scalar_mult(bytes scalar, Point base) {
    Point accumulator = identity();
    Point added = identity();
    Array<Array<int>> scratch = scratch_elements();
    Array<int> twice_d = two_d();
    int bit_position = 255;
    while (bit_position >= 0) {
        point_add_into(accumulator, accumulator, accumulator, scratch, twice_d);
        point_add_into(added, accumulator, base, scratch, twice_d);
        int bit = bit_at(scalar, bit_position);
        point_cselect_into(bit, accumulator, added, accumulator);
        bit_position = bit_position - 1;
    }
    return accumulator;
}

// `point`'s affine `y_coordinate`, with `x_coordinate`'s parity riding in the spare top bit -- RFC
// 8032 §5.1.2's point encoding. Not constant time in itself (`field25519`'s
// `invert`, called here, is; the point being encoded, `A` or `R`, is
// public once computed), but see `sign`'s own note on what stays secret.
bytes compress(Point point) {
    Array<int> zinv = field25519.invert(point.z_coordinate);
    Array<int> x_coordinate = field25519.mul(point.x_coordinate, zinv);
    Array<int> y_coordinate = field25519.mul(point.y_coordinate, zinv);
    bytes out = field25519.to_bytes(y_coordinate);
    int sign_bit = field25519.parity(x_coordinate);
    out[31] = out[31] | sign_bit << 7;
    return out;
}

// The inverse of `compress`, RFC 8032 §5.1.3: recover `x_coordinate` from `y_coordinate` and the
// sign bit via `x^2 = (y^2-1) / (d*y^2+1)`, taking the square root with
// `field25519.pow_p_minus_5_over_8` and correcting it by `sqrt(-1)` when
// the first candidate is the wrong one of the two roots -- exactly RFC
// 8032's own recipe, ported from the big-integer model this module's report
// verified against `pynacl` before this file existed.
//
// `d*y^2 + 1 = 0` has no solution for this curve's `d` (checked separately,
// mod p: `-1/d` is not a quadratic residue), so the inversion below never
// divides by zero for a `y_coordinate` that reaches it -- and a non-canonical `y_coordinate`
// (>= p) is refused before that, by comparing the reduced encoding to the
// one handed in.
pub Option<Point> decompress(bytes enc) {
    int sign_bit = enc[31] >> 7 & 1;
    bytes y_bytes = clone(enc);
    y_bytes[31] = y_bytes[31] & 0x7F;
    Array<int> y_coordinate = field25519.from_bytes(y_bytes);
    if (field25519.to_bytes(y_coordinate) != y_bytes) {
        return Option<Point>.None;
    }
    Array<int> y_squared = field25519.square(y_coordinate);
    Array<int> numerator = field25519.sub(y_squared, field25519.one());  // RFC 8032 §5.1.3: u
    Array<int> denominator = field25519.add(field25519.mul(EDWARDS_D, y_squared), field25519.one());  // RFC 8032 §5.1.3: v
    Array<int> x_squared = field25519.mul(numerator, field25519.invert(denominator));
    // RFC 8032 §5.1.3: the candidate root is `xx^((p+3)/8)`, and
    // `(p+3)/8 == (p-5)/8 + 1`, so this is `field25519.pow_p_minus_5_over_8`
    // (which computes the `(p-5)/8` power) times one more factor of `x_squared` --
    // reusing that function rather than adding a second, near-identical
    // exponentiation loop for a one-off exponent.
    Array<int> x_coordinate = field25519.mul(field25519.pow_p_minus_5_over_8(x_squared), x_squared);
    if (!field25519.eq(field25519.square(x_coordinate), x_squared)) {
        x_coordinate = field25519.mul(x_coordinate, SQRTM1);
        if (!field25519.eq(field25519.square(x_coordinate), x_squared)) {
            return Option<Point>.None;
        }
    }
    if (field25519.is_zero(x_coordinate) && sign_bit == 1) {
        return Option<Point>.None;
    }
    if (field25519.parity(x_coordinate) != sign_bit) {
        x_coordinate = field25519.neg(x_coordinate);
    }
    return Option<Point>.Some(of_affine(x_coordinate, y_coordinate));
}

// Whether `first_point` and `second_point` are the same affine point, compared projectively
// (`x1*z2 == x2*z1` and `y1*z2 == y2*z1`) so neither side needs an
// inversion. Both sides of `verify`'s check are public, so this makes no
// constant-time claim.
bool is_point_equal(Point first_point, Point second_point) {
    bool is_x_equal = field25519.eq(field25519.mul(first_point.x_coordinate, second_point.z_coordinate), field25519.mul(second_point.x_coordinate, first_point.z_coordinate));
    bool is_y_equal = field25519.eq(field25519.mul(first_point.y_coordinate, second_point.z_coordinate), field25519.mul(second_point.y_coordinate, first_point.z_coordinate));
    return is_x_equal && is_y_equal;
}

// RFC 8032 §5.1.5's clamp: clear the low 3 bits, clear the top bit, set the
// second-highest -- the same three lines `x25519.m31`'s `clamp_scalar` has,
// because RFC 8032 and RFC 7748 specify the identical clamp. Kept as its
// own copy rather than shared, the way `field25519.m31`'s and
// `scalar25519.m31`'s `cselect` are each their own copy: two three-line
// functions cost less than a dependency neither module otherwise needs.
bytes clamp(bytes scalar) {
    bytes out = clone(scalar);
    out[0] = out[0] & 0xF8;
    out[31] = out[31] & 0x7F;
    out[31] = out[31] | 0x40;
    return out;
}

// One SHA-512 over two pieces, without building a concatenated copy first.
bytes hash2(bytes first, bytes second) {
    sha512.Hasher hasher = sha512.Hasher();
    hasher.update(first);
    hasher.update(second);
    return hasher.digest();
}

bytes hash3(bytes first, bytes second, bytes third) {
    sha512.Hasher hasher = sha512.Hasher();
    hasher.update(first);
    hasher.update(second);
    hasher.update(third);
    return hasher.digest();
}

/// RFC 8032 §5.1.5: expand a 32-octet seed into the clamped scalar `a`
/// (still as 32 octets -- callers needing it reduced mod `L` do that
/// themselves) and the 32-octet nonce prefix.
Array<bytes> secret_expand(bytes seed) {
    bytes digest = sha512.sum(seed);
    bytes a_raw = clamp(digest.substr(0, 32));
    bytes prefix = digest.substr(32, 64);
    Array<bytes> out = [a_raw, prefix];
    return out;
}

/// The 32-octet public key for the 32-octet seed `seed` -- RFC 8032
/// §5.1.5, `A = [a]B`, encoded.
pub bytes public_key(bytes seed) {
    Array<bytes> expanded = secret_expand(seed);
    Point a_point = scalar_mult(expanded[0], base_point());
    return compress(a_point);
}

/// Sign `message` with the 32-octet seed `seed`, RFC 8032 §5.1.6. `sign` and
/// `public_key` agree: `verify(public_key(seed), msg, sign(seed, msg))` is
/// always `true`.
pub bytes sign(bytes seed, bytes message) {
    Array<bytes> expanded = secret_expand(seed);
    bytes a_raw = expanded[0];
    bytes prefix = expanded[1];
    Array<int> secret_scalar = scalar25519.reduce256(scalar25519.from_bytes(a_raw));  // RFC 8032 §5.1.6: a
    Point big_a = scalar_mult(a_raw, base_point());
    bytes a_enc = compress(big_a);
    Array<int> nonce_scalar = scalar25519.reduce64(hash2(prefix, message));  // RFC 8032 §5.1.6: r
    bytes r_bytes = scalar25519.to_bytes(nonce_scalar);
    Point big_r = scalar_mult(r_bytes, base_point());
    bytes r_enc = compress(big_r);
    Array<int> challenge_scalar = scalar25519.reduce64(hash3(r_enc, a_enc, message));  // RFC 8032 §5.1.6: k
    Array<int> signature_scalar = scalar25519.muladd(challenge_scalar, secret_scalar, nonce_scalar);  // RFC 8032 §5.1.6: S
    bytes out = clone(r_enc);
    out.extend(scalar25519.to_bytes(signature_scalar));
    return out;
}

/// Verify `sig` (64 octets) over `message` under the 32-octet public key `pub`,
/// RFC 8032 §5.1.7. Rejects a malformed length, a non-canonical `S`
/// (`S >= L`), an `R` or a public key that does not decompress to a point
/// on the curve, a public key of small order, and a signature that does not satisfy `[S]B = R + [k]A`.
pub bool is_valid_signature(bytes pub_key, bytes message, bytes sig) {
    if (sig.size() != 64 || pub_key.size() != 32) {
        return false;
    }
    bytes r_enc = sig.substr(0, 32);
    bytes s_bytes = sig.substr(32, 64);
    Array<int> signature_scalar = scalar25519.from_bytes(s_bytes);  // RFC 8032 §5.1.7: S
    if (!scalar25519.is_reduced(signature_scalar)) {
        return false;
    }
    match (decompress(pub_key)) {
        case None: {
            return false;
        }
        case Some(Point big_a): {
            // A public key of small order (the identity and the seven other
            // points of order dividing 8) makes `[k]A` vanish or collapse, so
            // a signature could be made without the secret: refuse such a
            // key, as libsodium does. [8]A is the identity exactly then.
            Point doubled = point_add(big_a, big_a);
            Point quadrupled = point_add(doubled, doubled);
            Point eightfold = point_add(quadrupled, quadrupled);
            if (is_point_equal(eightfold, identity())) {
                return false;
            }
            match (decompress(r_enc)) {
                case None: {
                    return false;
                }
                case Some(Point big_r): {
                    Array<int> challenge_scalar = scalar25519.reduce64(hash3(r_enc, pub_key, message));  // RFC 8032 §5.1.7: k
                    Point lhs = scalar_mult(s_bytes, base_point());
                    Point rhs = point_add(big_r, scalar_mult(scalar25519.to_bytes(challenge_scalar), big_a));
                    return is_point_equal(lhs, rhs);
                }
            }
        }
    }
}
