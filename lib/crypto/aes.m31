// AES-128 and AES-256 block encryption (FIPS 197), encrypt direction only --
// all that GCM and CTR mode need. `lib/crypto/aesgcm.m31` is the AEAD built on it.
//
//   import aes;
//   aes.Cipher cipher = aes.cipher(key);          // key: 16 or 32 octets
//   bytes out = cipher.encrypt_block(block);      // block: 16 octets
//
// A key of any other length, or a block that is not 16 octets, is a bug in
// the caller and **traps** (docs/errors-decision.md): nothing in here is
// network-facing, and there is no `Result` because nothing can fail once the
// lengths are right. AES-192 is deliberately absent -- TLS 1.3 has no suite
// for it and a code path nothing exercises is a code path nothing checks.
//
// --- Side channels: the stance ---------------------------------------------
//
// The usual software AES is four 1 KiB lookup tables indexed by secret data.
// That leaks the key through the cache (Bernstein 2005, Osvik-Shamir-Tromer
// 2006), and this language cannot promise otherwise: an `Array<int>` read is
// a memory access whose address depends on the index. So this module has **no
// lookup table, no branch and no memory index that depends on the key or on
// the data**.
//
//   * The state is two 64-bit ints, each holding eight bytes in eight
//     8-bit lanes ("SWAR": SIMD within a register). SubBytes, MixColumns and
//     AddRoundKey are masks, shifts, ANDs and XORs on those ints.
//   * SubBytes computes the S-box instead of reading it: the multiplicative
//     inverse in GF(2^8) as x^254 by a fixed chain of 13 field
//     multiplications, then the affine map. 0 maps to 0 with no special case,
//     because 0^254 is 0. A GF(2^8) multiplication is eight rounds of "XOR in
//     the multiplicand, masked by a bit of the multiplier; double the
//     multiplicand", the mask built arithmetically (`flag * 0x7F | flag << 7`),
//     never with `if`.
//   * ShiftRows and the key schedule's RotWord permute bytes by positions
//     that are constants of the algorithm, never of the data. The key
//     schedule's `if`s test the word index and the round constant, which are
//     public, and its S-box calls are the same constant-time SubBytes.
//   * The only loop bounds are round count (a function of the key *length*)
//     and the constants 8 and 128 above.
//
// What this does and does not buy. It is constant-time **at the source
// level**: the sequence of operations and the addresses touched are
// independent of key and data, which removes the cache-timing channel that
// table AES has. It is not verified at the machine-code level -- this
// language compiles to C and the C compiler is free to turn a mask into a
// branch (in practice it does not for this pattern, and the arithmetic
// overflow checks it adds are branches whose outcome never depends on
// secrets, since no value here ever gets near 2^63). No timing measurement
// was done on a real CPU, and nothing here defends against power or
// electromagnetic analysis, fault injection, or an attacker who can read the
// process's memory. It is also **slow**: AES-GCM through this module and
// `lib/crypto/aesgcm.m31` seals about 1 MiB per second on the development machine
// (measured, -O2), roughly twelve times slower than this library's
// ChaCha20-Poly1305 and three orders of magnitude behind AES-NI. A TLS client
// still works -- a 16 KiB record costs about 16 ms -- which is why the suite
// is offered at all, but ChaCha20-Poly1305 stays first in the ClientHello's
// preference order for that reason, and because it has no timing trade-off to
// document.
//
// --- Layout -----------------------------------------------------------------
//
// FIPS 197 numbers the 16 state bytes column by column: byte `4 * c + r` is
// row `r` of column `c`. Byte `i` of a block is held in lane `i % 8` of the
// int `i / 8` (little-endian: byte 0 is the least significant). So a
// column is four consecutive lanes, and a round key word, read little-endian
// the way `lib/crypto/chacha20poly1305.m31` reads words, is already a column.
// `>>` is arithmetic here (reference §6.1), so every right shift of a value
// that may have its top bit set is masked before use.

/// 0x01 in every one of the eight lanes.
const int LANE_ONES = 0x0101_0101_0101_0101;
/// 0x7F in every lane: the bits a doubling keeps in place.
const int LANE_LOW7 = 0x7F7F_7F7F_7F7F_7F7F;

/// A key schedule, ready to encrypt blocks. Built by `cipher`.
pub type Cipher {
    /// Two ints per round key, `(rounds + 1)` round keys.
    Array<int> round_keys;
    int rounds;
}

/// Encrypts one 16-octet block; any other length traps.
pub bytes Cipher.encrypt_block(bytes block) {
    if (block.size() != 16) {
        trap("aes: a block is 16 bytes");
    }
    int low = lanes_le(block, 0) ^ round_keys[0];
    int high = lanes_le(block, 8) ^ round_keys[1];
    for (int round in 1 .. rounds) {
        Array<int> shifted = shift_rows(substitute_lanes(low), substitute_lanes(high));
        low = mix_columns(shifted[0]) ^ round_keys[2 * round];
        high = mix_columns(shifted[1]) ^ round_keys[2 * round + 1];
    }
    Array<int> last = shift_rows(substitute_lanes(low), substitute_lanes(high));
    low = last[0] ^ round_keys[2 * rounds];
    high = last[1] ^ round_keys[2 * rounds + 1];
    bytes out = [];
    for (int index in 0 .. 8) {
        out.push(low >> (8 * index) & 0xFF);
    }
    for (int index in 0 .. 8) {
        out.push(high >> (8 * index) & 0xFF);
    }
    return out;
}

// Multiplication by x in GF(2^8)/(x^8+x^4+x^3+x+1), in all eight lanes.
int double_lanes(int value) {
    return ((value & LANE_LOW7) << 1) ^ ((value >> 7 & LANE_ONES) * 0x1B);
}

// Lane-wise product in GF(2^8), by shift and conditional XOR, with the
// condition turned into an all-ones/all-zeros lane mask by arithmetic.
int multiply_lanes(int left, int right) {
    int product = 0;
    int doubled = left;
    for (int bit in 0 .. 8) {
        int flag = right >> bit & LANE_ONES;
        product = product ^ (doubled & (flag * 0x7F | flag << 7));
        doubled = double_lanes(doubled);
    }
    return product;
}

// Each lane rotated left by `count` (1 to 7) bits.
int rotate_lanes(int value, int count) {
    int keep = LANE_ONES * (0xFF >> count);
    int carry = LANE_ONES * ((1 << count) - 1);
    return ((value & keep) << count) | (value >> (8 - count) & carry);
}

// SubBytes on eight bytes at once: x^254 (the inverse, 0 for 0) then the
// affine map of FIPS 197 §5.1.1, whose constant is 0x63.
int substitute_lanes(int value) {
    int power = value;
    for (int step in 0 .. 6) {
        power = multiply_lanes(multiply_lanes(power, power), value);
    }
    int inverse = multiply_lanes(power, power);
    int affine = inverse ^ rotate_lanes(inverse, 1) ^ rotate_lanes(inverse, 2) ^ rotate_lanes(inverse, 3) ^ rotate_lanes(inverse, 4);
    return affine ^ (LANE_ONES * 0x63);
}

// A 32-bit word with SubBytes applied to its four bytes.
int substitute_word(int word) {
    return substitute_lanes(word) & 0xFFFF_FFFF;
}

// Four octets of `data` at `at`, little-endian.
int word_le(bytes data, int at) {
    return data[at] | (data[at + 1] << 8) | (data[at + 2] << 16) | (data[at + 3] << 24);
}

// Eight octets of `data` at `at`, little-endian, as one 64-bit pattern.
int lanes_le(bytes data, int at) {
    return word_le(data, at) | (word_le(data, at + 4) << 32);
}

// The expanded key, FIPS 197 §5.2. `i` and `rcon` are public.
Array<int> expand_words(bytes key, int rounds) {
    int key_words = key.size() / 4;
    int total = 4 * (rounds + 1);
    Array<int> words = [0; total];
    for (int index in 0 .. key_words) {
        words[index] = word_le(key, 4 * index);
    }
    int rcon = 1;
    for (int index in key_words .. total) {
        int previous = words[index - 1];
        if (index % key_words == 0) {
            int rotated = (previous >> 8 | (previous & 0xFF) << 24) & 0xFFFF_FFFF;
            previous = substitute_word(rotated) ^ rcon;
            rcon = rcon << 1;
            if (rcon > 0xFF) {
                rcon = rcon ^ 0x11B;
            }
        } else if (key_words > 6 && index % key_words == 4) {
            previous = substitute_word(previous);
        }
        words[index] = words[index - key_words] ^ previous;
    }
    return words;
}

/// The key schedule for `key`, 16 octets (AES-128) or 32 (AES-256); any other
/// length traps.
pub Cipher cipher(bytes key) {
    if (key.size() != 16 && key.size() != 32) {
        trap("aes: key must be 16 or 32 bytes");
    }
    int rounds = key.size() / 4 + 6;
    Array<int> words = expand_words(key, rounds);
    Array<int> round_keys = [0; 2 * (rounds + 1)];
    for (int round in 0 .. rounds + 1) {
        round_keys[2 * round] = words[4 * round] | (words[4 * round + 1] << 32);
        round_keys[2 * round + 1] = words[4 * round + 2] | (words[4 * round + 3] << 32);
    }
    return Cipher(round_keys, rounds);
}

// Each column's rows rotated up by one: lane r of a column becomes what was
// in lane r + 1. Columns are the 4-lane groups; the masks keep lanes from
// crossing a column boundary.
int rotate_rows_by_one(int value) {
    return ((value >> 8) & 0x00FF_FFFF_00FF_FFFF) | ((value & 0x0000_00FF_0000_00FF) << 24);
}

int rotate_rows_by_two(int value) {
    return ((value >> 16) & 0x0000_FFFF_0000_FFFF) | ((value & 0x0000_FFFF_0000_FFFF) << 16);
}

int rotate_rows_by_three(int value) {
    return ((value >> 24) & 0x0000_00FF_0000_00FF) | ((value & 0x00FF_FFFF_00FF_FFFF) << 8);
}

// MixColumns, FIPS 197 §5.1.3: 2*a[r] ^ 3*a[r+1] ^ a[r+2] ^ a[r+3] per row,
// with 3*x written as 2*x ^ x.
int mix_columns(int value) {
    int next = rotate_rows_by_one(value);
    return double_lanes(value) ^ double_lanes(next) ^ next ^ rotate_rows_by_two(value) ^ rotate_rows_by_three(value);
}

// The byte at state position `index` (0 to 15) out of the pair `(low, high)`.
// `index` is a loop constant of ShiftRows, not data.
int state_byte(int low, int high, int index) {
    if (index < 8) {
        return low >> (8 * index) & 0xFF;
    }
    return high >> (8 * (index - 8)) & 0xFF;
}

// ShiftRows, FIPS 197 §5.1.2: row r moves left by r columns, so output byte
// `4 * c + r` is input byte `4 * ((c + r) % 4) + r`. Every position is a
// constant of the algorithm.
Array<int> shift_rows(int low, int high) {
    int out_low = 0;
    int out_high = 0;
    for (int column in 0 .. 4) {
        for (int row in 0 .. 4) {
            int target = 4 * column + row;
            int source = 4 * ((column + row) % 4) + row;
            int value = state_byte(low, high, source);
            if (target < 8) {
                out_low = out_low | (value << (8 * target));
            } else {
                out_high = out_high | (value << (8 * (target - 8)));
            }
        }
    }
    return [out_low, out_high];
}
