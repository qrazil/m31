// AES-128 and AES-256 block encryption (FIPS 197), encrypt direction only --
// all that GCM and CTR mode need. `lib/crypto/aesgcm.m31` is the AEAD built on it.
//
//   import aes;
//   aes.Cipher cipher = aes.cipher(key);          // key: 16 or 32 octets
//   bytes out = cipher.encrypt_block(block);      // block: 16 octets
//   bytes many = cipher.encrypt_blocks(blocks);   // ECB over any multiple of 16 octets
//
// A key of any other length, or input that is not a whole number of blocks,
// is a bug in the caller and **traps** (docs/errors-decision.md): nothing in
// here is network-facing, and there is no `Result` because nothing can fail
// once the lengths are right. AES-192 is deliberately absent -- TLS 1.3 has no
// suite for it and a code path nothing exercises is a code path nothing checks.
//
// --- Side channels: the stance ---------------------------------------------
//
// The usual software AES is four 1 KiB lookup tables indexed by secret data.
// That leaks the key through the cache (Bernstein 2005, Osvik-Shamir-Tromer
// 2006), and this language cannot promise otherwise: an `Array<int>` read is
// a memory access whose address depends on the index. So this module has **no
// lookup table, no branch and no memory index that depends on the key or on
// the data**.
//
//   * It is bitsliced: four blocks at a time, held as eight 64-bit ints
//     ("planes"), plane k holding bit k of all 64 state bytes (bit position
//     16 * block + 4 * column + row). SubBytes is the Boyar-Peralta 113-gate
//     boolean circuit for the S-box (J. Cryptology 2012, "A small depth-16
//     circuit for the AES S-box") run on whole planes -- XOR, AND and NOT only.
//     ShiftRows and MixColumns are fixed masks and shifts of the planes.
//   * The cost per block is therefore a fixed number of word operations that
//     cannot depend on the key or the data, and it is shared by four blocks,
//     which is what makes it fast: about 100 times the speed of the previous
//     one-byte-at-a-time x^254 formulation (docs/CRYPTO-PERF.md).
//   * Moving bytes into and out of planes is a fixed network of masked
//     shifts (an 8x8 bit transpose and an 8x8 byte transpose), no table.
//   * The key schedule runs the same circuit (`substitute_word`); its `if`s
//     test the word index and the round constant, which are public. The only
//     loop bounds are the round count (a function of the key *length*), the
//     number of blocks (public) and constants.
//
// What this does and does not buy. It is constant-time **at the source
// level**: the sequence of operations and the addresses touched are
// independent of key and data, which removes the cache-timing channel that
// table AES has. It is not verified at the machine-code level -- this
// language compiles to C and the C compiler is free to turn a mask into a
// branch (in practice it does not for this pattern, and the arithmetic
// overflow checks it adds are branches whose outcome never depends on
// secrets, since no value here ever gets near 2^63). No timing measurement
// was done on a real CPU, and nothing here defends against power or
// electromagnetic analysis, fault injection, or an attacker who can read the
// process's memory. It is still far from AES-NI (see docs/CRYPTO-ACCEL.md):
// a few tens of MiB/s against several GiB/s.

import crypto.accel;

// The hardware kernels (docs/ffi-decision.md, docs/CRYPTO-ACCEL.md): assembly in
// runtime/crypto_*.S, called with spans the compiler range-checks. A kernel runs
// only if the CPU has AES-NI and PCLMULQDQ (or ARMv8 AES and PMULL), the key is
// AES-128 or AES-256, and `M31_CRYPTO_ACCEL` has not switched it off
// (`accel.features()`); otherwise the bitsliced m31 code below does the work,
// with the same bytes out. `schedule` is the standard expanded key.
prim "c" nonblocking void __k_aes_ecb(
    in bytes schedule[0 .. 16 * (rounds + 1)],
    int rounds in 10 | 14,
    in bytes input[offset .. offset + 16 * count],
    out bytes output[offset .. offset + 16 * count],
    int count,
    range int offset);
prim "c" nonblocking void __k_aes_ctr(
    in bytes schedule[0 .. 16 * (rounds + 1)],
    int rounds in 10 | 14,
    inout bytes counter[0 .. 16],
    in bytes input[offset .. offset + 16 * count],
    out bytes output[offset .. offset + 16 * count],
    int count,
    range int offset);

/// A key schedule, ready to encrypt blocks. Built by `cipher`.
pub type Cipher {
    /// The standard expanded key, `rounds + 1` round keys of 16 octets, for the kernels.
    bytes schedule;
    /// Eight planes per round key, `(rounds + 1)` round keys: each round key's
    /// 16 octets broadcast to the four block slots of the bitsliced layout.
    Array<int> round_keys;
    int rounds;
}

/// Encrypts one 16-octet block; any other length traps. (A whole bitsliced
/// batch is computed and three of its four slots are thrown away: use
/// `encrypt_blocks` for more than one block.)
pub bytes Cipher.encrypt_block(bytes block) {
    if (block.size() != 16) {
        trap("aes: a block is 16 bytes");
    }
    return encrypt_blocks(block);
}

// Whether the kernels may run for this key: the CPU has them, they are not
// switched off, and the key is AES-128 or AES-256 (the round counts they take).
bool Cipher.has_kernel() {
    return (accel.features() & accel.AES) != 0 && (rounds == 10 || rounds == 14);
}

/// Encrypts `blocks`, any whole number of 16-octet blocks, each independently
/// (ECB -- the building block of CTR and GCM, not a mode to use on its own).
/// Any length that is not a multiple of 16 traps.
pub bytes Cipher.encrypt_blocks(bytes blocks) {
    int size = blocks.size();
    if (size % 16 != 0) {
        trap("aes: input must be a whole number of 16-octet blocks");
    }
    bytes out = [0; size];
    if (size > 0 && has_kernel()) {
        __k_aes_ecb(schedule, rounds, blocks, out, size / 16, 0);
        return out;
    }
    Array<int> planes = [0; 8];
    Array<int> words = [0; 8];
    int position = 0;
    while (position < size) {
        int batch = size - position;
        if (batch > 64) {
            batch = 64;
        }
        for (int j in 0 .. 8) {
            int octet_at = position + 8 * j;
            int word = 0;
            if (octet_at + 8 <= position + batch) {
                word = blocks[octet_at] | (blocks[octet_at + 1] << 8) | (blocks[octet_at + 2] << 16) | (blocks[octet_at + 3] << 24) | (blocks[octet_at + 4] << 32) | (blocks[octet_at + 5] << 40) | (blocks[octet_at + 6] << 48) | (blocks[octet_at + 7] << 56);
            }
            words[j] = word;
        }
        pack_planes(words, planes);
        encrypt_planes(planes, round_keys, rounds);
        unpack_planes(planes, words);
        int limit = batch;
        for (int j in 0 .. 8) {
            int word = words[j];
            for (int octet_index in 0 .. 8) {
                if (8 * j + octet_index < limit) {
                    out[position + 8 * j + octet_index] = word >> (8 * octet_index) & 0xFF;
                }
            }
        }
        position = position + batch;
    }
    return out;
}

/// CTR mode through the hardware kernel, if there is one: `out[0 .. count)`
/// becomes `data[0 .. count)` XOR the keystream of the 128-bit big-endian
/// counter block `counter` (16 octets), which is advanced in place by one per
/// block used (a partial last block counts as one). Returns `false` and does
/// nothing when this CPU has no kernel, so the caller runs its own loop.
/// `out` may be `data` itself. The increment is over all 128 bits, so a
/// caller whose counter is only the low 32 bits (GCM) must not wrap it.
pub bool Cipher.did_ctr_xor(bytes counter, bytes data, int count, bytes out) {
    return did_ctr_xor_at(counter, data, 0, count, out);
}

/// `ctr_xor` for `data[off .. off + count)` into `out[off .. off + count)`:
/// the same range of both, so a caller can work through a buffer in pieces.
pub bool Cipher.did_ctr_xor_at(bytes counter, bytes data, int off, int count, bytes out) {
    if (count <= 0 || !has_kernel() || counter.size() != 16) {
        return false;
    }
    int whole = count / 16;
    if (whole > 0) {
        __k_aes_ctr(schedule, rounds, counter, data, out, whole, off);
    }
    int rest = count - whole * 16;
    if (rest > 0) {
        bytes stream = encrypt_block(counter);
        for (int i in 0 .. rest) {
            out[off + whole * 16 + i] = data[off + whole * 16 + i] ^ stream[i];
        }
        int index = 15;
        while (index >= 0) {
            counter[index] = (counter[index] + 1) & 0xFF;
            if (counter[index] != 0) {
                index = 0 - 1;
            } else {
                index = index - 1;
            }
        }
    }
    return true;
}

// An 8x8 bit transpose inside each 64-bit word: bit 8 * m + b swaps with bit
// 8 * b + m. Three delta swaps; the masks keep `>>`'s sign fill out. Its own
// inverse.
int transpose_bits(int x) {
    int temp = (x ^ (x >> 7)) & 0x00AA_00AA_00AA_00AA;
    x = x ^ temp ^ (temp << 7);
    temp = (x ^ (x >> 14)) & 0x0000_CCCC_0000_CCCC;
    x = x ^ temp ^ (temp << 14);
    temp = (x ^ (x >> 28)) & 0x0000_0000_F0F0_F0F0;
    return x ^ temp ^ (temp << 28);
}

// The 8x8 byte transpose across eight words: byte b of out[j] is byte j of
// in[b]. Three delta swaps at 32, 16 and 8 bits. Its own inverse.
void transpose_bytes(Array<int> lanes) {
    for (int i in 0 .. 4) {
        int temp = (lanes[i] >> 32 ^ lanes[i + 4]) & 0x0000_0000_FFFF_FFFF;
        lanes[i + 4] = lanes[i + 4] ^ temp;
        lanes[i] = lanes[i] ^ temp << 32;
    }
    for (int i in 0 .. 8) {
        if (i % 4 < 2) {
            int temp = (lanes[i] >> 16 ^ lanes[i + 2]) & 0x0000_FFFF_0000_FFFF;
            lanes[i + 2] = lanes[i + 2] ^ temp;
            lanes[i] = lanes[i] ^ temp << 16;
        }
    }
    for (int i in 0 .. 4) {
        int temp = (lanes[2 * i] >> 8 ^ lanes[2 * i + 1]) & 0x00FF_00FF_00FF_00FF;
        lanes[2 * i + 1] = lanes[2 * i + 1] ^ temp;
        lanes[2 * i] = lanes[2 * i] ^ temp << 8;
    }
}

// Eight little-endian words of 64 state bytes (word j holds bytes 8j..8j+7)
// into eight planes (plane k, bit n = bit k of byte n).
void pack_planes(Array<int> words, Array<int> planes) {
    for (int j in 0 .. 8) {
        planes[j] = transpose_bits(words[j]);
    }
    transpose_bytes(planes);
}

// The inverse of `pack_planes`: planes into `words`.
void unpack_planes(Array<int> planes, Array<int> words) {
    for (int j in 0 .. 8) {
        words[j] = planes[j];
    }
    transpose_bytes(words);
    for (int j in 0 .. 8) {
        words[j] = transpose_bits(words[j]);
    }
}

// Four octets of `data` at `offset`, little-endian.
int word_le(bytes data, int offset) {
    return data[offset] | (data[offset + 1] << 8) | (data[offset + 2] << 16) | (data[offset + 3] << 24);
}

// SubBytes on the four bytes of a 32-bit word: the same circuit, with the
// bytes as positions 0-3 of each plane.
int substitute_word(int word) {
    int u_0 = (word >> 0 & 1) | (word >> 8 & 1) << 1 | (word >> 16 & 1) << 2 | (word >> 24 & 1) << 3;
    int u_1 = (word >> 1 & 1) | (word >> 9 & 1) << 1 | (word >> 17 & 1) << 2 | (word >> 25 & 1) << 3;
    int u_2 = (word >> 2 & 1) | (word >> 10 & 1) << 1 | (word >> 18 & 1) << 2 | (word >> 26 & 1) << 3;
    int u_3 = (word >> 3 & 1) | (word >> 11 & 1) << 1 | (word >> 19 & 1) << 2 | (word >> 27 & 1) << 3;
    int u_4 = (word >> 4 & 1) | (word >> 12 & 1) << 1 | (word >> 20 & 1) << 2 | (word >> 28 & 1) << 3;
    int u_5 = (word >> 5 & 1) | (word >> 13 & 1) << 1 | (word >> 21 & 1) << 2 | (word >> 29 & 1) << 3;
    int u_6 = (word >> 6 & 1) | (word >> 14 & 1) << 1 | (word >> 22 & 1) << 2 | (word >> 30 & 1) << 3;
    int u_7 = (word >> 7 & 1) | (word >> 15 & 1) << 1 | (word >> 23 & 1) << 2 | (word >> 31 & 1) << 3;
    int s_0 = 0;
    int s_1 = 0;
    int s_2 = 0;
    int s_3 = 0;
    int s_4 = 0;
    int s_5 = 0;
    int s_6 = 0;
    int s_7 = 0;
    int g_t1 = u_7 ^ u_4;
    int g_t2 = u_7 ^ u_2;
    int g_t3 = u_7 ^ u_1;
    int g_t4 = u_4 ^ u_2;
    int g_t5 = u_3 ^ u_1;
    int g_t6 = g_t1 ^ g_t5;
    int g_t7 = u_6 ^ u_5;
    int g_t8 = u_0 ^ g_t6;
    int g_t9 = u_0 ^ g_t7;
    int g_t10 = g_t6 ^ g_t7;
    int g_t11 = u_6 ^ u_2;
    int g_t12 = u_5 ^ u_2;
    int g_t13 = g_t3 ^ g_t4;
    int g_t14 = g_t6 ^ g_t11;
    int g_t15 = g_t5 ^ g_t11;
    int g_t16 = g_t5 ^ g_t12;
    int g_t17 = g_t9 ^ g_t16;
    int g_t18 = u_4 ^ u_0;
    int g_t19 = g_t7 ^ g_t18;
    int g_t20 = g_t1 ^ g_t19;
    int g_t21 = u_1 ^ u_0;
    int g_t22 = g_t7 ^ g_t21;
    int g_t23 = g_t2 ^ g_t22;
    int g_t24 = g_t2 ^ g_t10;
    int g_t25 = g_t20 ^ g_t17;
    int g_t26 = g_t3 ^ g_t16;
    int g_t27 = g_t1 ^ g_t12;
    int g_m1 = g_t13 & g_t6;
    int g_m2 = g_t23 & g_t8;
    int g_m3 = g_t14 ^ g_m1;
    int g_m4 = g_t19 & u_0;
    int g_m5 = g_m4 ^ g_m1;
    int g_m6 = g_t3 & g_t16;
    int g_m7 = g_t22 & g_t9;
    int g_m8 = g_t26 ^ g_m6;
    int g_m9 = g_t20 & g_t17;
    int g_m10 = g_m9 ^ g_m6;
    int g_m11 = g_t1 & g_t15;
    int g_m12 = g_t4 & g_t27;
    int g_m13 = g_m12 ^ g_m11;
    int g_m14 = g_t2 & g_t10;
    int g_m15 = g_m14 ^ g_m11;
    int g_m16 = g_m3 ^ g_m2;
    int g_m17 = g_m5 ^ g_t24;
    int g_m18 = g_m8 ^ g_m7;
    int g_m19 = g_m10 ^ g_m15;
    int g_m20 = g_m16 ^ g_m13;
    int g_m21 = g_m17 ^ g_m15;
    int g_m22 = g_m18 ^ g_m13;
    int g_m23 = g_m19 ^ g_t25;
    int g_m24 = g_m22 ^ g_m23;
    int g_m25 = g_m22 & g_m20;
    int g_m26 = g_m21 ^ g_m25;
    int g_m27 = g_m20 ^ g_m21;
    int g_m28 = g_m23 ^ g_m25;
    int g_m29 = g_m28 & g_m27;
    int g_m30 = g_m26 & g_m24;
    int g_m31 = g_m20 & g_m23;
    int g_m32 = g_m27 & g_m31;
    int g_m33 = g_m27 ^ g_m25;
    int g_m34 = g_m21 & g_m22;
    int g_m35 = g_m24 & g_m34;
    int g_m36 = g_m24 ^ g_m25;
    int g_m37 = g_m21 ^ g_m29;
    int g_m38 = g_m32 ^ g_m33;
    int g_m39 = g_m23 ^ g_m30;
    int g_m40 = g_m35 ^ g_m36;
    int g_m41 = g_m38 ^ g_m40;
    int g_m42 = g_m37 ^ g_m39;
    int g_m43 = g_m37 ^ g_m38;
    int g_m44 = g_m39 ^ g_m40;
    int g_m45 = g_m42 ^ g_m41;
    int g_m46 = g_m44 & g_t6;
    int g_m47 = g_m40 & g_t8;
    int g_m48 = g_m39 & u_0;
    int g_m49 = g_m43 & g_t16;
    int g_m50 = g_m38 & g_t9;
    int g_m51 = g_m37 & g_t17;
    int g_m52 = g_m42 & g_t15;
    int g_m53 = g_m45 & g_t27;
    int g_m54 = g_m41 & g_t10;
    int g_m55 = g_m44 & g_t13;
    int g_m56 = g_m40 & g_t23;
    int g_m57 = g_m39 & g_t19;
    int g_m58 = g_m43 & g_t3;
    int g_m59 = g_m38 & g_t22;
    int g_m60 = g_m37 & g_t20;
    int g_m61 = g_m42 & g_t1;
    int g_m62 = g_m45 & g_t4;
    int g_m63 = g_m41 & g_t2;
    int g_l0 = g_m61 ^ g_m62;
    int g_l1 = g_m50 ^ g_m56;
    int g_l2 = g_m46 ^ g_m48;
    int g_l3 = g_m47 ^ g_m55;
    int g_l4 = g_m54 ^ g_m58;
    int g_l5 = g_m49 ^ g_m61;
    int g_l6 = g_m62 ^ g_l5;
    int g_l7 = g_m46 ^ g_l3;
    int g_l8 = g_m51 ^ g_m59;
    int g_l9 = g_m52 ^ g_m53;
    int g_l10 = g_m53 ^ g_l4;
    int g_l11 = g_m60 ^ g_l2;
    int g_l12 = g_m48 ^ g_m51;
    int g_l13 = g_m50 ^ g_l0;
    int g_l14 = g_m52 ^ g_m61;
    int g_l15 = g_m55 ^ g_l1;
    int g_l16 = g_m56 ^ g_l0;
    int g_l17 = g_m57 ^ g_l1;
    int g_l18 = g_m58 ^ g_l8;
    int g_l19 = g_m63 ^ g_l4;
    int g_l20 = g_l0 ^ g_l1;
    int g_l21 = g_l1 ^ g_l7;
    int g_l22 = g_l3 ^ g_l12;
    int g_l23 = g_l18 ^ g_l2;
    int g_l24 = g_l15 ^ g_l9;
    int g_l25 = g_l6 ^ g_l10;
    int g_l26 = g_l7 ^ g_l9;
    int g_l27 = g_l8 ^ g_l10;
    int g_l28 = g_l11 ^ g_l14;
    int g_l29 = g_l11 ^ g_l17;
    s_7 = g_l6 ^ g_l24;
    s_6 = ~(g_l16 ^ g_l26);
    s_5 = ~(g_l19 ^ g_l28);
    s_4 = g_l6 ^ g_l21;
    s_3 = g_l20 ^ g_l22;
    s_2 = g_l25 ^ g_l29;
    s_1 = ~(g_l13 ^ g_l27);
    s_0 = ~(g_l6 ^ g_l23);
    int out = 0;
    out = out | (s_0 & 1) << 0 | (s_0 >> 1 & 1) << 8 | (s_0 >> 2 & 1) << 16 | (s_0 >> 3 & 1) << 24;
    out = out | (s_1 & 1) << 1 | (s_1 >> 1 & 1) << 9 | (s_1 >> 2 & 1) << 17 | (s_1 >> 3 & 1) << 25;
    out = out | (s_2 & 1) << 2 | (s_2 >> 1 & 1) << 10 | (s_2 >> 2 & 1) << 18 | (s_2 >> 3 & 1) << 26;
    out = out | (s_3 & 1) << 3 | (s_3 >> 1 & 1) << 11 | (s_3 >> 2 & 1) << 19 | (s_3 >> 3 & 1) << 27;
    out = out | (s_4 & 1) << 4 | (s_4 >> 1 & 1) << 12 | (s_4 >> 2 & 1) << 20 | (s_4 >> 3 & 1) << 28;
    out = out | (s_5 & 1) << 5 | (s_5 >> 1 & 1) << 13 | (s_5 >> 2 & 1) << 21 | (s_5 >> 3 & 1) << 29;
    out = out | (s_6 & 1) << 6 | (s_6 >> 1 & 1) << 14 | (s_6 >> 2 & 1) << 22 | (s_6 >> 3 & 1) << 30;
    out = out | (s_7 & 1) << 7 | (s_7 >> 1 & 1) << 15 | (s_7 >> 2 & 1) << 23 | (s_7 >> 3 & 1) << 31;
    return out;
}

// The expanded key, FIPS 197 §5.2. `i` and `rcon` are public.
Array<int> expand_words(bytes key, int rounds) {
    int key_words = key.size() / 4;
    int total = 4 * (rounds + 1);
    Array<int> words = [0; total];
    for (int index in 0 .. key_words) {
        words[index] = word_le(key, 4 * index);
    }
    int rcon = 1;
    for (int index in key_words .. total) {
        int previous = words[index - 1];
        if (index % key_words == 0) {
            int rotated = (previous >> 8 | (previous & 0xFF) << 24) & 0xFFFF_FFFF;
            previous = substitute_word(rotated) ^ rcon;
            rcon = rcon << 1;
            if (rcon > 0xFF) {
                rcon = rcon ^ 0x11B;
            }
        } else if (key_words > 6 && index % key_words == 4) {
            previous = substitute_word(previous);
        }
        words[index] = words[index - key_words] ^ previous;
    }
    return words;
}

/// The key schedule for `key`, 16 octets (AES-128) or 32 (AES-256); any other
/// length traps.
pub Cipher cipher(bytes key) {
    if (key.size() != 16 && key.size() != 32) {
        trap("aes: key must be 16 or 32 bytes");
    }
    int rounds = key.size() / 4 + 6;
    Array<int> words = expand_words(key, rounds);
    Array<int> round_keys = [0; 8 * (rounds + 1)];
    for (int round in 0 .. rounds + 1) {
        // The round key's 16 octets as two 64-bit words, packed into planes
        // (the same transposes the data takes), then repeated for the four
        // block slots.
        Array<int> halves = [0; 8];
        halves[0] = words[4 * round] | (words[4 * round + 1] << 32);
        halves[1] = words[4 * round + 2] | (words[4 * round + 3] << 32);
        Array<int> planes = [0; 8];
        pack_planes(halves, planes);
        for (int plane_index in 0 .. 8) {
            int plane = planes[plane_index] & 0xFFFF;
            round_keys[8 * round + plane_index] = plane | (plane << 16) | (plane << 32) | (plane << 48);
        }
    }
    bytes schedule = [0; 16 * (rounds + 1)];
    for (int index in 0 .. 4 * (rounds + 1)) {
        for (int j in 0 .. 4) {
            schedule[4 * index + j] = words[index] >> (8 * j) & 0xFF;
        }
    }
    return Cipher(schedule, round_keys, rounds);
}

// All rounds on one batch of four blocks, in planes. Everything lives in
// locals; each loop iteration is one full round (SubBytes circuit,
// ShiftRows, MixColumns, AddRoundKey) and the last round, which has no
// MixColumns, is written out after it.
void encrypt_planes(Array<int> planes, Array<int> round_keys, int rounds) {
    int p_0 = planes[0] ^ round_keys[0];
    int p_1 = planes[1] ^ round_keys[1];
    int p_2 = planes[2] ^ round_keys[2];
    int p_3 = planes[3] ^ round_keys[3];
    int p_4 = planes[4] ^ round_keys[4];
    int p_5 = planes[5] ^ round_keys[5];
    int p_6 = planes[6] ^ round_keys[6];
    int p_7 = planes[7] ^ round_keys[7];
    for (int round in 1 .. rounds) {
        int s_0 = 0;
        int s_1 = 0;
        int s_2 = 0;
        int s_3 = 0;
        int s_4 = 0;
        int s_5 = 0;
        int s_6 = 0;
        int s_7 = 0;
        int g_t1 = p_7 ^ p_4;
        int g_t2 = p_7 ^ p_2;
        int g_t3 = p_7 ^ p_1;
