// SHA-512 (FIPS 180-4), written in the language over `bytes` and the bit
// operators. Ed25519 (RFC 8032) uses SHA-512 throughout -- to expand a seed
// into a scalar and a nonce prefix, to derive the per-signature nonce, and
// to build the challenge scalar -- so this exists for `ed25519.m31`, not for
// git (which is SHA-1, `apps/git/sha1.m31`, and stays that way).
//
// API
// ---
//   sha512.Hasher h = sha512.Hasher();
//   h.update(chunk);            // as many times as you like
//   bytes d = h.digest();       // 64 octets; ends the hash
//
//   sha512.sum(data)            -> bytes, the 64 octets
//   sha512.hex(data)            -> str, 128 lowercase hex digits
//
// And SHA-384 (FIPS 180-4 §6.5), which is SHA-512 with a different set of
// initial chaining values and a digest cut to its first 48 octets -- nothing
// else differs, so it lives here rather than in a module that would copy the
// 80-round compression function. TLS 1.3 uses it for the
// `TLS_AES_256_GCM_SHA384` key schedule and for verifying the ECDSA-with-SHA384
// signatures on the certificate chains of real hosts.
//
//   sha512.Hasher h = sha512.sha384_hasher();   // then update/digest as above
//   bytes d = h.digest();       // 48 octets; ends the hash
//
//   sha512.sum384(data)         -> bytes, the 48 octets
//   sha512.hex384(data)         -> str, 96 lowercase hex digits
//
// --- why this is NOT sha1.m31 with bigger numbers ---------------------------
//
// `apps/git/sha1.m31` keeps every word comfortably inside 32 of this
// language's 64 bits, specifically so that `>>` -- which is an ARITHMETIC,
// sign-extending shift (reference §6.1) -- behaves as the logical shift
// SHA-1 needs, with no masking. SHA-512's words are the full 64 bits, so
// that trick has nowhere to hide: a SHA-512 word legitimately has its top
// bit set, and there is no unsigned type to fall back on.
//
// The masking formula the reference gives for a logical shift --
// `(x >> n) & ~(-1 << (64 - n))` -- gets the VALUE right, but does not
// change WHAT RUNS: `runtime/rt.h`'s `rt_ishr` is
//
//     a < 0 ? ~(~a >> n) : a >> n
//
// and that branch is taken on the sign of `a` regardless of what the caller
// does with the result afterwards. Ed25519 hashes secret data with this
// hash (the seed, and the nonce prefix -- RFC 8032 §5.1.6), and a nonce that
// leaks through timing is a straight line to key recovery (this is not
// hypothetical: reused/leaked ECDSA and EdDSA nonces have broken real
// systems, the Sony PS3 signing key among them) -- so a shift whose branch
// direction depends on the secret's bits is exactly the thing to avoid, not
// a cosmetic concern.
//
// **The fix: every 64-bit word is kept as a PAIR of 32-bit halves,
// `Word64 { hi; lo; }`, both always in [0, 2^32) -- i.e. always
// non-negative as a 64-bit `int`, whatever the word's own value is.** Every
// `>>` below shifts a `hi` or a `lo`, never a full 64-bit quantity, so the
// operand is PROVABLY non-negative by construction and `rt_ishr`'s branch
// always takes the same path, independent of the secret data flowing
// through it. This is the same reasoning `field25519.m31` documents at
// length for its own carry chain -- see that file's header for the fuller
// argument -- applied to a hash instead of a field. The formulas below
// (`add64`, `rotr64`, `shr64`) were derived and verified against plain
// 64-bit arithmetic before being written here; see the report this module
// shipped with for the verification method.
//
// This costs real code size and a constant-factor slowdown (every 64-bit
// operation is two or three 32-bit ones) against a hypothetical native
// 64-bit build. Given what a leaked Ed25519 nonce costs, that trade is not
// close.
//
// --- the constants ------------------------------------------------------
//
// `H_INIT` (the eight chaining values) and `K` (the eighty round constants)
// are FIPS 180-4's: the first 64 bits of the fractional part of the square
// root of the first 8 primes, and of the cube root of the first 80 primes,
// respectively. They were generated, not copied by hand, with:
//
//   import decimal
//   decimal.getcontext().prec = 60
//   def frac64(x):
//       f = x - int(x)
//       return int(f * (decimal.Decimal(2) ** 64))
//   H = [frac64(decimal.Decimal(p).sqrt()) for p in primes[:8]]
//   K = [frac64(cbrt(p)) for p in primes[:80]]        # Newton's method
//
// and checked against the values every published SHA-512 implementation
// uses (`0x6a09e667f3bcc908 .. 0x5be0cd19137e2179` for H, `0x428a2f98d728ae22
// .. 0x6c44198c4a475817` for K) before being written below as `hi`/`lo`
// pairs.

/// One 64-bit word, as two 32-bit halves -- see the header. Both fields are
/// always in `[0, 2^32)`; nothing outside this file should assume anything
/// else about them.
type Word64 {
    int high;
    int low;
}

const int M32 = 0xFFFF_FFFF;

// `a + b`, modulo 2^64, as a pair -- the only "overflow" SHA-512 has, and it
// is supposed to happen.
//
// CONSTANT TIME: `alo + blo` is a sum of two values in `[0, 2^32)`, so it is
// itself in `[0, 2^33)` -- never negative -- and the `>>` that pulls the
// carry out of it is shifting that always-non-negative sum, not either
// secret input. Every `&` below is the runtime's plain, unconditional
// bitwise operator (see `field25519.m31`'s header).
Word64 add64(Word64 first, Word64 second) {
    int low_bits = first.low + second.low;
    int carry = low_bits >> 32;
    int high_bits = (first.high + second.high + carry) & M32;
    return Word64(high_bits, low_bits & M32);
}

Word64 add3(Word64 first, Word64 second, Word64 third) {
    return add64(add64(first, second), third);
}

Word64 add4(Word64 first, Word64 second, Word64 third, Word64 fourth) {
    return add64(add3(first, second, third), fourth);
}

Word64 add5(Word64 first, Word64 second, Word64 third, Word64 fourth, Word64 fifth) {
    return add64(add4(first, second, third, fourth), fifth);
}

Word64 xor64(Word64 first, Word64 second) {
    return Word64(first.high ^ second.high, first.low ^ second.low);
}

Word64 and64(Word64 first, Word64 second) {
    return Word64(first.high & second.high, first.low & second.low);
}

Word64 not64(Word64 value) {
    return Word64(value.high ^ M32, value.low ^ M32);
}

// Rotate `value` right by `distance`, `1 <= n <= 63`. Three cases on which half of the
// 64 bits `distance` crosses into, all of them shifting only a `high_bits` or a `low_bits` --
// see the header for why that is the whole point.
Word64 rotr64(Word64 value, int distance) {
    if (distance < 32) {
        int low_bits = (value.low >> distance) | ((value.high << (32 - distance)) & M32);
        int high_bits = (value.high >> distance) | ((value.low << (32 - distance)) & M32);
        return Word64(high_bits, low_bits);
    }
    if (distance == 32) {
        return Word64(value.low, value.high);
    }
    int half_distance = distance - 32;
    int low_bits = (value.high >> half_distance) | ((value.low << (32 - half_distance)) & M32);
    int high_bits = (value.low >> half_distance) | ((value.high << (32 - half_distance)) & M32);
    return Word64(high_bits, low_bits);
}

// Logical shift right by `distance`, `1 <= n <= 63` -- as `rotr64`, but the bits
// that fall off the bottom of `high_bits` do not wrap back into `low_bits`'s top; they
// are just gone, and `high_bits`'s vacated top bits are zero.
Word64 shr64(Word64 value, int distance) {
    if (distance < 32) {
        int low_bits = (value.low >> distance) | ((value.high << (32 - distance)) & M32);
        int high_bits = value.high >> distance;
        return Word64(high_bits, low_bits);
    }
    if (distance == 32) {
        return Word64(0, value.high);
    }
    int half_distance = distance - 32;
    return Word64(0, value.high >> half_distance);
}

// The eight chaining values, FIPS 180-4 §5.3.5 -- see the header for where
// these numbers come from.
Array<Word64> h_init() {
    Array<Word64> initial_values = [Word64(0, 0); 8];
    initial_values[0] = Word64(0x6a09_e667, 0xf3bc_c908);
    initial_values[1] = Word64(0xbb67_ae85, 0x84ca_a73b);
    initial_values[2] = Word64(0x3c6e_f372, 0xfe94_f82b);
    initial_values[3] = Word64(0xa54f_f53a, 0x5f1d_36f1);
    initial_values[4] = Word64(0x510e_527f, 0xade6_82d1);
    initial_values[5] = Word64(0x9b05_688c, 0x2b3e_6c1f);
    initial_values[6] = Word64(0x1f83_d9ab, 0xfb41_bd6b);
    initial_values[7] = Word64(0x5be0_cd19, 0x137e_2179);
    return initial_values;
}

// SHA-384's eight chaining values, FIPS 180-4 §5.3.4: the first 64 bits of the
// fractional part of the square root of the ninth through sixteenth primes.
// The compression function and the round constants are SHA-512's, unchanged.
Array<Word64> h384_init() {
    Array<Word64> initial_values = [Word64(0, 0); 8];
    initial_values[0] = Word64(0xcbbb_9d5d, 0xc105_9ed8);
    initial_values[1] = Word64(0x629a_292a, 0x367c_d507);
    initial_values[2] = Word64(0x9159_015a, 0x3070_dd17);
    initial_values[3] = Word64(0x152f_ecd8, 0xf70e_5939);
    initial_values[4] = Word64(0x6733_2667, 0xffc0_0b31);
    initial_values[5] = Word64(0x8eb4_4a87, 0x6858_1511);
    initial_values[6] = Word64(0xdb0c_2e0d, 0x64f9_8fa7);
    initial_values[7] = Word64(0x47b5_481d, 0xbefa_4fa4);
    return initial_values;
}

