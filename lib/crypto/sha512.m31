// SHA-512 (FIPS 180-4), written in the language over `bytes` and the bit
// operators. Ed25519 (RFC 8032) uses SHA-512 throughout -- to expand a seed
// into a scalar and a nonce prefix, to derive the per-signature nonce, and
// to build the challenge scalar -- so this exists for `ed25519.m31`, not for
// git (which is SHA-1, `apps/git/sha1.m31`, and stays that way).
//
// API
// ---
//   sha512.Hasher h = sha512.Hasher();
//   h.update(chunk);            // as many times as you like
//   bytes d = h.digest();       // 64 octets; h starts over, ready for
//                               // the next message
//
//   sha512.sum(data)            -> bytes, the 64 octets
//   sha512.hex(data)            -> str, 128 lowercase hex digits
//
// And SHA-384 (FIPS 180-4 §6.5), which is SHA-512 with a different set of
// initial chaining values and a digest cut to its first 48 octets -- nothing
// else differs, so it lives here rather than in a module that would copy the
// 80-round compression function. TLS 1.3 uses it for the
// `TLS_AES_256_GCM_SHA384` key schedule and for verifying the ECDSA-with-SHA384
// signatures on the certificate chains of real hosts.
//
//   sha512.Hasher h = sha512.sha384_hasher();   // then update/digest as above
//   bytes d = h.digest();       // 48 octets; h starts over
//
//   sha512.sum384(data)         -> bytes, the 48 octets
//   sha512.hex384(data)         -> str, 96 lowercase hex digits
//
// --- words and constant time ----------------------------------------------
//
// Each 64-bit word is a plain `int`, and the additions are `wrapping_add`
// (modulo 2^64, never a trap). SHA-512 needs a LOGICAL right shift and `>>`
// is arithmetic (reference §6.1), so `shr` masks off the copied sign bits.
//
// Ed25519 hashes secret data with this (the seed and the nonce prefix, RFC
// 8032 §5.1.6), and password hashing builds on it, so nothing here may branch
// on a word's value. `>>` does not: `rt_ishr` in runtime/rt.h computes the
// arithmetic shift from the logical one and a mask built from the sign bit,
// with no branch on the operand. (An earlier version kept every word as a
// `Word64` object of two 32-bit halves because `rt_ishr` used to branch on
// the sign; that allocated per operation and made a 5000-round SHA-512-crypt
// verify take about 650 ms instead of about 30 ms.)
//
// `H512` and `K512` are FIPS 180-4's: the first 64 bits of the fractional
// parts of the square roots of the first 8 primes and the cube roots of the
// first 80 primes. They were generated, not copied by hand, and checked
// against the values every published implementation uses.

// FIPS 180-4 §5.3.5, the initial chaining values.
const Array<int> H512 = [
    0x6a09_e667_f3bc_c908, 0xbb67_ae85_84ca_a73b, 0x3c6e_f372_fe94_f82b, 0xa54f_f53a_5f1d_36f1,
    0x510e_527f_ade6_82d1, 0x9b05_688c_2b3e_6c1f, 0x1f83_d9ab_fb41_bd6b, 0x5be0_cd19_137e_2179
];

// FIPS 180-4 §4.2.3, the round constants.
const Array<int> K512 = [
    0x428a_2f98_d728_ae22, 0x7137_4491_23ef_65cd, 0xb5c0_fbcf_ec4d_3b2f, 0xe9b5_dba5_8189_dbbc,
    0x3956_c25b_f348_b538, 0x59f1_11f1_b605_d019, 0x923f_82a4_af19_4f9b, 0xab1c_5ed5_da6d_8118,
    0xd807_aa98_a303_0242, 0x1283_5b01_4570_6fbe, 0x2431_85be_4ee4_b28c, 0x550c_7dc3_d5ff_b4e2,
    0x72be_5d74_f27b_896f, 0x80de_b1fe_3b16_96b1, 0x9bdc_06a7_25c7_1235, 0xc19b_f174_cf69_2694,
    0xe49b_69c1_9ef1_4ad2, 0xefbe_4786_384f_25e3, 0x0fc1_9dc6_8b8c_d5b5, 0x240c_a1cc_77ac_9c65,
    0x2de9_2c6f_592b_0275, 0x4a74_84aa_6ea6_e483, 0x5cb0_a9dc_bd41_fbd4, 0x76f9_88da_8311_53b5,
    0x983e_5152_ee66_dfab, 0xa831_c66d_2db4_3210, 0xb003_27c8_98fb_213f, 0xbf59_7fc7_beef_0ee4,
    0xc6e0_0bf3_3da8_8fc2, 0xd5a7_9147_930a_a725, 0x06ca_6351_e003_826f, 0x1429_2967_0a0e_6e70,
    0x27b7_0a85_46d2_2ffc, 0x2e1b_2138_5c26_c926, 0x4d2c_6dfc_5ac4_2aed, 0x5338_0d13_9d95_b3df,
    0x650a_7354_8baf_63de, 0x766a_0abb_3c77_b2a8, 0x81c2_c92e_47ed_aee6, 0x9272_2c85_1482_353b,
    0xa2bf_e8a1_4cf1_0364, 0xa81a_664b_bc42_3001, 0xc24b_8b70_d0f8_9791, 0xc76c_51a3_0654_be30,
    0xd192_e819_d6ef_5218, 0xd699_0624_5565_a910, 0xf40e_3585_5771_202a, 0x106a_a070_32bb_d1b8,
    0x19a4_c116_b8d2_d0c8, 0x1e37_6c08_5141_ab53, 0x2748_774c_df8e_eb99, 0x34b0_bcb5_e19b_48a8,
    0x391c_0cb3_c5c9_5a63, 0x4ed8_aa4a_e341_8acb, 0x5b9c_ca4f_7763_e373, 0x682e_6ff3_d6b2_b8a3,
    0x748f_82ee_5def_b2fc, 0x78a5_636f_4317_2f60, 0x84c8_7814_a1f0_ab72, 0x8cc7_0208_1a64_39ec,
    0x90be_fffa_2363_1e28, 0xa450_6ceb_de82_bde9, 0xbef9_a3f7_b2c6_7915, 0xc671_78f2_e372_532b,
    0xca27_3ece_ea26_619c, 0xd186_b8c7_21c0_c207, 0xeada_7dd6_cde0_eb1e, 0xf57d_4f7f_ee6e_d178,
    0x06f0_67aa_7217_6fba, 0x0a63_7dc5_a2c8_98a6, 0x113f_9804_bef9_0dae, 0x1b71_0b35_131c_471b,
    0x28db_77f5_2304_7d84, 0x32ca_ab7b_40c7_2493, 0x3c9e_be0a_15c9_bebc, 0x431d_67c4_9c10_0d4c,
    0x4cc5_d4be_cb3e_42b6, 0x597f_299c_fc65_7e2a, 0x5fcb_6fab_3ad6_faec, 0x6c44_198c_4a47_5817
];

// SHA-384's eight chaining values, FIPS 180-4 §5.3.4: the first 64 bits of the
// fractional part of the square root of the ninth through sixteenth primes.
// The compression function and the round constants are SHA-512's, unchanged.
const Array<int> H384 = [
    0xcbbb_9d5d_c105_9ed8, 0x629a_292a_367c_d507, 0x9159_015a_3070_dd17, 0x152f_ecd8_f70e_5939,
    0x6733_2667_ffc0_0b31, 0x8eb4_4a87_6858_1511, 0xdb0c_2e0d_64f9_8fa7, 0x47b5_481d_befa_4fa4
];

/// The chaining state and everything `update`/`digest` need across calls.
/// `Hasher()` is the whole of "start a hash".
pub type Hasher {
    Array<int> state = clone(H512);
    /// Octets seen so far, for the 128-bit length field. Kept as one `int`
    /// (a message longer than 2^63 octets is not supported), so the top 8
    /// octets of the length field are always zero.
    int total = 0;
    /// How many octets of the final chaining value `digest` returns: 64 for
    /// SHA-512, 48 for SHA-384 (`sha384_hasher`).
    int digest_size = 64;
    /// The partial block: always fewer than 128 octets between `update`s.
    bytes tail = [];
    /// The message schedule, held across blocks so no block allocates.
    Array<int> schedule = [0; 80];
}

/// Feed `data` to the hash. Any number of calls, of any sizes, hash the same
/// as one call with them joined.
pub void Hasher.update(bytes data) {
    int data_length = data.size();
    total = total + data_length;
    int offset = 0;
    if (tail.size() > 0) {
        while (offset < data_length && tail.size() < 128) {
            tail.push(data[offset]);
            offset = offset + 1;
        }
        if (tail.size() == 128) {
            block(tail, 0);
            tail.clear();
        }
    }
    while (data_length - offset >= 128) {
        block(data, offset);
        offset = offset + 128;
    }
    while (offset < data_length) {
        tail.push(data[offset]);
        offset = offset + 1;
    }
}

/// The digest: 64 octets, or 48 for a `sha384_hasher`. The hasher then starts
/// over, so the next `update` begins a new message.
pub bytes Hasher.digest() {
    int bits = total * 8;
    tail.push(0x80);
    while (tail.size() % 128 != 112) {
        tail.push(0);
    }
    // The 128-bit big-endian length: 8 octets of zero (see the field
    // comment on `total`), then the 64-bit bit count.
    for (int padding_index in 0 .. 8) {
        tail.push(0);
    }
    int shift = 56;
    while (shift >= 0) {
        tail.push(bits >> shift & 0xFF);
        shift = shift - 8;
    }
    int offset = 0;
    int tail_length = tail.size();
    while (offset < tail_length) {
        block(tail, offset);
        offset = offset + 128;
    }
    tail.clear();
    bytes out = [];
    for (int word in state) {
        for (int shift_index in 0 .. 8) {
            out.push((word >> (56 - shift_index * 8)) & 0xFF);
        }
    }
    out.truncate(digest_size);
    restart();
    return out;
}

// Back to the initial chaining values for this hasher's digest size, so the
// next `update` begins a new message. SHA-512-crypt hashes thousands of short
// messages in a row; this spares it a new `Hasher` for each.
void Hasher.restart() {
    for (int index in 0 .. 8) {
        if (digest_size == 48) {
            state[index] = H384[index];
        } else {
            state[index] = H512[index];
        }
    }
    total = 0;
}

// One 128-octet block, read from `data` starting at `offset`.
void Hasher.block(bytes data, int offset) {
    for (int index in 0 .. 16) {
        int word = 0;
        for (int octet_index in 0 .. 8) {
            word = (word << 8) | data[offset + index * 8 + octet_index];
        }
        schedule[index] = word;
    }
    for (int index in 16 .. 80) {
        int early = schedule[index - 15];
        int late = schedule[index - 2];
        int small_sigma_0 = rotr(early, 1) ^ rotr(early, 8) ^ shr(early, 7);
        int small_sigma_1 = rotr(late, 19) ^ rotr(late, 61) ^ shr(late, 6);
        schedule[index] = schedule[index - 16].wrapping_add(small_sigma_0).wrapping_add(schedule[index - 7]).wrapping_add(small_sigma_1);
    }
    int working_a = state[0];
    int working_b = state[1];
    int working_c = state[2];
    int working_d = state[3];
    int working_e = state[4];
    int working_f = state[5];
    int working_g = state[6];
    int working_h = state[7];
    for (int index in 0 .. 80) {
        int big_sigma_1 = rotr(working_e, 14) ^ rotr(working_e, 18) ^ rotr(working_e, 41);
        int choose = (working_e & working_f) ^ (~working_e & working_g);
        int temp1 = working_h.wrapping_add(big_sigma_1).wrapping_add(choose).wrapping_add(K512[index]).wrapping_add(schedule[index]);
        int big_sigma_0 = rotr(working_a, 28) ^ rotr(working_a, 34) ^ rotr(working_a, 39);
        int majority = (working_a & working_b) ^ (working_a & working_c) ^ (working_b & working_c);
        int temp2 = big_sigma_0.wrapping_add(majority);
        working_h = working_g;
        working_g = working_f;
        working_f = working_e;
        working_e = working_d.wrapping_add(temp1);
        working_d = working_c;
        working_c = working_b;
        working_b = working_a;
        working_a = temp1.wrapping_add(temp2);
    }
    state[0] = state[0].wrapping_add(working_a);
    state[1] = state[1].wrapping_add(working_b);
    state[2] = state[2].wrapping_add(working_c);
    state[3] = state[3].wrapping_add(working_d);
    state[4] = state[4].wrapping_add(working_e);
    state[5] = state[5].wrapping_add(working_f);
    state[6] = state[6].wrapping_add(working_g);
    state[7] = state[7].wrapping_add(working_h);
}

/// The digest of `data`, in one call.
pub bytes sum(bytes data) {
    Hasher hasher = Hasher();
    hasher.update(data);
    return hasher.digest();
}

/// The digest of `data` as 128 lowercase hex digits.
pub str hex(bytes data) {
    return sum(data).hex();
}

/// A `Hasher` that computes SHA-384 instead of SHA-512: SHA-384's initial
/// chaining values and a 48-octet digest, the same `update` and `block`.
pub Hasher sha384_hasher() {
    Hasher hasher = Hasher();
    hasher.state = clone(H384);
    hasher.digest_size = 48;
    return hasher;
}

/// The SHA-384 digest of `data`, 48 octets, in one call.
pub bytes sum384(bytes data) {
    Hasher hasher = sha384_hasher();
    hasher.update(data);
    return hasher.digest();
}

/// The SHA-384 digest of `data` as 96 lowercase hex digits.
pub str hex384(bytes data) {
    return sum384(data).hex();
}

// Logical shift right, 1 <= distance <= 63: the arithmetic shift with the
// copied sign bits masked off.
int shr(int value, int distance) {
    return (value >> distance) & ~(-1 << (64 - distance));
}

// Rotate right, 1 <= distance <= 63.
int rotr(int value, int distance) {
    return shr(value, distance) | (value << (64 - distance));
}
