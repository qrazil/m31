/// Offset-basis chaining state and everything `update`/`digest` need across
/// calls -- the fields are defaults so that `Hasher()` is the whole of
/// "start a hash", as in `sha1.m31`.
///
/// `k`, the eighty round constants, is a per-instance field rather than a
/// module `const`, because a module constant may only be an int, float,
/// bool, str or bytes (or an `Array`/`List`/`Map` of those) -- `Word64` is a
/// user type, so it does not qualify, the same restriction `sched` (below)
/// and `h` are already written around.
pub type Hasher {
    Array<Word64> h = h_init();
    Array<Word64> k = k_init();
    /// Octets seen so far, for the 128-bit length field. Kept as one `int`
    /// (so a message longer than 2^63 octets is not supported -- no value
    /// this language can hold reaches memory anywhere near that size, so
    /// the 128-bit field FIPS 180-4 specifies is written with its top 8
    /// octets always zero).
    int total = 0;
    /// How many octets of the final chaining value `digest` returns: 64 for
    /// SHA-512, 48 for SHA-384 (`sha384_hasher`).
    int digest_size = 64;
    /// The partial block: always fewer than 128 octets between `update`s.
    bytes tail = [];
    /// The message schedule, held across blocks -- see `sha1.m31`'s note on
    /// why a field beats a fresh local per block.
    Array<Word64> sched = [Word64(0, 0); 80];
}

/// Feed `data` to the hash. Any number of calls, of any sizes, hash the same
/// as one call with them joined.
pub void Hasher.update(bytes data) {
    int n = data.size();
    total = total + n;
    int i = 0;
    if (tail.size() > 0) {
        while (i < n && tail.size() < 128) {
            tail.push(data[i]);
            i = i + 1;
        }
        if (tail.size() == 128) {
            block(tail, 0);
            tail.clear();
        }
    }
    while (n - i >= 128) {
        block(data, i);
        i = i + 128;
    }
    while (i < n) {
        tail.push(data[i]);
        i = i + 1;
    }
}

/// The digest: 64 octets, or 48 for a `sha384_hasher`. Ends the hash, exactly
/// as `sha1.m31`'s `digest` does: make a new `Hasher` for a new message.
pub bytes Hasher.digest() {
    int bits = total * 8;
    tail.push(0x80);
    while (tail.size() % 128 != 112) {
        tail.push(0);
    }
    // The 128-bit big-endian length: 8 octets of zero (see the field
    // comment on `total`), then the 64-bit bit count.
    for (int z in 0 .. 8) {
        tail.push(0);
    }
    int s = 56;
    while (s >= 0) {
        tail.push(bits >> s & 0xFF);
        s = s - 8;
    }
    int i = 0;
    int n = tail.size();
    while (i < n) {
        block(tail, i);
        i = i + 128;
    }
    tail.clear();
    bytes out = [];
    for (int w in 0 .. 8) {
        word(out, h[w]);
    }
    out.truncate(digest_size);
    return out;
}

// One 128-octet block, read from `b` starting at `at`.
void Hasher.block(bytes b, int at) {
    Array<Word64> w = sched;
    for (int i in 0 .. 16) {
        int j = at + i * 8;
        int hi = (b[j] << 24) | (b[j + 1] << 16) | (b[j + 2] << 8) | b[j + 3];
        int lo = (b[j + 4] << 24) | (b[j + 5] << 16) | (b[j + 6] << 8) | b[j + 7];
        w[i] = Word64(hi, lo);
    }
    for (int i in 16 .. 80) {
        Word64 s0 = xor64(xor64(rotr64(w[i - 15], 1), rotr64(w[i - 15], 8)), shr64(w[i - 15], 7));
        Word64 s1 = xor64(xor64(rotr64(w[i - 2], 19), rotr64(w[i - 2], 61)), shr64(w[i - 2], 6));
        w[i] = add4(w[i - 16], s0, w[i - 7], s1);
    }
    Word64 a = h[0];
    Word64 bb = h[1];
    Word64 c = h[2];
    Word64 d = h[3];
    Word64 e = h[4];
    Word64 f = h[5];
    Word64 g = h[6];
    Word64 hh = h[7];
    for (int i in 0 .. 80) {
        Word64 s1 = xor64(xor64(rotr64(e, 14), rotr64(e, 18)), rotr64(e, 41));
        Word64 ch = xor64(and64(e, f), and64(not64(e), g));
        Word64 temp1 = add5(hh, s1, ch, k[i], w[i]);
        Word64 s0 = xor64(xor64(rotr64(a, 28), rotr64(a, 34)), rotr64(a, 39));
        Word64 maj = xor64(xor64(and64(a, bb), and64(a, c)), and64(bb, c));
        Word64 temp2 = add64(s0, maj);
        hh = g;
        g = f;
        f = e;
        e = add64(d, temp1);
        d = c;
        c = bb;
        bb = a;
        a = add64(temp1, temp2);
    }
    h[0] = add64(h[0], a);
    h[1] = add64(h[1], bb);
    h[2] = add64(h[2], c);
    h[3] = add64(h[3], d);
    h[4] = add64(h[4], e);
    h[5] = add64(h[5], f);
    h[6] = add64(h[6], g);
    h[7] = add64(h[7], hh);
}

/// The digest of `data`, in one call.
pub bytes sum(bytes data) {
    Hasher h = Hasher();
    h.update(data);
    return h.digest();
}

/// The digest of `data` as 128 lowercase hex digits.
pub str hex(bytes data) {
    return sum(data).hex();
}

/// A `Hasher` that computes SHA-384 instead of SHA-512: SHA-384's initial
/// chaining values and a 48-octet digest, the same `update` and `block`.
pub Hasher sha384_hasher() {
    Hasher hasher = Hasher();
    hasher.h = h384_init();
    hasher.digest_size = 48;
    return hasher;
}

/// The SHA-384 digest of `data`, 48 octets, in one call.
pub bytes sum384(bytes data) {
    Hasher hasher = sha384_hasher();
    hasher.update(data);
    return hasher.digest();
}

/// The SHA-384 digest of `data` as 96 lowercase hex digits.
pub str hex384(bytes data) {
    return sum384(data).hex();
}

// A 64-bit word appended big-endian, as two 32-bit big-endian halves.
void word(bytes out, Word64 v) {
    out.push(v.hi >> 24 & 0xFF);
    out.push(v.hi >> 16 & 0xFF);
    out.push(v.hi >> 8 & 0xFF);
    out.push(v.hi & 0xFF);
    out.push(v.lo >> 24 & 0xFF);
    out.push(v.lo >> 16 & 0xFF);
    out.push(v.lo >> 8 & 0xFF);
    out.push(v.lo & 0xFF);
}
