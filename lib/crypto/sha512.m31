/// Offset-basis chaining state and everything `update`/`digest` need across
/// calls -- the fields are defaults so that `Hasher()` is the whole of
/// "start a hash", as in `sha1.m31`.
///
/// `k`, the eighty round constants, is a per-instance field rather than a
/// module `const`, because a module constant may only be an int, float,
/// bool, str or bytes (or an `Array`/`List`/`Map` of those) -- `Word64` is a
/// user type, so it does not qualify, the same restriction `sched` (below)
/// and `h` are already written around.
pub type Hasher {
    Array<Word64> state = h_init();
    Array<Word64> round_constants = k_init();
    /// Octets seen so far, for the 128-bit length field. Kept as one `int`
    /// (so a message longer than 2^63 octets is not supported -- no value
    /// this language can hold reaches memory anywhere near that size, so
    /// the 128-bit field FIPS 180-4 specifies is written with its top 8
    /// octets always zero).
    int total = 0;
    /// How many octets of the final chaining value `digest` returns: 64 for
    /// SHA-512, 48 for SHA-384 (`sha384_hasher`).
    int digest_size = 64;
    /// The partial block: always fewer than 128 octets between `update`s.
    bytes tail = [];
    /// The message schedule, held across blocks -- see `sha1.m31`'s note on
    /// why a field beats a fresh local per block.
    Array<Word64> sched = [Word64(0, 0); 80];
}

/// Feed `data` to the hash. Any number of calls, of any sizes, hash the same
/// as one call with them joined.
pub void Hasher.update(bytes data) {
    int data_length = data.size();
    total = total + data_length;
    int offset = 0;
    if (tail.size() > 0) {
        while (offset < data_length && tail.size() < 128) {
            tail.push(data[offset]);
            offset = offset + 1;
        }
        if (tail.size() == 128) {
            block(tail, 0);
            tail.clear();
        }
    }
    while (data_length - offset >= 128) {
        block(data, offset);
        offset = offset + 128;
    }
    while (offset < data_length) {
        tail.push(data[offset]);
        offset = offset + 1;
    }
}

/// The digest: 64 octets, or 48 for a `sha384_hasher`. Ends the hash, exactly
/// as `sha1.m31`'s `digest` does: make a new `Hasher` for a new message.
pub bytes Hasher.digest() {
    int bits = total * 8;
    tail.push(0x80);
    while (tail.size() % 128 != 112) {
        tail.push(0);
    }
    // The 128-bit big-endian length: 8 octets of zero (see the field
    // comment on `total`), then the 64-bit bit count.
    for (int padding_index in 0 .. 8) {
        tail.push(0);
    }
    int shift = 56;
    while (shift >= 0) {
        tail.push(bits >> shift & 0xFF);
        shift = shift - 8;
    }
    int offset = 0;
    int tail_length = tail.size();
    while (offset < tail_length) {
        block(tail, offset);
        offset = offset + 128;
    }
    tail.clear();
    bytes out = [];
    for (int word_index in 0 .. 8) {
        word(out, state[word_index]);
    }
    out.truncate(digest_size);
    return out;
}

// One 128-octet block, read from `data` starting at `offset`.
void Hasher.block(bytes data, int offset) {
    Array<Word64> message_words = sched;
    for (int i in 0 .. 16) {
        int byte_offset = offset + i * 8;
        int high_bits = (data[byte_offset] << 24) | (data[byte_offset + 1] << 16) | (data[byte_offset + 2] << 8) | data[byte_offset + 3];
        int low_bits = (data[byte_offset + 4] << 24) | (data[byte_offset + 5] << 16) | (data[byte_offset + 6] << 8) | data[byte_offset + 7];
        message_words[i] = Word64(high_bits, low_bits);
    }
    for (int i in 16 .. 80) {
        Word64 small_sigma_0 = xor64(xor64(rotr64(message_words[i - 15], 1), rotr64(message_words[i - 15], 8)), shr64(message_words[i - 15], 7));  // FIPS 180-4 §6.4.2: σ0
        Word64 small_sigma_1 = xor64(xor64(rotr64(message_words[i - 2], 19), rotr64(message_words[i - 2], 61)), shr64(message_words[i - 2], 6));  // FIPS 180-4 §6.4.2: σ1
        message_words[i] = add4(message_words[i - 16], small_sigma_0, message_words[i - 7], small_sigma_1);
    }
    Word64 working_a = state[0];  // FIPS 180-4 §6.4.2: a
    Word64 working_b = state[1];  // FIPS 180-4 §6.4.2: b
    Word64 working_c = state[2];  // FIPS 180-4 §6.4.2: c
    Word64 working_d = state[3];  // FIPS 180-4 §6.4.2: d
    Word64 working_e = state[4];  // FIPS 180-4 §6.4.2: e
    Word64 working_f = state[5];  // FIPS 180-4 §6.4.2: f
    Word64 working_g = state[6];  // FIPS 180-4 §6.4.2: g
    Word64 working_h = state[7];  // FIPS 180-4 §6.4.2: h
    for (int i in 0 .. 80) {
        Word64 big_sigma_1 = xor64(xor64(rotr64(working_e, 14), rotr64(working_e, 18)), rotr64(working_e, 41));  // FIPS 180-4 §4.1.3: Σ1
        Word64 choose = xor64(and64(working_e, working_f), and64(not64(working_e), working_g));  // FIPS 180-4 §4.1.3: Ch
        Word64 temp1 = add5(working_h, big_sigma_1, choose, round_constants[i], message_words[i]);
        Word64 big_sigma_0 = xor64(xor64(rotr64(working_a, 28), rotr64(working_a, 34)), rotr64(working_a, 39));  // FIPS 180-4 §4.1.3: Σ0
        Word64 maj = xor64(xor64(and64(working_a, working_b), and64(working_a, working_c)), and64(working_b, working_c));
        Word64 temp2 = add64(big_sigma_0, maj);
        working_h = working_g;
        working_g = working_f;
        working_f = working_e;
        working_e = add64(working_d, temp1);
        working_d = working_c;
        working_c = working_b;
        working_b = working_a;
        working_a = add64(temp1, temp2);
    }
    state[0] = add64(state[0], working_a);
    state[1] = add64(state[1], working_b);
    state[2] = add64(state[2], working_c);
    state[3] = add64(state[3], working_d);
    state[4] = add64(state[4], working_e);
    state[5] = add64(state[5], working_f);
    state[6] = add64(state[6], working_g);
    state[7] = add64(state[7], working_h);
}

/// The digest of `data`, in one call.
pub bytes sum(bytes data) {
    Hasher hasher = Hasher();
    hasher.update(data);
    return hasher.digest();
}

/// The digest of `data` as 128 lowercase hex digits.
pub str hex(bytes data) {
    return sum(data).hex();
}

/// A `Hasher` that computes SHA-384 instead of SHA-512: SHA-384's initial
/// chaining values and a 48-octet digest, the same `update` and `block`.
pub Hasher sha384_hasher() {
    Hasher hasher = Hasher();
    hasher.state = h384_init();
    hasher.digest_size = 48;
    return hasher;
}

/// The SHA-384 digest of `data`, 48 octets, in one call.
pub bytes sum384(bytes data) {
    Hasher hasher = sha384_hasher();
    hasher.update(data);
    return hasher.digest();
}

/// The SHA-384 digest of `data` as 96 lowercase hex digits.
pub str hex384(bytes data) {
    return sum384(data).hex();
}

// A 64-bit word appended big-endian, as two 32-bit big-endian halves.
void word(bytes out, Word64 value) {
    out.push(value.high >> 24 & 0xFF);
    out.push(value.high >> 16 & 0xFF);
    out.push(value.high >> 8 & 0xFF);
    out.push(value.high & 0xFF);
    out.push(value.low >> 24 & 0xFF);
    out.push(value.low >> 16 & 0xFF);
    out.push(value.low >> 8 & 0xFF);
    out.push(value.low & 0xFF);
}
