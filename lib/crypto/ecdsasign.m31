// ECDSA SIGNING over NIST P-256 (FIPS 186-5, SEC 1 v2) with deterministic
// nonces (RFC 6979): what a TLS 1.3 server needs to answer its
// CertificateVerify when its certificate holds a P-256 key.
//
// API
// ---
//   Result<bytes, ecdsasign.Error> pub = ecdsasign.public_key(secret);
//         // secret: the 32-octet big-endian private scalar d, 1 <= d < n.
//         // pub: 0x04 || X || Y, 65 octets.
//   Result<bytes, ecdsasign.Error> sig = ecdsasign.sign(secret, digest);
//         // digest: the 32-octet SHA-256 of the message, already computed.
//         // sig: DER SEQUENCE { INTEGER r, INTEGER s }, what TLS puts on the wire.
//   Result<bytes, ecdsasign.Error> raw = ecdsasign.sign_raw(secret, digest);   // r || s, 64 octets
//
// Verification is `ecdsa.m31`'s; the two agree (`ecdsa.verify_der` accepts
// what `sign` returns), and this module never imports it.
//
// --- what is constant time here, and what is not -----------------------------
//
// Read this before relying on the module. The claims are about THE SOURCE;
// nobody has measured the machine code (see the last paragraph).
//
//   CONSTANT-TIME-STYLE (no branch, no memory index, no loop count depends
//   on a secret value):
//     - the scalar multiplications `d*G` and `k*G` (`scalar_multiply`): a
//       fixed 256 iterations of "double, add, then SELECT with a mask", over
//       the COMPLETE projective addition law of Renes, Costello and Batina
//       (2015, Algorithm 4, for a = -3). Complete means it has no exceptional
//       input -- P + P, P + (-P) and P + infinity go through the same
//       arithmetic as any pair -- so "always add, keep the sum or not by
//       mask" is well defined and nothing branches on which case it is.
//     - every field operation on a secret (`multiply`, `add`, `subtract`):
//       fixed loop counts over 11 limbs, and the final "subtract the modulus
//       if needed" is a mask-select on the borrow, never an `if`.
//     - the modular inverse of the nonce `k` and the multiplication
//       `k^-1 * (e + r*d)`: Fermat exponentiation, whose exponent (n - 2) is
//       a public constant, so branching on its bits leaks nothing.
//     - nonce generation: HMAC-SHA-256 over secret octets. This inherits
//       `hmac.m31`/`sha256.m31`, which use only additions, rotates and
//       bitwise operators on 32-bit words and never branch on data.
//
//   NOT constant time, deliberately, because the value is public by then:
//     - the affine conversion's final steps and the DER encoding of `r` and
//       `s`, which are sent to the peer;
//     - the RFC 6979 rejection loop (draw again if the candidate is 0, >= n,
//       or gives r = 0 or s = 0): it leaks that a draw was rejected, an event
//       of probability about 2^-32, and nothing about the accepted nonce;
//     - the setup of the two field contexts, which reads public constants
//       through `bignum.m31` (which is NOT constant time and is never fed a
//       secret here).
//
//   One language fact this file is written around: the runtime's `>>` is
//   `a < 0 ? ~(~a >> n) : a >> n`, a branch on the sign of `a`. This file
//   never shifts a value that can be negative: borrows are computed from a
//   difference biased by +2^24 first, so every `>>` here has a non-negative
//   operand and takes the same side whatever the secret is. Overflow-checked
//   `+ - *` branch on the overflow flag, but every intermediate here is far
//   below 2^63 (limbs under 2^24, products under 2^48, sums under 2^50), so
//   that branch is never taken for ANY input.
//
//   What is NOT verified: that the C compiler, at every version and -O level,
//   keeps the masked selects branch-free and does not turn a table of
//   mask arithmetic back into a data-dependent branch. This is the known-hard
//   part of constant-time C. The source is written to give it nothing to
//   undo; the machine code was not audited, and no timing measurement across
//   secret inputs was made. Treat the module as hardened against timing
//   attacks in design, not as certified.
//
// --- representation -------------------------------------------------------------
//
// 24-bit limbs, 11 of them (264 bits for a 256-bit modulus), little-endian,
// the same layout `bignum.m31` documents; Montgomery form with R = 2^264 for
// the field GF(p) and, separately, for the group order n.

import crypto.bignum;
import encoding.hexcodec;
import crypto.hmac;

const int WIDTH = 11;
const int LIMB_BITS = 24;
const int LIMB_MASK = 0xFFFFFF;
const int LIMB_RADIX = 0x1000000;
const int SIZE = 32;
const str PRIME_HEX = "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff";
const str ORDER_HEX = "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551";
const str COEFFICIENT_B_HEX = "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b";
const str GENERATOR_X_HEX = "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296";
const str GENERATOR_Y_HEX = "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5";

/// Why a signing request was refused. Payload-free, and none of them says
/// anything about the key's value.
pub enum Error {
    /// The private scalar is not 32 octets, or is 0, or is not below the
    /// group order.
    BadSecretKey;
    /// The digest is not 32 octets.
    BadDigest;
}

pub str Error.to_str() {
    match (this) {
        case BadSecretKey: {
            return "the private key is not a valid P-256 scalar";
        }
        case BadDigest: {
            return "the digest is not 32 octets";
        }
    }
}

// --- limb arithmetic: one prime modulus, Montgomery form ----------------------

// A modulus and what Montgomery multiplication needs of it. Built once from
// public constants.
type Field {
    Array<int> modulus;
    int negative_inverse;
    Array<int> one;
    Array<int> radix_squared;
    Array<int> inverse_exponent;
}

Array<int> Field.add(Array<int> left, Array<int> right) {
    Array<int> sum = [0; WIDTH];
    int carry = 0;
    for (int index in 0 .. WIDTH) {
        int total = left[index] + right[index] + carry;
        sum[index] = total & LIMB_MASK;
        carry = total >> LIMB_BITS;
    }
    Difference reduced = subtract_with_borrow(sum, modulus);
    return select(carry | (1 - reduced.borrow), reduced.limbs, sum);
}

Array<int> Field.subtract(Array<int> left, Array<int> right) {
    Difference difference = subtract_with_borrow(left, right);
    int mask = 0 - difference.borrow;
    Array<int> out = [0; WIDTH];
    int carry = 0;
    for (int index in 0 .. WIDTH) {
        int total = difference.limbs[index] + (modulus[index] & mask) + carry;
        out[index] = total & LIMB_MASK;
        carry = total >> LIMB_BITS;
    }
    return out;
}

// CIOS Montgomery multiplication, `left * right * R^-1 mod modulus`, for
// inputs below the modulus. Every `>>` operand is a sum of non-negative terms.
Array<int> Field.multiply(Array<int> left, Array<int> right) {
    Array<int> work = [0; WIDTH + 2];
    for (int row in 0 .. WIDTH) {
        int left_limb = left[row];
        int carry = 0;
        for (int column in 0 .. WIDTH) {
            int sum = work[column] + left_limb * right[column] + carry;
            work[column] = sum & LIMB_MASK;
            carry = sum >> LIMB_BITS;
        }
        int top = work[WIDTH] + carry;
        work[WIDTH] = top & LIMB_MASK;
        work[WIDTH + 1] = top >> LIMB_BITS;
        int factor = work[0] * negative_inverse & LIMB_MASK;
        carry = (work[0] + factor * modulus[0]) >> LIMB_BITS;
        for (int column in 1 .. WIDTH) {
            int sum = work[column] + factor * modulus[column] + carry;
            work[column - 1] = sum & LIMB_MASK;
            carry = sum >> LIMB_BITS;
        }
        int next_top = work[WIDTH] + carry;
        work[WIDTH - 1] = next_top & LIMB_MASK;
        work[WIDTH] = work[WIDTH + 1] + (next_top >> LIMB_BITS);
    }
    Array<int> out = work.slice(0, WIDTH);
    Difference reduced = subtract_with_borrow(out, modulus);
    return select(work[WIDTH] | (1 - reduced.borrow), reduced.limbs, out);
}

Array<int> Field.to_montgomery(Array<int> value) {
    return multiply(value, radix_squared);
}

Array<int> Field.from_montgomery(Array<int> value) {
    return multiply(value, bignum.from_small(WIDTH, 1));
}

// `value^(modulus - 2)` by square-and-multiply over the bits of that public
// exponent: the branch is on the exponent, never on `value`. Zero maps to
// zero.
Array<int> Field.invert(Array<int> value) {
    Array<int> result = clone(one);
    int position = 255;
    while (position >= 0) {
        result = multiply(result, result);
        int limb = inverse_exponent[position / LIMB_BITS];
        if ((limb >> (position % LIMB_BITS) & 1) == 1) {
            result = multiply(result, value);
        }
        position = position - 1;
    }
    return result;
}

// `left - right` over 11 limbs, and whether it borrowed out of the top (1) or
// not (0).
type Difference {
    Array<int> limbs;
    int borrow;
}

// `-value^-1 mod 2^24` for an odd limb: Newton's iteration, as `bignum.m31`
// does. Public input only (the modulus).
int negative_inverse_of(int low_limb) {
    int inverse = low_limb;
    for (int round in 0 .. 5) {
        int product = low_limb * inverse & LIMB_MASK;
        int correction = 2 - product & LIMB_MASK;
        inverse = inverse * correction & LIMB_MASK;
    }
    return LIMB_RADIX - inverse & LIMB_MASK;
}

Field make_field(str modulus_hex) {
    bignum.Modulus context = bignum.make_modulus(hexcodec.literal(modulus_hex));
    Array<int> one = bignum.montgomery_one(context);
    Array<int> radix_squared = bignum.to_montgomery(context, one);
    Array<int> exponent = bignum.subtract_limbs(context.value, bignum.from_small(WIDTH, 2));
    return Field(clone(context.value), negative_inverse_of(context.value[0]), one, radix_squared, exponent);
}

// Octets (big-endian, at most 33 of them -- always 32 here) into 11 limbs.
// A pure rearrangement: 24 is a multiple of 8, so no octet straddles two
// limbs, and the loop counts are fixed.
Array<int> limbs_of(bytes octets) {
    Array<int> limbs = [0; WIDTH];
    int count = octets.size();
    for (int index in 0 .. count) {
        int octet = octets[count - 1 - index];
        int bit = index * 8;
        int limb = bit / LIMB_BITS;
        int shift = bit % LIMB_BITS;
        limbs[limb] = limbs[limb] | octet << shift;
    }
    return limbs;
}

// The 32 big-endian octets of limbs that hold a value below 2^256.
bytes octets_of(Array<int> limbs) {
    bytes out = [0; SIZE];
    for (int index in 0 .. SIZE) {
        int bit = index * 8;
        int limb = bit / LIMB_BITS;
        int shift = bit % LIMB_BITS;
        out[SIZE - 1 - index] = limbs[limb] >> shift & 0xFF;
    }
    return out;
}

// `left` where `condition` is 1, `right` where it is 0. `condition` must be
// exactly 0 or 1. The mask is 0 or -1 (`0 - 0`, `0 - 1` cannot overflow), and
// the selection is bitwise arithmetic on whole limbs.
Array<int> select(int condition, Array<int> left, Array<int> right) {
    int mask = 0 - condition;
    int inverse_mask = mask ^ -1;
    Array<int> out = [0; WIDTH];
    for (int index in 0 .. WIDTH) {
        out[index] = left[index] & mask | right[index] & inverse_mask;
    }
    return out;
}

// The borrow comes from a difference biased by +2^24 so it is positive and
// the shift below never meets a negative operand: `left - right - borrow` is
// at least -2^24, so `biased` is in [0, 2^25), and its bit 24 is 1 exactly
// when the true difference was not negative.
Difference subtract_with_borrow(Array<int> left, Array<int> right) {
    Array<int> out = [0; WIDTH];
    int borrow = 0;
    for (int index in 0 .. WIDTH) {
        int biased = left[index] - right[index] - borrow + LIMB_RADIX;
        out[index] = biased & LIMB_MASK;
        borrow = 1 - (biased >> LIMB_BITS);
    }
    return Difference(out, borrow);
}

// Whether the limbs hold zero: 1 or 0, with no early exit.
int is_zero_limbs(Array<int> limbs) {
    int accumulated = 0;
    for (int index in 0 .. WIDTH) {
        accumulated = accumulated | limbs[index];
    }
    // accumulated is in [0, 2^24): subtracting 1 goes negative only for 0, and
    // the biased shift reads that sign without a branch.
    return 1 - ((accumulated + LIMB_RADIX - 1) >> LIMB_BITS);
}

// 1 if `value < modulus`, else 0.
int below(Array<int> value, Array<int> modulus) {
    return subtract_with_borrow(value, modulus).borrow;
}

// --- the curve: complete projective arithmetic ---------------------------------

// A point in homogeneous projective coordinates (X : Y : Z), each a
// Montgomery-form element of GF(p): affine (X/Z, Y/Z). The point at infinity is
// (0 : 1 : 0). Private: nothing outside builds or reads one.
type Point {
    Array<int> x;
    Array<int> y;
    Array<int> z;
}

// Everything a signature needs that depends only on the curve.
type Curve {
    Field field;
    Field order;
    Array<int> coefficient_b;
    Point generator;
}

// Renes, Costello, Batina, "Complete addition formulas for prime order
// elliptic curves" (2015), Algorithm 4: P + Q for a = -3, valid for every pair
// of points on the curve, doubling and infinity included.
Point Curve.add_points(Point left, Point right) {
    Array<int> xx = field.multiply(left.x, right.x);
    Array<int> yy = field.multiply(left.y, right.y);
    Array<int> zz = field.multiply(left.z, right.z);
    Array<int> xy_product = field.multiply(field.add(left.x, left.y), field.add(right.x, right.y));
    Array<int> xy_cross = field.subtract(xy_product, field.add(xx, yy));
    Array<int> yz_product = field.multiply(field.add(left.y, left.z), field.add(right.y, right.z));
    Array<int> yz_cross = field.subtract(yz_product, field.add(yy, zz));
    Array<int> xz_product = field.multiply(field.add(left.x, left.z), field.add(right.x, right.z));
    Array<int> xz_cross = field.subtract(xz_product, field.add(xx, zz));
    Array<int> b_zz = field.multiply(coefficient_b, zz);
    Array<int> reduced = field.subtract(xz_cross, b_zz);
    Array<int> reduced_double = field.add(reduced, reduced);
    Array<int> reduced_triple = field.add(reduced, reduced_double);
    Array<int> difference = field.subtract(yy, reduced_triple);
    Array<int> total = field.add(yy, reduced_triple);
    Array<int> b_xz = field.multiply(coefficient_b, xz_cross);
    Array<int> zz_double = field.add(zz, zz);
    Array<int> zz_triple = field.add(zz_double, zz);
    Array<int> shifted = field.subtract(field.subtract(b_xz, zz_triple), xx);
    Array<int> shifted_double = field.add(shifted, shifted);
    Array<int> shifted_triple = field.add(shifted_double, shifted);
    Array<int> xx_double = field.add(xx, xx);
    Array<int> xx_triple = field.add(xx_double, xx);
    Array<int> xx_adjusted = field.subtract(xx_triple, zz_triple);
    Array<int> yz_term = field.multiply(yz_cross, shifted_triple);
    Array<int> xx_term = field.multiply(xx_adjusted, shifted_triple);
    Array<int> out_y = field.add(field.multiply(total, difference), xx_term);
    Array<int> out_x = field.subtract(field.multiply(xy_cross, total), yz_term);
    Array<int> out_z = field.add(field.multiply(yz_cross, difference), field.multiply(xy_cross, xx_adjusted));
    return Point(out_x, out_y, out_z);
}

// `[scalar] base`, always 256 iterations: double, add, keep the sum by mask.
Point Curve.scalar_multiply(bytes scalar, Point base) {
    Point running = infinity(field);
    int position = 255;
    while (position >= 0) {
        running = add_points(running, running);
        Point added = add_points(running, base);
        running = select_point(scalar_bit(scalar, position), added, running);
        position = position - 1;
    }
    return running;
}

// The affine x and y of a point that is not infinity, as plain values. Z is
// inverted by Fermat (fixed public exponent).
Array<Array<int>> Curve.affine(Point point) {
    Array<int> z_inverse = field.invert(point.z);
    Array<int> x_plain = field.from_montgomery(field.multiply(point.x, z_inverse));
    Array<int> y_plain = field.from_montgomery(field.multiply(point.y, z_inverse));
    Array<Array<int>> out = [x_plain, y_plain];
    return out;
}

Curve build_curve() {
    Field field = make_field(PRIME_HEX);
    Field order = make_field(ORDER_HEX);
    Array<int> coefficient_b = field.to_montgomery(limbs_of(hexcodec.literal(COEFFICIENT_B_HEX)));
    Array<int> generator_x = field.to_montgomery(limbs_of(hexcodec.literal(GENERATOR_X_HEX)));
    Array<int> generator_y = field.to_montgomery(limbs_of(hexcodec.literal(GENERATOR_Y_HEX)));
    return Curve(field, order, coefficient_b, Point(generator_x, generator_y, clone(field.one)));
}

Point infinity(Field field) {
    Array<int> zero = [0; WIDTH];
    return Point(zero, clone(field.one), clone(zero));
}

Point select_point(int condition, Point left, Point right) {
    return Point(select(condition, left.x, right.x), select(condition, left.y, right.y), select(condition, left.z, right.z));
}

// Bit `position` (0 = least significant) of a 32-octet big-endian scalar.
// Octets are never negative, so the shift is on a non-negative operand.
int scalar_bit(bytes scalar, int position) {
    return scalar[SIZE - 1 - position / 8] >> (position % 8) & 1;
}

// --- keys and nonces -----------------------------------------------------------------

// 1 if the 32 octets are a scalar in [1, n - 1], else 0.
int valid_scalar(Curve curve, bytes octets) {
    if (octets.size() != SIZE) {
        return 0;
    }
    Array<int> limbs = limbs_of(octets);
    return below(limbs, curve.order.modulus) & (1 - is_zero_limbs(limbs));
}

/// The uncompressed public point `0x04 || X || Y` for the private scalar
/// `secret`.
pub Result<bytes, Error> public_key(bytes secret) {
    Curve curve = build_curve();
    if (valid_scalar(curve, secret) == 0) {
        return Result<bytes, Error>.Err(Error.BadSecretKey);
    }
    Point point = curve.scalar_multiply(secret, curve.generator);
    Array<Array<int>> affine = curve.affine(point);
    bytes out = [4];
    out.extend(octets_of(affine[0]));
    out.extend(octets_of(affine[1]));
    return Result<bytes, Error>.Ok(out);
}

// `digest` as a number reduced once modulo n (a 256-bit value is below 2n).
Array<int> reduced_digest(Curve curve, bytes digest) {
    Array<int> limbs = limbs_of(digest);
    Difference reduced = subtract_with_borrow(limbs, curve.order.modulus);
    return select(reduced.borrow, limbs, reduced.limbs);
}

bytes concat3(bytes first, bytes second, bytes third) {
    bytes out = clone(first);
    out.extend(second);
    out.extend(third);
    return out;
}

// One `r, s` pair for the nonce `nonce`, or none if r or s came out zero.
// `signature_scalars` returns [r, s] as 32-octet strings, or an empty list.
List<bytes> signature_scalars(Curve curve, bytes secret, Array<int> digest_scalar, bytes nonce) {
    Point point = curve.scalar_multiply(nonce, curve.generator);
    Array<Array<int>> affine = curve.affine(point);
    Array<int> x_plain = affine[0];
    Difference folded = subtract_with_borrow(x_plain, curve.order.modulus);
    Array<int> r_plain = select(folded.borrow, x_plain, folded.limbs);
    Field order = curve.order;
    Array<int> nonce_inverse = order.invert(order.to_montgomery(limbs_of(nonce)));
    Array<int> product = order.multiply(order.to_montgomery(r_plain), order.to_montgomery(limbs_of(secret)));
    Array<int> sum = order.add(order.to_montgomery(digest_scalar), product);
    Array<int> s_plain = order.from_montgomery(order.multiply(nonce_inverse, sum));
    List<bytes> out = [];
    if (is_zero_limbs(r_plain) == 1 || is_zero_limbs(s_plain) == 1) {
        return out;
    }
    out.push(octets_of(r_plain));
    out.push(octets_of(s_plain));
    return out;
}

// RFC 6979 §3.2 with SHA-256 and a 256-bit order (qlen = hlen = 256), so
// `bits2octets(h1)` is `h1 mod n` and each nonce candidate is one HMAC block.
// Returns `r || s`.
bytes sign_with_drbg(Curve curve, bytes secret, bytes digest) {
    Array<int> digest_scalar = reduced_digest(curve, digest);
    bytes digest_octets = octets_of(digest_scalar);
    bytes chain = [1; SIZE];
    bytes key = [0; SIZE];
    key = hmac.sha256_mac(key, concat3(chain, [0], concat3(secret, digest_octets, [])));
    chain = hmac.sha256_mac(key, chain);
    key = hmac.sha256_mac(key, concat3(chain, [1], concat3(secret, digest_octets, [])));
    chain = hmac.sha256_mac(key, chain);
    while (true) {
        chain = hmac.sha256_mac(key, chain);
        Array<int> candidate = limbs_of(chain);
        if (below(candidate, curve.order.modulus) == 1 && is_zero_limbs(candidate) == 0) {
            List<bytes> scalars = signature_scalars(curve, secret, digest_scalar, chain);
            if (scalars.size() == 2) {
                bytes out = clone(scalars[0]);
                out.extend(scalars[1]);
                return out;
            }
        }
        key = hmac.sha256_mac(key, concat3(chain, [0], []));
        chain = hmac.sha256_mac(key, chain);
    }
}

/// The signature of `digest` under `secret`, as 64 octets `r || s`. The nonce
/// is RFC 6979's, so the same inputs always give the same signature.
pub Result<bytes, Error> sign_raw(bytes secret, bytes digest) {
    Curve curve = build_curve();
    if (valid_scalar(curve, secret) == 0) {
        return Result<bytes, Error>.Err(Error.BadSecretKey);
    }
    if (digest.size() != SIZE) {
        return Result<bytes, Error>.Err(Error.BadDigest);
    }
    return Result<bytes, Error>.Ok(sign_with_drbg(curve, secret, digest));
}

// A non-negative INTEGER in DER, from 32 big-endian octets (public: it is
// part of the signature).
bytes der_integer(bytes magnitude) {
    int start = 0;
    while (start < magnitude.size() - 1 && magnitude[start] == 0) {
        start = start + 1;
    }
    bytes body = [];
    if (magnitude[start] >= 0x80) {
        body.push(0);
    }
    body.extend(magnitude.substr(start, magnitude.size()));
    bytes out = [2, body.size()];
    out.extend(body);
    return out;
}

/// The signature of `digest` under `secret` as DER `SEQUENCE { r, s }`.
pub Result<bytes, Error> sign(bytes secret, bytes digest) {
    bytes raw = sign_raw(secret, digest)?;
    bytes body = der_integer(raw.substr(0, SIZE));
    body.extend(der_integer(raw.substr(SIZE, 2 * SIZE)));
    bytes out = [0x30, body.size()];
    out.extend(body);
    return Result<bytes, Error>.Ok(out);
}
