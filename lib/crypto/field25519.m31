// Arithmetic in GF(2^255 - 19), the base field Curve25519 (RFC 7748) and
// edwards25519 (RFC 8032) both share. Shared by `x25519` and `ed25519`.
//
// This module is the SECURITY-CRITICAL core of both: every operation here
// runs on secret data at some point (an X25519 ladder step, an Ed25519
// signing scalar multiplication), so every place this file relies on
// something being constant-time says so, in a comment, at the line that
// relies on it. Read that before changing anything below.
//
// --- representation: 10 limbs, radix 2^25.5 -----------------------------------
//
// A field element is an `Array<int>` of 10 signed limbs, value = sum of
// `limb[i] * 2^e(i)` with e(i) = ceil(25.5 * i) (weights 2^0, 2^26, 2^51,
// 2^77, 2^102, 2^128, 2^153, 2^179, 2^204, 2^230): even limbs carry 26 bits,
// odd limbs 25. This is the layout of Bernstein et al.'s `ref10` and of
// `curve25519-donna`'s 32-bit code: a product of two limbs is under 2^53 and
// a whole column of ten of them, with the wrap-around factor 19 folded in,
// stays under 2^61 -- inside `int`'s 2^63 trap threshold, so the
// multiplication needs no 128-bit arithmetic. (An earlier version of this file
// used 16 limbs of 16 bits: 256 partial products per multiplication instead of
// 100, three allocating carry passes, and about 15 times the running time --
// docs/CRYPTO-PERF.md.)
//
// Every function returns a CARRIED element: limbs balanced around zero, each
// within about 2^25 (even) or 2^24 (odd) in magnitude. `add` and `sub` carry
// too, so there is one invariant -- every input and every output is carried --
// and the bound on `mul`'s partial products below always holds.
//
// --- constant time: what this file promises, and how ------------------------
//
//   - No comparison, `if`, `while` condition or array index in this file
//     ever depends on a field element's value. Every loop bound is a fixed
//     count; every `Array` index is a loop counter or a constant.
//
//   - Carries are `(limb + half) >> width`: an ARITHMETIC right shift of a
//     value that really can be negative. The runtime's `>>` (runtime/rt.h,
//     `rt_ishr`) does the sign extension with arithmetic on the sign bit, not
//     a branch (an earlier version of the runtime branched on the sign, which
//     is why this module used to add a public bias before every shift; it no
//     longer needs to). The shift counts are public constants.
//
//   - `+ - *` on `int` trap on overflow (reference §6.1) via a branch on the
//     CPU's overflow flag. That branch's OUTCOME never depends on secret
//     data, because every bound in this file keeps every intermediate value
//     far below 2^63 -- the check always takes the same "did not overflow"
//     path, so it carries no information about which secret input it was.
//
//   - `& | ^ ~` never trap and compile to plain unconditional operators --
//     the operations `cselect` and `cswap` are built from.
//
// What this file does NOT independently verify: that gcc/clang, across every
// version and -O level, emit branch-free machine code for the overflow-checked
// arithmetic and the masked `cselect` pattern. This file does the one thing
// under its own control -- never write a branch, a comparison or an index
// that depends on a field element -- and no more than that.

import crypto.accel;

// The hardware field kernels (docs/ffi-decision.md, docs/CRYPTO-ACCEL.md):
// assembly in runtime/crypto_*.S that does `mul`, `add` and `sub` below
// instruction for instruction (ref10's multiply and carry chain), so the limbs
// that come back are identical to the m31 code's. Each takes ten-limb elements
// as `Array<int>` spans, checked by the compiler; `result` may be `left` or
// `right`. They run unless `M31_CRYPTO_ACCEL` has switched them off
// (`accel.features()`), and then the m31 code runs. Straight-line, no table,
// no branch: the constant-time argument above carries over unchanged.
prim "c" nonblocking void __k_fe_mul(
    out Array<int> result[0 .. 10],
    in Array<int> left[0 .. 10],
    in Array<int> right[0 .. 10]);
prim "c" nonblocking void __k_fe_add(
    out Array<int> result[0 .. 10],
    in Array<int> left[0 .. 10],
    in Array<int> right[0 .. 10]);
prim "c" nonblocking void __k_fe_sub(
    out Array<int> result[0 .. 10],
    in Array<int> left[0 .. 10],
    in Array<int> right[0 .. 10]);

// --- construction and encoding ----------------------------------------------

/// The additive identity.
pub Array<int> zero() {
    return [0; 10];
}

/// The multiplicative identity.
pub Array<int> one() {
    Array<int> out = [0; 10];
    out[0] = 1;
    return out;
}

/// The element `number` names, for the handful of small constants the curves need
/// (486662's Montgomery `(A-2)/4`, the `2*d` of the twisted Edwards curve, ...).
/// `number` must be below 2^26, which is every constant this module is ever
/// asked to build.
pub Array<int> small(int number) {
    Array<int> out = [0; 10];
    out[0] = number;
    return out;
}

/// The field element 32 little-endian octets encode, taken as a raw 256-bit
/// load with NO masking of any bit (the result is carried, so a value at or
/// above p is accepted and simply represents itself mod p).
///
/// Both RFC 7748 (the u-coordinate's top bit) and RFC 8032 (the sign bit
/// riding on the y-coordinate's encoding) reserve the top bit of the last
/// octet for something that is not field data; masking it off is the
/// caller's job, on the raw bytes, before this function ever sees them.
pub Array<int> from_bytes(bytes encoded) {
    int h_0 = (encoded[0] | (encoded[1] << 8) | (encoded[2] << 16) | (encoded[3] << 24) | (encoded[4] << 32)) >> 0 & 0x3ffffff;
    int h_1 = (encoded[3] | (encoded[4] << 8) | (encoded[5] << 16) | (encoded[6] << 24) | (encoded[7] << 32)) >> 2 & 0x1ffffff;
    int h_2 = (encoded[6] | (encoded[7] << 8) | (encoded[8] << 16) | (encoded[9] << 24) | (encoded[10] << 32)) >> 3 & 0x3ffffff;
    int h_3 = (encoded[9] | (encoded[10] << 8) | (encoded[11] << 16) | (encoded[12] << 24) | (encoded[13] << 32)) >> 5 & 0x1ffffff;
    int h_4 = (encoded[12] | (encoded[13] << 8) | (encoded[14] << 16) | (encoded[15] << 24) | (encoded[16] << 32)) >> 6 & 0x3ffffff;
    int h_5 = (encoded[16] | (encoded[17] << 8) | (encoded[18] << 16) | (encoded[19] << 24) | (encoded[20] << 32)) >> 0 & 0x1ffffff;
    int h_6 = (encoded[19] | (encoded[20] << 8) | (encoded[21] << 16) | (encoded[22] << 24) | (encoded[23] << 32)) >> 1 & 0x3ffffff;
    int h_7 = (encoded[22] | (encoded[23] << 8) | (encoded[24] << 16) | (encoded[25] << 24) | (encoded[26] << 32)) >> 3 & 0x1ffffff;
    int h_8 = (encoded[25] | (encoded[26] << 8) | (encoded[27] << 16) | (encoded[28] << 24) | (encoded[29] << 32)) >> 4 & 0x3ffffff;
    int h_9 = (encoded[28] | (encoded[29] << 8) | (encoded[30] << 16) | (encoded[31] << 24)) >> 6 & 0x3ffffff;
    int c_0 = (h_0 + 33554432) >> 26;
    h_1 = h_1 + c_0;
    h_0 = h_0 - (c_0 << 26);
    int c_1 = (h_4 + 33554432) >> 26;
    h_5 = h_5 + c_1;
    h_4 = h_4 - (c_1 << 26);
    int c_2 = (h_1 + 16777216) >> 25;
    h_2 = h_2 + c_2;
    h_1 = h_1 - (c_2 << 25);
    int c_3 = (h_5 + 16777216) >> 25;
    h_6 = h_6 + c_3;
    h_5 = h_5 - (c_3 << 25);
    int c_4 = (h_2 + 33554432) >> 26;
    h_3 = h_3 + c_4;
    h_2 = h_2 - (c_4 << 26);
    int c_5 = (h_6 + 33554432) >> 26;
    h_7 = h_7 + c_5;
    h_6 = h_6 - (c_5 << 26);
    int c_6 = (h_3 + 16777216) >> 25;
    h_4 = h_4 + c_6;
    h_3 = h_3 - (c_6 << 25);
    int c_7 = (h_7 + 16777216) >> 25;
    h_8 = h_8 + c_7;
    h_7 = h_7 - (c_7 << 25);
    int c_8 = (h_4 + 33554432) >> 26;
    h_5 = h_5 + c_8;
    h_4 = h_4 - (c_8 << 26);
    int c_9 = (h_8 + 33554432) >> 26;
    h_9 = h_9 + c_9;
    h_8 = h_8 - (c_9 << 26);
    int c10 = (h_9 + 16777216) >> 25;
    h_0 = h_0 + 19 * c10;
    h_9 = h_9 - (c10 << 25);
    int c11 = (h_0 + 33554432) >> 26;
    h_1 = h_1 + c11;
    h_0 = h_0 - (c11 << 26);
    Array<int> out = [0; 10];
    out[0] = h_0;
    out[1] = h_1;
    out[2] = h_2;
    out[3] = h_3;
    out[4] = h_4;
    out[5] = h_5;
    out[6] = h_6;
    out[7] = h_7;
    out[8] = h_8;
    out[9] = h_9;
    return out;
}

/// `element`, canonically reduced to `[0, p)` and packed as 32 little-endian
/// octets -- the encoding RFC 7748 and RFC 8032 both specify. (ref10's
/// `fe_tobytes`: find the quotient q in {0, 1} of the value by p with a chain
/// of carries, add 19 * q, carry again and drop bit 255.)
///
/// This runs on secret data (an X25519 shared secret, an Ed25519 nonce
/// point); its constant-time argument is the header's.
pub bytes to_bytes(Array<int> element) {
    int h_0 = element[0];
    int h_1 = element[1];
    int h_2 = element[2];
    int h_3 = element[3];
    int h_4 = element[4];
    int h_5 = element[5];
    int h_6 = element[6];
    int h_7 = element[7];
    int h_8 = element[8];
    int h_9 = element[9];
    int quotient = (19 * h_9 + (1 << 24)) >> 25;
    quotient = (h_0 + quotient) >> 26;
    quotient = (h_1 + quotient) >> 25;
    quotient = (h_2 + quotient) >> 26;
    quotient = (h_3 + quotient) >> 25;
    quotient = (h_4 + quotient) >> 26;
    quotient = (h_5 + quotient) >> 25;
    quotient = (h_6 + quotient) >> 26;
    quotient = (h_7 + quotient) >> 25;
    quotient = (h_8 + quotient) >> 26;
    quotient = (h_9 + quotient) >> 25;
    h_0 = h_0 + 19 * quotient;
    int k_0 = h_0 >> 26;
    h_1 = h_1 + k_0;
    h_0 = h_0 - (k_0 << 26);
    int k_1 = h_1 >> 25;
    h_2 = h_2 + k_1;
    h_1 = h_1 - (k_1 << 25);
    int k_2 = h_2 >> 26;
    h_3 = h_3 + k_2;
    h_2 = h_2 - (k_2 << 26);
    int k_3 = h_3 >> 25;
    h_4 = h_4 + k_3;
    h_3 = h_3 - (k_3 << 25);
    int k_4 = h_4 >> 26;
    h_5 = h_5 + k_4;
    h_4 = h_4 - (k_4 << 26);
    int k_5 = h_5 >> 25;
    h_6 = h_6 + k_5;
    h_5 = h_5 - (k_5 << 25);
    int k_6 = h_6 >> 26;
    h_7 = h_7 + k_6;
    h_6 = h_6 - (k_6 << 26);
    int k_7 = h_7 >> 25;
    h_8 = h_8 + k_7;
    h_7 = h_7 - (k_7 << 25);
    int k_8 = h_8 >> 26;
    h_9 = h_9 + k_8;
    h_8 = h_8 - (k_8 << 26);
    int k_9 = h_9 >> 25;
    h_9 = h_9 - (k_9 << 25);
    Array<int> limbs = [h_0, h_1, h_2, h_3, h_4, h_5, h_6, h_7, h_8, h_9];
    bytes out = [0; 32];
    int accumulator = 0;
    int bit_count = 0;
    int position = 0;
    for (int i in 0 .. 10) {
        accumulator = accumulator | (limbs[i] << bit_count);
        bit_count = bit_count + 26 - i % 2;
        while (bit_count >= 8) {
            out[position] = accumulator & 0xFF;
            accumulator = accumulator >> 8;
            bit_count = bit_count - 8;
            position = position + 1;
        }
    }
    out[31] = accumulator & 0xFF;
    return out;
}

// --- the four operations -----------------------------------------------------

/// `left + right`, carried.
pub void add_into(Array<int> out, Array<int> left, Array<int> right) {
    if ((accel.features() & accel.FIELD) != 0) {
        __k_fe_add(out, left, right);
        return;
    }
    int h_0 = left[0] + right[0];
    int h_1 = left[1] + right[1];
    int h_2 = left[2] + right[2];
    int h_3 = left[3] + right[3];
    int h_4 = left[4] + right[4];
    int h_5 = left[5] + right[5];
    int h_6 = left[6] + right[6];
    int h_7 = left[7] + right[7];
    int h_8 = left[8] + right[8];
    int h_9 = left[9] + right[9];
    int c_0 = (h_0 + 33554432) >> 26;
    h_1 = h_1 + c_0;
    h_0 = h_0 - (c_0 << 26);
    int c_1 = (h_4 + 33554432) >> 26;
    h_5 = h_5 + c_1;
    h_4 = h_4 - (c_1 << 26);
    int c_2 = (h_1 + 16777216) >> 25;
    h_2 = h_2 + c_2;
    h_1 = h_1 - (c_2 << 25);
    int c_3 = (h_5 + 16777216) >> 25;
    h_6 = h_6 + c_3;
    h_5 = h_5 - (c_3 << 25);
    int c_4 = (h_2 + 33554432) >> 26;
    h_3 = h_3 + c_4;
    h_2 = h_2 - (c_4 << 26);
    int c_5 = (h_6 + 33554432) >> 26;
    h_7 = h_7 + c_5;
    h_6 = h_6 - (c_5 << 26);
    int c_6 = (h_3 + 16777216) >> 25;
    h_4 = h_4 + c_6;
    h_3 = h_3 - (c_6 << 25);
    int c_7 = (h_7 + 16777216) >> 25;
    h_8 = h_8 + c_7;
    h_7 = h_7 - (c_7 << 25);
    int c_8 = (h_4 + 33554432) >> 26;
    h_5 = h_5 + c_8;
    h_4 = h_4 - (c_8 << 26);
    int c_9 = (h_8 + 33554432) >> 26;
    h_9 = h_9 + c_9;
    h_8 = h_8 - (c_9 << 26);
    int c10 = (h_9 + 16777216) >> 25;
    h_0 = h_0 + 19 * c10;
    h_9 = h_9 - (c10 << 25);
    int c11 = (h_0 + 33554432) >> 26;
    h_1 = h_1 + c11;
    h_0 = h_0 - (c11 << 26);
    out[0] = h_0;
    out[1] = h_1;
    out[2] = h_2;
    out[3] = h_3;
    out[4] = h_4;
    out[5] = h_5;
    out[6] = h_6;
    out[7] = h_7;
    out[8] = h_8;
    out[9] = h_9;
}

pub Array<int> add(Array<int> left, Array<int> right) {
    Array<int> out = [0; 10];
    add_into(out, left, right);
    return out;
}

/// `left - right`, carried.
pub void sub_into(Array<int> out, Array<int> left, Array<int> right) {
    if ((accel.features() & accel.FIELD) != 0) {
        __k_fe_sub(out, left, right);
        return;
    }
    int h_0 = left[0] - right[0];
    int h_1 = left[1] - right[1];
    int h_2 = left[2] - right[2];
    int h_3 = left[3] - right[3];
    int h_4 = left[4] - right[4];
    int h_5 = left[5] - right[5];
    int h_6 = left[6] - right[6];
    int h_7 = left[7] - right[7];
    int h_8 = left[8] - right[8];
    int h_9 = left[9] - right[9];
    int c_0 = (h_0 + 33554432) >> 26;
    h_1 = h_1 + c_0;
    h_0 = h_0 - (c_0 << 26);
    int c_1 = (h_4 + 33554432) >> 26;
    h_5 = h_5 + c_1;
    h_4 = h_4 - (c_1 << 26);
    int c_2 = (h_1 + 16777216) >> 25;
    h_2 = h_2 + c_2;
    h_1 = h_1 - (c_2 << 25);
    int c_3 = (h_5 + 16777216) >> 25;
    h_6 = h_6 + c_3;
    h_5 = h_5 - (c_3 << 25);
    int c_4 = (h_2 + 33554432) >> 26;
    h_3 = h_3 + c_4;
    h_2 = h_2 - (c_4 << 26);
    int c_5 = (h_6 + 33554432) >> 26;
    h_7 = h_7 + c_5;
    h_6 = h_6 - (c_5 << 26);
    int c_6 = (h_3 + 16777216) >> 25;
    h_4 = h_4 + c_6;
    h_3 = h_3 - (c_6 << 25);
    int c_7 = (h_7 + 16777216) >> 25;
    h_8 = h_8 + c_7;
    h_7 = h_7 - (c_7 << 25);
    int c_8 = (h_4 + 33554432) >> 26;
    h_5 = h_5 + c_8;
    h_4 = h_4 - (c_8 << 26);
    int c_9 = (h_8 + 33554432) >> 26;
    h_9 = h_9 + c_9;
    h_8 = h_8 - (c_9 << 26);
    int c10 = (h_9 + 16777216) >> 25;
    h_0 = h_0 + 19 * c10;
    h_9 = h_9 - (c10 << 25);
    int c11 = (h_0 + 33554432) >> 26;
    h_1 = h_1 + c11;
    h_0 = h_0 - (c11 << 26);
    out[0] = h_0;
    out[1] = h_1;
    out[2] = h_2;
    out[3] = h_3;
    out[4] = h_4;
    out[5] = h_5;
    out[6] = h_6;
    out[7] = h_7;
    out[8] = h_8;
    out[9] = h_9;
}

pub Array<int> sub(Array<int> left, Array<int> right) {
    Array<int> out = [0; 10];
    sub_into(out, left, right);
    return out;
}

pub Array<int> neg(Array<int> element) {
    return sub(zero(), element);
}

/// `left * right`, carried. Ten limbs by ten: each product `f_i * g_j` lands in
/// limb `(i + j) % 10`, doubled when both `i` and `j` are odd (two half-bit
/// radix steps make a whole bit: 2^e(i) * 2^e(j) = 2 * 2^e(i + j) there) and
/// times 19 when `i + j >= 10` (2^255 = 19 mod p). Bound: carried inputs are
/// at most 2^26 in magnitude, so `19 * g` is under 2^31, `2 * f` under 2^27, a
/// product under 2^58, and a column of ten under 2^62 -- the overflow
/// check cannot fire on any legal input.
pub void mul_into(Array<int> out, Array<int> left, Array<int> right) {
    if ((accel.features() & accel.FIELD) != 0) {
        __k_fe_mul(out, left, right);
        return;
    }
    int f_0 = left[0];
    int f_1 = left[1];
    int f_2 = left[2];
    int f_3 = left[3];
    int f_4 = left[4];
    int f_5 = left[5];
    int f_6 = left[6];
    int f_7 = left[7];
    int f_8 = left[8];
    int f_9 = left[9];
    int g_0 = right[0];
    int g_1 = right[1];
    int g_2 = right[2];
    int g_3 = right[3];
    int g_4 = right[4];
    int g_5 = right[5];
    int g_6 = right[6];
    int g_7 = right[7];
    int g_8 = right[8];
    int g_9 = right[9];
    int f1_2 = 2 * f_1;
    int f3_2 = 2 * f_3;
    int f5_2 = 2 * f_5;
    int f7_2 = 2 * f_7;
    int f9_2 = 2 * f_9;
    int g1_19 = 19 * g_1;
    int g2_19 = 19 * g_2;
    int g3_19 = 19 * g_3;
    int g4_19 = 19 * g_4;
    int g5_19 = 19 * g_5;
    int g6_19 = 19 * g_6;
    int g7_19 = 19 * g_7;
    int g8_19 = 19 * g_8;
    int g9_19 = 19 * g_9;
    int h_0 = f_0 * g_0 + f1_2 * g9_19 + f_2 * g8_19 + f3_2 * g7_19 + f_4 * g6_19 + f5_2 * g5_19 + f_6 * g4_19 + f7_2 * g3_19 + f_8 * g2_19 + f9_2 * g1_19;
    int h_1 = f_0 * g_1 + f_1 * g_0 + f_2 * g9_19 + f_3 * g8_19 + f_4 * g7_19 + f_5 * g6_19 + f_6 * g5_19 + f_7 * g4_19 + f_8 * g3_19 + f_9 * g2_19;
    int h_2 = f_0 * g_2 + f1_2 * g_1 + f_2 * g_0 + f3_2 * g9_19 + f_4 * g8_19 + f5_2 * g7_19 + f_6 * g6_19 + f7_2 * g5_19 + f_8 * g4_19 + f9_2 * g3_19;
    int h_3 = f_0 * g_3 + f_1 * g_2 + f_2 * g_1 + f_3 * g_0 + f_4 * g9_19 + f_5 * g8_19 + f_6 * g7_19 + f_7 * g6_19 + f_8 * g5_19 + f_9 * g4_19;
    int h_4 = f_0 * g_4 + f1_2 * g_3 + f_2 * g_2 + f3_2 * g_1 + f_4 * g_0 + f5_2 * g9_19 + f_6 * g8_19 + f7_2 * g7_19 + f_8 * g6_19 + f9_2 * g5_19;
    int h_5 = f_0 * g_5 + f_1 * g_4 + f_2 * g_3 + f_3 * g_2 + f_4 * g_1 + f_5 * g_0 + f_6 * g9_19 + f_7 * g8_19 + f_8 * g7_19 + f_9 * g6_19;
    int h_6 = f_0 * g_6 + f1_2 * g_5 + f_2 * g_4 + f3_2 * g_3 + f_4 * g_2 + f5_2 * g_1 + f_6 * g_0 + f7_2 * g9_19 + f_8 * g8_19 + f9_2 * g7_19;
    int h_7 = f_0 * g_7 + f_1 * g_6 + f_2 * g_5 + f_3 * g_4 + f_4 * g_3 + f_5 * g_2 + f_6 * g_1 + f_7 * g_0 + f_8 * g9_19 + f_9 * g8_19;
    int h_8 = f_0 * g_8 + f1_2 * g_7 + f_2 * g_6 + f3_2 * g_5 + f_4 * g_4 + f5_2 * g_3 + f_6 * g_2 + f7_2 * g_1 + f_8 * g_0 + f9_2 * g9_19;
    int h_9 = f_0 * g_9 + f_1 * g_8 + f_2 * g_7 + f_3 * g_6 + f_4 * g_5 + f_5 * g_4 + f_6 * g_3 + f_7 * g_2 + f_8 * g_1 + f_9 * g_0;
    int c_0 = (h_0 + 33554432) >> 26;
    h_1 = h_1 + c_0;
    h_0 = h_0 - (c_0 << 26);
    int c_1 = (h_4 + 33554432) >> 26;
    h_5 = h_5 + c_1;
    h_4 = h_4 - (c_1 << 26);
    int c_2 = (h_1 + 16777216) >> 25;
    h_2 = h_2 + c_2;
    h_1 = h_1 - (c_2 << 25);
    int c_3 = (h_5 + 16777216) >> 25;
    h_6 = h_6 + c_3;
    h_5 = h_5 - (c_3 << 25);
    int c_4 = (h_2 + 33554432) >> 26;
    h_3 = h_3 + c_4;
    h_2 = h_2 - (c_4 << 26);
    int c_5 = (h_6 + 33554432) >> 26;
    h_7 = h_7 + c_5;
    h_6 = h_6 - (c_5 << 26);
    int c_6 = (h_3 + 16777216) >> 25;
    h_4 = h_4 + c_6;
    h_3 = h_3 - (c_6 << 25);
    int c_7 = (h_7 + 16777216) >> 25;
    h_8 = h_8 + c_7;
    h_7 = h_7 - (c_7 << 25);
    int c_8 = (h_4 + 33554432) >> 26;
    h_5 = h_5 + c_8;
    h_4 = h_4 - (c_8 << 26);
    int c_9 = (h_8 + 33554432) >> 26;
    h_9 = h_9 + c_9;
    h_8 = h_8 - (c_9 << 26);
    int c10 = (h_9 + 16777216) >> 25;
    h_0 = h_0 + 19 * c10;
    h_9 = h_9 - (c10 << 25);
    int c11 = (h_0 + 33554432) >> 26;
    h_1 = h_1 + c11;
    h_0 = h_0 - (c11 << 26);
    out[0] = h_0;
    out[1] = h_1;
    out[2] = h_2;
    out[3] = h_3;
    out[4] = h_4;
    out[5] = h_5;
    out[6] = h_6;
    out[7] = h_7;
    out[8] = h_8;
    out[9] = h_9;
}

pub Array<int> mul(Array<int> left, Array<int> right) {
    Array<int> out = [0; 10];
    mul_into(out, left, right);
    return out;
}

pub Array<int> square(Array<int> element) {
    return mul(element, element);
}

/// `out = element * element`, in place: `out` may be `element`.
pub void square_into(Array<int> out, Array<int> element) {
    mul_into(out, element, element);
}

/// `2*a*a` -- the extended-coordinates addition law wants this exact shape
/// as its own step often enough (`ed25519.m31`) to give it a name; it is
/// `add(sq(a), sq(a))` and nothing more.
pub Array<int> sq2(Array<int> element) {
    Array<int> squared = square(element);
    return add(squared, squared);
}

// --- constant-time selection -------------------------------------------------

/// `when_one` if `cond` is 1, `when_zero` if `cond` is 0 -- with no branch, for any two
/// elements. `cond` must be exactly 0 or 1; anything else is a bug in the
/// caller (not checked, the way an out-of-range index is not re-checked by
/// every caller of `Array` indexing).
///
/// CONSTANT TIME: `mask` is `0 - cond`, which is 0 or -1 (all 64 bits set,
/// two's complement) -- `-` never traps here because 0-0 and 0-1 both fit
/// trivially. `&`, `|` and `^` are the runtime's plain, unconditional bitwise
/// operators: the whole selection is arithmetic on 64-bit patterns, never a
/// read of `cond` by anything that could branch on it.
pub Array<int> cselect(int cond, Array<int> when_one, Array<int> when_zero) {
    int mask = 0 - cond;
    int notmask = mask ^ -1;
    Array<int> out = [0; 10];
    for (int i in 0 .. 10) {
        out[i] = when_one[i] & mask | when_zero[i] & notmask;
    }
    return out;
}

/// `cselect` into an array the caller owns: `out` becomes `when_one` or
/// `when_zero`; `out` may be either. Same masking argument as `cselect`.
pub void cselect_into(int cond, Array<int> out, Array<int> when_one, Array<int> when_zero) {
    int mask = 0 - cond;
    int notmask = mask ^ -1;
    for (int i in 0 .. 10) {
        out[i] = when_one[i] & mask | when_zero[i] & notmask;
    }
}

/// Swap `first` and `second` in place when `cond` is 1, leave them alone when it is
/// 0 -- the Montgomery ladder's `cswap`. `Array` is a reference type
/// (reference §3.9), so `first` and `second` here are the caller's own arrays: this
/// mutates them directly, element by element, rather than building and
/// returning new ones. Same masking argument as `cselect`.
pub void cswap(int cond, Array<int> first, Array<int> second) {
    int mask = 0 - cond;
    int notmask = mask ^ -1;
    for (int i in 0 .. 10) {
        int first_limb = first[i];
        int second_limb = second[i];
        first[i] = first_limb & notmask | second_limb & mask;
        second[i] = first_limb & mask | second_limb & notmask;
    }
}

// --- inversion and the square-root helper: fixed exponents ------------------
//
// Both exponents are FIXED public constants (they name the field, not any
// input), so these are the classic ref10 addition chains: 254 squarings and 11
// multiplications for `p - 2`, 251 squarings and 2 multiplications for
// `(p - 5) / 8`. The chain is the same for every input.

// `element` squared `count` times (`count` is a public constant at every call).
Array<int> square_times(Array<int> element, int count) {
    Array<int> power = element;
    for (int step in 0 .. count) {
        power = square(power);
    }
    return power;
}

// `element^(2^250 - 1)`, the stretch the two exponents below share, and
// `element^11` on the side, in `Array<Array<int>>`'s two slots.
Array<Array<int>> power_chain(Array<int> element) {
    Array<int> z_2 = square(element);
    Array<int> z_8 = square_times(z_2, 2);
    Array<int> z_9 = mul(z_8, element);
    Array<int> z11 = mul(z_9, z_2);
    Array<int> z22 = square(z11);
    Array<int> z_5_0 = mul(z22, z_9);
    Array<int> z_10_0 = mul(square_times(z_5_0, 5), z_5_0);
    Array<int> z_20_0 = mul(square_times(z_10_0, 10), z_10_0);
    Array<int> z_40_0 = mul(square_times(z_20_0, 20), z_20_0);
    Array<int> z_50_0 = mul(square_times(z_40_0, 10), z_10_0);
    Array<int> z_100_0 = mul(square_times(z_50_0, 50), z_50_0);
    Array<int> z_200_0 = mul(square_times(z_100_0, 100), z_100_0);
    Array<int> z_250_0 = mul(square_times(z_200_0, 50), z_50_0);
    Array<Array<int>> out = [z_250_0, z11];
    return out;
}

/// `a^(p-2) = a^-1` for any nonzero `element` (undefined, like any inverse, at
/// zero -- callers that can see zero must decide what that means to them).
pub Array<int> invert(Array<int> element) {
    Array<Array<int>> chain = power_chain(element);
    return mul(square_times(chain[0], 5), chain[1]);
}

/// `a^((p-5)/8)` -- the candidate exponent RFC 8032 §5.1.3 uses to compute a
/// square root mod p (since p = 5 mod 8): the caller still has to check the
/// candidate and correct it by `sqrt(-1)` if needed, exactly as the RFC
/// describes. Not a square root on its own.
pub Array<int> pow_p_minus_5_over_8(Array<int> element) {
    Array<Array<int>> chain = power_chain(element);
    return mul(square_times(chain[0], 2), element);
}

// --- equality and parity -----------------------------------------------------

/// Whether `left` and `right` are the same field element. Compares canonical
/// encodings, so two representations of the same value always agree; this
/// is used on public values only (a decoded point's coordinates against a
/// recomputed candidate) and makes no constant-time claim -- `==` on `bytes`
/// is ordinary byte comparison.
pub bool eq(Array<int> left, Array<int> right) {
    return to_bytes(left) == to_bytes(right);
}

pub bool is_zero(Array<int> element) {
    return eq(element, zero());
}

/// The low bit of `element`'s canonical representative -- the "sign" RFC 8032
/// packs into a point encoding's spare bit. Not a constant-time operation
/// (it reads a public coordinate, never a secret scalar).
pub int parity(Array<int> element) {
    bytes encoded = to_bytes(element);
    return encoded[0] & 1;
}
