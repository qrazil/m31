// A float as text and text as a float, written entirely in this language.
//
// This is what `print` of a float, `f.to_str()`, `str(f)` and
// `s.parse_float()` call. The compiler loads it into any program that could
// reach one of those, and no program can name it: the module's name begins
// with `__`, which no source may write. See docs/stdlib-seam.md §6.
//
// Nothing here may format or parse a float itself -- it would be calling
// itself -- and the compiler refuses to lower one inside this module.
//
// Formatting is Schubfach (Raffaello Giulietti, 2020): the shortest decimal
// that reads back as the same float, from three 128-bit products and no
// loop. Parsing is Eisel-Lemire (Daniel Lemire, 2021): one or two 128-bit
// products settle every input of up to 19 significant digits, and a longer
// input that they cannot settle is decided exactly, by comparing it against
// the halfway point between two floats with big integers.
//
// There is no unsigned type, so the 64-bit unsigned arithmetic both need is
// spelt on `int` with the bit operators and the wrapping methods: equal bits,
// with the logical shift and the unsigned comparison written out below.

/// A decimal `digits * 10^exp`, with no trailing zeros in `digits`.
type Decimal {
    int digits;
    int exp;
}

/// The text of a float -- the one place a float becomes text, so `print` and
/// `to_str` cannot disagree.
///
/// The format is the one the C runtime printed before this existed, byte for
/// byte, and the corpus depends on every byte of it. It is C's `%.{p}g` with
/// the smallest precision `p` that reads back as the same float, except that
/// a whole number below 10^17 is written out in full rather than as `%g`'s
/// `2.5e+03`: `3`, `2500`, `0.1`, `1e+17`, `1.5e-05`, `5e-324`, `-0`, `inf`,
/// `nan`.
pub str format(float x) {
    int bits = x.to_bits();
    str sign = "";
    if (bits < 0) {
        sign = "-";
        bits = bits & ~(1 << 63);
    }
    // Every NaN prints the same, whatever its sign or payload.
    if (bits > inf_bits()) {
        return "nan";
    }
    if (bits == inf_bits()) {
        return sign + "inf";
    }
    if (bits == 0) {
        return sign + "0";
    }
    Decimal d = shortest(bits);
    int n = digit_count(d.digits);
    // The power of ten of the leading digit: 2 for 250, -3 for 0.00125.
    int point = d.exp + n - 1;
    // `%g` switches to an exponent once the exponent reaches the precision,
    // so the shortest 2500 is 2.5e+03. For a whole number a reader would
    // write out in full, the digits are the number itself -- every float from
    // 2^53 up is whole, and below that a shortest form ending before the
    // point names a whole number exactly -- so `int` states it exactly.
    if (point >= n && float.from_bits(bits) < 100000000000000000.0) {
        return int(x).to_str();
    }
    str ds = d.digits.to_str();
    if (point < -4 || point >= n) {
        str mant = ds.substr(0, 1);
        if (n > 1) {
            mant = mant + "." + ds.substr(1, n);
        }
        str esign = "+";
        int mag = point;
        if (point < 0) {
            esign = "-";
            mag = -point;
        }
        // At least two exponent digits, as C writes them.
        str pad = "";
        if (mag < 10) {
            pad = "0";
        }
        return sign + mant + "e" + esign + pad + mag.to_str();
    }
    if (point >= 0) {
        if (n > point + 1) {
            return sign + ds.substr(0, point + 1) + "." + ds.substr(point + 1, n);
        }
        return sign + ds;
    }
    return sign + "0." + "0".repeat(-point - 1) + ds;
}

/// The float a decimal names, correctly rounded, or None if `s` is not one.
///
/// Accepted: an optional sign, then digits with an optional `.` and fraction
/// (at least one digit in all), then an optional exponent `e` or `E` with an
/// optional sign and at least one digit -- or exactly `inf` or `nan` after
/// the sign, the words `format` writes for the floats with no digits. No
/// surrounding space, no hex, no `infinity`, the same as `parse_int`. A value
/// too large for a float is None; one too small rounds to a subnormal or a
/// zero, which is its correctly rounded value.
pub Option<float> parse(str s) {
    int n = s.size();
    int i = 0;
    int sign = 0;
    if (n > 0 && (s.byte_at(0) == 43 || s.byte_at(0) == 45)) {
        if (s.byte_at(0) == 45) {
            sign = 1 << 63;
        }
        i = 1;
    }
    if (n - i == 3) {
        if (s.byte_at(i) == 105 && s.byte_at(i + 1) == 110 && s.byte_at(i + 2) == 102) {
            return Option<float>.Some(float.from_bits(sign | inf_bits()));
        }
        // The quiet NaN C's strtod gives, sign included.
        if (s.byte_at(i) == 110 && s.byte_at(i + 1) == 97 && s.byte_at(i + 2) == 110) {
            return Option<float>.Some(float.from_bits(sign | 0x7FF8_0000_0000_0000));
        }
    }
    int start = i;
    int dot = -1;
    int count = 0;
    int frac = 0;
    while (i < n && is_digit(s.byte_at(i))) {
        i = i + 1;
        count = count + 1;
    }
    if (i < n && s.byte_at(i) == 46) {
        dot = i;
        i = i + 1;
        while (i < n && is_digit(s.byte_at(i))) {
            i = i + 1;
            count = count + 1;
            frac = frac + 1;
        }
    }
    if (count == 0) {
        return Option<float>.None;
    }
    int end = i;
    int exp = 0;
    if (i < n && (s.byte_at(i) == 101 || s.byte_at(i) == 69)) {
        i = i + 1;
        bool negative = false;
        if (i < n && (s.byte_at(i) == 43 || s.byte_at(i) == 45)) {
            negative = s.byte_at(i) == 45;
            i = i + 1;
        }
        int written = 0;
        while (i < n && is_digit(s.byte_at(i))) {
            // An exponent this large already means infinity or zero for any
            // input that fits in memory, so it stops growing rather than
            // overflowing.
            if (exp < 1000000000000000) {
                exp = exp * 10 + s.byte_at(i) - 48;
            }
            i = i + 1;
            written = written + 1;
        }
        if (written == 0) {
            return Option<float>.None;
        }
        if (negative) {
            exp = -exp;
        }
    }
    if (i != n) {
        return Option<float>.None;
    }
    // The significant digits run from the first nonzero digit to the last.
    // Leading zeros change nothing, and each trailing zero dropped moves the
    // exponent up by one, so `digits * 10^e10` is the exact value with
    // `digits` free of zeros at either end.
    int first = start;
    while (first < end && (s.byte_at(first) == 48 || s.byte_at(first) == 46)) {
        first = first + 1;
    }
    if (first == end) {
        return Option<float>.Some(float.from_bits(sign));
    }
    int last = end - 1;
    while (s.byte_at(last) == 48 || s.byte_at(last) == 46) {
        last = last - 1;
    }
    int trailing = end - 1 - last;
    if (dot > last) {
        trailing = trailing - 1;
    }
    int nd = last - first + 1;
    if (dot > first && dot < last) {
        nd = nd - 1;
    }
    int bits = decimal_bits(s, first, last, nd, exp - frac + trailing);
    if (bits == inf_bits()) {
        return Option<float>.None;
    }
    return Option<float>.Some(float.from_bits(sign | bits));
}

bool is_digit(int b) {
    return b >= 48 && b <= 57;
}

// The bits of +infinity. Every positive float's bits are below it, and every
// NaN's are above.
int inf_bits() {
    return 0x7FF0_0000_0000_0000;
}

// 2^52: the implicit leading bit of a normal float's significand.
int hidden_bit() {
    return 0x0010_0000_0000_0000;
}

int mask32() {
    return 0xFFFF_FFFF;
}

int digit_count(int v) {
    int n = 1;
    int rest = v / 10;
    while (rest > 0) {
        n = n + 1;
        rest = rest / 10;
    }
    return n;
}

int pow10_int(int n) {
    int p = 1;
    int k = 0;
    while (k < n) {
        p = p * 10;
        k = k + 1;
    }
    return p;
}

// ---------------------------------------------------------------------------
// 64-bit unsigned arithmetic on `int`.
// `x >> n` with zeros shifted in rather than copies of the sign bit, for n in
// 1..63.
int lsr(int x, int n) {
    return x >> n & ~(-1 << 64 - n);
}

// `a < b` with both read as unsigned. Flipping the sign bit maps the
// unsigned order onto the signed one.
bool ult(int a, int b) {
    return a ^ 1 << 63 < b ^ 1 << 63;
}

// The high 64 bits of the 128-bit product of `a` and `b`, both unsigned.
// The low 64 bits are `a.wrapping_mul(b)`.
//
// Schoolbook multiplication on 32-bit halves. Each partial product fits in 64
// unsigned bits, so `wrapping_mul` gives it exactly; the middle column sums
// three values below 2^32 and cannot overflow; and the high word is below
// 2^64 as a whole, so its wrapping additions never actually wrap.
int umulhi(int a, int b) {
    int a0 = a & mask32();
    int a1 = lsr(a, 32);
    int b0 = b & mask32();
    int b1 = lsr(b, 32);
    int p00 = a0.wrapping_mul(b0);
    int p01 = a0.wrapping_mul(b1);
    int p10 = a1.wrapping_mul(b0);
    int p11 = a1.wrapping_mul(b1);
    int mid = lsr(p00, 32) + (p01 & mask32()) + (p10 & mask32());
    return p11.wrapping_add(lsr(p01, 32)).wrapping_add(lsr(p10, 32)).wrapping_add(lsr(mid, 32));
}

// The top 64 bits of the 192-bit product g * cp, where g = ghi * 2^64 + glo,
// rounded to odd: the lowest bit is set if anything below it was not zero.
// That one sticky bit is what lets Schubfach compare the scaled value with
// the interval ends exactly, never mistaking a near miss for equality.
int round_to_odd(int ghi, int glo, int cp) {
    int x_hi = umulhi(glo, cp);
    int y_lo = ghi.wrapping_mul(cp);
    int y_hi = umulhi(ghi, cp);
    int y0 = y_lo.wrapping_add(x_hi);
    int y1 = y_hi;
    if (ult(y0, x_hi)) {
        y1 = y1 + 1;
    }
    if (ult(1, y0)) {
        return y1 | 1;
    }
    return y1;
}

// floor(log2(10^e)), floor(log10(2^e)) and floor(log10(3/4 * 2^e)), by fixed
// point multiplication. Exact over the whole range any float needs, which was
// checked against exact rational arithmetic for every e used.
int floor_log2_pow10(int e) {
    return e * 1741647 >> 19;
}

int floor_log10_pow2(int e) {
    return e * 1262611 >> 22;
}

int floor_log10_three_quarters_pow2(int e) {
    return e * 1262611 - 524031 >> 22;
}

// ---------------------------------------------------------------------------
// Formatting: Schubfach.
// The Decimal for the positive finite float with these bits, in the digits
// `format` prints.
Decimal shortest(int bits) {
    int ieee_exp = bits >> 52;
    int frac = bits & hidden_bit() - 1;
    int c = frac;
    int q = -1074;
    if (ieee_exp != 0) {
        c = frac | hidden_bit();
        q = ieee_exp - 1075;
        // A whole number below 2^53 is its own shortest form: the floats
        // either side are at least 1/2 away, so nothing shorter reads back.
        if (q <= 0 && q > -53 && c & (1 << -q) - 1 == 0) {
            return strip(c >> -q, 0);
        }
    }
    // At a power of two the float below is half as far away as the float
    // above, so the rounding interval is lopsided.
    bool lopsided = frac == 0 && ieee_exp > 1;
    int k = floor_log10_pow2(q);
    if (lopsided) {
        k = floor_log10_three_quarters_pow2(q);
    }
    Decimal d = strip(schubfach(c, q, lopsided, k), k);
    if (lopsided) {
        return printf_digits(q, d);
    }
    return d;
}

// The shortest decimal in the rounding interval of c * 2^q, and of those the
// closest, as digits at the scale 10^k.
//
// Everything is scaled by 10^-k so the interval spans a few units, and by 4
// so its ends are whole: the float is `cb`, the ends `cbl` and `cbr`. The
// scaled values come from one table entry, g = 10^-k to 128 bits rounded up,
// and are rounded to odd, which keeps every comparison below exact. Then:
// if exactly one multiple of ten is inside the interval, it is the answer
// with a digit fewer; otherwise the answer is whichever of s and s + 1 is
// inside, or the closer of the two when both are.
int schubfach(int c, int q, bool lopsided, int k) {
    int h = q + floor_log2_pow10(-k) + 1;
    int ghi = pow10_hi(-k);
    int glo = pow10_lo(-k).wrapping_add(1);
    int cb = 4 * c;
    int cbl = cb - 2;
    if (lopsided) {
        cbl = cb - 1;
    }
    int cbr = cb + 2;
    int vbl = round_to_odd(ghi, glo, cbl << h);
    int vb = round_to_odd(ghi, glo, cb << h);
    int vbr = round_to_odd(ghi, glo, cbr << h);
    // An end of the interval belongs to it when the float's significand is
    // even, because that is where round-half-to-even sends a tie.
    int lower = vbl;
    int upper = vbr;
    if (c & 1 == 1) {
        lower = vbl + 1;
        upper = vbr - 1;
    }
    int s = vb / 4;
    if (s >= 10) {
        int sp = s / 10;
        bool up_inside = lower <= 40 * sp;
        bool wp_inside = 40 * sp + 40 <= upper;
        if (up_inside != wp_inside) {
            if (wp_inside) {
                return 10 * sp + 10;
            }
            return 10 * sp;
        }
    }
    bool u_inside = lower <= 4 * s;
    bool w_inside = 4 * s + 4 <= upper;
    if (u_inside != w_inside) {
        if (w_inside) {
            return s + 1;
        }
        return s;
    }
    int mid = 4 * s + 2;
    if (vb > mid || vb == mid && s & 1 == 1) {
        return s + 1;
    }
    return s;
}

Decimal strip(int digits, int exp) {
    int d = digits;
    int e = exp;
    while (d % 10 == 0) {
        d = d / 10;
        e = e + 1;
    }
    return Decimal(d, e);
}

// The digits C's `%.{p}g` gives at the smallest precision that reads back,
// for a power of two -- the one place that is not the shortest form.
//
// `%.{p}g` rounds to p digits and stops at the first p that reads back.
// Where the rounding interval is symmetric, the closest p-digit decimal is
// inside it whenever any p-digit decimal is, so that is exactly Schubfach's
// answer. At a power of two it is lopsided, and the closest decimal of the
// shortest length can fall just outside the narrow side while a farther one
// fits in the wide side: 2^1194 is 5.986310706507379e+51 shortest, but C
// prints 5.9863107065073784e+51. There are 46 such floats, and the corpus
// has always printed C's answer.
//
// So the float is scaled to 18 digits, carrying the same sticky bit as
// Schubfach, and rounded to p digits for each p from the shortest length up
// until the rounded value is inside the interval.
Decimal printf_digits(int q, Decimal d) {
    int n = digit_count(d.digits);
    int kf = d.exp + n - 1 - 17;
    // 4 * 2^52: the significand of a power of two, times 4 as in Schubfach.
    int cb = 0x0040_0000_0000_0000;
    int h = q + floor_log2_pow10(-kf) + 1;
    int ghi = pow10_hi(-kf);
    int glo = pow10_lo(-kf).wrapping_add(1);
    int vb = round_to_odd(ghi, glo, cb << h);
    // The shortest form can round up to a power of ten -- 1e23 for a float
    // just below it -- which puts the float one digit short of 18. One step
    // further down fixes it.
    if (vb < 400000000000000000) {
        kf = kf - 1;
        h = q + floor_log2_pow10(-kf) + 1;
        ghi = pow10_hi(-kf);
        glo = pow10_lo(-kf).wrapping_add(1);
        vb = round_to_odd(ghi, glo, cb << h);
    }
    int vl = round_to_odd(ghi, glo, cb - 1 << h);
    int vr = round_to_odd(ghi, glo, cb + 2 << h);
    int p = n;
    while (p <= 17) {
        int j = 18 - p;
        int m = 4 * pow10_int(j);
        int r = vb / m;
        int rem = vb - r * m;
        // `rem` equal to half is a true tie only when vb is even, i.e.
        // exact; an odd vb carries the sticky bit and is never equal to an
        // even value. Ties go to even, as C's printf rounds them.
        if (rem > m / 2 || rem == m / 2 && r & 1 == 1) {
            r = r + 1;
        }
        // The significand is even, so both ends of the interval belong to
        // it, and a multiple of 4 is compared exactly against an odd vl or
        // vr for the same reason as above.
        if (vl <= r * m && r * m <= vr) {
            return strip(r, kf + j);
        }
        p = p + 1;
    }
    // Not reached: 17 digits always read back.
    return d;
}

// ---------------------------------------------------------------------------
// Parsing: Eisel-Lemire, then an exact comparison when that cannot decide.
// The bits of the positive float nearest `digits * 10^e10`, where `digits`
// is the `nd` significant digits of `s` from `first` to `last` (skipping a
// `.`), with no zero at either end.
int decimal_bits(str s, int first, int last, int nd, int e10) {
    // The first 19 digits always fit in 64 unsigned bits.
    int w = 0;
    int taken = 0;
    int j = first;
    while (taken < 19 && taken < nd) {
        int b = s.byte_at(j);
        if (b != 46) {
            w = w.wrapping_mul(10).wrapping_add(b - 48);
            taken = taken + 1;
        }
        j = j + 1;
    }
    if (nd <= 19) {
        int got = eisel_lemire(w, e10);
        if (got >= 0) {
            return got;
        }
        return exact_bits(s, first, last, nd, e10, -got - 1);
    }
    // Truncated to 19 digits, the value lies between w and w + 1 at this
    // scale. When both round to the same float, so does everything between.
    int q = e10 + nd - 19;
    int below = eisel_lemire(w, q);
    int above = eisel_lemire(w.wrapping_add(1), q);
    if (below >= 0 && below == above) {
        return below;
    }
    if (below < 0) {
        below = -below - 1;
    }
    return exact_bits(s, first, last, nd, e10, below);
}

// The float nearest w * 10^q for an unsigned w, from a 128-bit product with a
// table entry for 10^q. Either the bits, or -(bits) - 1 when the truncated
// product cannot say which of two floats is nearer and `bits` is only a
// guess; Mushtak and Lemire proved that never happens for a whole w below
// 2^64, and it is checked anyway because checking costs nothing.
//
// This is fast_float's `compute_float`, line for line.
int eisel_lemire(int w, int q) {
    if (w == 0 || q < -342) {
        return 0;
    }
    if (q > 308) {
        return inf_bits();
    }
    int lz = leading_zeros(w);
    int ww = w << lz;
    // fast_float's table rounds 10^q up for -27 <= q < 0, where the
    // reciprocal is exact to 128 bits, and down everywhere else.
    int thi = pow10_hi(q);
    int tlo = pow10_lo(q);
    if (q < 0 && q >= -27) {
        tlo = tlo.wrapping_add(1);
    }
    int hi = umulhi(ww, thi);
    int lo = ww.wrapping_mul(thi);
    bool unsure = false;
    // Only when the bits below the 55 that matter are all ones could the
    // rest of the product carry into them, and only then is the second
    // half of the table entry needed.
    if (hi & 511 == 511) {
        int lo2 = umulhi(ww, tlo);
        lo = lo.wrapping_add(lo2);
        if (ult(lo, lo2)) {
            hi = hi.wrapping_add(1);
        }
        unsure = lo == -1;
    }
    int upper = lsr(hi, 63);
    int mant = lsr(hi, upper + 9);
    int power2 = (217706 * q >> 16) + 63 + upper - lz + 1023;
    int bits = 0;
    if (power2 <= 0) {
        // Subnormal, or zero.
        if (-power2 + 1 >= 64) {
            return 0;
        }
        mant = mant >> -power2 + 1;
        mant = mant + (mant & 1);
        mant = mant >> 1;
        // Rounding up can carry into the smallest normal exponent.
        if (mant < hidden_bit()) {
            bits = mant;
        } else {
            bits = hidden_bit() | mant & hidden_bit() - 1;
        }
    } else {
        // An exact tie can only come from a small power of ten, and then the
        // low product is zero and the dropped bits are exactly one half:
        // round it to even instead of up.
        if (ult(lo, 2) && q >= -4 && q <= 23 && mant & 3 == 1) {
            if (mant << upper + 9 == hi) {
                mant = mant & ~1;
            }
        }
        mant = mant + (mant & 1);
        mant = mant >> 1;
        if (mant >= 2 * hidden_bit()) {
            mant = hidden_bit();
            power2 = power2 + 1;
        }
        mant = mant & hidden_bit() - 1;
        if (power2 >= 2047) {
            return inf_bits();
        }
        bits = power2 << 52 | mant;
    }
    if (unsure) {
        return -bits - 1;
    }
    return bits;
}

int leading_zeros(int x) {
    if (x < 0) {
        return 0;
    }
    int n = 0;
    int v = x;
    if (v >> 32 == 0) {
        n = n + 32;
        v = v << 32;
    }
    if (v >> 48 == 0) {
        n = n + 16;
        v = v << 16;
    }
    if (v >> 56 == 0) {
        n = n + 8;
        v = v << 8;
    }
    if (v >> 60 == 0) {
        n = n + 4;
        v = v << 4;
    }
    if (v >> 62 == 0) {
        n = n + 2;
        v = v << 2;
    }
    if (v >> 63 == 0) {
        n = n + 1;
    }
    return n;
}

// The correctly rounded bits, starting from a guess at most a float or two
// away: move while the value is past the halfway point on either side.
//
// Only the first 800 significant digits are kept, with a final 1 standing
// in for the rest when there are more. That changes no comparison: a
// halfway point between two floats has at most 767 significant digits, so
// none lies strictly between the kept digits and the full value, and the 1
// keeps the full value's side when the kept digits equal one exactly.
int exact_bits(str s, int first, int last, int nd, int e10, int guess) {
    List<int> big = [];
    int chunk = 0;
    int held = 0;
    int used = 0;
    int j = first;
    while (j <= last && used < 800) {
        int ch = s.byte_at(j);
        if (ch != 46) {
            chunk = chunk * 10 + ch - 48;
            held = held + 1;
            used = used + 1;
            if (held == 9) {
                mul_add(big, 1000000000, chunk);
                chunk = 0;
                held = 0;
            }
        }
        j = j + 1;
    }
    if (held > 0) {
        mul_add(big, pow10_int(held), chunk);
    }
    int scale = e10;
    if (nd > 800) {
        mul_add(big, 10, 1);
        scale = e10 + nd - 800 - 1;
    }
    int b = guess;
    bool moved = true;
    while (moved) {
        moved = false;
        if (b < inf_bits()) {
            int up = compare_half(big, scale, b);
            if (up > 0 || up == 0 && b & 1 == 1) {
                b = b + 1;
                moved = true;
            }
        }
        if (!moved && b > 0) {
            int down = compare_half(big, scale, b - 1);
            if (down < 0 || down == 0 && b & 1 == 1) {
                b = b - 1;
                moved = true;
            }
        }
    }
    return b;
}

// The sign of big * 10^e10 minus the point halfway between the float with
// bits `b` and the next one up.
//
// The halfway point is (2m + 1) * 2^(e2 - 1) for the float m * 2^e2, so both
// sides are whole numbers times powers of 2 and 5: move the power of 5 to
// whichever side makes it a multiplication, then line up the powers of 2.
int compare_half(List<int> big, int e10, int b) {
    int ieee_exp = b >> 52;
    int m = b & hidden_bit() - 1;
    int e2 = -1074;
    if (ieee_exp != 0) {
        m = m | hidden_bit();
        e2 = ieee_exp - 1075;
    }
    int t = 2 * m + 1;
    List<int> lhs = clone(big);
    List<int> rhs = [t & mask32(), t >> 32];
    if (e10 >= 0) {
        mul_pow5(lhs, e10);
    } else {
        mul_pow5(rhs, -e10);
    }
    int lp = e10;
    int rp = e2 - 1;
    if (lp > rp) {
        lhs = shift_left(lhs, lp - rp);
    } else {
        rhs = shift_left(rhs, rp - lp);
    }
    return compare_big(lhs, rhs);
}

// Big integers: a List of 32-bit limbs, least significant first.
// a = a * m + add, for m and add below 2^31: a limb times m plus the carry
// stays below 2^63.
void mul_add(List<int> a, int m, int add) {
    int carry = add;
    int i = 0;
    while (i < a.size()) {
        int v = a[i] * m + carry;
        a[i] = v & mask32();
        carry = v >> 32;
        i = i + 1;
    }
    while (carry != 0) {
        a.push(carry & mask32());
        carry = carry >> 32;
    }
}

void mul_pow5(List<int> a, int e) {
    int left = e;
    // 5^13 is the largest power of 5 below 2^31.
    while (left >= 13) {
        mul_add(a, 1220703125, 0);
        left = left - 13;
    }
    int p = 1;
    while (left > 0) {
        p = p * 5;
        left = left - 1;
    }
    mul_add(a, p, 0);
}

List<int> shift_left(List<int> a, int bits) {
    List<int> out = [];
    int words = bits / 32;
    int r = bits % 32;
    int i = 0;
    while (i < words) {
        out.push(0);
        i = i + 1;
    }
    if (r == 0) {
        for (int v in a) {
            out.push(v);
        }
        return out;
    }
    int carry = 0;
    for (int v in a) {
        out.push(v << r & mask32() | carry);
        carry = v >> 32 - r;
    }
    if (carry != 0) {
        out.push(carry);
    }
    return out;
}

int significant_limbs(List<int> a) {
    int n = a.size();
    while (n > 0 && a[n - 1] == 0) {
        n = n - 1;
    }
    return n;
}

int compare_big(List<int> a, List<int> b) {
    int na = significant_limbs(a);
    int nb = significant_limbs(b);
    if (na != nb) {
        if (na < nb) {
            return -1;
        }
        return 1;
    }
    int i = na - 1;
    while (i >= 0) {
        if (a[i] != b[i]) {
            if (a[i] < b[i]) {
                return -1;
            }
            return 1;
        }
        i = i - 1;
    }
    return 0;
}

// ---------------------------------------------------------------------------
// Powers of ten to 128 bits.
//
// pow10_hi(e) * 2^64 + pow10_lo(e), both read as unsigned, is
// floor(10^e * 2^s) with s chosen to put it in [2^127, 2^128), for e from
// -342 to 341 -- the union of what Schubfach needs to format any float and
// what Eisel-Lemire needs to parse any decimal. Schubfach wants 10^e rounded
// up, so it adds one; so does Eisel-Lemire for -27 <= e < 0, which makes the
// table exactly fast_float's. No low word is all ones, so the +1 never
// carries.
//
// The language has no module-level constants, so the table is text: each
// entry is 32 hex digits, eight entries to a string literal, found by a
// binary search over the literals. A string literal is immortal, so a lookup
// allocates nothing. (A search tree with one `return` per word was tried
// first. It made the emitted C five times larger, and added most of a second
// to every -O2 build of a program that prints a float.)
//
// Generated, not written, by this Python, which also checks the no-carry
// claim:
//
//     def F(e):
//         if e >= 0:
//             v = 10 ** e
//             n = v.bit_length()
//             return v >> (n - 128) if n > 128 else v << (128 - n)
//         d = 10 ** -e
//         s = 127 + d.bit_length()
//         while (1 << s) // d >= 1 << 128: s -= 1
//         while (1 << s) // d < 1 << 127: s += 1
//         return (1 << s) // d
//
//     assert all(F(e) & (2**64 - 1) != 2**64 - 1 for e in range(-342, 342))
//     rows = [''.join('%032x' % F(e) for e in range(r, min(r + 8, 342)))
//             for r in range(-342, 342, 8)]
//
// with `pow10_row` a binary search returning rows[row].
int pow10_hi(int e) {
    int i = e + 342;
    return hex_word(pow10_row(i / 8), i % 8 * 32);
}

int pow10_lo(int e) {
    int i = e + 342;
    return hex_word(pow10_row(i / 8), i % 8 * 32 + 16);
}

// The 64-bit word spelt by the 16 hex digits of `s` from `at`. Shifting left
// discards the top bits rather than trapping, so the word's top bit arrives
// as the sign bit without any arithmetic overflowing.
int hex_word(str s, int at) {
    int v = 0;
    int i = at;
    while (i < at + 16) {
        int c = s.byte_at(i);
        int d = c - 48;
        if (c >= 97) {
            d = c - 87;
        }
        v = v << 4 | d;
        i = i + 1;
    }
    return v;
}

