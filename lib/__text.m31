// Code points: UTF-8 decoding and encoding, written in the language.
//
// The compiler lowers `s.chars()` and `str.from_chars(xs)` to the two
// functions here, the way it lowers float text to lib/__floatfmt.m31. No
// program can import this module or collide with it: its name begins with
// `__`. It is loaded only when some file mentions `chars` or `from_chars`.
//
// Both are bit manipulation over bytes the language already reaches --
// `byte_at`, `bytes.push`, `utf8()` -- so neither needs the runtime. See
// docs/text-decision.md for why a code point is an `int`.
//
// Constants are decimal because the language has no hex literal yet:
//   128 = 0x80      192 = 0xC0      224 = 0xE0      240 = 0xF0
//   2048 = 0x800    65536 = 0x10000 1114111 = 0x10FFFF
//   55296..57343 = 0xD800..0xDFFF, the surrogates

/// The Unicode scalar values of `text`, in order.
///
/// `text` is valid UTF-8 -- every way to make a `str` guarantees it -- so this
/// decodes without checking: the lead byte says how many continuation bytes
/// follow, and they are there. A decoder that also validated would be
/// testing an invariant the type already holds.
List<int> chars(str text) {
    List<int> out = [];
    int byte_count = text.size();
    int index = 0;
    while (index < byte_count) {
        int lead_byte = text.byte_at(index);
        if (lead_byte < 128) {
            out.push(lead_byte);
            index = index + 1;
        } else if (lead_byte < 224) {
            out.push((lead_byte & 31) << 6 | text.byte_at(index + 1) & 63);
            index = index + 2;
        } else if (lead_byte < 240) {
            out.push((lead_byte & 15) << 12 | (text.byte_at(index + 1) & 63) << 6 | text.byte_at(index + 2) & 63);
            index = index + 3;
        } else {
            int high_bits = (lead_byte & 7) << 18 | (text.byte_at(index + 1) & 63) << 12;
            out.push(high_bits | (text.byte_at(index + 2) & 63) << 6 | text.byte_at(index + 3) & 63);
            index = index + 4;
        }
    }
    return out;
}

/// The text whose scalar values are `cps`, encoded as UTF-8.
///
/// A value that is not a Unicode scalar value -- negative, a surrogate, or
/// past U+10FFFF -- traps, as storing 256 in a `bytes` does (reference
/// §3.10): it has no UTF-8 form, so there is no string to return, and a
/// code point is the program's own value, like an index. A program holding
/// numbers from outside -- a `\u` escape in JSON -- checks them first.
str from_chars(List<int> cps) {
    bytes encoded = [];
    for (int code_point in cps) {
        if (code_point < 0 || code_point > 1114111 || code_point >= 55296 && code_point <= 57343) {
            trap("str.from_chars: " + show(code_point) + " is not a Unicode scalar value");
        }
        if (code_point < 128) {
            encoded.push(code_point);
        } else if (code_point < 2048) {
            encoded.push(192 | code_point >> 6);
            encoded.push(128 | code_point & 63);
        } else if (code_point < 65536) {
            encoded.push(224 | code_point >> 12);
            encoded.push(128 | code_point >> 6 & 63);
            encoded.push(128 | code_point & 63);
        } else {
            encoded.push(240 | code_point >> 18);
            encoded.push(128 | code_point >> 12 & 63);
            encoded.push(128 | code_point >> 6 & 63);
            encoded.push(128 | code_point & 63);
        }
    }
    // Every value was checked above and encoded in its shortest form, so
    // this cannot be None. Going through utf8() anyway keeps it the single
    // door into `str`, rather than adding a second one that trusts its
    // caller.
    match (encoded.utf8()) {
        case Some(str text): {
            return text;
        }
        case None: {
            trap("str.from_chars: encoded invalid UTF-8; this is a compiler bug");
        }
    }
}

// A code point the way Unicode writes one: U+ and at least four uppercase
// hex digits, or the decimal number for a negative one, which has no U+ form.
str show(int code_point) {
    if (code_point < 0) {
        return code_point.to_str();
    }
    str digits = "0123456789ABCDEF";
    str out = "";
    int remaining = code_point;
    while (remaining > 0 || out.size() < 4) {
        out = digits.substr(remaining & 15, (remaining & 15) + 1) + out;
        remaining = remaining >> 4;
    }
    return "U+" + out;
}
