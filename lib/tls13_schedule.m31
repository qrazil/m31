// TLS 1.3's key schedule (RFC 8446 §7) for the cipher suites whose hash is
// SHA-256 -- `TLS_CHACHA20_POLY1305_SHA256` here, and `TLS_AES_128_GCM_SHA256`
// should it ever be wanted: the schedule is the same, only the record cipher
// differs. Every function is pure and works on `bytes`; nothing touches a
// socket. `lib/tls13_record.m31` is what puts the keys it derives to use.
//
// The schedule, with RFC 8446 §7.1's own names:
//
//                 0
//                 |
//   PSK ->  HKDF-Extract = early_secret(psk)
//                 |
//           Derive-Secret(., "derived", "")
//                 |
//   (EC)DHE -> HKDF-Extract = handshake_secret(early_secret, shared_secret)
//                 |
//                 +-> client_handshake_traffic_secret(., hello_hash)
//                 +-> server_handshake_traffic_secret(., hello_hash)
//                 |
//           Derive-Secret(., "derived", "")
//                 |
//        0 -> HKDF-Extract = master_secret(handshake_secret)
//                 |
//                 +-> client_application_traffic_secret(., finished_hash)
//                 +-> server_application_traffic_secret(., finished_hash)
//                 +-> exporter_master_secret(., finished_hash)
//                 +-> resumption_master_secret(., client_finished_hash)
//
// and from any traffic secret: `traffic_key`, `traffic_iv`, `finished_key`
// and `next_traffic_secret` (KeyUpdate, RFC 8446 §7.2).
//
// Transcript hashes are not computed here from a running hash: this
// language's `sha256.Hasher` cannot be cloned and `digest()` ends it, while
// the schedule needs the hash after ClientHello..ServerHello, again after
// ..server Finished, again after ..client Finished -- each a prefix of the
// next. `Transcript` therefore keeps the message bytes and hashes the whole
// of them on demand, which for a handshake of a few kilobytes costs nothing.
//
// `hello_hash`, `finished_hash` and so on below are always the 32-octet
// result of `Transcript.digest()` at the point the RFC names, passed in by the
// caller; "the empty transcript" is `empty_hash()`.
//
// Everything here uses the SHA-256 side of `lib/hkdf.m31` and
// `lib/hmac.m31`. A SHA-384 suite (`TLS_AES_256_GCM_SHA384`) is a different
// set of 48-octet functions over `hkdf.sha384_*` and is not here.

import sha256;
import hmac;
import hkdf;

/// HashLen of SHA-256, which is also the length of every secret in the
/// schedule and of a Finished key and a Finished `verify_data`.
pub const int HASH_SIZE = 32;
/// The key length of `TLS_CHACHA20_POLY1305_SHA256`.
pub const int KEY_SIZE = 32;
/// The IV length of `TLS_CHACHA20_POLY1305_SHA256` (RFC 8446 §5.3's
/// `iv_length`, the AEAD's nonce length).
pub const int IV_SIZE = 12;
/// A handshake message's type octet (RFC 8446 §4), for the one the schedule
/// itself must recognise: HelloRetryRequest rewrites the transcript.
const int MESSAGE_HASH_TYPE = 254;

/// The SHA-256 hash of nothing: `Transcript-Hash("")`, which `Derive-Secret`
/// is given for the "derived" steps and for `early_secret`-side labels used
/// without any handshake yet.
pub bytes empty_hash() {
    return sha256.sum([]);
}

// --- the transcript ----------------------------------------------------------

/// The handshake messages so far, concatenated in the order sent and
/// received, each with its own 4-octet header (RFC 8446 §4.4.1): everything
/// from the first ClientHello's `msg_type` on, and nothing from the record
/// layer. Fields are private; messages go in through `add`.
pub type Transcript {
    bytes messages;
}

/// Appends one complete handshake message, header included.
pub void Transcript.add(bytes message) {
    messages.extend(message);
}

/// `Transcript-Hash` of everything added so far. Does not change the
/// transcript: ask as often as the schedule needs.
pub bytes Transcript.digest() {
    return sha256.sum(messages);
}

/// Rewrites the transcript after a HelloRetryRequest, RFC 8446 §4.4.1: the
/// messages so far -- which must be exactly the first ClientHello -- are
/// replaced by a synthetic `message_hash` handshake message whose body is
/// their hash. The caller adds the HelloRetryRequest and the second
/// ClientHello after this, as for any other messages.
pub void Transcript.restart_after_retry_request() {
    bytes first_hello_hash = sha256.sum(messages);
    bytes synthetic = [];
    synthetic.push(MESSAGE_HASH_TYPE);
    synthetic.push(0);
    synthetic.push(0);
    synthetic.push(first_hello_hash.size());
    synthetic.extend(first_hello_hash);
    messages = synthetic;
}

/// A transcript with nothing in it.
pub Transcript transcript() {
    bytes none = [];
    return Transcript(none);
}

// --- the secrets -------------------------------------------------------------

/// `Derive-Secret(secret, label, Messages)` of RFC 8446 §7.1, given the
/// transcript hash itself. The named functions below are this with the
/// label filled in; it is public for a label this module does not name.
pub bytes derive_secret(bytes secret, str label, bytes transcript_hash) {
    return hkdf.sha256_derive_secret(secret, label, transcript_hash);
}

/// The Early Secret: `HKDF-Extract(0, psk)`. `psk` is the pre-shared key, or
/// empty for a handshake without one, which RFC 8446 §7.1 spells as HashLen
/// zero octets.
pub bytes early_secret(bytes psk) {
    bytes keying_material = psk;
    if (psk.size() == 0) {
        keying_material = [0; HASH_SIZE];
    }
    return hkdf.sha256_extract([0; HASH_SIZE], keying_material);
}

/// The Handshake Secret:
/// `HKDF-Extract(Derive-Secret(early_secret, "derived", ""), shared_secret)`,
/// with `shared_secret` the (EC)DHE output.
pub bytes handshake_secret(bytes early_secret_value, bytes shared_secret) {
    bytes salt = derive_secret(early_secret_value, "derived", empty_hash());
    return hkdf.sha256_extract(salt, shared_secret);
}

/// The Master Secret:
/// `HKDF-Extract(Derive-Secret(handshake_secret, "derived", ""), 0)`.
pub bytes master_secret(bytes handshake_secret_value) {
    bytes salt = derive_secret(handshake_secret_value, "derived", empty_hash());
    return hkdf.sha256_extract(salt, [0; HASH_SIZE]);
}

/// `client_handshake_traffic_secret`: `hello_hash` is the transcript hash
/// through ServerHello.
pub bytes client_handshake_traffic_secret(bytes handshake_secret_value, bytes hello_hash) {
    return derive_secret(handshake_secret_value, "c hs traffic", hello_hash);
}

/// `server_handshake_traffic_secret`: `hello_hash` is the transcript hash
/// through ServerHello.
pub bytes server_handshake_traffic_secret(bytes handshake_secret_value, bytes hello_hash) {
    return derive_secret(handshake_secret_value, "s hs traffic", hello_hash);
}

/// `client_application_traffic_secret_0`: `finished_hash` is the transcript
/// hash through the server's Finished.
pub bytes client_application_traffic_secret(bytes master_secret_value, bytes finished_hash) {
    return derive_secret(master_secret_value, "c ap traffic", finished_hash);
}

/// `server_application_traffic_secret_0`: `finished_hash` is the transcript
/// hash through the server's Finished.
pub bytes server_application_traffic_secret(bytes master_secret_value, bytes finished_hash) {
    return derive_secret(master_secret_value, "s ap traffic", finished_hash);
}

/// `exporter_master_secret`: `finished_hash` is the transcript hash through
/// the server's Finished.
pub bytes exporter_master_secret(bytes master_secret_value, bytes finished_hash) {
    return derive_secret(master_secret_value, "exp master", finished_hash);
}

/// `resumption_master_secret`: `client_finished_hash` is the transcript hash
/// through the client's Finished.
pub bytes resumption_master_secret(bytes master_secret_value, bytes client_finished_hash) {
    return derive_secret(master_secret_value, "res master", client_finished_hash);
}

/// `client_early_traffic_secret`: `hello_hash` is the transcript hash
/// through the ClientHello.
pub bytes client_early_traffic_secret(bytes early_secret_value, bytes hello_hash) {
    return derive_secret(early_secret_value, "c e traffic", hello_hash);
}

/// The key a PSK binder is computed under (RFC 8446 §4.2.11.2):
/// `Derive-Secret(early_secret, "ext binder" | "res binder", "")`.
pub bytes binder_key(bytes early_secret_value, bool resumption) {
    if (resumption) {
        return derive_secret(early_secret_value, "res binder", empty_hash());
    }
    return derive_secret(early_secret_value, "ext binder", empty_hash());
}

// --- from a traffic secret ---------------------------------------------------

/// The record-protection key for `traffic_secret`, RFC 8446 §7.3:
/// `HKDF-Expand-Label(secret, "key", "", key_length)`, for the 32-octet key
/// of `TLS_CHACHA20_POLY1305_SHA256`.
pub bytes traffic_key(bytes traffic_secret) {
    return sized_traffic_key(traffic_secret, KEY_SIZE);
}

/// `traffic_key` for a cipher with another key length -- 16 for
/// `TLS_AES_128_GCM_SHA256`, which RFC 8448's traces use. The length is part
/// of the HKDF label, so this is not a prefix of the 32-octet key.
pub bytes sized_traffic_key(bytes traffic_secret, int key_size) {
    return hkdf.sha256_expand_label(traffic_secret, "key", [], key_size);
}

/// The record-protection IV for `traffic_secret`, RFC 8446 §7.3:
/// `HKDF-Expand-Label(secret, "iv", "", iv_length)`.
pub bytes traffic_iv(bytes traffic_secret) {
    return hkdf.sha256_expand_label(traffic_secret, "iv", [], IV_SIZE);
}

/// The key a Finished message's MAC is computed under, RFC 8446 §4.4.4:
/// `HKDF-Expand-Label(base_key, "finished", "", HashLen)`, where `base_key`
/// is the sender's handshake traffic secret.
pub bytes finished_key(bytes base_key) {
    return hkdf.sha256_expand_label(base_key, "finished", [], HASH_SIZE);
}

/// A Finished message's `verify_data`: `HMAC(finished_key, transcript_hash)`,
/// the transcript hash being through the message before Finished.
pub bytes finished_verify_data(bytes finished_key_value, bytes transcript_hash) {
    return hmac.sha256_mac(finished_key_value, transcript_hash);
}

/// The next generation of a traffic secret after a KeyUpdate, RFC 8446 §7.2:
/// `HKDF-Expand-Label(secret, "traffic upd", "", HashLen)`. Feed the result
/// to `traffic_key` and `traffic_iv` for the new keys.
pub bytes next_traffic_secret(bytes traffic_secret) {
    return hkdf.sha256_expand_label(traffic_secret, "traffic upd", [], HASH_SIZE);
}

/// The key and IV of one direction, derived together from its traffic
/// secret.
pub type TrafficKeys {
    pub bytes key;
    pub bytes iv;
}

/// `traffic_key` and `traffic_iv` of `traffic_secret` as one value.
pub TrafficKeys traffic_keys(bytes traffic_secret) {
    return TrafficKeys(traffic_key(traffic_secret), traffic_iv(traffic_secret));
}
