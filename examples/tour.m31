// A tour of everything the language does today.
//
// Run it:   ./build.sh examples/tour.m31 && ./tour
// This file is also in the corpus, so it cannot rot.

// ---- user types --------------------------------------------------------
// Reference types: heap allocated, refcounted, aliased by assignment.
// A field with no default is positional; one with a default is named.

type Point {
    int x;
    int y;
}

type Rect {
    Point origin;
    int width;
    int height;
}

int Rect.area() {
    return width * height;
}

void Rect.scale(int factor) {
    width = width * factor;
    height = height * factor;
}

bool Rect.is_square() {
    return width == height;
}

// ---- generics ----------------------------------------------------------
// Java-shaped angle brackets. Monomorphised, so Cell<int> and Cell<str>
// become two separate concrete types at compile time.

type Cell<T> {
    T value;
}

type Pair<A, B> {
    A first;
    B second;
}

// ---- methods -----------------------------------------------------------
// Declared by qualified name, outside the type body, so they can be added to
// any type. Fields are reached by BARE NAME -- there is no `this`, because
// nothing shadows anything anywhere, so a bare name means one thing.

// ---- functions ---------------------------------------------------------
// Type-first, like C and Java. Type arguments on a generic function are
// inferred from the call, never written.

T unwrap<T>(Cell<T> cell) {
    return cell.value;
}

int fib(int index) {
    if (index < 2) {
        return index;
    }
    return fib(index - 1) + fib(index - 2);
}

// Overflow traps rather than wrapping, so this cannot silently go negative.
int factorial(int limit) {
    int acc = 1;
    int factor = 2;
    while (factor <= limit) {
        acc = acc * factor;
        factor = factor + 1;
    }
    return acc;
}

str banner(str label, int width) {
    str out = "";
    int column = 0;
    while (column < width) {
        out = concat(out, "=");
        column = column + 1;
    }
    return concat(concat(out, " "), label);
}

// ---- const and arithmetic ----------------------------------------------
const int SCALE = 3;

print(2 + 3 * 4);  // C precedence
print(fib(20));
print(factorial(20));  // the largest that fits in an int
// ---- types and fields --------------------------------------------------
Rect rect = Rect(Point(0, 0), 4, 5);
print(rect.area() * SCALE);
print(rect.origin.x);
rect.width = 10;  // field assignment
print(rect.area());
// ---- aliasing ----------------------------------------------------------
// Assignment aliases; both names see the change. `clone` is the explicit
// way to get a second object.
Rect same = rect;
same.height = 1;
print(rect.area());
// ---- generics ----------------------------------------------------------
Cell<int> int_cell = Cell<int>(21);
print(unwrap(int_cell) * 2);
Cell<str> text_cell = Cell<str>("boxed");
print(unwrap(text_cell));
Pair<int, str> pair = Pair<int, str>(7, "seven");
print(pair.first);
print(pair.second);
// ---- strings -----------------------------------------------------------
str title = banner("tour", 8);
print(title);
print(title.size());

// ---- interfaces ----------------------------------------------------
// Structural: having the methods is the proof, no `implements` clause.

interface Sized {
    int area();
}

Sized shape = rect;
print(shape.area());

// ---- collections ---------------------------------------------------
// Array is fixed length with its elements stored inline -- one allocation,
// one pointer chase. List is growable, with a separate buffer. An array
// needs a fill value because there is no null.

Array<int> squares = [0; 5];
int square_index = 0;
while (square_index < 5) {
    squares[square_index] = square_index * square_index;
    square_index = square_index + 1;
}
int sq_total = 0;
for (int square in squares) {
    sq_total = sq_total + square;
}
print(sq_total);
List<str> words = [];
words.push("the");
words.push("quick");
words.push("fox");
str sentence = "";
for (str word in words) {
    if (word.size() == 3) {
        continue;
    }
    sentence = sentence + word;
}
print(sentence);
print(words.size());
// `=` aliases, because user types are reference types; clone is the
// explicit copy.
List<str> copy = clone(words);
copy.push("more");
print(words.size());
print(copy.size());

// ---- concurrency ---------------------------------------------------
// Threads and channels. A reference sent to another thread is MOVED, which
// is what keeps refcounts non-atomic. A channel is exempt -- it is how
// threads share.

void adder(Chan<int> out, int from, int last) {
    int number = from;
    int total = 0;
    while (number <= last) {
        total = total + number;
        number = number + 1;
    }
    send(out, total);
}

Chan<int> sums = Chan<int>(4);
spawn adder(sums, 1, 50);
spawn adder(sums, 51, 100);
print(recv(sums) + recv(sums));  // order-independent
// ---- control flow ------------------------------------------------------
int step = 0;
int evens = 0;
while (true) {
    step = step + 1;
    if (step > 20) {
        break;
    }
    if (step % 2 != 0) {
        continue;
    }
    evens = evens + step;
}
print(evens);
// Short-circuit: the right side would divide by zero if it ran.
int divisor = 0;
if (divisor != 0 && 10 / divisor > 1) {
    print(-1);
} else {
    print(0);
}
bool is_long = title.size() > 3;
print(is_long);
