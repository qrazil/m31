// Enums and match.
//
// Run it:   ./build.sh examples/enums.m31 && ./enums
// This file is also in the corpus, so it cannot rot.
//
// An enum is a value that is exactly one of several shapes, and each shape
// can carry its own data. A `match` takes it apart. The compiler checks that
// every variant is handled, so adding a variant later is a compile error at
// every place that has to learn about it -- which is the whole reason to
// have the compiler involved.

// ---- Option: a value that might not be there ---------------------------
// This is what the language has instead of null. Only something typed
// `Option<T>` can be absent, and you cannot read the value without saying
// what happens when it is not there.
//
// `Option` and `Result` are declared by the compiler, not here. They have to
// be: a built-in method cannot return a type the program defines, so without
// them `index_of` and `Map.get` could not hand back "nothing" at all. Past
// that they are ordinary enums -- the same match, the same exhaustiveness.

int or_else(Option<int> o, int fallback) {
    match (o) {
        case Some(int v): {
            return v;
        }
        case None: {
            return fallback;
        }
    }
}

print(or_else(Option<int>.Some(7), 0));         // 7
print(or_else(Option<int>.None, -1));           // -1

// Three methods spare you a `match` when all you want is a fallback or a
// yes/no. Taking the value OUT and keeping it still needs `match`.
print(Option<int>.Some(3).or(0));               // 3
print(Option<int>.None.or(0));                  // 0
print(Option<int>.Some(3).is_some());           // true
print(Option<int>.None.is_none());              // true

// Where they come from in practice: a lookup that might find nothing.
Map<str, int> ages = {};
ages.set("ada", 36);
print(ages.get("ada").or(-1));                  // 36
print(ages.get("nobody").or(-1));               // -1

List<str> names = [];
names.push("ada");
names.push("grace");
print(names.index_of("grace").or(-1));          // 1
print(names.index_of("nobody").or(-1));         // -1

// ---- Result: an answer or a reason it failed ----------------------------
// Errors as values. No exceptions, no unwinding, nothing hidden in the
// control flow -- a function that can fail says so in its return type.

Result<int, str> half(int n) {
    if (n % 2 == 0) {
        return Result<int, str>.Ok(n / 2);
    }
    return Result<int, str>.Err("cannot halve an odd number");
}

match (half(10)) {
    case Ok(int v): {
        print(v);                               // 5
    }
    case Err(str why): {
        print(why);
    }
}

match (half(7)) {
    case Ok(int v): {
        print(v);
    }
    case Err(str why): {
        print(why);                             // cannot halve an odd number
    }
}

// ---- A shape is one of several things -----------------------------------
// Variants carry different numbers of values, and different types. They all
// share one object, so `Shape` is one type and a Circle is not a subclass.

enum Shape {
    Empty;
    Circle(int);
    Rect(int, int);
}

int area(Shape s) {
    match (s) {
        case Empty: {
            return 0;
        }
        case Circle(int r): {
            return 3 * r * r;                   // no floats yet, so 3 for pi
        }
        case Rect(int w, int h): {
            return w * h;
        }
    }
}

Array<Shape> shapes = [Shape.Empty; 3];
shapes[0] = Shape.Circle(2);
shapes[1] = Shape.Rect(3, 4);
shapes[2] = Shape.Empty;

int total = 0;
for (Shape s in shapes) {
    total = total + area(s);
}
print(total);                                   // 12 + 12 + 0 = 24

// ---- JSON, which is why null is not needed ------------------------------
// JSON genuinely has a null, and modelling it takes no null in the language:
// it is one variant among the others. The difference matters -- a JSON null
// can only turn up where a Json was expected, and the compiler makes you
// handle it. A null pointer can turn up anywhere and makes you handle
// nothing.

enum Json {
    Null;
    Bool(bool);
    Number(int);
    Text(str);
}

str describe(Json j) {
    match (j) {
        case Null: {
            return "null";
        }
        case Bool(bool b): {
            if (b) {
                return "bool true";
            }
            return "bool false";
        }
        case Number(int n): {
            if (n < 0) {
                return "negative number";
            }
            return "number";
        }
        case Text(str t): {
            if (t.size() > 3) {
                return "long text";
            }
            return "short text";
        }
    }
}

List<Json> doc = [];
doc.push(Json.Null);
doc.push(Json.Bool(true));
doc.push(Json.Number(42));
doc.push(Json.Number(-1));
doc.push(Json.Text("hello"));

for (Json j in doc) {
    print(describe(j));
}

// A payload can be read back out and used, not just matched on.
int sum = 0;
for (Json j in doc) {
    match (j) {
        case Number(int n): {
            sum = sum + n;
        }
        case Null: {
        }
        case Bool(bool b): {
        }
        case Text(str t): {
            sum = sum + t.size();
        }
    }
}
print(sum);                                     // 42 + -1 + 5 = 46

// ---- Enums hold references, and release them ----------------------------
// A variant's payload is owned by the enum exactly as a field is owned by a
// struct: retained when it goes in, released when the enum is freed. The
// corpus checks that __rc_live is 0 at exit, so a leak here would fail.

enum Message {
    Quit;
    Say(str);
    Move(int, int);
}

str render(Message m) {
    match (m) {
        case Quit: {
            return "quit";
        }
        case Say(str what): {
            return concat("say ", what);
        }
        case Move(int x, int y): {
            if (x == 0 && y == 0) {
                return "move nowhere";
            }
            return "move somewhere";
        }
    }
}

print(render(Message.Say(concat("hel", "lo"))));    // say hello
print(render(Message.Move(1, 2)));                  // move somewhere
print(render(Message.Quit));                        // quit
