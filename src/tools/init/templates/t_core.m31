// Unit tests for @@PREFIX@@_core.
//
// Output: one `ok`/`FAIL` line per check and a last line `N passed, M failed`.

import core.@@PREFIX@@_core;

type Tally {
    int passed = 0;
    int failed = 0;
}

void Tally.same(str name, str got, str want) {
    if (got == want) {
        passed = passed + 1;
        print("ok   " + name);
    } else {
        failed = failed + 1;
        print("FAIL " + name + ": got [" + got + "] want [" + want + "]");
    }
}

Tally tally = Tally();
tally.same("greeting", @@PREFIX@@_core.greeting("world"), "hello, world");
tally.same("greeting: empty", @@PREFIX@@_core.greeting(""), "hello, ");
print(str(tally.passed) + " passed, " + str(tally.failed) + " failed");
